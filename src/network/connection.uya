fn connection_acl_category_known(category: &[byte]) bool {
    return connection_keyword_eq(category, &"keyspace"[0: 8]) ||
        connection_keyword_eq(category, &"read"[0: 4]) ||
        connection_keyword_eq(category, &"write"[0: 5]) ||
        connection_keyword_eq(category, &"set"[0: 3]) ||
        connection_keyword_eq(category, &"sortedset"[0: 9]) ||
        connection_keyword_eq(category, &"list"[0: 4]) ||
        connection_keyword_eq(category, &"hash"[0: 4]) ||
        connection_keyword_eq(category, &"string"[0: 6]) ||
        connection_keyword_eq(category, &"bitmap"[0: 6]) ||
        connection_keyword_eq(category, &"hyperloglog"[0: 11]) ||
        connection_keyword_eq(category, &"geo"[0: 3]) ||
        connection_keyword_eq(category, &"stream"[0: 6]) ||
        connection_keyword_eq(category, &"pubsub"[0: 6]) ||
        connection_keyword_eq(category, &"admin"[0: 5]) ||
        connection_keyword_eq(category, &"fast"[0: 4]) ||
        connection_keyword_eq(category, &"slow"[0: 4]) ||
        connection_keyword_eq(category, &"blocking"[0: 8]) ||
        connection_keyword_eq(category, &"dangerous"[0: 9]) ||
        connection_keyword_eq(category, &"connection"[0: 10]) ||
        connection_keyword_eq(category, &"transaction"[0: 11]) ||
        connection_keyword_eq(category, &"scripting"[0: 9]);
}

fn connection_acl_default_command_denied(name: &[byte]) bool {
    if connection_acl_default_denied_find(name) >= 0 {
        return true;
    }
    const entry: CommandCatalogEntry = command_catalog_lookup(name) catch {
        return false;
    };
    var index: usize = 0;
    while index < CONNECTION_ACL_DENIED_CATEGORY_MAX {
        if connection_acl_default_denied_categories[index].active &&
            command_catalog_has_acl_category(&entry, connection_acl_default_denied_categories[index].name[0: connection_acl_default_denied_categories[index].name_len]) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn connection_acl_user_clear_rules(user: &ConnectionAclUser) void {
    var index: usize = 0;
    while index < CONNECTION_ACL_DENIED_COMMAND_MAX {
        user.denied_commands[index].active = false;
        user.denied_commands[index].name_len = 0;
        index = index + 1;
    }
    index = 0;
    while index < CONNECTION_ACL_DENIED_CATEGORY_MAX {
        user.denied_categories[index].active = false;
        user.denied_categories[index].name_len = 0;
        index = index + 1;
    }
}

