    resp_value_free(&hincrby_existing_parsed.value);

    var hincrbyfloat_missing_parsed: RespParseResult = try parse_resp2(&"*4\r\n$12\r\nHINCRBYFLOAT\r\n$4\r\nhash\r\n$5\r\nratio\r\n$3\r\n1.5\r\n"[0: 53]);
