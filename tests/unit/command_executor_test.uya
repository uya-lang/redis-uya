    try assert_eq_i32(zremrangebyrank_reply.integer as i32, 2);
    resp_value_free(&zremrangebyrank_parsed.value);

    var zrange_after_rank_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nZRANGE\r\n$4\r\nzset\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 41]);
