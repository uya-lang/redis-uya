    command_reply_cleanup(&zrangebylex_missing_reply);
    resp_value_free(&zrangebylex_missing_parsed.value);

    var zrangebylex_bad_offset_parsed: RespParseResult = try parse_resp2(&"*7\r\n$11\r\nZRANGEBYLEX\r\n$3\r\nlex\r\n$1\r\n-\r\n$1\r\n+\r\n$5\r\nLIMIT\r\n$2\r\n-1\r\n$1\r\n2\r\n"[0: 71]);
    const zrangebylex_bad_offset_command: Command = try command_executor_test_command(&router, &zrangebylex_bad_offset_parsed);
    const zrangebylex_bad_offset_reply: CommandReply = command_execute_at(&engine, &zrangebylex_bad_offset_command, 1000u64);
