    _ = command_execute_at(&engine, &set_bar_command, 1000u64);
    resp_value_free(&set_bar_parsed.value);

    var keys_all_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nKEYS\r\n$1\r\n*\r\n"[0: 21]);
    const keys_all_command: Command = try command_executor_test_command(&router, &keys_all_parsed);
    var keys_all_reply: CommandReply = command_execute_at(&engine, &keys_all_command, 1000u64);
