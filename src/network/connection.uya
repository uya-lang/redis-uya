fn connection_transaction_empty() ConnectionTransaction {
    return ConnectionTransaction{
        active: false,
        queue: null as &RedisObject,
        queue_count: 0,
        watched: null as &RedisObject,
        watch_registered: false,
        watch_engine: null as &Engine,
        protocol_version: 2,
        client_fd: -1,
        created_ms: 0u64,
        last_interaction_ms: 0u64,
        query_buffer_len: 0,
        query_buffer_capacity: 0,
        output_buffer_len: 0,
        total_network_input: 0u64,
        client_memory_base: 0,
        command_name_len: 0,
        command_name: [],
        client_addr_len: 0,
        client_addr: [],
        client_local_addr_len: 0,
        client_local_addr: [],
        client_name_len: 0,
        client_name: [],
        client_lib_name_len: 0,
        client_lib_name: [],
        client_lib_ver_len: 0,
        client_lib_ver: [],
        username_len: 0,
        username: [],
        pubsub_count: 0,
        authenticated: false,
        tracking_enabled: false,
        tracking_redirect_id: -1,
        tracking_bcast: false,
        tracking_optin: false,
        tracking_optout: false,
        tracking_noloop: false,
        tracking_prefixes: null as &RedisObject,
        himport_fieldsets: null as &RedisObject,
        reply_off_enabled: false,
        reply_skip_next: false,
        caching_enabled: false,
        no_evict_enabled: false,
        no_touch_enabled: false,
        blocking_active: false,
        blocking_deadline_ms: 0u64,
        monitoring: false,
    };
}

export fn connection_transaction_new() ConnectionTransaction {
    return connection_transaction_empty();
}

export fn connection_transaction_set_memory_base(tx: &ConnectionTransaction, bytes: usize) void {
    if tx == null {
        return;
    }
    tx.client_memory_base = bytes;
}

export fn connection_transaction_reset(tx: &ConnectionTransaction) void {
    if tx == null {
        return;
    }
    if tx.monitoring && tx.client_fd >= 0 {
        connection_monitor_unregister_fd(tx.client_fd);
    }
    if tx.queue != null {
        object_free(tx.queue);
    }
    connection_transaction_clear_watches(tx);
    connection_client_tracking_clear(tx);
    if tx.himport_fieldsets != null {
        object_free(tx.himport_fieldsets);
        tx.himport_fieldsets = null as &RedisObject;
    }
    tx.active = false;
    tx.queue = null as &RedisObject;
    tx.queue_count = 0;
    tx.blocking_active = false;
    tx.blocking_deadline_ms = 0u64;
    tx.monitoring = false;
}

fn connection_transaction_clear_queue(tx: &ConnectionTransaction) void {
    if tx == null {
        return;
    }
    if tx.queue != null {
        object_free(tx.queue);
    }
    tx.active = false;
    tx.queue = null as &RedisObject;
    tx.queue_count = 0;
}

fn connection_transaction_clear_watches(tx: &ConnectionTransaction) void {
    if tx == null {
        return;
    }
    if tx.watched != null {
        object_free(tx.watched);
    }
    tx.watched = null as &RedisObject;
    if tx.watch_registered {
        engine_watch_unregister_client(tx.watch_engine);
    }
    tx.watch_registered = false;
    tx.watch_engine = null as &Engine;
}

fn connection_transaction_finish(tx: &ConnectionTransaction) void {
    if tx == null {
        return;
    }
    connection_transaction_clear_queue(tx);
    connection_transaction_clear_watches(tx);
    tx.blocking_active = false;
    tx.blocking_deadline_ms = 0u64;
}

fn connection_dummy_resp_parse_result() RespParseResult {
    return RespParseResult{
        value: RespValue{
            typ: RespType.resp_simple_string,
            data: connection_reply_empty_slice(),
            integer: 0,
            elements: null as &RespValue,
            element_count: 0,
        },
        consumed: 0,
        elements_owned: false,
    };
}

fn connection_dummy_command(router: &CommandRouter) Command {
    const info: CommandInfo = command_router_lookup(router, &"PING"[0: 4]) catch {
        return Command{
            info: CommandInfo{
                cmd_type: CommandType.command_ping,
                name: &"PING"[0: 4],
                arity: -1,
                flags: 0u64,
                first_key: 0,
                last_key: 0,
                key_step: 0,
            },
            argc: 0,
            request: null as &RespValue,
        };
    };
    return Command{
        info: info,
        argc: 0,
        request: null as &RespValue,
    };
}

fn connection_reply_empty_slice() &[byte] {
    return (null as &byte)[0: 0];
}

fn connection_zero_copy_process_result(
    response_head_len: usize,
    zero_copy_body: &[byte],
    zero_copy_tail_len: usize,
    consumed: usize,
    close_after: bool,
    request_replicaof: bool,
    replicaof_promote: bool,
    request_bgsave: bool,
    request_aof_rewrite: bool,
) ConnectionProcessResult {
    return ConnectionProcessResult{
        response_len: response_head_len + zero_copy_body.len + zero_copy_tail_len,
        response_head_len: response_head_len,
        zero_copy_body: zero_copy_body,
        zero_copy_tail_len: zero_copy_tail_len,
        consumed: consumed,
        close_after: close_after,
        request_replicaof: request_replicaof,
        replicaof_promote: replicaof_promote,
        request_bgsave: request_bgsave,
        request_aof_rewrite: request_aof_rewrite,
        request_shutdown: false,
        request_config_set: false,
        request_client_kill: false,
        client_kill_id: 0,
        client_kill_laddr_id: 0,
        client_kill_user_selector: CONNECTION_CLIENT_KILL_USER_NONE,
        client_kill_type_selector: CONNECTION_CLIENT_KILL_TYPE_NONE,
        client_kill_self: false,
        request_client_pause: false,
        client_pause_timeout_ms: 0u64,
        client_pause_write_only: false,
        client_pause_owner_id: 0,
        request_client_unpause: false,
        request_maxclients_set: false,
        maxclients_after: 0,
    };
}

fn connection_make_reply(typ: CommandReplyType, data: &[byte], integer: i64) CommandReply {
    return CommandReply{
        typ: typ,
        data: data,
        integer: integer,
        scan_cursor: 0u64,
        array_head: null,
        array_count: 0,
        owned_object: null,
        request_replicaof: false,
        replicaof_promote: false,
        replicaof_host: [],
        replicaof_port: 0,
        request_bgsave: false,
        request_aof_rewrite: false,
        request_config_set: false,
        request_client_kill: false,
        client_kill_id: 0,
        client_kill_laddr_id: 0,
        client_kill_user_selector: CONNECTION_CLIENT_KILL_USER_NONE,
        client_kill_type_selector: CONNECTION_CLIENT_KILL_TYPE_NONE,
        client_kill_self: false,
        request_client_pause: false,
        client_pause_timeout_ms: 0u64,
        client_pause_write_only: false,
        client_pause_owner_id: 0,
        request_client_unpause: false,
        request_maxclients_set: false,
        maxclients_after: 0,
    };
}

fn connection_error_reply(data: &[byte]) CommandReply {
    return connection_make_reply(CommandReplyType.reply_error, data, 0);
}

fn connection_copy_replica_host(dst: &[byte], src: [byte: 64]) void {
    var i: usize = 0;
    while i < dst.len && i < 64 {
        dst.ptr[i] = src[i];
        i = i + 1;
    }
}

fn connection_sds_append_u64(buf: &Sds, value: u64) !void {
    if value == 0u64 {
        try sds_cat(buf, &"0"[0: 1]);
        return;
    }
    var tmp: [byte: 20] = [];
    var count: usize = 0;
    var v: u64 = value;
    while v > 0u64 {
        const digit: u64 = v % 10u64;
        tmp[count] = (48u64 + digit) as byte;
        count = count + 1;
        v = v / 10u64;
    }
    while count > 0 {
        count = count - 1;
        try sds_cat(buf, tmp[count: 1]);
    }
}

fn connection_sds_append_i64(buf: &Sds, value: i64) !void {
    if value < 0 {
        try sds_cat(buf, &"-"[0: 1]);
        try connection_sds_append_u64(buf, (0 - value) as u64);
        return;
    }
    try connection_sds_append_u64(buf, value as u64);
}

fn connection_append_bulk_node_sds(buf: &Sds, node: &ListNode, count: usize) !void {
    var current: &ListNode = node;
    var emitted: usize = 0;
    while current != null && emitted < count {
        const data: &[byte] = current.value.value.buf[0: current.value.value.len];
        try sds_cat(buf, &"$"[0: 1]);
        try connection_sds_append_u64(buf, data.len as u64);
        try sds_cat(buf, &"\r\n"[0: 2]);
        try sds_cat(buf, data);
        try sds_cat(buf, &"\r\n"[0: 2]);
        current = current.next;
        emitted = emitted + 1;
    }
}

fn connection_append_reply_sds(buf: &Sds, reply: &CommandReply, protocol_version: i32) !void {
    if reply.typ == CommandReplyType.reply_simple_string {
        try sds_cat(buf, &"+"[0: 1]);
        try sds_cat(buf, reply.data);
        try sds_cat(buf, &"\r\n"[0: 2]);
        return;
    }
    if reply.typ == CommandReplyType.reply_error {
        try sds_cat(buf, &"-"[0: 1]);
        try sds_cat(buf, reply.data);
        try sds_cat(buf, &"\r\n"[0: 2]);
        return;
    }
    if reply.typ == CommandReplyType.reply_integer {
        try sds_cat(buf, &":"[0: 1]);
        try connection_sds_append_i64(buf, reply.integer);
        try sds_cat(buf, &"\r\n"[0: 2]);
        return;
    }
    if reply.typ == CommandReplyType.reply_bulk_string {
        try sds_cat(buf, &"$"[0: 1]);
        try connection_sds_append_u64(buf, reply.data.len as u64);
        try sds_cat(buf, &"\r\n"[0: 2]);
        try sds_cat(buf, reply.data);
        try sds_cat(buf, &"\r\n"[0: 2]);
        return;
    }
    if reply.typ == CommandReplyType.reply_null_bulk {
        if protocol_version == 3 {
            try sds_cat(buf, &"_\r\n"[0: 3]);
        } else {
            try sds_cat(buf, &"$-1\r\n"[0: 5]);
        }
        return;
    }
    if reply.typ == CommandReplyType.reply_array_bulk {
        try sds_cat(buf, &"*"[0: 1]);
        try connection_sds_append_u64(buf, reply.array_count as u64);
        try sds_cat(buf, &"\r\n"[0: 2]);
        try connection_append_bulk_node_sds(buf, reply.array_head, reply.array_count);
        return;
    }
    if reply.typ == CommandReplyType.reply_array_nullable_bulk {
        try sds_cat(buf, &"*"[0: 1]);
        try connection_sds_append_u64(buf, reply.array_count as u64);
        try sds_cat(buf, &"\r\n"[0: 2]);
        var node_nullable: &ListNode = reply.array_head;
        var count_nullable: usize = 0;
        while node_nullable != null && count_nullable < reply.array_count {
            const is_null: bool = count_nullable < reply.data.len && reply.data.ptr[count_nullable] != 0 as byte;
            if is_null {
                if protocol_version == 3 {
                    try sds_cat(buf, &"_\r\n"[0: 3]);
                } else {
                    try sds_cat(buf, &"$-1\r\n"[0: 5]);
                }
            } else {
                const data_nullable: &[byte] = node_nullable.value.value.buf[0: node_nullable.value.value.len];
                try sds_cat(buf, &"$"[0: 1]);
                try connection_sds_append_u64(buf, data_nullable.len as u64);
                try sds_cat(buf, &"\r\n"[0: 2]);
                try sds_cat(buf, data_nullable);
                try sds_cat(buf, &"\r\n"[0: 2]);
            }
            node_nullable = node_nullable.next;
            count_nullable = count_nullable + 1;
        }
        return;
    }
    if reply.typ == CommandReplyType.reply_scan {
        try sds_cat(buf, &"*2\r\n"[0: 4]);
        try sds_cat(buf, &"$"[0: 1]);
        try connection_sds_append_u64(buf, connection_u64_decimal_len(reply.scan_cursor) as u64);
        try sds_cat(buf, &"\r\n"[0: 2]);
        try connection_sds_append_u64(buf, reply.scan_cursor);
        try sds_cat(buf, &"\r\n"[0: 2]);
        try sds_cat(buf, &"*"[0: 1]);
        try connection_sds_append_u64(buf, reply.array_count as u64);
        try sds_cat(buf, &"\r\n"[0: 2]);
        try connection_append_bulk_node_sds(buf, reply.array_head, reply.array_count);
        return;
    }
    if reply.typ == CommandReplyType.reply_raw_bytes {
        try sds_cat(buf, reply.data);
        return;
    }
}

fn connection_transaction_ensure_queue(tx: &ConnectionTransaction) !&RedisObject {
    if tx.queue != null {
        return tx.queue;
    }
    const queue: &RedisObject = create_list_object() catch {
        return error.AllocOutOfMemory;
    };
    tx.queue = queue;
    return queue;
}

fn connection_transaction_queue_command(tx: &ConnectionTransaction, raw: &[byte]) !void {
    const queue: &RedisObject = try connection_transaction_ensure_queue(tx);
    _ = try list_object_push_tail(queue, raw);
    tx.queue_count = tx.queue_count + 1;
}

fn connection_transaction_multi_memory(tx: &ConnectionTransaction) usize {
    if tx == null || tx.queue == null || tx.queue_count == 0 {
        return 0;
    }
    var total: usize = 0;
    var node: &ListNode = tx.queue.list_head;
    var count: usize = 0;
    while node != null && count < tx.queue_count {
        total = total + node.value.value.len;
        node = node.next;
        count = count + 1;
    }
    return total;
}

fn connection_client_owned_sds_memory(value: &Sds) usize {
    if value == null || value.buf.ptr == null {
        return 0;
    }
    return value.alloc + 1;
}

fn connection_client_owned_dict_memory(dict: &Dict) usize {
    var total: usize = dict_bucket_count(dict) * dict_bucket_layout_size();
    var iter: DictIterator = dict_iter_new();
    var entry: &DictEntry = dict_iter_next(dict, &iter);
    while entry != null {
        total = total + dict_entry_layout_size();
        total = total + connection_client_owned_sds_memory(&entry.key);
        const value: &RedisObject = @ptr_from_usize(entry.value) as &RedisObject;
        total = total + connection_client_owned_object_memory(value);
        entry = dict_iter_next(dict, &iter);
    }
    return total;
}

fn connection_client_owned_object_memory(obj: &RedisObject) usize {
    if obj == null {
        return 0;
    }
    var total: usize = object_layout_size() + connection_client_owned_sds_memory(&obj.value);
    if obj.obj_type == ObjectType.object_list {
        var node: &ListNode = obj.list_head;
        while node != null {
            total = total + list_node_layout_size();
            total = total + connection_client_owned_object_memory(node.value);
            node = node.next;
        }
        return total;
    }
    if obj.obj_type == ObjectType.object_hash ||
        obj.obj_type == ObjectType.object_set ||
        obj.obj_type == ObjectType.object_zset {
        total = total + connection_client_owned_dict_memory(&obj.hash_dict);
        total = total + connection_client_owned_dict_memory(&obj.hash_expire_dict);
    }
    return total;
}

fn connection_client_total_memory(tx: &ConnectionTransaction) usize {
    if tx == null {
        return 0;
    }
    var total: usize = tx.client_memory_base;
    if total == 0 {
        total = (@size_of(ConnectionTransaction) as usize) + tx.query_buffer_capacity + CONNECTION_CLIENT_REPLY_BUFFER_CAP;
    }
    total = total + connection_client_owned_object_memory(tx.queue);
    total = total + connection_client_owned_object_memory(tx.watched);
    total = total + connection_client_owned_object_memory(tx.tracking_prefixes);
    total = total + connection_client_owned_object_memory(tx.himport_fieldsets);
    return total;
}

fn connection_parse_u64(data: &[byte]) !u64 {
    if data.len == 0 {
        return error.ConnectionIoFailed;
    }
    var value: u64 = 0u64;
    var i: usize = 0;
    while i < data.len {
        const ch: byte = data.ptr[i];
        if ch < 48 as byte || ch > 57 as byte {
            return error.ConnectionIoFailed;
        }
        value = value * 10u64 + ((ch - 48 as byte) as u64);
        i = i + 1;
    }
    return value;
}

fn connection_validate_float_token(data: &[byte]) bool {
    if data.len == 0 {
        return false;
    }
    var index: usize = 0;
    if data.ptr[index] == 43 as byte || data.ptr[index] == 45 as byte {
        index = index + 1;
        if index >= data.len {
            return false;
        }
    }

    var digits_before: usize = 0;
    while index < data.len && data.ptr[index] >= 48 as byte && data.ptr[index] <= 57 as byte {
        digits_before = digits_before + 1;
        index = index + 1;
    }

    var digits_after: usize = 0;
    if index < data.len && data.ptr[index] == 46 as byte {
        index = index + 1;
        while index < data.len && data.ptr[index] >= 48 as byte && data.ptr[index] <= 57 as byte {
            digits_after = digits_after + 1;
            index = index + 1;
        }
    }

    if digits_before + digits_after == 0 {
        return false;
    }

    if index < data.len && (data.ptr[index] == 101 as byte || data.ptr[index] == 69 as byte) {
        index = index + 1;
        if index >= data.len {
            return false;
        }
        if data.ptr[index] == 43 as byte || data.ptr[index] == 45 as byte {
            index = index + 1;
            if index >= data.len {
                return false;
            }
        }
        var exp_digits: usize = 0;
        while index < data.len && data.ptr[index] >= 48 as byte && data.ptr[index] <= 57 as byte {
            exp_digits = exp_digits + 1;
            index = index + 1;
        }
        if exp_digits == 0 {
            return false;
        }
    }

    return index == data.len;
}

fn connection_parse_blocking_timeout_ms(data: &[byte]) !u64 {
    if !connection_validate_float_token(data) || data.len >= 255usize {
        return error.ConnectionIoFailed;
    }
    var buf: [byte: 256] = [];
    var index: usize = 0;
    while index < data.len {
        buf[index] = data.ptr[index];
        index = index + 1;
    }
    buf[data.len] = 0 as byte;
    const parsed: f64 = strtod(&buf[0], null);
    if isnan(parsed) != 0 || isinf(parsed) != 0 || parsed < 0.0 || parsed > 18446744073709551.0 {
        return error.ConnectionIoFailed;
    }
    return (parsed * 1000.0) as u64;
}

fn connection_blocking_clear(tx: &ConnectionTransaction) void {
    tx.blocking_active = false;
    tx.blocking_deadline_ms = 0u64;
    connection_client_registry_sync(tx);
}

fn connection_command_is_blocking_pop(cmd_type: CommandType) bool {
    return cmd_type == CommandType.command_blpop ||
        cmd_type == CommandType.command_brpop ||
        cmd_type == CommandType.command_blmove ||
        cmd_type == CommandType.command_blmovem ||
        cmd_type == CommandType.command_blmpop ||
        cmd_type == CommandType.command_brpoplpush ||
        cmd_type == CommandType.command_bzpopmax ||
        cmd_type == CommandType.command_bzpopmin ||
        cmd_type == CommandType.command_bzmpop;
}

fn connection_lookup_key_for_client_at(engine: &Engine, tx: &ConnectionTransaction, key: &[byte], now_ms: u64) !&RedisObject {
    if tx != null && tx.no_touch_enabled {
        return lookup_key_no_touch_at(engine, key, now_ms);
    }
    return lookup_key_at(engine, key, now_ms);
}

fn connection_should_block_pop_command(engine: &Engine, tx: &ConnectionTransaction, command: &Command, now_ms: u64) bool {
    if command.info.cmd_type == CommandType.command_blpop || command.info.cmd_type == CommandType.command_brpop {
        var index: usize = 1;
        while index + 1 < command.argc {
            const key: &[byte] = command_arg_data(command, index) catch {
                return false;
            };
            const obj_result: !&RedisObject = connection_lookup_key_for_client_at(engine, tx, key, now_ms);
            if obj_result.error_id != 0 {
                index = index + 1;
                continue;
            }
            const obj: &RedisObject = obj_result.value;
            if obj.obj_type != ObjectType.object_list {
                return false;
            }
            if obj.list_len > 0 {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    if command.info.cmd_type == CommandType.command_blmovem {
        if command.argc != 6 && command.argc != 9 {
            return false;
        }
        const wherefrom_movem: &[byte] = command_arg_data(command, 3) catch {
            return false;
        };
        const whereto_movem: &[byte] = command_arg_data(command, 4) catch {
            return false;
        };
        if (!connection_keyword_eq(wherefrom_movem, &"LEFT"[0: 4]) &&
                !connection_keyword_eq(wherefrom_movem, &"RIGHT"[0: 5])) ||
            (!connection_keyword_eq(whereto_movem, &"LEFT"[0: 4]) &&
                !connection_keyword_eq(whereto_movem, &"RIGHT"[0: 5])) {
            return false;
        }

        var exactly_movem: bool = false;
        var required_movem: usize = 1;
        if command.argc == 9 {
            const selector_movem: &[byte] = command_arg_data(command, 6) catch {
                return false;
            };
            if connection_keyword_eq(selector_movem, &"EXACTLY"[0: 7]) {
                exactly_movem = true;
            } else if !connection_keyword_eq(selector_movem, &"COUNT"[0: 5]) {
                return false;
            }
            const count_data_movem: &[byte] = command_arg_data(command, 7) catch {
                return false;
            };
            const count_movem: u64 = connection_parse_u64(count_data_movem) catch {
                return false;
            };
            if count_movem == 0u64 || count_movem > 9223372036854775807u64 {
                return false;
            }
            const ordering_movem: &[byte] = command_arg_data(command, 8) catch {
                return false;
            };
            if !connection_keyword_eq(ordering_movem, &"OBO"[0: 3]) &&
                !connection_keyword_eq(ordering_movem, &"BULK"[0: 4]) {
                return false;
            }
            if exactly_movem {
                required_movem = count_movem as usize;
            }
        }

        const source_movem: &[byte] = command_arg_data(command, 1) catch {
            return false;
        };
        const obj_movem: &RedisObject = connection_lookup_key_for_client_at(engine, tx, source_movem, now_ms) catch {
            return true;
        };
        if obj_movem.obj_type != ObjectType.object_list {
            return false;
        }
        return obj_movem.list_len < required_movem;
    }

    if command.info.cmd_type == CommandType.command_blmove ||
        command.info.cmd_type == CommandType.command_brpoplpush {
        const source: &[byte] = command_arg_data(command, 1) catch {
            return false;
        };
        const obj: &RedisObject = connection_lookup_key_for_client_at(engine, tx, source, now_ms) catch {
            return true;
        };
        if obj.obj_type != ObjectType.object_list {
            return false;
        }
        return obj.list_len == 0;
    }

    if command.info.cmd_type == CommandType.command_bzpopmax || command.info.cmd_type == CommandType.command_bzpopmin {
        var index_z: usize = 1;
        while index_z + 1 < command.argc {
            const key_z: &[byte] = command_arg_data(command, index_z) catch {
                return false;
            };
            const obj_result_z: !&RedisObject = connection_lookup_key_for_client_at(engine, tx, key_z, now_ms);
            if obj_result_z.error_id != 0 {
                index_z = index_z + 1;
                continue;
            }
            const obj_z: &RedisObject = obj_result_z.value;
            if obj_z.obj_type != ObjectType.object_zset {
                return false;
            }
            const zset_len: usize = zset_object_len(obj_z) catch {
                return false;
            };
            if zset_len > 0 {
                return false;
            }
            index_z = index_z + 1;
        }
        return true;
    }

    if command.info.cmd_type == CommandType.command_bzmpop {
        const numkeys_data: &[byte] = command_arg_data(command, 2) catch {
            return false;
        };
        const numkeys_u64: u64 = connection_parse_u64(numkeys_data) catch {
            return false;
        };
        if numkeys_u64 == 0u64 {
            return false;
        }
        var index_bzm: usize = 3;
        const end_bzm: usize = 3 + numkeys_u64 as usize;
        while index_bzm < end_bzm {
            const key_bzm: &[byte] = command_arg_data(command, index_bzm) catch {
                return false;
            };
            const obj_result_bzm: !&RedisObject = connection_lookup_key_for_client_at(engine, tx, key_bzm, now_ms);
            if obj_result_bzm.error_id != 0 {
                index_bzm = index_bzm + 1;
                continue;
            }
            const obj_bzm: &RedisObject = obj_result_bzm.value;
            if obj_bzm.obj_type != ObjectType.object_zset {
                return false;
            }
            const zset_len_bzm: usize = zset_object_len(obj_bzm) catch {
                return false;
            };
            if zset_len_bzm > 0 {
                return false;
            }
            index_bzm = index_bzm + 1;
        }
        return true;
    }

    if command.info.cmd_type == CommandType.command_blmpop {
        const numkeys_data_blm: &[byte] = command_arg_data(command, 2) catch {
            return false;
        };
        const numkeys_u64_blm: u64 = connection_parse_u64(numkeys_data_blm) catch {
            return false;
        };
        if numkeys_u64_blm == 0u64 {
            return false;
        }
        var index_blm: usize = 3;
        const end_blm: usize = 3 + numkeys_u64_blm as usize;
        while index_blm < end_blm {
            const key_blm: &[byte] = command_arg_data(command, index_blm) catch {
                return false;
            };
            const obj_result_blm: !&RedisObject = connection_lookup_key_for_client_at(engine, tx, key_blm, now_ms);
            if obj_result_blm.error_id != 0 {
                index_blm = index_blm + 1;
                continue;
            }
            const obj_blm: &RedisObject = obj_result_blm.value;
            if obj_blm.obj_type != ObjectType.object_list {
                return false;
            }
            if obj_blm.list_len > 0 {
                return false;
            }
            index_blm = index_blm + 1;
        }
        return true;
    }

    return false;
}

fn connection_transaction_ensure_watched(tx: &ConnectionTransaction) !&RedisObject {
    if tx.watched != null {
        return tx.watched;
    }
    const watched: &RedisObject = create_hash_object() catch {
        return error.AllocOutOfMemory;
    };
    tx.watched = watched;
    return watched;
}

fn connection_transaction_watch_key(tx: &ConnectionTransaction, engine: &Engine, key: &[byte]) !void {
    const watched: &RedisObject = try connection_transaction_ensure_watched(tx);
    var version_buf: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&version_buf);
    }
    try connection_sds_append_u64(&version_buf, engine_watch_version(engine, key));
    _ = try hash_object_set_field(watched, key, version_buf.buf[0: version_buf.len]);
    if !tx.watch_registered {
        engine_watch_register_client(engine);
        tx.watch_registered = true;
        tx.watch_engine = engine;
    }
}

fn connection_transaction_watches_match(tx: &ConnectionTransaction, engine: &Engine) bool {
    if tx == null || tx.watched == null {
        return true;
    }

    var iter: DictIterator = dict_iter_new();
    var entry: &DictEntry = dict_iter_next(&tx.watched.hash_dict, &iter);
    while entry != null {
        const key: &[byte] = entry.key.buf[0: entry.key.len];
        const version_obj_result: !&RedisObject = hash_object_get_field(tx.watched, key);
        const version_obj: &RedisObject = version_obj_result catch {
            return false;
        };
        const watched_version: u64 = connection_parse_u64(version_obj.value.buf[0: version_obj.value.len]) catch {
            return false;
        };
        if engine_watch_version(engine, key) != watched_version {
            return false;
        }
        entry = dict_iter_next(&tx.watched.hash_dict, &iter);
    }
    return true;
}

fn connection_raw_reply_owned(data: &[byte]) CommandReply {
    const obj: &RedisObject = create_string_object(data) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    var reply: CommandReply = connection_make_reply(CommandReplyType.reply_raw_bytes, obj.value.buf[0: obj.value.len], 0);
    reply.owned_object = obj;
    return reply;
}

fn connection_bulk_reply_owned(data: &[byte]) CommandReply {
    const obj: &RedisObject = create_string_object(data) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    var reply: CommandReply = connection_make_reply(CommandReplyType.reply_bulk_string, obj.value.buf[0: obj.value.len], 0);
    reply.owned_object = obj;
    return reply;
}

fn connection_owned_error(data: &[byte]) CommandReply {
    const obj: &RedisObject = create_string_object(data) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    var reply: CommandReply = connection_error_reply(obj.value.buf[0: obj.value.len]);
    reply.owned_object = obj;
    return reply;
}

fn connection_array_reply_owned(list: &RedisObject, count: usize) CommandReply {
    var reply: CommandReply = connection_make_reply(CommandReplyType.reply_array_bulk, connection_reply_empty_slice(), 0);
    reply.array_head = list.list_head;
    reply.array_count = count;
    reply.owned_object = list;
    return reply;
}

fn connection_ascii_lower(ch: byte) byte {
    if ch >= 65 as byte && ch <= 90 as byte {
        return ch + 32 as byte;
    }
    return ch;
}

fn connection_keyword_eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if connection_ascii_lower(a.ptr[i]) != connection_ascii_lower(b.ptr[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn connection_slice_eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if a.ptr[i] != b.ptr[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn connection_sds_append_ascii_lower(buf: &Sds, data: &[byte]) !void {
    var tmp: [byte: 1] = [];
    var i: usize = 0;
    while i < data.len {
        tmp[0] = connection_ascii_lower(data.ptr[i]);
        try sds_cat(buf, tmp[0: 1]);
        i = i + 1;
    }
}

fn connection_sha1_rotl32(x: u32, n: i32) u32 {
    return (x << n) | (x >> (32 - n));
}

fn connection_sha1_load_be32(block: &[byte], off: usize) u32 {
    return ((block.ptr[off] as u32) << 24) |
        ((block.ptr[off + 1] as u32) << 16) |
        ((block.ptr[off + 2] as u32) << 8) |
        (block.ptr[off + 3] as u32);
}

fn connection_sha1_digest(data: &[byte], digest: &[byte]) void {
    if digest.len < CONNECTION_SCRIPT_SHA1_BYTES {
        return;
    }
    var h: [u32: 5] = [
        0x67452301 as u32,
        0xefcdab89 as u32,
        0x98badcfe as u32,
        0x10325476 as u32,
        0xc3d2e1f0 as u32,
    ];
    var off: usize = 0;
    var schedule: [u32: 80] = [];
    while off + 64 <= data.len {
        var t: usize = 0;
        while t < 16 {
            schedule[t] = connection_sha1_load_be32(data[off: data.len - off], t * 4);
            t = t + 1;
        }
        while t < 80 {
            const tm3: usize = t - 3;
            const tm8: usize = t - 8;
            const tm14: usize = t - 14;
            const tm16: usize = t - 16;
            if tm3 < 80 && tm8 < 80 && tm14 < 80 && tm16 < 80 && t < 80 {
                schedule[t] = connection_sha1_rotl32(schedule[tm3] ^ schedule[tm8] ^ schedule[tm14] ^ schedule[tm16], 1);
            }
            t = t + 1;
        }
        var a: u32 = h[0];
        var b: u32 = h[1];
        var c: u32 = h[2];
        var d: u32 = h[3];
        var e: u32 = h[4];
        var round: usize = 0;
        while round < 80 {
            var f: u32 = 0u32;
            var k: u32 = 0u32;
            if round < 20 {
                f = (b & c) | ((~b) & d);
                k = 0x5a827999 as u32;
            } else if round < 40 {
                f = b ^ c ^ d;
                k = 0x6ed9eba1 as u32;
            } else if round < 60 {
                f = (b & c) | (b & d) | (c & d);
                k = 0x8f1bbcdc as u32;
            } else {
                f = b ^ c ^ d;
                k = 0xca62c1d6 as u32;
            }
            const tmp: u32 = connection_sha1_rotl32(a, 5) + f + e + k + schedule[round];
            e = d;
            d = c;
            c = connection_sha1_rotl32(b, 30);
            b = a;
            a = tmp;
            round = round + 1;
        }
        h[0] = h[0] + a;
        h[1] = h[1] + b;
        h[2] = h[2] + c;
        h[3] = h[3] + d;
        h[4] = h[4] + e;
        off = off + 64;
    }

    var tail: [byte: 128] = [];
    const remain: usize = data.len - off;
    var i: usize = 0;
    while i < remain {
        tail[i] = data.ptr[off + i];
        i = i + 1;
    }
    tail[remain] = 0x80 as byte;
    const rem1: usize = remain + 1;
    var pad: usize = (64usize - ((rem1 + 8usize) % 64usize)) % 64usize;
    i = 0;
    while i < pad {
        tail[rem1 + i] = 0 as byte;
        i = i + 1;
    }
    const bitlen: u64 = (data.len as u64) * 8u64;
    const len_off: usize = rem1 + pad;
    var bi: i32 = 0;
    while bi < 8 {
        const sh: i32 = (7 - bi) * 8;
        tail[len_off + bi as usize] = ((bitlen >> sh) & 0xffu64) as byte;
        bi = bi + 1;
    }
    const total: usize = rem1 + pad + 8;
    var block_off: usize = 0;
    while block_off < total {
        var t2: usize = 0;
        while t2 < 16 {
            schedule[t2] = connection_sha1_load_be32(tail[block_off: total - block_off], t2 * 4);
            t2 = t2 + 1;
        }
        while t2 < 80 {
            const tm3_2: usize = t2 - 3;
            const tm8_2: usize = t2 - 8;
            const tm14_2: usize = t2 - 14;
            const tm16_2: usize = t2 - 16;
            if tm3_2 < 80 && tm8_2 < 80 && tm14_2 < 80 && tm16_2 < 80 && t2 < 80 {
                schedule[t2] = connection_sha1_rotl32(schedule[tm3_2] ^ schedule[tm8_2] ^ schedule[tm14_2] ^ schedule[tm16_2], 1);
            }
            t2 = t2 + 1;
        }
        var a2: u32 = h[0];
        var b2: u32 = h[1];
        var c2: u32 = h[2];
        var d2: u32 = h[3];
        var e2: u32 = h[4];
        var round2: usize = 0;
        while round2 < 80 {
            var f2: u32 = 0u32;
            var k2: u32 = 0u32;
            if round2 < 20 {
                f2 = (b2 & c2) | ((~b2) & d2);
                k2 = 0x5a827999 as u32;
            } else if round2 < 40 {
                f2 = b2 ^ c2 ^ d2;
                k2 = 0x6ed9eba1 as u32;
            } else if round2 < 60 {
                f2 = (b2 & c2) | (b2 & d2) | (c2 & d2);
                k2 = 0x8f1bbcdc as u32;
            } else {
                f2 = b2 ^ c2 ^ d2;
                k2 = 0xca62c1d6 as u32;
            }
            const tmp2: u32 = connection_sha1_rotl32(a2, 5) + f2 + e2 + k2 + schedule[round2];
            e2 = d2;
            d2 = c2;
            c2 = connection_sha1_rotl32(b2, 30);
            b2 = a2;
            a2 = tmp2;
            round2 = round2 + 1;
        }
        h[0] = h[0] + a2;
        h[1] = h[1] + b2;
        h[2] = h[2] + c2;
        h[3] = h[3] + d2;
        h[4] = h[4] + e2;
        block_off = block_off + 64;
    }

    var di: usize = 0;
    while di < 5 {
        const word: u32 = h[di];
        digest.ptr[di * 4] = ((word >> 24) & 0xffu32) as byte;
        digest.ptr[di * 4 + 1] = ((word >> 16) & 0xffu32) as byte;
        digest.ptr[di * 4 + 2] = ((word >> 8) & 0xffu32) as byte;
        digest.ptr[di * 4 + 3] = (word & 0xffu32) as byte;
        di = di + 1;
    }
}

fn connection_script_hex_nibble(value: byte) byte {
    if value < 10 as byte {
        return (48 as byte) + value;
    }
    return (97 as byte) + (value - 10 as byte);
}

fn connection_script_sha_hex(script: &[byte], sha_hex: &[byte]) void {
    if sha_hex.len < CONNECTION_SCRIPT_SHA1_HEX_BYTES {
        return;
    }
    var digest: [byte: CONNECTION_SCRIPT_SHA1_BYTES] = [];
    connection_sha1_digest(script, digest[0: CONNECTION_SCRIPT_SHA1_BYTES]);
    var i: usize = 0;
    while i < CONNECTION_SCRIPT_SHA1_BYTES {
        const value: byte = digest[i];
        sha_hex.ptr[i * 2] = connection_script_hex_nibble((value >> 4) & (15 as byte));
        sha_hex.ptr[i * 2 + 1] = connection_script_hex_nibble(value & (15 as byte));
        i = i + 1;
    }
}

fn connection_script_cache_find_sha(sha_hex: &[byte]) i32 {
    if sha_hex.len != CONNECTION_SCRIPT_SHA1_HEX_BYTES {
        return -1;
    }
    var index: usize = 0;
    while index < CONNECTION_SCRIPT_CACHE_MAX {
        if connection_script_cache[index].active &&
            connection_keyword_eq(connection_script_cache[index].sha_hex[0: CONNECTION_SCRIPT_SHA1_HEX_BYTES], sha_hex) {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_script_cache_find_free() i32 {
    var index: usize = 0;
    while index < CONNECTION_SCRIPT_CACHE_MAX {
        if !connection_script_cache[index].active {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_script_cache_store(script: &[byte], sha_out: &[byte]) !void {
    connection_script_sha_hex(script, sha_out);
    const existing: i32 = connection_script_cache_find_sha(sha_out);
    if existing >= 0 {
        return;
    }
    const slot: i32 = connection_script_cache_find_free();
    if slot < 0 {
        return error.AllocOutOfMemory;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_SCRIPT_CACHE_MAX {
        return error.AllocOutOfMemory;
    }
    const obj: &RedisObject = create_string_object(script) catch {
        return error.AllocOutOfMemory;
    };
    connection_script_cache[slot_index].active = true;
    connection_script_cache[slot_index].script = obj;
    var i: usize = 0;
    while i < CONNECTION_SCRIPT_SHA1_HEX_BYTES {
        connection_script_cache[slot_index].sha_hex[i] = sha_out.ptr[i];
        i = i + 1;
    }
}

fn connection_script_cache_lookup_script(sha_hex: &[byte]) !&[byte] {
    const slot: i32 = connection_script_cache_find_sha(sha_hex);
    if slot < 0 {
        return error.ConnectionScriptCacheMiss;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_SCRIPT_CACHE_MAX {
        return error.ConnectionScriptCacheMiss;
    }
    const obj: &RedisObject = connection_script_cache[slot_index].script;
    if obj == null {
        return error.ConnectionScriptCacheMiss;
    }
    return obj.value.buf[0: obj.value.len];
}

fn connection_script_cache_exists(sha_hex: &[byte]) bool {
    return connection_script_cache_find_sha(sha_hex) >= 0;
}

fn connection_script_cache_flush_all() void {
    var index: usize = 0;
    while index < CONNECTION_SCRIPT_CACHE_MAX {
        if connection_script_cache[index].active {
            if connection_script_cache[index].script != null {
                object_free(connection_script_cache[index].script);
                connection_script_cache[index].script = null as &RedisObject;
            }
            connection_script_cache[index].active = false;
        }
        index = index + 1;
    }
}

fn connection_function_name_valid(name: &[byte]) bool {
    if name.len == 0 || name.len > CONNECTION_FUNCTION_NAME_MAX {
        return false;
    }
    var index: usize = 0;
    while index < name.len {
        const ch: byte = name.ptr[index];
        const alpha: bool = (ch >= 65 as byte && ch <= 90 as byte) || (ch >= 97 as byte && ch <= 122 as byte);
        const digit: bool = ch >= 48 as byte && ch <= 57 as byte;
        if !alpha && !digit && ch != 45 as byte && ch != 95 as byte {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn connection_function_copy_name(dst: &[byte], src: &[byte]) void {
    var index: usize = 0;
    while index < dst.len {
        dst.ptr[index] = 0 as byte;
        index = index + 1;
    }
    index = 0;
    while index < src.len && index < dst.len {
        dst.ptr[index] = src.ptr[index];
        index = index + 1;
    }
}

fn connection_function_find_library(name: &[byte]) i32 {
    var index: usize = 0;
    while index < CONNECTION_FUNCTION_LIBRARY_MAX {
        if connection_function_libraries[index].active &&
            connection_slice_eq(connection_function_libraries[index].library_name[0: connection_function_libraries[index].library_name_len], name) {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_function_find_name(name: &[byte], library_index: &usize, function_index: &usize) bool {
    var library: usize = 0;
    while library < CONNECTION_FUNCTION_LIBRARY_MAX {
        if connection_function_libraries[library].active {
            var function: usize = 0;
            while function < CONNECTION_FUNCTIONS_PER_LIBRARY_MAX {
                if connection_function_libraries[library].functions[function].active &&
                    connection_slice_eq(connection_function_libraries[library].functions[function].function_name[0: connection_function_libraries[library].functions[function].function_name_len], name) {
                    *library_index = library;
                    *function_index = function;
                    return true;
                }
                function = function + 1;
            }
        }
        library = library + 1;
    }
    return false;
}

fn connection_function_find_free() i32 {
    var index: usize = 0;
    while index < CONNECTION_FUNCTION_LIBRARY_MAX {
        if !connection_function_libraries[index].active {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_function_clear_entry(entry: &ConnectionFunctionLibraryEntry) void {
    if !entry.active {
        return;
    }
    var function: usize = 0;
    while function < CONNECTION_FUNCTIONS_PER_LIBRARY_MAX {
        if entry.functions[function].script != null {
            object_free(entry.functions[function].script);
            entry.functions[function].script = null as &RedisObject;
        }
        entry.functions[function].active = false;
        entry.functions[function].no_writes = false;
        entry.functions[function].function_name_len = 0;
        entry.functions[function].has_description = false;
        entry.functions[function].description_len = 0;
        function = function + 1;
    }
    if entry.code != null {
        object_free(entry.code);
        entry.code = null as &RedisObject;
    }
    entry.active = false;
    entry.library_name_len = 0;
    entry.function_count = 0;
}

fn connection_function_clear_slot(index: usize) void {
    if index >= CONNECTION_FUNCTION_LIBRARY_MAX {
        return;
    }
    connection_function_clear_entry(&connection_function_libraries[index]);
}

fn connection_function_flush_all() void {
    var index: usize = 0;
    while index < CONNECTION_FUNCTION_LIBRARY_MAX {
        connection_function_clear_slot(index);
        index = index + 1;
    }
}

fn connection_function_restore_staging_clear_all() void {
    var index: usize = 0;
    while index < CONNECTION_FUNCTION_LIBRARY_MAX {
        connection_function_clear_entry(&connection_function_restore_staging[index]);
        index = index + 1;
    }
}

fn connection_function_move_entry(dst: &ConnectionFunctionLibraryEntry, src: &ConnectionFunctionLibraryEntry) void {
    connection_function_clear_entry(dst);
    dst.active = src.active;
    dst.library_name_len = src.library_name_len;
    connection_function_copy_name(dst.library_name[0: CONNECTION_FUNCTION_NAME_MAX], src.library_name[0: src.library_name_len]);
    dst.function_count = src.function_count;
    dst.code = src.code;
    src.code = null as &RedisObject;
    var function: usize = 0;
    while function < CONNECTION_FUNCTIONS_PER_LIBRARY_MAX {
        dst.functions[function].active = src.functions[function].active;
        dst.functions[function].no_writes = src.functions[function].no_writes;
        dst.functions[function].function_name_len = src.functions[function].function_name_len;
        connection_function_copy_name(
            dst.functions[function].function_name[0: CONNECTION_FUNCTION_NAME_MAX],
            src.functions[function].function_name[0: src.functions[function].function_name_len],
        );
        dst.functions[function].has_description = src.functions[function].has_description;
        dst.functions[function].description_len = src.functions[function].description_len;
        connection_function_copy_name(
            dst.functions[function].description[0: CONNECTION_FUNCTION_DESCRIPTION_MAX],
            src.functions[function].description[0: src.functions[function].description_len],
        );
        dst.functions[function].script = src.functions[function].script;
        src.functions[function].script = null as &RedisObject;
        src.functions[function].active = false;
        src.functions[function].function_name_len = 0;
        src.functions[function].description_len = 0;
        function = function + 1;
    }
    src.active = false;
    src.library_name_len = 0;
    src.function_count = 0;
}

fn connection_function_find_prefix(source: &[byte], start: usize, prefix: &[byte]) i32 {
    if prefix.len == 0 || start >= source.len {
        return -1;
    }
    var index: usize = start;
    while index + prefix.len <= source.len {
        if connection_script_match_prefix(source, index, prefix) {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_function_find_registration_marker(source: &[byte], start: usize) i32 {
    const marker: &[byte] = &"redis.register_function"[0: 23];
    var search_start: usize = start;
    while search_start < source.len {
        const marker_relative: i32 = connection_function_find_prefix(source, search_start, marker);
        if marker_relative < 0 {
            return -1;
        }
        const marker_index: usize = marker_relative as usize;
        var after_marker: usize = marker_index + marker.len;
        connection_script_skip_space(source, &after_marker);
        if after_marker < source.len && (source.ptr[after_marker] == 40 as byte || source.ptr[after_marker] == 123 as byte) {
            return marker_index as i32;
        }
        search_start = marker_index + marker.len;
    }
    return -1;
}

fn connection_function_find_table_field(code: &[byte], start: usize, end: usize, field: &[byte]) i32 {
    var search_start: usize = start;
    while search_start < end {
        const relative: i32 = connection_function_find_prefix(code[search_start: end - search_start], 0, field);
        if relative < 0 {
            return -1;
        }
        const field_index: usize = search_start + relative as usize;
        var left: usize = field_index;
        while left > start && connection_script_is_space(code.ptr[left - 1]) {
            left = left - 1;
        }
        var right: usize = field_index + field.len;
        connection_script_skip_space(code, &right);
        if (left == start || code.ptr[left - 1] == 44 as byte) && right < end && code.ptr[right] == 61 as byte {
            return field_index as i32;
        }
        search_start = field_index + field.len;
    }
    return -1;
}

fn connection_function_extract_no_writes_at(code: &[byte], marker_index: usize, marker_end: usize) !bool {
    var index: usize = marker_index + 23;
    connection_script_skip_space(code, &index);
    if index >= marker_end || code.ptr[index] != 123 as byte {
        return false;
    }
    index = index + 1;
    const flags_field: i32 = connection_function_find_table_field(code, index, marker_end, &"flags"[0: 5]);
    if flags_field < 0 {
        return false;
    }
    index = flags_field as usize + 5;
    connection_script_skip_space(code, &index);
    if index >= marker_end || code.ptr[index] != 61 as byte {
        return error.ConnectionScriptUnsupported;
    }
    index = index + 1;
    connection_script_skip_space(code, &index);
    if index >= marker_end || code.ptr[index] != 123 as byte {
        return error.ConnectionScriptUnsupported;
    }
    index = index + 1;
    connection_script_skip_space(code, &index);
    if index >= marker_end || (code.ptr[index] != 39 as byte && code.ptr[index] != 34 as byte) {
        return error.ConnectionScriptUnsupported;
    }
    const quote: byte = code.ptr[index];
    index = index + 1;
    if !connection_script_match_prefix(code, index, &"no-writes"[0: 9]) {
        return error.ConnectionScriptUnsupported;
    }
    index = index + 9;
    if index >= marker_end || code.ptr[index] != quote {
        return error.ConnectionScriptUnsupported;
    }
    index = index + 1;
    connection_script_skip_space(code, &index);
    if index >= marker_end || code.ptr[index] != 125 as byte {
        return error.ConnectionScriptUnsupported;
    }
    return true;
}

fn connection_function_extract_description_at(code: &[byte], marker_index: usize, marker_end: usize, out_start: &usize, out_len: &usize) !bool {
    *out_start = 0;
    *out_len = 0;
    var index: usize = marker_index + 23;
    connection_script_skip_space(code, &index);
    if index >= marker_end || code.ptr[index] != 123 as byte {
        return false;
    }
    index = index + 1;
    const description_field: i32 = connection_function_find_table_field(code, index, marker_end, &"description"[0: 11]);
    if description_field < 0 {
        return false;
    }
    index = description_field as usize + 11;
    connection_script_skip_space(code, &index);
    if index >= marker_end || code.ptr[index] != 61 as byte {
        return error.ConnectionScriptUnsupported;
    }
    index = index + 1;
    connection_script_skip_space(code, &index);
    if index >= marker_end || (code.ptr[index] != 39 as byte && code.ptr[index] != 34 as byte) {
        return error.ConnectionScriptUnsupported;
    }
    const quote: byte = code.ptr[index];
    index = index + 1;
    const description_start: usize = index;
    while index < marker_end && code.ptr[index] != quote {
        if code.ptr[index] == 92 as byte || index - description_start >= CONNECTION_FUNCTION_DESCRIPTION_MAX {
            return error.ConnectionScriptUnsupported;
        }
        index = index + 1;
    }
    if index >= marker_end {
        return error.ConnectionScriptUnsupported;
    }
    *out_start = description_start;
    *out_len = index - description_start;
    return true;
}

fn connection_function_parse_name_after(source: &[byte], start: usize, out_len: &usize) !&[byte] {
    var index: usize = start;
    while index < source.len && connection_script_is_space(source.ptr[index]) {
        index = index + 1;
    }
    const name_start: usize = index;
    while index < source.len && !connection_script_is_space(source.ptr[index]) && source.ptr[index] != 39 as byte && source.ptr[index] != 34 as byte && source.ptr[index] != 40 as byte && source.ptr[index] != 41 as byte {
        index = index + 1;
    }
    const name: &[byte] = source[name_start: index - name_start];
    if !connection_function_name_valid(name) {
        return error.ConnectionScriptUnsupported;
    }
    *out_len = name.len;
    return name;
}

fn connection_function_extract_registered_name_at(code: &[byte], marker_index: usize, marker_end: usize, out_start: &usize, out_len: &usize) !void {
    const marker_len: usize = 23;
    if marker_index + marker_len > marker_end || marker_end > code.len {
        return error.ConnectionScriptUnsupported;
    }
    var index: usize = marker_index + marker_len;
    connection_script_skip_space(code, &index);
    if index >= marker_end {
        return error.ConnectionScriptUnsupported;
    }
    if code.ptr[index] == 123 as byte {
        index = index + 1;
        const name_field: i32 = connection_function_find_table_field(code, index, marker_end, &"function_name"[0: 13]);
        const callback_field: i32 = connection_function_find_table_field(code, index, marker_end, &"callback"[0: 8]);
        if name_field < 0 || callback_field < 0 {
            return error.ConnectionScriptUnsupported;
        }
        var callback_index: usize = callback_field as usize + 8;
        connection_script_skip_space(code, &callback_index);
        if callback_index >= marker_end || code.ptr[callback_index] != 61 as byte {
            return error.ConnectionScriptUnsupported;
        }
        callback_index = callback_index + 1;
        connection_script_skip_space(code, &callback_index);
        if !connection_script_match_prefix(code, callback_index, &"function"[0: 8]) {
            return error.ConnectionScriptUnsupported;
        }
        callback_index = callback_index + 8;
        connection_script_skip_space(code, &callback_index);
        if callback_index >= marker_end || code.ptr[callback_index] != 40 as byte {
            return error.ConnectionScriptUnsupported;
        }
        index = name_field as usize + 13;
        connection_script_skip_space(code, &index);
        if index >= marker_end || code.ptr[index] != 61 as byte {
            return error.ConnectionScriptUnsupported;
        }
        index = index + 1;
        connection_script_skip_space(code, &index);
    } else if code.ptr[index] == 40 as byte {
        index = index + 1;
        connection_script_skip_space(code, &index);
    } else {
        return error.ConnectionScriptUnsupported;
    }
    if index >= marker_end || (code.ptr[index] != 39 as byte && code.ptr[index] != 34 as byte) {
        return error.ConnectionScriptUnsupported;
    }
    const quote: byte = code.ptr[index];
    index = index + 1;
    const name_start: usize = index;
    while index < marker_end && code.ptr[index] != quote {
        if code.ptr[index] == 92 as byte {
            return error.ConnectionScriptUnsupported;
        }
        index = index + 1;
    }
    if index >= marker_end {
        return error.ConnectionScriptUnsupported;
    }
    const name: &[byte] = code[name_start: index - name_start];
    if !connection_function_name_valid(name) {
        return error.ConnectionScriptUnsupported;
    }
    *out_start = name_start;
    *out_len = name.len;
}

fn connection_function_extract_single_call_at(code: &[byte], start: usize, end: usize, out_start: &usize, out_len: &usize) !void {
    if start >= end || end > code.len {
        return error.ConnectionScriptUnsupported;
    }
    const return_relative: i32 = connection_function_find_prefix(code[start: end - start], 0, &"return redis.call"[0: 17]);
    if return_relative < 0 {
        return error.ConnectionScriptUnsupported;
    }
    const return_index: usize = start + return_relative as usize;
    const call_relative: i32 = connection_function_find_prefix(code[return_index: end - return_index], 0, &"redis.call"[0: 10]);
    if call_relative < 0 {
        return error.ConnectionScriptUnsupported;
    }
    var index: usize = return_index + call_relative as usize + 10;
    connection_script_skip_space(code, &index);
    if index >= end || code.ptr[index] != 40 as byte {
        return error.ConnectionScriptUnsupported;
    }
    var depth: usize = 0;
    var quote: byte = 0 as byte;
    while index < end {
        const ch: byte = code.ptr[index];
        if quote != 0 as byte {
            if ch == 92 as byte {
                index = index + 2;
                continue;
            }
            if ch == quote {
                quote = 0 as byte;
            }
        } else if ch == 39 as byte || ch == 34 as byte {
            quote = ch;
        } else if ch == 40 as byte {
            depth = depth + 1;
        } else if ch == 41 as byte {
            if depth == 0 {
                return error.ConnectionScriptUnsupported;
            }
            depth = depth - 1;
            if depth == 0 {
                *out_start = return_index;
                *out_len = index + 1 - return_index;
                return;
            }
        }
        index = index + 1;
    }
    return error.ConnectionScriptUnsupported;
}

fn connection_function_parse_entries(code: &[byte], entries: &[ConnectionFunctionParsedEntry], entry_count: &usize) !void {
    *entry_count = 0;
    var search_start: usize = 0;
    while search_start < code.len {
        const marker_relative: i32 = connection_function_find_registration_marker(code, search_start);
        if marker_relative < 0 {
            break;
        }
        const marker_index: usize = marker_relative as usize;
        const next_marker: i32 = connection_function_find_registration_marker(code, marker_index + 23);
        var marker_end: usize = code.len;
        if next_marker >= 0 {
            marker_end = next_marker as usize;
        }
        if *entry_count >= entries.len {
            return error.ConnectionScriptUnsupported;
        }
        var name_start: usize = 0;
        var name_len: usize = 0;
        try connection_function_extract_registered_name_at(code, marker_index, marker_end, &name_start, &name_len);
        var script_start: usize = 0;
        var script_len: usize = 0;
        try connection_function_extract_single_call_at(code, marker_index, marker_end, &script_start, &script_len);
        const no_writes: bool = try connection_function_extract_no_writes_at(code, marker_index, marker_end);
        var description_start: usize = 0;
        var description_len: usize = 0;
        const has_description: bool = try connection_function_extract_description_at(code, marker_index, marker_end, &description_start, &description_len);
        var previous: usize = 0;
        while previous < (*entry_count) {
            if entries.ptr[previous].name_len == name_len &&
                connection_slice_eq(code[entries.ptr[previous].name_start: entries.ptr[previous].name_len], code[name_start: name_len]) {
                return error.ConnectionScriptUnsupported;
            }
            previous = previous + 1;
        }
        entries.ptr[*entry_count].no_writes = no_writes;
        entries.ptr[*entry_count].name_start = name_start;
        entries.ptr[*entry_count].name_len = name_len;
        entries.ptr[*entry_count].has_description = has_description;
        entries.ptr[*entry_count].description_start = description_start;
        entries.ptr[*entry_count].description_len = description_len;
        entries.ptr[*entry_count].script_start = script_start;
        entries.ptr[*entry_count].script_len = script_len;
        *entry_count = *entry_count + 1;
        search_start = marker_end;
    }
    if *entry_count == 0 {
        return error.ConnectionScriptUnsupported;
    }
}

fn connection_function_normalize_script(script: &[byte]) !&RedisObject {
    var raw: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&raw);
    }
    var index: usize = 0;
    var quote: byte = 0 as byte;
    while index < script.len {
        const ch: byte = script.ptr[index];
        if quote != 0 as byte {
            _ = sds_cat(&raw, script[index: 1]) catch { return error.AllocOutOfMemory; };
            if ch == 92 as byte && index + 1 < script.len {
                index = index + 1;
                _ = sds_cat(&raw, script[index: 1]) catch { return error.AllocOutOfMemory; };
            } else if ch == quote {
                quote = 0 as byte;
            }
            index = index + 1;
            continue;
        }
        if ch == 39 as byte || ch == 34 as byte {
            quote = ch;
            _ = sds_cat(&raw, script[index: 1]) catch { return error.AllocOutOfMemory; };
            index = index + 1;
            continue;
        }
        if connection_script_match_prefix(script, index, &"keys["[0: 5]) {
            _ = sds_cat(&raw, &"KEYS["[0: 5]) catch { return error.AllocOutOfMemory; };
            index = index + 5;
            continue;
        }
        if connection_script_match_prefix(script, index, &"args["[0: 5]) {
            _ = sds_cat(&raw, &"ARGV["[0: 5]) catch { return error.AllocOutOfMemory; };
            index = index + 5;
            continue;
        }
        _ = sds_cat(&raw, script[index: 1]) catch { return error.AllocOutOfMemory; };
        index = index + 1;
    }
    _ = connection_script_validate_subset(raw.buf[0: raw.len]) catch {
        return error.ConnectionScriptUnsupported;
    };
    return create_string_object(raw.buf[0: raw.len]) catch {
        return error.AllocOutOfMemory;
    };
}

fn connection_function_prepare_entry(code: &[byte], entry: &ConnectionFunctionLibraryEntry) !void {
    if entry.active {
        return error.ConnectionScriptUnsupported;
    }
    if !connection_script_match_prefix(code, 0, &"#!lua name="[0: 11]) {
        return error.ConnectionScriptUnsupported;
    }
    var library_name_len: usize = 0;
    const library_name: &[byte] = try connection_function_parse_name_after(code, 11, &library_name_len);
    var parsed: [ConnectionFunctionParsedEntry: CONNECTION_FUNCTIONS_PER_LIBRARY_MAX] = [];
    var parsed_count: usize = 0;
    try connection_function_parse_entries(code, parsed[0: CONNECTION_FUNCTIONS_PER_LIBRARY_MAX], &parsed_count);

    var scripts: [&RedisObject: CONNECTION_FUNCTIONS_PER_LIBRARY_MAX] = [];
    var parsed_index: usize = 0;
    while parsed_index < parsed_count {
        scripts[parsed_index] = connection_function_normalize_script(code[parsed[parsed_index].script_start: parsed[parsed_index].script_len]) catch |err| {
            var cleanup_index: usize = 0;
            while cleanup_index < parsed_index {
                if scripts[cleanup_index] != null {
                    object_free(scripts[cleanup_index]);
                }
                cleanup_index = cleanup_index + 1;
            }
            return err;
        };
        parsed_index = parsed_index + 1;
    }
    const code_obj: &RedisObject = create_string_object(code) catch {
        parsed_index = 0;
        while parsed_index < parsed_count {
            object_free(scripts[parsed_index]);
            parsed_index = parsed_index + 1;
        }
        return error.AllocOutOfMemory;
    };

    entry.active = true;
    entry.library_name_len = library_name_len;
    connection_function_copy_name(entry.library_name[0: CONNECTION_FUNCTION_NAME_MAX], library_name);
    entry.function_count = parsed_count;
    entry.code = code_obj;
    parsed_index = 0;
    while parsed_index < parsed_count {
        entry.functions[parsed_index].active = true;
        entry.functions[parsed_index].no_writes = parsed[parsed_index].no_writes;
        entry.functions[parsed_index].function_name_len = parsed[parsed_index].name_len;
        connection_function_copy_name(
            entry.functions[parsed_index].function_name[0: CONNECTION_FUNCTION_NAME_MAX],
            code[parsed[parsed_index].name_start: parsed[parsed_index].name_len],
        );
        entry.functions[parsed_index].has_description = parsed[parsed_index].has_description;
        entry.functions[parsed_index].description_len = parsed[parsed_index].description_len;
        if parsed[parsed_index].description_len > 0 {
            connection_function_copy_name(
                entry.functions[parsed_index].description[0: CONNECTION_FUNCTION_DESCRIPTION_MAX],
                code[parsed[parsed_index].description_start: parsed[parsed_index].description_len],
            );
        }
        entry.functions[parsed_index].script = scripts[parsed_index];
        parsed_index = parsed_index + 1;
    }
}

fn connection_function_entry_find_name(entry: &ConnectionFunctionLibraryEntry, name: &[byte]) bool {
    if !entry.active {
        return false;
    }
    var function: usize = 0;
    while function < CONNECTION_FUNCTIONS_PER_LIBRARY_MAX {
        if entry.functions[function].active &&
            connection_slice_eq(entry.functions[function].function_name[0: entry.functions[function].function_name_len], name) {
            return true;
        }
        function = function + 1;
    }
    return false;
}

fn connection_function_staging_has_library_before(index: usize, name: &[byte]) bool {
    var current: usize = 0;
    while current < index {
        if connection_function_restore_staging[current].active &&
            connection_slice_eq(
                connection_function_restore_staging[current].library_name[0: connection_function_restore_staging[current].library_name_len],
                name,
            ) {
            return true;
        }
        current = current + 1;
    }
    return false;
}

fn connection_function_staging_has_name_before(index: usize, name: &[byte]) bool {
    var current: usize = 0;
    while current < index {
        if connection_function_entry_find_name(&connection_function_restore_staging[current], name) {
            return true;
        }
        current = current + 1;
    }
    return false;
}

fn connection_acl_default_denied_find(name: &[byte]) i32 {
    var index: usize = 0;
    while index < CONNECTION_ACL_DENIED_COMMAND_MAX {
        if connection_acl_default_denied_commands[index].active &&
            connection_keyword_eq(connection_acl_default_denied_commands[index].name[0: connection_acl_default_denied_commands[index].name_len], name) {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_acl_default_denied_find_free() i32 {
    var index: usize = 0;
    while index < CONNECTION_ACL_DENIED_COMMAND_MAX {
        if !connection_acl_default_denied_commands[index].active {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_acl_default_denied_clear_all() void {
    var index: usize = 0;
    while index < CONNECTION_ACL_DENIED_COMMAND_MAX {
        connection_acl_default_denied_commands[index].active = false;
        connection_acl_default_denied_commands[index].name_len = 0;
        index = index + 1;
    }
    connection_acl_default_denied_command_count = 0;
}

fn connection_acl_default_category_find(name: &[byte]) i32 {
    var index: usize = 0;
