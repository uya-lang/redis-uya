    resp_value_free(&copy_conflict_parsed.value);

    var copy_replace_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nCOPY\r\n$4\r\nnext\r\n$4\r\ncopy\r\n$7\r\nREPLACE\r\n"[0: 47]);
    const copy_replace_command: Command = try command_executor_test_command(&router, &copy_replace_parsed);
    const copy_replace_reply: CommandReply = command_execute_at(&engine, &copy_replace_command, 1000u64);
    try assert_eq_i32(copy_replace_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(copy_replace_reply.integer as i32, 1);
    resp_value_free(&copy_replace_parsed.value);

    var copy_db0_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nCOPY\r\n$4\r\nnext\r\n$7\r\ndbcopy0\r\n$2\r\nDB\r\n$1\r\n0\r\n"[0: 52]);
