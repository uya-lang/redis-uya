    const dst_obj: &RedisObject = try lookup_key_at(&engine, &"dst"[0: 3], 1000u64);
    try assert_eq_i32(dst_obj.obj_type as i32, ObjectType.object_set as i32);
    try assert_eq_i32((try set_object_len(dst_obj)) as i32, 1);
    const dst_members: &RedisObject = try set_object_members_reply(dst_obj);
    const first: &RedisObject = try list_object_index_value(dst_members, 0);
