    try assert_eq_i32(zlex_excl_reply.integer as i32, 3);
    resp_value_free(&zlex_excl_parsed.value);

    var zlex_inf_parsed: RespParseResult = try parse_resp2(&"*4\r\n$9\r\nZLEXCOUNT\r\n$3\r\nlex\r\n$1\r\n-\r\n$1\r\n+\r\n"[0: 42]);
