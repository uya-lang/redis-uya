    try assert_true(aof_key_missing_at(&replay_engine, &"zs2"[0: 3], 2000u64));
    engine_free(&replay_engine);
    _ = unlink(path);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_aof_replay_flush_commands() !void {
