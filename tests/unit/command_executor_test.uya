    const bitcount_wrongtype_reply: CommandReply = command_execute_at(&engine, &bitcount_wrongtype_command, 1000u64);
    try assert_eq_i32(bitcount_wrongtype_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&bitcount_wrongtype_parsed.value);

