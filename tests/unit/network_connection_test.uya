    try assert_true(network_connection_slice_eq(out[0: discard.response_len], &"+OK\r\n"[0: 5]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_reset() !void {
    reset_memory_stats_for_test();
    connection_pubsub_reset_for_test();
    connection_client_registry_reset_for_test();
    defer {
        connection_pubsub_reset_for_test();
        connection_client_registry_reset_for_test();
    }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.requirepass[0] = 115 as byte; // s
    runtime.config.requirepass[1] = 101 as byte; // e
    runtime.config.requirepass[2] = 99 as byte;  // c
    runtime.config.requirepass[3] = 114 as byte; // r
    runtime.config.requirepass[4] = 101 as byte; // e
    runtime.config.requirepass[5] = 116 as byte; // t
    runtime.config.requirepass[6] = 0 as byte;
    var tx: ConnectionTransaction = connection_transaction_new();
    tx.client_fd = 41;
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 512] = [];

    const auth_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$4\r\nAUTH\r\n$7\r\ndefault\r\n$6\r\nsecret\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_ok.response_len], &"+OK\r\n"[0: 5]));

    const watch_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$5\r\nWATCH\r\n$3\r\nkey\r\n"[0: 24], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch_ok.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 1);

    const hello3: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n3\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_true(out[0] == 37 as byte);

    const setname: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$7\r\nSETNAME\r\n$12\r\nreset-client\r\n"[0: 48], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: setname.response_len], &"+OK\r\n"[0: 5]));

    const setinfo: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$9\r\nreset-lib\r\n"[0: 58], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: setinfo.response_len], &"+OK\r\n"[0: 5]));

    const tracking_on: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*4\r\n$6\r\nCLIENT\r\n$8\r\nTRACKING\r\n$2\r\nON\r\n$6\r\nNOLOOP\r\n"[0: 50], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: tracking_on.response_len], &"+OK\r\n"[0: 5]));

    const no_touch_on: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nNO-TOUCH\r\n$2\r\nON\r\n"[0: 38], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_on.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(tx.no_touch_enabled as i32, 1);

    const no_evict_on: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nNO-EVICT\r\n$2\r\nON\r\n"[0: 38], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_evict_on.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(tx.no_evict_enabled as i32, 1);

    const caching_yes: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$7\r\nCACHING\r\n$3\r\nYES\r\n"[0: 38], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: caching_yes.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(tx.caching_enabled as i32, 1);

    const subscribe_resp3: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$3\r\nfoo\r\n"[0: 28], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: subscribe_resp3.response_len], &"subscribe"[0: 9]));

    const get_resp3_subscribed: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_resp3_subscribed.response_len], &"_\r\n"[0: 3]));

    const multi_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_ok.response_len], &"+OK\r\n"[0: 5]));

    const queued_get: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_get.response_len], &"+QUEUED\r\n"[0: 9]));

    const reset_reply: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$5\r\nRESET\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_reply.response_len], &"+RESET\r\n"[0: 8]));
    try assert_eq_i32(tx.active as i32, 0);
    try assert_eq_i32(tx.protocol_version, 2);
    try assert_eq_i32(tx.pubsub_count as i32, 0);
    try assert_eq_i32(tx.client_name_len as i32, 0);
    try assert_eq_i32(tx.client_lib_name_len as i32, 0);
    try assert_eq_i32(tx.tracking_enabled as i32, 0);
    try assert_eq_i32(tx.reply_off_enabled as i32, 0);
    try assert_eq_i32(tx.reply_skip_next as i32, 0);
    try assert_eq_i32(tx.caching_enabled as i32, 0);
    try assert_eq_i32(tx.no_evict_enabled as i32, 0);
    try assert_eq_i32(tx.no_touch_enabled as i32, 0);
    try assert_eq_i32(tx.authenticated as i32, 0);
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 0);

    const ping_after_reset: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ping_after_reset.response_len], &"-NOAUTH Authentication required.\r\n"[0: 34]));

    const reset_unauthed: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$5\r\nRESET\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_unauthed.response_len], &"+RESET\r\n"[0: 8]));

    const auth_again: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$4\r\nAUTH\r\n$7\r\ndefault\r\n$6\r\nsecret\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_again.response_len], &"+OK\r\n"[0: 5]));

    const get_resp2_after_reset: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_resp2_after_reset.response_len], &"$-1\r\n"[0: 5]));

    const client_getname: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$7\r\nGETNAME\r\n"[0: 29], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: client_getname.response_len], &"$-1\r\n"[0: 5]));

    const exec_after_reset: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec_after_reset.response_len], &"-ERR EXEC without MULTI\r\n"[0: 25]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_acl_permission_denial() !void {
    reset_memory_stats_for_test();
    connection_acl_reset_for_test();
    try assert_eq_i32(connection_acl_denied_command_count_for_test(&"default"[0: 7]) as i32, 0);
    connection_client_registry_reset_for_test();
    defer {
        connection_acl_reset_for_test();
        connection_client_registry_reset_for_test();
    }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    connection_transaction_set_client_addresses(&tx, &"127.0.0.1:50000"[0: 15], &"127.0.0.1:6380"[0: 14]);
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 2048] = [];

    const dryrun_before: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$7\r\ndefault\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 60], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: dryrun_before.response_len], &"+OK\r\n"[0: 5]));

    const deny_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$4\r\n-get\r\n"[0: 49], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: deny_get.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(connection_acl_denied_command_count_for_test(&"default"[0: 7]) as i32, 1);

    const acl_list: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nACL\r\n$4\r\nLIST\r\n"[0: 23], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: acl_list.response_len], &"+@all -get"[0: 10]));

    const acl_getuser: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n"[0: 39], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: acl_getuser.response_len], &"+@all -get"[0: 10]));

    const reset_channels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$13\r\nresetchannels\r\n"[0: 59], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_channels.response_len], &"+OK\r\n"[0: 5]));

    const getuser_reset_channels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n"[0: 39], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_reset_channels.response_len], &"$13\r\nresetchannels\r\n"[0: 20]));

    const publish_other_channel_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$7\r\nPUBLISH\r\n$5\r\nother\r\n$5\r\nhello\r\n"[0: 39], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: publish_other_channel_denied.response_len], &"-NOPERM User default has no permissions to access one of the channels used as arguments\r\n"[0: 89]));

    const ping_with_channels_restricted: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ping_with_channels_restricted.response_len], &"+PONG\r\n"[0: 7]));

    const allow_default_safe_channels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$6\r\n&safe*\r\n"[0: 51], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: allow_default_safe_channels.response_len], &"+OK\r\n"[0: 5]));

    const publish_safe_channel_allowed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$7\r\nPUBLISH\r\n$5\r\nsafe1\r\n$5\r\nhello\r\n"[0: 39], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: publish_safe_channel_allowed.response_len], &":0\r\n"[0: 4]));

    const dryrun_other_channel_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*6\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$7\r\ndefault\r\n$7\r\nPUBLISH\r\n$5\r\nother\r\n$5\r\nhello\r\n"[0: 73], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: dryrun_other_channel_denied.response_len], &"-NOPERM User default has no permissions to access one of the channels used as arguments\r\n"[0: 89]));

    const restore_default_allchannels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$11\r\nallchannels\r\n"[0: 57], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: restore_default_allchannels.response_len], &"+OK\r\n"[0: 5]));

    const reset_selectors_noop: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$14\r\nclearselectors\r\n$14\r\nresetselectors\r\n"[0: 81], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_selectors_noop.response_len], &"+OK\r\n"[0: 5]));

    const dryrun_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$7\r\ndefault\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 60], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: dryrun_denied.response_len], &"-NOPERM User default has no permissions to run the 'get' command\r\n"[0: 66]));

    const get_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_denied.response_len], &"-NOPERM User default has no permissions to run the 'get' command\r\n"[0: 66]));

    const acl_log_two: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$3\r\nLOG\r\n$1\r\n2\r\n"[0: 29], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: acl_log_two.response_len], &"$7\r\ncontext\r\n$7\r\ncommand\r\n"[0: 26]));
    try assert_true(network_connection_contains(out[0: acl_log_two.response_len], &"$7\r\ncontext\r\n$6\r\ndryrun\r\n"[0: 25]));
    try assert_true(network_connection_contains(out[0: acl_log_two.response_len], &"$6\r\nobject\r\n$3\r\nget\r\n"[0: 21]));
    try assert_true(network_connection_contains(out[0: acl_log_two.response_len], &"$8\r\nusername\r\n$7\r\ndefault\r\n"[0: 27]));
    try assert_true(network_connection_contains(out[0: acl_log_two.response_len], &"$8\r\nentry-id\r\n"[0: 14]));
    try assert_true(network_connection_contains(out[0: acl_log_two.response_len], &"$17\r\ntimestamp-created\r\n"[0: 24]));
    try assert_true(network_connection_contains(out[0: acl_log_two.response_len], &"$22\r\ntimestamp-last-updated\r\n"[0: 29]));
    try assert_true(network_connection_contains(out[0: acl_log_two.response_len], &"$11\r\nclient-info\r\n$46\r\nid=1 addr=127.0.0.1:50000 laddr=127.0.0.1:6380\r\n"[0: 71]));

    const multi_ok: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_ok.response_len], &"+OK\r\n"[0: 5]));

    const queued_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_denied.response_len], &"-NOPERM User default has no permissions to run the 'get' command\r\n"[0: 66]));

    const discard: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nDISCARD\r\n"[0: 17], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard.response_len], &"+OK\r\n"[0: 5]));

    const acl_log_one: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$3\r\nLOG\r\n$1\r\n1\r\n"[0: 29], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: acl_log_one.response_len], &"$7\r\ncontext\r\n$11\r\ntransaction\r\n"[0: 31]));

    const acl_log_reset: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$3\r\nLOG\r\n$5\r\nRESET\r\n"[0: 33], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: acl_log_reset.response_len], &"+OK\r\n"[0: 5]));

    const acl_log_empty: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nACL\r\n$3\r\nLOG\r\n"[0: 22], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: acl_log_empty.response_len], &"*0\r\n"[0: 4]));

    const allow_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$4\r\n+get\r\n"[0: 49], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: allow_get.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(connection_acl_denied_command_count_for_test(&"default"[0: 7]) as i32, 0);

    const dryrun_after: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$7\r\ndefault\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 60], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: dryrun_after.response_len], &"+OK\r\n"[0: 5]));

    const get_after: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_after.response_len], &"$-1\r\n"[0: 5]));

    const deny_string_category: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$8\r\n-@string\r\n"[0: 53], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: deny_string_category.response_len], &"+OK\r\n"[0: 5]));

    const acl_category_list: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nACL\r\n$4\r\nLIST\r\n"[0: 23], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: acl_category_list.response_len], &"-@string"[0: 8]));

    const get_category_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_category_denied.response_len], &"-NOPERM User default has no permissions to run the 'get' command\r\n"[0: 66]));

    const deny_get_again: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$4\r\n-get\r\n"[0: 49], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: deny_get_again.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(connection_acl_denied_command_count_for_test(&"default"[0: 7]) as i32, 1);

    const resetcommands: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$13\r\nresetcommands\r\n"[0: 59], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: resetcommands.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(connection_acl_denied_command_count_for_test(&"default"[0: 7]) as i32, 0);

    const acl_reset_list: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nACL\r\n$4\r\nLIST\r\n"[0: 23], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: acl_reset_list.response_len], &"*1\r\n$34\r\nuser default on nopass ~* &* +@all\r\n"[0: 45]));

    const get_category_after: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_category_after.response_len], &"$-1\r\n"[0: 5]));

    const reset_default_keys: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$9\r\nresetkeys\r\n"[0: 54], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_default_keys.response_len], &"+OK\r\n"[0: 5]));

    const get_after_resetkeys: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$5\r\nother\r\n"[0: 24], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_after_resetkeys.response_len], &"-NOPERM User default has no permissions to access one of the keys used as arguments\r\n"[0: 85]));

    const allow_default_safe_keys: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$6\r\n~safe*\r\n"[0: 51], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: allow_default_safe_keys.response_len], &"+OK\r\n"[0: 5]));

    const getuser_default_safe_keys: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n"[0: 39], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_default_safe_keys.response_len], &"$6\r\n~safe*\r\n"[0: 12]));

    const get_safe_key_allowed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$5\r\nsafe1\r\n"[0: 24], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_safe_key_allowed.response_len], &"$-1\r\n"[0: 5]));

    const dryrun_other_key_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$7\r\ndefault\r\n$3\r\nGET\r\n$5\r\nother\r\n"[0: 58], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: dryrun_other_key_denied.response_len], &"-NOPERM User default has no permissions to access one of the keys used as arguments\r\n"[0: 85]));

    const restore_default_allkeys: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$7\r\nallkeys\r\n"[0: 52], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: restore_default_allkeys.response_len], &"+OK\r\n"[0: 5]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_acl_named_user_metadata() !void {
    reset_memory_stats_for_test();
    connection_acl_reset_for_test();
    defer {
        connection_acl_reset_for_test();
    }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 4096] = [];

    const create_virgin: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$6\r\nvirgin\r\n"[0: 38], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: create_virgin.response_len], &"+OK\r\n"[0: 5]));
    const getuser_virgin: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$6\r\nvirgin\r\n"[0: 38], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_virgin.response_len], &"$3\r\noff\r\n"[0: 9]));
    try assert_true(!network_connection_contains(out[0: getuser_virgin.response_len], &"$6\r\nnopass\r\n"[0: 12]));
    try assert_true(network_connection_contains(out[0: getuser_virgin.response_len], &"$5\r\n-@all\r\n"[0: 11]));
    try assert_true(network_connection_contains(out[0: getuser_virgin.response_len], &"$9\r\nresetkeys\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: getuser_virgin.response_len], &"$13\r\nresetchannels\r\n"[0: 20]));
    const modify_virgin: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*9\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$6\r\nvirgin\r\n$2\r\non\r\n$6\r\nnopass\r\n$7\r\nallkeys\r\n$11\r\nallchannels\r\n$11\r\nallcommands\r\n$13\r\n(~safe* +get)\r\n"[0: 127], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: modify_virgin.response_len], &"+OK\r\n"[0: 5]));
    const reset_virgin: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$6\r\nvirgin\r\n$5\r\nreset\r\n"[0: 49], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_virgin.response_len], &"+OK\r\n"[0: 5]));
    const getuser_reset_virgin: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$6\r\nvirgin\r\n"[0: 38], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_reset_virgin.response_len], &"$3\r\noff\r\n"[0: 9]));
    try assert_true(!network_connection_contains(out[0: getuser_reset_virgin.response_len], &"$6\r\nnopass\r\n"[0: 12]));
    try assert_true(network_connection_contains(out[0: getuser_reset_virgin.response_len], &"$5\r\n-@all\r\n"[0: 11]));
    try assert_true(network_connection_contains(out[0: getuser_reset_virgin.response_len], &"$9\r\nresetkeys\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: getuser_reset_virgin.response_len], &"$13\r\nresetchannels\r\n"[0: 20]));
    try assert_true(network_connection_contains(out[0: getuser_reset_virgin.response_len], &"$9\r\nselectors\r\n*0\r\n"[0: 19]));
    const del_virgin: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nDELUSER\r\n$6\r\nvirgin\r\n"[0: 38], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: del_virgin.response_len], &":1\r\n"[0: 4]));

    const set_alice: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*8\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$5\r\nalice\r\n$2\r\non\r\n$6\r\nnopass\r\n$2\r\n~*\r\n$2\r\n&*\r\n$5\r\n+@all\r\n"[0: 84], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_alice.response_len], &"+OK\r\n"[0: 5]));

    const users_after_create: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nACL\r\n$5\r\nUSERS\r\n"[0: 24], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: users_after_create.response_len], &"$7\r\ndefault\r\n"[0: 13]));
    try assert_true(network_connection_contains(out[0: users_after_create.response_len], &"$5\r\nalice\r\n"[0: 11]));

    const getuser_alice: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$5\r\nalice\r\n"[0: 37], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_alice.response_len], &"$5\r\nflags\r\n"[0: 11]));
    try assert_true(network_connection_contains(out[0: getuser_alice.response_len], &"$2\r\non\r\n"[0: 8]));
    try assert_true(network_connection_contains(out[0: getuser_alice.response_len], &"$6\r\nnopass\r\n"[0: 12]));
    try assert_true(network_connection_contains(out[0: getuser_alice.response_len], &"$5\r\n+@all\r\n"[0: 11]));

    const list_after_create: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nACL\r\n$4\r\nLIST\r\n"[0: 23], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: list_after_create.response_len], &"user default on nopass ~* &* +@all"[0: 34]));
    try assert_true(network_connection_contains(out[0: list_after_create.response_len], &"user alice on nopass ~* &* +@all"[0: 32]));

    const dryrun_alice: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$5\r\nalice\r\n$3\r\nGET\r\n$1\r\nk\r\n"[0: 52], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: dryrun_alice.response_len], &"+OK\r\n"[0: 5]));
    const alice_nocommands: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$5\r\nalice\r\n$10\r\nnocommands\r\n"[0: 54], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: alice_nocommands.response_len], &"+OK\r\n"[0: 5]));
    const alice_ping_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$5\r\nalice\r\n$4\r\nPING\r\n"[0: 46], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: alice_ping_denied.response_len], &"NOPERM"[0: 6]));
    const alice_allcommands: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$5\r\nalice\r\n$11\r\nallcommands\r\n"[0: 55], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: alice_allcommands.response_len], &"+OK\r\n"[0: 5]));

    const set_alice_off: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$5\r\nalice\r\n$3\r\noff\r\n"[0: 46], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_alice_off.response_len], &"+OK\r\n"[0: 5]));

    const list_after_off: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nACL\r\n$4\r\nLIST\r\n"[0: 23], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: list_after_off.response_len], &"user alice off nopass ~* &* +@all"[0: 33]));

    const del_alice: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nDELUSER\r\n$5\r\nalice\r\n"[0: 37], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: del_alice.response_len], &":1\r\n"[0: 4]));

    const getuser_after_del: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$5\r\nalice\r\n"[0: 37], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: getuser_after_del.response_len], &"$-1\r\n"[0: 5]));

    const users_after_del: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nACL\r\n$5\r\nUSERS\r\n"[0: 24], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: users_after_del.response_len], &"*1\r\n$7\r\ndefault\r\n"[0: 17]));

    const set_bob_password: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*10\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$2\r\non\r\n$7\r\n>secret\r\n$8\r\n>secret2\r\n$7\r\n>secret\r\n$2\r\n~*\r\n$2\r\n&*\r\n$5\r\n+@all\r\n"[0: 111], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_bob_password.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(connection_acl_denied_command_count_for_test(&"bob"[0: 3]) as i32, 0);

    const getuser_bob: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$3\r\nbob\r\n"[0: 35], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_bob.response_len], &"$9\r\npasswords\r\n*2\r\n$64\r\n"[0: 24]));
    try assert_true(network_connection_contains(out[0: getuser_bob.response_len], &"2bb80d537b1da3e38bd30361aa855686bde0eacd7162fef6a25fe97bf527a25b"[0: 64]));
    try assert_true(network_connection_contains(out[0: getuser_bob.response_len], &"35224d0d3465d74e855f8d69a136e79c744ea35a675d3393360a327cbf6359a2"[0: 64]));
    try assert_true(!network_connection_contains(out[0: getuser_bob.response_len], &"secret"[0: 6]));

    const list_with_bob_password: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nACL\r\n$4\r\nLIST\r\n"[0: 23], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: list_with_bob_password.response_len], &"user bob on #"[0: 13]));
    try assert_true(!network_connection_contains(out[0: list_with_bob_password.response_len], &"secret"[0: 6]));

    var bob_auth_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&bob_auth_tx);
    }
    const auth_bob_wrong: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*3\r\n$4\r\nAUTH\r\n$3\r\nbob\r\n$5\r\nwrong\r\n"[0: 34], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_bob_wrong.response_len], &"-WRONGPASS invalid username-password pair or user is disabled.\r\n"[0: 64]));
    try assert_eq_i32(bob_auth_tx.authenticated as i32, 0);

    const auth_bob_ok: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*3\r\n$4\r\nAUTH\r\n$3\r\nbob\r\n$6\r\nsecret\r\n"[0: 35], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_bob_ok.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(bob_auth_tx.authenticated as i32, 1);

    var bob_second_auth_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&bob_second_auth_tx);
    }
    const auth_bob_second: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_second_auth_tx, &"*3\r\n$4\r\nAUTH\r\n$3\r\nbob\r\n$7\r\nsecret2\r\n"[0: 36], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_bob_second.response_len], &"+OK\r\n"[0: 5]));

    const remove_bob_first_password: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$7\r\n<secret\r\n"[0: 48], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: remove_bob_first_password.response_len], &"+OK\r\n"[0: 5]));

    var bob_removed_auth_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&bob_removed_auth_tx);
    }
    const auth_bob_removed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_removed_auth_tx, &"*3\r\n$4\r\nAUTH\r\n$3\r\nbob\r\n$6\r\nsecret\r\n"[0: 35], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_bob_removed.response_len], &"-WRONGPASS invalid username-password pair or user is disabled.\r\n"[0: 64]));

    var bob_remaining_auth_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&bob_remaining_auth_tx);
    }
    const auth_bob_remaining: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_remaining_auth_tx, &"*3\r\n$4\r\nAUTH\r\n$3\r\nbob\r\n$7\r\nsecret2\r\n"[0: 36], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_bob_remaining.response_len], &"+OK\r\n"[0: 5]));

    const whoami_bob: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*2\r\n$3\r\nACL\r\n$6\r\nWHOAMI\r\n"[0: 25], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: whoami_bob.response_len], &"$3\r\nbob\r\n"[0: 9]));

    const deny_get_default_only: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$4\r\n-get\r\n"[0: 49], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: deny_get_default_only.response_len], &"+OK\r\n"[0: 5]));

    const default_get_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: default_get_denied.response_len], &"-NOPERM User default has no permissions to run the 'get' command\r\n"[0: 66]));

    const bob_get_allowed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_get_allowed.response_len], &"$-1\r\n"[0: 5]));

    const bob_safe_keys_only: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$6\r\n~safe*\r\n"[0: 47], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_safe_keys_only.response_len], &"+OK\r\n"[0: 5]));

    const getuser_bob_safe_keys: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$3\r\nbob\r\n"[0: 35], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_bob_safe_keys.response_len], &"$6\r\n~safe*\r\n"[0: 12]));

    const bob_safe_key_allowed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*2\r\n$3\r\nGET\r\n$5\r\nsafe1\r\n"[0: 24], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_safe_key_allowed.response_len], &"$-1\r\n"[0: 5]));

    const bob_other_key_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*2\r\n$3\r\nGET\r\n$5\r\nother\r\n"[0: 24], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_other_key_denied.response_len], &"-NOPERM User bob has no permissions to access one of the keys used as arguments\r\n"[0: 81]));

    const bob_resetkeys: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$9\r\nresetkeys\r\n"[0: 50], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_resetkeys.response_len], &"+OK\r\n"[0: 5]));

    const bob_after_resetkeys_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*2\r\n$3\r\nGET\r\n$5\r\nsafe1\r\n"[0: 24], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_after_resetkeys_denied.response_len], &"-NOPERM User bob has no permissions to access one of the keys used as arguments\r\n"[0: 81]));

    const bob_restore_allkeys: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$7\r\nallkeys\r\n"[0: 48], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_restore_allkeys.response_len], &"+OK\r\n"[0: 5]));

    const bob_reset_channels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$13\r\nresetchannels\r\n"[0: 55], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_reset_channels.response_len], &"+OK\r\n"[0: 5]));

    const bob_publish_reset_channels_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*3\r\n$7\r\nPUBLISH\r\n$5\r\nother\r\n$5\r\nhello\r\n"[0: 39], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_publish_reset_channels_denied.response_len], &"-NOPERM User bob has no permissions to access one of the channels used as arguments\r\n"[0: 85]));

    const bob_safe_channels_only: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$6\r\n&safe*\r\n"[0: 47], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_safe_channels_only.response_len], &"+OK\r\n"[0: 5]));

    const getuser_bob_safe_channels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$3\r\nbob\r\n"[0: 35], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_bob_safe_channels.response_len], &"$6\r\n&safe*\r\n"[0: 12]));

    const bob_safe_channel_allowed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*3\r\n$7\r\nPUBLISH\r\n$5\r\nsafe1\r\n$5\r\nhello\r\n"[0: 39], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_safe_channel_allowed.response_len], &":0\r\n"[0: 4]));

    const bob_other_channel_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*3\r\n$7\r\nPUBLISH\r\n$5\r\nother\r\n$5\r\nhello\r\n"[0: 39], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_other_channel_denied.response_len], &"-NOPERM User bob has no permissions to access one of the channels used as arguments\r\n"[0: 85]));

    const bob_restore_allchannels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$11\r\nallchannels\r\n"[0: 53], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_restore_allchannels.response_len], &"+OK\r\n"[0: 5]));

    const deny_bob_get_and_string: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$4\r\n-get\r\n$8\r\n-@string\r\n"[0: 59], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: deny_bob_get_and_string.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(connection_acl_denied_command_count_for_test(&"bob"[0: 3]) as i32, 1);

    const getuser_bob_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$3\r\nbob\r\n"[0: 35], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_bob_denied.response_len], &"$8\r\ncommands\r\n$19\r\n+@all -get -@string\r\n"[0: 40]));

    const dryrun_bob_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$3\r\nbob\r\n$3\r\nGET\r\n$1\r\nk\r\n"[0: 50], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: dryrun_bob_denied.response_len], &"-NOPERM User bob has no permissions to run the 'get' command\r\n"[0: 62]));

    const bob_get_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_get_denied.response_len], &"-NOPERM User bob has no permissions to run the 'get' command\r\n"[0: 62]));

    const reset_bob_rules: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$13\r\nresetcommands\r\n"[0: 55], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_bob_rules.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(connection_acl_denied_command_count_for_test(&"bob"[0: 3]) as i32, 0);

    const bob_get_after_reset: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_auth_tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bob_get_after_reset.response_len], &"$-1\r\n"[0: 5]));

    const reset_default_rules_after_bob: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$13\r\nresetcommands\r\n"[0: 59], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_default_rules_after_bob.response_len], &"+OK\r\n"[0: 5]));

    var bob_hello_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&bob_hello_tx);
    }
    const hello_bob_ok: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &bob_hello_tx, &"*5\r\n$5\r\nHELLO\r\n$1\r\n3\r\n$4\r\nAUTH\r\n$3\r\nbob\r\n$7\r\nsecret2\r\n"[0: 54], &out[0], 4096, 1000u64);
    try assert_true(out[0] == 37 as byte);
    try assert_eq_i32(bob_hello_tx.authenticated as i32, 1);
    try assert_eq_i32(bob_hello_tx.protocol_version, 3);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_acl_selectors() !void {
    reset_memory_stats_for_test();
    connection_acl_reset_for_test();
    defer {
        connection_acl_reset_for_test();
    }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var admin_tx: ConnectionTransaction = connection_transaction_new();
    var scoped_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&scoped_tx);
        connection_transaction_reset(&admin_tx);
    }
    var out: [byte: 4096] = [];

    const set_scoped: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*12\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$6\r\nscoped\r\n$2\r\non\r\n$6\r\nnopass\r\n$4\r\n-get\r\n$4\r\n-set\r\n$8\r\n-publish\r\n$9\r\nresetkeys\r\n$13\r\nresetchannels\r\n$29\r\n(~safe* &news* +get +publish)\r\n$14\r\n(~write* +set)\r\n"[0: 185], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_scoped.response_len], &"+OK\r\n"[0: 5]));

    const auth_scoped: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &scoped_tx, &"*3\r\n$4\r\nAUTH\r\n$6\r\nscoped\r\n$1\r\nx\r\n"[0: 33], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_scoped.response_len], &"+OK\r\n"[0: 5]));

    const get_safe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &scoped_tx, &"*2\r\n$3\r\nGET\r\n$5\r\nsafe1\r\n"[0: 24], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_safe.response_len], &"$-1\r\n"[0: 5]));

    const get_other: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &scoped_tx, &"*2\r\n$3\r\nGET\r\n$5\r\nother\r\n"[0: 24], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: get_other.response_len], &"NOPERM"[0: 6]));

    const set_write: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &scoped_tx, &"*3\r\n$3\r\nSET\r\n$6\r\nwrite1\r\n$1\r\nv\r\n"[0: 32], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_write.response_len], &"+OK\r\n"[0: 5]));

    const set_safe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &scoped_tx, &"*3\r\n$3\r\nSET\r\n$5\r\nsafe1\r\n$1\r\nv\r\n"[0: 31], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: set_safe.response_len], &"NOPERM"[0: 6]));

    const publish_news: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &scoped_tx, &"*3\r\n$7\r\nPUBLISH\r\n$5\r\nnews1\r\n$5\r\nhello\r\n"[0: 39], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: publish_news.response_len], &":0\r\n"[0: 4]));

    const publish_other: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &scoped_tx, &"*3\r\n$7\r\nPUBLISH\r\n$5\r\nother\r\n$5\r\nhello\r\n"[0: 39], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: publish_other.response_len], &"NOPERM"[0: 6]));

    const getuser: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$6\r\nscoped\r\n"[0: 38], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser.response_len], &"$9\r\nselectors\r\n*2\r\n"[0: 19]));
    try assert_true(network_connection_contains(out[0: getuser.response_len], &"$19\r\n-@all +get +publish\r\n"[0: 26]));
    try assert_true(network_connection_contains(out[0: getuser.response_len], &"$6\r\n~safe*\r\n"[0: 12]));
    try assert_true(network_connection_contains(out[0: getuser.response_len], &"$6\r\n&news*\r\n"[0: 12]));

    const list: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*2\r\n$3\r\nACL\r\n$4\r\nLIST\r\n"[0: 23], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: list.response_len], &"(~safe* &news* -@all +get +publish)"[0: 35]));
    try assert_true(network_connection_contains(out[0: list.response_len], &"(~write* resetchannels -@all +set)"[0: 34]));

    const clear: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$6\r\nscoped\r\n$14\r\nclearselectors\r\n"[0: 59], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: clear.response_len], &"+OK\r\n"[0: 5]));
    const get_after_clear: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &scoped_tx, &"*2\r\n$3\r\nGET\r\n$5\r\nsafe1\r\n"[0: 24], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: get_after_clear.response_len], &"NOPERM"[0: 6]));

    const set_default_selector: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*6\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$4\r\n-get\r\n$9\r\nresetkeys\r\n$16\r\n(~default* +get)\r\n"[0: 87], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_default_selector.response_len], &"+OK\r\n"[0: 5]));
    const default_get_allowed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*2\r\n$3\r\nGET\r\n$8\r\ndefault1\r\n"[0: 27], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: default_get_allowed.response_len], &"$-1\r\n"[0: 5]));
    const default_get_denied: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*2\r\n$3\r\nGET\r\n$5\r\nother\r\n"[0: 24], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: default_get_denied.response_len], &"NOPERM"[0: 6]));
    const default_getuser: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n"[0: 39], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: default_getuser.response_len], &"$9\r\nselectors\r\n*1\r\n"[0: 19]));
    try assert_true(network_connection_contains(out[0: default_getuser.response_len], &"$9\r\n~default*\r\n"[0: 15]));
    const reset_default: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*6\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$14\r\nclearselectors\r\n$13\r\nresetcommands\r\n$7\r\nallkeys\r\n"[0: 93], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_default.response_len], &"+OK\r\n"[0: 5]));

    const ordered_deny: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*8\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$12\r\nordered-deny\r\n$2\r\non\r\n$6\r\nnopass\r\n$4\r\n-get\r\n$7\r\n-exists\r\n$16\r\n(+@read -get ~*)\r\n"[0: 111], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ordered_deny.response_len], &"+OK\r\n"[0: 5]));
    const ordered_deny_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*5\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$12\r\nordered-deny\r\n$3\r\nGET\r\n$1\r\nk\r\n"[0: 60], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: ordered_deny_get.response_len], &"NOPERM"[0: 6]));
    const ordered_deny_exists: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*5\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$12\r\nordered-deny\r\n$6\r\nEXISTS\r\n$1\r\nk\r\n"[0: 63], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ordered_deny_exists.response_len], &"+OK\r\n"[0: 5]));

    const ordered_allow: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*8\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$13\r\nordered-allow\r\n$2\r\non\r\n$6\r\nnopass\r\n$4\r\n-get\r\n$7\r\n-exists\r\n$16\r\n(-get +@read ~*)\r\n"[0: 112], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ordered_allow.response_len], &"+OK\r\n"[0: 5]));
    const ordered_allow_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*5\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$13\r\nordered-allow\r\n$3\r\nGET\r\n$1\r\nk\r\n"[0: 61], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ordered_allow_get.response_len], &"+OK\r\n"[0: 5]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_acl_command_whitelist() !void {
    reset_memory_stats_for_test();
    connection_acl_reset_for_test();
    defer { connection_acl_reset_for_test(); }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var admin_tx: ConnectionTransaction = connection_transaction_new();
    defer { connection_transaction_reset(&admin_tx); }
    var out: [byte: 4096] = [];

    const default_whitelist: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*6\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$5\r\n-@all\r\n$4\r\n+get\r\n$4\r\n+acl\r\n"[0: 70], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: default_whitelist.response_len], &"+OK\r\n"[0: 5]));
    const default_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: default_get.response_len], &"$-1\r\n"[0: 5]));
    const default_exists: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*2\r\n$6\r\nEXISTS\r\n$7\r\nmissing\r\n"[0: 29], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: default_exists.response_len], &"NOPERM"[0: 6]));
    const default_getuser: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &admin_tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n"[0: 39], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: default_getuser.response_len], &"$15\r\n-@all +get +acl\r\n"[0: 22]));
