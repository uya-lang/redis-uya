    command_reply_cleanup(&sort_desc_reply);
    resp_value_free(&sort_desc_parsed.value);

    var sort_limit_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nSORT\r\n$7\r\nsortnum\r\n$5\r\nLIMIT\r\n$1\r\n1\r\n$1\r\n2\r\n"[0: 52]);
