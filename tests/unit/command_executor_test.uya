    var copy_db_bad_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nCOPY\r\n$4\r\nnext\r\n$5\r\nother\r\n$2\r\nDB\r\n$1\r\n1\r\n"[0: 50]);
    const copy_db_bad_command: Command = try command_executor_test_command(&router, &copy_db_bad_parsed);
    const copy_db_bad_reply: CommandReply = command_execute_at(&engine, &copy_db_bad_command, 1000u64);
