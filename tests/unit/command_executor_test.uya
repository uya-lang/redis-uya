    const zrange_byscore_rev_scores_len: usize = try connection_encode_reply(&zrange_byscore_rev_scores_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zrange_byscore_rev_scores_len], &"*6\r\n$1\r\nc\r\n$1\r\n3\r\n$1\r\nb\r\n$1\r\n2\r\n$1\r\na\r\n$1\r\n1\r\n"[0: 46]));
    command_reply_cleanup(&zrange_byscore_rev_scores_reply);
    resp_value_free(&zrange_byscore_rev_scores_parsed.value);

    var zrange_byscore_limit_scores_parsed: RespParseResult = try parse_resp2(&"*9\r\n$6\r\nZRANGE\r\n$4\r\nzset\r\n$1\r\n1\r\n$1\r\n3\r\n$7\r\nBYSCORE\r\n$5\r\nLIMIT\r\n$1\r\n1\r\n$1\r\n1\r\n$10\r\nWITHSCORES\r\n"[0: 95]);
    const zrange_byscore_limit_scores_command: Command = try command_executor_test_command(&router, &zrange_byscore_limit_scores_parsed);
    var zrange_byscore_limit_scores_reply: CommandReply = command_execute_at(&engine, &zrange_byscore_limit_scores_command, 1000u64);
    const zrange_byscore_limit_scores_len: usize = try connection_encode_reply(&zrange_byscore_limit_scores_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zrange_byscore_limit_scores_len], &"*2\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 18]));
    command_reply_cleanup(&zrange_byscore_limit_scores_reply);
    resp_value_free(&zrange_byscore_limit_scores_parsed.value);

    var zadd_lex_parsed: RespParseResult = try parse_resp2(&"*10\r\n$4\r\nZADD\r\n$3\r\nlex\r\n$1\r\n0\r\n$5\r\nalpha\r\n$1\r\n0\r\n$4\r\nbeta\r\n$1\r\n0\r\n$7\r\ncharlie\r\n$1\r\n0\r\n$5\r\ndelta\r\n"[0: 97]);
    const zadd_lex_command: Command = try command_executor_test_command(&router, &zadd_lex_parsed);
    _ = command_execute_at(&engine, &zadd_lex_command, 1000u64);
    resp_value_free(&zadd_lex_parsed.value);

    var zrange_bylex_parsed: RespParseResult = try parse_resp2(&"*5\r\n$6\r\nZRANGE\r\n$3\r\nlex\r\n$6\r\n[alpha\r\n$8\r\n[charlie\r\n$5\r\nBYLEX\r\n"[0: 62]);
    const zrange_bylex_command: Command = try command_executor_test_command(&router, &zrange_bylex_parsed);
    var zrange_bylex_reply: CommandReply = command_execute_at(&engine, &zrange_bylex_command, 1000u64);
    const zrange_bylex_len: usize = try connection_encode_reply(&zrange_bylex_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zrange_bylex_len], &"*3\r\n$5\r\nalpha\r\n$4\r\nbeta\r\n$7\r\ncharlie\r\n"[0: 38]));
    command_reply_cleanup(&zrange_bylex_reply);
    resp_value_free(&zrange_bylex_parsed.value);

    var zrange_bylex_limit_parsed: RespParseResult = try parse_resp2(&"*8\r\n$6\r\nZRANGE\r\n$3\r\nlex\r\n$1\r\n-\r\n$1\r\n+\r\n$5\r\nBYLEX\r\n$5\r\nLIMIT\r\n$1\r\n1\r\n$1\r\n2\r\n"[0: 75]);
    const zrange_bylex_limit_command: Command = try command_executor_test_command(&router, &zrange_bylex_limit_parsed);
    var zrange_bylex_limit_reply: CommandReply = command_execute_at(&engine, &zrange_bylex_limit_command, 1000u64);
    const zrange_bylex_limit_len: usize = try connection_encode_reply(&zrange_bylex_limit_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zrange_bylex_limit_len], &"*2\r\n$4\r\nbeta\r\n$7\r\ncharlie\r\n"[0: 27]));
    command_reply_cleanup(&zrange_bylex_limit_reply);
    resp_value_free(&zrange_bylex_limit_parsed.value);

    var zrange_bylex_rev_parsed: RespParseResult = try parse_resp2(&"*6\r\n$6\r\nZRANGE\r\n$3\r\nlex\r\n$6\r\n[delta\r\n$6\r\n(alpha\r\n$5\r\nBYLEX\r\n$3\r\nREV\r\n"[0: 69]);
    const zrange_bylex_rev_command: Command = try command_executor_test_command(&router, &zrange_bylex_rev_parsed);
    var zrange_bylex_rev_reply: CommandReply = command_execute_at(&engine, &zrange_bylex_rev_command, 1000u64);
    const zrange_bylex_rev_len: usize = try connection_encode_reply(&zrange_bylex_rev_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zrange_bylex_rev_len], &"*3\r\n$5\r\ndelta\r\n$7\r\ncharlie\r\n$4\r\nbeta\r\n"[0: 38]));
    command_reply_cleanup(&zrange_bylex_rev_reply);
    resp_value_free(&zrange_bylex_rev_parsed.value);

    var zrange_bylex_scores_parsed: RespParseResult = try parse_resp2(&"*6\r\n$6\r\nZRANGE\r\n$3\r\nlex\r\n$6\r\n[alpha\r\n$8\r\n[charlie\r\n$5\r\nBYLEX\r\n$10\r\nWITHSCORES\r\n"[0: 79]);
    const zrange_bylex_scores_command: Command = try command_executor_test_command(&router, &zrange_bylex_scores_parsed);
    const zrange_bylex_scores_reply: CommandReply = command_execute_at(&engine, &zrange_bylex_scores_command, 1000u64);
    try assert_eq_i32(zrange_bylex_scores_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(zrange_bylex_scores_reply.data, &"ERR syntax error"[0: 16]));
    resp_value_free(&zrange_bylex_scores_parsed.value);

    var zrange_limit_no_byscore_parsed: RespParseResult = try parse_resp2(&"*7\r\n$6\r\nZRANGE\r\n$4\r\nzset\r\n$1\r\n0\r\n$1\r\n2\r\n$5\r\nLIMIT\r\n$1\r\n0\r\n$1\r\n1\r\n"[0: 65]);
    const zrange_limit_no_byscore_command: Command = try command_executor_test_command(&router, &zrange_limit_no_byscore_parsed);
    const zrange_limit_no_byscore_reply: CommandReply = command_execute_at(&engine, &zrange_limit_no_byscore_command, 1000u64);
