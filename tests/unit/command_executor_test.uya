    const fcounter_del_reply: CommandReply = command_execute_at(&engine, &fcounter_del_command, 1000u64);
    try assert_eq_i32(fcounter_del_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(fcounter_del_reply.integer as i32, 1);
    resp_value_free(&fcounter_del_parsed.value);

    var allones_del_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nDEL\r\n$7\r\nallones\r\n"[0: 26]);
    const allones_del_command: Command = try command_executor_test_command(&router, &allones_del_parsed);
    const allones_del_reply: CommandReply = command_execute_at(&engine, &allones_del_command, 1000u64);
    try assert_eq_i32(allones_del_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(allones_del_reply.integer as i32, 1);
    resp_value_free(&allones_del_parsed.value);

    var bitfield_del_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nDEL\r\n$2\r\nbf\r\n$6\r\nbf-ttl\r\n"[0: 33]);
    const bitfield_del_command: Command = try command_executor_test_command(&router, &bitfield_del_parsed);
    const bitfield_del_reply: CommandReply = command_execute_at(&engine, &bitfield_del_command, 1000u64);
    try assert_eq_i32(bitfield_del_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(bitfield_del_reply.integer as i32, 2);
    resp_value_free(&bitfield_del_parsed.value);

    var echo_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nECHO\r\n$2\r\nhi\r\n"[0: 22]);
    const echo_command: Command = try command_executor_test_command(&router, &echo_parsed);
    const echo_reply: CommandReply = command_execute_at(&engine, &echo_command, 1000u64);
    try assert_eq_i32(echo_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(echo_reply.data, &"hi"[0: 2]));
    resp_value_free(&echo_parsed.value);

    var type_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nTYPE\r\n$3\r\nkey\r\n"[0: 23]);
    const type_command: Command = try command_executor_test_command(&router, &type_parsed);
    const type_reply: CommandReply = command_execute_at(&engine, &type_command, 1000u64);
    try assert_eq_i32(type_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(type_reply.data, &"string"[0: 6]));
    resp_value_free(&type_parsed.value);

    var dbsize_parsed: RespParseResult = try parse_resp2(&"*1\r\n$6\r\nDBSIZE\r\n"[0: 16]);
    const dbsize_command: Command = try command_executor_test_command(&router, &dbsize_parsed);
    const dbsize_reply: CommandReply = command_execute_at(&engine, &dbsize_command, 1000u64);
    try assert_eq_i32(dbsize_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(dbsize_reply.integer as i32, 1);
    resp_value_free(&dbsize_parsed.value);

    var exists_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nEXISTS\r\n$3\r\nkey\r\n$7\r\nmissing\r\n"[0: 41]);
    const exists_command: Command = try command_executor_test_command(&router, &exists_parsed);
    const exists_reply: CommandReply = command_execute_at(&engine, &exists_command, 1000u64);
    try assert_eq_i32(exists_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(exists_reply.integer as i32, 1);
    resp_value_free(&exists_parsed.value);

    var del_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nDEL\r\n$3\r\nkey\r\n$7\r\nmissing\r\n"[0: 38]);
    const del_command: Command = try command_executor_test_command(&router, &del_parsed);
    const del_reply: CommandReply = command_execute_at(&engine, &del_command, 1000u64);
    try assert_eq_i32(del_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(del_reply.integer as i32, 1);
    resp_value_free(&del_parsed.value);

    var missing_get_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22]);
    const missing_get_command: Command = try command_executor_test_command(&router, &missing_get_parsed);
    const missing_get_reply: CommandReply = command_execute_at(&engine, &missing_get_command, 1000u64);
    try assert_eq_i32(missing_get_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&missing_get_parsed.value);

    var missing_getdel_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nGETDEL\r\n$6\r\ngd-key\r\n"[0: 28]);
    const missing_getdel_command: Command = try command_executor_test_command(&router, &missing_getdel_parsed);
    const missing_getdel_reply: CommandReply = command_execute_at(&engine, &missing_getdel_command, 1000u64);
    try assert_eq_i32(missing_getdel_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&missing_getdel_parsed.value);

    var missing_type_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nTYPE\r\n$3\r\nkey\r\n"[0: 23]);
    const missing_type_command: Command = try command_executor_test_command(&router, &missing_type_parsed);
    const missing_type_reply: CommandReply = command_execute_at(&engine, &missing_type_command, 1000u64);
    try assert_eq_i32(missing_type_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(missing_type_reply.data, &"none"[0: 4]));
    resp_value_free(&missing_type_parsed.value);

    var empty_dbsize_parsed: RespParseResult = try parse_resp2(&"*1\r\n$6\r\nDBSIZE\r\n"[0: 16]);
    const empty_dbsize_command: Command = try command_executor_test_command(&router, &empty_dbsize_parsed);
    const empty_dbsize_reply: CommandReply = command_execute_at(&engine, &empty_dbsize_command, 1000u64);
    try assert_eq_i32(empty_dbsize_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(empty_dbsize_reply.integer as i32, 0);
    resp_value_free(&empty_dbsize_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_digest_partial() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var digest_set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$10\r\ndigest-key\r\n$11\r\nHello world\r\n"[0: 48]);
    const digest_set_command: Command = try command_executor_test_command(&router, &digest_set_parsed);
    const digest_set_reply: CommandReply = command_execute_at(&engine, &digest_set_command, 1000u64);
    try assert_eq_i32(digest_set_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    resp_value_free(&digest_set_parsed.value);

    var digest_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nDIGEST\r\n$10\r\ndigest-key\r\n"[0: 33]);
    const digest_command: Command = try command_executor_test_command(&router, &digest_parsed);
    var digest_reply: CommandReply = command_execute_at(&engine, &digest_command, 1000u64);
    try assert_eq_i32(digest_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(digest_reply.data, &"b6acb9d84a38ff74"[0: 16]));
    command_reply_cleanup(&digest_reply);
    resp_value_free(&digest_parsed.value);

    var digest_empty_set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$12\r\ndigest-empty\r\n$0\r\n\r\n"[0: 38]);
    const digest_empty_set_command: Command = try command_executor_test_command(&router, &digest_empty_set_parsed);
    const digest_empty_set_reply: CommandReply = command_execute_at(&engine, &digest_empty_set_command, 1000u64);
    try assert_eq_i32(digest_empty_set_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    resp_value_free(&digest_empty_set_parsed.value);

    var digest_empty_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nDIGEST\r\n$12\r\ndigest-empty\r\n"[0: 35]);
    const digest_empty_command: Command = try command_executor_test_command(&router, &digest_empty_parsed);
    var digest_empty_reply: CommandReply = command_execute_at(&engine, &digest_empty_command, 1000u64);
    try assert_eq_i32(digest_empty_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(digest_empty_reply.data, &"2d06800538d394c2"[0: 16]));
    command_reply_cleanup(&digest_empty_reply);
    resp_value_free(&digest_empty_parsed.value);

    var digest_missing_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nDIGEST\r\n$7\r\nmissing\r\n"[0: 29]);
    const digest_missing_command: Command = try command_executor_test_command(&router, &digest_missing_parsed);
    const digest_missing_reply: CommandReply = command_execute_at(&engine, &digest_missing_command, 1000u64);
    try assert_eq_i32(digest_missing_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&digest_missing_parsed.value);

    var digest_hash_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nHSET\r\n$11\r\ndigest-hash\r\n$5\r\nfield\r\n$5\r\nvalue\r\n"[0: 54]);
    const digest_hash_command: Command = try command_executor_test_command(&router, &digest_hash_parsed);
    const digest_hash_reply: CommandReply = command_execute_at(&engine, &digest_hash_command, 1000u64);
    try assert_eq_i32(digest_hash_reply.typ as i32, CommandReplyType.reply_integer as i32);
    resp_value_free(&digest_hash_parsed.value);

    var digest_wrongtype_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nDIGEST\r\n$11\r\ndigest-hash\r\n"[0: 34]);
    const digest_wrongtype_command: Command = try command_executor_test_command(&router, &digest_wrongtype_parsed);
    const digest_wrongtype_reply: CommandReply = command_execute_at(&engine, &digest_wrongtype_command, 1000u64);
    try assert_eq_i32(digest_wrongtype_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(digest_wrongtype_reply.data, &"WRONGTYPE Operation against a key holding the wrong kind of value"[0: 65]));
    resp_value_free(&digest_wrongtype_parsed.value);

    var long_value: [byte: 129] = [];
    command_executor_test_fill_bytes(long_value[0: 129], 120 as byte);
    const long_obj: &RedisObject = try create_string_object(long_value[0: 129]);
    try set_key_at(&engine, &"digest-long"[0: 11], long_obj, 1000u64);

    var digest_long_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nDIGEST\r\n$11\r\ndigest-long\r\n"[0: 34]);
    const digest_long_command: Command = try command_executor_test_command(&router, &digest_long_parsed);
    const digest_long_reply: CommandReply = command_execute_at(&engine, &digest_long_command, 1000u64);
    try assert_eq_i32(digest_long_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(digest_long_reply.data, &"ERR DIGEST only supports string values up to 128 bytes in redis-uya partial"[0: 75]));
    resp_value_free(&digest_long_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_maxmemory_noeviction() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.maxmemory = 1;

    var set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33]);
    const set_command: Command = try command_executor_test_command(&router, &set_parsed);
    const set_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &set_command, 1000u64);
    try assert_eq_i32(set_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_contains(set_reply.data, &"maxmemory"[0: 9]));
    resp_value_free(&set_parsed.value);

    runtime.config.maxmemory = 0;
    const source_obj: &RedisObject = try create_string_object(&"value"[0: 5]);
    try set_key_at(&engine, &"source"[0: 6], source_obj, 1000u64);

    runtime.config.maxmemory = 1;
    var copy_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nCOPY\r\n$6\r\nsource\r\n$6\r\ncopied\r\n"[0: 38]);
    const copy_command: Command = try command_executor_test_command(&router, &copy_parsed);
    const copy_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &copy_command, 1000u64);
    try assert_eq_i32(copy_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_contains(copy_reply.data, &"maxmemory"[0: 9]));
    resp_value_free(&copy_parsed.value);

    runtime.config.maxmemory = 0;
    var get_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22]);
    const get_command: Command = try command_executor_test_command(&router, &get_parsed);
    const get_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &get_command, 1000u64);
    try assert_eq_i32(get_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&get_parsed.value);

    var copied_get_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nGET\r\n$6\r\ncopied\r\n"[0: 25]);
    const copied_get_command: Command = try command_executor_test_command(&router, &copied_get_parsed);
    const copied_get_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &copied_get_command, 1000u64);
    try assert_eq_i32(copied_get_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&copied_get_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_maxmemory_allkeys_lru() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.maxmemory_policy = MaxmemoryPolicy.maxmemory_allkeys_lru;

    var old_value: [byte: 1024] = [];
    var hot_value: [byte: 1024] = [];
    command_executor_test_fill_bytes(old_value[0: 1024], 97 as byte);
    command_executor_test_fill_bytes(hot_value[0: 1024], 98 as byte);
    const old_obj: &RedisObject = try create_string_object(old_value[0: 1024]);
    const hot_obj: &RedisObject = try create_string_object(hot_value[0: 1024]);
    try set_key_at(&engine, &"old"[0: 3], old_obj, 1000u64);
    try set_key_at(&engine, &"hot"[0: 3], hot_obj, 2000u64);
    _ = try lookup_key_at(&engine, &"hot"[0: 3], 3000u64);

    var set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$3\r\nnew\r\n$1\r\nx\r\n"[0: 29]);
    const set_command: Command = try command_executor_test_command(&router, &set_parsed);
    runtime.config.maxmemory = used_memory() + 1;
    const set_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &set_command, 4000u64);
    try assert_eq_i32(set_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(set_reply.data, &"OK"[0: 2]));
    resp_value_free(&set_parsed.value);

    runtime.config.maxmemory = 0;
    try assert_true(command_executor_test_key_missing_at(&engine, &"old"[0: 3], 5000u64));
    const hot_found: &RedisObject = try lookup_key_at(&engine, &"hot"[0: 3], 5000u64);
    try assert_true(command_executor_test_slice_eq(hot_found.value.buf[0: hot_found.value.len], hot_value[0: 1024]));
    const new_found: &RedisObject = try lookup_key_at(&engine, &"new"[0: 3], 5000u64);
    try assert_true(command_executor_test_slice_eq(new_found.value.buf[0: new_found.value.len], &"x"[0: 1]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_maxmemory_allkeys_lfu() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
