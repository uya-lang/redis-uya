    var sort_get_parsed: RespParseResult = try parse_resp2(&"*8\r\n$4\r\nSORT\r\n$7\r\nsortnum\r\n$2\r\nBY\r\n$7\r\nsortw_*\r\n$3\r\nGET\r\n$5\r\nobj_*\r\n$3\r\nGET\r\n$1\r\n#\r\n"[0: 84]);
