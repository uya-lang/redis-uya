    resp_value_free(&default_parsed.value);

    var to_parsed: RespParseResult = try parse_resp2(&"*4\r\n$8\r\nFAILOVER\r\n$2\r\nTO\r\n$9\r\n127.0.0.1\r\n$4\r\n6380\r\n"[0: 51]);
    const to_command: Command = try command_executor_test_command(&router, &to_parsed);
    const to_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &to_command, 1000u64);
    try assert_eq_i32(to_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(to_reply.data, &"ERR FAILOVER requires connected replicas."[0: 41]));
    resp_value_free(&to_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

