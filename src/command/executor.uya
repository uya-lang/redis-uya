fn command_executor_sismember(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const member: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }
    const present: bool = command_executor_set_contains(obj, member) catch {
        return command_executor_wrongtype();
    };
    if present {
        return command_executor_integer(1);
    }
    return command_executor_integer(0);
}

fn command_executor_smismember(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        var empty_reply: Sds = sds_empty() catch {
            return command_executor_oom();
        };
        defer {
            sds_free(&empty_reply);
        }
        _ = command_executor_resp_collection_prefix(&empty_reply, &"*"[0: 1], command.argc - 2) catch {
            return command_executor_oom();
        };
        var missing_index: usize = 2;
        while missing_index < command.argc {
            _ = command_executor_info_append_i64(&empty_reply, &":%i\r\n"[0: 5], 0) catch {
                return command_executor_oom();
            };
            missing_index = missing_index + 1;
        }
        return command_executor_owned_raw(empty_reply.buf[0: empty_reply.len]);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], command.argc - 2) catch {
        return command_executor_oom();
    };
    var index: usize = 2;
    while index < command.argc {
        const member: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const present: bool = command_executor_set_contains(obj, member) catch {
            return command_executor_wrongtype();
        };
        var integer_value: i64 = 0;
        if present {
            integer_value = 1;
        }
        _ = command_executor_info_append_i64(&raw, &":%i\r\n"[0: 5], integer_value) catch {
            return command_executor_oom();
        };
        index = index + 1;
    }
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_sscan(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 && command.argc != 5 {
        return command_executor_wrong_arity();
    }

    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_scan(0u64, null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const cursor_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const cursor_i64: i64 = command_executor_parse_i64(cursor_data) catch {
        return command_executor_invalid_integer();
    };
    if cursor_i64 < 0 {
        return command_executor_invalid_integer();
    }

    var count_hint: usize = 10;
    if command.argc == 5 {
        const option: &[byte] = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(option, &"COUNT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const count_data: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        const count_i64: i64 = command_executor_parse_i64(count_data) catch {
            return command_executor_invalid_integer();
        };
        if count_i64 <= 0 {
            return command_executor_invalid_integer();
        }
        count_hint = count_i64 as usize;
    }

    const members: &RedisObject = command_executor_set_sorted_members(obj) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const total: usize = list_object_len(members) catch {
        object_free(members);
        return command_executor_wrongtype();
    };

    const cursor: usize = cursor_i64 as usize;
    var emit_head: &ListNode = null as &ListNode;
    var emit_count: usize = 0;
    var next_cursor: u64 = 0u64;

    if cursor < total {
        const stop_index: i64 = cursor_i64 + (count_hint as i64) - 1;
        const view: ListRangeView = list_object_range(members, cursor_i64, stop_index) catch {
            object_free(members);
            return command_executor_wrongtype();
        };
        emit_head = view.head;
        emit_count = view.count;
        if cursor + emit_count < total {
            next_cursor = (cursor + emit_count) as u64;
        }
    }

    var reply: CommandReply = command_executor_scan(next_cursor, emit_head, emit_count);
    reply.owned_object = members;
    return reply;
}

fn command_executor_smove(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }

    const source: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const destination: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const member: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };

    const source_obj: &RedisObject = lookup_key_at(engine, source, now_ms) catch {
        return command_executor_integer(0);
    };
    if source_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const source_has_member: bool = command_executor_set_contains(source_obj, member) catch {
        return command_executor_wrongtype();
    };

    if bytes_eq(source, destination) {
        if source_has_member {
            return command_executor_integer(1);
        }
        return command_executor_integer(0);
    }

    const destination_result: !&RedisObject = lookup_key_at(engine, destination, now_ms);
    const destination_obj: &RedisObject = destination_result catch {
        null as &RedisObject;
    };
    if destination_obj != null && destination_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    if !source_has_member {
        return command_executor_integer(0);
    }

    if destination_obj == null {
        const new_destination: &RedisObject = create_set_object() catch {
            return command_executor_oom();
        };
        _ = set_object_add_member(new_destination, member) catch |err| {
            object_free(new_destination);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };

        const removed_missing: bool = set_object_remove_member(source_obj, member) catch {
            object_free(new_destination);
            return command_executor_wrongtype();
        };
        if !removed_missing {
            object_free(new_destination);
            return command_executor_integer(0);
        }

        _ = set_key_at(engine, destination, new_destination, now_ms) catch {
            _ = set_object_add_member(source_obj, member) catch {};
            object_free(new_destination);
            return command_executor_oom();
        };

        const source_remaining: usize = set_object_len(source_obj) catch {
            return command_executor_wrongtype();
        };
        if source_remaining == 0 {
            _ = delete_key(engine, source);
        }
        return command_executor_integer(1);
    }

    const destination_has_member: bool = command_executor_set_contains(destination_obj, member) catch {
        return command_executor_wrongtype();
    };
    if !destination_has_member {
        _ = set_object_add_member(destination_obj, member) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
    }

    const removed_existing: bool = set_object_remove_member(source_obj, member) catch {
        if !destination_has_member {
            _ = set_object_remove_member(destination_obj, member) catch {};
        }
        return command_executor_wrongtype();
    };
    if !removed_existing {
        if !destination_has_member {
            _ = set_object_remove_member(destination_obj, member) catch {};
        }
        return command_executor_integer(0);
    }

    const remaining: usize = set_object_len(source_obj) catch {
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, source);
    }
    return command_executor_integer(1);
}

fn command_executor_spop(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_null_bulk();
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const member: &[byte] = command_executor_set_any_member(obj) catch {
        return command_executor_null_bulk();
    };
    const reply_obj: &RedisObject = create_string_object(member) catch {
        return command_executor_oom();
    };
    _ = set_object_remove_member(obj, member) catch {
        object_free(reply_obj);
        return command_executor_wrongtype();
    };
    const remaining: usize = set_object_len(obj) catch {
        object_free(reply_obj);
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, key);
    }
    const data: &[byte] = reply_obj.value.buf[0: reply_obj.value.len];
    var reply: CommandReply = command_executor_bulk(data);
    reply.owned_object = reply_obj;
    return reply;
}

fn command_executor_srandmember(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_null_bulk();
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const member: &[byte] = command_executor_set_any_member(obj) catch {
        return command_executor_null_bulk();
    };
    return command_executor_bulk(member);
}

fn command_executor_sinter(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }

    const first_key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const first_obj: &RedisObject = lookup_key_at(engine, first_key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if first_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    const members: &RedisObject = command_executor_set_sorted_members(first_obj) catch |err| {
        object_free(result_set);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var present_everywhere: bool = true;
        var arg_index: usize = 2;
        while arg_index < command.argc {
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                present_everywhere = false;
                null as &RedisObject;
            };
            if obj == null {
                present_everywhere = false;
                break;
            }
            if obj.obj_type != ObjectType.object_set {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            }
            const present: bool = command_executor_set_contains(obj, member) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            };
            if !present {
                present_everywhere = false;
                break;
            }
            arg_index = arg_index + 1;
        }
        if present_everywhere {
            _ = set_object_add_member(result_set, member) catch |err| {
                object_free(members);
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        }
        node = node.next;
    }
    object_free(members);
    const reply: CommandReply = command_executor_set_reply_from_set(result_set);
    object_free(result_set);
    return reply;
}

fn command_executor_sdiff(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }

    const first_key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const first_obj: &RedisObject = lookup_key_at(engine, first_key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if first_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    const members: &RedisObject = command_executor_set_sorted_members(first_obj) catch |err| {
        object_free(result_set);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var seen_elsewhere: bool = false;
        var arg_index: usize = 2;
        while arg_index < command.argc {
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                arg_index = arg_index + 1;
                null as &RedisObject;
            };
            if obj == null {
                continue;
            }
            if obj.obj_type != ObjectType.object_set {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            }
            const present: bool = command_executor_set_contains(obj, member) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            };
            if present {
                seen_elsewhere = true;
                break;
            }
            arg_index = arg_index + 1;
        }
        if !seen_elsewhere {
            _ = set_object_add_member(result_set, member) catch |err| {
                object_free(members);
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        }
        node = node.next;
    }
    object_free(members);
    const reply: CommandReply = command_executor_set_reply_from_set(result_set);
    object_free(result_set);
    return reply;
}

fn command_executor_sunion(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }

    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    var arg_index: usize = 1;
    while arg_index < command.argc {
        const key: &[byte] = command_executor_arg(command, arg_index) catch {
            object_free(result_set);
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        const obj: &RedisObject = obj_result catch {
            arg_index = arg_index + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_set {
            object_free(result_set);
            return command_executor_wrongtype();
        }
        var iter: DictIterator = dict_iter_new();
        var entry: &DictEntry = dict_iter_next(&obj.hash_dict, &iter);
        while entry != null {
            _ = set_object_add_member(result_set, entry.key.buf[0: entry.key.len]) catch |err| {
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
            entry = dict_iter_next(&obj.hash_dict, &iter);
        }
        arg_index = arg_index + 1;
    }
    const reply: CommandReply = command_executor_set_reply_from_set(result_set);
    object_free(result_set);
    return reply;
}

fn command_executor_sintercard(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }

    const numkeys_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }

    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 2 + numkeys;
    if command.argc < keys_end {
        return command_executor_error(&"ERR Number of keys can't be greater than number of args"[0: 55]);
    }

    var limit: usize = 0;
    if command.argc > keys_end {
        if command.argc != keys_end + 2 {
            return command_executor_syntax_error();
        }
        const option: &[byte] = command_executor_arg(command, keys_end) catch {
            return command_executor_syntax_error();
        };
        if !command_executor_keyword_eq(option, &"LIMIT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const limit_data: &[byte] = command_executor_arg(command, keys_end + 1) catch {
            return command_executor_syntax_error();
        };
        const limit_i64: i64 = command_executor_parse_i64(limit_data) catch {
            return command_executor_error(&"ERR LIMIT can't be negative"[0: 27]);
        };
        if limit_i64 < 0 {
            return command_executor_error(&"ERR LIMIT can't be negative"[0: 27]);
        }
        limit = limit_i64 as usize;
    }

    var missing_any: bool = false;
    var candidate: &RedisObject = null as &RedisObject;
    var candidate_arg_index: usize = 2;
    var candidate_len: usize = 0;
    var arg_index_check: usize = 2;
    while arg_index_check < keys_end {
        const key_check: &[byte] = command_executor_arg(command, arg_index_check) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key_check, now_ms);
        const obj: &RedisObject = obj_result catch {
            missing_any = true;
            arg_index_check = arg_index_check + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_set {
            return command_executor_wrongtype();
        }
        const obj_len: usize = set_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if candidate == null || obj_len < candidate_len {
            candidate = obj;
            candidate_arg_index = arg_index_check;
            candidate_len = obj_len;
        }
        arg_index_check = arg_index_check + 1;
    }

    if candidate == null || missing_any {
        return command_executor_integer(0);
    }

    if numkeys == 1 {
        if limit > 0 && candidate_len > limit {
            return command_executor_integer(limit as i64);
        }
        return command_executor_integer(candidate_len as i64);
    }

    const members: &RedisObject = command_executor_set_sorted_members(candidate) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(members);
    }

    var count: usize = 0;
    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var present_everywhere: bool = true;
        var arg_index: usize = 2;
        while arg_index < keys_end {
            if arg_index == candidate_arg_index {
                arg_index = arg_index + 1;
                continue;
            }
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                present_everywhere = false;
                null as &RedisObject;
            };
            if obj == null {
                break;
            }
            if obj.obj_type != ObjectType.object_set {
                return command_executor_wrongtype();
            }
            const present: bool = command_executor_set_contains(obj, member) catch {
                return command_executor_wrongtype();
            };
            if !present {
                present_everywhere = false;
                break;
            }
            arg_index = arg_index + 1;
        }
        if present_everywhere {
            count = count + 1;
            if limit > 0 && count >= limit {
                return command_executor_integer(limit as i64);
            }
        }
        node = node.next;
    }
    return command_executor_integer(count as i64);
}

fn command_executor_set_store_result(engine: &Engine, target: &[byte], result_set: &RedisObject, now_ms: u64) CommandReply {
    const len: usize = set_object_len(result_set) catch {
        object_free(result_set);
        return command_executor_wrongtype();
    };
    if len == 0 {
        object_free(result_set);
        _ = delete_key(engine, target);
        return command_executor_integer(0);
    }
    _ = set_key_at(engine, target, result_set, now_ms) catch {
        object_free(result_set);
        return command_executor_oom();
    };
    return command_executor_integer(len as i64);
}

fn command_executor_bulk_i64(value: i64) CommandReply {
    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_i64(value);
    _ = sds_cat_fmt(&buf, &"%i"[0: 2], args[0: 1]) catch {
        return command_executor_oom();
    };
    const obj: &RedisObject = create_string_object(buf.buf[0: buf.len]) catch {
        return command_executor_oom();
    };
    var reply: CommandReply = command_executor_bulk(obj.value.buf[0: obj.value.len]);
    reply.owned_object = obj;
    return reply;
}

fn command_executor_busykey() CommandReply {
    return command_executor_error(&"BUSYKEY Target key name already exists."[0: 37]);
}

fn command_executor_rename_common(engine: &Engine, command: &Command, now_ms: u64, overwrite: bool) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const source: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const target: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const result: EngineRenameResult = engine_rename_key(engine, source, target, overwrite) catch {
        return command_executor_oom();
    };
    _ = now_ms;
    match result {
        EngineRenameResult.rename_ok => {
            if overwrite {
                return command_executor_simple(&"OK"[0: 2]);
            }
            return command_executor_integer(1);
        },
        EngineRenameResult.rename_source_missing => {
            return command_executor_error(&"ERR no such key"[0: 14]);
        },
        EngineRenameResult.rename_target_exists => {
            return command_executor_integer(0);
        },
        EngineRenameResult.rename_same_key => {
            return command_executor_error(&"ERR source and destination objects are the same"[0: 47]);
        },
        else => {
            return command_executor_error(&"ERR rename failed"[0: 17]);
        }
    }
}

fn command_executor_rename(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    return command_executor_rename_common(engine, command, now_ms, true);
}

fn command_executor_renamenx(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    return command_executor_rename_common(engine, command, now_ms, false);
}

fn command_executor_lastsave(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    if command.argc != 1 {
        return command_executor_wrong_arity();
    }
    return command_executor_integer((runtime.lastsave_ms / 1000u64) as i64);
}

fn command_executor_select(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const db_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const db_index: i64 = command_executor_parse_i64(db_data) catch {
        return command_executor_invalid_integer();
    };
    if db_index != 0 {
        return command_executor_error(&"ERR DB index is out of range"[0: 28]);
    }
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_object_help() CommandReply {
    const reply_list: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    _ = list_object_push_tail(reply_list, &"OBJECT ENCODING <key>"[0: 21]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    _ = list_object_push_tail(reply_list, &"OBJECT FREQ <key>"[0: 17]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    _ = list_object_push_tail(reply_list, &"OBJECT IDLETIME <key>"[0: 21]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    _ = list_object_push_tail(reply_list, &"OBJECT REFCOUNT <key>"[0: 21]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    _ = list_object_push_tail(reply_list, &"OBJECT HELP"[0: 11]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    return command_executor_owned_array(reply_list);
}

fn command_executor_object(runtime: &CommandRuntimeInfo, engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }

    const subcommand: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    if command_executor_keyword_eq(subcommand, &"HELP"[0: 4]) {
        if command.argc != 2 {
            return command_executor_wrong_arity();
        }
        return command_executor_object_help();
    }

    if command.argc != 3 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'object|encoding' command"[0: 59]);
    }

    const key: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_no_touch_at(engine, key, now_ms) catch {
        return command_executor_null_bulk();
    };

    if command_executor_keyword_eq(subcommand, &"ENCODING"[0: 8]) {
        return command_executor_bulk(object_encoding_name(obj.encoding));
    }
    if command_executor_keyword_eq(subcommand, &"REFCOUNT"[0: 8]) {
        return command_executor_integer(1);
    }
    if command_executor_keyword_eq(subcommand, &"IDLETIME"[0: 8]) {
        if runtime.config.maxmemory_policy == MaxmemoryPolicy.maxmemory_allkeys_lfu ||
            runtime.config.maxmemory_policy == MaxmemoryPolicy.maxmemory_volatile_lfu {
            return command_executor_error(&"ERR An LFU maxmemory policy is selected, idle time not tracked. Please note that when switching between policies at runtime LRU and LFU data will take some time to adjust."[0: 171]);
        }
        if now_ms <= obj.lru_at_ms {
            return command_executor_integer(0);
        }
        return command_executor_integer(((now_ms - obj.lru_at_ms) / 1000u64) as i64);
    }
    if command_executor_keyword_eq(subcommand, &"FREQ"[0: 4]) {
        if runtime.config.maxmemory_policy != MaxmemoryPolicy.maxmemory_allkeys_lfu &&
            runtime.config.maxmemory_policy != MaxmemoryPolicy.maxmemory_volatile_lfu {
            return command_executor_error(&"ERR An LFU maxmemory policy is not selected, access frequency not tracked. Please note that when switching between policies at runtime LRU and LFU data will take some time to adjust."[0: 182]);
        }
        return command_executor_integer(obj.lfu_counter as i64);
    }

    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR unknown subcommand '"[0: 24]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"'. Try OBJECT HELP."[0: 19]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_move(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const db_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const db_index: i64 = command_executor_parse_i64(db_data) catch {
        return command_executor_invalid_integer();
    };
    if db_index != 0 {
        return command_executor_error(&"ERR DB index is out of range"[0: 28]);
    }
    return command_executor_error(&"ERR source and destination objects are the same"[0: 47]);
}

fn command_executor_wait(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const replicas_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const timeout_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const replicas: i64 = command_executor_parse_i64(replicas_data) catch {
        return command_executor_invalid_integer();
    };
    const timeout_ms: i64 = command_executor_parse_i64(timeout_data) catch {
        return command_executor_invalid_integer();
    };
    if timeout_ms < 0 {
        return command_executor_error(&"ERR timeout is negative"[0: 23]);
    }
    if replicas <= 0 {
        return command_executor_integer(0);
    }
    return command_executor_integer(0);
}

fn command_executor_sort_reply_from_members(engine: &Engine, ordered: &RedisObject, options: &SortOptions, now_ms: u64) CommandReply {
    _ = engine;
    const window: SortEmitWindow = command_executor_sort_emit_window(ordered.list_len, options);
    if window.count == 0 {
        return command_executor_array_bulk(null as &ListNode, 0);
    }

    if options.get_count == 0 {
        const reply_list: &RedisObject = create_list_object() catch {
            return command_executor_oom();
        };
        const view: ListRangeView = list_object_range(ordered, window.start, window.start + (window.count as i64) - 1) catch {
            object_free(reply_list);
            return command_executor_wrongtype();
        };
        var node_plain: &ListNode = view.head;
        var emitted_plain: usize = 0;
        while node_plain != null && emitted_plain < view.count {
            const member_plain: &[byte] = node_plain.value.value.buf[0: node_plain.value.value.len];
            _ = list_object_push_tail(reply_list, member_plain) catch {
                object_free(reply_list);
                return command_executor_oom();
            };
            node_plain = node_plain.next;
            emitted_plain = emitted_plain + 1;
        }
        return command_executor_owned_array(reply_list);
    }

    const projected: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    var null_map: Sds = sds_empty() catch {
        object_free(projected);
        return command_executor_oom();
    };
    defer {
        sds_free(&null_map);
    }
    const view_projected: ListRangeView = list_object_range(ordered, window.start, window.start + (window.count as i64) - 1) catch {
        object_free(projected);
        return command_executor_wrongtype();
    };
    var has_null: bool = false;
    var node: &ListNode = view_projected.head;
    var emitted: usize = 0;
    while node != null && emitted < view_projected.count {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var pattern_node: &ListNode = options.get_patterns.list_head;
        while pattern_node != null {
            const pattern: &[byte] = pattern_node.value.value.buf[0: pattern_node.value.value.len];
            const value: SortValueResult = command_executor_sort_lookup_value(engine, pattern, member, now_ms) catch |err| {
                object_free(projected);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                if err == error.CommandInvalidFloat {
                    return command_executor_sort_numeric_error();
                }
                return command_executor_wrongtype();
            };
            var result_data: &[byte] = command_executor_empty_slice();
            var null_flag: byte = 0 as byte;
            if value.found {
                result_data = value.data;
            } else {
                has_null = true;
                null_flag = 1 as byte;
            }
            _ = list_object_push_tail(projected, result_data) catch {
                object_free(projected);
                return command_executor_oom();
            };
            var null_byte: [byte: 1] = [];
            null_byte[0] = null_flag;
            _ = sds_cat(&null_map, null_byte[0: 1]) catch {
                object_free(projected);
                return command_executor_oom();
            };
            pattern_node = pattern_node.next;
        }
        node = node.next;
        emitted = emitted + 1;
    }
    if !has_null {
        return command_executor_owned_array(projected);
    }
    const null_map_obj: &RedisObject = create_string_object(null_map.buf[0: null_map.len]) catch {
        object_free(projected);
        return command_executor_oom();
    };
    var reply: CommandReply = command_executor_nullable_array_bulk(projected.list_head, projected.list_len, null_map_obj);
    reply.owned_object = projected;
    return reply;
}

fn command_executor_sort_store_members(engine: &Engine, ordered: &RedisObject, options: &SortOptions, now_ms: u64) CommandReply {
    const window: SortEmitWindow = command_executor_sort_emit_window(ordered.list_len, options);
    var per_member: usize = options.get_count;
    if per_member == 0 {
        per_member = 1;
    }
    const total_count: usize = window.count * per_member;
    if total_count == 0 {
        _ = delete_key(engine, options.store_destination);
        return command_executor_integer(0);
    }

    const stored: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    const view: ListRangeView = list_object_range(ordered, window.start, window.start + (window.count as i64) - 1) catch {
        object_free(stored);
        return command_executor_wrongtype();
    };
    var node: &ListNode = view.head;
    var emitted: usize = 0;
    while node != null && emitted < view.count {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        if options.get_count == 0 {
            _ = list_object_push_tail(stored, member) catch {
                object_free(stored);
                return command_executor_oom();
            };
        } else {
            var pattern_node: &ListNode = options.get_patterns.list_head;
            while pattern_node != null {
                const pattern: &[byte] = pattern_node.value.value.buf[0: pattern_node.value.value.len];
                const value: SortValueResult = command_executor_sort_lookup_value(engine, pattern, member, now_ms) catch |err| {
                    object_free(stored);
                    if err == error.AllocOutOfMemory {
                        return command_executor_oom();
                    }
                    if err == error.CommandInvalidFloat {
                        return command_executor_sort_numeric_error();
                    }
                    return command_executor_wrongtype();
                };
                var stored_data: &[byte] = command_executor_empty_slice();
                if value.found {
                    stored_data = value.data;
                }
                _ = list_object_push_tail(stored, stored_data) catch {
                    object_free(stored);
                    return command_executor_oom();
                };
                pattern_node = pattern_node.next;
            }
        }
        node = node.next;
        emitted = emitted + 1;
    }

    _ = set_key_at(engine, options.store_destination, stored, now_ms) catch {
        object_free(stored);
        return command_executor_oom();
    };
    _ = clear_key_expire(engine, options.store_destination);
    return command_executor_integer(total_count as i64);
}

fn command_executor_sort(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    var options: SortOptions = command_executor_sort_parse_options(command) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        if err == error.CommandInvalidInteger {
            return command_executor_invalid_integer();
        }
        return command_executor_syntax_error();
    };
    defer {
        command_executor_sort_cleanup_options(&options);
    }

    const source: &RedisObject = command_executor_sort_collect_source(engine, key, now_ms) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(source);
    }

    const ordered: &RedisObject = command_executor_sort_order_members(engine, source, &options, now_ms) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        if err == error.CommandInvalidFloat {
            return command_executor_sort_numeric_error();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(ordered);
    }

    if options.store_enabled {
        return command_executor_sort_store_members(engine, ordered, &options, now_ms);
    }
    return command_executor_sort_reply_from_members(engine, ordered, &options, now_ms);
}

fn command_executor_sort_ro(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    var options: SortOptions = command_executor_sort_parse_options(command) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        if err == error.CommandInvalidInteger {
            return command_executor_invalid_integer();
        }
        return command_executor_syntax_error();
    };
    defer {
        command_executor_sort_cleanup_options(&options);
    }
    if options.store_enabled {
        return command_executor_syntax_error();
    }

    const source: &RedisObject = command_executor_sort_collect_source(engine, key, now_ms) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(source);
    }

    const ordered: &RedisObject = command_executor_sort_order_members(engine, source, &options, now_ms) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        if err == error.CommandInvalidFloat {
            return command_executor_sort_numeric_error();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(ordered);
    }

    return command_executor_sort_reply_from_members(engine, ordered, &options, now_ms);
}

fn command_executor_flushdb(engine: &Engine, command: &Command) CommandReply {
    if command.argc != 1 {
        return command_executor_wrong_arity();
    }
    _ = engine_flush_all(engine);
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_flushall(engine: &Engine, command: &Command) CommandReply {
    if command.argc != 1 {
        return command_executor_wrong_arity();
    }
    _ = engine_flush_all(engine);
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_dump(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_null_bulk();
    };
    const clone: &RedisObject = object_clone(obj) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var temp_engine: Engine = engine_new();
    _ = set_key_at(&temp_engine, key, clone, now_ms) catch {
        object_free(clone);
        engine_free(&temp_engine);
        return command_executor_oom();
    };
    const dump_obj: &RedisObject = rdb_dump_object_at(&temp_engine, now_ms) catch |err| {
        engine_free(&temp_engine);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_error(&"ERR dump failed"[0: 15]);
    };
    engine_free(&temp_engine);
    var reply: CommandReply = command_executor_bulk(dump_obj.value.buf[0: dump_obj.value.len]);
    reply.owned_object = dump_obj;
    return reply;
}

fn command_executor_restore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const ttl_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const payload: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const ttl_ms: i64 = command_executor_parse_i64(ttl_data) catch {
        return command_executor_invalid_integer();
    };
    if ttl_ms < 0 {
        return command_executor_invalid_integer();
    }
    const existing: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    if existing != null {
        return command_executor_busykey();
    }

    var temp_engine: Engine = engine_new();
    const load_result: !void = rdb_load_bytes_at(payload, &temp_engine, now_ms);
    load_result catch |err| {
        engine_free(&temp_engine);
        if err == error.RdbInvalidFormat || err == error.RdbTruncated || err == error.RdbUnsupportedType {
            return command_executor_error(&"ERR invalid dump payload"[0: 24]);
        }
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    };

    const keys_obj: &RedisObject = engine_scan_keys_at(&temp_engine, now_ms) catch {
        engine_free(&temp_engine);
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    };
    defer {
        object_free(keys_obj);
    }
    const key_count: usize = list_object_len(keys_obj) catch {
        engine_free(&temp_engine);
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    };
    if key_count != 1 || keys_obj.list_head == null {
        engine_free(&temp_engine);
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    }
    const source_key: &[byte] = keys_obj.list_head.value.value.buf[0: keys_obj.list_head.value.value.len];
    const restored_obj: &RedisObject = lookup_key_at(&temp_engine, source_key, now_ms) catch {
        engine_free(&temp_engine);
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    };
    const clone: &RedisObject = object_clone(restored_obj) catch |err| {
        engine_free(&temp_engine);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    };
    engine_free(&temp_engine);

    _ = set_key_at(engine, key, clone, now_ms) catch {
        object_free(clone);
        return command_executor_oom();
    };
    if ttl_ms > 0 {
        _ = set_key_expire_at(engine, key, now_ms + ttl_ms as u64) catch {
            _ = delete_key(engine, key);
            return command_executor_oom();
        };
    }
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_list_push_i64(obj: &RedisObject, value: i64) !void {
    var buf: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&buf);
    }
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_i64(value);
    _ = sds_cat_fmt(&buf, &"%i"[0: 2], args[0: 1]) catch {
        return error.AllocOutOfMemory;
    };
    _ = list_object_push_tail(obj, buf.buf[0: buf.len]) catch |err| {
        return err;
    };
}

fn command_executor_sinterstore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const target: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const first_key: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const first_obj: &RedisObject = lookup_key_at(engine, first_key, now_ms) catch {
        const empty: &RedisObject = create_set_object() catch {
            return command_executor_oom();
        };
        return command_executor_set_store_result(engine, target, empty, now_ms);
    };
    if first_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    const members: &RedisObject = command_executor_set_sorted_members(first_obj) catch |err| {
        object_free(result_set);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var present_everywhere: bool = true;
        var arg_index: usize = 3;
        while arg_index < command.argc {
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                present_everywhere = false;
                null as &RedisObject;
            };
            if obj == null {
                present_everywhere = false;
                break;
            }
            if obj.obj_type != ObjectType.object_set {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            }
            const present: bool = command_executor_set_contains(obj, member) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            };
            if !present {
                present_everywhere = false;
                break;
            }
            arg_index = arg_index + 1;
        }
        if present_everywhere {
            _ = set_object_add_member(result_set, member) catch |err| {
                object_free(members);
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        }
        node = node.next;
    }
    object_free(members);
    return command_executor_set_store_result(engine, target, result_set, now_ms);
}

fn command_executor_sdiffstore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const target: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const first_key: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const first_obj: &RedisObject = lookup_key_at(engine, first_key, now_ms) catch {
        const empty: &RedisObject = create_set_object() catch {
            return command_executor_oom();
        };
        return command_executor_set_store_result(engine, target, empty, now_ms);
    };
    if first_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    const members: &RedisObject = command_executor_set_sorted_members(first_obj) catch |err| {
        object_free(result_set);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var seen_elsewhere: bool = false;
        var arg_index: usize = 3;
        while arg_index < command.argc {
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                arg_index = arg_index + 1;
                null as &RedisObject;
            };
            if obj == null {
                continue;
            }
            if obj.obj_type != ObjectType.object_set {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            }
            const present: bool = command_executor_set_contains(obj, member) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            };
            if present {
                seen_elsewhere = true;
                break;
            }
            arg_index = arg_index + 1;
        }
        if !seen_elsewhere {
            _ = set_object_add_member(result_set, member) catch |err| {
                object_free(members);
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        }
        node = node.next;
    }
    object_free(members);
    return command_executor_set_store_result(engine, target, result_set, now_ms);
}

fn command_executor_sunionstore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const target: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    var arg_index: usize = 2;
    while arg_index < command.argc {
        const key: &[byte] = command_executor_arg(command, arg_index) catch {
            object_free(result_set);
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        const obj: &RedisObject = obj_result catch {
            arg_index = arg_index + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_set {
            object_free(result_set);
            return command_executor_wrongtype();
        }
        var iter: DictIterator = dict_iter_new();
        var entry: &DictEntry = dict_iter_next(&obj.hash_dict, &iter);
        while entry != null {
            _ = set_object_add_member(result_set, entry.key.buf[0: entry.key.len]) catch |err| {
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
            entry = dict_iter_next(&obj.hash_dict, &iter);
        }
        arg_index = arg_index + 1;
    }
    return command_executor_set_store_result(engine, target, result_set, now_ms);
}

fn command_executor_zincrby(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const increment_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const member: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const increment: i64 = command_executor_parse_i64(increment_data) catch {
        return command_executor_invalid_integer();
    };

    const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
    const obj: &RedisObject = obj_result catch {
        const zset_obj: &RedisObject = create_zset_object() catch {
            return command_executor_oom();
        };
        _ = zset_object_add_member(zset_obj, increment, member) catch |err| {
            object_free(zset_obj);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        _ = set_key_at(engine, key, zset_obj, now_ms) catch {
            object_free(zset_obj);
            return command_executor_oom();
        };
        return command_executor_bulk_i64(increment);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    const current_score_result: !i64 = zset_object_get_score(obj, member);
    const current_score: i64 = current_score_result catch {
        _ = zset_object_add_member(obj, increment, member) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        return command_executor_bulk_i64(increment);
    };
    const next_score: i64 = current_score + increment;
    _ = zset_object_add_member(obj, next_score, member) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    return command_executor_bulk_i64(next_score);
}

fn command_executor_zcard(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    const len: usize = zset_object_len(obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_integer(len as i64);
}

fn command_executor_zcount(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const min_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const max_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const min_score: i64 = command_executor_parse_i64(min_data) catch {
        return command_executor_invalid_integer();
    };
    const max_score: i64 = command_executor_parse_i64(max_data) catch {
        return command_executor_invalid_integer();
    };
    if min_score > max_score {
        return command_executor_integer(0);
    }
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    var count: i64 = 0;
    var iter: DictIterator = dict_iter_new();
    var entry: &DictEntry = dict_iter_next(&obj.hash_dict, &iter);
    while entry != null {
        const score: i64 = zset_object_get_score(obj, entry.key.buf[0: entry.key.len]) catch {
            return command_executor_wrongtype();
        };
        if score >= min_score && score <= max_score {
            count = count + 1;
        }
        entry = dict_iter_next(&obj.hash_dict, &iter);
    }
    return command_executor_integer(count);
}

fn command_executor_zrangebyscore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const min_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const max_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const min_score: i64 = command_executor_parse_i64(min_data) catch {
        return command_executor_invalid_integer();
    };
    const max_score: i64 = command_executor_parse_i64(max_data) catch {
        return command_executor_invalid_integer();
    };
    if min_score > max_score {
        return command_executor_array_bulk(null as &ListNode, 0);
    }
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    const ranged: &RedisObject = zset_object_range_by_score_reply(obj, min_score, max_score, false) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const count: usize = list_object_len(ranged) catch {
        object_free(ranged);
        return command_executor_wrongtype();
    };
    var reply: CommandReply = command_executor_array_bulk(ranged.list_head, count);
    reply.owned_object = ranged;
    return reply;
}

fn command_executor_zremrangebyrank(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const start_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const stop_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const start: i64 = command_executor_parse_i64(start_data) catch {
        return command_executor_invalid_integer();
    };
    const stop: i64 = command_executor_parse_i64(stop_data) catch {
        return command_executor_invalid_integer();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    const ranged: &RedisObject = zset_object_range_reply(obj, start, stop) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var removed: i64 = 0;
    var node: &ListNode = ranged.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        const deleted: bool = zset_object_remove_member(obj, member) catch {
            object_free(ranged);
            return command_executor_wrongtype();
        };
        if deleted {
            removed = removed + 1;
        }
        node = node.next;
    }
    object_free(ranged);
    if removed > 0 {
        const remaining: usize = zset_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if remaining == 0 {
            _ = delete_key(engine, key);
        }
    }
    return command_executor_integer(removed);
}

