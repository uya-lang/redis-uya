    const geodist_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$7\r\nGEODIST\r\n$3\r\ngeo\r\n$7\r\nPalermo\r\n$7\r\nCatania\r\n$2\r\nkm\r\n"[0: 60], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: geodist_result.response_len], &"$8\r\n166.2742\r\n"[0: 14]));

