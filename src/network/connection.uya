fn connection_acl_channel_pattern_add(patterns: &[ConnectionAclChannelPattern], pattern: &[byte]) !void {
    if pattern.len == 0 || pattern.len > CONNECTION_ACL_CHANNEL_PATTERN_BYTES_MAX {
        return error.ConnectionInputTooLarge;
    }
    if connection_acl_channel_pattern_find(patterns, pattern) >= 0 {
        return;
    }
    const slot: i32 = connection_acl_channel_pattern_find_free(patterns);
    if slot < 0 {
        return error.ConnectionInputTooLarge;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= patterns.len {
        return error.ConnectionInputTooLarge;
    }
    patterns.ptr[slot_index].active = true;
    patterns.ptr[slot_index].pattern_len = pattern.len;
    var i: usize = 0;
    while i < pattern.len {
        patterns.ptr[slot_index].pattern[i] = pattern.ptr[i];
        i = i + 1;
    }
    while i < CONNECTION_ACL_CHANNEL_PATTERN_BYTES_MAX {
        patterns.ptr[slot_index].pattern[i] = 0 as byte;
        i = i + 1;
    }
}

