fn aof_test_slice_eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len { return false; }
    var i: usize = 0;
    while i < a.len {
        if a.ptr[i] != b.ptr[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn aof_test_copy(dst: &byte, offset: usize, data: &[byte]) usize {
    var i: usize = 0;
    while i < data.len {
        dst[offset + i] = data.ptr[i];
        i = i + 1;
    }
    return offset + data.len;
}

fn aof_test_fill(dst: &byte, offset: usize, len: usize, value: byte) usize {
    var i: usize = 0;
    while i < len {
        dst[offset + i] = value;
        i = i + 1;
    }
    return offset + len;
}

fn aof_test_append_decimal(dst: &byte, offset: usize, value: usize) !usize {
    var buf: [byte: 32] = [];
    const written: i32 = snprintf(&buf[0] as *byte, 32usize, "%zu" as *byte, value);
    if written <= 0 || written >= 32 {
        return error.AllocOutOfMemory;
    }
    return aof_test_copy(dst, offset, buf[0: written as usize]);
}

fn aof_replay_fails(path: &const byte) bool {
    var engine: Engine = engine_new();
    const router: CommandRouter = command_router_new();
    _ = aof_replay_file_at(path, &engine, &router, 1000u64) catch |err| {
        engine_free(&engine);
        if err == error.AofTruncated {
            return true;
        }
        if err == error.AofInvalidFormat {
            return true;
        }
        if err == error.AofInvalidCommand {
            return true;
        }
        if err == error.AofReplayCommandFailed {
            return true;
        }
        return false;
    };
    engine_free(&engine);
    return false;
}

fn aof_key_missing_at(engine: &Engine, key: &[byte], now_ms: u64) bool {
    const found: &RedisObject = lookup_key_at(engine, key, now_ms) catch |err| {
        if err == error.EngineKeyNotFound {
            return true;
        }
        return false;
    };
    _ = found;
    return false;
}

export fn test_aof_connection_append_and_replay_set() !void {
    reset_memory_stats_for_test();
    const path: &const byte = "build/test-aof-set.aof";
    _ = unlink(path);

    var writer: AofWriter = try aof_open_truncate(path);
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    const result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: result.response_len], &"+OK\r\n"[0: 5]));
    const append_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*3\r\n$6\r\nAPPEND\r\n$3\r\nkey\r\n$2\r\n++\r\n"[0: 33],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: append_result.response_len], &":7\r\n"[0: 4]));
    const setrange_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*4\r\n$8\r\nSETRANGE\r\n$3\r\nkey\r\n$1\r\n5\r\n$2\r\n__\r\n"[0: 42],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: setrange_result.response_len], &":7\r\n"[0: 4]));
    const incrbyfloat_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*3\r\n$11\r\nINCRBYFLOAT\r\n$8\r\nfcounter\r\n$3\r\n1.5\r\n"[0: 45],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: incrbyfloat_result.response_len], &"$3\r\n1.5\r\n"[0: 9]));
    const mset_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*5\r\n$4\r\nMSET\r\n$2\r\nk1\r\n$2\r\nv1\r\n$2\r\nk2\r\n$2\r\nv2\r\n"[0: 46],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: mset_result.response_len], &"+OK\r\n"[0: 5]));
    const msetnx_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*5\r\n$6\r\nMSETNX\r\n$3\r\nnx1\r\n$1\r\na\r\n$3\r\nnx2\r\n$1\r\nb\r\n"[0: 48],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: msetnx_result.response_len], &":1\r\n"[0: 4]));
    _ = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*3\r\n$3\r\nSET\r\n$4\r\nsrca\r\n$3\r\nfoo\r\n"[0: 32],
        &out[0],
        256,
        1000u64,
    );
    _ = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*3\r\n$3\r\nSET\r\n$4\r\nsrcb\r\n$3\r\nbar\r\n"[0: 32],
        &out[0],
        256,
        1000u64,
    );
    const bitop_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*5\r\n$5\r\nBITOP\r\n$3\r\nAND\r\n$6\r\ndstbit\r\n$4\r\nsrca\r\n$4\r\nsrcb\r\n"[0: 56],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: bitop_result.response_len], &":3\r\n"[0: 4]));
    const bitfield_set_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*6\r\n$8\r\nBITFIELD\r\n$2\r\nbf\r\n$3\r\nSET\r\n$2\r\nu8\r\n$1\r\n0\r\n$1\r\n5\r\n"[0: 57],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: bitfield_set_result.response_len], &"*1\r\n:0\r\n"[0: 8]));
    const bitfield_incr_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*6\r\n$8\r\nBITFIELD\r\n$2\r\nbf\r\n$6\r\nINCRBY\r\n$2\r\nu8\r\n$1\r\n0\r\n$1\r\n3\r\n"[0: 60],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: bitfield_incr_result.response_len], &"*1\r\n:8\r\n"[0: 8]));
    const pfadd_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*5\r\n$5\r\nPFADD\r\n$3\r\nhll\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 45],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: pfadd_result.response_len], &":1\r\n"[0: 4]));
    const pfmerge_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*4\r\n$7\r\nPFMERGE\r\n$3\r\ndst\r\n$3\r\nhll\r\n$7\r\nmissing\r\n"[0: 48],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: pfmerge_result.response_len], &"+OK\r\n"[0: 5]));
    const geoadd_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*8\r\n$6\r\nGEOADD\r\n$3\r\ngeo\r\n$9\r\n13.361389\r\n$9\r\n38.115556\r\n$7\r\nPalermo\r\n$9\r\n15.087269\r\n$9\r\n37.502669\r\n$7\r\nCatania\r\n"[0: 111],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: geoadd_result.response_len], &":2\r\n"[0: 4]));
    const eval_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*5\r\n$4\r\nEVAL\r\n$42\r\nreturn redis.call('SET', KEYS[1], ARGV[1])\r\n$1\r\n1\r\n$7\r\nlua-key\r\n$5\r\nvalue\r\n"[0: 94],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: eval_result.response_len], &"+OK\r\n"[0: 5]));
    const script_flush_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*2\r\n$6\r\nSCRIPT\r\n$5\r\nFLUSH\r\n"[0: 27],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: script_flush_result.response_len], &"+OK\r\n"[0: 5]));
    aof_close(&writer);
    engine_free(&engine);

    var replay_engine: Engine = engine_new();
    try aof_replay_file_at(path, &replay_engine, &router, 2000u64);
    const found: &RedisObject = try lookup_key_at(&replay_engine, &"key"[0: 3], 2000u64);
    try assert_true(aof_test_slice_eq(found.value.buf[0: found.value.len], &"value__"[0: 7]));
    const found_float: &RedisObject = try lookup_key_at(&replay_engine, &"fcounter"[0: 8], 2000u64);
    try assert_true(aof_test_slice_eq(found_float.value.buf[0: found_float.value.len], &"1.5"[0: 3]));
    const found_k1: &RedisObject = try lookup_key_at(&replay_engine, &"k1"[0: 2], 2000u64);
    try assert_true(aof_test_slice_eq(found_k1.value.buf[0: found_k1.value.len], &"v1"[0: 2]));
    const found_k2: &RedisObject = try lookup_key_at(&replay_engine, &"k2"[0: 2], 2000u64);
    try assert_true(aof_test_slice_eq(found_k2.value.buf[0: found_k2.value.len], &"v2"[0: 2]));
    const found_nx1: &RedisObject = try lookup_key_at(&replay_engine, &"nx1"[0: 3], 2000u64);
    try assert_true(aof_test_slice_eq(found_nx1.value.buf[0: found_nx1.value.len], &"a"[0: 1]));
    const found_nx2: &RedisObject = try lookup_key_at(&replay_engine, &"nx2"[0: 3], 2000u64);
    try assert_true(aof_test_slice_eq(found_nx2.value.buf[0: found_nx2.value.len], &"b"[0: 1]));
    const found_dstbit: &RedisObject = try lookup_key_at(&replay_engine, &"dstbit"[0: 6], 2000u64);
    try assert_true(aof_test_slice_eq(found_dstbit.value.buf[0: found_dstbit.value.len], &"bab"[0: 3]));
    const found_bf: &RedisObject = try lookup_key_at(&replay_engine, &"bf"[0: 2], 2000u64);
    try assert_eq_i32(found_bf.value.len as i32, 1);
    try assert_eq_i32(found_bf.value.buf.ptr[0] as i32, 8);
    const found_hll: &RedisObject = try lookup_key_at(&replay_engine, &"hll"[0: 3], 2000u64);
    try assert_eq_i32(found_hll.obj_type as i32, ObjectType.object_set as i32);
    try assert_eq_i32((try set_object_len(found_hll)) as i32, 3);
    const found_dst_hll: &RedisObject = try lookup_key_at(&replay_engine, &"dst"[0: 3], 2000u64);
    try assert_eq_i32(found_dst_hll.obj_type as i32, ObjectType.object_set as i32);
    try assert_eq_i32((try set_object_len(found_dst_hll)) as i32, 3);
    const found_geo: &RedisObject = try lookup_key_at(&replay_engine, &"geo"[0: 3], 2000u64);
    try assert_eq_i32(found_geo.obj_type as i32, ObjectType.object_zset as i32);
    try assert_eq_i32((try zset_object_len(found_geo)) as i32, 2);
    const found_lua_key: &RedisObject = try lookup_key_at(&replay_engine, &"lua-key"[0: 7], 2000u64);
    try assert_true(aof_test_slice_eq(found_lua_key.value.buf[0: found_lua_key.value.len], &"value"[0: 5]));
    engine_free(&replay_engine);
    _ = unlink(path);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_aof_replay_set_then_del() !void {
    reset_memory_stats_for_test();
    const path: &const byte = "build/test-aof-del.aof";
    _ = unlink(path);

    var writer: AofWriter = try aof_open_truncate(path);
    try aof_append_raw(&writer, &"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33]);
    try aof_append_raw(&writer, &"*2\r\n$6\r\nGETDEL\r\n$3\r\nkey\r\n"[0: 25]);
    aof_close(&writer);

    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    try aof_replay_file_at(path, &engine, &router, 1000u64);
    try assert_true(aof_key_missing_at(&engine, &"key"[0: 3], 1000u64));
    engine_free(&engine);
    _ = unlink(path);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_aof_replay_hash_commands() !void {
    reset_memory_stats_for_test();
    const path: &const byte = "build/test-aof-hash.aof";
    _ = unlink(path);

    var writer: AofWriter = try aof_open_truncate(path);
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    const hsetnx_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*4\r\n$6\r\nHSETNX\r\n$4\r\nhash\r\n$5\r\nfield\r\n$5\r\nvalue\r\n"[0: 48],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: hsetnx_result.response_len], &":1\r\n"[0: 4]));
    const hsetnx_dup_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*4\r\n$6\r\nHSETNX\r\n$4\r\nhash\r\n$5\r\nfield\r\n$4\r\nnext\r\n"[0: 47],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: hsetnx_dup_result.response_len], &":0\r\n"[0: 4]));
    const hset_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*4\r\n$4\r\nHSET\r\n$4\r\nhash\r\n$6\r\nsecond\r\n$3\r\ntwo\r\n"[0: 45],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: hset_result.response_len], &":1\r\n"[0: 4]));
    const hdel_result: ConnectionProcessResult = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*3\r\n$4\r\nHDEL\r\n$4\r\nhash\r\n$5\r\nfield\r\n"[0: 35],
        &out[0],
        256,
        1000u64,
    );
    try assert_true(aof_test_slice_eq(out[0: hdel_result.response_len], &":1\r\n"[0: 4]));
    aof_close(&writer);
    engine_free(&engine);

    var replay_engine: Engine = engine_new();
    try aof_replay_file_at(path, &replay_engine, &router, 2000u64);
    const hash_obj: &RedisObject = try lookup_key_at(&replay_engine, &"hash"[0: 4], 2000u64);
    try assert_eq_i32(hash_obj.obj_type as i32, ObjectType.object_hash as i32);
    const second_obj: &RedisObject = try hash_object_get_field(hash_obj, &"second"[0: 6]);
    try assert_true(aof_test_slice_eq(second_obj.value.buf[0: second_obj.value.len], &"two"[0: 3]));
    var missing_not_found: bool = false;
    var unexpected_missing_error: bool = false;
    const maybe_missing_result: !&RedisObject = hash_object_get_field(hash_obj, &"field"[0: 5]);
    if maybe_missing_result.error_id == 0 {
        unexpected_missing_error = true;
    } else {
        missing_not_found = true;
    }
    engine_free(&replay_engine);
    _ = unlink(path);
    try assert_eq_i32(unexpected_missing_error as i32, 0);
    try assert_eq_i32(missing_not_found as i32, 1);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_aof_replay_rename_commands() !void {
    reset_memory_stats_for_test();
    const path: &const byte = "build/test-aof-rename.aof";
    _ = unlink(path);

    var writer: AofWriter = try aof_open_truncate(path);
    try aof_append_raw(&writer, &"*3\r\n$3\r\nSET\r\n$3\r\nsrc\r\n$5\r\nvalue\r\n"[0: 33]);
    try aof_append_raw(&writer, &"*3\r\n$6\r\nRENAME\r\n$3\r\nsrc\r\n$3\r\ndst\r\n"[0: 34]);
    try aof_append_raw(&writer, &"*3\r\n$3\r\nSET\r\n$4\r\nsrc2\r\n$3\r\ntwo\r\n"[0: 32]);
    try aof_append_raw(&writer, &"*3\r\n$8\r\nRENAMENX\r\n$4\r\nsrc2\r\n$4\r\ndst2\r\n"[0: 38]);
    aof_close(&writer);

    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    try aof_replay_file_at(path, &engine, &router, 1000u64);
    const found_dst: &RedisObject = try lookup_key_at(&engine, &"dst"[0: 3], 1000u64);
    try assert_true(aof_test_slice_eq(found_dst.value.buf[0: found_dst.value.len], &"value"[0: 5]));
    const found_dst2: &RedisObject = try lookup_key_at(&engine, &"dst2"[0: 4], 1000u64);
    try assert_true(aof_test_slice_eq(found_dst2.value.buf[0: found_dst2.value.len], &"two"[0: 3]));
    try assert_true(aof_key_missing_at(&engine, &"src"[0: 3], 1000u64));
    try assert_true(aof_key_missing_at(&engine, &"src2"[0: 4], 1000u64));
    engine_free(&engine);
    _ = unlink(path);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_aof_replay_blocking_list_commands() !void {
    reset_memory_stats_for_test();
    const path: &const byte = "build/test-aof-blocking-list.aof";
    _ = unlink(path);

    var writer: AofWriter = try aof_open_truncate(path);
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    _ = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*4\r\n$5\r\nRPUSH\r\n$3\r\nsrc\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 39],
        &out[0],
        256,
        1000u64,
    );
    _ = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*4\r\n$5\r\nBLPOP\r\n$4\r\nmiss\r\n$3\r\nsrc\r\n$1\r\n1\r\n"[0: 44],
        &out[0],
        256,
        1000u64,
    );
    _ = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*4\r\n$10\r\nBRPOPLPUSH\r\n$3\r\nsrc\r\n$3\r\ndst\r\n$1\r\n1\r\n"[0: 49],
        &out[0],
        256,
        1000u64,
    );
    aof_close(&writer);
    engine_free(&engine);

    var replay_engine: Engine = engine_new();
    try aof_replay_file_at(path, &replay_engine, &router, 2000u64);
    try assert_true(aof_key_missing_at(&replay_engine, &"src"[0: 3], 2000u64));
    const dst_obj: &RedisObject = try lookup_key_at(&replay_engine, &"dst"[0: 3], 2000u64);
    try assert_eq_i32(dst_obj.obj_type as i32, ObjectType.object_list as i32);
    const dst_value: &RedisObject = try list_object_index_value(dst_obj, 0);
    try assert_true(aof_test_slice_eq(dst_value.value.buf[0: dst_value.value.len], &"b"[0: 1]));
    engine_free(&replay_engine);
    _ = unlink(path);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_aof_replay_blocking_zset_commands() !void {
