    _ = list_object_push_tail(reply_list, &"    Returns whether the user can execute the given command without executing the command."[0: 89]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"GETUSER <username>"[0: 18]) catch { object_free(reply_list); return command_executor_oom(); };
