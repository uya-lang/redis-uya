    const msetex_bad_numkeys_reply: CommandReply = command_execute_at(&engine, &msetex_bad_numkeys_command, 1000u64);
    try assert_eq_i32(msetex_bad_numkeys_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&msetex_bad_numkeys_parsed.value);

    var lcs_bad_idx_option_parsed: RespParseResult = try parse_resp2(&"*4\r\n$3\r\nLCS\r\n$3\r\nkey\r\n$7\r\nmissing\r\n$12\r\nWITHMATCHLEN\r\n"[0: 54]);
    const lcs_bad_idx_option_command: Command = try command_executor_test_command(&router, &lcs_bad_idx_option_parsed);
    const lcs_bad_idx_option_reply: CommandReply = command_execute_at(&engine, &lcs_bad_idx_option_command, 1000u64);
    try assert_eq_i32(lcs_bad_idx_option_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(lcs_bad_idx_option_reply.data, &"ERR syntax error"[0: 16]));
    resp_value_free(&lcs_bad_idx_option_parsed.value);

    var expire_bad_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nEXPIRE\r\n$3\r\nkey\r\n$3\r\nbad\r\n"[0: 36]);
    const expire_bad_command: Command = try command_executor_test_command(&router, &expire_bad_parsed);
    const expire_bad_reply: CommandReply = command_execute_at(&engine, &expire_bad_command, 1000u64);
    try assert_eq_i32(expire_bad_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&expire_bad_parsed.value);

    var pexpire_bad_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nPEXPIRE\r\n$3\r\nkey\r\n$3\r\nbad\r\n"[0: 37]);
