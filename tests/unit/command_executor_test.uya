    var setex_bad_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nSETEX\r\n$3\r\nkey\r\n$3\r\nbad\r\n$5\r\nvalue\r\n"[0: 47]);
    const setex_bad_command: Command = try command_executor_test_command(&router, &setex_bad_parsed);
    const setex_bad_reply: CommandReply = command_execute_at(&engine, &setex_bad_command, 1000u64);
    try assert_eq_i32(setex_bad_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&setex_bad_parsed.value);

    var psetex_bad_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nPSETEX\r\n$3\r\nkey\r\n$3\r\nbad\r\n$5\r\nvalue\r\n"[0: 45]);
    const psetex_bad_command: Command = try command_executor_test_command(&router, &psetex_bad_parsed);
    const psetex_bad_reply: CommandReply = command_execute_at(&engine, &psetex_bad_command, 1000u64);
    try assert_eq_i32(psetex_bad_reply.typ as i32, CommandReplyType.reply_error as i32);
