    var replicaof_promote: bool = false;
    var replicaof_host: [byte: 64] = [];
    var replicaof_port: i32 = 0;
    var bgsave_requested: bool = false;
    var rewrite_requested: bool = false;
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    return connection_process_input_with_runtime_with_aof_and_rewrite_and_transaction_internal_at(
        engine,
        &runtime,
        router,
        null as &AofWriter,
        null as &Sds,
        null as &ReplicationBacklog,
        &tx,
        input,
        out,
        out_cap,
        now_ms,
        &replicaof_requested,
        &replicaof_promote,
        replicaof_host[0: 64],
        &replicaof_port,
        &bgsave_requested,
        &rewrite_requested,
        null as &bool,
        true,
    );
}

