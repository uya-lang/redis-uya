fn command_executor_hscan(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }

    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_scan(0u64, null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_hash {
        return command_executor_wrongtype();
    }

    const cursor_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const cursor_i64: i64 = command_executor_parse_i64(cursor_data) catch {
        return command_executor_invalid_integer();
    };
    if cursor_i64 < 0 {
        return command_executor_invalid_integer();
    }

    var count_hint: usize = 10;
    if command.argc == 5 {
        const option: &[byte] = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(option, &"COUNT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const count_data: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        const count_i64: i64 = command_executor_parse_i64(count_data) catch {
            return command_executor_invalid_integer();
        };
        if count_i64 <= 0 {
            return command_executor_invalid_integer();
        }
        count_hint = count_i64 as usize;
    }

    const fields: &RedisObject = command_executor_hash_sorted_fields(obj) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };

    const combined: &RedisObject = create_list_object() catch {
        object_free(fields);
        return command_executor_oom();
    };

    var field_node: &ListNode = fields.list_head;
    while field_node != null {
        const field_data: &[byte] = field_node.value.value.buf[0: field_node.value.value.len];
        const field_obj: &RedisObject = hash_object_get_field(obj, field_data) catch {
            object_free(fields);
            object_free(combined);
            return command_executor_wrongtype();
        };
        const value_data: &[byte] = command_executor_string_value(field_obj) catch {
            object_free(fields);
            object_free(combined);
            return command_executor_wrongtype();
        };
        _ = list_object_push_tail(combined, field_data) catch {
            object_free(fields);
            object_free(combined);
            return command_executor_oom();
        };
        _ = list_object_push_tail(combined, value_data) catch {
            object_free(fields);
            object_free(combined);
            return command_executor_oom();
        };
        field_node = field_node.next;
    }
    object_free(fields);

    const total_fields: usize = list_object_len(combined) catch {
        object_free(combined);
        return command_executor_wrongtype();
    };
    const total: usize = total_fields / 2;

    const cursor: usize = cursor_i64 as usize;
    var emit_head: &ListNode = null as &ListNode;
    var emit_count: usize = 0;
    var next_cursor: u64 = 0u64;

    if cursor < total {
        const start_offset: i64 = cursor_i64 * 2;
        const stop_offset: i64 = start_offset + (count_hint as i64) * 2 - 1;
        const view: ListRangeView = list_object_range(combined, start_offset, stop_offset) catch {
            object_free(combined);
            return command_executor_wrongtype();
        };
        emit_head = view.head;
        emit_count = view.count;
        if cursor + (emit_count / 2) < total {
            next_cursor = (cursor + (emit_count / 2)) as u64;
        }
    }

    var reply: CommandReply = command_executor_scan(next_cursor, emit_head, emit_count);
    reply.owned_object = combined;
    return reply;
}

fn command_executor_set(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_error(&"ERR syntax error"[0: 16]);
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const value: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    return command_executor_store_string(engine, key, value, now_ms);
}

fn command_executor_del(engine: &Engine, command: &Command) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    var deleted: i64 = 0;
    var index: usize = 1;
    while index < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if delete_key(engine, key) {
            deleted = deleted + 1;
        }
        index = index + 1;
    }
    return command_executor_integer(deleted);
}

fn command_executor_touch(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    var touched: i64 = 0;
    var index: usize = 1;
    while index < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        if obj_result.error_id == 0 {
            touched = touched + 1;
        }
        index = index + 1;
    }
    return command_executor_integer(touched);
}

fn command_executor_unlink(engine: &Engine, command: &Command) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    var deleted: i64 = 0;
    var index: usize = 1;
    while index < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if delete_key(engine, key) {
            deleted = deleted + 1;
        }
        index = index + 1;
    }
    return command_executor_integer(deleted);
}

fn command_executor_exists(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    var count: i64 = 0;
    var index: usize = 1;
    while index < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_key_exists(engine, key, now_ms) {
            count = count + 1;
        }
        index = index + 1;
    }
    return command_executor_integer(count);
}

fn command_executor_dbsize(engine: &Engine, command: &Command) CommandReply {
    if command.argc != 1 {
        return command_executor_wrong_arity();
    }
    return command_executor_integer(engine_len(engine) as i64);
}

fn command_executor_randomkey(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 1 {
        return command_executor_wrong_arity();
    }
    const keys_obj: &RedisObject = engine_scan_keys_at(engine, now_ms) catch {
        return command_executor_oom();
    };
    defer {
        object_free(keys_obj);
    }
    const key_count: usize = list_object_len(keys_obj) catch {
        return command_executor_wrongtype();
    };
    if key_count == 0 {
        return command_executor_null_bulk();
    }
    const index: i64 = (now_ms % (key_count as u64)) as i64;
    const key_obj: &RedisObject = list_object_index_value(keys_obj, index) catch {
        return command_executor_wrongtype();
    };
    const data: &[byte] = command_executor_string_value(key_obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_owned_bulk_copy(data);
}

fn command_executor_keys(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const pattern: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const keys_obj: &RedisObject = engine_scan_keys_at(engine, now_ms) catch {
        return command_executor_oom();
    };
    defer {
        object_free(keys_obj);
    }

    const matched: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    var node: &ListNode = keys_obj.list_head;
    while node != null {
        const key: &[byte] = node.value.value.buf[0: node.value.value.len];
        if command_executor_glob_match(pattern, 0, key, 0) {
            _ = list_object_push_tail(matched, key) catch {
                object_free(matched);
                return command_executor_oom();
            };
        }
        node = node.next;
    }

    const count: usize = list_object_len(matched) catch {
        object_free(matched);
        return command_executor_wrongtype();
    };
    var reply: CommandReply = command_executor_array_bulk(matched.list_head, count);
    reply.owned_object = matched;
    return reply;
}

fn command_executor_time(command: &Command, now_ms: u64) CommandReply {
    if command.argc != 1 {
        return command_executor_wrong_arity();
    }
    var seconds_buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&seconds_buf);
    }
    var micros_buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&micros_buf);
    }
    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }

    _ = command_executor_info_append_u64(&seconds_buf, &"%u"[0: 2], now_ms / 1000u64) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append_u64(&micros_buf, &"%u"[0: 2], (now_ms % 1000u64) * 1000u64) catch {
        return command_executor_oom();
    };
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], 2) catch {
        return command_executor_oom();
    };
    _ = command_executor_command_append_bulk(&raw, seconds_buf.buf[0: seconds_buf.len]) catch {
        return command_executor_oom();
    };
    _ = command_executor_command_append_bulk(&raw, micros_buf.buf[0: micros_buf.len]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_role(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    if command.argc != 1 {
        return command_executor_wrong_arity();
    }
    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }

    if runtime.replication_role == ReplicationRole.role_master {
        _ = sds_cat(&raw, &"*3\r\n$6\r\nmaster\r\n"[0: 16]) catch { return command_executor_oom(); };
        _ = command_executor_info_append_u64(&raw, &":%u\r\n"[0: 5], runtime.replication_master_offset) catch {
            return command_executor_oom();
        };
        _ = sds_cat(&raw, &"*0\r\n"[0: 4]) catch { return command_executor_oom(); };
        return command_executor_owned_raw(raw.buf[0: raw.len]);
    }

    const host: &[byte] = command_executor_cstring_slice(runtime.config.replicaof_host[0: 64]);
    const state: &[byte] = replication_state_name(runtime.replication_state);
    _ = sds_cat(&raw, &"*5\r\n$5\r\nslave\r\n"[0: 15]) catch { return command_executor_oom(); };
    _ = command_executor_command_append_bulk(&raw, host) catch { return command_executor_oom(); };
    _ = command_executor_info_append_i64(&raw, &":%i\r\n"[0: 5], runtime.config.replicaof_port as i64) catch {
        return command_executor_oom();
    };
    _ = command_executor_command_append_bulk(&raw, state) catch { return command_executor_oom(); };
    _ = command_executor_info_append_u64(&raw, &":%u\r\n"[0: 5], runtime.replication_master_offset) catch {
        return command_executor_oom();
    };
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_expire(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const seconds_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const seconds: i64 = command_executor_parse_i64(seconds_data) catch {
        return command_executor_invalid_integer();
    };
    if seconds < 0 {
        return command_executor_invalid_integer();
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    _ = obj;

    if seconds == 0 {
        _ = delete_key(engine, key);
        return command_executor_integer(1);
    }

    _ = set_key_expire_at(engine, key, now_ms + (seconds as u64) * 1000u64) catch {
        return command_executor_oom();
    };
    return command_executor_integer(1);
}

fn command_executor_expireat(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const expire_at_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const expire_at_seconds: i64 = command_executor_parse_i64(expire_at_data) catch {
        return command_executor_invalid_integer();
    };
    if expire_at_seconds < 0 {
        return command_executor_invalid_integer();
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    _ = obj;

    const expire_at_ms: u64 = (expire_at_seconds as u64) * 1000u64;
    if expire_at_ms <= now_ms {
        _ = delete_key(engine, key);
        return command_executor_integer(1);
    }

    _ = set_key_expire_at(engine, key, expire_at_ms) catch {
        return command_executor_oom();
    };
    return command_executor_integer(1);
}

fn command_executor_pexpire(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const milliseconds_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const milliseconds: i64 = command_executor_parse_i64(milliseconds_data) catch {
        return command_executor_invalid_integer();
    };
    if milliseconds < 0 {
        return command_executor_invalid_integer();
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    _ = obj;

    if milliseconds == 0 {
        _ = delete_key(engine, key);
        return command_executor_integer(1);
    }

    _ = set_key_expire_at(engine, key, now_ms + milliseconds as u64) catch {
        return command_executor_oom();
    };
    return command_executor_integer(1);
}

fn command_executor_pexpireat(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const expire_at_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const expire_at_ms: i64 = command_executor_parse_i64(expire_at_data) catch {
        return command_executor_invalid_integer();
    };
    if expire_at_ms < 0 {
        return command_executor_invalid_integer();
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    _ = obj;

    if expire_at_ms as u64 <= now_ms {
        _ = delete_key(engine, key);
        return command_executor_integer(1);
    }

    _ = set_key_expire_at(engine, key, expire_at_ms as u64) catch {
        return command_executor_oom();
    };
    return command_executor_integer(1);
}

fn command_executor_persist(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    _ = obj;
    if persist_key_expire(engine, key) {
        return command_executor_integer(1);
    }
    return command_executor_integer(0);
}

fn command_executor_pttl(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(-2);
    };
    _ = obj;

    const expire_at: u64 = get_key_expire_at(engine, key) catch {
        return command_executor_integer(-1);
    };
    if expire_at <= now_ms {
        _ = delete_key(engine, key);
        return command_executor_integer(-2);
    }
    return command_executor_integer((expire_at - now_ms) as i64);
}

fn command_executor_expiretime(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(-2);
    };
    _ = obj;

    const expire_at: u64 = get_key_expire_at(engine, key) catch {
        return command_executor_integer(-1);
    };
    if expire_at <= now_ms {
        _ = delete_key(engine, key);
        return command_executor_integer(-2);
    }
    return command_executor_integer((expire_at / 1000u64) as i64);
}

