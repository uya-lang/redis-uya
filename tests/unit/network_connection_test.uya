    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_acl_directional_key_patterns() !void {
    reset_memory_stats_for_test();
    connection_acl_reset_for_test();
    defer { connection_acl_reset_for_test(); }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer { connection_transaction_reset(&tx); }
    var out: [byte: 4096] = [];

    const setup: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*10\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$9\r\ndirection\r\n$2\r\non\r\n$6\r\nnopass\r\n$5\r\n+@all\r\n$9\r\nresetkeys\r\n$9\r\n%R~read:*\r\n$10\r\n%W~write:*\r\n$7\r\n~both:*\r\n"[0: 133], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: setup.response_len], &"+OK\r\n"[0: 5]));

    const get_read: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$9\r\ndirection\r\n$3\r\nGET\r\n$8\r\nread:key\r\n"[0: 63], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_read.response_len], &"+OK\r\n"[0: 5]));
