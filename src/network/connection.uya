    rewrite_requested: &bool,
    rewrite_failed: &bool,
) !ConnectionProcessResult {
    return connection_process_input_with_runtime_with_aof_and_rewrite_and_transaction_internal_at(engine, runtime, router, aof, rewrite_buf, backlog, tx, input, out, out_cap, now_ms, replicaof_requested, replicaof_promote, replicaof_host, replicaof_port, bgsave_requested, rewrite_requested, rewrite_failed, false);
