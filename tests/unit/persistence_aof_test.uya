        &writer,
        &"*4\r\n$8\r\nBZPOPMIN\r\n$4\r\nmiss\r\n$2\r\nzs\r\n$1\r\n1\r\n"[0: 47],
        &out[0],
        256,
        1000u64,
    );
    _ = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*3\r\n$8\r\nBZPOPMAX\r\n$2\r\nzs\r\n$1\r\n1\r\n"[0: 37],
        &out[0],
        256,
        1000u64,
    );
    _ = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*6\r\n$4\r\nZADD\r\n$3\r\nzs2\r\n$1\r\n1\r\n$1\r\na\r\n$1\r\n2\r\n$1\r\nb\r\n"[0: 52],
        &out[0],
        256,
        1000u64,
    );
    _ = try connection_process_input_with_aof_at(
        &engine,
        &router,
        &writer,
        &"*7\r\n$6\r\nBZMPOP\r\n$1\r\n1\r\n$1\r\n1\r\n$3\r\nzs2\r\n$3\r\nMIN\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n"[0: 66],
        &out[0],
        256,
        1000u64,
    );
    aof_close(&writer);
    engine_free(&engine);

    var replay_engine: Engine = engine_new();
