    try assert_eq_i32(rpush_reply.integer as i32, 5);
    resp_value_free(&rpush_parsed.value);

    var linsert_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nLINSERT\r\n$5\r\nwlist\r\n$6\r\nBEFORE\r\n$1\r\nc\r\n$1\r\nx\r\n"[0: 54]);
