    try aof_append_raw(&writer, &"*1\r\n$7\r\nFLUSHDB\r\n"[0: 17]);
    try aof_append_raw(&writer, &"*3\r\n$3\r\nSET\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 27]);
