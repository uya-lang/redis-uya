export fn test_connection_zero_copy_get_reply_metadata() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];
    const value: &[byte] = &"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGH"[0: 70];

    const set_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$70\r\nabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGH\r\n"[0: 99], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_result.response_len], &"+OK\r\n"[0: 5]));

    const get_result: ConnectionProcessResult = try connection_process_input_zero_copy_for_test_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_eq_i32(get_result.response_len as i32, 77);
    try assert_eq_i32(get_result.response_head_len as i32, 5);
    try assert_eq_i32(get_result.zero_copy_tail_len as i32, 2);
    try assert_true(network_connection_slice_eq(out[0: get_result.response_head_len], &"$70\r\n"[0: 5]));
    try assert_true(network_connection_slice_eq(get_result.zero_copy_body, value));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_maxmemory() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.maxmemory = 1;
    var out: [byte: 256] = [];

    const set_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: set_result.response_len], &"OOM command not allowed"[0: 23]));

    runtime.config.maxmemory = 0;
    const get_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_result.response_len], &"$-1\r\n"[0: 5]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_error_paths() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    const unknown: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$7\r\nMISSING\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: 1], &"-"[0: 1]));
    try assert_eq_i32(unknown.close_after as i32, 0);

    const bad_proto: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"?bad\r\n"[0: 6], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bad_proto.response_len], &"-ERR protocol error\r\n"[0: 21]));
    try assert_eq_i32(bad_proto.close_after as i32, 1);

    var saw_incomplete: bool = false;
    _ = connection_process_input_at(&engine, &router, &"$6\r\nfoo"[0: 7], &out[0], 256, 1000u64) catch |err| {
        if err == error.ConnectionIncomplete {
            saw_incomplete = true;
        }
        return;
    };
    try assert_true(saw_incomplete);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_multi_exec_discard() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 256] = [];

    const multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi.response_len], &"+OK\r\n"[0: 5]));

    const queued_set: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_set.response_len], &"+QUEUED\r\n"[0: 9]));

    const queued_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_get.response_len], &"+QUEUED\r\n"[0: 9]));

    const exec: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec.response_len], &"*2\r\n+OK\r\n$5\r\nvalue\r\n"[0: 20]));

    const multi_discard: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_discard.response_len], &"+OK\r\n"[0: 5]));

    const discard_queue: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nSET\r\n$5\r\nother\r\n$3\r\nabc\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard_queue.response_len], &"+QUEUED\r\n"[0: 9]));

    const discard: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nDISCARD\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard.response_len], &"+OK\r\n"[0: 5]));

    const get_other: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$5\r\nother\r\n"[0: 24], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_other.response_len], &"$-1\r\n"[0: 5]));

    const exec_without_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec_without_multi.response_len], &"-ERR EXEC without MULTI\r\n"[0: 25]));

    const discard_without_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nDISCARD\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard_without_multi.response_len], &"-ERR DISCARD without MULTI\r\n"[0: 28]));

    const multi_again: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_again.response_len], &"+OK\r\n"[0: 5]));

    const nested_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: nested_multi.response_len], &"-ERR MULTI calls can not be nested\r\n"[0: 36]));

    const empty_exec: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: empty_exec.response_len], &"*0\r\n"[0: 4]));

    const multi_script: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_script.response_len], &"+OK\r\n"[0: 5]));

    const queued_eval: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$4\r\nEVAL\r\n$42\r\nreturn redis.call('SET', KEYS[1], ARGV[1])\r\n$1\r\n1\r\n$6\r\ntx-lua\r\n$3\r\ntxv\r\n"[0: 91], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_eval.response_len], &"+QUEUED\r\n"[0: 9]));

    const queued_script_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$6\r\ntx-lua\r\n"[0: 25], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_script_get.response_len], &"+QUEUED\r\n"[0: 9]));

    const exec_script: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec_script.response_len], &"*2\r\n+OK\r\n$3\r\ntxv\r\n"[0: 18]));

    const script_flush: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nSCRIPT\r\n$5\r\nFLUSH\r\n"[0: 27], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: script_flush.response_len], &"+OK\r\n"[0: 5]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_pipeline_batch() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 4096] = [];

    const pipeline: &[byte] = &"*1\r\n$5\r\nMULTI\r\n*3\r\n$3\r\nSET\r\n$4\r\nmkey\r\n$4\r\nmval\r\n*2\r\n$3\r\nGET\r\n$4\r\nmkey\r\n*1\r\n$4\r\nEXEC\r\n"[0: 85];
    const result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, pipeline, &out[0], 512, 1000u64);
    try assert_eq_i32(result.consumed as i32, pipeline.len as i32);
    try assert_true(network_connection_slice_eq(out[0: result.response_len], &"+OK\r\n+QUEUED\r\n+QUEUED\r\n*2\r\n+OK\r\n$4\r\nmval\r\n"[0: 42]));

    const get_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$4\r\nmkey\r\n"[0: 23], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_result.response_len], &"$4\r\nmval\r\n"[0: 10]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_watch_unwatch() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 256] = [];

    const watch: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nWATCH\r\n$7\r\nwatched\r\n"[0: 28], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 1);

    const multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi.response_len], &"+OK\r\n"[0: 5]));

    const watch_inside_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nWATCH\r\n$7\r\nwatched\r\n"[0: 28], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch_inside_multi.response_len], &"-ERR WATCH inside MULTI is not allowed\r\n"[0: 40]));

    const queued_set: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nSET\r\n$7\r\nwatched\r\n$3\r\ntxn\r\n"[0: 37], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_set.response_len], &"+QUEUED\r\n"[0: 9]));

    const outside_set: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$7\r\nwatched\r\n$7\r\noutside\r\n"[0: 41], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: outside_set.response_len], &"+OK\r\n"[0: 5]));

    const exec_abort: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec_abort.response_len], &"*-1\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 0);

    const get_outside: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$7\r\nwatched\r\n"[0: 26], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_outside.response_len], &"$7\r\noutside\r\n"[0: 13]));

    const watch_again: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nWATCH\r\n$7\r\nwatched\r\n"[0: 28], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch_again.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 1);

    const unwatch: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nUNWATCH\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: unwatch.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 0);

    const multi_again: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_again.response_len], &"+OK\r\n"[0: 5]));

    const unwatch_inside_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nUNWATCH\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: unwatch_inside_multi.response_len], &"-ERR UNWATCH inside MULTI is not allowed\r\n"[0: 42]));

    const queued_set_again: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nSET\r\n$7\r\nwatched\r\n$2\r\nok\r\n"[0: 36], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_set_again.response_len], &"+QUEUED\r\n"[0: 9]));

    const outside_set_again: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$7\r\nwatched\r\n$5\r\nother\r\n"[0: 39], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: outside_set_again.response_len], &"+OK\r\n"[0: 5]));

    const exec_ok: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec_ok.response_len], &"*1\r\n+OK\r\n"[0: 9]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 0);

    const get_ok: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$7\r\nwatched\r\n"[0: 26], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_ok.response_len], &"$2\r\nok\r\n"[0: 8]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_resp3_hello() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 512] = [];

    const hello3: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n3\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_eq_i32(hello3.response_len as i32, 154);
    try assert_true(network_connection_contains(out[0: hello3.response_len], &"%7\r\n$6\r\nserver\r\n$9\r\nredis-uya\r\n"[0: 31]));
    try assert_true(network_connection_contains(out[0: hello3.response_len], &"$7\r\nversion\r\n$10\r\n"[0: 18]));
    try assert_true(network_connection_contains(out[0: hello3.response_len], redis_uya_version()));
    try assert_true(network_connection_contains(out[0: hello3.response_len], &"$5\r\nproto\r\n:3\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: hello3.response_len], &"$7\r\nmodules\r\n*0\r\n"[0: 17]));

    const missing_resp3: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: missing_resp3.response_len], &"_\r\n"[0: 3]));

    const hello2: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n2\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_eq_i32(hello2.response_len as i32, 155);
    try assert_true(network_connection_contains(out[0: hello2.response_len], &"*14\r\n$6\r\nserver\r\n$9\r\nredis-uya\r\n"[0: 32]));
    try assert_true(network_connection_contains(out[0: hello2.response_len], &"$7\r\nversion\r\n$10\r\n"[0: 18]));
    try assert_true(network_connection_contains(out[0: hello2.response_len], redis_uya_version()));
    try assert_true(network_connection_contains(out[0: hello2.response_len], &"$5\r\nproto\r\n:2\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: hello2.response_len], &"$7\r\nmodules\r\n*0\r\n"[0: 17]));

    const missing_resp2: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: missing_resp2.response_len], &"$-1\r\n"[0: 5]));

    const bad_hello: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n4\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bad_hello.response_len], &"-NOPROTO unsupported protocol version\r\n"[0: 39]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_client_commands() !void {
    reset_memory_stats_for_test();
    connection_client_registry_reset_for_test();
    defer {
        connection_client_registry_reset_for_test();
    }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    tx.client_fd = 42;
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 512] = [];

    const client_id: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$2\r\nID\r\n"[0: 24], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: client_id.response_len], &":1\r\n"[0: 4]));

    const get_empty: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$7\r\nGETNAME\r\n"[0: 29], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_empty.response_len], &"$-1\r\n"[0: 5]));

    const set_name: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$7\r\nSETNAME\r\n$6\r\nworker\r\n"[0: 41], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_name.response_len], &"+OK\r\n"[0: 5]));

    const get_name: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$7\r\nGETNAME\r\n"[0: 29], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_name.response_len], &"$6\r\nworker\r\n"[0: 12]));

    const set_lib_name: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$14\r\nredis-uya-test\r\n"[0: 64], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_lib_name.response_len], &"+OK\r\n"[0: 5]));

    const set_lib_ver: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n0.5.0\r\n"[0: 53], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_lib_ver.response_len], &"+OK\r\n"[0: 5]));

    const client_info: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$4\r\nINFO\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"id=1"[0: 4]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"name=worker"[0: 11]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"lib-name=redis-uya-test"[0: 23]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"lib-ver=0.5.0"[0: 13]));

    var tx2: ConnectionTransaction = connection_transaction_new();
    tx2.client_fd = 43;
    defer {
        connection_transaction_reset(&tx2);
    }
    const second_name: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx2, &"*3\r\n$6\r\nCLIENT\r\n$7\r\nSETNAME\r\n$5\r\npeer2\r\n"[0: 40], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: second_name.response_len], &"+OK\r\n"[0: 5]));

    const client_list: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$4\r\nLIST\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: client_list.response_len], &"id=1"[0: 4]));
    try assert_true(network_connection_contains(out[0: client_list.response_len], &"name=worker"[0: 11]));
    try assert_true(network_connection_contains(out[0: client_list.response_len], &"id=2"[0: 4]));
    try assert_true(network_connection_contains(out[0: client_list.response_len], &"name=peer2"[0: 10]));

    const getredir_default: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$8\r\nGETREDIR\r\n"[0: 30], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: getredir_default.response_len], &":-1\r\n"[0: 5]));

    const tracking_on: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*6\r\n$6\r\nCLIENT\r\n$8\r\nTRACKING\r\n$2\r\nON\r\n$8\r\nREDIRECT\r\n$1\r\n2\r\n$6\r\nNOLOOP\r\n"[0: 71], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: tracking_on.response_len], &"+OK\r\n"[0: 5]));

    const getredir_active: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$8\r\nGETREDIR\r\n"[0: 30], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: getredir_active.response_len], &":2\r\n"[0: 4]));

    const tracking_info: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$12\r\nTRACKINGINFO\r\n"[0: 35], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: tracking_info.response_len], &"flags"[0: 5]));
    try assert_true(network_connection_contains(out[0: tracking_info.response_len], &"noloop"[0: 6]));
    try assert_true(network_connection_contains(out[0: tracking_info.response_len], &"redirect"[0: 8]));

    const tracking_off: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nTRACKING\r\n$3\r\nOFF\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: tracking_off.response_len], &"+OK\r\n"[0: 5]));

    const getredir_off: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$8\r\nGETREDIR\r\n"[0: 30], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: getredir_off.response_len], &":-1\r\n"[0: 5]));

    const client_kill: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$6\r\nCLIENT\r\n$4\r\nKILL\r\n$2\r\nID\r\n$1\r\n2\r\n"[0: 41], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: client_kill.response_len], &":1\r\n"[0: 4]));
    try assert_eq_i32(client_kill.request_client_kill as i32, 1);
    try assert_eq_i32(client_kill.client_kill_id as i32, 2);

    const client_pause: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$6\r\nCLIENT\r\n$5\r\nPAUSE\r\n$3\r\n250\r\n$3\r\nALL\r\n"[0: 45], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: client_pause.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(client_pause.request_client_pause as i32, 1);
    try assert_eq_i32(client_pause.client_pause_timeout_ms as i32, 250);
    try assert_eq_i32(client_pause.client_pause_owner_id as i32, 1);

    const client_unpause: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$7\r\nUNPAUSE\r\n"[0: 29], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: client_unpause.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(client_unpause.request_client_unpause as i32, 1);

    const hello_setname: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$5\r\nHELLO\r\n$1\r\n3\r\n$7\r\nSETNAME\r\n$12\r\nhello-client\r\n"[0: 54], &out[0], 512, 1000u64);
    try assert_true(out[0] == 37 as byte);

    const get_hello_name: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$7\r\nGETNAME\r\n"[0: 29], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_hello_name.response_len], &"$12\r\nhello-client\r\n"[0: 19]));

    const client_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: client_multi.response_len], &"+OK\r\n"[0: 5]));

    const client_inside_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$2\r\nID\r\n"[0: 24], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: client_inside_multi.response_len], &"-ERR CLIENT command inside MULTI is not allowed\r\n"[0: 49]));

    const discard: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nDISCARD\r\n"[0: 17], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard.response_len], &"+OK\r\n"[0: 5]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_reset() !void {
    reset_memory_stats_for_test();
    connection_pubsub_reset_for_test();
    connection_client_registry_reset_for_test();
    defer {
        connection_pubsub_reset_for_test();
        connection_client_registry_reset_for_test();
    }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.requirepass[0] = 115 as byte; // s
    runtime.config.requirepass[1] = 101 as byte; // e
    runtime.config.requirepass[2] = 99 as byte;  // c
    runtime.config.requirepass[3] = 114 as byte; // r
    runtime.config.requirepass[4] = 101 as byte; // e
    runtime.config.requirepass[5] = 116 as byte; // t
    runtime.config.requirepass[6] = 0 as byte;
    var tx: ConnectionTransaction = connection_transaction_new();
    tx.client_fd = 41;
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 512] = [];

    const auth_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$4\r\nAUTH\r\n$7\r\ndefault\r\n$6\r\nsecret\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_ok.response_len], &"+OK\r\n"[0: 5]));

    const watch_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$5\r\nWATCH\r\n$3\r\nkey\r\n"[0: 24], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch_ok.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 1);

    const hello3: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n3\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_true(out[0] == 37 as byte);

    const setname: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$7\r\nSETNAME\r\n$12\r\nreset-client\r\n"[0: 48], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: setname.response_len], &"+OK\r\n"[0: 5]));

    const setinfo: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$9\r\nreset-lib\r\n"[0: 58], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: setinfo.response_len], &"+OK\r\n"[0: 5]));

    const tracking_on: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*4\r\n$6\r\nCLIENT\r\n$8\r\nTRACKING\r\n$2\r\nON\r\n$6\r\nNOLOOP\r\n"[0: 50], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: tracking_on.response_len], &"+OK\r\n"[0: 5]));

    const subscribe_resp3: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$3\r\nfoo\r\n"[0: 28], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: subscribe_resp3.response_len], &"subscribe"[0: 9]));

    const get_resp3_subscribed: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_resp3_subscribed.response_len], &"_\r\n"[0: 3]));

    const multi_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_ok.response_len], &"+OK\r\n"[0: 5]));

    const queued_get: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_get.response_len], &"+QUEUED\r\n"[0: 9]));

    const reset_reply: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$5\r\nRESET\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_reply.response_len], &"+RESET\r\n"[0: 8]));
    try assert_eq_i32(tx.active as i32, 0);
    try assert_eq_i32(tx.protocol_version, 2);
    try assert_eq_i32(tx.pubsub_count as i32, 0);
    try assert_eq_i32(tx.client_name_len as i32, 0);
    try assert_eq_i32(tx.client_lib_name_len as i32, 0);
    try assert_eq_i32(tx.tracking_enabled as i32, 0);
    try assert_eq_i32(tx.authenticated as i32, 0);
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 0);

    const ping_after_reset: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ping_after_reset.response_len], &"-NOAUTH Authentication required.\r\n"[0: 34]));

    const reset_unauthed: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$5\r\nRESET\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_unauthed.response_len], &"+RESET\r\n"[0: 8]));

    const auth_again: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$4\r\nAUTH\r\n$7\r\ndefault\r\n$6\r\nsecret\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_again.response_len], &"+OK\r\n"[0: 5]));

    const get_resp2_after_reset: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_resp2_after_reset.response_len], &"$-1\r\n"[0: 5]));

    const client_getname: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$7\r\nGETNAME\r\n"[0: 29], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: client_getname.response_len], &"$-1\r\n"[0: 5]));

    const exec_after_reset: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec_after_reset.response_len], &"-ERR EXEC without MULTI\r\n"[0: 25]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_command_docs_all_large_reply() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 262144] = [];

    const docs_all: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$7\r\nCOMMAND\r\n$4\r\nDOCS\r\n"[0: 27], &out[0], 262144, 1000u64);
    try assert_true(docs_all.response_len > 0);
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$3\r\nget\r\n"[0: 9]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$9\r\nclient|id\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$7\r\nsummary\r\n"[0: 13]));
    try assert_true(!network_connection_contains(out[0: docs_all.response_len], &"$3\r\nacl\r\n"[0: 9]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$5\r\nblpop\r\n"[0: 11]));
    const docs_all_len: u64 = try network_connection_parse_resp2_collection_len(out[0: docs_all.response_len], 42 as byte);
    try assert_true(docs_all_len > 100u64);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_auth_requirepass_shutdown() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.requirepass[0] = 115 as byte; // s
    runtime.config.requirepass[1] = 101 as byte; // e
    runtime.config.requirepass[2] = 99 as byte;  // c
    runtime.config.requirepass[3] = 114 as byte; // r
    runtime.config.requirepass[4] = 101 as byte; // e
    runtime.config.requirepass[5] = 116 as byte; // t
    runtime.config.requirepass[6] = 0 as byte;
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 512] = [];

    const ping_noauth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ping_noauth.response_len], &"-NOAUTH Authentication required.\r\n"[0: 34]));

    var quit_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&quit_tx);
    }
    const quit_before_auth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &quit_tx, &"*1\r\n$4\r\nQUIT\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: quit_before_auth.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(quit_before_auth.close_after as i32, 1);

    const hello_noauth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n3\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: hello_noauth.response_len], &"-NOAUTH Authentication required.\r\n"[0: 34]));

    const auth_wrong: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$4\r\nAUTH\r\n$5\r\nwrong\r\n"[0: 25], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_wrong.response_len], &"-WRONGPASS invalid username-password pair or user is disabled.\r\n"[0: 64]));

    const auth_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$4\r\nAUTH\r\n$7\r\ndefault\r\n$6\r\nsecret\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_ok.response_len], &"+OK\r\n"[0: 5]));

    const ping_after_auth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ping_after_auth.response_len], &"+PONG\r\n"[0: 7]));

    const config_requirepass: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$11\r\nrequirepass\r\n"[0: 43], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: config_requirepass.response_len], &"requirepass"[0: 11]));
    try assert_true(network_connection_contains(out[0: config_requirepass.response_len], &"secret"[0: 6]));

    const multi_auth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_auth.response_len], &"+OK\r\n"[0: 5]));

    const shutdown_in_multi: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$8\r\nSHUTDOWN\r\n$6\r\nNOSAVE\r\n"[0: 30], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: shutdown_in_multi.response_len], &"-ERR Command not allowed inside a transaction\r\n"[0: 47]));

    const discard_after_shutdown_err: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$7\r\nDISCARD\r\n"[0: 17], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard_after_shutdown_err.response_len], &"+OK\r\n"[0: 5]));

    const shutdown_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$8\r\nSHUTDOWN\r\n$6\r\nNOSAVE\r\n"[0: 30], &out[0], 512, 1000u64);
    try assert_eq_i32(shutdown_ok.response_len as i32, 0);
    try assert_eq_i32(shutdown_ok.close_after as i32, 1);
    try assert_eq_i32(shutdown_ok.request_shutdown as i32, 1);

    var no_pass_runtime: CommandRuntimeInfo = command_runtime_default();
    var no_pass_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&no_pass_tx);
    }
    const auth_no_pass: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &no_pass_runtime, &router, &no_pass_tx, &"*2\r\n$4\r\nAUTH\r\n$6\r\nsecret\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_no_pass.response_len], &"-ERR AUTH <password> called without any password configured for the default user. Are you sure your configuration is correct?\r\n"[0: 127]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_pubsub_commands() !void {
    reset_memory_stats_for_test();
    connection_pubsub_reset_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    tx.client_fd = 11;
    defer {
        connection_transaction_reset(&tx);
        connection_pubsub_reset_for_test();
    }
    var out: [byte: 256] = [];

    const subscribe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$5\r\nchan1\r\n"[0: 30], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: subscribe.response_len], &"subscribe"[0: 9]));
    try assert_true(network_connection_contains(out[0: subscribe.response_len], &"chan1"[0: 5]));
    try assert_true(network_connection_contains(out[0: subscribe.response_len], &":1\r\n"[0: 4]));

    const psubscribe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$10\r\nPSUBSCRIBE\r\n$5\r\nchan*\r\n"[0: 32], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: psubscribe.response_len], &"psubscribe"[0: 10]));
    try assert_true(network_connection_contains(out[0: psubscribe.response_len], &"chan*"[0: 5]));
    try assert_true(network_connection_contains(out[0: psubscribe.response_len], &":2\r\n"[0: 4]));

    const blocked_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: blocked_get.response_len], &"only SUBSCRIBE / PSUBSCRIBE / UNSUBSCRIBE / PUNSUBSCRIBE / PING / QUIT are allowed in this context"[0: 98]));

    const blocked_publish: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$7\r\nPUBLISH\r\n$5\r\nchan1\r\n$5\r\nhello\r\n"[0: 39], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: blocked_publish.response_len], &"only SUBSCRIBE / PSUBSCRIBE / UNSUBSCRIBE / PUNSUBSCRIBE / PING / QUIT are allowed in this context"[0: 98]));

    const ping_subscribed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ping_subscribed.response_len], &"+PONG\r\n"[0: 7]));

    const punsubscribe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$12\r\nPUNSUBSCRIBE\r\n$5\r\nchan*\r\n"[0: 34], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: punsubscribe.response_len], &"punsubscribe"[0: 12]));
    try assert_true(network_connection_contains(out[0: punsubscribe.response_len], &"chan*"[0: 5]));
    try assert_true(network_connection_contains(out[0: punsubscribe.response_len], &":1\r\n"[0: 4]));

    const unsubscribe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$11\r\nUNSUBSCRIBE\r\n$5\r\nchan1\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: unsubscribe.response_len], &"unsubscribe"[0: 11]));
    try assert_true(network_connection_contains(out[0: unsubscribe.response_len], &"chan1"[0: 5]));
    try assert_true(network_connection_contains(out[0: unsubscribe.response_len], &":0\r\n"[0: 4]));

    const unsubscribe_all: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$11\r\nUNSUBSCRIBE\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: unsubscribe_all.response_len], &"unsubscribe"[0: 11]));
    try assert_true(network_connection_contains(out[0: unsubscribe_all.response_len], &"$-1\r\n"[0: 5]));
    try assert_true(network_connection_contains(out[0: unsubscribe_all.response_len], &":0\r\n"[0: 4]));

    const punsubscribe_all: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$12\r\nPUNSUBSCRIBE\r\n"[0: 23], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: punsubscribe_all.response_len], &"punsubscribe"[0: 12]));
    try assert_true(network_connection_contains(out[0: punsubscribe_all.response_len], &"$-1\r\n"[0: 5]));
    try assert_true(network_connection_contains(out[0: punsubscribe_all.response_len], &":0\r\n"[0: 4]));

    var resp3_tx: ConnectionTransaction = connection_transaction_new();
    resp3_tx.client_fd = 13;
    defer {
        connection_transaction_reset(&resp3_tx);
    }
    var resp3_out: [byte: 512] = [];
    const hello3: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &resp3_tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n3\r\n"[0: 22], &resp3_out[0], 512, 1000u64);
    try assert_true(resp3_out[0] == 37 as byte);
    _ = hello3;

    const subscribe_resp3: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &resp3_tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$5\r\nchan1\r\n"[0: 30], &resp3_out[0], 512, 1000u64);
    try assert_true(network_connection_contains(resp3_out[0: subscribe_resp3.response_len], &"subscribe"[0: 9]));

    const get_resp3_subscribed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &resp3_tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &resp3_out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(resp3_out[0: get_resp3_subscribed.response_len], &"_\r\n"[0: 3]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_pubsub_introspection() !void {
    reset_memory_stats_for_test();
    connection_pubsub_reset_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var sub_tx: ConnectionTransaction = connection_transaction_new();
    sub_tx.client_fd = 21;
    var direct_tx: ConnectionTransaction = connection_transaction_new();
    direct_tx.client_fd = 22;
    var info_tx: ConnectionTransaction = connection_transaction_new();
    info_tx.client_fd = 23;
    defer {
        connection_transaction_reset(&sub_tx);
        connection_transaction_reset(&direct_tx);
        connection_transaction_reset(&info_tx);
        connection_pubsub_reset_for_test();
    }
    var out: [byte: 2048] = [];

    _ = try connection_process_input_with_transaction_at(&engine, &router, &sub_tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$5\r\nchan1\r\n"[0: 30], &out[0], 2048, 1000u64);
    _ = try connection_process_input_with_transaction_at(&engine, &router, &sub_tx, &"*2\r\n$10\r\nPSUBSCRIBE\r\n$5\r\nchan*\r\n"[0: 32], &out[0], 2048, 1000u64);
    _ = try connection_process_input_with_transaction_at(&engine, &router, &direct_tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$5\r\nchan1\r\n"[0: 30], &out[0], 2048, 1000u64);
    _ = try connection_process_input_with_transaction_at(&engine, &router, &direct_tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$3\r\nzed\r\n"[0: 28], &out[0], 2048, 1000u64);

    const channels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$8\r\nCHANNELS\r\n"[0: 30], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: channels.response_len], &"*2\r\n$5\r\nchan1\r\n$3\r\nzed\r\n"[0: 24]));

    const channels_pattern: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*3\r\n$6\r\nPUBSUB\r\n$8\r\nCHANNELS\r\n$5\r\nchan?\r\n"[0: 41], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: channels_pattern.response_len], &"*1\r\n$5\r\nchan1\r\n"[0: 15]));

    const numpat: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$6\r\nNUMPAT\r\n"[0: 28], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: numpat.response_len], &":1\r\n"[0: 4]));

    const numsub: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*5\r\n$6\r\nPUBSUB\r\n$6\r\nNUMSUB\r\n$5\r\nchan1\r\n$3\r\nzed\r\n$5\r\nghost\r\n"[0: 59], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: numsub.response_len], &"*6\r\n$5\r\nchan1\r\n:2\r\n$3\r\nzed\r\n:1\r\n$5\r\nghost\r\n:0\r\n"[0: 47]));

    const numsub_empty: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$6\r\nNUMSUB\r\n"[0: 28], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: numsub_empty.response_len], &"*0\r\n"[0: 4]));

    const shardchannels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$13\r\nSHARDCHANNELS\r\n"[0: 36], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: shardchannels.response_len], &"*0\r\n"[0: 4]));

    const shardnumsub: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*4\r\n$6\r\nPUBSUB\r\n$11\r\nSHARDNUMSUB\r\n$6\r\nshard1\r\n$6\r\nshard2\r\n"[0: 58], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: shardnumsub.response_len], &"*4\r\n$6\r\nshard1\r\n:0\r\n$6\r\nshard2\r\n:0\r\n"[0: 36]));

    const help: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$4\r\nHELP\r\n"[0: 26], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: help.response_len], &"PUBSUB <subcommand> [<arg> [value] [opt] ...]. Subcommands are:"[0: 63]));
    try assert_true(network_connection_contains(out[0: help.response_len], &"SHARDCHANNELS [<pattern>]"[0: 25]));

    const missing_subcommand: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*1\r\n$6\r\nPUBSUB\r\n"[0: 16], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: missing_subcommand.response_len], &"-ERR wrong number of arguments for 'pubsub' command\r\n"[0: 53]));

    const bad_subcommand: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$4\r\nNOPE\r\n"[0: 26], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bad_subcommand.response_len], &"-ERR unknown subcommand 'nope'. Try PUBSUB HELP.\r\n"[0: 50]));

    const bad_channels_arity: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*4\r\n$6\r\nPUBSUB\r\n$8\r\nCHANNELS\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 44], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bad_channels_arity.response_len], &"-ERR unknown subcommand or wrong number of arguments for 'channels'. Try PUBSUB HELP.\r\n"[0: 87]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}
