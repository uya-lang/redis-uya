export fn test_command_sintercard() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var s1_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nSADD\r\n$2\r\ns1\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 43]);
    const s1_command: Command = try command_executor_test_command(&router, &s1_parsed);
    _ = command_execute_at(&engine, &s1_command, 1000u64);
    resp_value_free(&s1_parsed.value);

    var s2_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nSADD\r\n$2\r\ns2\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 36]);
    const s2_command: Command = try command_executor_test_command(&router, &s2_parsed);
    _ = command_execute_at(&engine, &s2_command, 1000u64);
    resp_value_free(&s2_parsed.value);

    var s3_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nSADD\r\n$2\r\ns3\r\n$1\r\nc\r\n"[0: 29]);
    const s3_command: Command = try command_executor_test_command(&router, &s3_parsed);
    _ = command_execute_at(&engine, &s3_command, 1000u64);
    resp_value_free(&s3_parsed.value);

    var bad_seed_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$3\r\nbad\r\n$1\r\nx\r\n"[0: 29]);
    const bad_seed_command: Command = try command_executor_test_command(&router, &bad_seed_parsed);
    _ = command_execute_at(&engine, &bad_seed_command, 1000u64);
    resp_value_free(&bad_seed_parsed.value);

    var base_parsed: RespParseResult = try parse_resp2(&"*5\r\n$10\r\nSINTERCARD\r\n$1\r\n3\r\n$2\r\ns1\r\n$2\r\ns2\r\n$2\r\ns3\r\n"[0: 52]);
    const base_command: Command = try command_executor_test_command(&router, &base_parsed);
    const base_reply: CommandReply = command_execute_at(&engine, &base_command, 1000u64);
    try assert_eq_i32(base_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(base_reply.integer as i32, 1);
    resp_value_free(&base_parsed.value);

    var limit_parsed: RespParseResult = try parse_resp2(&"*7\r\n$10\r\nSINTERCARD\r\n$1\r\n3\r\n$2\r\ns1\r\n$2\r\ns2\r\n$2\r\ns3\r\n$5\r\nLIMIT\r\n$1\r\n1\r\n"[0: 70]);
    const limit_command: Command = try command_executor_test_command(&router, &limit_parsed);
    const limit_reply: CommandReply = command_execute_at(&engine, &limit_command, 1000u64);
    try assert_eq_i32(limit_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(limit_reply.integer as i32, 1);
    resp_value_free(&limit_parsed.value);

    var single_limit_parsed: RespParseResult = try parse_resp2(&"*5\r\n$10\r\nSINTERCARD\r\n$1\r\n1\r\n$2\r\ns1\r\n$5\r\nLIMIT\r\n$1\r\n2\r\n"[0: 54]);
    const single_limit_command: Command = try command_executor_test_command(&router, &single_limit_parsed);
    const single_limit_reply: CommandReply = command_execute_at(&engine, &single_limit_command, 1000u64);
    try assert_eq_i32(single_limit_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(single_limit_reply.integer as i32, 2);
    resp_value_free(&single_limit_parsed.value);

    var missing_parsed: RespParseResult = try parse_resp2(&"*4\r\n$10\r\nSINTERCARD\r\n$1\r\n2\r\n$2\r\ns1\r\n$7\r\nmissing\r\n"[0: 49]);
    const missing_command: Command = try command_executor_test_command(&router, &missing_parsed);
    const missing_reply: CommandReply = command_execute_at(&engine, &missing_command, 1000u64);
    try assert_eq_i32(missing_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(missing_reply.integer as i32, 0);
    resp_value_free(&missing_parsed.value);

    var wrongtype_parsed: RespParseResult = try parse_resp2(&"*4\r\n$10\r\nSINTERCARD\r\n$1\r\n2\r\n$7\r\nmissing\r\n$3\r\nbad\r\n"[0: 50]);
    const wrongtype_command: Command = try command_executor_test_command(&router, &wrongtype_parsed);
    const wrongtype_reply: CommandReply = command_execute_at(&engine, &wrongtype_command, 1000u64);
    try assert_eq_i32(wrongtype_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(wrongtype_reply.data, &"WRONGTYPE Operation against a key holding the wrong kind of value"[0: 65]));
    resp_value_free(&wrongtype_parsed.value);

    var zero_numkeys_parsed: RespParseResult = try parse_resp2(&"*3\r\n$10\r\nSINTERCARD\r\n$1\r\n0\r\n$2\r\ns1\r\n"[0: 36]);
    const zero_numkeys_command: Command = try command_executor_test_command(&router, &zero_numkeys_parsed);
    const zero_numkeys_reply: CommandReply = command_execute_at(&engine, &zero_numkeys_command, 1000u64);
    try assert_eq_i32(zero_numkeys_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(zero_numkeys_reply.data, &"ERR numkeys should be greater than 0"[0: 36]));
    resp_value_free(&zero_numkeys_parsed.value);

    var mismatch_parsed: RespParseResult = try parse_resp2(&"*4\r\n$10\r\nSINTERCARD\r\n$1\r\n3\r\n$2\r\ns1\r\n$2\r\ns2\r\n"[0: 44]);
    const mismatch_command: Command = try command_executor_test_command(&router, &mismatch_parsed);
    const mismatch_reply: CommandReply = command_execute_at(&engine, &mismatch_command, 1000u64);
    try assert_eq_i32(mismatch_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(mismatch_reply.data, &"ERR Number of keys can't be greater than number of args"[0: 55]));
    resp_value_free(&mismatch_parsed.value);

    var negative_limit_parsed: RespParseResult = try parse_resp2(&"*6\r\n$10\r\nSINTERCARD\r\n$1\r\n2\r\n$2\r\ns1\r\n$2\r\ns2\r\n$5\r\nLIMIT\r\n$2\r\n-1\r\n"[0: 63]);
    const negative_limit_command: Command = try command_executor_test_command(&router, &negative_limit_parsed);
    const negative_limit_reply: CommandReply = command_execute_at(&engine, &negative_limit_command, 1000u64);
    try assert_eq_i32(negative_limit_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(negative_limit_reply.data, &"ERR LIMIT can't be negative"[0: 27]));
    resp_value_free(&negative_limit_parsed.value);

    var syntax_parsed: RespParseResult = try parse_resp2(&"*5\r\n$10\r\nSINTERCARD\r\n$1\r\n2\r\n$2\r\ns1\r\n$2\r\ns2\r\n$3\r\nfoo\r\n"[0: 53]);
    const syntax_command: Command = try command_executor_test_command(&router, &syntax_parsed);
    const syntax_reply: CommandReply = command_execute_at(&engine, &syntax_command, 1000u64);
    try assert_eq_i32(syntax_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(syntax_reply.data, &"ERR syntax error"[0: 16]));
    resp_value_free(&syntax_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_sinterstore_sdiffstore_sunionstore() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var sadd_s1_parsed: RespParseResult = try parse_resp2(&"*6\r\n$4\r\nSADD\r\n$2\r\ns1\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n$1\r\nd\r\n"[0: 50]);
