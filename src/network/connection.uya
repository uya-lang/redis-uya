fn connection_acl_named_user_command_denied(user: &ConnectionAclUser, name: &[byte]) bool {
    if user.denied_command_count > 0 && connection_acl_user_denied_command_find(user, name) >= 0 {
        return true;
    }
    if user.denied_category_count == 0 {
        return false;
    }
    const entry: CommandCatalogEntry = command_catalog_lookup(name) catch {
        return false;
    };
    var index: usize = 0;
    while index < CONNECTION_ACL_DENIED_CATEGORY_MAX {
        if user.denied_categories[index].active &&
            command_catalog_has_acl_category(&entry, user.denied_categories[index].name[0: user.denied_categories[index].name_len]) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn connection_acl_backup_child_name(name: &[byte]) bool {
    return connection_keyword_eq(name, &"backup|abort"[0: 12]) ||
        connection_keyword_eq(name, &"backup|cleanup"[0: 14]) ||
        connection_keyword_eq(name, &"backup|help"[0: 11]) ||
        connection_keyword_eq(name, &"backup|list"[0: 11]) ||
        connection_keyword_eq(name, &"backup|seal"[0: 11]) ||
        connection_keyword_eq(name, &"backup|start"[0: 12]) ||
        connection_keyword_eq(name, &"backup|status"[0: 13]);
}

fn connection_acl_user_command_denied(username: &[byte], name: &[byte]) bool {
    if connection_keyword_eq(username, &"default"[0: 7]) {
        if connection_acl_default_command_denied(name) {
            return true;
        }
        if connection_keyword_eq(name, &"himport|prepare"[0: 15]) ||
            connection_keyword_eq(name, &"himport|set"[0: 11]) ||
            connection_keyword_eq(name, &"himport|discard"[0: 15]) ||
            connection_keyword_eq(name, &"himport|discardall"[0: 18]) {
            return connection_acl_default_command_denied(&"himport"[0: 7]);
        }
        if connection_acl_backup_child_name(name) {
            return connection_acl_default_command_denied(&"backup"[0: 6]);
        }
        return false;
    }
    const slot: i32 = connection_acl_user_find(username);
    if slot < 0 || slot >= CONNECTION_ACL_USER_MAX as i32 {
        return false;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_USER_MAX {
        return false;
    }
    const user: &ConnectionAclUser = &connection_acl_users[slot_index];
    if !user.active {
        return false;
    }
    if connection_acl_named_user_command_denied(user, name) {
        return true;
    }
    if connection_keyword_eq(name, &"himport|prepare"[0: 15]) ||
        connection_keyword_eq(name, &"himport|set"[0: 11]) ||
        connection_keyword_eq(name, &"himport|discard"[0: 15]) ||
        connection_keyword_eq(name, &"himport|discardall"[0: 18]) {
        return connection_acl_named_user_command_denied(user, &"himport"[0: 7]);
    }
    if connection_acl_backup_child_name(name) {
        return connection_acl_named_user_command_denied(user, &"backup"[0: 6]);
    }
    return false;
}

fn connection_acl_effective_command_name(command: &Command) &[byte] {
    if command.argc < 2 {
        return command.info.name;
    }
    const subcommand: &[byte] = command_arg_data(command, 1) catch {
        return command.info.name;
    };
    if command.info.cmd_type == CommandType.command_himport {
        if connection_keyword_eq(subcommand, &"PREPARE"[0: 7]) { return &"himport|prepare"[0: 15]; }
        if connection_keyword_eq(subcommand, &"SET"[0: 3]) { return &"himport|set"[0: 11]; }
        if connection_keyword_eq(subcommand, &"DISCARD"[0: 7]) { return &"himport|discard"[0: 15]; }
        if connection_keyword_eq(subcommand, &"DISCARDALL"[0: 10]) { return &"himport|discardall"[0: 18]; }
    }
    if command.info.cmd_type == CommandType.command_backup {
        if connection_keyword_eq(subcommand, &"ABORT"[0: 5]) { return &"backup|abort"[0: 12]; }
        if connection_keyword_eq(subcommand, &"CLEANUP"[0: 7]) { return &"backup|cleanup"[0: 14]; }
        if connection_keyword_eq(subcommand, &"HELP"[0: 4]) { return &"backup|help"[0: 11]; }
        if connection_keyword_eq(subcommand, &"LIST"[0: 4]) { return &"backup|list"[0: 11]; }
        if connection_keyword_eq(subcommand, &"SEAL"[0: 4]) { return &"backup|seal"[0: 11]; }
        if connection_keyword_eq(subcommand, &"START"[0: 5]) { return &"backup|start"[0: 12]; }
        if connection_keyword_eq(subcommand, &"STATUS"[0: 6]) { return &"backup|status"[0: 13]; }
    }
    return command.info.name;
}

export fn connection_acl_denied_command_count_for_test(username: &[byte]) usize {
    if connection_keyword_eq(username, &"default"[0: 7]) {
        return connection_acl_default_denied_command_count;
    }
    const slot: i32 = connection_acl_user_find(username);
    if slot < 0 || slot >= CONNECTION_ACL_USER_MAX as i32 {
        return 0;
    }
    const slot_index: usize = slot as usize;
    if slot_index < CONNECTION_ACL_USER_MAX {
        if connection_acl_users[slot_index].active {
            return connection_acl_users[slot_index].denied_command_count;
        }
    }
    return 0;
}

fn connection_acl_user_key_allowed(username: &[byte], key: &[byte]) bool {
    if connection_keyword_eq(username, &"default"[0: 7]) {
        return connection_acl_key_allowed_by_patterns(connection_acl_default_key_rules.allkeys, connection_acl_default_key_rules.patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX], key);
    }
    const slot: i32 = connection_acl_user_find(username);
    if slot < 0 || slot >= CONNECTION_ACL_USER_MAX as i32 {
        return true;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_USER_MAX || !connection_acl_users[slot_index].active {
        return true;
    }
    return connection_acl_key_allowed_by_patterns(connection_acl_users[slot_index].allkeys, connection_acl_users[slot_index].key_patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX], key);
}

fn connection_acl_user_allkeys(username: &[byte]) bool {
    if connection_keyword_eq(username, &"default"[0: 7]) {
        return connection_acl_default_key_rules.allkeys;
    }
    const slot: i32 = connection_acl_user_find(username);
    if slot < 0 || slot >= CONNECTION_ACL_USER_MAX as i32 {
        return true;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_USER_MAX {
        return true;
    }
    if connection_acl_users[slot_index].active == false {
        return true;
    }
    return connection_acl_users[slot_index].allkeys;
}

fn connection_acl_user_channel_allowed(username: &[byte], channel: &[byte]) bool {
    if connection_keyword_eq(username, &"default"[0: 7]) {
        return connection_acl_channel_allowed_by_patterns(connection_acl_default_channel_rules.allchannels, connection_acl_default_channel_rules.patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX], channel);
    }
    const slot: i32 = connection_acl_user_find(username);
    if slot < 0 || slot >= CONNECTION_ACL_USER_MAX as i32 {
        return true;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_USER_MAX || !connection_acl_users[slot_index].active {
        return true;
    }
    return connection_acl_channel_allowed_by_patterns(connection_acl_users[slot_index].allchannels, connection_acl_users[slot_index].channel_patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX], channel);
}

fn connection_acl_user_allchannels(username: &[byte]) bool {
    if connection_keyword_eq(username, &"default"[0: 7]) {
        return connection_acl_default_channel_rules.allchannels;
    }
    const slot: i32 = connection_acl_user_find(username);
    if slot < 0 || slot >= CONNECTION_ACL_USER_MAX as i32 {
        return true;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_USER_MAX {
        return true;
    }
    if connection_acl_users[slot_index].active == false {
        return true;
    }
    return connection_acl_users[slot_index].allchannels;
}

fn connection_acl_default_user_unrestricted() bool {
    return connection_acl_default_denied_command_count == 0 &&
        connection_acl_default_denied_category_count == 0 &&
        connection_acl_default_key_rules.allkeys &&
        connection_acl_default_channel_rules.allchannels;
}

fn connection_acl_user_unrestricted(username: &[byte]) bool {
    if connection_keyword_eq(username, &"default"[0: 7]) {
        return connection_acl_default_user_unrestricted();
    }
    const slot: i32 = connection_acl_user_find(username);
    if slot < 0 || slot >= CONNECTION_ACL_USER_MAX as i32 {
        return true;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_USER_MAX {
        return true;
    }
    if !connection_acl_users[slot_index].active {
        return true;
    }
    return connection_acl_users[slot_index].denied_command_count == 0 &&
        connection_acl_users[slot_index].denied_category_count == 0 &&
        connection_acl_users[slot_index].allkeys &&
        connection_acl_users[slot_index].allchannels;
}

fn connection_acl_current_user_unrestricted(tx: &ConnectionTransaction) bool {
    if tx == null || tx.username_len == 0 {
        return connection_acl_default_user_unrestricted();
    }
    return connection_acl_user_unrestricted(tx.username[0: tx.username_len]);
}

fn connection_acl_command_uses_channels(cmd_type: CommandType) bool {
    return cmd_type == CommandType.command_publish ||
        cmd_type == CommandType.command_spublish ||
        cmd_type == CommandType.command_subscribe ||
        cmd_type == CommandType.command_psubscribe ||
        cmd_type == CommandType.command_ssubscribe ||
        cmd_type == CommandType.command_unsubscribe ||
        cmd_type == CommandType.command_punsubscribe ||
        cmd_type == CommandType.command_sunsubscribe;
}

fn connection_acl_user_command_channel_denied(username: &[byte], info: &CommandInfo, command: &Command, arg_offset: usize, full_argc: usize) bool {
    if connection_acl_user_allchannels(username) {
        return false;
    }
    if !connection_acl_command_uses_channels(info.cmd_type) {
        return false;
    }
    if full_argc <= 1 {
        return false;
    }
    var start_index: usize = 1;
    var end_index: usize = full_argc;
    if info.cmd_type == CommandType.command_publish || info.cmd_type == CommandType.command_spublish {
        end_index = 2;
    }
    var index: usize = start_index;
    while index < end_index {
        const channel: &[byte] = command_arg_data(command, arg_offset + index) catch {
            return false;
        };
        if !connection_acl_user_channel_allowed(username, channel) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn connection_acl_count_range_keys(info: &CommandInfo, full_argc: usize) usize {
    if info.first_key <= 0 || info.key_step <= 0 {
        return 0;
    }
    var last_index: i32 = info.last_key;
    if info.last_key < 0 {
        last_index = full_argc as i32 + info.last_key;
    }
    if last_index < info.first_key {
        return 0;
    }
    return (((last_index - info.first_key) / info.key_step) + 1) as usize;
}

fn connection_acl_user_command_key_denied(username: &[byte], info: &CommandInfo, command: &Command, arg_offset: usize, full_argc: usize) bool {
    if info.cmd_type == CommandType.command_himport {
        if connection_acl_user_allkeys(username) || full_argc < 3 {
            return false;
        }
        const subcommand: &[byte] = command_arg_data(command, arg_offset + 1) catch {
            return false;
        };
        if !connection_keyword_eq(subcommand, &"SET"[0: 3]) {
            return false;
        }
        const key: &[byte] = command_arg_data(command, arg_offset + 2) catch {
            return false;
        };
        return !connection_acl_user_key_allowed(username, key);
    }
    const key_count: usize = connection_acl_count_range_keys(info, full_argc);
    if key_count == 0 {
        return false;
    }
    if connection_acl_user_allkeys(username) {
        return false;
    }
    var last_index: i32 = info.last_key;
    if info.last_key < 0 {
        last_index = full_argc as i32 + info.last_key;
    }
    var key_index: i32 = info.first_key;
    while key_index <= last_index {
        const actual_index: usize = arg_offset + key_index as usize;
        const key: &[byte] = command_arg_data(command, actual_index) catch {
            return false;
        };
        if !connection_acl_user_key_allowed(username, key) {
            return true;
        }
        key_index = key_index + info.key_step;
    }
    return false;
}

fn connection_acl_log_copy_lower(dst: &[byte], src: &[byte]) usize {
    var written: usize = 0;
    while written < dst.len && written < src.len {
        dst.ptr[written] = connection_ascii_lower(src.ptr[written]);
        written = written + 1;
    }
    return written;
}

fn connection_acl_log_append_command_denied(name: &[byte], context: &[byte], username: &[byte], now_ms: u64, client_id: i64) void {
    if name.len == 0 || context.len == 0 {
        return;
    }
    var slot: usize = connection_acl_log_next_index;
    if slot >= CONNECTION_ACL_LOG_MAX {
        slot = 0;
        connection_acl_log_next_index = 0;
    }
    if slot < CONNECTION_ACL_LOG_MAX {
        connection_acl_log_entries[slot].active = true;
        connection_acl_log_entries[slot].sequence = connection_acl_log_next_sequence;
        connection_acl_log_entries[slot].created_ms = now_ms;
        connection_acl_log_entries[slot].client_id = client_id;
        connection_acl_log_entries[slot].username_len = connection_acl_log_copy_lower(connection_acl_log_entries[slot].username[0: CONNECTION_ACL_USER_NAME_MAX], username);
        connection_acl_log_entries[slot].client_addr_len = 0;
        connection_acl_log_entries[slot].client_local_addr_len = 0;
        const client_slot_idx: i32 = connection_client_registry_find_client_id_slot(client_id);
        if client_slot_idx >= 0 && client_slot_idx < CONNECTION_CLIENT_REGISTRY_MAX as i32 {
            const client_slot_usize: usize = client_slot_idx as usize;
            if client_slot_usize < CONNECTION_CLIENT_REGISTRY_MAX {
                connection_acl_log_entries[slot].client_addr_len = connection_client_registry[client_slot_usize].client_addr_len;
                connection_acl_log_entries[slot].client_local_addr_len = connection_client_registry[client_slot_usize].client_local_addr_len;
                connection_client_registry_copy_bytes(connection_acl_log_entries[slot].client_addr[0: CONNECTION_CLIENT_ADDR_MAX], connection_client_registry[client_slot_usize].client_addr[0: CONNECTION_CLIENT_ADDR_MAX], connection_acl_log_entries[slot].client_addr_len);
                connection_client_registry_copy_bytes(connection_acl_log_entries[slot].client_local_addr[0: CONNECTION_CLIENT_ADDR_MAX], connection_client_registry[client_slot_usize].client_local_addr[0: CONNECTION_CLIENT_ADDR_MAX], connection_acl_log_entries[slot].client_local_addr_len);
            }
        }
        connection_acl_log_entries[slot].count = 1u64;
        connection_acl_log_entries[slot].command_len = connection_acl_log_copy_lower(connection_acl_log_entries[slot].command[0: CONNECTION_ACL_COMMAND_NAME_MAX], name);
        connection_acl_log_entries[slot].context_len = connection_acl_log_copy_lower(connection_acl_log_entries[slot].context[0: CONNECTION_ACL_LOG_CONTEXT_MAX], context);
    } else {
        return;
    }

    connection_acl_log_next_sequence = connection_acl_log_next_sequence + 1u64;
    connection_acl_log_next_index = connection_acl_log_next_index + 1;
    if connection_acl_log_next_index >= CONNECTION_ACL_LOG_MAX {
        connection_acl_log_next_index = 0;
    }
    if connection_acl_log_count < CONNECTION_ACL_LOG_MAX {
        connection_acl_log_count = connection_acl_log_count + 1;
    }
}

fn connection_acl_permission_error_for_user(name: &[byte], username: &[byte]) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    _ = sds_cat(&raw, &"NOPERM User "[0: 12]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&raw, username) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&raw, &" has no permissions to run the '"[0: 32]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_ascii_lower(&raw, name) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&raw, &"' command"[0: 9]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_owned_error(raw.buf[0: raw.len]);
}

fn connection_acl_permission_error(name: &[byte]) CommandReply {
    return connection_acl_permission_error_for_user(name, &"default"[0: 7]);
}

fn connection_acl_permission_denied_reply_for_user(name: &[byte], context: &[byte], username: &[byte], now_ms: u64, client_id: i64) CommandReply {
    connection_acl_log_append_command_denied(name, context, username, now_ms, client_id);
    return connection_acl_permission_error_for_user(name, username);
}

fn connection_acl_key_permission_error_for_user(username: &[byte]) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    _ = sds_cat(&raw, &"NOPERM User "[0: 12]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&raw, username) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&raw, &" has no permissions to access one of the keys used as arguments"[0: 63]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_owned_error(raw.buf[0: raw.len]);
}

fn connection_acl_key_permission_denied_reply_for_user(name: &[byte], context: &[byte], username: &[byte], now_ms: u64, client_id: i64) CommandReply {
    connection_acl_log_append_command_denied(name, context, username, now_ms, client_id);
    return connection_acl_key_permission_error_for_user(username);
}

fn connection_acl_channel_permission_error_for_user(username: &[byte]) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    _ = sds_cat(&raw, &"NOPERM User "[0: 12]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&raw, username) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&raw, &" has no permissions to access one of the channels used as arguments"[0: 67]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_owned_error(raw.buf[0: raw.len]);
}

fn connection_acl_channel_permission_denied_reply_for_user(name: &[byte], context: &[byte], username: &[byte], now_ms: u64, client_id: i64) CommandReply {
    connection_acl_log_append_command_denied(name, context, username, now_ms, client_id);
    return connection_acl_channel_permission_error_for_user(username);
}

fn connection_acl_permission_denied_reply(name: &[byte], context: &[byte], now_ms: u64, client_id: i64) CommandReply {
    return connection_acl_permission_denied_reply_for_user(name, context, &"default"[0: 7], now_ms, client_id);
}

fn connection_acl_append_default_command_rules(raw: &Sds) !void {
    try sds_cat(raw, &"+@all"[0: 5]);
    var index: usize = 0;
    while index < CONNECTION_ACL_DENIED_COMMAND_MAX {
        if connection_acl_default_denied_commands[index].active {
            try sds_cat(raw, &" -"[0: 2]);
            try sds_cat(raw, connection_acl_default_denied_commands[index].name[0: connection_acl_default_denied_commands[index].name_len]);
        }
        index = index + 1;
    }
    var category_index: usize = 0;
    while category_index < CONNECTION_ACL_DENIED_CATEGORY_MAX {
        if connection_acl_default_denied_categories[category_index].active {
            try sds_cat(raw, &" -@"[0: 3]);
            try sds_cat(raw, connection_acl_default_denied_categories[category_index].name[0: connection_acl_default_denied_categories[category_index].name_len]);
        }
        category_index = category_index + 1;
    }
}

fn connection_acl_append_named_command_rules(raw: &Sds, user: &ConnectionAclUser) !void {
    try sds_cat(raw, &"+@all"[0: 5]);
    var index: usize = 0;
    while index < CONNECTION_ACL_DENIED_COMMAND_MAX {
        if user.denied_commands[index].active {
            try sds_cat(raw, &" -"[0: 2]);
            try sds_cat(raw, user.denied_commands[index].name[0: user.denied_commands[index].name_len]);
        }
        index = index + 1;
    }
    var category_index: usize = 0;
    while category_index < CONNECTION_ACL_DENIED_CATEGORY_MAX {
        if user.denied_categories[category_index].active {
            try sds_cat(raw, &" -@"[0: 3]);
            try sds_cat(raw, user.denied_categories[category_index].name[0: user.denied_categories[category_index].name_len]);
        }
        category_index = category_index + 1;
    }
}

fn connection_acl_named_command_rules_sds(user: &ConnectionAclUser) !Sds {
    var rules: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    _ = connection_acl_append_named_command_rules(&rules, user) catch {
        sds_free(&rules);
        return error.AllocOutOfMemory;
    };
    return rules;
}

fn connection_acl_append_key_rules(raw: &Sds, allkeys: bool, patterns: &[ConnectionAclKeyPattern]) !void {
    if allkeys {
        try sds_cat(raw, &"~*"[0: 2]);
        return;
    }
    var first: bool = true;
    var index: usize = 0;
    while index < patterns.len {
        if patterns.ptr[index].active {
            if first == false {
                try sds_cat(raw, &" "[0: 1]);
            }
            try sds_cat(raw, &"~"[0: 1]);
            try sds_cat(raw, patterns.ptr[index].pattern[0: patterns.ptr[index].pattern_len]);
            first = false;
        }
        index = index + 1;
    }
    if first {
        try sds_cat(raw, &"resetkeys"[0: 9]);
    }
}

fn connection_acl_key_rules_sds(allkeys: bool, patterns: &[ConnectionAclKeyPattern]) !Sds {
    var rules: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    _ = connection_acl_append_key_rules(&rules, allkeys, patterns) catch {
        sds_free(&rules);
        return error.AllocOutOfMemory;
    };
    return rules;
}

fn connection_acl_append_channel_rules(raw: &Sds, allchannels: bool, patterns: &[ConnectionAclChannelPattern]) !void {
    if allchannels {
        try sds_cat(raw, &"&*"[0: 2]);
        return;
    }
    var first: bool = true;
    var index: usize = 0;
    while index < patterns.len {
        if patterns.ptr[index].active {
            if first == false {
                try sds_cat(raw, &" "[0: 1]);
            }
            try sds_cat(raw, &"&"[0: 1]);
            try sds_cat(raw, patterns.ptr[index].pattern[0: patterns.ptr[index].pattern_len]);
            first = false;
        }
        index = index + 1;
    }
    if first {
        try sds_cat(raw, &"resetchannels"[0: 13]);
    }
}

fn connection_acl_channel_rules_sds(allchannels: bool, patterns: &[ConnectionAclChannelPattern]) !Sds {
    var rules: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    _ = connection_acl_append_channel_rules(&rules, allchannels, patterns) catch {
        sds_free(&rules);
        return error.AllocOutOfMemory;
    };
    return rules;
}

fn connection_acl_default_command_rules_sds() !Sds {
    var rules: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    _ = connection_acl_append_default_command_rules(&rules) catch {
        sds_free(&rules);
        return error.AllocOutOfMemory;
    };
    return rules;
}

fn connection_acl_hash_hex_nibble(value: byte) byte {
    if value < 10 as byte {
        return 48 as byte + value;
    }
    return 97 as byte + (value - 10 as byte);
}

fn connection_acl_hash_hex_value(ch: byte) !byte {
    if ch >= 48 as byte && ch <= 57 as byte {
        return ch - 48 as byte;
    }
    if ch >= 97 as byte && ch <= 102 as byte {
        return ch - 97 as byte + 10 as byte;
    }
    return error.ConnectionAclFileInvalid;
}

fn connection_acl_hash_password(password: &[byte], out: &[byte]) void {
    if out.len < CONNECTION_ACL_PASSWORD_HASH_BYTES {
        return;
    }
    sha256(password.ptr as &const byte, password.len, out.ptr);
}

fn connection_acl_bytes_clear(data: &[byte]) void {
    var index: usize = 0;
    while index < data.len {
        data.ptr[index] = 0 as byte;
        index = index + 1;
    }
}

fn connection_acl_hash_from_hex(hex: &[byte], out: &[byte]) !void {
    if hex.len != CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES || out.len < CONNECTION_ACL_PASSWORD_HASH_BYTES {
        return error.ConnectionAclFileInvalid;
    }
    var index: usize = 0;
    while index < CONNECTION_ACL_PASSWORD_HASH_BYTES {
        const high: byte = try connection_acl_hash_hex_value(hex.ptr[index * 2]);
        const low: byte = try connection_acl_hash_hex_value(hex.ptr[index * 2 + 1]);
        out.ptr[index] = (high << 4) | low;
        index = index + 1;
    }
}

fn connection_acl_hash_hex_valid(hex: &[byte]) bool {
    if hex.len != CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES {
        return false;
    }
    var index: usize = 0;
    while index < hex.len {
        const ch: byte = hex.ptr[index];
        if !((ch >= 48 as byte && ch <= 57 as byte) || (ch >= 97 as byte && ch <= 102 as byte)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn connection_acl_hash_marker(hash: &[byte], out: &[byte]) usize {
    if hash.len < CONNECTION_ACL_PASSWORD_HASH_BYTES || out.len < CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1 {
        return 0;
    }
    out.ptr[0] = 35 as byte;
    var index: usize = 0;
    while index < CONNECTION_ACL_PASSWORD_HASH_BYTES {
        const value: byte = hash.ptr[index];
        out.ptr[index * 2 + 1] = connection_acl_hash_hex_nibble((value >> 4) & 15 as byte);
        out.ptr[index * 2 + 2] = connection_acl_hash_hex_nibble(value & 15 as byte);
        index = index + 1;
    }
    return CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1;
}

fn connection_acl_password_marker(password: &[byte], out: &[byte]) usize {
    if password.len == 0 {
        return 0;
    }
    var hash: [byte: CONNECTION_ACL_PASSWORD_HASH_BYTES] = [];
    connection_acl_hash_password(password, hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
    return connection_acl_hash_marker(hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], out);
}

fn connection_acl_default_password_marker(runtime: &CommandRuntimeInfo, out: &[byte]) usize {
    if runtime.config.requirepass_hash_set {
        return connection_acl_hash_marker(runtime.config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], out);
    }
    return connection_acl_password_marker(connection_requirepass(runtime), out);
}

fn connection_acl_hash_matches_password(hash: &[byte], password: &[byte]) bool {
    if hash.len < CONNECTION_ACL_PASSWORD_HASH_BYTES {
        return false;
    }
    var candidate: [byte: CONNECTION_ACL_PASSWORD_HASH_BYTES] = [];
    connection_acl_hash_password(password, candidate[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
    var difference: byte = 0 as byte;
    var index: usize = 0;
    while index < CONNECTION_ACL_PASSWORD_HASH_BYTES {
        const mismatch: byte = hash.ptr[index] ^ candidate[index];
        difference = difference | mismatch;
        index = index + 1;
    }
    return difference == 0 as byte;
}

fn connection_acl_hash_matches_hash(hash: &[byte], candidate: &[byte]) bool {
    if hash.len < CONNECTION_ACL_PASSWORD_HASH_BYTES || candidate.len < CONNECTION_ACL_PASSWORD_HASH_BYTES {
        return false;
    }
    var difference: byte = 0 as byte;
    var index: usize = 0;
    while index < CONNECTION_ACL_PASSWORD_HASH_BYTES {
        const mismatch: byte = hash.ptr[index] ^ candidate.ptr[index];
        difference = difference | mismatch;
        index = index + 1;
    }
    return difference == 0 as byte;
}

fn connection_set_authenticated_user(tx: &ConnectionTransaction, username: &[byte]) void {
    if tx == null {
        return;
    }
    var len: usize = username.len;
    if len > CONNECTION_ACL_USER_NAME_MAX {
        len = CONNECTION_ACL_USER_NAME_MAX;
    }
    tx.username_len = len;
    var i: usize = 0;
    while i < len {
        tx.username[i] = username.ptr[i];
        i = i + 1;
    }
    while i < CONNECTION_ACL_USER_NAME_MAX {
        tx.username[i] = 0 as byte;
        i = i + 1;
    }
}

fn connection_current_username(tx: &ConnectionTransaction) &[byte] {
    if tx != null && tx.username_len > 0 {
        return tx.username[0: tx.username_len];
    }
    return &"default"[0: 7];
}

export fn connection_transaction_client_kill_user_matches(tx: &ConnectionTransaction, selector: i32) bool {
    if selector == CONNECTION_CLIENT_KILL_USER_NONE {
        return true;
    }
    if selector == CONNECTION_CLIENT_KILL_USER_DEFAULT {
        return connection_slice_eq(connection_current_username(tx), &"default"[0: 7]);
    }
    if selector < 0 || selector >= CONNECTION_ACL_USER_MAX as i32 {
        return false;
    }
    const selector_index: usize = selector as usize;
    if selector_index >= CONNECTION_ACL_USER_MAX || !connection_acl_users[selector_index].active {
        return false;
    }
    return connection_slice_eq(
        connection_current_username(tx),
        connection_acl_users[selector_index].name[0: connection_acl_users[selector_index].name_len],
    );
}

export fn connection_transaction_client_kill_type_matches(tx: &ConnectionTransaction, selector: i32) bool {
    if selector == CONNECTION_CLIENT_KILL_TYPE_NONE {
        return true;
    }
    if selector == CONNECTION_CLIENT_KILL_TYPE_NORMAL {
        return tx == null || tx.pubsub_count == 0;
    }
    if selector == CONNECTION_CLIENT_KILL_TYPE_PUBSUB {
        return tx != null && tx.pubsub_count > 0;
    }
    return false;
}

export fn connection_transaction_client_local_addr_matches(left: &ConnectionTransaction, right: &ConnectionTransaction) bool {
    if left == null || right == null || left.client_local_addr_len == 0 || right.client_local_addr_len == 0 {
        return false;
    }
    return connection_slice_eq(
        left.client_local_addr[0: left.client_local_addr_len],
        right.client_local_addr[0: right.client_local_addr_len],
    );
}

fn connection_current_user_is_default(tx: &ConnectionTransaction) bool {
    return connection_keyword_eq(connection_current_username(tx), &"default"[0: 7]);
}

fn connection_clear_authenticated_user(tx: &ConnectionTransaction) void {
    if tx == null {
        return;
    }
    tx.username_len = 0;
    var i: usize = 0;
    while i < CONNECTION_ACL_USER_NAME_MAX {
        tx.username[i] = 0 as byte;
        i = i + 1;
    }
}

fn connection_acl_named_user_set_password(user: &ConnectionAclUser, password: &[byte]) !void {
    if password.len == 0 || password.len > CONNECTION_ACL_USER_PASSWORD_MAX {
        return error.ConnectionInputTooLarge;
    }
    connection_acl_hash_password(password, user.password_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
    user.password_hash_set = true;
    user.nopass = false;
}

fn connection_acl_named_user_set_password_hash(user: &ConnectionAclUser, hex: &[byte]) !void {
    try connection_acl_hash_from_hex(hex, user.password_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
    user.password_hash_set = true;
    user.nopass = false;
}

fn connection_acl_named_user_clear_password(user: &ConnectionAclUser) void {
    user.password_hash_set = false;
    connection_acl_bytes_clear(user.password_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
}

fn connection_acl_setuser_modifier_error(modifier: &[byte], suffix: &[byte]) CommandReply {
    var err: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&err);
    }
    _ = sds_cat(&err, &"ERR Error in ACL SETUSER modifier '"[0: 35]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&err, modifier) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&err, suffix) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_owned_error(err.buf[0: err.len]);
}

fn connection_acl_setuser_noop_modifier(modifier: &[byte]) bool {
    return connection_keyword_eq(modifier, &"ON"[0: 2]) ||
        connection_keyword_eq(modifier, &"NOPASS"[0: 6]) ||
        connection_keyword_eq(modifier, &"CLEARSELECTORS"[0: 14]) ||
        connection_keyword_eq(modifier, &"RESETSELECTORS"[0: 14]);
}

fn connection_acl_setuser_key_modifier_known(modifier: &[byte]) bool {
    if connection_keyword_eq(modifier, &"ALLKEYS"[0: 7]) ||
        connection_keyword_eq(modifier, &"RESETKEYS"[0: 9]) {
        return true;
    }
    return modifier.len > 1 && modifier.ptr[0] == 126 as byte;
}

fn connection_acl_setuser_channel_modifier_known(modifier: &[byte]) bool {
    if connection_keyword_eq(modifier, &"ALLCHANNELS"[0: 11]) ||
        connection_keyword_eq(modifier, &"RESETCHANNELS"[0: 13]) {
        return true;
    }
    return modifier.len > 1 && modifier.ptr[0] == 38 as byte;
}

fn connection_acl_key_patterns_apply_modifier(allkeys: &bool, patterns: &[ConnectionAclKeyPattern], modifier: &[byte]) CommandReply {
    if connection_keyword_eq(modifier, &"ALLKEYS"[0: 7]) || connection_keyword_eq(modifier, &"~*"[0: 2]) {
        *allkeys = true;
        connection_acl_key_patterns_clear(patterns);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    if connection_keyword_eq(modifier, &"RESETKEYS"[0: 9]) {
        *allkeys = false;
        connection_acl_key_patterns_clear(patterns);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    if modifier.len <= 1 || modifier.ptr[0] != 126 as byte {
        return connection_acl_setuser_modifier_error(modifier, &"': Syntax error"[0: 15]);
    }
    const pattern: &[byte] = modifier[1: modifier.len - 1];
    if pattern.len == 0 {
        return connection_acl_setuser_modifier_error(modifier, &"': Syntax error"[0: 15]);
    }
    if connection_slice_eq(pattern, &"*"[0: 1]) {
        *allkeys = true;
        connection_acl_key_patterns_clear(patterns);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    *allkeys = false;
    _ = connection_acl_key_pattern_add(patterns, pattern) catch {
        return connection_error_reply(&"ERR ACL SETUSER redis-uya partial key pattern list is full"[0: 58]);
    };
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_acl_channel_patterns_apply_modifier(allchannels: &bool, patterns: &[ConnectionAclChannelPattern], modifier: &[byte]) CommandReply {
    if connection_keyword_eq(modifier, &"ALLCHANNELS"[0: 11]) || connection_keyword_eq(modifier, &"&*"[0: 2]) {
        *allchannels = true;
        connection_acl_channel_patterns_clear(patterns);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    if connection_keyword_eq(modifier, &"RESETCHANNELS"[0: 13]) {
        *allchannels = false;
        connection_acl_channel_patterns_clear(patterns);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    if modifier.len <= 1 || modifier.ptr[0] != 38 as byte {
        return connection_acl_setuser_modifier_error(modifier, &"': Syntax error"[0: 15]);
    }
    const pattern: &[byte] = modifier[1: modifier.len - 1];
    if pattern.len == 0 {
        return connection_acl_setuser_modifier_error(modifier, &"': Syntax error"[0: 15]);
    }
    if connection_slice_eq(pattern, &"*"[0: 1]) {
        *allchannels = true;
        connection_acl_channel_patterns_clear(patterns);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    *allchannels = false;
    _ = connection_acl_channel_pattern_add(patterns, pattern) catch {
        return connection_error_reply(&"ERR ACL SETUSER redis-uya partial channel pattern list is full"[0: 62]);
    };
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_acl_setuser_mutating_modifier(modifier: &[byte]) bool {
    if connection_keyword_eq(modifier, &"OFF"[0: 3]) ||
        connection_keyword_eq(modifier, &"RESET"[0: 5]) ||
        connection_keyword_eq(modifier, &"RESETPASS"[0: 9]) {
        return true;
    }
    if modifier.len > 0 {
        const head: byte = modifier.ptr[0];
        return head == 62 as byte ||
            head == 60 as byte ||
            head == 35 as byte ||
            head == 33 as byte ||
            head == 37 as byte ||
            head == 40 as byte;
    }
    return false;
}

fn connection_acl_rule_command_name(router: &CommandRouter, name: &[byte]) !&[byte] {
    const info: CommandInfo = command_router_lookup(router, name) catch {
        if connection_keyword_eq(name, &"himport|prepare"[0: 15]) {
            return &"himport|prepare"[0: 15];
        }
        if connection_keyword_eq(name, &"himport|set"[0: 11]) {
            return &"himport|set"[0: 11];
        }
        if connection_keyword_eq(name, &"himport|discard"[0: 15]) {
            return &"himport|discard"[0: 15];
        }
        if connection_keyword_eq(name, &"himport|discardall"[0: 18]) {
            return &"himport|discardall"[0: 18];
        }
        if connection_acl_backup_child_name(name) {
            return name;
        }
        return error.CommandUnknown;
    };
    return info.name;
}

fn connection_acl_setuser_command_modifier(router: &CommandRouter, modifier: &[byte]) CommandReply {
    if modifier.len <= 1 {
        return connection_acl_setuser_modifier_error(modifier, &"': Syntax error"[0: 15]);
    }
    const op: byte = modifier.ptr[0];
    const command_name: &[byte] = modifier[1: modifier.len - 1];
    if command_name.len == 0 {
        return connection_acl_setuser_modifier_error(modifier, &"': Syntax error"[0: 15]);
    }
    if command_name.ptr[0] == 64 as byte {
        if op == 43 as byte && connection_keyword_eq(command_name, &"@all"[0: 4]) {
            connection_acl_default_denied_clear_all();
            connection_acl_default_categories_clear_all();
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        const category: &[byte] = command_name[1: command_name.len - 1];
        if !connection_acl_category_known(category) {
            return connection_acl_setuser_modifier_error(modifier, &"': Unknown command or category name in ACL"[0: 42]);
        }
        if op == 45 as byte {
            _ = connection_acl_default_category_add(category) catch {
                return connection_error_reply(&"ERR ACL SETUSER redis-uya partial category deny list is full"[0: 60]);
            };
        } else {
            connection_acl_default_category_remove(category);
        }
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    const normalized_name: &[byte] = connection_acl_rule_command_name(router, command_name) catch {
        return connection_acl_setuser_modifier_error(modifier, &"': Unknown command or category name in ACL"[0: 42]);
    };
    if op == 45 as byte {
        _ = connection_acl_default_denied_add(normalized_name) catch {
            return connection_error_reply(&"ERR ACL SETUSER redis-uya partial command deny list is full"[0: 59]);
        };
    } else {
        connection_acl_default_denied_remove(normalized_name);
    }
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_acl_setuser_named_allows_modifier(router: &CommandRouter, modifier: &[byte]) bool {
    if connection_acl_setuser_noop_modifier(modifier) ||
        connection_acl_setuser_key_modifier_known(modifier) ||
        connection_acl_setuser_channel_modifier_known(modifier) ||
        connection_keyword_eq(modifier, &"ALLCOMMANDS"[0: 11]) ||
        connection_keyword_eq(modifier, &"+@all"[0: 5]) ||
        connection_keyword_eq(modifier, &"RESETCOMMANDS"[0: 13]) {
        return true;
    }
    if modifier.len > 1 && (modifier.ptr[0] == 43 as byte || modifier.ptr[0] == 45 as byte) {
        const command_name: &[byte] = modifier[1: modifier.len - 1];
        if command_name.len == 0 {
            return false;
        }
        if command_name.ptr[0] == 64 as byte {
            const category: &[byte] = command_name[1: command_name.len - 1];
            return connection_acl_category_known(category);
        }
        _ = connection_acl_rule_command_name(router, command_name) catch {
            return false;
        };
        return true;
    }
    return false;
}

fn connection_acl_setuser_named_command_modifier(router: &CommandRouter, user: &ConnectionAclUser, modifier: &[byte]) CommandReply {
    if modifier.len <= 1 {
        return connection_acl_setuser_modifier_error(modifier, &"': Syntax error"[0: 15]);
    }
    const op: byte = modifier.ptr[0];
    const command_name: &[byte] = modifier[1: modifier.len - 1];
    if command_name.len == 0 {
        return connection_acl_setuser_modifier_error(modifier, &"': Syntax error"[0: 15]);
    }
    if command_name.ptr[0] == 64 as byte {
        const category: &[byte] = command_name[1: command_name.len - 1];
        if !connection_acl_category_known(category) {
            return connection_acl_setuser_modifier_error(modifier, &"': Unknown command or category name in ACL"[0: 42]);
        }
        if op == 45 as byte {
            _ = connection_acl_user_denied_category_add(user, category) catch {
                return connection_error_reply(&"ERR ACL SETUSER redis-uya partial named user category deny list is full"[0: 71]);
            };
        } else {
            connection_acl_user_denied_category_remove(user, category);
        }
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    const normalized_name: &[byte] = connection_acl_rule_command_name(router, command_name) catch {
        return connection_acl_setuser_modifier_error(modifier, &"': Unknown command or category name in ACL"[0: 42]);
    };
    if op == 45 as byte {
        _ = connection_acl_user_denied_command_add(user, normalized_name) catch {
            return connection_error_reply(&"ERR ACL SETUSER redis-uya partial named user command deny list is full"[0: 70]);
        };
    } else {
        connection_acl_user_denied_command_remove(user, normalized_name);
    }
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_acl_setuser_named(router: &CommandRouter, username: &[byte], command: &Command) CommandReply {
    var validate_index: usize = 3;
    while validate_index < command.argc {
        const validate_modifier: &[byte] = command_arg_data(command, validate_index) catch {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        };
        if connection_keyword_eq(validate_modifier, &"ON"[0: 2]) ||
            connection_keyword_eq(validate_modifier, &"OFF"[0: 3]) ||
            connection_keyword_eq(validate_modifier, &"NOPASS"[0: 6]) ||
            connection_keyword_eq(validate_modifier, &"RESETPASS"[0: 9]) ||
            connection_acl_setuser_named_allows_modifier(router, validate_modifier) {
            validate_index = validate_index + 1;
            continue;
        }
        if validate_modifier.len > 1 &&
            (validate_modifier.ptr[0] == 62 as byte || validate_modifier.ptr[0] == 60 as byte) {
            if validate_modifier.len - 1 > CONNECTION_ACL_USER_PASSWORD_MAX {
                return connection_acl_setuser_modifier_error(validate_modifier, &"': Password is too long"[0: 23]);
            }
            validate_index = validate_index + 1;
            continue;
        }
        if validate_modifier.len > 1 &&
            (validate_modifier.ptr[0] == 35 as byte || validate_modifier.ptr[0] == 33 as byte) {
            if !connection_acl_hash_hex_valid(validate_modifier[1: validate_modifier.len - 1]) {
                return connection_acl_setuser_modifier_error(validate_modifier, &"': The password hash must be exactly 64 characters and contain only lowercase hexadecimal characters"[0: 100]);
            }
            validate_index = validate_index + 1;
            continue;
        }
        if connection_acl_setuser_mutating_modifier(validate_modifier) {
            return connection_error_reply(&"ERR ACL SETUSER redis-uya partial only supports named user metadata modifiers"[0: 77]);
        }
        return connection_acl_setuser_modifier_error(validate_modifier, &"': Syntax error"[0: 15]);
    }

    const slot: usize = connection_acl_user_create_or_get(username) catch {
        return connection_error_reply(&"ERR ACL SETUSER redis-uya partial named user table is full or username is too long"[0: 82]);
    };
    if slot >= CONNECTION_ACL_USER_MAX {
        return connection_error_reply(&"ERR ACL SETUSER redis-uya partial named user table is full or username is too long"[0: 82]);
    }

    var index: usize = 3;
    while index < command.argc {
        const modifier: &[byte] = command_arg_data(command, index) catch {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        };
        if connection_keyword_eq(modifier, &"ON"[0: 2]) {
            connection_acl_users[slot].enabled = true;
            index = index + 1;
            continue;
        }
        if connection_keyword_eq(modifier, &"OFF"[0: 3]) {
            connection_acl_users[slot].enabled = false;
            index = index + 1;
            continue;
        }
        if connection_keyword_eq(modifier, &"NOPASS"[0: 6]) {
            connection_acl_users[slot].nopass = true;
            connection_acl_named_user_clear_password(&connection_acl_users[slot]);
            index = index + 1;
            continue;
        }
        if connection_keyword_eq(modifier, &"RESETPASS"[0: 9]) {
            connection_acl_users[slot].nopass = false;
            connection_acl_named_user_clear_password(&connection_acl_users[slot]);
            index = index + 1;
            continue;
        }
        if connection_acl_setuser_key_modifier_known(modifier) {
            const reply: CommandReply = connection_acl_key_patterns_apply_modifier(&connection_acl_users[slot].allkeys, connection_acl_users[slot].key_patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX], modifier);
            if reply.typ == CommandReplyType.reply_error {
                return reply;
            }
            command_reply_cleanup(&reply);
            index = index + 1;
            continue;
        }
        if connection_acl_setuser_channel_modifier_known(modifier) {
            const reply: CommandReply = connection_acl_channel_patterns_apply_modifier(&connection_acl_users[slot].allchannels, connection_acl_users[slot].channel_patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX], modifier);
            if reply.typ == CommandReplyType.reply_error {
                return reply;
            }
            command_reply_cleanup(&reply);
            index = index + 1;
            continue;
        }
        if connection_keyword_eq(modifier, &"ALLCOMMANDS"[0: 11]) ||
            connection_keyword_eq(modifier, &"+@all"[0: 5]) ||
            connection_keyword_eq(modifier, &"RESETCOMMANDS"[0: 13]) {
            connection_acl_user_clear_rules(&connection_acl_users[slot]);
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && modifier.ptr[0] == 62 as byte {
            const password: &[byte] = modifier[1: modifier.len - 1];
            _ = connection_acl_named_user_set_password(&connection_acl_users[slot], password) catch {
                return connection_acl_setuser_modifier_error(modifier, &"': Password is too long"[0: 23]);
            };
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && modifier.ptr[0] == 35 as byte {
            _ = connection_acl_named_user_set_password_hash(&connection_acl_users[slot], modifier[1: modifier.len - 1]) catch {
                return connection_acl_setuser_modifier_error(modifier, &"': The password hash must be exactly 64 characters and contain only lowercase hexadecimal characters"[0: 100]);
            };
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && modifier.ptr[0] == 60 as byte {
            const remove_password: &[byte] = modifier[1: modifier.len - 1];
            if connection_acl_users[slot].password_hash_set &&
                connection_acl_hash_matches_password(connection_acl_users[slot].password_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], remove_password) {
                connection_acl_named_user_clear_password(&connection_acl_users[slot]);
                connection_acl_users[slot].nopass = false;
            } else {
                return connection_acl_setuser_modifier_error(modifier, &"': The password you are trying to remove from the user does not exist"[0: 69]);
            }
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && modifier.ptr[0] == 33 as byte {
            var remove_hash: [byte: CONNECTION_ACL_PASSWORD_HASH_BYTES] = [];
            _ = connection_acl_hash_from_hex(modifier[1: modifier.len - 1], remove_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]) catch {
                return connection_acl_setuser_modifier_error(modifier, &"': The password hash must be exactly 64 characters and contain only lowercase hexadecimal characters"[0: 100]);
            };
            if connection_acl_users[slot].password_hash_set &&
                connection_acl_hash_matches_hash(connection_acl_users[slot].password_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], remove_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]) {
                connection_acl_named_user_clear_password(&connection_acl_users[slot]);
                connection_acl_users[slot].nopass = false;
            } else {
                return connection_acl_setuser_modifier_error(modifier, &"': The password you are trying to remove from the user does not exist"[0: 69]);
            }
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && (modifier.ptr[0] == 43 as byte || modifier.ptr[0] == 45 as byte) {
            const reply: CommandReply = connection_acl_setuser_named_command_modifier(router, &connection_acl_users[slot], modifier);
            if reply.typ == CommandReplyType.reply_error {
                return reply;
            }
            command_reply_cleanup(&reply);
            index = index + 1;
            continue;
        }
        index = index + 1;
    }
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_acl_handle_setuser(runtime: &CommandRuntimeInfo, router: &CommandRouter, command: &Command) CommandReply {
    if command.argc < 3 {
        return connection_error_reply(&"ERR wrong number of arguments for 'acl|setuser' command"[0: 55]);
    }
    const username: &[byte] = command_arg_data(command, 2) catch {
        return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
    };
    if !connection_keyword_eq(username, &"default"[0: 7]) {
        return connection_acl_setuser_named(router, username, command);
    }

    runtime.pending_config = runtime.config;
    var index: usize = 3;
    while index < command.argc {
        const modifier: &[byte] = command_arg_data(command, index) catch {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        };
        if connection_keyword_eq(modifier, &"NOPASS"[0: 6]) ||
            connection_keyword_eq(modifier, &"RESETPASS"[0: 9]) {
            runtime.pending_config.requirepass_hash_set = false;
            connection_acl_bytes_clear(runtime.pending_config.requirepass[0: 128]);
            connection_acl_bytes_clear(runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && modifier.ptr[0] == 62 as byte {
            const password: &[byte] = modifier[1: modifier.len - 1];
            if password.len > 127 {
                return connection_acl_setuser_modifier_error(modifier, &"': Password is too long"[0: 23]);
            }
            connection_acl_hash_password(password, runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
            connection_acl_bytes_clear(runtime.pending_config.requirepass[0: 128]);
            runtime.pending_config.requirepass_hash_set = true;
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && modifier.ptr[0] == 35 as byte {
            if !connection_acl_hash_hex_valid(modifier[1: modifier.len - 1]) {
                return connection_acl_setuser_modifier_error(modifier, &"': The password hash must be exactly 64 characters and contain only lowercase hexadecimal characters"[0: 100]);
            }
            _ = connection_acl_hash_from_hex(modifier[1: modifier.len - 1], runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]) catch {
                return connection_acl_setuser_modifier_error(modifier, &"': The password hash must be exactly 64 characters and contain only lowercase hexadecimal characters"[0: 100]);
            };
            connection_acl_bytes_clear(runtime.pending_config.requirepass[0: 128]);
            runtime.pending_config.requirepass_hash_set = true;
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && modifier.ptr[0] == 60 as byte {
            const remove_password: &[byte] = modifier[1: modifier.len - 1];
            const current_password: &[byte] = connection_cstring_slice(runtime.pending_config.requirepass[0: 128]);
            if connection_slice_eq(remove_password, current_password) {
                connection_acl_bytes_clear(runtime.pending_config.requirepass[0: 128]);
                runtime.pending_config.requirepass_hash_set = false;
                connection_acl_bytes_clear(runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
            } else if runtime.pending_config.requirepass_hash_set &&
                connection_acl_hash_matches_password(runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], remove_password) {
                runtime.pending_config.requirepass_hash_set = false;
                connection_acl_bytes_clear(runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
            } else {
                return connection_acl_setuser_modifier_error(modifier, &"': The password you are trying to remove from the user does not exist"[0: 69]);
            }
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && modifier.ptr[0] == 33 as byte {
            if !connection_acl_hash_hex_valid(modifier[1: modifier.len - 1]) {
                return connection_acl_setuser_modifier_error(modifier, &"': The password hash must be exactly 64 characters and contain only lowercase hexadecimal characters"[0: 100]);
            }
            var remove_hash: [byte: CONNECTION_ACL_PASSWORD_HASH_BYTES] = [];
            _ = connection_acl_hash_from_hex(modifier[1: modifier.len - 1], remove_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]) catch {
                return connection_acl_setuser_modifier_error(modifier, &"': The password hash must be exactly 64 characters and contain only lowercase hexadecimal characters"[0: 100]);
            };
            if runtime.pending_config.requirepass_hash_set &&
                connection_acl_hash_matches_hash(runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], remove_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]) {
                runtime.pending_config.requirepass_hash_set = false;
                connection_acl_bytes_clear(runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
            } else {
                return connection_acl_setuser_modifier_error(modifier, &"': The password you are trying to remove from the user does not exist"[0: 69]);
            }
            index = index + 1;
            continue;
        }
        if connection_acl_setuser_noop_modifier(modifier) {
            index = index + 1;
            continue;
        }
        if connection_acl_setuser_key_modifier_known(modifier) {
            const reply: CommandReply = connection_acl_key_patterns_apply_modifier(&connection_acl_default_key_rules.allkeys, connection_acl_default_key_rules.patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX], modifier);
            if reply.typ == CommandReplyType.reply_error {
                return reply;
            }
            command_reply_cleanup(&reply);
            index = index + 1;
            continue;
        }
        if connection_acl_setuser_channel_modifier_known(modifier) {
            const reply: CommandReply = connection_acl_channel_patterns_apply_modifier(&connection_acl_default_channel_rules.allchannels, connection_acl_default_channel_rules.patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX], modifier);
            if reply.typ == CommandReplyType.reply_error {
                return reply;
            }
            command_reply_cleanup(&reply);
            index = index + 1;
            continue;
        }
        if connection_keyword_eq(modifier, &"ALLCOMMANDS"[0: 11]) ||
            connection_keyword_eq(modifier, &"+@all"[0: 5]) {
            connection_acl_default_denied_clear_all();
            connection_acl_default_categories_clear_all();
            index = index + 1;
            continue;
        }
        if connection_keyword_eq(modifier, &"RESETCOMMANDS"[0: 13]) {
            connection_acl_default_denied_clear_all();
            connection_acl_default_categories_clear_all();
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && (modifier.ptr[0] == 43 as byte || modifier.ptr[0] == 45 as byte) {
            const reply: CommandReply = connection_acl_setuser_command_modifier(router, modifier);
            if reply.typ == CommandReplyType.reply_error {
                return reply;
            }
            command_reply_cleanup(&reply);
            index = index + 1;
            continue;
        }
        if connection_acl_setuser_mutating_modifier(modifier) {
            return connection_error_reply(&"ERR ACL SETUSER redis-uya partial only supports default command allow/deny modifiers"[0: 84]);
        }
        return connection_acl_setuser_modifier_error(modifier, &"': Syntax error"[0: 15]);
    }
    var reply: CommandReply = connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    reply.request_config_set = true;
    return reply;
}

fn connection_acl_dryrun_user_missing(username: &[byte]) CommandReply {
    var err: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&err);
    }
    _ = sds_cat(&err, &"ERR User '"[0: 10]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&err, username) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&err, &"' not found"[0: 11]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_owned_error(err.buf[0: err.len]);
}

fn connection_acl_dryrun_command_missing(name: &[byte]) CommandReply {
    var err: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&err);
    }
    _ = sds_cat(&err, &"ERR Command '"[0: 13]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&err, name) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&err, &"' not found"[0: 11]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_owned_error(err.buf[0: err.len]);
}

fn connection_acl_dryrun_arity_error(name: &[byte]) CommandReply {
    var err: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&err);
    }
    _ = sds_cat(&err, &"ERR wrong number of arguments for '"[0: 35]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&err, name) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&err, &"' command"[0: 9]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_owned_error(err.buf[0: err.len]);
}

fn connection_acl_handle_dryrun(router: &CommandRouter, command: &Command, now_ms: u64, client_id: i64) CommandReply {
    if command.argc < 4 {
        return connection_error_reply(&"ERR wrong number of arguments for 'acl|dryrun' command"[0: 54]);
    }
    const username: &[byte] = command_arg_data(command, 2) catch {
        return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
    };
    const is_default_user: bool = connection_keyword_eq(username, &"default"[0: 7]);
    if !is_default_user && connection_acl_user_find(username) < 0 {
        return connection_acl_dryrun_user_missing(username);
    }
    const dry_command_name: &[byte] = command_arg_data(command, 3) catch {
        return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
    };
    var dry_info: CommandInfo = command_router_lookup(router, dry_command_name) catch {
        return connection_acl_dryrun_command_missing(dry_command_name);
    };
    _ = command_validate_arity(&dry_info, command.argc - 3) catch {
        return connection_acl_dryrun_arity_error(dry_info.name);
    };
    if connection_acl_user_command_denied(username, dry_info.name) {
        return connection_acl_permission_denied_reply_for_user(dry_info.name, &"dryrun"[0: 6], username, now_ms, client_id);
    }
    if dry_info.first_key > 0 && dry_info.key_step > 0 &&
        connection_acl_user_allkeys(username) == false &&
        connection_acl_user_command_key_denied(username, &dry_info, command, 3, command.argc - 3) {
        return connection_acl_key_permission_denied_reply_for_user(dry_info.name, &"dryrun"[0: 6], username, now_ms, client_id);
    }
    if connection_acl_user_allchannels(username) == false &&
        connection_acl_user_command_channel_denied(username, &dry_info, command, 3, command.argc - 3) {
        return connection_acl_channel_permission_denied_reply_for_user(dry_info.name, &"dryrun"[0: 6], username, now_ms, client_id);
    }
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_acl_append_named_config_line(raw: &Sds, user: &ConnectionAclUser) !void {
    try sds_cat(raw, &"user "[0: 5]);
    try sds_cat(raw, user.name[0: user.name_len]);
    if user.enabled {
        try sds_cat(raw, &" on "[0: 4]);
    } else {
        try sds_cat(raw, &" off "[0: 5]);
    }
    if user.nopass {
        try sds_cat(raw, &"nopass"[0: 6]);
    } else if user.password_hash_set {
        var password_marker: [byte: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1] = [];
        const password_marker_len: usize = connection_acl_hash_marker(user.password_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], password_marker[0: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1]);
        if password_marker_len > 0 {
            try sds_cat(raw, password_marker[0: password_marker_len]);
        }
    }
    try sds_cat(raw, &" "[0: 1]);
    try connection_acl_append_key_rules(raw, user.allkeys, user.key_patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]);
    try sds_cat(raw, &" "[0: 1]);
    try connection_acl_append_channel_rules(raw, user.allchannels, user.channel_patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]);
    try sds_cat(raw, &" "[0: 1]);
    try connection_acl_append_named_command_rules(raw, user);
}

fn connection_acl_handle_list(runtime: &CommandRuntimeInfo) CommandReply {
    var line: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&line);
    }
    _ = sds_cat(&line, &"user default on "[0: 16]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    var password_marker: [byte: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1] = [];
    const password_marker_len: usize = connection_acl_default_password_marker(runtime, password_marker[0: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1]);
    if password_marker_len > 0 {
        _ = sds_cat(&line, password_marker[0: password_marker_len]) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    } else {
        _ = sds_cat(&line, &"nopass"[0: 6]) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    _ = sds_cat(&line, &" "[0: 1]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_acl_append_key_rules(&line, connection_acl_default_key_rules.allkeys, connection_acl_default_key_rules.patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&line, &" "[0: 1]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_acl_append_channel_rules(&line, connection_acl_default_channel_rules.allchannels, connection_acl_default_channel_rules.patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&line, &" "[0: 1]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_acl_append_default_command_rules(&line) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    var reply_list: &RedisObject = create_list_object() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, line.buf[0: line.len]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    var count: usize = 1;
    var index: usize = 0;
    while index < CONNECTION_ACL_USER_MAX {
        if connection_acl_users[index].active {
            var named_line: Sds = sds_empty() catch {
                object_free(reply_list);
                return connection_error_reply(&"ERR out of memory"[0: 17]);
            };
            _ = connection_acl_append_named_config_line(&named_line, &connection_acl_users[index]) catch {
                sds_free(&named_line);
                object_free(reply_list);
                return connection_error_reply(&"ERR out of memory"[0: 17]);
            };
            _ = list_object_push_tail(reply_list, named_line.buf[0: named_line.len]) catch {
                sds_free(&named_line);
                object_free(reply_list);
                return connection_error_reply(&"ERR out of memory"[0: 17]);
            };
            sds_free(&named_line);
            count = count + 1;
        }
        index = index + 1;
    }
    return connection_array_reply_owned(reply_list, count);
}

fn connection_acl_getuser_named(user: &ConnectionAclUser) CommandReply {
    var rules: Sds = connection_acl_named_command_rules_sds(user) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&rules);
    }
    var key_rules: Sds = connection_acl_key_rules_sds(user.allkeys, user.key_patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&key_rules);
    }
    var channel_rules: Sds = connection_acl_channel_rules_sds(user.allchannels, user.channel_patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&channel_rules);
    }
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    _ = connection_sds_append_resp_array_header(&raw, 12) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, &"flags"[0: 5]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    if user.nopass {
        _ = connection_sds_append_resp_array_header(&raw, 2) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    } else {
        _ = connection_sds_append_resp_array_header(&raw, 1) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    if user.enabled {
        _ = connection_sds_append_resp_bulk(&raw, &"on"[0: 2]) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    } else {
        _ = connection_sds_append_resp_bulk(&raw, &"off"[0: 3]) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    if user.nopass {
        _ = connection_sds_append_resp_bulk(&raw, &"nopass"[0: 6]) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    _ = connection_sds_append_resp_bulk(&raw, &"passwords"[0: 9]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    if user.password_hash_set {
        var password_marker: [byte: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1] = [];
        const password_marker_len: usize = connection_acl_hash_marker(user.password_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], password_marker[0: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1]);
        _ = connection_sds_append_resp_array_header(&raw, 1) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
        _ = connection_sds_append_resp_bulk(&raw, password_marker[0: password_marker_len]) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    } else {
        _ = connection_sds_append_resp_array_header(&raw, 0) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    _ = connection_sds_append_resp_bulk(&raw, &"commands"[0: 8]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, rules.buf[0: rules.len]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, &"keys"[0: 4]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, key_rules.buf[0: key_rules.len]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, &"channels"[0: 8]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, channel_rules.buf[0: channel_rules.len]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, &"selectors"[0: 9]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_array_header(&raw, 0) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_raw_reply_owned(raw.buf[0: raw.len]);
}

fn connection_acl_handle_getuser(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    if command.argc != 3 {
        return connection_error_reply(&"ERR wrong number of arguments for 'acl|getuser' command"[0: 55]);
    }
    const username: &[byte] = command_arg_data(command, 2) catch {
        return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
    };
    if !connection_keyword_eq(username, &"default"[0: 7]) {
        const slot: i32 = connection_acl_user_find(username);
        if slot >= 0 {
            return connection_acl_getuser_named(&connection_acl_users[slot as usize]);
        }
        return connection_make_reply(CommandReplyType.reply_null_bulk, connection_reply_empty_slice(), 0);
    }

    var rules: Sds = connection_acl_default_command_rules_sds() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&rules);
    }
    var key_rules: Sds = connection_acl_key_rules_sds(connection_acl_default_key_rules.allkeys, connection_acl_default_key_rules.patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&key_rules);
    }
    var channel_rules: Sds = connection_acl_channel_rules_sds(connection_acl_default_channel_rules.allchannels, connection_acl_default_channel_rules.patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&channel_rules);
    }
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    var password_marker: [byte: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1] = [];
    const password_marker_len: usize = connection_acl_default_password_marker(runtime, password_marker[0: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1]);
    _ = connection_sds_append_resp_array_header(&raw, 12) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, &"flags"[0: 5]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    if password_marker_len > 0 {
        _ = connection_sds_append_resp_array_header(&raw, 1) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    } else {
        _ = connection_sds_append_resp_array_header(&raw, 2) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    _ = connection_sds_append_resp_bulk(&raw, &"on"[0: 2]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    if password_marker_len == 0 {
        _ = connection_sds_append_resp_bulk(&raw, &"nopass"[0: 6]) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    _ = connection_sds_append_resp_bulk(&raw, &"passwords"[0: 9]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    if password_marker_len > 0 {
        _ = connection_sds_append_resp_array_header(&raw, 1) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
        _ = connection_sds_append_resp_bulk(&raw, password_marker[0: password_marker_len]) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    } else {
        _ = connection_sds_append_resp_array_header(&raw, 0) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    _ = connection_sds_append_resp_bulk(&raw, &"commands"[0: 8]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, rules.buf[0: rules.len]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, &"keys"[0: 4]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, key_rules.buf[0: key_rules.len]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, &"channels"[0: 8]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, channel_rules.buf[0: channel_rules.len]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_bulk(&raw, &"selectors"[0: 9]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = connection_sds_append_resp_array_header(&raw, 0) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_raw_reply_owned(raw.buf[0: raw.len]);
}

fn connection_acl_handle_users(command: &Command) CommandReply {
    if command.argc != 2 {
        return connection_error_reply(&"ERR wrong number of arguments for 'acl|users' command"[0: 53]);
    }
    var reply_list: &RedisObject = create_list_object() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"default"[0: 7]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    var count: usize = 1;
    var index: usize = 0;
    while index < CONNECTION_ACL_USER_MAX {
        if connection_acl_users[index].active {
            _ = list_object_push_tail(reply_list, connection_acl_users[index].name[0: connection_acl_users[index].name_len]) catch {
                object_free(reply_list);
                return connection_error_reply(&"ERR out of memory"[0: 17]);
            };
            count = count + 1;
        }
        index = index + 1;
    }
    return connection_array_reply_owned(reply_list, count);
}

fn connection_acl_handle_deluser(command: &Command) CommandReply {
    if command.argc < 3 {
        return connection_error_reply(&"ERR wrong number of arguments for 'acl|deluser' command"[0: 55]);
    }
    var scan_index: usize = 2;
    while scan_index < command.argc {
        const username_scan: &[byte] = command_arg_data(command, scan_index) catch {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        };
        if connection_keyword_eq(username_scan, &"default"[0: 7]) {
            return connection_error_reply(&"ERR The 'default' user cannot be removed"[0: 40]);
        }
        scan_index = scan_index + 1;
    }

    var deleted: i64 = 0;
    var index: usize = 2;
    while index < command.argc {
        const username: &[byte] = command_arg_data(command, index) catch {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        };
        if connection_acl_user_delete(username) {
            deleted = deleted + 1;
        }
        index = index + 1;
    }
    return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), deleted);
}

fn connection_acl_log_requested_count(command: &Command) !usize {
    if command.argc == 2 {
        return 10usize;
    }
    const arg: &[byte] = command_arg_data(command, 2) catch {
        return error.ConnectionInputTooLarge;
    };
    if arg.len == 0 || arg.ptr[0] == 45 as byte {
        return error.ConnectionInputTooLarge;
    }
    const parsed: u64 = connection_parse_u64(arg) catch {
        return error.ConnectionInputTooLarge;
    };
    if parsed > CONNECTION_ACL_LOG_MAX as u64 {
        return CONNECTION_ACL_LOG_MAX;
    }
    return parsed as usize;
}

fn connection_acl_log_append_client_info(raw: &Sds, entry: &ConnectionAclLogEntry) !void {
    var client_info: Sds = try sds_empty();
    defer {
        sds_free(&client_info);
    }
    try sds_cat(&client_info, &"id="[0: 3]);
    try connection_sds_append_i64(&client_info, entry.client_id);
    try sds_cat(&client_info, &" addr="[0: 6]);
    if entry.client_addr_len > 0 {
        try sds_cat(&client_info, entry.client_addr[0: entry.client_addr_len]);
    } else {
        try sds_cat(&client_info, &"unknown"[0: 7]);
    }
    try sds_cat(&client_info, &" laddr="[0: 7]);
    if entry.client_local_addr_len > 0 {
        try sds_cat(&client_info, entry.client_local_addr[0: entry.client_local_addr_len]);
    } else {
        try sds_cat(&client_info, &"unknown"[0: 7]);
    }
    try connection_sds_append_resp_bulk(raw, client_info.buf[0: client_info.len]);
}

fn connection_acl_log_append_entry(raw: &Sds, entry: &ConnectionAclLogEntry, now_ms: u64) !void {
    var age_seconds: u64 = 0u64;
    if now_ms >= entry.created_ms {
        age_seconds = (now_ms - entry.created_ms) / 1000u64;
    }
    const timestamp_seconds: u64 = entry.created_ms / 1000u64;
    try connection_sds_append_resp_array_header(raw, 20);
    try connection_sds_append_resp_bulk(raw, &"reason"[0: 6]);
    try connection_sds_append_resp_bulk(raw, &"command"[0: 7]);
    try connection_sds_append_resp_bulk(raw, &"context"[0: 7]);
    try connection_sds_append_resp_bulk(raw, entry.context[0: entry.context_len]);
    try connection_sds_append_resp_bulk(raw, &"object"[0: 6]);
    try connection_sds_append_resp_bulk(raw, entry.command[0: entry.command_len]);
    try connection_sds_append_resp_bulk(raw, &"username"[0: 8]);
    if entry.username_len > 0 {
        try connection_sds_append_resp_bulk(raw, entry.username[0: entry.username_len]);
    } else {
        try connection_sds_append_resp_bulk(raw, &"default"[0: 7]);
    }
    try connection_sds_append_resp_bulk(raw, &"age-seconds"[0: 11]);
    try connection_sds_append_resp_integer(raw, age_seconds as i64);
    try connection_sds_append_resp_bulk(raw, &"client-info"[0: 11]);
    try connection_acl_log_append_client_info(raw, entry);
    try connection_sds_append_resp_bulk(raw, &"entry-id"[0: 8]);
    try connection_sds_append_resp_integer(raw, entry.sequence as i64);
    try connection_sds_append_resp_bulk(raw, &"timestamp-created"[0: 17]);
    try connection_sds_append_resp_integer(raw, timestamp_seconds as i64);
    try connection_sds_append_resp_bulk(raw, &"timestamp-last-updated"[0: 22]);
    try connection_sds_append_resp_integer(raw, timestamp_seconds as i64);
    try connection_sds_append_resp_bulk(raw, &"count"[0: 5]);
    try connection_sds_append_resp_integer(raw, entry.count as i64);
}

fn connection_acl_handle_log(command: &Command, now_ms: u64) CommandReply {
    if command.argc == 3 {
        const arg: &[byte] = command_arg_data(command, 2) catch {
            return connection_error_reply(&"ERR unknown subcommand or wrong number of arguments for 'log'. Try ACL HELP."[0: 76]);
        };
        if connection_keyword_eq(arg, &"RESET"[0: 5]) {
            connection_acl_log_clear_all();
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
    }
    if command.argc > 3 {
        return connection_error_reply(&"ERR unknown subcommand or wrong number of arguments for 'log'. Try ACL HELP."[0: 76]);
    }
    const requested: usize = connection_acl_log_requested_count(command) catch {
        return connection_error_reply(&"ERR value is not an integer or out of range"[0: 43]);
    };
    var limit: usize = requested;
    if limit > connection_acl_log_count {
        limit = connection_acl_log_count;
    }

    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    _ = connection_sds_append_resp_array_header(&raw, limit) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    var emitted: usize = 0;
    var scanned: usize = 0;
    var slot_index: usize = 0;
    if connection_acl_log_next_index == 0 {
        slot_index = CONNECTION_ACL_LOG_MAX - 1;
    } else {
        slot_index = connection_acl_log_next_index - 1;
    }
    while emitted < limit && scanned < CONNECTION_ACL_LOG_MAX {
        if connection_acl_log_entries[slot_index].active {
            _ = connection_acl_log_append_entry(&raw, &connection_acl_log_entries[slot_index], now_ms) catch {
                return connection_error_reply(&"ERR out of memory"[0: 17]);
            };
            emitted = emitted + 1;
        }
        scanned = scanned + 1;
        if slot_index == 0 {
            slot_index = CONNECTION_ACL_LOG_MAX - 1;
        } else {
            slot_index = slot_index - 1;
        }
    }
    return connection_raw_reply_owned(raw.buf[0: raw.len]);
}

fn connection_acl_file_cstring_slice(data: &[byte]) &[byte] {
    var len: usize = 0;
    while len < data.len && data.ptr[len] != 0 as byte {
        len = len + 1;
    }
    return data[0: len];
}

fn connection_acl_file_append_path(dst: &[byte], pos: &usize, part: &[byte]) !void {
    if *pos + part.len >= dst.len {
        return error.ConnectionAclFilePathTooLong;
    }
    var i: usize = 0;
    while i < part.len {
        dst.ptr[*pos + i] = part.ptr[i];
        i = i + 1;
    }
    *pos = *pos + part.len;
}

fn connection_acl_file_has_sep(path: &[byte]) bool {
    var i: usize = 0;
    while i < path.len {
        if path.ptr[i] == 47 as byte {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn connection_acl_file_path(runtime: &CommandRuntimeInfo, out: &[byte]) !void {
    const aclfile: &[byte] = connection_acl_file_cstring_slice(runtime.config.aclfile[0: 256]);
    if aclfile.len == 0 {
        return error.ConnectionAclFileUnconfigured;
    }
    var pos: usize = 0;
    if connection_acl_file_has_sep(aclfile) {
        try connection_acl_file_append_path(out, &pos, aclfile);
    } else {
        const dir: &[byte] = connection_acl_file_cstring_slice(runtime.config.dir[0: 256]);
        try connection_acl_file_append_path(out, &pos, dir);
        if pos > 0 && out.ptr[pos - 1] != 47 as byte {
            try connection_acl_file_append_path(out, &pos, &"/"[0: 1]);
        }
        try connection_acl_file_append_path(out, &pos, aclfile);
    }
    out.ptr[pos] = 0 as byte;
}

fn connection_acl_file_write_all(file: &File, data: &[byte]) !void {
    var written: usize = 0;
    while written < data.len {
        const ptr: &const byte = @ptr_from_usize(@usize_from_ptr(data.ptr as &void) + written) as &const byte;
        const count: usize = file_write(file, ptr, data.len - written) catch {
            return error.ConnectionAclFileWriteFailed;
        };
        if count == 0 {
            return error.ConnectionAclFileWriteFailed;
        }
        written = written + count;
    }
}

fn connection_acl_file_token_safe(token: &[byte]) bool {
    var index: usize = 0;
    while index < token.len {
        const ch: byte = token.ptr[index];
        if ch <= 32 as byte || ch == 127 as byte {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn connection_acl_file_key_rules_safe(patterns: &[ConnectionAclKeyPattern]) bool {
    var index: usize = 0;
    while index < patterns.len {
        if patterns.ptr[index].active &&
            !connection_acl_file_token_safe(patterns.ptr[index].pattern[0: patterns.ptr[index].pattern_len]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn connection_acl_file_channel_rules_safe(patterns: &[ConnectionAclChannelPattern]) bool {
    var index: usize = 0;
    while index < patterns.len {
        if patterns.ptr[index].active &&
            !connection_acl_file_token_safe(patterns.ptr[index].pattern[0: patterns.ptr[index].pattern_len]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn connection_acl_append_default_file_line(raw: &Sds, runtime: &CommandRuntimeInfo) !void {
    if !connection_acl_file_key_rules_safe(connection_acl_default_key_rules.patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]) ||
        !connection_acl_file_channel_rules_safe(connection_acl_default_channel_rules.patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]) {
        return error.ConnectionAclFileInvalid;
    }
    try sds_cat(raw, &"user default on "[0: 16]);
    var password_marker: [byte: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1] = [];
    const password_marker_len: usize = connection_acl_default_password_marker(runtime, password_marker[0: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1]);
    if password_marker_len > 0 {
        try sds_cat(raw, password_marker[0: password_marker_len]);
    } else {
        try sds_cat(raw, &"nopass"[0: 6]);
    }
    try sds_cat(raw, &" "[0: 1]);
    try connection_acl_append_key_rules(raw, connection_acl_default_key_rules.allkeys, connection_acl_default_key_rules.patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]);
    try sds_cat(raw, &" "[0: 1]);
    try connection_acl_append_channel_rules(raw, connection_acl_default_channel_rules.allchannels, connection_acl_default_channel_rules.patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]);
    try sds_cat(raw, &" "[0: 1]);
    try connection_acl_append_default_command_rules(raw);
    try sds_cat(raw, &"\n"[0: 1]);
}

fn connection_acl_append_named_file_line(raw: &Sds, user: &ConnectionAclUser) !void {
    if !connection_acl_file_token_safe(user.name[0: user.name_len]) ||
        !connection_acl_file_key_rules_safe(user.key_patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]) ||
        !connection_acl_file_channel_rules_safe(user.channel_patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]) {
        return error.ConnectionAclFileInvalid;
    }
    try sds_cat(raw, &"user "[0: 5]);
    try sds_cat(raw, user.name[0: user.name_len]);
    if user.enabled {
        try sds_cat(raw, &" on "[0: 4]);
    } else {
        try sds_cat(raw, &" off "[0: 5]);
    }
    if user.nopass {
        try sds_cat(raw, &"nopass"[0: 6]);
    } else if user.password_hash_set {
        var password_marker: [byte: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1] = [];
        const password_marker_len: usize = connection_acl_hash_marker(user.password_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], password_marker[0: CONNECTION_ACL_PASSWORD_HASH_HEX_BYTES + 1]);
        try sds_cat(raw, password_marker[0: password_marker_len]);
    } else {
        try sds_cat(raw, &"resetpass"[0: 9]);
    }
    try sds_cat(raw, &" "[0: 1]);
    try connection_acl_append_key_rules(raw, user.allkeys, user.key_patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]);
    try sds_cat(raw, &" "[0: 1]);
    try connection_acl_append_channel_rules(raw, user.allchannels, user.channel_patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]);
    try sds_cat(raw, &" "[0: 1]);
    try connection_acl_append_named_command_rules(raw, user);
    try sds_cat(raw, &"\n"[0: 1]);
}

fn connection_acl_file_payload(runtime: &CommandRuntimeInfo) !Sds {
    var raw: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    _ = connection_acl_append_default_file_line(&raw, runtime) catch |err| {
        sds_free(&raw);
        return err;
    };
    var index: usize = 0;
    while index < CONNECTION_ACL_USER_MAX {
        if connection_acl_users[index].active {
            _ = connection_acl_append_named_file_line(&raw, &connection_acl_users[index]) catch |err| {
                sds_free(&raw);
                return err;
            };
        }
        index = index + 1;
    }
    return raw;
}

export fn connection_acl_save_file(runtime: &CommandRuntimeInfo) !void {
    var path: [byte: CONNECTION_ACL_FILE_PATH_MAX] = [];
    try connection_acl_file_path(runtime, path[0: CONNECTION_ACL_FILE_PATH_MAX]);
    var tmp_path: [byte: CONNECTION_ACL_FILE_PATH_MAX] = [];
    const path_slice: &[byte] = connection_acl_file_cstring_slice(path[0: CONNECTION_ACL_FILE_PATH_MAX]);
    var tmp_pos: usize = 0;
    try connection_acl_file_append_path(tmp_path[0: CONNECTION_ACL_FILE_PATH_MAX], &tmp_pos, path_slice);
    try connection_acl_file_append_path(tmp_path[0: CONNECTION_ACL_FILE_PATH_MAX], &tmp_pos, &".tmp"[0: 4]);
    tmp_path[tmp_pos] = 0 as byte;
    _ = unlink(&tmp_path[0] as &const byte);

    var payload: Sds = try connection_acl_file_payload(runtime);
    defer {
        sds_free(&payload);
    }
    var success: bool = false;
    defer {
        if !success {
            _ = unlink(&tmp_path[0] as &const byte);
        }
    }
    var file: File = file_open(&tmp_path[0] as &const byte, (O_WRONLY | O_CREAT | O_EXCL | O_TRUNC) as i32, 0o600u32) catch {
        return error.ConnectionAclFileOpenFailed;
    };
    defer {
        _ = file_close(&file) catch {};
    }
    try connection_acl_file_write_all(&file, payload.buf[0: payload.len]);
    _ = file_close(&file) catch {
        return error.ConnectionAclFileWriteFailed;
    };
    if rename(&tmp_path[0] as &const byte, &path[0] as &const byte) != 0 {
        return error.ConnectionAclFileRenameFailed;
    }
    success = true;
}

fn connection_acl_load_snapshot(runtime: &CommandRuntimeInfo) void {
    var command_index: usize = 0;
    while command_index < CONNECTION_ACL_DENIED_COMMAND_MAX {
        connection_acl_load_backup_default_denied_commands[command_index] = connection_acl_default_denied_commands[command_index];
        command_index = command_index + 1;
    }
    connection_acl_load_backup_default_denied_command_count = connection_acl_default_denied_command_count;
    var category_index: usize = 0;
    while category_index < CONNECTION_ACL_DENIED_CATEGORY_MAX {
        connection_acl_load_backup_default_denied_categories[category_index] = connection_acl_default_denied_categories[category_index];
        category_index = category_index + 1;
    }
    connection_acl_load_backup_default_denied_category_count = connection_acl_default_denied_category_count;
    connection_acl_load_backup_default_key_rules = connection_acl_default_key_rules;
    connection_acl_load_backup_default_channel_rules = connection_acl_default_channel_rules;
    var user_index: usize = 0;
    while user_index < CONNECTION_ACL_USER_MAX {
        connection_acl_load_backup_users[user_index] = connection_acl_users[user_index];
        user_index = user_index + 1;
    }
    runtime.pending_config = runtime.config;
}

fn connection_acl_load_restore(runtime: &CommandRuntimeInfo) void {
    var command_index: usize = 0;
    while command_index < CONNECTION_ACL_DENIED_COMMAND_MAX {
        connection_acl_default_denied_commands[command_index] = connection_acl_load_backup_default_denied_commands[command_index];
        command_index = command_index + 1;
    }
    connection_acl_default_denied_command_count = connection_acl_load_backup_default_denied_command_count;
    var category_index: usize = 0;
    while category_index < CONNECTION_ACL_DENIED_CATEGORY_MAX {
        connection_acl_default_denied_categories[category_index] = connection_acl_load_backup_default_denied_categories[category_index];
        category_index = category_index + 1;
    }
    connection_acl_default_denied_category_count = connection_acl_load_backup_default_denied_category_count;
    connection_acl_default_key_rules = connection_acl_load_backup_default_key_rules;
    connection_acl_default_channel_rules = connection_acl_load_backup_default_channel_rules;
    var user_index: usize = 0;
    while user_index < CONNECTION_ACL_USER_MAX {
        connection_acl_users[user_index] = connection_acl_load_backup_users[user_index];
        user_index = user_index + 1;
    }
    runtime.pending_config = runtime.config;
}

fn connection_acl_file_space(ch: byte) bool {
    return ch == 32 as byte || ch == 9 as byte || ch == 13 as byte;
}

fn connection_acl_file_next_token(line: &[byte], pos: &usize) &[byte] {
    while *pos < line.len && connection_acl_file_space(line.ptr[*pos]) {
        *pos = *pos + 1;
    }
    const start: usize = *pos;
    while *pos < line.len && !connection_acl_file_space(line.ptr[*pos]) {
        *pos = *pos + 1;
    }
    return line[start: *pos - start];
}

fn connection_acl_file_apply_default_modifier(runtime: &CommandRuntimeInfo, router: &CommandRouter, modifier: &[byte]) !void {
    if connection_keyword_eq(modifier, &"ON"[0: 2]) ||
        connection_keyword_eq(modifier, &"CLEARSELECTORS"[0: 14]) ||
        connection_keyword_eq(modifier, &"RESETSELECTORS"[0: 14]) {
        return;
    }
    if connection_keyword_eq(modifier, &"NOPASS"[0: 6]) || connection_keyword_eq(modifier, &"RESETPASS"[0: 9]) {
        connection_acl_bytes_clear(runtime.pending_config.requirepass[0: 128]);
        runtime.pending_config.requirepass_hash_set = false;
        connection_acl_bytes_clear(runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
        return;
    }
    if modifier.len > 1 && modifier.ptr[0] == 62 as byte {
        const password: &[byte] = modifier[1: modifier.len - 1];
        if password.len > 127 {
            return error.ConnectionAclFileInvalid;
        }
        connection_acl_hash_password(password, runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
        connection_acl_bytes_clear(runtime.pending_config.requirepass[0: 128]);
        runtime.pending_config.requirepass_hash_set = true;
        return;
    }
    if modifier.len > 1 && modifier.ptr[0] == 35 as byte {
        try connection_acl_hash_from_hex(modifier[1: modifier.len - 1], runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
        connection_acl_bytes_clear(runtime.pending_config.requirepass[0: 128]);
        runtime.pending_config.requirepass_hash_set = true;
        return;
    }
    if connection_acl_setuser_key_modifier_known(modifier) {
        const reply: CommandReply = connection_acl_key_patterns_apply_modifier(&connection_acl_default_key_rules.allkeys, connection_acl_default_key_rules.patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX], modifier);
        if reply.typ == CommandReplyType.reply_error {
            command_reply_cleanup(&reply);
            return error.ConnectionAclFileInvalid;
        }
        command_reply_cleanup(&reply);
        return;
    }
    if connection_acl_setuser_channel_modifier_known(modifier) {
        const reply: CommandReply = connection_acl_channel_patterns_apply_modifier(&connection_acl_default_channel_rules.allchannels, connection_acl_default_channel_rules.patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX], modifier);
        if reply.typ == CommandReplyType.reply_error {
            command_reply_cleanup(&reply);
            return error.ConnectionAclFileInvalid;
        }
        command_reply_cleanup(&reply);
        return;
    }
    if connection_keyword_eq(modifier, &"ALLCOMMANDS"[0: 11]) ||
        connection_keyword_eq(modifier, &"RESETCOMMANDS"[0: 13]) ||
        connection_keyword_eq(modifier, &"+@all"[0: 5]) {
        connection_acl_default_denied_clear_all();
        connection_acl_default_categories_clear_all();
        return;
    }
    if modifier.len > 1 && (modifier.ptr[0] == 43 as byte || modifier.ptr[0] == 45 as byte) {
        const reply: CommandReply = connection_acl_setuser_command_modifier(router, modifier);
        if reply.typ == CommandReplyType.reply_error {
            command_reply_cleanup(&reply);
            return error.ConnectionAclFileInvalid;
        }
        command_reply_cleanup(&reply);
        return;
    }
    return error.ConnectionAclFileInvalid;
}

fn connection_acl_file_apply_named_modifier(router: &CommandRouter, user: &ConnectionAclUser, modifier: &[byte]) !void {
    if connection_keyword_eq(modifier, &"ON"[0: 2]) {
        user.enabled = true;
        return;
    }
    if connection_keyword_eq(modifier, &"OFF"[0: 3]) {
        user.enabled = false;
        return;
    }
    if connection_keyword_eq(modifier, &"NOPASS"[0: 6]) {
        user.nopass = true;
        connection_acl_named_user_clear_password(user);
        return;
    }
    if connection_keyword_eq(modifier, &"RESETPASS"[0: 9]) {
        user.nopass = false;
        connection_acl_named_user_clear_password(user);
        return;
    }
    if modifier.len > 1 && modifier.ptr[0] == 62 as byte {
        try connection_acl_named_user_set_password(user, modifier[1: modifier.len - 1]);
        return;
    }
    if modifier.len > 1 && modifier.ptr[0] == 35 as byte {
        try connection_acl_named_user_set_password_hash(user, modifier[1: modifier.len - 1]);
        return;
    }
    if connection_acl_setuser_key_modifier_known(modifier) {
        const reply: CommandReply = connection_acl_key_patterns_apply_modifier(&user.allkeys, user.key_patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX], modifier);
        if reply.typ == CommandReplyType.reply_error {
            command_reply_cleanup(&reply);
            return error.ConnectionAclFileInvalid;
        }
        command_reply_cleanup(&reply);
        return;
    }
    if connection_acl_setuser_channel_modifier_known(modifier) {
        const reply: CommandReply = connection_acl_channel_patterns_apply_modifier(&user.allchannels, user.channel_patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX], modifier);
        if reply.typ == CommandReplyType.reply_error {
            command_reply_cleanup(&reply);
            return error.ConnectionAclFileInvalid;
        }
        command_reply_cleanup(&reply);
        return;
    }
    if connection_keyword_eq(modifier, &"ALLCOMMANDS"[0: 11]) ||
        connection_keyword_eq(modifier, &"RESETCOMMANDS"[0: 13]) ||
        connection_keyword_eq(modifier, &"+@all"[0: 5]) {
        connection_acl_user_clear_rules(user);
        return;
    }
    if modifier.len > 1 && (modifier.ptr[0] == 43 as byte || modifier.ptr[0] == 45 as byte) {
        const reply: CommandReply = connection_acl_setuser_named_command_modifier(router, user, modifier);
        if reply.typ == CommandReplyType.reply_error {
            command_reply_cleanup(&reply);
            return error.ConnectionAclFileInvalid;
        }
        command_reply_cleanup(&reply);
        return;
    }
    if connection_keyword_eq(modifier, &"CLEARSELECTORS"[0: 14]) || connection_keyword_eq(modifier, &"RESETSELECTORS"[0: 14]) {
        return;
    }
    return error.ConnectionAclFileInvalid;
}

fn connection_acl_file_apply_line(runtime: &CommandRuntimeInfo, router: &CommandRouter, line: &[byte], saw_default: &bool) !void {
    var pos: usize = 0;
    const keyword: &[byte] = connection_acl_file_next_token(line, &pos);
    if keyword.len == 0 || keyword.ptr[0] == 35 as byte {
        return;
    }
    if !connection_keyword_eq(keyword, &"USER"[0: 4]) {
        return error.ConnectionAclFileInvalid;
    }
    const username: &[byte] = connection_acl_file_next_token(line, &pos);
    if username.len == 0 || !connection_acl_file_token_safe(username) {
        return error.ConnectionAclFileInvalid;
    }
    const is_default: bool = connection_keyword_eq(username, &"default"[0: 7]);
    var user: &ConnectionAclUser = null as &ConnectionAclUser;
    if is_default {
        if *saw_default {
            return error.ConnectionAclFileInvalid;
        }
        *saw_default = true;
    } else {
        if connection_acl_user_find(username) >= 0 {
            return error.ConnectionAclFileInvalid;
        }
        const slot: usize = try connection_acl_user_create_or_get(username);
        if slot >= CONNECTION_ACL_USER_MAX {
            return error.ConnectionAclFileInvalid;
        }
        user = &connection_acl_users[slot];
    }
    var modifier_count: usize = 0;
    while true {
        const modifier: &[byte] = connection_acl_file_next_token(line, &pos);
        if modifier.len == 0 {
            break;
        }
        if !connection_acl_file_token_safe(modifier) {
            return error.ConnectionAclFileInvalid;
        }
        if is_default {
            try connection_acl_file_apply_default_modifier(runtime, router, modifier);
        } else {
            try connection_acl_file_apply_named_modifier(router, user, modifier);
        }
        modifier_count = modifier_count + 1;
    }
    if modifier_count == 0 {
        return error.ConnectionAclFileInvalid;
    }
}

export fn connection_acl_load_file(runtime: &CommandRuntimeInfo, router: &CommandRouter) !void {
    var path: [byte: CONNECTION_ACL_FILE_PATH_MAX] = [];
    try connection_acl_file_path(runtime, path[0: CONNECTION_ACL_FILE_PATH_MAX]);
    var file: File = file_open(&path[0] as &const byte, O_RDONLY as i32, 0u32) catch {
        return error.ConnectionAclFileOpenFailed;
    };
    defer {
        _ = file_close(&file) catch {};
    }
    var data: [byte: CONNECTION_ACL_FILE_MAX_BYTES] = [];
    var total: usize = 0;
    while total < CONNECTION_ACL_FILE_MAX_BYTES {
        const count: isize = file_read(&file, &data[total], CONNECTION_ACL_FILE_MAX_BYTES - total);
        if count < 0 {
            return error.ConnectionAclFileReadFailed;
        }
        if count == 0 {
            break;
        }
        total = total + (count as usize);
    }
    if total == CONNECTION_ACL_FILE_MAX_BYTES {
        var extra: [byte: 1] = [];
        const extra_count: isize = file_read(&file, &extra[0], 1);
        if extra_count < 0 {
            return error.ConnectionAclFileReadFailed;
        }
        if extra_count > 0 {
            return error.ConnectionAclFileTooLarge;
        }
    }

    connection_acl_load_snapshot(runtime);
    connection_acl_default_denied_clear_all();
    connection_acl_default_categories_clear_all();
    connection_acl_default_key_patterns_reset_allkeys();
    connection_acl_default_channel_patterns_reset_allchannels();
    connection_acl_users_clear_all();
    connection_acl_bytes_clear(runtime.pending_config.requirepass[0: 128]);
    runtime.pending_config.requirepass_hash_set = false;
    connection_acl_bytes_clear(runtime.pending_config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES]);
    var saw_default: bool = false;
    var start: usize = 0;
    var index: usize = 0;
    while index <= total {
        if index == total || data[index] == 10 as byte {
            _ = connection_acl_file_apply_line(runtime, router, data[start: index - start], &saw_default) catch |err| {
                connection_acl_load_restore(runtime);
                return err;
            };
            start = index + 1;
        }
        index = index + 1;
    }
    if !saw_default {
        connection_acl_load_restore(runtime);
        return error.ConnectionAclFileInvalid;
    }
}

fn connection_acl_file_unconfigured_reply() CommandReply {
    return connection_error_reply(&"ERR This Redis instance is not configured to use an ACL file. You may want to specify users via the ACL SETUSER command and then issue a CONFIG REWRITE (assuming you have a Redis configuration file) in order to store users in the Redis configuration."[0: 244]);
}

fn connection_acl_handle_save(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    if command.argc != 2 {
        return connection_error_reply(&"ERR wrong number of arguments for 'acl|save' command"[0: 52]);
    }
    _ = connection_acl_save_file(runtime) catch |err| {
        if err == error.ConnectionAclFileUnconfigured {
            return connection_acl_file_unconfigured_reply();
        }
        return connection_error_reply(&"ERR Error saving the ACLs. Please check the server logs for more information."[0: 76]);
    };
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_acl_handle_load(runtime: &CommandRuntimeInfo, router: &CommandRouter, command: &Command) CommandReply {
    if command.argc != 2 {
        return connection_error_reply(&"ERR wrong number of arguments for 'acl|load' command"[0: 52]);
    }
    _ = connection_acl_load_file(runtime, router) catch |err| {
        if err == error.ConnectionAclFileUnconfigured {
            return connection_acl_file_unconfigured_reply();
        }
        return connection_error_reply(&"ERR Error loading the ACLs, check server logs for more information."[0: 67]);
    };
    var reply: CommandReply = connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    reply.request_config_set = true;
    return reply;
}

fn connection_handle_acl(
    engine: &Engine,
    runtime: &CommandRuntimeInfo,
    router: &CommandRouter,
    tx: &ConnectionTransaction,
    command: &Command,
    now_ms: u64,
    client_id: i64,
) CommandReply {
    if command.argc < 2 {
        return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
    }
    const subcommand: &[byte] = command_arg_data(command, 1) catch {
        return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
    };
    if connection_keyword_eq(subcommand, &"SETUSER"[0: 7]) {
        return connection_acl_handle_setuser(runtime, router, command);
    }
    if connection_keyword_eq(subcommand, &"SAVE"[0: 4]) {
        return connection_acl_handle_save(runtime, command);
    }
    if connection_keyword_eq(subcommand, &"LOAD"[0: 4]) {
        return connection_acl_handle_load(runtime, router, command);
    }
    if connection_keyword_eq(subcommand, &"DRYRUN"[0: 6]) {
        return connection_acl_handle_dryrun(router, command, now_ms, client_id);
    }
    if connection_keyword_eq(subcommand, &"LIST"[0: 4]) {
        if command.argc != 2 {
            return connection_error_reply(&"ERR wrong number of arguments for 'acl|list' command"[0: 52]);
        }
        return connection_acl_handle_list(runtime);
    }
    if connection_keyword_eq(subcommand, &"GETUSER"[0: 7]) {
        return connection_acl_handle_getuser(runtime, command);
    }
    if connection_keyword_eq(subcommand, &"USERS"[0: 5]) {
        return connection_acl_handle_users(command);
    }
    if connection_keyword_eq(subcommand, &"DELUSER"[0: 7]) {
        return connection_acl_handle_deluser(command);
    }
    if connection_keyword_eq(subcommand, &"LOG"[0: 3]) {
        return connection_acl_handle_log(command, now_ms);
    }
    if connection_keyword_eq(subcommand, &"WHOAMI"[0: 6]) {
        if command.argc != 2 {
            return connection_error_reply(&"ERR wrong number of arguments for 'acl|whoami' command"[0: 54]);
        }
        return connection_make_reply(CommandReplyType.reply_bulk_string, connection_current_username(tx), 0);
    }
    return command_execute_with_runtime_at(engine, runtime, command, now_ms);
}

fn connection_script_is_space(ch: byte) bool {
    return ch == 32 as byte || ch == 9 as byte || ch == 10 as byte || ch == 13 as byte;
}

fn connection_script_skip_space(script: &[byte], index: &usize) void {
    while *index < script.len && connection_script_is_space(script.ptr[*index]) {
        *index = *index + 1;
    }
}

fn connection_script_match_prefix(script: &[byte], index: usize, prefix: &[byte]) bool {
    if index + prefix.len > script.len {
        return false;
    }
    var i: usize = 0;
    while i < prefix.len {
        if script.ptr[index + i] != prefix.ptr[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn connection_script_parse_reference_index(script: &[byte], index: &usize, prefix: &[byte]) !usize {
    if !connection_script_match_prefix(script, *index, prefix) {
        return error.ConnectionScriptUnsupported;
    }
    *index = *index + prefix.len;
    if *index >= script.len {
        return error.ConnectionScriptUnsupported;
    }
    var value: usize = 0;
    var digits: usize = 0;
    while *index < script.len {
        const ch: byte = script.ptr[*index];
        if ch == 93 as byte {
            break;
        }
        if ch < 48 as byte || ch > 57 as byte {
            return error.ConnectionScriptUnsupported;
        }
        value = value * 10usize + ((ch - 48 as byte) as usize);
        digits = digits + 1;
        *index = *index + 1;
    }
    if *index >= script.len || script.ptr[*index] != 93 as byte || digits == 0 || value == 0usize {
        return error.ConnectionScriptUnsupported;
    }
    *index = *index + 1;
    return value;
}

fn connection_script_parse_arg_spec(script: &[byte], index: &usize, spec: &ConnectionScriptArgSpec) !void {
    if *index >= script.len {
        return error.ConnectionScriptUnsupported;
    }
    const ch: byte = script.ptr[*index];
    if ch == 39 as byte || ch == 34 as byte {
        const quote: byte = ch;
        *index = *index + 1;
        const start: usize = *index;
        while *index < script.len && script.ptr[*index] != quote {
            if script.ptr[*index] == 92 as byte {
                return error.ConnectionScriptUnsupported;
            }
            *index = *index + 1;
        }
        if *index >= script.len {
            return error.ConnectionScriptUnsupported;
        }
        spec.kind = ConnectionScriptArgKind.script_arg_literal;
        spec.start = start;
        spec.len = *index - start;
        spec.ref_index = 0;
        *index = *index + 1;
        return;
    }
    if connection_script_match_prefix(script, *index, &"KEYS["[0: 5]) {
        spec.kind = ConnectionScriptArgKind.script_arg_key;
        spec.start = 0;
        spec.len = 0;
        spec.ref_index = try connection_script_parse_reference_index(script, index, &"KEYS["[0: 5]);
        return;
    }
    if connection_script_match_prefix(script, *index, &"ARGV["[0: 5]) {
        spec.kind = ConnectionScriptArgKind.script_arg_argv;
        spec.start = 0;
        spec.len = 0;
        spec.ref_index = try connection_script_parse_reference_index(script, index, &"ARGV["[0: 5]);
        return;
    }
    const start_bare: usize = *index;
    while *index < script.len {
        const current: byte = script.ptr[*index];
        if connection_script_is_space(current) || current == 44 as byte || current == 41 as byte {
            break;
        }
        *index = *index + 1;
    }
    if *index == start_bare {
        return error.ConnectionScriptUnsupported;
    }
    spec.kind = ConnectionScriptArgKind.script_arg_literal;
    spec.start = start_bare;
    spec.len = *index - start_bare;
    spec.ref_index = 0;
}

fn connection_script_parse_single_call(script: &[byte], args: &[ConnectionScriptArgSpec], arg_count: &usize) !void {
    var index: usize = 0;
    *arg_count = 0;
    connection_script_skip_space(script, &index);
    if !connection_script_match_prefix(script, index, &"return"[0: 6]) {
        return error.ConnectionScriptUnsupported;
    }
    index = index + 6;
    if index < script.len && !connection_script_is_space(script.ptr[index]) {
        return error.ConnectionScriptUnsupported;
    }
    connection_script_skip_space(script, &index);
    if !connection_script_match_prefix(script, index, &"redis.call"[0: 10]) {
        return error.ConnectionScriptUnsupported;
    }
    index = index + 10;
    connection_script_skip_space(script, &index);
    if index >= script.len || script.ptr[index] != 40 as byte {
        return error.ConnectionScriptUnsupported;
    }
    index = index + 1;
    connection_script_skip_space(script, &index);
    while index < script.len && script.ptr[index] != 41 as byte {
        if *arg_count >= args.len {
            return error.ConnectionScriptUnsupported;
        }
        try connection_script_parse_arg_spec(script, &index, &args.ptr[*arg_count]);
        *arg_count = *arg_count + 1;
        connection_script_skip_space(script, &index);
        if index < script.len && script.ptr[index] == 44 as byte {
            index = index + 1;
            connection_script_skip_space(script, &index);
            continue;
        }
        break;
    }
    if *arg_count == 0 || index >= script.len || script.ptr[index] != 41 as byte {
        return error.ConnectionScriptUnsupported;
    }
    if args.ptr[0].kind != ConnectionScriptArgKind.script_arg_literal {
        return error.ConnectionScriptUnsupported;
    }
    index = index + 1;
    connection_script_skip_space(script, &index);
    if index != script.len {
        return error.ConnectionScriptUnsupported;
    }
}

fn connection_script_validate_subset(script: &[byte]) !void {
    var args: [ConnectionScriptArgSpec: CONNECTION_SCRIPT_MAX_CALL_ARGS] = [];
    var arg_count: usize = 0;
    try connection_script_parse_single_call(script, args[0: CONNECTION_SCRIPT_MAX_CALL_ARGS], &arg_count);
}

fn connection_script_eval_numkeys(command: &Command) !usize {
    const numkeys_data: &[byte] = command_arg_data(command, 2) catch {
        return error.ConnectionScriptInvalidNumkeys;
    };
    if numkeys_data.len == 0 {
        return error.ConnectionScriptInvalidNumkeys;
    }
    if numkeys_data.ptr[0] == 45 as byte {
        return error.ConnectionScriptNegativeNumkeys;
    }
    const numkeys_u64: u64 = connection_parse_u64(numkeys_data) catch {
        return error.ConnectionScriptInvalidNumkeys;
    };
    const numkeys: usize = numkeys_u64 as usize;
    if command.argc < 3 + numkeys {
        return error.ConnectionScriptTooManyKeys;
    }
    return numkeys;
}

fn connection_script_resolve_arg(script: &[byte], command: &Command, numkeys: usize, spec: &ConnectionScriptArgSpec) !&[byte] {
    if spec.kind == ConnectionScriptArgKind.script_arg_literal {
        return script[spec.start: spec.len];
    }
    if spec.kind == ConnectionScriptArgKind.script_arg_key {
        const key_index: usize = 2 + spec.ref_index;
        return command_arg_data(command, key_index) catch {
            return error.ConnectionScriptMissingReference;
        };
    }
    const argv_index: usize = 2 + numkeys + spec.ref_index;
    return command_arg_data(command, argv_index) catch {
        return error.ConnectionScriptMissingReference;
    };
}

fn connection_script_build_raw_command(script: &[byte], command: &Command, numkeys: usize) !&RedisObject {
    var specs: [ConnectionScriptArgSpec: CONNECTION_SCRIPT_MAX_CALL_ARGS] = [];
    var arg_count: usize = 0;
    try connection_script_parse_single_call(script, specs[0: CONNECTION_SCRIPT_MAX_CALL_ARGS], &arg_count);

    var raw: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&raw);
    }
    try connection_sds_append_resp_array_header(&raw, arg_count);
    var index: usize = 0;
    while index < arg_count {
        const arg: &[byte] = try connection_script_resolve_arg(script, command, numkeys, &specs[index]);
        try connection_sds_append_resp_bulk(&raw, arg);
        index = index + 1;
    }
    return create_string_object(raw.buf[0: raw.len]) catch {
        return error.AllocOutOfMemory;
    };
}

fn connection_function_resolve_arg(script: &[byte], command: &Command, numkeys: usize, spec: &ConnectionScriptArgSpec) !&[byte] {
    if spec.kind == ConnectionScriptArgKind.script_arg_literal {
        return script[spec.start: spec.len];
    }
    if spec.kind == ConnectionScriptArgKind.script_arg_key {
        const key_index: usize = 2 + spec.ref_index;
        return command_arg_data(command, key_index) catch {
            return error.ConnectionScriptMissingReference;
        };
    }
    const argv_index: usize = 2 + numkeys + spec.ref_index;
    return command_arg_data(command, argv_index) catch {
        return error.ConnectionScriptMissingReference;
    };
}

fn connection_function_build_raw_command(script: &[byte], command: &Command, numkeys: usize) !&RedisObject {
    var specs: [ConnectionScriptArgSpec: CONNECTION_SCRIPT_MAX_CALL_ARGS] = [];
    var arg_count: usize = 0;
    try connection_script_parse_single_call(script, specs[0: CONNECTION_SCRIPT_MAX_CALL_ARGS], &arg_count);

    var raw: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&raw);
    }
    try connection_sds_append_resp_array_header(&raw, arg_count);
    var index: usize = 0;
    while index < arg_count {
        const arg: &[byte] = try connection_function_resolve_arg(script, command, numkeys, &specs[index]);
        try connection_sds_append_resp_bulk(&raw, arg);
        index = index + 1;
    }
    return create_string_object(raw.buf[0: raw.len]) catch {
        return error.AllocOutOfMemory;
    };
}

fn connection_script_reply_attach_raw(reply: &CommandReply, raw_obj: &RedisObject) void {
    if raw_obj == null {
        return;
    }
    if reply.owned_object == null {
        reply.owned_object = raw_obj;
        return;
    }
    if reply.owned_aux_object == null {
        reply.owned_aux_object = raw_obj;
        return;
    }
    object_free(raw_obj);
}

fn connection_script_command_allowed(cmd_type: CommandType) bool {
    if connection_command_is_blocking_pop(cmd_type) {
        return false;
    }
    if cmd_type == CommandType.command_multi ||
        cmd_type == CommandType.command_exec ||
        cmd_type == CommandType.command_discard ||
        cmd_type == CommandType.command_watch ||
        cmd_type == CommandType.command_unwatch ||
        cmd_type == CommandType.command_auth ||
        cmd_type == CommandType.command_hello ||
        cmd_type == CommandType.command_client ||
        cmd_type == CommandType.command_subscribe ||
        cmd_type == CommandType.command_unsubscribe ||
        cmd_type == CommandType.command_psubscribe ||
        cmd_type == CommandType.command_punsubscribe ||
        cmd_type == CommandType.command_ssubscribe ||
        cmd_type == CommandType.command_sunsubscribe ||
        cmd_type == CommandType.command_publish ||
        cmd_type == CommandType.command_spublish ||
        cmd_type == CommandType.command_pubsub ||
        cmd_type == CommandType.command_shutdown ||
        cmd_type == CommandType.command_quit ||
        cmd_type == CommandType.command_reset ||
        cmd_type == CommandType.command_save ||
        cmd_type == CommandType.command_bgsave ||
        cmd_type == CommandType.command_bgrewriteaof ||
        cmd_type == CommandType.command_monitor ||
        cmd_type == CommandType.command_debug ||
        cmd_type == CommandType.command_failover ||
        cmd_type == CommandType.command_hotkeys ||
        cmd_type == CommandType.command_migrate ||
        cmd_type == CommandType.command_module_unsupported ||
        cmd_type == CommandType.command_pfselftest ||
        cmd_type == CommandType.command_pfdebug ||
        cmd_type == CommandType.command_replicaof ||
        cmd_type == CommandType.command_psync ||
        cmd_type == CommandType.command_sync ||
        cmd_type == CommandType.command_replconf ||
        cmd_type == CommandType.command_config ||
        cmd_type == CommandType.command_cluster ||
        cmd_type == CommandType.command_wait ||
        cmd_type == CommandType.command_waitaof ||
        cmd_type == CommandType.command_eval ||
        cmd_type == CommandType.command_evalsha ||
        cmd_type == CommandType.command_eval_ro ||
        cmd_type == CommandType.command_evalsha_ro ||
        cmd_type == CommandType.command_script ||
        cmd_type == CommandType.command_function ||
        cmd_type == CommandType.command_himport ||
        cmd_type == CommandType.command_backup {
        return false;
    }
    return true;
}

fn connection_script_command_readonly(command: &Command) bool {
    return !connection_command_requests_write(command);
}

fn connection_command_allowed_in_resp2_pubsub_mode(cmd_type: CommandType) bool {
    return cmd_type == CommandType.command_subscribe ||
        cmd_type == CommandType.command_unsubscribe ||
        cmd_type == CommandType.command_psubscribe ||
        cmd_type == CommandType.command_punsubscribe ||
        cmd_type == CommandType.command_ssubscribe ||
        cmd_type == CommandType.command_sunsubscribe ||
        cmd_type == CommandType.command_ping ||
        cmd_type == CommandType.command_quit ||
        cmd_type == CommandType.command_reset;
}

fn connection_pubsub_mode_error() CommandReply {
    return connection_error_reply(&"ERR only SUBSCRIBE / PSUBSCRIBE / SSUBSCRIBE / UNSUBSCRIBE / PUNSUBSCRIBE / SUNSUBSCRIBE / PING / QUIT are allowed in this context"[0: 130]);
}

fn connection_reset_state(tx: &ConnectionTransaction) void {
    if tx == null {
        return;
    }
    connection_transaction_clear_queue(tx);
    connection_transaction_clear_watches(tx);
    if tx.client_fd >= 0 {
        connection_pubsub_unregister_fd(tx.client_fd);
        connection_monitor_unregister_fd(tx.client_fd);
    }
    tx.pubsub_count = 0;
    tx.monitoring = false;
    tx.protocol_version = 2;
    tx.client_name_len = 0;
    tx.client_lib_name_len = 0;
    tx.client_lib_ver_len = 0;
    tx.authenticated = false;
    connection_clear_authenticated_user(tx);
    connection_client_tracking_clear(tx);
    if tx.himport_fieldsets != null {
        object_free(tx.himport_fieldsets);
        tx.himport_fieldsets = null as &RedisObject;
    }
    tx.reply_off_enabled = false;
    tx.reply_skip_next = false;
    tx.caching_enabled = false;
    tx.no_evict_enabled = false;
    tx.no_touch_enabled = false;
    tx.blocking_active = false;
    tx.blocking_deadline_ms = 0u64;
    connection_client_registry_sync(tx);
}

fn connection_handle_reset(tx: &ConnectionTransaction, command: &Command) CommandReply {
    if command.argc != 1 {
        return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
    }
    connection_reset_state(tx);
    return connection_make_reply(CommandReplyType.reply_simple_string, &"RESET"[0: 5], 0);
}

fn connection_client_id(tx: &ConnectionTransaction) i64 {
    if tx != null {
        const tx_addr: usize = @usize_from_ptr(tx as &void);
        const slot_idx: i32 = connection_client_registry_find_slot(tx_addr);
        if slot_idx >= 0 && slot_idx < CONNECTION_CLIENT_REGISTRY_MAX as i32 {
            const slot_usize: usize = slot_idx as usize;
            if slot_usize < CONNECTION_CLIENT_REGISTRY_MAX {
                return connection_client_registry[slot_usize].client_id;
            }
        }
        if tx.client_fd >= 0 {
            return tx.client_fd as i64;
        }
    }
    return 0;
}

export fn connection_client_registry_client_id(tx: &ConnectionTransaction) i64 {
    return connection_client_id(tx);
}

fn connection_client_registry_has_client_id(client_id: i64) bool {
    var i: usize = 0;
    while i < CONNECTION_CLIENT_REGISTRY_MAX {
        if connection_client_registry[i].active && connection_client_registry[i].client_id == client_id {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn connection_client_registry_find_client_id_slot(client_id: i64) i32 {
    var i: usize = 0;
    while i < CONNECTION_CLIENT_REGISTRY_MAX {
        if connection_client_registry[i].active && connection_client_registry[i].client_id == client_id {
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

fn connection_client_registry_find_client_addr_slot(addr: &[byte]) i32 {
    if addr.len == 0 {
        return -1;
    }
    var i: usize = 0;
    while i < CONNECTION_CLIENT_REGISTRY_MAX {
        if connection_client_registry[i].active &&
            connection_slice_eq(connection_client_registry[i].client_addr[0: connection_client_registry[i].client_addr_len], addr) {
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

fn connection_client_registry_find_client_local_addr_slot(addr: &[byte]) i32 {
    if addr.len == 0 {
        return -1;
    }
    var i: usize = 0;
    while i < CONNECTION_CLIENT_REGISTRY_MAX {
        if connection_client_registry[i].active &&
            connection_slice_eq(
                connection_client_registry[i].client_local_addr[0: connection_client_registry[i].client_local_addr_len],
                addr,
            ) {
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

fn connection_client_registry_slot_matches_local_addr(slot_index: usize, addr: &[byte]) bool {
    if slot_index >= CONNECTION_CLIENT_REGISTRY_MAX {
        return false;
    }
    if !connection_client_registry[slot_index].active {
        return false;
    }
    return connection_slice_eq(
        connection_client_registry[slot_index].client_local_addr[0: connection_client_registry[slot_index].client_local_addr_len],
        addr,
    );
}

fn connection_client_registry_slots_share_local_addr(left_index: usize, right_index: usize) bool {
    if right_index >= CONNECTION_CLIENT_REGISTRY_MAX {
        return false;
    }
    if !connection_client_registry[right_index].active {
        return false;
    }
    return connection_client_registry_slot_matches_local_addr(
        left_index,
        connection_client_registry[right_index].client_local_addr[0: connection_client_registry[right_index].client_local_addr_len],
    );
}

fn connection_client_registry_slot_matches_user_selector(slot_index: usize, selector: i32) bool {
    if slot_index >= CONNECTION_CLIENT_REGISTRY_MAX || !connection_client_registry[slot_index].active {
        return false;
    }
    if selector == CONNECTION_CLIENT_KILL_USER_DEFAULT {
        return connection_slice_eq(
            connection_client_registry[slot_index].username[0: connection_client_registry[slot_index].username_len],
            &"default"[0: 7],
        );
    }
    if selector < 0 || selector >= CONNECTION_ACL_USER_MAX as i32 {
        return false;
    }
    const selector_index: usize = selector as usize;
    if selector_index >= CONNECTION_ACL_USER_MAX || !connection_acl_users[selector_index].active {
        return false;
    }
    return connection_slice_eq(
        connection_client_registry[slot_index].username[0: connection_client_registry[slot_index].username_len],
        connection_acl_users[selector_index].name[0: connection_acl_users[selector_index].name_len],
    );
}

fn connection_client_registry_slot_matches_type_selector(slot_index: usize, selector: i32) bool {
    if slot_index >= CONNECTION_CLIENT_REGISTRY_MAX {
        return false;
    }
    const proven_slot_index: usize = slot_index;
    if proven_slot_index >= CONNECTION_CLIENT_REGISTRY_MAX || !connection_client_registry[proven_slot_index].active {
        return false;
    }
    if selector == CONNECTION_CLIENT_KILL_TYPE_NONE {
        return true;
    }
    if selector == CONNECTION_CLIENT_KILL_TYPE_NORMAL {
        return connection_client_registry[proven_slot_index].pubsub_count == 0;
    }
    if selector == CONNECTION_CLIENT_KILL_TYPE_PUBSUB {
        return connection_client_registry[proven_slot_index].pubsub_count > 0;
    }
    return false;
}

fn connection_client_kill_no_such_user_reply(username: &[byte]) CommandReply {
    var err: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&err);
    }
    _ = sds_cat(&err, &"ERR No such user '"[0: 18]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&err, username) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&err, &"'"[0: 1]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_owned_error(err.buf[0: err.len]);
}

fn connection_client_name_valid(name: &[byte]) bool {
    var i: usize = 0;
    while i < name.len {
        const ch: byte = name.ptr[i];
        if ch <= 32 as byte || ch == 127 as byte {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn connection_client_copy_bytes(dst: &[byte], src: &[byte]) !void {
    if src.len > dst.len {
        return error.ConnectionInputTooLarge;
    }
    var i: usize = 0;
    while i < src.len {
        dst.ptr[i] = src.ptr[i];
        i = i + 1;
    }
    while i < dst.len {
        dst.ptr[i] = 0 as byte;
        i = i + 1;
    }
}

fn connection_cstring_slice(data: &[byte]) &[byte] {
    var len: usize = 0;
    while len < data.len && data.ptr[len] != 0 as byte {
        len = len + 1;
    }
    return data[0: len];
}

fn connection_client_registry_copy_bytes(dst: &[byte], src: &[byte], src_len: usize) void {
    var i: usize = 0;
    while i < src_len && i < dst.len {
        dst.ptr[i] = src.ptr[i];
        i = i + 1;
    }
    while i < dst.len {
        dst.ptr[i] = 0 as byte;
        i = i + 1;
    }
}

export fn connection_transaction_set_client_addresses(tx: &ConnectionTransaction, addr: &[byte], local_addr: &[byte]) void {
    if tx == null {
        return;
    }
    var addr_len: usize = addr.len;
    if addr_len > CONNECTION_CLIENT_ADDR_MAX {
        addr_len = CONNECTION_CLIENT_ADDR_MAX;
    }
    var local_addr_len: usize = local_addr.len;
    if local_addr_len > CONNECTION_CLIENT_ADDR_MAX {
        local_addr_len = CONNECTION_CLIENT_ADDR_MAX;
    }
    tx.client_addr_len = addr_len;
    tx.client_local_addr_len = local_addr_len;
    connection_client_registry_copy_bytes(tx.client_addr[0: CONNECTION_CLIENT_ADDR_MAX], addr, addr_len);
    connection_client_registry_copy_bytes(tx.client_local_addr[0: CONNECTION_CLIENT_ADDR_MAX], local_addr, local_addr_len);
    connection_client_registry_sync(tx);
}

export fn connection_transaction_set_client_times(tx: &ConnectionTransaction, created_ms: u64, last_interaction_ms: u64) void {
    if tx == null {
        return;
    }
    tx.created_ms = created_ms;
    tx.last_interaction_ms = last_interaction_ms;
    connection_client_registry_sync(tx);
}

export fn connection_transaction_set_query_buffer(tx: &ConnectionTransaction, len: usize, capacity: usize) void {
    if tx == null {
        return;
    }
    tx.query_buffer_len = len;
    tx.query_buffer_capacity = capacity;
}

export fn connection_transaction_set_output_buffer(tx: &ConnectionTransaction, len: usize) void {
    if tx == null {
        return;
    }
    tx.output_buffer_len = len;
}

export fn connection_transaction_add_network_input(tx: &ConnectionTransaction, bytes: usize) void {
    if tx == null {
        return;
    }
    tx.total_network_input = tx.total_network_input + (bytes as u64);
}

fn connection_client_registry_clear_slot(slot: &ConnectionClientRegistryEntry) void {
    slot.active = false;
    slot.tx_addr = 0 as usize;
    slot.client_id = 0;
    slot.fd = -1;
    slot.protocol_version = 2;
    slot.created_ms = 0u64;
    slot.last_interaction_ms = 0u64;
    slot.client_addr_len = 0;
    slot.client_local_addr_len = 0;
    slot.client_name_len = 0;
    slot.client_lib_name_len = 0;
    slot.client_lib_ver_len = 0;
    slot.username_len = 0;
    slot.pubsub_count = 0;
    slot.multi_active = false;
    slot.monitoring = false;
    slot.blocking_active = false;
    slot.tracking_enabled = false;
    connection_client_registry_copy_bytes(slot.client_addr[0: CONNECTION_CLIENT_ADDR_MAX], connection_reply_empty_slice(), 0);
    connection_client_registry_copy_bytes(slot.client_local_addr[0: CONNECTION_CLIENT_ADDR_MAX], connection_reply_empty_slice(), 0);
    connection_client_registry_copy_bytes(slot.client_name[0: CONNECTION_CLIENT_NAME_MAX], connection_reply_empty_slice(), 0);
    connection_client_registry_copy_bytes(slot.client_lib_name[0: CONNECTION_CLIENT_INFO_MAX], connection_reply_empty_slice(), 0);
    connection_client_registry_copy_bytes(slot.client_lib_ver[0: CONNECTION_CLIENT_INFO_MAX], connection_reply_empty_slice(), 0);
    connection_client_registry_copy_bytes(slot.username[0: CONNECTION_ACL_USER_NAME_MAX], connection_reply_empty_slice(), 0);
}

fn connection_client_registry_tx_addr(tx: &ConnectionTransaction) usize {
    if tx == null {
        return 0 as usize;
    }
    return @usize_from_ptr(tx as &void);
}

fn connection_client_registry_find_slot(tx_addr: usize) i32 {
    var i: usize = 0;
    while i < CONNECTION_CLIENT_REGISTRY_MAX {
        if connection_client_registry[i].active && connection_client_registry[i].tx_addr == tx_addr {
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

fn connection_client_registry_ensure_slot(tx_addr: usize) i32 {
    if tx_addr == 0 as usize {
        return -1;
    }
    const existing: i32 = connection_client_registry_find_slot(tx_addr);
    if existing >= 0 {
        return existing;
    }
    var i: usize = 0;
    while i < CONNECTION_CLIENT_REGISTRY_MAX {
        if !connection_client_registry[i].active {
            connection_client_registry_clear_slot(&connection_client_registry[i]);
            connection_client_registry[i].active = true;
            connection_client_registry[i].tx_addr = tx_addr;
            connection_client_registry[i].client_id = connection_client_registry_next_id;
            connection_client_registry_next_id = connection_client_registry_next_id + 1;
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

export fn connection_client_registry_sync(tx: &ConnectionTransaction) void {
    if tx == null {
        return;
    }
    const tx_addr: usize = connection_client_registry_tx_addr(tx);
    const slot_idx: i32 = connection_client_registry_ensure_slot(tx_addr);
    if slot_idx < 0 || slot_idx >= CONNECTION_CLIENT_REGISTRY_MAX as i32 {
        return;
    }
    const slot_usize: usize = slot_idx as usize;
    if slot_usize >= CONNECTION_CLIENT_REGISTRY_MAX {
        return;
    }
    const slot: &ConnectionClientRegistryEntry = &connection_client_registry[slot_usize];
    slot.active = true;
    slot.tx_addr = tx_addr;
    slot.fd = tx.client_fd;
    slot.protocol_version = tx.protocol_version;
    slot.created_ms = tx.created_ms;
    slot.last_interaction_ms = tx.last_interaction_ms;
    slot.client_addr_len = tx.client_addr_len;
    if slot.client_addr_len > CONNECTION_CLIENT_ADDR_MAX {
        slot.client_addr_len = CONNECTION_CLIENT_ADDR_MAX;
    }
    slot.client_local_addr_len = tx.client_local_addr_len;
    if slot.client_local_addr_len > CONNECTION_CLIENT_ADDR_MAX {
        slot.client_local_addr_len = CONNECTION_CLIENT_ADDR_MAX;
    }
    slot.client_name_len = tx.client_name_len;
    slot.client_lib_name_len = tx.client_lib_name_len;
    slot.client_lib_ver_len = tx.client_lib_ver_len;
    const username: &[byte] = connection_current_username(tx);
    slot.username_len = username.len;
    slot.pubsub_count = tx.pubsub_count;
    slot.multi_active = tx.active;
    slot.monitoring = tx.monitoring;
    slot.blocking_active = tx.blocking_active;
    slot.tracking_enabled = tx.tracking_enabled;
    connection_client_registry_copy_bytes(slot.client_addr[0: CONNECTION_CLIENT_ADDR_MAX], tx.client_addr[0: CONNECTION_CLIENT_ADDR_MAX], slot.client_addr_len);
    connection_client_registry_copy_bytes(slot.client_local_addr[0: CONNECTION_CLIENT_ADDR_MAX], tx.client_local_addr[0: CONNECTION_CLIENT_ADDR_MAX], slot.client_local_addr_len);
    connection_client_registry_copy_bytes(slot.client_name[0: CONNECTION_CLIENT_NAME_MAX], tx.client_name[0: CONNECTION_CLIENT_NAME_MAX], tx.client_name_len);
    connection_client_registry_copy_bytes(slot.client_lib_name[0: CONNECTION_CLIENT_INFO_MAX], tx.client_lib_name[0: CONNECTION_CLIENT_INFO_MAX], tx.client_lib_name_len);
    connection_client_registry_copy_bytes(slot.client_lib_ver[0: CONNECTION_CLIENT_INFO_MAX], tx.client_lib_ver[0: CONNECTION_CLIENT_INFO_MAX], tx.client_lib_ver_len);
    connection_client_registry_copy_bytes(slot.username[0: CONNECTION_ACL_USER_NAME_MAX], username, slot.username_len);
}

fn connection_client_command_uses_subcommand(cmd_type: CommandType) bool {
    return cmd_type == CommandType.command_acl ||
        cmd_type == CommandType.command_backup ||
        cmd_type == CommandType.command_client ||
        cmd_type == CommandType.command_cluster ||
        cmd_type == CommandType.command_command ||
        cmd_type == CommandType.command_config ||
        cmd_type == CommandType.command_debug ||
        cmd_type == CommandType.command_function ||
        cmd_type == CommandType.command_hotkeys ||
        cmd_type == CommandType.command_latency ||
        cmd_type == CommandType.command_memory ||
        cmd_type == CommandType.command_module ||
        cmd_type == CommandType.command_object ||
        cmd_type == CommandType.command_pubsub ||
        cmd_type == CommandType.command_script ||
        cmd_type == CommandType.command_slowlog ||
        cmd_type == CommandType.command_xgroup ||
        cmd_type == CommandType.command_xinfo;
}

fn connection_transaction_set_client_command(tx: &ConnectionTransaction, command: &Command) void {
    if tx == null || command == null {
        return;
    }
    var command_len: usize = command.info.name.len;
    var subcommand: &[byte] = connection_reply_empty_slice();
    if command.argc > 1 &&
        (command.info.first_key == 0 || command.info.cmd_type == CommandType.command_object) &&
        connection_client_command_uses_subcommand(command.info.cmd_type) {
        subcommand = command_arg_data(command, 1) catch {
            return;
        };
        const qualified_len: usize = command.info.name.len + 1 + subcommand.len;
        if subcommand.len > 0 && connection_client_name_valid(subcommand) && qualified_len <= CONNECTION_CLIENT_COMMAND_MAX {
            command_len = qualified_len;
        } else {
            subcommand = connection_reply_empty_slice();
        }
    }
    if command_len > CONNECTION_CLIENT_COMMAND_MAX {
        command_len = CONNECTION_CLIENT_COMMAND_MAX;
        subcommand = connection_reply_empty_slice();
    }

    tx.command_name_len = command_len;
    var index: usize = 0;
    while index < command.info.name.len && index < command_len {
        tx.command_name[index] = connection_ascii_lower(command.info.name.ptr[index]);
        index = index + 1;
    }
    if subcommand.len > 0 && index < command_len {
        tx.command_name[index] = 124 as byte;
        index = index + 1;
        var sub_index: usize = 0;
        while sub_index < subcommand.len && index < command_len {
            tx.command_name[index] = connection_ascii_lower(subcommand.ptr[sub_index]);
            index = index + 1;
            sub_index = sub_index + 1;
        }
    }
}

fn connection_acl_log_client_id(tx: &ConnectionTransaction) i64 {
    connection_client_registry_sync(tx);
    return connection_client_id(tx);
}

fn connection_client_elapsed_seconds(now_ms: u64, then_ms: u64) u64 {
    if then_ms == 0u64 || now_ms < then_ms {
        return 0u64;
    }
    return (now_ms - then_ms) / 1000u64;
}

fn connection_client_registry_append_info_line(raw: &Sds, client_id: i64, protocol_version: i32, fd: i32, created_ms: u64, last_interaction_ms: u64, now_ms: u64, command_name: &[byte], tracking_redirect_id: i64, addr: &[byte], local_addr: &[byte], name: &[byte], lib_name: &[byte], lib_ver: &[byte], username: &[byte], sub_count: usize, psub_count: usize, ssub_count: usize, query_buffer_len: usize, query_buffer_capacity: usize, output_buffer_len: usize, multi_count: i64, watch_count: usize, multi_memory: usize, total_memory: usize, total_network_input: u64, monitoring: bool, blocking_active: bool, tracking_enabled: bool, tracking_bcast: bool, watch_dirty: bool, no_evict_enabled: bool, no_touch_enabled: bool) !void {
    try sds_cat(raw, &"id="[0: 3]);
    try connection_sds_append_i64(raw, client_id);
    try sds_cat(raw, &" addr="[0: 6]);
    if addr.len > 0 {
        try sds_cat(raw, addr);
    }
    try sds_cat(raw, &" laddr="[0: 7]);
    if local_addr.len > 0 {
        try sds_cat(raw, local_addr);
    }
    try sds_cat(raw, &" fd="[0: 4]);
    try connection_sds_append_i64(raw, fd as i64);
    try sds_cat(raw, &" name="[0: 6]);
    if name.len > 0 {
        try sds_cat(raw, name);
    }
    try sds_cat(raw, &" age="[0: 5]);
    try connection_sds_append_u64(raw, connection_client_elapsed_seconds(now_ms, created_ms));
    try sds_cat(raw, &" idle="[0: 6]);
    try connection_sds_append_u64(raw, connection_client_elapsed_seconds(now_ms, last_interaction_ms));
    try sds_cat(raw, &" resp="[0: 6]);
    try connection_sds_append_i64(raw, protocol_version as i64);
    try sds_cat(raw, &" multi="[0: 7]);
    try connection_sds_append_i64(raw, multi_count);
    try sds_cat(raw, &" watch="[0: 7]);
    try connection_sds_append_u64(raw, watch_count as u64);
    try sds_cat(raw, &" db=0"[0: 5]);
    try sds_cat(raw, &" sub="[0: 5]);
    try connection_sds_append_u64(raw, sub_count as u64);
    try sds_cat(raw, &" psub="[0: 6]);
    try connection_sds_append_u64(raw, psub_count as u64);
    try sds_cat(raw, &" ssub="[0: 6]);
    try connection_sds_append_u64(raw, ssub_count as u64);
    try sds_cat(raw, &" qbuf="[0: 6]);
    try connection_sds_append_u64(raw, query_buffer_len as u64);
    try sds_cat(raw, &" qbuf-free="[0: 11]);
    if query_buffer_len < query_buffer_capacity {
        try connection_sds_append_u64(raw, (query_buffer_capacity - query_buffer_len) as u64);
    } else {
        try connection_sds_append_u64(raw, 0u64);
    }
    try sds_cat(raw, &" argv-mem=0"[0: 11]);
    try sds_cat(raw, &" multi-mem="[0: 11]);
    try connection_sds_append_u64(raw, multi_memory as u64);
    try sds_cat(raw, &" rbs="[0: 5]);
    try connection_sds_append_u64(raw, CONNECTION_CLIENT_REPLY_BUFFER_CAP as u64);
    try sds_cat(raw, &" rbp="[0: 5]);
    try connection_sds_append_u64(raw, CONNECTION_CLIENT_REPLY_BUFFER_CAP as u64);
    try sds_cat(raw, &" obl="[0: 5]);
    try connection_sds_append_u64(raw, output_buffer_len as u64);
    try sds_cat(raw, &" oll=0 omem=0"[0: 13]);
    try sds_cat(raw, &" tot-mem="[0: 9]);
    try connection_sds_append_u64(raw, total_memory as u64);
    if output_buffer_len > 0 {
        try sds_cat(raw, &" events=w"[0: 9]);
    } else {
        try sds_cat(raw, &" events=r"[0: 9]);
    }
    try sds_cat(raw, &" user="[0: 6]);
    try sds_cat(raw, username);
    try sds_cat(raw, &" redir="[0: 7]);
    try connection_sds_append_i64(raw, tracking_redirect_id);
    try sds_cat(raw, &" flags="[0: 7]);
    var has_flag: bool = false;
    if monitoring {
        try sds_cat(raw, &"O"[0: 1]);
        has_flag = true;
    }
    if sub_count + psub_count + ssub_count > 0 {
        try sds_cat(raw, &"P"[0: 1]);
        has_flag = true;
    }
    if multi_count >= 0 {
        try sds_cat(raw, &"x"[0: 1]);
        has_flag = true;
    }
    if blocking_active {
        try sds_cat(raw, &"b"[0: 1]);
        has_flag = true;
    }
    if tracking_enabled {
        try sds_cat(raw, &"t"[0: 1]);
        has_flag = true;
    }
    if tracking_bcast {
        try sds_cat(raw, &"B"[0: 1]);
        has_flag = true;
    }
    if watch_dirty {
        try sds_cat(raw, &"d"[0: 1]);
        has_flag = true;
    }
    if no_evict_enabled {
        try sds_cat(raw, &"e"[0: 1]);
        has_flag = true;
    }
    if no_touch_enabled {
        try sds_cat(raw, &"T"[0: 1]);
        has_flag = true;
    }
    if !has_flag {
        try sds_cat(raw, &"N"[0: 1]);
    }
    try sds_cat(raw, &" cmd="[0: 5]);
    if command_name.len > 0 {
        try sds_cat(raw, command_name);
    } else {
        try sds_cat(raw, &"NULL"[0: 4]);
    }
    try sds_cat(raw, &" lib-name="[0: 10]);
    if lib_name.len > 0 {
        try sds_cat(raw, lib_name);
    }
    try sds_cat(raw, &" lib-ver="[0: 9]);
    if lib_ver.len > 0 {
        try sds_cat(raw, lib_ver);
    }
    try sds_cat(raw, &" io-thread=0"[0: 12]);
    try sds_cat(raw, &" tot-net-in="[0: 12]);
    try connection_sds_append_u64(raw, total_network_input);
    try sds_cat(raw, &"\r\n"[0: 2]);
}

fn connection_client_registry_append_slot_info(raw: &Sds, slot_index: usize, now_ms: u64) !void {
    if slot_index >= CONNECTION_CLIENT_REGISTRY_MAX {
        return;
    }
    if !connection_client_registry[slot_index].active {
        return;
    }
    var command_name: &[byte] = connection_reply_empty_slice();
    var tracking_redirect_id: i64 = -1;
    var multi_count: i64 = -1;
    var query_buffer_len: usize = 0;
    var query_buffer_capacity: usize = 0;
    var output_buffer_len: usize = 0;
    var watch_count: usize = 0;
    var multi_memory: usize = 0;
    var total_memory: usize = 0;
    var total_network_input: u64 = 0u64;
    var tracking_bcast: bool = false;
    var watch_dirty: bool = false;
    var no_evict_enabled: bool = false;
    var no_touch_enabled: bool = false;
    if connection_client_registry[slot_index].multi_active {
        multi_count = 0;
    }
    const tx_addr: usize = connection_client_registry[slot_index].tx_addr;
    if tx_addr != 0 as usize {
        const tx: &ConnectionTransaction = @ptr_from_usize(tx_addr) as &ConnectionTransaction;
        if tx != null {
            tracking_redirect_id = tx.tracking_redirect_id;
            query_buffer_len = tx.query_buffer_len;
            query_buffer_capacity = tx.query_buffer_capacity;
            output_buffer_len = tx.output_buffer_len;
            if tx.watched != null {
                watch_count = dict_len(&tx.watched.hash_dict);
            }
            multi_memory = connection_transaction_multi_memory(tx);
            total_memory = connection_client_total_memory(tx);
            total_network_input = tx.total_network_input;
            tracking_bcast = tx.tracking_bcast;
            if tx.watched != null && tx.watch_engine != null {
                watch_dirty = !connection_transaction_watches_match(tx, tx.watch_engine);
            }
            no_evict_enabled = tx.no_evict_enabled;
            no_touch_enabled = tx.no_touch_enabled;
            if tx.active {
                multi_count = tx.queue_count as i64;
            } else {
                multi_count = -1;
            }
            if tx.command_name_len <= CONNECTION_CLIENT_COMMAND_MAX {
                command_name = tx.command_name[0: tx.command_name_len];
            }
        }
    }
    const client_fd: i32 = connection_client_registry[slot_index].fd;
    const sub_count: usize = connection_pubsub_count_fd_kind(client_fd, false, false);
    const psub_count: usize = connection_pubsub_count_fd_kind(client_fd, true, false);
    const ssub_count: usize = connection_pubsub_count_fd_kind(client_fd, false, true);
    try connection_client_registry_append_info_line(
        raw,
        connection_client_registry[slot_index].client_id,
        connection_client_registry[slot_index].protocol_version,
        connection_client_registry[slot_index].fd,
        connection_client_registry[slot_index].created_ms,
        connection_client_registry[slot_index].last_interaction_ms,
        now_ms,
        command_name,
        tracking_redirect_id,
        connection_client_registry[slot_index].client_addr[0: connection_client_registry[slot_index].client_addr_len],
        connection_client_registry[slot_index].client_local_addr[0: connection_client_registry[slot_index].client_local_addr_len],
        connection_client_registry[slot_index].client_name[0: connection_client_registry[slot_index].client_name_len],
        connection_client_registry[slot_index].client_lib_name[0: connection_client_registry[slot_index].client_lib_name_len],
        connection_client_registry[slot_index].client_lib_ver[0: connection_client_registry[slot_index].client_lib_ver_len],
        connection_client_registry[slot_index].username[0: connection_client_registry[slot_index].username_len],
        sub_count,
        psub_count,
        ssub_count,
        query_buffer_len,
        query_buffer_capacity,
        output_buffer_len,
        multi_count,
        watch_count,
        multi_memory,
        total_memory,
        total_network_input,
        connection_client_registry[slot_index].monitoring,
        connection_client_registry[slot_index].blocking_active,
        connection_client_registry[slot_index].tracking_enabled,
        tracking_bcast,
        watch_dirty,
        no_evict_enabled,
        no_touch_enabled,
    );
}

fn connection_client_unknown_type_reply(client_type: &[byte]) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    _ = sds_cat(&raw, &"ERR Unknown client type '"[0: 25]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&raw, client_type) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = sds_cat(&raw, &"'"[0: 1]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_owned_error(raw.buf[0: raw.len]);
}

fn connection_client_list_reply(command: &Command, now_ms: u64) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }

    if command.argc == 2 {
        var i: usize = 0;
        while i < CONNECTION_CLIENT_REGISTRY_MAX {
            _ = connection_client_registry_append_slot_info(&raw, i, now_ms) catch {
                return connection_error_reply(&"ERR out of memory"[0: 17]);
            };
            i = i + 1;
        }
        return connection_bulk_reply_owned(raw.buf[0: raw.len]);
    }

    if command.argc < 4 {
        return connection_error_reply(&"ERR syntax error"[0: 16]);
    }
    const selector: &[byte] = command_arg_data(command, 2) catch {
        return connection_error_reply(&"ERR invalid request"[0: 19]);
    };
    if connection_keyword_eq(selector, &"TYPE"[0: 4]) {
        if command.argc != 4 {
            return connection_error_reply(&"ERR syntax error"[0: 16]);
        }
        const client_type: &[byte] = command_arg_data(command, 3) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        var want_pubsub: bool = false;
        if connection_keyword_eq(client_type, &"NORMAL"[0: 6]) {
            want_pubsub = false;
        } else if connection_keyword_eq(client_type, &"PUBSUB"[0: 6]) {
            want_pubsub = true;
        } else if connection_keyword_eq(client_type, &"MASTER"[0: 6]) ||
            connection_keyword_eq(client_type, &"REPLICA"[0: 7]) ||
            connection_keyword_eq(client_type, &"SLAVE"[0: 5]) {
            return connection_bulk_reply_owned(raw.buf[0: raw.len]);
        } else {
            return connection_client_unknown_type_reply(client_type);
        }
        var type_index: usize = 0;
        while type_index < CONNECTION_CLIENT_REGISTRY_MAX {
            if connection_client_registry[type_index].active &&
                ((connection_client_registry[type_index].pubsub_count > 0) == want_pubsub) {
                _ = connection_client_registry_append_slot_info(&raw, type_index, now_ms) catch {
                    return connection_error_reply(&"ERR out of memory"[0: 17]);
                };
            }
            type_index = type_index + 1;
        }
        return connection_bulk_reply_owned(raw.buf[0: raw.len]);
    }
    if !connection_keyword_eq(selector, &"ID"[0: 2]) {
        return connection_error_reply(&"ERR syntax error"[0: 16]);
    }

    var arg_index: usize = 3;
    while arg_index < command.argc {
        const id_arg: &[byte] = command_arg_data(command, arg_index) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        const client_id_u64: u64 = connection_parse_u64(id_arg) catch {
            return connection_error_reply(&"ERR Invalid client ID"[0: 21]);
        };
        if client_id_u64 > 9223372036854775807u64 {
            return connection_error_reply(&"ERR Invalid client ID"[0: 21]);
        }
        const slot_index: i32 = connection_client_registry_find_client_id_slot(client_id_u64 as i64);
        if slot_index >= 0 && slot_index < CONNECTION_CLIENT_REGISTRY_MAX as i32 {
            const slot_usize: usize = slot_index as usize;
            if slot_usize < CONNECTION_CLIENT_REGISTRY_MAX {
                _ = connection_client_registry_append_slot_info(&raw, slot_usize, now_ms) catch {
                    return connection_error_reply(&"ERR out of memory"[0: 17]);
                };
            }
        }
        arg_index = arg_index + 1;
    }
    return connection_bulk_reply_owned(raw.buf[0: raw.len]);
}

export fn connection_client_registry_unregister_tx(tx: &ConnectionTransaction) void {
    const tx_addr: usize = connection_client_registry_tx_addr(tx);
    const slot_idx: i32 = connection_client_registry_find_slot(tx_addr);
    if slot_idx < 0 || slot_idx >= CONNECTION_CLIENT_REGISTRY_MAX as i32 {
        return;
    }
    const slot_usize: usize = slot_idx as usize;
    if slot_usize >= CONNECTION_CLIENT_REGISTRY_MAX {
        return;
    }
    connection_client_registry_clear_slot(&connection_client_registry[slot_usize]);
}

export fn connection_client_registry_reset_for_test() void {
    var i: usize = 0;
    while i < CONNECTION_CLIENT_REGISTRY_MAX {
        connection_client_registry_clear_slot(&connection_client_registry[i]);
        i = i + 1;
    }
    connection_client_registry_next_id = 1;
}

export fn connection_monitor_reset_for_test() void {
    var i: usize = 0;
    while i < CONNECTION_MONITOR_MAX_CLIENTS {
        connection_monitor_clients[i].active = false;
        connection_monitor_clients[i].fd = -1;
        i = i + 1;
    }
    connection_monitor_active_count = 0;
}

fn connection_monitor_clear_slot(index: usize) void {
    if index >= CONNECTION_MONITOR_MAX_CLIENTS {
        return;
    }
    if !connection_monitor_clients[index].active {
        return;
    }
    connection_monitor_clients[index].active = false;
    connection_monitor_clients[index].fd = -1;
    if connection_monitor_active_count > 0 {
        connection_monitor_active_count = connection_monitor_active_count - 1;
    }
}

fn connection_monitor_register(fd: i32) bool {
    if fd < 0 {
        return true;
    }
    var free_index: i32 = -1;
    var i: usize = 0;
    while i < CONNECTION_MONITOR_MAX_CLIENTS {
        if connection_monitor_clients[i].active {
            if connection_monitor_clients[i].fd == fd {
                return true;
            }
        } else if free_index < 0 {
            free_index = i as i32;
        }
        i = i + 1;
    }
    if free_index < 0 {
        return false;
    }
    const slot: usize = free_index as usize;
    if slot >= CONNECTION_MONITOR_MAX_CLIENTS {
        return false;
    }
    connection_monitor_clients[slot].active = true;
    connection_monitor_clients[slot].fd = fd;
    connection_monitor_active_count = connection_monitor_active_count + 1;
    return true;
}

export fn connection_monitor_unregister_fd(fd: i32) void {
    var i: usize = 0;
    while i < CONNECTION_MONITOR_MAX_CLIENTS {
        if connection_monitor_clients[i].active && connection_monitor_clients[i].fd == fd {
            connection_monitor_clear_slot(i);
        }
        i = i + 1;
    }
}

fn connection_monitor_append_quoted_arg(buf: &Sds, data: &[byte]) !void {
    try sds_cat(buf, &"\""[0: 1]);
    var i: usize = 0;
    while i < data.len {
        const ch: byte = data.ptr[i];
        if ch == 34 as byte || ch == 92 as byte {
            try sds_cat(buf, &"\\"[0: 1]);
        }
        var tmp: [byte: 1] = [];
        tmp[0] = ch;
        try sds_cat(buf, tmp[0: 1]);
        i = i + 1;
    }
    try sds_cat(buf, &"\""[0: 1]);
}

fn connection_monitor_build_line(command: &Command, now_ms: u64) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    _ = sds_cat(&raw, &"+"[0: 1]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    _ = connection_sds_append_u64(&raw, now_ms / 1000u64) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    _ = sds_cat(&raw, &"."[0: 1]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    const millis: u64 = now_ms % 1000u64;
    _ = connection_sds_append_u64(&raw, millis) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    _ = sds_cat(&raw, &" [0 redis-uya] "[0: 15]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    var index: usize = 0;
    while index < command.argc {
        if index > 0 {
            _ = sds_cat(&raw, &" "[0: 1]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
        }
        const arg: &[byte] = command_arg_data(command, index) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        _ = connection_monitor_append_quoted_arg(&raw, arg) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
        index = index + 1;
    }
    _ = sds_cat(&raw, &"\r\n"[0: 2]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    return connection_raw_reply_owned(raw.buf[0: raw.len]);
}

fn connection_monitor_broadcast(command: &Command, source_fd: i32, now_ms: u64) void {
    if connection_monitor_active_count == 0 {
        return;
    }
    var line: CommandReply = connection_monitor_build_line(command, now_ms);
    defer {
        command_reply_cleanup(&line);
    }
    if line.typ != CommandReplyType.reply_raw_bytes {
        return;
    }
    var i: usize = 0;
    while i < CONNECTION_MONITOR_MAX_CLIENTS {
        if connection_monitor_clients[i].active {
            const fd: i32 = connection_monitor_clients[i].fd;
            if fd >= 0 && fd != source_fd {
                _ = connection_send_all_nonblocking(fd, line.data.ptr, line.data.len) catch {
                    connection_monitor_clear_slot(i);
                };
            }
        }
        i = i + 1;
    }
}

fn connection_requirepass(runtime: &CommandRuntimeInfo) &[byte] {
    return connection_cstring_slice(runtime.config.requirepass[0: 128]);
}

fn connection_auth_required(runtime: &CommandRuntimeInfo) bool {
    return runtime.config.requirepass[0] != 0 as byte || runtime.config.requirepass_hash_set;
}

fn connection_default_password_matches(runtime: &CommandRuntimeInfo, password: &[byte]) bool {
    if runtime.config.requirepass_hash_set {
        return connection_acl_hash_matches_password(runtime.config.requirepass_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], password);
    }
    const requirepass: &[byte] = connection_requirepass(runtime);
    return password.len == requirepass.len && connection_slice_eq(password, requirepass);
}

fn connection_authenticated_named_user_valid(tx: &ConnectionTransaction) bool {
    if tx == null || tx.username_len == 0 {
        return true;
    }
    if connection_keyword_eq(tx.username[0: tx.username_len], &"default"[0: 7]) {
        return true;
    }
    const slot: i32 = connection_acl_user_find(tx.username[0: tx.username_len]);
    if slot < 0 || slot >= CONNECTION_ACL_USER_MAX as i32 {
        return false;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_USER_MAX {
        return false;
    }
    return connection_acl_users[slot_index].active && connection_acl_users[slot_index].enabled;
}

fn connection_auth_ok(tx: &ConnectionTransaction, runtime: &CommandRuntimeInfo) bool {
    if !connection_auth_required(runtime) {
        return true;
    }
    return tx != null && tx.authenticated && connection_authenticated_named_user_valid(tx);
}

fn connection_noauth_reply() CommandReply {
    return connection_error_reply(&"NOAUTH Authentication required."[0: 31]);
}

fn connection_wrongpass_reply() CommandReply {
    return connection_error_reply(&"WRONGPASS invalid username-password pair or user is disabled."[0: 61]);
}

fn connection_auth_no_password_reply() CommandReply {
    return connection_error_reply(&"ERR AUTH <password> called without any password configured for the default user. Are you sure your configuration is correct?"[0: 124]);
}

fn connection_authenticate_named_user(tx: &ConnectionTransaction, username: &[byte], password: &[byte]) CommandReply {
    const slot: i32 = connection_acl_user_find(username);
    if slot < 0 || slot >= CONNECTION_ACL_USER_MAX as i32 {
        tx.authenticated = false;
        connection_clear_authenticated_user(tx);
        return connection_wrongpass_reply();
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_USER_MAX {
        tx.authenticated = false;
        connection_clear_authenticated_user(tx);
        return connection_wrongpass_reply();
    }
    const user: &ConnectionAclUser = &connection_acl_users[slot_index];
    if !user.enabled {
        tx.authenticated = false;
        connection_clear_authenticated_user(tx);
        return connection_wrongpass_reply();
    }
    if user.nopass {
        tx.authenticated = true;
        connection_set_authenticated_user(tx, user.name[0: user.name_len]);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    if !user.password_hash_set ||
        !connection_acl_hash_matches_password(user.password_hash[0: CONNECTION_ACL_PASSWORD_HASH_BYTES], password) {
        tx.authenticated = false;
        connection_clear_authenticated_user(tx);
        return connection_wrongpass_reply();
    }
    tx.authenticated = true;
    connection_set_authenticated_user(tx, user.name[0: user.name_len]);
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_handle_auth_state(tx: &ConnectionTransaction, runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    if command.argc != 2 && command.argc != 3 {
        return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
    }

    const requirepass: &[byte] = connection_requirepass(runtime);
    if requirepass.len == 0 && !runtime.config.requirepass_hash_set {
        if command.argc == 3 {
            const username_no_pass: &[byte] = command_arg_data(command, 1) catch {
                return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
            };
            if !connection_keyword_eq(username_no_pass, &"default"[0: 7]) {
                const named_password_no_pass: &[byte] = command_arg_data(command, 2) catch {
                    return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
                };
                return connection_authenticate_named_user(tx, username_no_pass, named_password_no_pass);
            }
            tx.authenticated = true;
            connection_set_authenticated_user(tx, &"default"[0: 7]);
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        return connection_auth_no_password_reply();
    }

    var password: &[byte] = connection_reply_empty_slice();
    if command.argc == 2 {
        password = command_arg_data(command, 1) catch {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        };
    } else {
        const username: &[byte] = command_arg_data(command, 1) catch {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        };
        if !connection_keyword_eq(username, &"default"[0: 7]) {
            const named_password: &[byte] = command_arg_data(command, 2) catch {
                return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
            };
            return connection_authenticate_named_user(tx, username, named_password);
        }
        password = command_arg_data(command, 2) catch {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        };
    }

    if !connection_default_password_matches(runtime, password) {
        tx.authenticated = false;
        connection_clear_authenticated_user(tx);
        return connection_wrongpass_reply();
    }
    tx.authenticated = true;
    connection_set_authenticated_user(tx, &"default"[0: 7]);
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_handle_auth(tx: &ConnectionTransaction, runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    const reply: CommandReply = connection_handle_auth_state(tx, runtime, command);
    connection_client_registry_sync(tx);
    return reply;
}

fn connection_authenticate_username_password(tx: &ConnectionTransaction, runtime: &CommandRuntimeInfo, username: &[byte], password: &[byte]) CommandReply {
    const requirepass: &[byte] = connection_requirepass(runtime);
    if !connection_keyword_eq(username, &"default"[0: 7]) {
        return connection_authenticate_named_user(tx, username, password);
    }
    if requirepass.len == 0 && !runtime.config.requirepass_hash_set {
        tx.authenticated = true;
        connection_set_authenticated_user(tx, &"default"[0: 7]);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    if !connection_default_password_matches(runtime, password) {
        tx.authenticated = false;
        connection_clear_authenticated_user(tx);
        return connection_wrongpass_reply();
    }
    tx.authenticated = true;
    connection_set_authenticated_user(tx, &"default"[0: 7]);
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_handle_shutdown(command: &Command) !ConnectionProcessResult {
    if command.argc > 2 {
        return error.CommandInvalidRequest;
    }
    if command.argc == 2 {
        const option: &[byte] = command_arg_data(command, 1) catch {
            return error.CommandInvalidRequest;
        };
        if !connection_keyword_eq(option, &"NOSAVE"[0: 6]) && !connection_keyword_eq(option, &"SAVE"[0: 4]) {
            return error.CommandInvalidRequest;
        }
    }
    return ConnectionProcessResult{
        response_len: 0,
        response_head_len: 0,
        zero_copy_body: connection_reply_empty_slice(),
        zero_copy_tail_len: 0,
        consumed: 0,
        close_after: true,
        request_replicaof: false,
        replicaof_promote: false,
        request_bgsave: false,
        request_aof_rewrite: false,
        request_shutdown: true,
    };
}

fn connection_client_store_name(tx: &ConnectionTransaction, name: &[byte]) !void {
    if name.len > CONNECTION_CLIENT_NAME_MAX || !connection_client_name_valid(name) {
        return error.ConnectionInputTooLarge;
    }
    try connection_client_copy_bytes(tx.client_name[0: CONNECTION_CLIENT_NAME_MAX], name);
    tx.client_name_len = name.len;
}

fn connection_client_store_info(tx: &ConnectionTransaction, target: &[byte], value: &[byte]) !void {
    if value.len > CONNECTION_CLIENT_INFO_MAX {
        return error.ConnectionInputTooLarge;
    }
    if connection_keyword_eq(target, &"LIB-NAME"[0: 8]) {
        try connection_client_copy_bytes(tx.client_lib_name[0: CONNECTION_CLIENT_INFO_MAX], value);
        tx.client_lib_name_len = value.len;
        return;
    }
    if connection_keyword_eq(target, &"LIB-VER"[0: 7]) {
        try connection_client_copy_bytes(tx.client_lib_ver[0: CONNECTION_CLIENT_INFO_MAX], value);
        tx.client_lib_ver_len = value.len;
        return;
    }
    return error.ConnectionInputTooLarge;
}

fn connection_client_tracking_clear(tx: &ConnectionTransaction) void {
    tx.tracking_enabled = false;
    tx.tracking_redirect_id = -1;
    tx.tracking_bcast = false;
    tx.tracking_optin = false;
    tx.tracking_optout = false;
    tx.tracking_noloop = false;
    if tx.tracking_prefixes != null {
        object_free(tx.tracking_prefixes);
    }
    tx.tracking_prefixes = null as &RedisObject;
}

fn connection_himport_wrongtype() CommandReply {
    return connection_error_reply(&"WRONGTYPE Operation against a key holding the wrong kind of value"[0: 65]);
}

fn connection_himport_wrong_arity(subcommand: &[byte]) CommandReply {
    if connection_keyword_eq(subcommand, &"PREPARE"[0: 7]) {
        return connection_error_reply(&"ERR wrong number of arguments for 'himport|prepare' command"[0: 59]);
    }
    if connection_keyword_eq(subcommand, &"SET"[0: 3]) {
        return connection_error_reply(&"ERR wrong number of arguments for 'himport|set' command"[0: 55]);
    }
    if connection_keyword_eq(subcommand, &"DISCARD"[0: 7]) {
        return connection_error_reply(&"ERR wrong number of arguments for 'himport|discard' command"[0: 59]);
    }
    if connection_keyword_eq(subcommand, &"DISCARDALL"[0: 10]) {
        return connection_error_reply(&"ERR wrong number of arguments for 'himport|discardall' command"[0: 62]);
    }
    return connection_error_reply(&"ERR unknown HIMPORT subcommand"[0: 30]);
}

fn connection_himport_append_u32(buf: &Sds, value: usize) !void {
    if value > 0xffffffffusize {
        return error.ConnectionInputTooLarge;
    }
    var encoded: [byte: 4] = [];
    _ = write_u32_be(encoded[0: 4], value as u32);
    try sds_cat(buf, encoded[0: 4]);
}

fn connection_himport_prepare(tx: &ConnectionTransaction, command: &Command) CommandReply {
    if command.argc < 4 {
        return connection_himport_wrong_arity(&"PREPARE"[0: 7]);
    }
    const name: &[byte] = command_arg_data(command, 2) catch {
        return connection_himport_wrong_arity(&"PREPARE"[0: 7]);
    };
    const seen: &RedisObject = create_hash_object() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        object_free(seen);
    }
    var field_index: usize = 3;
    while field_index < command.argc {
        const field: &[byte] = command_arg_data(command, field_index) catch {
            return connection_himport_wrong_arity(&"PREPARE"[0: 7]);
        };
        const inserted: bool = hash_object_set_field(seen, field, connection_reply_empty_slice()) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
        if !inserted {
            return connection_error_reply(&"ERR duplicate field name in fieldset"[0: 36]);
        }
        field_index = field_index + 1;
    }

    var encoded: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&encoded);
    }
    _ = connection_himport_append_u32(&encoded, command.argc - 3) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    field_index = 3;
    while field_index < command.argc {
        const field: &[byte] = command_arg_data(command, field_index) catch {
            return connection_himport_wrong_arity(&"PREPARE"[0: 7]);
        };
        _ = connection_himport_append_u32(&encoded, field.len) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
        _ = sds_cat(&encoded, field) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
        field_index = field_index + 1;
    }

    if tx.himport_fieldsets == null {
        tx.himport_fieldsets = create_hash_object() catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    _ = hash_object_set_field(tx.himport_fieldsets, name, encoded.buf[0: encoded.len]) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_himport_restore_raw(key: &[byte], obj: &RedisObject, now_ms: u64) !Sds {
    var temp_engine: Engine = engine_new();
    defer {
        engine_free(&temp_engine);
    }
    const clone: &RedisObject = try object_clone(obj);
    _ = set_key_at(&temp_engine, key, clone, now_ms) catch |err| {
        object_free(clone);
        return err;
    };
    const payload: &RedisObject = try rdb_dump_object_at(&temp_engine, now_ms);
    defer {
        object_free(payload);
    }

    var raw: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    errdefer {
        sds_free(&raw);
    }
    try connection_sds_append_resp_array_header(&raw, 5);
    try connection_sds_append_resp_bulk(&raw, &"RESTORE"[0: 7]);
    try connection_sds_append_resp_bulk(&raw, key);
    try connection_sds_append_resp_bulk(&raw, &"0"[0: 1]);
    try connection_sds_append_resp_bulk(&raw, payload.value.buf[0: payload.value.len]);
    try connection_sds_append_resp_bulk(&raw, &"REPLACE"[0: 7]);
    return raw;
}

fn connection_himport_lookup_key_or_null(engine: &Engine, key: &[byte], now_ms: u64) &RedisObject {
    return lookup_key_at(engine, key, now_ms) catch {
        return null as &RedisObject;
    };
}

fn connection_himport_propagate(
    runtime: &CommandRuntimeInfo,
    aof: &AofWriter,
    rewrite_buf: &Sds,
    backlog: &ReplicationBacklog,
    raw: &Sds,
    rewrite_failed: &bool,
) !void {
    if aof != null && aof.enabled {
        try aof_append_raw(aof, raw.buf[0: raw.len]);
    }
    if rewrite_buf != null && runtime.aof_rewrite_in_progress {
        _ = sds_cat(rewrite_buf, raw.buf[0: raw.len]) catch {
            if rewrite_failed != null {
                *rewrite_failed = true;
            }
        };
    }
    if backup_is_incrementing(runtime.backup) {
        _ = sds_cat(&runtime.backup.incremental, raw.buf[0: raw.len]) catch {
            backup_capture_failed_at(runtime.backup, now_ms_safe());
        };
    }
    if backlog != null && backlog.active && runtime.replication_role == ReplicationRole.role_master {
        _ = replication_backlog_append_raw(backlog, raw.buf[0: raw.len]) catch {};
    }
}

fn connection_himport_set(
    engine: &Engine,
    runtime: &CommandRuntimeInfo,
    aof: &AofWriter,
    rewrite_buf: &Sds,
    backlog: &ReplicationBacklog,
    tx: &ConnectionTransaction,
    command: &Command,
    now_ms: u64,
    rewrite_failed: &bool,
) CommandReply {
    if command.argc < 5 {
        return connection_himport_wrong_arity(&"SET"[0: 3]);
    }
    const key: &[byte] = command_arg_data(command, 2) catch {
        return connection_himport_wrong_arity(&"SET"[0: 3]);
    };
    const existing: &RedisObject = connection_himport_lookup_key_or_null(engine, key, now_ms);
    if existing != null && existing.obj_type != ObjectType.object_hash {
        return connection_himport_wrongtype();
    }
    const fieldset_name: &[byte] = command_arg_data(command, 3) catch {
        return connection_himport_wrong_arity(&"SET"[0: 3]);
    };
    if tx.himport_fieldsets == null {
        return connection_error_reply(&"ERR no such fieldset"[0: 20]);
    }
    const fieldset: &RedisObject = hash_object_get_field(tx.himport_fieldsets, fieldset_name) catch {
        return connection_error_reply(&"ERR no such fieldset"[0: 20]);
    };
    const encoded: &[byte] = fieldset.value.buf[0: fieldset.value.len];
    if encoded.len < 4 {
        return connection_error_reply(&"ERR invalid fieldset"[0: 20]);
    }
    const field_count: usize = read_u32_be(encoded[0: 4]) as usize;
    if command.argc - 4 != field_count {
        return connection_error_reply(&"ERR value count does not match fieldset field count"[0: 51]);
    }
    if !command_prepare_maxmemory_at(engine, runtime, command, now_ms) {
        return connection_error_reply(&"OOM command not allowed when used memory > 'maxmemory'"[0: 54]);
    }

    const hash: &RedisObject = create_hash_object() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    var hash_owned: bool = true;
    defer {
        if hash_owned {
            object_free(hash);
        }
    }
    var pos: usize = 4;
    var field_index: usize = 0;
    while field_index < field_count {
        if pos + 4 > encoded.len {
            return connection_error_reply(&"ERR invalid fieldset"[0: 20]);
        }
        const field_len: usize = read_u32_be(encoded[pos: 4]) as usize;
        pos = pos + 4;
        if field_len > encoded.len - pos {
            return connection_error_reply(&"ERR invalid fieldset"[0: 20]);
        }
        const value: &[byte] = command_arg_data(command, 4 + field_index) catch {
            return connection_himport_wrong_arity(&"SET"[0: 3]);
        };
        _ = hash_object_set_field(hash, encoded[pos: field_len], value) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
        pos = pos + field_len;
        field_index = field_index + 1;
    }
    if pos != encoded.len {
        return connection_error_reply(&"ERR invalid fieldset"[0: 20]);
    }

    const needs_propagation: bool = (aof != null && aof.enabled) ||
        (rewrite_buf != null && runtime.aof_rewrite_in_progress) ||
        (backlog != null && backlog.active && runtime.replication_role == ReplicationRole.role_master);
    var restore_raw: Sds = Sds{ buf: (null as &byte)[0: 0], len: 0, alloc: 0 };
    if needs_propagation {
        restore_raw = connection_himport_restore_raw(key, hash, now_ms) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    defer {
        if restore_raw.buf.ptr != null {
            sds_free(&restore_raw);
        }
    }

    _ = set_key_at(engine, key, hash, now_ms) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    hash_owned = false;
    _ = clear_key_expire(engine, key);
    if needs_propagation {
        _ = connection_himport_propagate(runtime, aof, rewrite_buf, backlog, &restore_raw, rewrite_failed) catch {
            return connection_error_reply(&"ERR AOF append failed"[0: 21]);
        };
    }
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_himport_discard(tx: &ConnectionTransaction, command: &Command) CommandReply {
    if command.argc != 3 {
        return connection_himport_wrong_arity(&"DISCARD"[0: 7]);
    }
    if tx.himport_fieldsets == null {
        return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), 0);
    }
    const name: &[byte] = command_arg_data(command, 2) catch {
        return connection_himport_wrong_arity(&"DISCARD"[0: 7]);
    };
    const removed: bool = hash_object_delete_field(tx.himport_fieldsets, name) catch {
        return connection_himport_wrongtype();
    };
    const remaining: usize = hash_object_len(tx.himport_fieldsets) catch {
        return connection_himport_wrongtype();
    };
    if remaining == 0 {
        object_free(tx.himport_fieldsets);
        tx.himport_fieldsets = null as &RedisObject;
    }
    return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), removed as i64);
}

fn connection_himport_discardall(tx: &ConnectionTransaction, command: &Command) CommandReply {
    if command.argc != 2 {
        return connection_himport_wrong_arity(&"DISCARDALL"[0: 10]);
    }
    if tx.himport_fieldsets == null {
        return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), 0);
    }
    const removed: usize = hash_object_len(tx.himport_fieldsets) catch {
        return connection_himport_wrongtype();
    };
    object_free(tx.himport_fieldsets);
    tx.himport_fieldsets = null as &RedisObject;
    return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), removed as i64);
}

fn connection_handle_himport_at(
    engine: &Engine,
    runtime: &CommandRuntimeInfo,
    aof: &AofWriter,
    rewrite_buf: &Sds,
    backlog: &ReplicationBacklog,
    tx: &ConnectionTransaction,
    command: &Command,
    now_ms: u64,
    rewrite_failed: &bool,
) CommandReply {
    if command.argc < 2 {
        return connection_himport_wrong_arity(connection_reply_empty_slice());
    }
    const subcommand: &[byte] = command_arg_data(command, 1) catch {
        return connection_himport_wrong_arity(connection_reply_empty_slice());
    };
    if connection_keyword_eq(subcommand, &"PREPARE"[0: 7]) {
        return connection_himport_prepare(tx, command);
    }
    if connection_keyword_eq(subcommand, &"SET"[0: 3]) {
        return connection_himport_set(engine, runtime, aof, rewrite_buf, backlog, tx, command, now_ms, rewrite_failed);
    }
    if connection_keyword_eq(subcommand, &"DISCARD"[0: 7]) {
        return connection_himport_discard(tx, command);
    }
    if connection_keyword_eq(subcommand, &"DISCARDALL"[0: 10]) {
        return connection_himport_discardall(tx, command);
    }
    return connection_himport_wrong_arity(subcommand);
}

fn connection_sds_append_resp_array_header(buf: &Sds, count: usize) !void {
    try sds_cat(buf, &"*"[0: 1]);
    try connection_sds_append_u64(buf, count as u64);
    try sds_cat(buf, &"\r\n"[0: 2]);
}

fn connection_sds_append_resp_map_header(buf: &Sds, count: usize) !void {
    try sds_cat(buf, &"%"[0: 1]);
    try connection_sds_append_u64(buf, count as u64);
    try sds_cat(buf, &"\r\n"[0: 2]);
}

fn connection_sds_append_resp_bulk(buf: &Sds, data: &[byte]) !void {
    try sds_cat(buf, &"$"[0: 1]);
    try connection_sds_append_u64(buf, data.len as u64);
    try sds_cat(buf, &"\r\n"[0: 2]);
    try sds_cat(buf, data);
    try sds_cat(buf, &"\r\n"[0: 2]);
}

fn connection_sds_append_resp_integer(buf: &Sds, value: i64) !void {
    try sds_cat(buf, &":"[0: 1]);
    try connection_sds_append_i64(buf, value);
    try sds_cat(buf, &"\r\n"[0: 2]);
}

fn connection_client_tracking_flag_count(tx: &ConnectionTransaction) usize {
    var count: usize = 0;
    if tx.tracking_enabled {
        count = count + 1;
    }
    if tx.tracking_bcast {
        count = count + 1;
    }
    if tx.tracking_optin {
        count = count + 1;
    }
    if tx.tracking_optout {
        count = count + 1;
    }
    if tx.tracking_noloop {
        count = count + 1;
    }
    return count;
}

fn connection_client_tracking_append_flags(buf: &Sds, tx: &ConnectionTransaction) !void {
    try connection_sds_append_resp_array_header(buf, connection_client_tracking_flag_count(tx));
    if tx.tracking_enabled {
        try connection_sds_append_resp_bulk(buf, &"on"[0: 2]);
    }
    if tx.tracking_bcast {
        try connection_sds_append_resp_bulk(buf, &"bcast"[0: 5]);
    }
    if tx.tracking_optin {
        try connection_sds_append_resp_bulk(buf, &"optin"[0: 5]);
    }
    if tx.tracking_optout {
        try connection_sds_append_resp_bulk(buf, &"optout"[0: 6]);
    }
    if tx.tracking_noloop {
        try connection_sds_append_resp_bulk(buf, &"noloop"[0: 6]);
    }
}

fn connection_client_tracking_append_prefixes(buf: &Sds, tx: &ConnectionTransaction) !void {
    if tx.tracking_prefixes == null {
        try connection_sds_append_resp_array_header(buf, 0);
        return;
    }
    try connection_sds_append_resp_array_header(buf, tx.tracking_prefixes.list_len);
    var node: &ListNode = tx.tracking_prefixes.list_head;
    while node != null {
        const data: &[byte] = node.value.value.buf[0: node.value.value.len];
        try connection_sds_append_resp_bulk(buf, data);
        node = node.next;
    }
}

fn connection_command_client_reply_behavior(command: &Command) ConnectionClientReplyBehavior {
    if command == null || command.info.cmd_type != CommandType.command_client || command.argc < 2 {
        return ConnectionClientReplyBehavior.connection_client_reply_behavior_normal;
    }
    const subcommand: &[byte] = command_arg_data(command, 1) catch {
        return ConnectionClientReplyBehavior.connection_client_reply_behavior_normal;
    };
    if !connection_keyword_eq(subcommand, &"REPLY"[0: 5]) || command.argc != 3 {
        return ConnectionClientReplyBehavior.connection_client_reply_behavior_normal;
    }
    const mode: &[byte] = command_arg_data(command, 2) catch {
        return ConnectionClientReplyBehavior.connection_client_reply_behavior_normal;
    };
    if connection_keyword_eq(mode, &"ON"[0: 2]) {
        return ConnectionClientReplyBehavior.connection_client_reply_behavior_force_reply;
    }
    if connection_keyword_eq(mode, &"OFF"[0: 3]) || connection_keyword_eq(mode, &"SKIP"[0: 4]) {
        return ConnectionClientReplyBehavior.connection_client_reply_behavior_suppress_self;
    }
    return ConnectionClientReplyBehavior.connection_client_reply_behavior_normal;
}

fn connection_apply_client_reply_policy(
    tx: &ConnectionTransaction,
    command: &Command,
    reply_off_before: bool,
    reply_skip_before: bool,
    response_len: usize,
) usize {
    if tx == null {
        return response_len;
    }
    if reply_skip_before {
        tx.reply_skip_next = false;
        return 0;
    }
    const behavior: ConnectionClientReplyBehavior = connection_command_client_reply_behavior(command);
    if behavior == ConnectionClientReplyBehavior.connection_client_reply_behavior_force_reply {
        return response_len;
    }
    if behavior == ConnectionClientReplyBehavior.connection_client_reply_behavior_suppress_self {
        return 0;
    }
    if reply_off_before {
        return 0;
    }
    return response_len;
}

fn connection_encode_reply_for_command(
    tx: &ConnectionTransaction,
    command: &Command,
    reply: &CommandReply,
    out: &byte,
    out_cap: usize,
    reply_off_before: bool,
    reply_skip_before: bool,
) !usize {
    const encoded_len: usize = try connection_encode_reply_with_protocol(reply, out, out_cap, tx.protocol_version);
    return connection_apply_client_reply_policy(tx, command, reply_off_before, reply_skip_before, encoded_len);
}

fn connection_client_help_reply() CommandReply {
    const reply_list: &RedisObject = create_list_object() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT ID"[0: 9]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT GETNAME"[0: 14]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT GETREDIR"[0: 15]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT REPLY <ON|OFF|SKIP>"[0: 26]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT CACHING <YES|NO>"[0: 23]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT SETNAME <name>"[0: 21]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT NO-EVICT <ON|OFF>"[0: 24]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT NO-TOUCH <ON|OFF>"[0: 24]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT INFO"[0: 11]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT LIST [TYPE NORMAL|MASTER|REPLICA|PUBSUB] | [ID <id> ...]"[0: 63]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT KILL [ID <id>] [ADDR <ip:port>] [LADDR <ip:port>] [USER <username>] [TYPE <normal|master|replica|pubsub>] [SKIPME yes|no]"[0: 128]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT KILL <ip:port>"[0: 21]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT UNBLOCK <id> [TIMEOUT|ERROR]"[0: 35]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT PAUSE <timeout-ms> [WRITE|ALL]"[0: 37]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT UNPAUSE"[0: 14]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT TRACKING <ON|OFF> [REDIRECT <id>] [BCAST] [PREFIX <prefix> ...] [OPTIN] [OPTOUT] [NOLOOP]"[0: 96]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT TRACKINGINFO"[0: 19]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT SETINFO LIB-NAME <value>"[0: 31]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    _ = list_object_push_tail(reply_list, &"CLIENT SETINFO LIB-VER <value>"[0: 30]) catch {
        object_free(reply_list);
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_array_reply_owned(reply_list, 18);
}

fn connection_client_info_reply(tx: &ConnectionTransaction, now_ms: u64) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    var multi_count: i64 = -1;
    if tx.active {
        multi_count = tx.queue_count as i64;
    }
    var watch_count: usize = 0;
    if tx.watched != null {
        watch_count = dict_len(&tx.watched.hash_dict);
    }
    const sub_count: usize = connection_pubsub_count_fd_kind(tx.client_fd, false, false);
    const psub_count: usize = connection_pubsub_count_fd_kind(tx.client_fd, true, false);
    const ssub_count: usize = connection_pubsub_count_fd_kind(tx.client_fd, false, true);

    _ = connection_client_registry_append_info_line(
        &raw,
        connection_client_id(tx),
        tx.protocol_version,
        tx.client_fd,
        tx.created_ms,
        tx.last_interaction_ms,
        now_ms,
        tx.command_name[0: tx.command_name_len],
        tx.tracking_redirect_id,
        tx.client_addr[0: tx.client_addr_len],
        tx.client_local_addr[0: tx.client_local_addr_len],
        tx.client_name[0: tx.client_name_len],
        tx.client_lib_name[0: tx.client_lib_name_len],
        tx.client_lib_ver[0: tx.client_lib_ver_len],
        connection_current_username(tx),
        sub_count,
        psub_count,
        ssub_count,
        tx.query_buffer_len,
        tx.query_buffer_capacity,
        tx.output_buffer_len,
        multi_count,
        watch_count,
        connection_transaction_multi_memory(tx),
        connection_client_total_memory(tx),
        tx.total_network_input,
        tx.monitoring,
        tx.blocking_active,
        tx.tracking_enabled,
        tx.tracking_bcast,
        tx.watched != null && tx.watch_engine != null && !connection_transaction_watches_match(tx, tx.watch_engine),
        tx.no_evict_enabled,
        tx.no_touch_enabled,
    ) catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    return connection_bulk_reply_owned(raw.buf[0: raw.len]);
}

fn connection_client_trackinginfo_reply(tx: &ConnectionTransaction) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }

    if tx.protocol_version == 3 {
        _ = connection_sds_append_resp_map_header(&raw, 3) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    } else {
        _ = connection_sds_append_resp_array_header(&raw, 6) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    }
    _ = connection_sds_append_resp_bulk(&raw, &"flags"[0: 5]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    _ = connection_client_tracking_append_flags(&raw, tx) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    _ = connection_sds_append_resp_bulk(&raw, &"redirect"[0: 8]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    _ = connection_sds_append_resp_integer(&raw, tx.tracking_redirect_id) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    _ = connection_sds_append_resp_bulk(&raw, &"prefixes"[0: 8]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    _ = connection_client_tracking_append_prefixes(&raw, tx) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    return connection_raw_reply_owned(raw.buf[0: raw.len]);
}

fn connection_handle_client_tracking(tx: &ConnectionTransaction, command: &Command) CommandReply {
    if command.argc < 3 {
        return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
    }
    const state: &[byte] = command_arg_data(command, 2) catch {
        return connection_error_reply(&"ERR invalid request"[0: 19]);
    };
    if connection_keyword_eq(state, &"OFF"[0: 3]) {
        if command.argc != 3 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        connection_client_tracking_clear(tx);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    if !connection_keyword_eq(state, &"ON"[0: 2]) {
        return connection_error_reply(&"ERR syntax error"[0: 16]);
    }

    var tracking_redirect_id: i64 = -1;
    var tracking_bcast: bool = false;
    var tracking_optin: bool = false;
    var tracking_optout: bool = false;
    var tracking_noloop: bool = false;
    var tracking_prefixes: &RedisObject = null as &RedisObject;
    var tracking_prefixes_owned: bool = true;
    defer {
        if tracking_prefixes_owned && tracking_prefixes != null {
            object_free(tracking_prefixes);
        }
    }

    var index: usize = 3;
    while index < command.argc {
        const option: &[byte] = command_arg_data(command, index) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        if connection_keyword_eq(option, &"REDIRECT"[0: 8]) {
            if index + 1 >= command.argc {
                return connection_error_reply(&"ERR syntax error"[0: 16]);
            }
            const id_arg: &[byte] = command_arg_data(command, index + 1) catch {
                return connection_error_reply(&"ERR invalid request"[0: 19]);
            };
            const redirect_id_u64: u64 = connection_parse_u64(id_arg) catch {
                return connection_error_reply(&"ERR invalid client ID"[0: 21]);
            };
            tracking_redirect_id = redirect_id_u64 as i64;
            if tracking_redirect_id > 0 && !connection_client_registry_has_client_id(tracking_redirect_id) {
                return connection_error_reply(&"ERR invalid client ID"[0: 21]);
            }
            index = index + 2;
            continue;
        }
        if connection_keyword_eq(option, &"BCAST"[0: 5]) {
            tracking_bcast = true;
            index = index + 1;
            continue;
        }
        if connection_keyword_eq(option, &"OPTIN"[0: 5]) {
            if tracking_optout {
                return connection_error_reply(&"ERR syntax error"[0: 16]);
            }
            tracking_optin = true;
            index = index + 1;
            continue;
        }
        if connection_keyword_eq(option, &"OPTOUT"[0: 6]) {
            if tracking_optin {
                return connection_error_reply(&"ERR syntax error"[0: 16]);
            }
            tracking_optout = true;
            index = index + 1;
            continue;
        }
        if connection_keyword_eq(option, &"NOLOOP"[0: 6]) {
            tracking_noloop = true;
            index = index + 1;
            continue;
        }
        if connection_keyword_eq(option, &"PREFIX"[0: 6]) {
            if index + 1 >= command.argc {
                return connection_error_reply(&"ERR syntax error"[0: 16]);
            }
            const prefix: &[byte] = command_arg_data(command, index + 1) catch {
                return connection_error_reply(&"ERR invalid request"[0: 19]);
            };
            if tracking_prefixes == null {
                tracking_prefixes = create_list_object() catch {
                    return connection_error_reply(&"ERR out of memory"[0: 17]);
                };
            }
            _ = list_object_push_tail(tracking_prefixes, prefix) catch {
                return connection_error_reply(&"ERR out of memory"[0: 17]);
            };
            index = index + 2;
            continue;
        }
        return connection_error_reply(&"ERR syntax error"[0: 16]);
    }
    if tracking_prefixes != null && !tracking_bcast {
        return connection_error_reply(&"ERR PREFIX option requires BCAST mode to be enabled"[0: 51]);
    }
    connection_client_tracking_clear(tx);
    tx.tracking_enabled = true;
    tx.tracking_redirect_id = tracking_redirect_id;
    tx.tracking_bcast = tracking_bcast;
    tx.tracking_optin = tracking_optin;
    tx.tracking_optout = tracking_optout;
    tx.tracking_noloop = tracking_noloop;
    tx.tracking_prefixes = tracking_prefixes;
    tracking_prefixes_owned = false;
    return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
}

fn connection_handle_client(tx: &ConnectionTransaction, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
    }
    connection_client_registry_sync(tx);
    const subcommand: &[byte] = command_arg_data(command, 1) catch {
        return connection_error_reply(&"ERR invalid request"[0: 19]);
    };

    if connection_keyword_eq(subcommand, &"ID"[0: 2]) {
        if command.argc != 2 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), connection_client_id(tx));
    }
    if connection_keyword_eq(subcommand, &"GETNAME"[0: 7]) {
        if command.argc != 2 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        if tx.client_name_len == 0 {
            return connection_make_reply(CommandReplyType.reply_null_bulk, connection_reply_empty_slice(), 0);
        }
        return connection_make_reply(CommandReplyType.reply_bulk_string, tx.client_name[0: tx.client_name_len], 0);
    }
    if connection_keyword_eq(subcommand, &"GETREDIR"[0: 8]) {
        if command.argc != 2 {
            return connection_error_reply(&"ERR wrong number of arguments for 'client|getredir' command"[0: 59]);
        }
        return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), tx.tracking_redirect_id);
    }
    if connection_keyword_eq(subcommand, &"REPLY"[0: 5]) {
        if command.argc != 3 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        const mode: &[byte] = command_arg_data(command, 2) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        if connection_keyword_eq(mode, &"ON"[0: 2]) {
            tx.reply_off_enabled = false;
            tx.reply_skip_next = false;
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        if connection_keyword_eq(mode, &"OFF"[0: 3]) {
            tx.reply_off_enabled = true;
            tx.reply_skip_next = false;
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        if connection_keyword_eq(mode, &"SKIP"[0: 4]) {
            if !tx.reply_off_enabled {
                tx.reply_skip_next = true;
            }
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        return connection_error_reply(&"ERR syntax error"[0: 16]);
    }
    if connection_keyword_eq(subcommand, &"SETNAME"[0: 7]) {
        if command.argc != 3 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        const name: &[byte] = command_arg_data(command, 2) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        _ = connection_client_store_name(tx, name) catch {
            return connection_error_reply(&"ERR invalid client name"[0: 23]);
        };
        connection_client_registry_sync(tx);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    if connection_keyword_eq(subcommand, &"CACHING"[0: 7]) {
        if command.argc != 3 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        const state: &[byte] = command_arg_data(command, 2) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        if connection_keyword_eq(state, &"YES"[0: 3]) {
            tx.caching_enabled = true;
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        if connection_keyword_eq(state, &"NO"[0: 2]) {
            tx.caching_enabled = false;
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        return connection_error_reply(&"ERR syntax error"[0: 16]);
    }
    if connection_keyword_eq(subcommand, &"NO-TOUCH"[0: 8]) {
        if command.argc != 3 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        const state: &[byte] = command_arg_data(command, 2) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        if connection_keyword_eq(state, &"ON"[0: 2]) {
            tx.no_touch_enabled = true;
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        if connection_keyword_eq(state, &"OFF"[0: 3]) {
            tx.no_touch_enabled = false;
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        return connection_error_reply(&"ERR syntax error"[0: 16]);
    }
    if connection_keyword_eq(subcommand, &"NO-EVICT"[0: 8]) {
        if command.argc != 3 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        const state: &[byte] = command_arg_data(command, 2) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        if connection_keyword_eq(state, &"ON"[0: 2]) {
            tx.no_evict_enabled = true;
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        if connection_keyword_eq(state, &"OFF"[0: 3]) {
            tx.no_evict_enabled = false;
            return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        }
        return connection_error_reply(&"ERR syntax error"[0: 16]);
    }
    if connection_keyword_eq(subcommand, &"SETINFO"[0: 7]) {
        if command.argc != 4 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        const target: &[byte] = command_arg_data(command, 2) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        const value: &[byte] = command_arg_data(command, 3) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        _ = connection_client_store_info(tx, target, value) catch {
            return connection_error_reply(&"ERR syntax error"[0: 16]);
        };
        connection_client_registry_sync(tx);
        return connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    }
    if connection_keyword_eq(subcommand, &"INFO"[0: 4]) {
        if command.argc != 2 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        return connection_client_info_reply(tx, now_ms);
    }
    if connection_keyword_eq(subcommand, &"LIST"[0: 4]) {
        return connection_client_list_reply(command, now_ms);
    }
    if connection_keyword_eq(subcommand, &"KILL"[0: 4]) {
        if command.argc == 3 {
            const addr: &[byte] = command_arg_data(command, 2) catch {
                return connection_error_reply(&"ERR invalid request"[0: 19]);
            };
            const addr_slot: i32 = connection_client_registry_find_client_addr_slot(addr);
            if addr_slot < 0 || addr_slot >= CONNECTION_CLIENT_REGISTRY_MAX as i32 {
                return connection_error_reply(&"ERR No such client"[0: 18]);
            }
            const addr_slot_index: usize = addr_slot as usize;
            if addr_slot_index >= CONNECTION_CLIENT_REGISTRY_MAX {
                return connection_error_reply(&"ERR No such client"[0: 18]);
            }
            var legacy_reply: CommandReply = connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
            legacy_reply.request_client_kill = true;
            legacy_reply.client_kill_id = connection_client_registry[addr_slot_index].client_id;
            legacy_reply.client_kill_self = legacy_reply.client_kill_id == connection_client_id(tx);
            return legacy_reply;
        }
        if command.argc < 4 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        var target_slot: i32 = -1;
        var has_target: bool = false;
        var target_matches: bool = true;
        var has_laddr: bool = false;
        var laddr_slot: i32 = -1;
        var skip_me: bool = true;
        var kill_user_selector: i32 = CONNECTION_CLIENT_KILL_USER_NONE;
        var kill_type_selector: i32 = CONNECTION_CLIENT_KILL_TYPE_NONE;
        var index: usize = 2;
        while index < command.argc {
            const selector: &[byte] = command_arg_data(command, index) catch {
                return connection_error_reply(&"ERR invalid request"[0: 19]);
            };
            if connection_keyword_eq(selector, &"ID"[0: 2]) {
                if index + 1 >= command.argc {
                    return connection_error_reply(&"ERR syntax error"[0: 16]);
                }
                const id_arg: &[byte] = command_arg_data(command, index + 1) catch {
                    return connection_error_reply(&"ERR invalid request"[0: 19]);
                };
                const target_id_u64: u64 = connection_parse_u64(id_arg) catch {
                    return connection_error_reply(&"ERR invalid client ID"[0: 21]);
                };
                var selector_slot: i32 = -1;
                if target_id_u64 <= 9223372036854775807u64 {
                    selector_slot = connection_client_registry_find_client_id_slot(target_id_u64 as i64);
                }
                if !has_target {
                    target_slot = selector_slot;
                    has_target = true;
                } else if selector_slot != target_slot {
                    target_matches = false;
                }
                index = index + 2;
                continue;
            }
            if connection_keyword_eq(selector, &"TYPE"[0: 4]) {
                if index + 1 >= command.argc {
                    return connection_error_reply(&"ERR syntax error"[0: 16]);
                }
                const client_type: &[byte] = command_arg_data(command, index + 1) catch {
                    return connection_error_reply(&"ERR invalid request"[0: 19]);
                };
                if connection_keyword_eq(client_type, &"NORMAL"[0: 6]) {
                    kill_type_selector = CONNECTION_CLIENT_KILL_TYPE_NORMAL;
                } else if connection_keyword_eq(client_type, &"PUBSUB"[0: 6]) {
                    kill_type_selector = CONNECTION_CLIENT_KILL_TYPE_PUBSUB;
                } else if connection_keyword_eq(client_type, &"MASTER"[0: 6]) ||
                    connection_keyword_eq(client_type, &"REPLICA"[0: 7]) ||
                    connection_keyword_eq(client_type, &"SLAVE"[0: 5]) {
                    kill_type_selector = CONNECTION_CLIENT_KILL_TYPE_REPLICATION;
                } else {
                    return connection_client_unknown_type_reply(client_type);
                }
                index = index + 2;
                continue;
            }
            if connection_keyword_eq(selector, &"ADDR"[0: 4]) {
                if index + 1 >= command.argc {
                    return connection_error_reply(&"ERR syntax error"[0: 16]);
                }
                const addr_arg: &[byte] = command_arg_data(command, index + 1) catch {
                    return connection_error_reply(&"ERR invalid request"[0: 19]);
                };
                const selector_slot: i32 = connection_client_registry_find_client_addr_slot(addr_arg);
                if !has_target {
                    target_slot = selector_slot;
                    has_target = true;
                } else if selector_slot != target_slot {
                    target_matches = false;
                }
                index = index + 2;
                continue;
            }
            if connection_keyword_eq(selector, &"LADDR"[0: 5]) {
                if index + 1 >= command.argc {
                    return connection_error_reply(&"ERR syntax error"[0: 16]);
                }
                const laddr_arg: &[byte] = command_arg_data(command, index + 1) catch {
                    return connection_error_reply(&"ERR invalid request"[0: 19]);
                };
                laddr_slot = connection_client_registry_find_client_local_addr_slot(laddr_arg);
                has_laddr = true;
                index = index + 2;
                continue;
            }
            if connection_keyword_eq(selector, &"USER"[0: 4]) {
                if index + 1 >= command.argc {
                    return connection_error_reply(&"ERR syntax error"[0: 16]);
                }
                const username_arg: &[byte] = command_arg_data(command, index + 1) catch {
                    return connection_error_reply(&"ERR invalid request"[0: 19]);
                };
                const user_selector: i32 = connection_acl_user_selector(username_arg);
                if user_selector < CONNECTION_CLIENT_KILL_USER_DEFAULT {
                    return connection_client_kill_no_such_user_reply(username_arg);
                }
                kill_user_selector = user_selector;
                index = index + 2;
                continue;
            }
            if connection_keyword_eq(selector, &"SKIPME"[0: 6]) {
                if index + 1 >= command.argc {
                    return connection_error_reply(&"ERR syntax error"[0: 16]);
                }
                const skip_arg: &[byte] = command_arg_data(command, index + 1) catch {
                    return connection_error_reply(&"ERR invalid request"[0: 19]);
                };
                if connection_keyword_eq(skip_arg, &"YES"[0: 3]) {
                    skip_me = true;
                } else if connection_keyword_eq(skip_arg, &"NO"[0: 2]) {
                    skip_me = false;
                } else {
                    return connection_error_reply(&"ERR syntax error"[0: 16]);
                }
                index = index + 2;
                continue;
            }
            return connection_error_reply(&"ERR syntax error"[0: 16]);
        }
        if !has_target && !has_laddr && kill_user_selector == CONNECTION_CLIENT_KILL_USER_NONE && kill_type_selector == CONNECTION_CLIENT_KILL_TYPE_NONE {
            return connection_error_reply(&"ERR syntax error"[0: 16]);
        }
        if has_target && (!target_matches || target_slot < 0 || target_slot >= CONNECTION_CLIENT_REGISTRY_MAX as i32) {
            return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), 0);
        }
        var target_slot_index: usize = 0;
        if has_target {
            target_slot_index = target_slot as usize;
            if target_slot_index >= CONNECTION_CLIENT_REGISTRY_MAX {
                return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), 0);
            }
        }
        var laddr_slot_index: usize = 0;
        if has_laddr {
            if laddr_slot < 0 || laddr_slot >= CONNECTION_CLIENT_REGISTRY_MAX as i32 {
                return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), 0);
            }
            laddr_slot_index = laddr_slot as usize;
            if laddr_slot_index >= CONNECTION_CLIENT_REGISTRY_MAX {
                return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), 0);
            }
        }
        const current_id: i64 = connection_client_id(tx);
        var matched: i64 = 0;
        var matched_self: bool = false;
        var scan_index: usize = 0;
        while scan_index < CONNECTION_CLIENT_REGISTRY_MAX {
            if connection_client_registry[scan_index].active &&
                (!has_target || scan_index == target_slot_index) &&
                (!has_laddr || connection_client_registry_slots_share_local_addr(scan_index, laddr_slot_index)) &&
                (kill_user_selector == CONNECTION_CLIENT_KILL_USER_NONE || connection_client_registry_slot_matches_user_selector(scan_index, kill_user_selector)) &&
                connection_client_registry_slot_matches_type_selector(scan_index, kill_type_selector) &&
                (!skip_me || connection_client_registry[scan_index].client_id != current_id) {
                matched = matched + 1;
                if connection_client_registry[scan_index].client_id == current_id {
                    matched_self = true;
                }
            }
            scan_index = scan_index + 1;
        }
        if matched == 0 {
            return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), 0);
        }
        var reply: CommandReply = connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), matched);
        reply.request_client_kill = true;
        if has_target {
            reply.client_kill_id = connection_client_registry[target_slot_index].client_id;
        }
        if has_laddr {
            reply.client_kill_laddr_id = connection_client_registry[laddr_slot_index].client_id;
        }
        reply.client_kill_user_selector = kill_user_selector;
        reply.client_kill_type_selector = kill_type_selector;
        reply.client_kill_self = matched_self;
        return reply;
    }
    if connection_keyword_eq(subcommand, &"UNBLOCK"[0: 7]) {
        if command.argc != 3 && command.argc != 4 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        const id_arg: &[byte] = command_arg_data(command, 2) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        const target_id_u64: u64 = connection_parse_u64(id_arg) catch {
            return connection_error_reply(&"ERR invalid client ID"[0: 21]);
        };
        var unblock_error: bool = false;
        if command.argc == 4 {
            const mode: &[byte] = command_arg_data(command, 3) catch {
                return connection_error_reply(&"ERR invalid request"[0: 19]);
            };
            if connection_keyword_eq(mode, &"TIMEOUT"[0: 7]) {
                unblock_error = false;
            } else if connection_keyword_eq(mode, &"ERROR"[0: 5]) {
                unblock_error = true;
            } else {
                return connection_error_reply(&"ERR syntax error"[0: 16]);
            }
        }
        const target_id: i64 = target_id_u64 as i64;
        if target_id == connection_client_id(tx) || !connection_client_registry_has_client_id(target_id) {
            return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), 0);
        }
        var unblock_reply: CommandReply = connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), 1);
        unblock_reply.request_client_kill = true;
        unblock_reply.client_kill_id = target_id;
        unblock_reply.client_pause_timeout_ms = 1u64;
        unblock_reply.client_pause_write_only = unblock_error;
        return unblock_reply;
    }
    if connection_keyword_eq(subcommand, &"PAUSE"[0: 5]) {
        if command.argc != 3 && command.argc != 4 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        const timeout_arg: &[byte] = command_arg_data(command, 2) catch {
            return connection_error_reply(&"ERR invalid request"[0: 19]);
        };
        const timeout_ms: u64 = connection_parse_u64(timeout_arg) catch {
            return connection_error_reply(&"ERR timeout is not an integer or out of range"[0: 45]);
        };
        var write_only: bool = false;
        if command.argc == 4 {
            const mode: &[byte] = command_arg_data(command, 3) catch {
                return connection_error_reply(&"ERR invalid request"[0: 19]);
            };
            if connection_keyword_eq(mode, &"WRITE"[0: 5]) {
                write_only = true;
            } else if !connection_keyword_eq(mode, &"ALL"[0: 3]) {
                return connection_error_reply(&"ERR syntax error"[0: 16]);
            }
        }
        var reply: CommandReply = connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        reply.request_client_pause = true;
        reply.client_pause_timeout_ms = timeout_ms;
        reply.client_pause_write_only = write_only;
        reply.client_pause_owner_id = connection_client_id(tx);
        _ = now_ms;
        return reply;
    }
    if connection_keyword_eq(subcommand, &"UNPAUSE"[0: 7]) {
        if command.argc != 2 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        var reply: CommandReply = connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        reply.request_client_unpause = true;
        return reply;
    }
    if connection_keyword_eq(subcommand, &"TRACKING"[0: 8]) {
        return connection_handle_client_tracking(tx, command);
    }
    if connection_keyword_eq(subcommand, &"TRACKINGINFO"[0: 12]) {
        if command.argc != 2 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        return connection_client_trackinginfo_reply(tx);
    }
    if connection_keyword_eq(subcommand, &"HELP"[0: 4]) {
        if command.argc != 2 {
            return connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
        }
        return connection_client_help_reply();
    }

    return connection_error_reply(&"ERR unknown CLIENT subcommand"[0: 29]);
}

export fn connection_pubsub_reset_for_test() void {
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        connection_pubsub_subscriptions[i].active = false;
        connection_pubsub_subscriptions[i].fd = -1;
        connection_pubsub_subscriptions[i].is_pattern = false;
        connection_pubsub_subscriptions[i].is_shard = false;
        connection_pubsub_subscriptions[i].channel_len = 0;
        connection_pubsub_subscriptions[i].protocol_version = 2;
        i = i + 1;
    }
}

fn connection_pubsub_channel_eq(slot: &ConnectionPubSubSubscription, channel: &[byte]) bool {
    if slot.channel_len != channel.len {
        return false;
    }
    var i: usize = 0;
    while i < channel.len {
        if slot.channel[i] != channel.ptr[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn connection_pubsub_pattern_match(pattern: &[byte], pattern_index: usize, channel: &[byte], channel_index: usize) bool {
    if pattern_index == pattern.len {
        return channel_index == channel.len;
    }

    const current: byte = pattern.ptr[pattern_index];
    if current == 42 as byte {
        var next_index: usize = pattern_index;
        while next_index < pattern.len && pattern.ptr[next_index] == 42 as byte {
            next_index = next_index + 1;
        }
        if next_index == pattern.len {
            return true;
        }
        var scan: usize = channel_index;
        while scan <= channel.len {
            if connection_pubsub_pattern_match(pattern, next_index, channel, scan) {
                return true;
            }
            if scan == channel.len {
                break;
            }
            scan = scan + 1;
        }
        return false;
    }

    if channel_index >= channel.len {
        return false;
    }

    if current == 63 as byte {
        return connection_pubsub_pattern_match(pattern, pattern_index + 1, channel, channel_index + 1);
    }

    if current != channel.ptr[channel_index] {
        return false;
    }
    return connection_pubsub_pattern_match(pattern, pattern_index + 1, channel, channel_index + 1);
}

fn connection_pubsub_copy_channel(slot: &ConnectionPubSubSubscription, channel: &[byte]) void {
    slot.channel_len = channel.len;
    var i: usize = 0;
    while i < channel.len && i < CONNECTION_PUBSUB_CHANNEL_MAX {
        slot.channel[i] = channel.ptr[i];
        i = i + 1;
    }
}

fn connection_pubsub_register(fd: i32, protocol_version: i32, channel: &[byte], is_pattern: bool, is_shard: bool) !bool {
    if channel.len > CONNECTION_PUBSUB_CHANNEL_MAX {
        return error.ConnectionInputTooLarge;
    }
    if fd < 0 {
        return true;
    }

    var free_index: i32 = -1;
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        if connection_pubsub_subscriptions[i].active {
            if connection_pubsub_subscriptions[i].fd == fd &&
                connection_pubsub_subscriptions[i].is_pattern == is_pattern &&
                connection_pubsub_subscriptions[i].is_shard == is_shard &&
                connection_pubsub_channel_eq(&connection_pubsub_subscriptions[i], channel) {
                connection_pubsub_subscriptions[i].protocol_version = protocol_version;
                return false;
            }
        } else if free_index < 0 {
            free_index = i as i32;
        }
        i = i + 1;
    }
    if free_index < 0 {
        return error.ConnectionOutputTooSmall;
    }

    const slot: usize = free_index as usize;
    if slot >= CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        return error.ConnectionOutputTooSmall;
    }
    connection_pubsub_subscriptions[slot].active = true;
    connection_pubsub_subscriptions[slot].fd = fd;
    connection_pubsub_subscriptions[slot].is_pattern = is_pattern;
    connection_pubsub_subscriptions[slot].is_shard = is_shard;
    connection_pubsub_subscriptions[slot].protocol_version = protocol_version;
    connection_pubsub_copy_channel(&connection_pubsub_subscriptions[slot], channel);
    return true;
}

fn connection_pubsub_unregister_channel(fd: i32, channel: &[byte], is_pattern: bool, is_shard: bool) bool {
    if fd < 0 {
        return true;
    }
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        if connection_pubsub_subscriptions[i].active &&
            connection_pubsub_subscriptions[i].fd == fd &&
            connection_pubsub_subscriptions[i].is_pattern == is_pattern &&
            connection_pubsub_subscriptions[i].is_shard == is_shard &&
            connection_pubsub_channel_eq(&connection_pubsub_subscriptions[i], channel) {
            connection_pubsub_subscriptions[i].active = false;
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn connection_pubsub_unregister_fd_kind(fd: i32, is_pattern: bool, is_shard: bool) usize {
    var removed: usize = 0;
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        if connection_pubsub_subscriptions[i].active &&
            connection_pubsub_subscriptions[i].fd == fd &&
            connection_pubsub_subscriptions[i].is_pattern == is_pattern &&
            connection_pubsub_subscriptions[i].is_shard == is_shard {
            connection_pubsub_subscriptions[i].active = false;
            removed = removed + 1;
        }
        i = i + 1;
    }
    return removed;
}

fn connection_pubsub_count_fd_kind(fd: i32, is_pattern: bool, is_shard: bool) usize {
    if fd < 0 {
        return 0;
    }
    var count: usize = 0;
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        if connection_pubsub_subscriptions[i].active &&
            connection_pubsub_subscriptions[i].fd == fd &&
            connection_pubsub_subscriptions[i].is_pattern == is_pattern &&
            connection_pubsub_subscriptions[i].is_shard == is_shard {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

export fn connection_pubsub_unregister_fd(fd: i32) void {
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        if connection_pubsub_subscriptions[i].active && connection_pubsub_subscriptions[i].fd == fd {
            connection_pubsub_subscriptions[i].active = false;
        }
        i = i + 1;
    }
}

fn connection_pubsub_count_channel(channel: &[byte]) usize {
    var count: usize = 0;
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        if connection_pubsub_subscriptions[i].active &&
            !connection_pubsub_subscriptions[i].is_pattern &&
            !connection_pubsub_subscriptions[i].is_shard &&
            connection_pubsub_channel_eq(&connection_pubsub_subscriptions[i], channel) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn connection_pubsub_count_shard_channel(channel: &[byte]) usize {
    var count: usize = 0;
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        if connection_pubsub_subscriptions[i].active &&
            connection_pubsub_subscriptions[i].is_shard &&
            connection_pubsub_channel_eq(&connection_pubsub_subscriptions[i], channel) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn connection_pubsub_count_patterns() usize {
    var count: usize = 0;
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        if connection_pubsub_subscriptions[i].active && connection_pubsub_subscriptions[i].is_pattern {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn connection_pubsub_is_unique_direct_channel(index: usize) bool {
    if index >= CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        return false;
    }
    if !connection_pubsub_subscriptions[index].active || connection_pubsub_subscriptions[index].is_pattern || connection_pubsub_subscriptions[index].is_shard {
        return false;
    }
    const channel: &[byte] = connection_pubsub_subscriptions[index].channel[0: connection_pubsub_subscriptions[index].channel_len];
    var scan: usize = 0;
    while scan < index {
        if connection_pubsub_subscriptions[scan].active &&
            !connection_pubsub_subscriptions[scan].is_pattern &&
            !connection_pubsub_subscriptions[scan].is_shard &&
            connection_pubsub_channel_eq(&connection_pubsub_subscriptions[scan], channel) {
            return false;
        }
        scan = scan + 1;
    }
    return true;
}

fn connection_pubsub_is_unique_shard_channel(index: usize) bool {
    if index >= CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        return false;
    }
    if !connection_pubsub_subscriptions[index].active || !connection_pubsub_subscriptions[index].is_shard {
        return false;
    }
    const channel: &[byte] = connection_pubsub_subscriptions[index].channel[0: connection_pubsub_subscriptions[index].channel_len];
    var scan: usize = 0;
    while scan < index {
        if connection_pubsub_subscriptions[scan].active &&
            connection_pubsub_subscriptions[scan].is_shard &&
            connection_pubsub_channel_eq(&connection_pubsub_subscriptions[scan], channel) {
            return false;
        }
        scan = scan + 1;
    }
    return true;
}

fn connection_pubsub_channel_matches_pattern(channel: &[byte], pattern: &[byte], has_pattern: bool) bool {
    if !has_pattern {
        return true;
    }
    return connection_pubsub_pattern_match(pattern, 0, channel, 0);
}

fn connection_pubsub_count_matching_direct_channels(pattern: &[byte], has_pattern: bool) usize {
    var count: usize = 0;
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        if connection_pubsub_is_unique_direct_channel(i) {
            const channel: &[byte] = connection_pubsub_subscriptions[i].channel[0: connection_pubsub_subscriptions[i].channel_len];
            if connection_pubsub_channel_matches_pattern(channel, pattern, has_pattern) {
                count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

fn connection_pubsub_count_matching_shard_channels(pattern: &[byte], has_pattern: bool) usize {
    var count: usize = 0;
    var i: usize = 0;
    while i < CONNECTION_PUBSUB_MAX_SUBSCRIPTIONS {
        if connection_pubsub_is_unique_shard_channel(i) {
            const channel: &[byte] = connection_pubsub_subscriptions[i].channel[0: connection_pubsub_subscriptions[i].channel_len];
            if connection_pubsub_channel_matches_pattern(channel, pattern, has_pattern) {
                count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

fn connection_pubsub_append_bulk(buf: &Sds, data: &[byte]) !void {
    try sds_cat(buf, &"$"[0: 1]);
    try connection_sds_append_u64(buf, data.len as u64);
    try sds_cat(buf, &"\r\n"[0: 2]);
    try sds_cat(buf, data);
    try sds_cat(buf, &"\r\n"[0: 2]);
}

fn connection_pubsub_append_event(buf: &Sds, prefix: &[byte], kind: &[byte], channel: &[byte], value: &[byte], count: usize, has_value: bool) !void {
    try sds_cat(buf, prefix);
    try connection_pubsub_append_bulk(buf, kind);
    try connection_pubsub_append_bulk(buf, channel);
    if has_value {
        try connection_pubsub_append_bulk(buf, value);
    } else {
        try sds_cat(buf, &":"[0: 1]);
        try connection_sds_append_u64(buf, count as u64);
        try sds_cat(buf, &"\r\n"[0: 2]);
    }
}

fn connection_pubsub_append_pattern_event(buf: &Sds, prefix: &[byte], kind: &[byte], pattern: &[byte], channel: &[byte], value: &[byte]) !void {
    try sds_cat(buf, prefix);
    try connection_pubsub_append_bulk(buf, kind);
    try connection_pubsub_append_bulk(buf, pattern);
    try connection_pubsub_append_bulk(buf, channel);
    try connection_pubsub_append_bulk(buf, value);
}

fn connection_pubsub_subscription_reply(kind: &[byte], channel: &[byte], count: usize, protocol_version: i32) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    if protocol_version == 3 {
        _ = connection_pubsub_append_event(&raw, &">3\r\n"[0: 4], kind, channel, connection_reply_empty_slice(), count, false) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    } else {
        _ = connection_pubsub_append_event(&raw, &"*3\r\n"[0: 4], kind, channel, connection_reply_empty_slice(), count, false) catch {
            return connection_error_reply(&"ERR out of memory"[0: 17]);
        };
    }
    return connection_raw_reply_owned(raw.buf[0: raw.len]);
}

fn connection_pubsub_unsubscribe_all_reply(kind: &[byte], protocol_version: i32) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
        sds_free(&raw);
    }
    if protocol_version == 3 {
        _ = sds_cat(&raw, &">3\r\n"[0: 4]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
        _ = connection_pubsub_append_bulk(&raw, kind) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
        _ = sds_cat(&raw, &"_\r\n:0\r\n"[0: 8]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    } else {
        _ = sds_cat(&raw, &"*3\r\n"[0: 4]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
        _ = connection_pubsub_append_bulk(&raw, kind) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
        _ = sds_cat(&raw, &"$-1\r\n:0\r\n"[0: 10]) catch { return connection_error_reply(&"ERR out of memory"[0: 17]); };
    }
    return connection_raw_reply_owned(raw.buf[0: raw.len]);
}

fn connection_pubsub_message_raw(channel: &[byte], message: &[byte], protocol_version: i32) CommandReply {
    var raw: Sds = sds_empty() catch {
        return connection_error_reply(&"ERR out of memory"[0: 17]);
    };
    defer {
