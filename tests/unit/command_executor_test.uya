    resp_value_free(&smove_new_destination_parsed.value);

    var src_exists_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nEXISTS\r\n$3\r\nsrc\r\n"[0: 25]);
    const src_exists_command: Command = try command_executor_test_command(&router, &src_exists_parsed);
    const src_exists_reply: CommandReply = command_execute_at(&engine, &src_exists_command, 1000u64);
    try assert_eq_i32(src_exists_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(src_exists_reply.integer as i32, 0);
    resp_value_free(&src_exists_parsed.value);

    var fresh_members_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nSMEMBERS\r\n$5\r\nfresh\r\n"[0: 29]);
    const fresh_members_command: Command = try command_executor_test_command(&router, &fresh_members_parsed);
    var fresh_members_reply: CommandReply = command_execute_at(&engine, &fresh_members_command, 1000u64);
    const fresh_members_len: usize = try connection_encode_reply(&fresh_members_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: fresh_members_len], &"*1\r\n$1\r\na\r\n"[0: 11]));
    command_reply_cleanup(&fresh_members_reply);
    resp_value_free(&fresh_members_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_zadd_zrem_zrange() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var zadd_parsed: RespParseResult = try parse_resp2(&"*8\r\n$4\r\nZADD\r\n$4\r\nzset\r\n$1\r\n2\r\n$1\r\nb\r\n$1\r\n1\r\n$1\r\na\r\n$1\r\n3\r\n$1\r\nc\r\n"[0: 66]);
    const zadd_command: Command = try command_executor_test_command(&router, &zadd_parsed);
    const zadd_reply: CommandReply = command_execute_at(&engine, &zadd_command, 1000u64);
    try assert_eq_i32(zadd_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(zadd_reply.integer as i32, 3);
    resp_value_free(&zadd_parsed.value);

    var zrange_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nZRANGE\r\n$4\r\nzset\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 41]);
    const zrange_command: Command = try command_executor_test_command(&router, &zrange_parsed);
    var zrange_reply: CommandReply = command_execute_at(&engine, &zrange_command, 1000u64);
    try assert_eq_i32(zrange_reply.typ as i32, CommandReplyType.reply_array_bulk as i32);
    const zrange_len: usize = try connection_encode_reply(&zrange_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zrange_len], &"*3\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 25]));
    command_reply_cleanup(&zrange_reply);
    resp_value_free(&zrange_parsed.value);

    var zrange_scores_parsed: RespParseResult = try parse_resp2(&"*5\r\n$6\r\nZRANGE\r\n$4\r\nzset\r\n$1\r\n0\r\n$1\r\n1\r\n$10\r\nWITHSCORES\r\n"[0: 57]);
    const zrange_scores_command: Command = try command_executor_test_command(&router, &zrange_scores_parsed);
    var zrange_scores_reply: CommandReply = command_execute_at(&engine, &zrange_scores_command, 1000u64);
    const zrange_scores_len: usize = try connection_encode_reply(&zrange_scores_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zrange_scores_len], &"*4\r\n$1\r\na\r\n$1\r\n1\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 32]));
    command_reply_cleanup(&zrange_scores_reply);
    resp_value_free(&zrange_scores_parsed.value);

    var zrange_rev_parsed: RespParseResult = try parse_resp2(&"*5\r\n$6\r\nZRANGE\r\n$4\r\nzset\r\n$1\r\n0\r\n$2\r\n-1\r\n$3\r\nREV\r\n"[0: 50]);
    const zrange_rev_command: Command = try command_executor_test_command(&router, &zrange_rev_parsed);
    var zrange_rev_reply: CommandReply = command_execute_at(&engine, &zrange_rev_command, 1000u64);
    const zrange_rev_len: usize = try connection_encode_reply(&zrange_rev_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zrange_rev_len], &"*3\r\n$1\r\nc\r\n$1\r\nb\r\n$1\r\na\r\n"[0: 25]));
    command_reply_cleanup(&zrange_rev_reply);
    resp_value_free(&zrange_rev_parsed.value);

    var zrange_rev_scores_parsed: RespParseResult = try parse_resp2(&"*6\r\n$6\r\nZRANGE\r\n$4\r\nzset\r\n$1\r\n0\r\n$1\r\n1\r\n$3\r\nREV\r\n$10\r\nWITHSCORES\r\n"[0: 66]);
    const zrange_rev_scores_command: Command = try command_executor_test_command(&router, &zrange_rev_scores_parsed);
    var zrange_rev_scores_reply: CommandReply = command_execute_at(&engine, &zrange_rev_scores_command, 1000u64);
    const zrange_rev_scores_len: usize = try connection_encode_reply(&zrange_rev_scores_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zrange_rev_scores_len], &"*4\r\n$1\r\nc\r\n$1\r\n3\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 32]));
    command_reply_cleanup(&zrange_rev_scores_reply);
    resp_value_free(&zrange_rev_scores_parsed.value);

    var zrange_byscore_parsed: RespParseResult = try parse_resp2(&"*5\r\n$6\r\nZRANGE\r\n$4\r\nzset\r\n$1\r\n2\r\n$1\r\n3\r\n$7\r\nBYSCORE\r\n"[0: 53]);
