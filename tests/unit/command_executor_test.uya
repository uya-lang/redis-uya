export fn test_command_hash_field_ttl_partial() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var hset_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nHSET\r\n$4\r\nhash\r\n$5\r\nfield\r\n$5\r\nvalue\r\n"[0: 46]);
    const hset_command: Command = try command_executor_test_command(&router, &hset_parsed);
    _ = command_execute_at(&engine, &hset_command, 1000u64);
    resp_value_free(&hset_parsed.value);

    var hgetex_parsed: RespParseResult = try parse_resp2(&"*6\r\n$6\r\nHGETEX\r\n$4\r\nhash\r\n$6\r\nFIELDS\r\n$1\r\n2\r\n$5\r\nfield\r\n$7\r\nmissing\r\n"[0: 69]);
    const hgetex_command: Command = try command_executor_test_command(&router, &hgetex_parsed);
    var hgetex_reply: CommandReply = command_execute_at(&engine, &hgetex_command, 1000u64);
    const hgetex_len: usize = try connection_encode_reply(&hgetex_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: hgetex_len], &"*2\r\n$5\r\nvalue\r\n$-1\r\n"[0: 20]));
    command_reply_cleanup(&hgetex_reply);
    resp_value_free(&hgetex_parsed.value);

    var hgetex_ex_parsed: RespParseResult = try parse_resp2(&"*8\r\n$6\r\nHGETEX\r\n$4\r\nhash\r\n$2\r\nEX\r\n$2\r\n10\r\n$6\r\nFIELDS\r\n$1\r\n2\r\n$5\r\nfield\r\n$7\r\nmissing\r\n"[0: 85]);
    const hgetex_ex_command: Command = try command_executor_test_command(&router, &hgetex_ex_parsed);
    var hgetex_ex_reply: CommandReply = command_execute_at(&engine, &hgetex_ex_command, 1000u64);
    const hgetex_ex_len: usize = try connection_encode_reply(&hgetex_ex_reply, &out[0], 256);
