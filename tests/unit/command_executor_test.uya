    resp_value_free(&keys_k_parsed.value);

    var keys_q_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nKEYS\r\n$1\r\n?\r\n"[0: 21]);
    const keys_q_command: Command = try command_executor_test_command(&router, &keys_q_parsed);
    var keys_q_reply: CommandReply = command_execute_at(&engine, &keys_q_command, 1000u64);
    const keys_q_len: usize = try connection_encode_reply(&keys_q_reply, &out[0], 256);
