    try assert_true(network_connection_slice_eq(out[0: getbit_result.response_len], &":0\r\n"[0: 4]));

    const setbit_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$6\r\nSETBIT\r\n$3\r\nkey\r\n$1\r\n1\r\n$1\r\n1\r\n"[0: 39], &out[0], 256, 1000u64);
