    try assert_true(command_executor_test_slice_eq(incrbyfloat_missing_reply.data, &"1.5"[0: 3]));
    resp_value_free(&incrbyfloat_missing_parsed.value);

    var incrbyfloat_existing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$11\r\nINCRBYFLOAT\r\n$8\r\nfcounter\r\n$1\r\n2\r\n"[0: 43]);
    const incrbyfloat_existing_command: Command = try command_executor_test_command(&router, &incrbyfloat_existing_parsed);
    const incrbyfloat_existing_reply: CommandReply = command_execute_at(&engine, &incrbyfloat_existing_command, 1000u64);
    try assert_eq_i32(incrbyfloat_existing_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(incrbyfloat_existing_reply.data, &"3.5"[0: 3]));
    resp_value_free(&incrbyfloat_existing_parsed.value);

    var setnx_parsed: RespParseResult = try parse_resp2(&"*3\r\n$5\r\nSETNX\r\n$6\r\nnx-key\r\n$5\r\nfirst\r\n"[0: 40]);
    const setnx_command: Command = try command_executor_test_command(&router, &setnx_parsed);
    const setnx_reply: CommandReply = command_execute_at(&engine, &setnx_command, 1000u64);
