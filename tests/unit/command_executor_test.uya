    try assert_true(command_executor_test_slice_eq(slowlog_reset_reply.data, &"OK"[0: 2]));
    resp_value_free(&slowlog_reset_parsed.value);

    var slowlog_len_zero_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nSLOWLOG\r\n$3\r\nLEN\r\n"[0: 26]);
