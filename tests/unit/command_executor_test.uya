    const msetex_bad_ttl_reply: CommandReply = command_execute_at(&engine, &msetex_bad_ttl_command, 1000u64);
    try assert_eq_i32(msetex_bad_ttl_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&msetex_bad_ttl_parsed.value);

    var msetex_bad_numkeys_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nMSETEX\r\n$1\r\n2\r\n$3\r\nbad\r\n$1\r\nv\r\n"[0: 39]);
