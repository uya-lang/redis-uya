export fn test_command_lolwut() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();

    var default_parsed: RespParseResult = try parse_resp2(&"*1\r\n$6\r\nLOLWUT\r\n"[0: 16]);
    const default_command: Command = try command_executor_test_command(&router, &default_parsed);
    var default_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &default_command, 1000u64);
    try assert_eq_i32(default_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_contains(default_reply.data, &"redis-uya LOLWUT partial"[0: 24]));
    try assert_true(command_executor_test_contains(default_reply.data, &"Redis ver. v0.9.1-dev"[0: 21]));
    command_reply_cleanup(&default_reply);
    resp_value_free(&default_parsed.value);

    var version_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nLOLWUT\r\n$7\r\nVERSION\r\n$1\r\n5\r\n"[0: 36]);
