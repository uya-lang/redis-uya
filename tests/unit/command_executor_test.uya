    var copy_same_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nCOPY\r\n$4\r\nnext\r\n$4\r\nnext\r\n"[0: 34]);
    const copy_same_command: Command = try command_executor_test_command(&router, &copy_same_parsed);
    const copy_same_reply: CommandReply = command_execute_at(&engine, &copy_same_command, 1000u64);
    try assert_eq_i32(copy_same_reply.typ as i32, CommandReplyType.reply_error as i32);
