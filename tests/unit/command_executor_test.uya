    const missing_getdel_reply: CommandReply = command_execute_at(&engine, &missing_getdel_command, 1000u64);
    try assert_eq_i32(missing_getdel_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&missing_getdel_parsed.value);

    var missing_type_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nTYPE\r\n$3\r\nkey\r\n"[0: 23]);
    const missing_type_command: Command = try command_executor_test_command(&router, &missing_type_parsed);
    const missing_type_reply: CommandReply = command_execute_at(&engine, &missing_type_command, 1000u64);
    try assert_eq_i32(missing_type_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(missing_type_reply.data, &"none"[0: 4]));
    resp_value_free(&missing_type_parsed.value);

    var empty_dbsize_parsed: RespParseResult = try parse_resp2(&"*1\r\n$6\r\nDBSIZE\r\n"[0: 16]);
    const empty_dbsize_command: Command = try command_executor_test_command(&router, &empty_dbsize_parsed);
