    var msetex_bad_condition_parsed: RespParseResult = try parse_resp2(&"*6\r\n$6\r\nMSETEX\r\n$1\r\n1\r\n$3\r\nbad\r\n$1\r\nv\r\n$2\r\nNX\r\n$2\r\nXX\r\n"[0: 55]);
