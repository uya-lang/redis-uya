    command_reply_cleanup(&hmset_hmget_reply);
    resp_value_free(&hmset_hmget_parsed.value);

    var hmset_hdel_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nHDEL\r\n$4\r\nhash\r\n$5\r\nmulti\r\n$6\r\nsecond\r\n"[0: 47]);
    const hmset_hdel_command: Command = try command_executor_test_command(&router, &hmset_hdel_parsed);
    const hmset_hdel_reply: CommandReply = command_execute_at(&engine, &hmset_hdel_command, 1000u64);
    try assert_eq_i32(hmset_hdel_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(hmset_hdel_reply.integer as i32, 2);
    resp_value_free(&hmset_hdel_parsed.value);

    var hsetnx_new_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nHSETNX\r\n$4\r\nhash\r\n$5\r\nextra\r\n$5\r\nvalue\r\n"[0: 48]);
