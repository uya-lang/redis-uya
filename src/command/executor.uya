    _ = list_object_push_tail(reply_list, &"fast"[0: 4]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"slow"[0: 4]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"blocking"[0: 8]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"dangerous"[0: 9]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"connection"[0: 10]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"transaction"[0: 11]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"scripting"[0: 9]) catch { object_free(reply_list); return command_executor_oom(); };
    return command_executor_owned_array(reply_list);
}

fn command_executor_acl_cat_commands(category: &[byte]) CommandReply {
    if !command_executor_acl_category_known(category) {
        return command_executor_acl_unknown_category(category);
    }

    const router: CommandRouter = command_router_new();
    var reply_list: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    var index: usize = 0;
    while index < command_catalog_total_count() {
        const entry: CommandCatalogEntry = command_catalog_entry(index) catch {
            object_free(reply_list);
            return command_executor_error(&"ERR command catalog error"[0: 25]);
        };
        if command_executor_command_entry_visible(&router, &entry) &&
            command_catalog_has_acl_category(&entry, category) {
            _ = list_object_push_tail(reply_list, entry.name) catch { object_free(reply_list); return command_executor_oom(); };
        }
        index = index + 1;
    }
    return command_executor_owned_array(reply_list);
}

fn command_executor_acl_getuser(command: &Command) CommandReply {
    if command.argc != 3 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'acl|getuser' command"[0: 55]);
    }
    const username: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    if !command_executor_slice_eq(username, &"default"[0: 7]) {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    }
    return command_executor_owned_raw(&"*12\r\n$5\r\nflags\r\n*2\r\n$2\r\non\r\n$6\r\nnopass\r\n$9\r\npasswords\r\n*0\r\n$8\r\ncommands\r\n$5\r\n+@all\r\n$4\r\nkeys\r\n$2\r\n~*\r\n$8\r\nchannels\r\n$2\r\n&*\r\n$9\r\nselectors\r\n*0\r\n"[0: 143]);
}

fn command_executor_acl_log(command: &Command) CommandReply {
    if command.argc == 2 {
        return command_executor_owned_raw(&"*0\r\n"[0: 4]);
    }
    if command.argc == 3 {
        const arg: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(arg, &"RESET"[0: 5]) {
            return command_executor_simple(&"OK"[0: 2]);
        }
        _ = command_executor_parse_i64(arg) catch {
            return command_executor_invalid_integer();
        };
        return command_executor_owned_raw(&"*0\r\n"[0: 4]);
    }
    return command_executor_owned_error(&"ERR unknown subcommand or wrong number of arguments for 'log'. Try ACL HELP."[0: 76]);
}

var command_executor_acl_genpass_counter: u64 = 0u64;

fn command_executor_acl_genpass_hex_nibble(value: u64) byte {
    const nibble: byte = (value & 15u64) as byte;
    if nibble < 10 as byte {
        return (48 as byte) + nibble;
    }
    return (97 as byte) + (nibble - 10 as byte);
}

fn command_executor_acl_genpass_next(state: u64) u64 {
    var value: u64 = state;
    value = value ^ (value << 13);
    value = value ^ (value >> 7);
    value = value ^ (value << 17);
    if value == 0u64 {
        return 0x9e3779b97f4a7c15u64;
    }
    return value;
}

fn command_executor_acl_genpass(command: &Command, now_ms: u64) CommandReply {
    if command.argc > 3 {
        return command_executor_owned_error(&"ERR unknown subcommand or wrong number of arguments for 'GENPASS'. Try ACL HELP."[0: 80]);
    }

    var bits: i64 = 256;
    if command.argc == 3 {
        const bits_arg: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
        bits = command_executor_parse_i64(bits_arg) catch {
            return command_executor_invalid_integer();
        };
        if bits <= 0 || bits > 4096 {
            return command_executor_owned_error(&"ERR ACL GENPASS argument must be the number of bits for the output password, a positive number up to 4096"[0: 105]);
        }
    }

    const hex_len: usize = ((bits as usize) + 3) / 4;
    var password: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&password);
    }
    _ = sds_grow(&password, hex_len) catch {
        return command_executor_oom();
    };

    command_executor_acl_genpass_counter = command_executor_acl_genpass_counter + 1u64;
    var state: u64 = now_ms ^
        ((bits as u64) << 32) ^
        (command_executor_acl_genpass_counter * 0x9e3779b97f4a7c15u64);
    if state == 0u64 {
        state = 0x6a09e667f3bcc909u64;
    }

    var i: usize = 0;
    while i < hex_len {
        state = command_executor_acl_genpass_next(state + i as u64);
        password.buf.ptr[i] = command_executor_acl_genpass_hex_nibble(state);
        i = i + 1;
    }
    password.len = hex_len;
    password.buf.ptr[password.len] = 0 as byte;
    return command_executor_owned_bulk_copy(password.buf[0: password.len]);
}

fn command_executor_acl_file_unconfigured() CommandReply {
    return command_executor_owned_error(&"ERR This Redis instance is not configured to use an ACL file. You may want to specify users via the ACL SETUSER command and then issue a CONFIG REWRITE (assuming you have a Redis configuration file set) in order to store users in the Redis configuration."[0: 254]);
}

fn command_executor_acl_setuser_modifier_error(modifier: &[byte], suffix: &[byte]) CommandReply {
    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR Error in ACL SETUSER modifier '"[0: 35]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, modifier) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, suffix) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_acl_setuser_noop_modifier(modifier: &[byte]) bool {
    if command_executor_keyword_eq(modifier, &"ON"[0: 2]) ||
        command_executor_keyword_eq(modifier, &"NOPASS"[0: 6]) ||
        command_executor_keyword_eq(modifier, &"ALLKEYS"[0: 7]) ||
        command_executor_keyword_eq(modifier, &"ALLCHANNELS"[0: 11]) ||
        command_executor_keyword_eq(modifier, &"ALLCOMMANDS"[0: 11]) ||
        command_executor_keyword_eq(modifier, &"~*"[0: 2]) ||
        command_executor_keyword_eq(modifier, &"&*"[0: 2]) {
        return true;
    }
    if modifier.len > 1 && modifier.ptr[0] == 43 as byte {
        if modifier.len > 2 && modifier.ptr[1] == 64 as byte {
            const category: &[byte] = modifier[2: modifier.len - 2];
            return command_executor_keyword_eq(category, &"all"[0: 3]) ||
                command_executor_acl_category_known(category);
        }
        const command_name: &[byte] = modifier[1: modifier.len - 1];
        const router: CommandRouter = command_router_new();
        _ = command_router_lookup(&router, command_name) catch {
            return false;
        };
        return true;
    }
    return false;
}

fn command_executor_acl_setuser_mutating_modifier(modifier: &[byte]) bool {
    if command_executor_keyword_eq(modifier, &"OFF"[0: 3]) ||
        command_executor_keyword_eq(modifier, &"RESET"[0: 5]) ||
        command_executor_keyword_eq(modifier, &"RESETPASS"[0: 9]) ||
        command_executor_keyword_eq(modifier, &"RESETKEYS"[0: 9]) ||
        command_executor_keyword_eq(modifier, &"RESETCHANNELS"[0: 13]) ||
        command_executor_keyword_eq(modifier, &"CLEARSELECTORS"[0: 14]) ||
        command_executor_keyword_eq(modifier, &"RESETSELECTORS"[0: 14]) {
        return true;
    }
    if modifier.len > 0 {
        const head: byte = modifier.ptr[0];
        return head == 45 as byte ||
            head == 62 as byte ||
            head == 60 as byte ||
            head == 35 as byte ||
            head == 33 as byte ||
            head == 37 as byte ||
            head == 40 as byte;
    }
    return false;
}

fn command_executor_acl_setuser(command: &Command) CommandReply {
    if command.argc < 3 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'acl|setuser' command"[0: 55]);
    }
    const username: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    if !command_executor_keyword_eq(username, &"default"[0: 7]) {
        return command_executor_owned_error(&"ERR ACL SETUSER redis-uya partial only supports the default user"[0: 64]);
    }

    var index: usize = 3;
    while index < command.argc {
        const modifier: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_acl_setuser_noop_modifier(modifier) {
            index = index + 1;
            continue;
        }
        if modifier.len > 1 && modifier.ptr[0] == 43 as byte {
            return command_executor_acl_setuser_modifier_error(modifier, &"': Unknown command or category name in ACL"[0: 42]);
        }
        if command_executor_acl_setuser_mutating_modifier(modifier) {
            return command_executor_owned_error(&"ERR ACL SETUSER redis-uya partial only supports default no-op modifiers"[0: 71]);
        }
        return command_executor_acl_setuser_modifier_error(modifier, &"': Syntax error"[0: 15]);
    }
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_acl_deluser(command: &Command) CommandReply {
    if command.argc < 3 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'acl|deluser' command"[0: 55]);
    }
    var index: usize = 2;
    while index < command.argc {
        const username: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(username, &"default"[0: 7]) {
            return command_executor_owned_error(&"ERR The 'default' user cannot be removed"[0: 40]);
        }
        index = index + 1;
    }
    return command_executor_integer(0);
}

fn command_executor_acl_dryrun_user_missing(username: &[byte]) CommandReply {
    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR User '"[0: 10]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, username) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"' not found"[0: 11]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_acl_dryrun_command_missing(name: &[byte]) CommandReply {
    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR Command '"[0: 13]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, name) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"' not found"[0: 11]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_acl_dryrun_arity_error(name: &[byte]) CommandReply {
    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR wrong number of arguments for '"[0: 35]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, name) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"' command"[0: 9]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_acl_dryrun(command: &Command) CommandReply {
    if command.argc < 4 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'acl|dryrun' command"[0: 54]);
    }
    const username: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    if !command_executor_slice_eq(username, &"default"[0: 7]) {
        return command_executor_acl_dryrun_user_missing(username);
    }
    const dry_command_name: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const router: CommandRouter = command_router_new();
    var dry_info: CommandInfo = command_router_lookup(&router, dry_command_name) catch {
        return command_executor_acl_dryrun_command_missing(dry_command_name);
    };
    _ = command_validate_arity(&dry_info, command.argc - 3) catch {
        return command_executor_acl_dryrun_arity_error(dry_info.name);
    };
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_acl(command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    const subcommand: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    if command_executor_keyword_eq(subcommand, &"HELP"[0: 4]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'acl|help' command"[0: 52]);
        }
        return command_executor_acl_help();
    }
    if command_executor_keyword_eq(subcommand, &"WHOAMI"[0: 6]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'acl|whoami' command"[0: 54]);
        }
        return command_executor_bulk(&"default"[0: 7]);
    }
    if command_executor_keyword_eq(subcommand, &"USERS"[0: 5]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'acl|users' command"[0: 53]);
        }
        var reply_list: &RedisObject = create_list_object() catch {
            return command_executor_oom();
        };
        _ = list_object_push_tail(reply_list, &"default"[0: 7]) catch { object_free(reply_list); return command_executor_oom(); };
        return command_executor_owned_array(reply_list);
    }
    if command_executor_keyword_eq(subcommand, &"LIST"[0: 4]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'acl|list' command"[0: 52]);
        }
        var reply_list: &RedisObject = create_list_object() catch {
            return command_executor_oom();
        };
        _ = list_object_push_tail(reply_list, &"user default on nopass ~* &* +@all"[0: 34]) catch { object_free(reply_list); return command_executor_oom(); };
        return command_executor_owned_array(reply_list);
    }
    if command_executor_keyword_eq(subcommand, &"CAT"[0: 3]) {
        if command.argc == 2 {
            return command_executor_acl_cat_categories();
        }
        if command.argc == 3 {
            const category: &[byte] = command_executor_arg(command, 2) catch {
                return command_executor_wrong_arity();
            };
            return command_executor_acl_cat_commands(category);
        }
        return command_executor_owned_error(&"ERR unknown subcommand or wrong number of arguments for 'cat'. Try ACL HELP."[0: 76]);
    }
    if command_executor_keyword_eq(subcommand, &"GETUSER"[0: 7]) {
        return command_executor_acl_getuser(command);
    }
    if command_executor_keyword_eq(subcommand, &"LOG"[0: 3]) {
        return command_executor_acl_log(command);
    }
    if command_executor_keyword_eq(subcommand, &"GENPASS"[0: 7]) {
        return command_executor_acl_genpass(command, now_ms);
    }
    if command_executor_keyword_eq(subcommand, &"SAVE"[0: 4]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'acl|save' command"[0: 52]);
        }
        return command_executor_acl_file_unconfigured();
    }
    if command_executor_keyword_eq(subcommand, &"LOAD"[0: 4]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'acl|load' command"[0: 52]);
        }
        return command_executor_acl_file_unconfigured();
    }
    if command_executor_keyword_eq(subcommand, &"DELUSER"[0: 7]) {
        return command_executor_acl_deluser(command);
    }
    if command_executor_keyword_eq(subcommand, &"DRYRUN"[0: 6]) {
        return command_executor_acl_dryrun(command);
    }
    if command_executor_keyword_eq(subcommand, &"SETUSER"[0: 7]) {
        return command_executor_acl_setuser(command);
    }

    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR unknown subcommand '"[0: 24]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"'. Try ACL HELP."[0: 16]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_function_list(command: &Command) CommandReply {
    var index: usize = 2;
    var seen_libraryname: bool = false;
    var seen_withcode: bool = false;
    while index < command.argc {
        const token: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(token, &"LIBRARYNAME"[0: 11]) {
            if seen_libraryname || index + 1 >= command.argc {
                return command_executor_syntax_error();
            }
            seen_libraryname = true;
            index = index + 2;
        } else if command_executor_keyword_eq(token, &"WITHCODE"[0: 8]) {
            if seen_withcode {
                return command_executor_syntax_error();
            }
            seen_withcode = true;
            index = index + 1;
        } else {
            return command_executor_syntax_error();
        }
    }
    return command_executor_owned_raw(&"*0\r\n"[0: 4]);
}

fn command_executor_function_stats() CommandReply {
    return command_executor_owned_raw(&"*4\r\n$14\r\nrunning_script\r\n$-1\r\n$7\r\nengines\r\n*2\r\n$3\r\nLUA\r\n*4\r\n$15\r\nlibraries_count\r\n:0\r\n$15\r\nfunctions_count\r\n:0\r\n"[0: 112]);
}

fn command_executor_function_flush(command: &Command) CommandReply {
    if command.argc > 3 {
        return command_executor_owned_error(&"ERR unknown subcommand or wrong number of arguments for 'flush'. Try FUNCTION HELP."[0: 83]);
    }
    if command.argc == 3 {
        const mode: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(mode, &"SYNC"[0: 4]) && !command_executor_keyword_eq(mode, &"ASYNC"[0: 5]) {
            return command_executor_owned_error(&"ERR FUNCTION FLUSH only supports SYNC|ASYNC option"[0: 50]);
        }
    }
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_function_delete(command: &Command) CommandReply {
    if command.argc != 3 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'function|delete' command"[0: 59]);
    }
    return command_executor_owned_error(&"ERR Library not found"[0: 21]);
}

fn command_executor_function_load(command: &Command) CommandReply {
    if command.argc < 3 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'function|load' command"[0: 57]);
    }
    if command.argc > 4 {
        return command_executor_owned_error(&"ERR unknown subcommand or wrong number of arguments for 'LOAD'. Try FUNCTION HELP."[0: 82]);
    }
    if command.argc == 4 {
        const replace: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(replace, &"REPLACE"[0: 7]) {
            return command_executor_syntax_error();
        }
        _ = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
    } else {
        _ = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
    }
    return command_executor_owned_error(&"ERR FUNCTION LOAD is not supported by redis-uya partial"[0: 55]);
}

fn command_executor_function_kill(command: &Command) CommandReply {
    if command.argc != 2 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'function|kill' command"[0: 57]);
    }
    return command_executor_owned_error(&"NOTBUSY No scripts in execution right now."[0: 42]);
}

fn command_executor_function_dump(command: &Command) CommandReply {
    if command.argc != 2 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'function|dump' command"[0: 57]);
    }
    var payload: [byte: 10] = [
        0x0a as byte,
        0x00 as byte,
        0x5d as byte,
        0x9b as byte,
        0x5c as byte,
        0x40 as byte,
        0x0f as byte,
        0x7f as byte,
        0xa2 as byte,
        0xda as byte,
    ];
    return command_executor_owned_bulk_copy(payload[0: 10]);
}

fn command_executor_function_restore_payload_is_empty_dump(payload: &[byte]) bool {
    var expected: [byte: 10] = [
        0x0a as byte,
        0x00 as byte,
        0x5d as byte,
        0x9b as byte,
        0x5c as byte,
        0x40 as byte,
        0x0f as byte,
        0x7f as byte,
        0xa2 as byte,
        0xda as byte,
    ];
    return command_executor_slice_eq(payload, expected[0: 10]);
}

fn command_executor_function_restore(command: &Command) CommandReply {
    if command.argc < 3 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'function|restore' command"[0: 60]);
    }
    if command.argc > 4 {
        return command_executor_owned_error(&"ERR unknown subcommand or wrong number of arguments for 'RESTORE'. Try FUNCTION HELP."[0: 85]);
    }
    const payload: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    if command.argc == 4 {
        const policy: &[byte] = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(policy, &"FLUSH"[0: 5]) &&
            !command_executor_keyword_eq(policy, &"APPEND"[0: 6]) &&
            !command_executor_keyword_eq(policy, &"REPLACE"[0: 7]) {
            return command_executor_owned_error(&"ERR Wrong restore policy given, value should be either FLUSH, APPEND or REPLACE."[0: 80]);
        }
    }
    if !command_executor_function_restore_payload_is_empty_dump(payload) {
        return command_executor_owned_error(&"ERR DUMP payload version or checksum are wrong"[0: 46]);
    }
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_fcall(command: &Command) CommandReply {
    if command.argc < 3 {
        if command.info.cmd_type == CommandType.command_fcall_ro {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'fcall_ro' command"[0: 52]);
        }
        return command_executor_owned_error(&"ERR wrong number of arguments for 'fcall' command"[0: 49]);
    }
    return command_executor_owned_error(&"ERR Function not found"[0: 22]);
}

fn command_executor_function(command: &Command) CommandReply {
    if command.argc < 2 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'function' command"[0: 52]);
    }

    const subcommand: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'function' command"[0: 52]);
    };
    if command_executor_keyword_eq(subcommand, &"HELP"[0: 4]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'function' command"[0: 52]);
        }
        return command_executor_function_help();
    }
    if command_executor_keyword_eq(subcommand, &"LIST"[0: 4]) {
        return command_executor_function_list(command);
    }
    if command_executor_keyword_eq(subcommand, &"STATS"[0: 5]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'function' command"[0: 52]);
        }
        return command_executor_function_stats();
    }
    if command_executor_keyword_eq(subcommand, &"FLUSH"[0: 5]) {
        return command_executor_function_flush(command);
    }
    if command_executor_keyword_eq(subcommand, &"DELETE"[0: 6]) {
        return command_executor_function_delete(command);
    }
    if command_executor_keyword_eq(subcommand, &"LOAD"[0: 4]) {
        return command_executor_function_load(command);
    }
    if command_executor_keyword_eq(subcommand, &"DUMP"[0: 4]) {
        return command_executor_function_dump(command);
    }
    if command_executor_keyword_eq(subcommand, &"RESTORE"[0: 7]) {
        return command_executor_function_restore(command);
    }
    if command_executor_keyword_eq(subcommand, &"KILL"[0: 4]) {
        return command_executor_function_kill(command);
    }

    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR unknown subcommand '"[0: 24]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"'. Try FUNCTION HELP."[0: 21]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_move(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const db_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const db_index: i64 = command_executor_parse_i64(db_data) catch {
        return command_executor_invalid_integer();
    };
    if db_index != 0 {
        return command_executor_error(&"ERR DB index is out of range"[0: 28]);
    }
    return command_executor_error(&"ERR source and destination objects are the same"[0: 47]);
}

fn command_executor_swapdb(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const first_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const second_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const first_db: i64 = command_executor_parse_i64(first_data) catch {
        return command_executor_invalid_integer();
    };
    const second_db: i64 = command_executor_parse_i64(second_data) catch {
        return command_executor_invalid_integer();
    };
    if first_db != 0 || second_db != 0 {
        return command_executor_error(&"ERR DB index is out of range"[0: 28]);
    }
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_lolwut(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    if command.argc >= 3 {
        const option_data: &[byte] = command_executor_arg(command, 1) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(option_data, &"VERSION"[0: 7]) {
            const version_data: &[byte] = command_executor_arg(command, 2) catch {
                return command_executor_wrong_arity();
            };
            _ = command_executor_parse_i64(version_data) catch {
                return command_executor_invalid_integer();
            };
        }
    }

    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    _ = sds_cat(&buf, &"redis-uya LOLWUT partial\r\n"[0: 26]) catch { sds_free(&buf); return command_executor_oom(); };
    _ = sds_cat(&buf, &"+------------------+\r\n"[0: 22]) catch { sds_free(&buf); return command_executor_oom(); };
    _ = sds_cat(&buf, &"| Redis-compatible |\r\n"[0: 22]) catch { sds_free(&buf); return command_executor_oom(); };
    _ = sds_cat(&buf, &"| single node mode |\r\n"[0: 22]) catch { sds_free(&buf); return command_executor_oom(); };
    _ = sds_cat(&buf, &"+------------------+\r\n"[0: 22]) catch { sds_free(&buf); return command_executor_oom(); };
    _ = sds_cat(&buf, &"Redis ver. "[0: 11]) catch { sds_free(&buf); return command_executor_oom(); };
    _ = sds_cat(&buf, redis_uya_version()) catch { sds_free(&buf); return command_executor_oom(); };

    const obj: &RedisObject = create_string_object(buf.buf[0: buf.len]) catch {
        sds_free(&buf);
        return command_executor_oom();
    };
    sds_free(&buf);
    return command_executor_owned_bulk(obj);
}

fn command_executor_debug(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    _ = command;
    return command_executor_error(&"ERR DEBUG command not allowed by redis-uya standalone profile"[0: 61]);
}

fn command_executor_failover(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    _ = command;
    return command_executor_error(&"ERR FAILOVER requires connected replicas."[0: 41]);
}

fn command_executor_wait(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const replicas_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const timeout_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const replicas: i64 = command_executor_parse_i64(replicas_data) catch {
        return command_executor_invalid_integer();
    };
    _ = replicas;
    const timeout_ms: i64 = command_executor_parse_i64(timeout_data) catch {
        return command_executor_invalid_integer();
    };
    if timeout_ms < 0 {
        return command_executor_error(&"ERR timeout is negative"[0: 23]);
    }
    if replicas <= 0 {
        return command_executor_integer(0);
    }
    return command_executor_integer(0);
}

fn command_executor_waitaof(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const local_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const replicas_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const timeout_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const local: i64 = command_executor_parse_i64(local_data) catch {
        return command_executor_invalid_integer();
    };
    const replicas: i64 = command_executor_parse_i64(replicas_data) catch {
        return command_executor_invalid_integer();
    };
    const timeout_ms: i64 = command_executor_parse_i64(timeout_data) catch {
        return command_executor_invalid_integer();
    };
    if timeout_ms < 0 {
        return command_executor_error(&"ERR timeout is negative"[0: 23]);
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_append_array_header(&raw, 2) catch {
        return command_executor_oom();
    };
    if local <= 0 {
        _ = command_executor_resp_append_integer(&raw, 0) catch {
            return command_executor_oom();
        };
    } else {
        _ = command_executor_resp_append_integer(&raw, 1) catch {
            return command_executor_oom();
        };
    }
    _ = command_executor_resp_append_integer(&raw, 0) catch {
        return command_executor_oom();
    };
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_sort_reply_from_members(engine: &Engine, ordered: &RedisObject, options: &SortOptions, now_ms: u64) CommandReply {
    _ = engine;
    const window: SortEmitWindow = command_executor_sort_emit_window(ordered.list_len, options);
    if window.count == 0 {
        return command_executor_array_bulk(null as &ListNode, 0);
    }

    if options.get_count == 0 {
        const reply_list: &RedisObject = create_list_object() catch {
            return command_executor_oom();
        };
        const view: ListRangeView = list_object_range(ordered, window.start, window.start + (window.count as i64) - 1) catch {
            object_free(reply_list);
            return command_executor_wrongtype();
        };
        var node_plain: &ListNode = view.head;
        var emitted_plain: usize = 0;
        while node_plain != null && emitted_plain < view.count {
            const member_plain: &[byte] = node_plain.value.value.buf[0: node_plain.value.value.len];
            _ = list_object_push_tail(reply_list, member_plain) catch {
                object_free(reply_list);
                return command_executor_oom();
            };
            node_plain = node_plain.next;
            emitted_plain = emitted_plain + 1;
        }
        return command_executor_owned_array(reply_list);
    }

    const projected: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    var null_map: Sds = sds_empty() catch {
        object_free(projected);
        return command_executor_oom();
    };
    defer {
        sds_free(&null_map);
    }
    const view_projected: ListRangeView = list_object_range(ordered, window.start, window.start + (window.count as i64) - 1) catch {
        object_free(projected);
        return command_executor_wrongtype();
    };
    var has_null: bool = false;
    var node: &ListNode = view_projected.head;
    var emitted: usize = 0;
    while node != null && emitted < view_projected.count {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var pattern_node: &ListNode = options.get_patterns.list_head;
        while pattern_node != null {
            const pattern: &[byte] = pattern_node.value.value.buf[0: pattern_node.value.value.len];
            const value: SortValueResult = command_executor_sort_lookup_value(engine, pattern, member, now_ms) catch |err| {
                object_free(projected);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                if err == error.CommandInvalidFloat {
                    return command_executor_sort_numeric_error();
                }
                return command_executor_wrongtype();
            };
            var result_data: &[byte] = command_executor_empty_slice();
            var null_flag: byte = 0 as byte;
            if value.found {
                result_data = value.data;
            } else {
                has_null = true;
                null_flag = 1 as byte;
            }
            _ = list_object_push_tail(projected, result_data) catch {
                object_free(projected);
                return command_executor_oom();
            };
            var null_byte: [byte: 1] = [];
            null_byte[0] = null_flag;
            _ = sds_cat(&null_map, null_byte[0: 1]) catch {
                object_free(projected);
                return command_executor_oom();
            };
            pattern_node = pattern_node.next;
        }
        node = node.next;
        emitted = emitted + 1;
    }
    if !has_null {
        return command_executor_owned_array(projected);
    }
    const null_map_obj: &RedisObject = create_string_object(null_map.buf[0: null_map.len]) catch {
        object_free(projected);
        return command_executor_oom();
    };
    var reply: CommandReply = command_executor_nullable_array_bulk(projected.list_head, projected.list_len, null_map_obj);
    reply.owned_object = projected;
    return reply;
}

fn command_executor_sort_store_members(engine: &Engine, ordered: &RedisObject, options: &SortOptions, now_ms: u64) CommandReply {
    const window: SortEmitWindow = command_executor_sort_emit_window(ordered.list_len, options);
    var per_member: usize = options.get_count;
    if per_member == 0 {
        per_member = 1;
    }
    const total_count: usize = window.count * per_member;
    if total_count == 0 {
        _ = delete_key(engine, options.store_destination);
        return command_executor_integer(0);
    }

    const stored: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    const view: ListRangeView = list_object_range(ordered, window.start, window.start + (window.count as i64) - 1) catch {
        object_free(stored);
        return command_executor_wrongtype();
    };
    var node: &ListNode = view.head;
    var emitted: usize = 0;
    while node != null && emitted < view.count {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        if options.get_count == 0 {
            _ = list_object_push_tail(stored, member) catch {
                object_free(stored);
                return command_executor_oom();
            };
        } else {
            var pattern_node: &ListNode = options.get_patterns.list_head;
            while pattern_node != null {
                const pattern: &[byte] = pattern_node.value.value.buf[0: pattern_node.value.value.len];
                const value: SortValueResult = command_executor_sort_lookup_value(engine, pattern, member, now_ms) catch |err| {
                    object_free(stored);
                    if err == error.AllocOutOfMemory {
                        return command_executor_oom();
                    }
                    if err == error.CommandInvalidFloat {
                        return command_executor_sort_numeric_error();
                    }
                    return command_executor_wrongtype();
                };
                var stored_data: &[byte] = command_executor_empty_slice();
                if value.found {
                    stored_data = value.data;
                }
                _ = list_object_push_tail(stored, stored_data) catch {
                    object_free(stored);
                    return command_executor_oom();
                };
                pattern_node = pattern_node.next;
            }
        }
        node = node.next;
        emitted = emitted + 1;
    }

    _ = set_key_at(engine, options.store_destination, stored, now_ms) catch {
        object_free(stored);
        return command_executor_oom();
    };
    _ = clear_key_expire(engine, options.store_destination);
    return command_executor_integer(total_count as i64);
}

fn command_executor_sort(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    var options: SortOptions = command_executor_sort_parse_options(command) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        if err == error.CommandInvalidInteger {
            return command_executor_invalid_integer();
        }
        return command_executor_syntax_error();
    };
    defer {
        command_executor_sort_cleanup_options(&options);
    }

    const source: &RedisObject = command_executor_sort_collect_source(engine, key, now_ms) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(source);
    }

    const ordered: &RedisObject = command_executor_sort_order_members(engine, source, &options, now_ms) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        if err == error.CommandInvalidFloat {
            return command_executor_sort_numeric_error();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(ordered);
    }

    if options.store_enabled {
        return command_executor_sort_store_members(engine, ordered, &options, now_ms);
    }
    return command_executor_sort_reply_from_members(engine, ordered, &options, now_ms);
}

fn command_executor_sort_ro(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    var options: SortOptions = command_executor_sort_parse_options(command) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        if err == error.CommandInvalidInteger {
            return command_executor_invalid_integer();
        }
        return command_executor_syntax_error();
    };
    defer {
        command_executor_sort_cleanup_options(&options);
    }
    if options.store_enabled {
        return command_executor_syntax_error();
    }

    const source: &RedisObject = command_executor_sort_collect_source(engine, key, now_ms) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(source);
    }

    const ordered: &RedisObject = command_executor_sort_order_members(engine, source, &options, now_ms) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        if err == error.CommandInvalidFloat {
            return command_executor_sort_numeric_error();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(ordered);
    }

    return command_executor_sort_reply_from_members(engine, ordered, &options, now_ms);
}

fn command_executor_dump(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    const clone: &RedisObject = object_clone(obj) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var temp_engine: Engine = engine_new();
    _ = set_key_at(&temp_engine, key, clone, now_ms) catch {
        object_free(clone);
        engine_free(&temp_engine);
        return command_executor_oom();
    };
    const dump_obj: &RedisObject = rdb_dump_object_at(&temp_engine, now_ms) catch |err| {
        engine_free(&temp_engine);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_error(&"ERR dump failed"[0: 15]);
    };
    engine_free(&temp_engine);
    var reply: CommandReply = command_executor_bulk(dump_obj.value.buf[0: dump_obj.value.len]);
    reply.owned_object = dump_obj;
    return reply;
}

fn command_executor_restore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const ttl_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const payload: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const ttl_ms: i64 = command_executor_parse_i64(ttl_data) catch {
        return command_executor_invalid_integer();
    };
    if ttl_ms < 0 {
        return command_executor_invalid_integer();
    }
    const existing: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    if existing != null {
        return command_executor_error(&"BUSYKEY Target key name already exists."[0: 37]);
    }

    var temp_engine: Engine = engine_new();
    const load_result: !void = rdb_load_bytes_at(payload, &temp_engine, now_ms);
    load_result catch |err| {
        engine_free(&temp_engine);
        if err == error.RdbInvalidFormat || err == error.RdbTruncated || err == error.RdbUnsupportedType {
            return command_executor_error(&"ERR invalid dump payload"[0: 24]);
        }
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    };

    const keys_obj: &RedisObject = engine_scan_keys_at(&temp_engine, now_ms) catch {
        engine_free(&temp_engine);
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    };
    defer {
        object_free(keys_obj);
    }
    const key_count: usize = list_object_len(keys_obj) catch {
        engine_free(&temp_engine);
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    };
    if key_count != 1 || keys_obj.list_head == null {
        engine_free(&temp_engine);
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    }
    const source_key: &[byte] = keys_obj.list_head.value.value.buf[0: keys_obj.list_head.value.value.len];
    const restored_obj: &RedisObject = lookup_key_at(&temp_engine, source_key, now_ms) catch {
        engine_free(&temp_engine);
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    };
    const clone: &RedisObject = object_clone(restored_obj) catch |err| {
        engine_free(&temp_engine);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_error(&"ERR invalid dump payload"[0: 24]);
    };
    engine_free(&temp_engine);

    _ = set_key_at(engine, key, clone, now_ms) catch {
        object_free(clone);
        return command_executor_oom();
    };
    if ttl_ms > 0 {
        _ = set_key_expire_at(engine, key, now_ms + ttl_ms as u64) catch {
            _ = delete_key(engine, key);
            return command_executor_oom();
        };
    }
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_list_push_i64(obj: &RedisObject, value: i64) !void {
    var buf: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&buf);
    }
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_i64(value);
    _ = sds_cat_fmt(&buf, &"%i"[0: 2], args[0: 1]) catch {
        return error.AllocOutOfMemory;
    };
    _ = list_object_push_tail(obj, buf.buf[0: buf.len]) catch |err| {
        return err;
    };
}

fn command_executor_sinterstore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const target: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const first_key: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const first_obj: &RedisObject = lookup_key_at(engine, first_key, now_ms) catch {
        const empty: &RedisObject = create_set_object() catch {
            return command_executor_oom();
        };
        return command_executor_set_store_result(engine, target, empty, now_ms);
    };
    if first_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    const members: &RedisObject = command_executor_set_sorted_members(first_obj) catch |err| {
        object_free(result_set);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var present_everywhere: bool = true;
        var arg_index: usize = 3;
        while arg_index < command.argc {
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                present_everywhere = false;
                null as &RedisObject;
            };
            if obj == null {
                present_everywhere = false;
                break;
            }
            if obj.obj_type != ObjectType.object_set {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            }
            const present: bool = command_executor_set_contains(obj, member) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            };
            if !present {
                present_everywhere = false;
                break;
            }
            arg_index = arg_index + 1;
        }
        if present_everywhere {
            _ = set_object_add_member(result_set, member) catch |err| {
                object_free(members);
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        }
        node = node.next;
    }
    object_free(members);
    return command_executor_set_store_result(engine, target, result_set, now_ms);
}

fn command_executor_sdiffstore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
