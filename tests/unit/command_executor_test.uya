    var config_slowlog_threshold_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_slowlog_threshold_command, 5000u64);
    const config_slowlog_threshold_len: usize = try connection_encode_reply(&config_slowlog_threshold_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: config_slowlog_threshold_len], &"*2\r\n$23\r\nslowlog-log-slower-than\r\n$5\r\n10000\r\n"[0: 45]));
    command_reply_cleanup(&config_slowlog_threshold_reply);
    resp_value_free(&config_slowlog_threshold_parsed.value);

    var config_slowlog_max_len_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$15\r\nslowlog-max-len\r\n"[0: 47]);
    const config_slowlog_max_len_command: Command = try command_executor_test_command(&router, &config_slowlog_max_len_parsed);
    var config_slowlog_max_len_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_slowlog_max_len_command, 5000u64);
