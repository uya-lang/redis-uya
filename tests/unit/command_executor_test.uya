    const lrange_lmpop_after_len: usize = try connection_encode_reply(&lrange_lmpop_after_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: lrange_lmpop_after_len], &"*1\r\n$1\r\nc\r\n"[0: 11]));
    command_reply_cleanup(&lrange_lmpop_after_reply);
