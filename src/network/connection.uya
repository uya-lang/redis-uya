fn connection_acl_key_patterns_clear(patterns: &[ConnectionAclKeyPattern]) void {
    var index: usize = 0;
    while index < patterns.len {
        patterns.ptr[index].active = false;
        patterns.ptr[index].pattern_len = 0;
        index = index + 1;
    }
}

fn connection_acl_default_key_patterns_reset_allkeys() void {
    connection_acl_default_key_rules.allkeys = true;
    connection_acl_key_patterns_clear(connection_acl_default_key_rules.patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]);
}

fn connection_acl_default_key_patterns_resetkeys() void {
    connection_acl_default_key_rules.allkeys = false;
    connection_acl_key_patterns_clear(connection_acl_default_key_rules.patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]);
}

fn connection_acl_channel_patterns_clear(patterns: &[ConnectionAclChannelPattern]) void {
    var index: usize = 0;
    while index < patterns.len {
        patterns.ptr[index].active = false;
        patterns.ptr[index].pattern_len = 0;
        index = index + 1;
    }
}

fn connection_acl_default_channel_patterns_reset_allchannels() void {
    connection_acl_default_channel_rules.allchannels = true;
    connection_acl_channel_patterns_clear(connection_acl_default_channel_rules.patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]);
}

fn connection_acl_channel_pattern_find(patterns: &[ConnectionAclChannelPattern], pattern: &[byte]) i32 {
    var index: usize = 0;
    while index < patterns.len {
        if patterns.ptr[index].active && connection_slice_eq(patterns.ptr[index].pattern[0: patterns.ptr[index].pattern_len], pattern) {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_acl_channel_pattern_find_free(patterns: &[ConnectionAclChannelPattern]) i32 {
    var index: usize = 0;
    while index < patterns.len {
        if patterns.ptr[index].active == false {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_acl_channel_pattern_add(patterns: &[ConnectionAclChannelPattern], pattern: &[byte]) !void {
    if pattern.len == 0 || pattern.len > CONNECTION_ACL_CHANNEL_PATTERN_BYTES_MAX {
        return error.ConnectionInputTooLarge;
    }
    if connection_acl_channel_pattern_find(patterns, pattern) >= 0 {
        return;
    }
    const slot: i32 = connection_acl_channel_pattern_find_free(patterns);
    if slot < 0 {
        return error.ConnectionInputTooLarge;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= patterns.len {
        return error.ConnectionInputTooLarge;
    }
    patterns.ptr[slot_index].active = true;
    patterns.ptr[slot_index].pattern_len = pattern.len;
    var i: usize = 0;
    while i < pattern.len {
        patterns.ptr[slot_index].pattern[i] = pattern.ptr[i];
        i = i + 1;
    }
    while i < CONNECTION_ACL_CHANNEL_PATTERN_BYTES_MAX {
        patterns.ptr[slot_index].pattern[i] = 0 as byte;
        i = i + 1;
    }
}

fn connection_acl_key_pattern_find(patterns: &[ConnectionAclKeyPattern], pattern: &[byte]) i32 {
    var index: usize = 0;
    while index < patterns.len {
        if patterns.ptr[index].active && connection_slice_eq(patterns.ptr[index].pattern[0: patterns.ptr[index].pattern_len], pattern) {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

