    try assert_eq_i32(getex_bad_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&getex_bad_parsed.value);

    var incrbyfloat_bad_arg_parsed: RespParseResult = try parse_resp2(&"*3\r\n$11\r\nINCRBYFLOAT\r\n$3\r\nkey\r\n$3\r\nbad\r\n"[0: 42]);
