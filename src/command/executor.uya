        };
        options.center_lat = command_executor_parse_f64(command_executor_arg(command, index + 2) catch {
            return command_executor_wrong_arity();
        }) catch {
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        if !command_executor_geo_validate_lonlat(options.center_lon, options.center_lat) {
            return command_executor_geo_invalid_lonlat(options.center_lon, options.center_lat);
        }
        index = index + 3;
    } else {
        return command_executor_wrong_arity();
    }

    const by_token: &[byte] = command_executor_arg(command, index) catch {
        return command_executor_wrong_arity();
    };
    if command_executor_keyword_eq(by_token, &"BYRADIUS"[0: 8]) {
        if index + 2 >= command.argc {
            return command_executor_wrong_arity();
        }
        const radius: f64 = command_executor_parse_f64(command_executor_arg(command, index + 1) catch {
            return command_executor_wrong_arity();
        }) catch {
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        const unit: &[byte] = command_executor_arg(command, index + 2) catch {
            return command_executor_wrong_arity();
        };
        const unit_scale: f64 = command_executor_geo_unit_scale(unit) catch {
            return command_executor_error(&"ERR unsupported unit provided. please use M, KM, FT, MI"[0: 57]);
        };
        options.by_radius = true;
        options.radius_m = radius * unit_scale;
        options.unit_scale = unit_scale;
        index = index + 3;
    } else if command_executor_keyword_eq(by_token, &"BYBOX"[0: 5]) {
        if index + 3 >= command.argc {
            return command_executor_wrong_arity();
        }
        const width: f64 = command_executor_parse_f64(command_executor_arg(command, index + 1) catch {
            return command_executor_wrong_arity();
        }) catch {
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        const height: f64 = command_executor_parse_f64(command_executor_arg(command, index + 2) catch {
            return command_executor_wrong_arity();
        }) catch {
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        const unit: &[byte] = command_executor_arg(command, index + 3) catch {
            return command_executor_wrong_arity();
        };
        const unit_scale: f64 = command_executor_geo_unit_scale(unit) catch {
            return command_executor_error(&"ERR unsupported unit provided. please use M, KM, FT, MI"[0: 57]);
        };
        options.by_radius = false;
        options.box_width_m = width * unit_scale;
        options.box_height_m = height * unit_scale;
        options.unit_scale = unit_scale;
        index = index + 4;
    } else {
        return command_executor_wrong_arity();
    }

    while index < command.argc {
        const token: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(token, &"ASC"[0: 3]) {
            if options.order != CommandExecutorGeoOrder.geo_order_none {
                return command_executor_syntax_error();
            }
            options.order = CommandExecutorGeoOrder.geo_order_asc;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"DESC"[0: 4]) {
            if options.order != CommandExecutorGeoOrder.geo_order_none {
                return command_executor_syntax_error();
            }
            options.order = CommandExecutorGeoOrder.geo_order_desc;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"COUNT"[0: 5]) {
            if options.has_count || index + 1 >= command.argc {
                return command_executor_syntax_error();
            }
            const count_i64: i64 = command_executor_parse_i64(command_executor_arg(command, index + 1) catch {
                return command_executor_wrong_arity();
            }) catch {
                return command_executor_invalid_integer();
            };
            if count_i64 <= 0 {
                return command_executor_error(&"ERR COUNT must be > 0"[0: 22]);
            }
            options.has_count = true;
            options.count_limit = count_i64 as usize;
            index = index + 2;
            if index < command.argc {
                const any_token: &[byte] = command_executor_arg(command, index) catch {
                    return command_executor_wrong_arity();
                };
                if command_executor_keyword_eq(any_token, &"ANY"[0: 3]) {
                    options.any = true;
                    index = index + 1;
                }
            }
            continue;
        }
        if command_executor_keyword_eq(token, &"STOREDIST"[0: 9]) {
            if options.storedist {
                return command_executor_syntax_error();
            }
            options.storedist = true;
            index = index + 1;
            continue;
        }
        return command_executor_syntax_error();
    }

    return command_executor_geo_search_store_run(engine, destination, source, &options, now_ms);
}

