    const slowlog_unknown_command: Command = try command_executor_test_command(&router, &slowlog_unknown_parsed);
    var slowlog_unknown_reply: CommandReply = command_execute_at(&engine, &slowlog_unknown_command, 1000u64);
    try assert_eq_i32(slowlog_unknown_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(slowlog_unknown_reply.data, &"ERR unknown subcommand 'X'. Try SLOWLOG HELP."[0: 45]));
    command_reply_cleanup(&slowlog_unknown_reply);
    resp_value_free(&slowlog_unknown_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}
