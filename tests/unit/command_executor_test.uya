export fn test_command_set_get_del_exists() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33]);
    const set_command: Command = try command_executor_test_command(&router, &set_parsed);
    const set_reply: CommandReply = command_execute_at(&engine, &set_command, 1000u64);
    try assert_eq_i32(set_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(set_reply.data, &"OK"[0: 2]));
    resp_value_free(&set_parsed.value);

    var get_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22]);
    const get_command: Command = try command_executor_test_command(&router, &get_parsed);
    const get_reply: CommandReply = command_execute_at(&engine, &get_command, 1000u64);
    try assert_eq_i32(get_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(get_reply.data, &"value"[0: 5]));
    resp_value_free(&get_parsed.value);

    var mset_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nMSET\r\n$2\r\nk1\r\n$2\r\nv1\r\n$2\r\nk2\r\n$2\r\nv2\r\n"[0: 46]);
    const mset_command: Command = try command_executor_test_command(&router, &mset_parsed);
    const mset_reply: CommandReply = command_execute_at(&engine, &mset_command, 1000u64);
    try assert_eq_i32(mset_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(mset_reply.data, &"OK"[0: 2]));
    resp_value_free(&mset_parsed.value);

    var mget_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nMGET\r\n$2\r\nk1\r\n$7\r\nmissing\r\n$2\r\nk2\r\n"[0: 43]);
    const mget_command: Command = try command_executor_test_command(&router, &mget_parsed);
    var mget_reply: CommandReply = command_execute_at(&engine, &mget_command, 1000u64);
    const mget_len: usize = try connection_encode_reply(&mget_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: mget_len], &"*3\r\n$2\r\nv1\r\n$-1\r\n$2\r\nv2\r\n"[0: 25]));
    command_reply_cleanup(&mget_reply);
    resp_value_free(&mget_parsed.value);

    var msetnx_parsed: RespParseResult = try parse_resp2(&"*5\r\n$6\r\nMSETNX\r\n$3\r\nnx1\r\n$1\r\na\r\n$3\r\nnx2\r\n$1\r\nb\r\n"[0: 48]);
    const msetnx_command: Command = try command_executor_test_command(&router, &msetnx_parsed);
    const msetnx_reply: CommandReply = command_execute_at(&engine, &msetnx_command, 1000u64);
    try assert_eq_i32(msetnx_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(msetnx_reply.integer as i32, 1);
    resp_value_free(&msetnx_parsed.value);

    var msetnx_conflict_parsed: RespParseResult = try parse_resp2(&"*5\r\n$6\r\nMSETNX\r\n$3\r\nnx1\r\n$1\r\nx\r\n$3\r\nnx3\r\n$1\r\ny\r\n"[0: 48]);
    const msetnx_conflict_command: Command = try command_executor_test_command(&router, &msetnx_conflict_parsed);
    const msetnx_conflict_reply: CommandReply = command_execute_at(&engine, &msetnx_conflict_command, 1000u64);
    try assert_eq_i32(msetnx_conflict_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(msetnx_conflict_reply.integer as i32, 0);
    resp_value_free(&msetnx_conflict_parsed.value);

    var multi_del_parsed: RespParseResult = try parse_resp2(&"*5\r\n$3\r\nDEL\r\n$2\r\nk1\r\n$2\r\nk2\r\n$3\r\nnx1\r\n$3\r\nnx2\r\n"[0: 47]);
    const multi_del_command: Command = try command_executor_test_command(&router, &multi_del_parsed);
    const multi_del_reply: CommandReply = command_execute_at(&engine, &multi_del_command, 1000u64);
    try assert_eq_i32(multi_del_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(multi_del_reply.integer as i32, 4);
    resp_value_free(&multi_del_parsed.value);

    var incr_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nINCR\r\n$7\r\ncounter\r\n"[0: 28]);
    const incr_command: Command = try command_executor_test_command(&router, &incr_parsed);
    const incr_reply: CommandReply = command_execute_at(&engine, &incr_command, 1000u64);
    try assert_eq_i32(incr_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(incr_reply.integer as i32, 1);
    resp_value_free(&incr_parsed.value);

    var incrby_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nINCRBY\r\n$7\r\ncounter\r\n$1\r\n4\r\n"[0: 38]);
    const incrby_command: Command = try command_executor_test_command(&router, &incrby_parsed);
    const incrby_reply: CommandReply = command_execute_at(&engine, &incrby_command, 1000u64);
    try assert_eq_i32(incrby_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(incrby_reply.integer as i32, 5);
    resp_value_free(&incrby_parsed.value);

    var decr_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nDECR\r\n$7\r\ncounter\r\n"[0: 28]);
    const decr_command: Command = try command_executor_test_command(&router, &decr_parsed);
    const decr_reply: CommandReply = command_execute_at(&engine, &decr_command, 1000u64);
    try assert_eq_i32(decr_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(decr_reply.integer as i32, 4);
    resp_value_free(&decr_parsed.value);

    var decrby_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nDECRBY\r\n$7\r\ncounter\r\n$1\r\n2\r\n"[0: 38]);
    const decrby_command: Command = try command_executor_test_command(&router, &decrby_parsed);
    const decrby_reply: CommandReply = command_execute_at(&engine, &decrby_command, 1000u64);
    try assert_eq_i32(decrby_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(decrby_reply.integer as i32, 2);
    resp_value_free(&decrby_parsed.value);

    var incrbyfloat_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$11\r\nINCRBYFLOAT\r\n$8\r\nfcounter\r\n$3\r\n1.5\r\n"[0: 45]);
    const incrbyfloat_missing_command: Command = try command_executor_test_command(&router, &incrbyfloat_missing_parsed);
    const incrbyfloat_missing_reply: CommandReply = command_execute_at(&engine, &incrbyfloat_missing_command, 1000u64);
    try assert_eq_i32(incrbyfloat_missing_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(incrbyfloat_missing_reply.data, &"1.5"[0: 3]));
    resp_value_free(&incrbyfloat_missing_parsed.value);

    var incrbyfloat_existing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$11\r\nINCRBYFLOAT\r\n$8\r\nfcounter\r\n$1\r\n2\r\n"[0: 43]);
    const incrbyfloat_existing_command: Command = try command_executor_test_command(&router, &incrbyfloat_existing_parsed);
    const incrbyfloat_existing_reply: CommandReply = command_execute_at(&engine, &incrbyfloat_existing_command, 1000u64);
    try assert_eq_i32(incrbyfloat_existing_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(incrbyfloat_existing_reply.data, &"3.5"[0: 3]));
    resp_value_free(&incrbyfloat_existing_parsed.value);

    var setnx_parsed: RespParseResult = try parse_resp2(&"*3\r\n$5\r\nSETNX\r\n$6\r\nnx-key\r\n$5\r\nfirst\r\n"[0: 40]);
    const setnx_command: Command = try command_executor_test_command(&router, &setnx_parsed);
    const setnx_reply: CommandReply = command_execute_at(&engine, &setnx_command, 1000u64);
    try assert_eq_i32(setnx_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(setnx_reply.integer as i32, 1);
    resp_value_free(&setnx_parsed.value);

    var setnx_dup_parsed: RespParseResult = try parse_resp2(&"*3\r\n$5\r\nSETNX\r\n$6\r\nnx-key\r\n$6\r\nsecond\r\n"[0: 42]);
    const setnx_dup_command: Command = try command_executor_test_command(&router, &setnx_dup_parsed);
    const setnx_dup_reply: CommandReply = command_execute_at(&engine, &setnx_dup_command, 1000u64);
    try assert_eq_i32(setnx_dup_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(setnx_dup_reply.integer as i32, 0);
    resp_value_free(&setnx_dup_parsed.value);

    var getset_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nGETSET\r\n$6\r\ngs-key\r\n$5\r\nfirst\r\n"[0: 41]);
    const getset_missing_command: Command = try command_executor_test_command(&router, &getset_missing_parsed);
    const getset_missing_reply: CommandReply = command_execute_at(&engine, &getset_missing_command, 1000u64);
    try assert_eq_i32(getset_missing_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&getset_missing_parsed.value);

    var getset_existing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nGETSET\r\n$6\r\ngs-key\r\n$6\r\nsecond\r\n"[0: 43]);
    const getset_existing_command: Command = try command_executor_test_command(&router, &getset_existing_parsed);
    var getset_existing_reply: CommandReply = command_execute_at(&engine, &getset_existing_command, 1000u64);
    try assert_eq_i32(getset_existing_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(getset_existing_reply.data, &"first"[0: 5]));
    command_reply_cleanup(&getset_existing_reply);
    resp_value_free(&getset_existing_parsed.value);

    var strlen_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nSTRLEN\r\n$3\r\nkey\r\n"[0: 25]);
    const strlen_command: Command = try command_executor_test_command(&router, &strlen_parsed);
    const strlen_reply: CommandReply = command_execute_at(&engine, &strlen_command, 1000u64);
    try assert_eq_i32(strlen_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(strlen_reply.integer as i32, 5);
    resp_value_free(&strlen_parsed.value);

    var append_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nAPPEND\r\n$3\r\nkey\r\n$2\r\n++\r\n"[0: 33]);
    const append_command: Command = try command_executor_test_command(&router, &append_parsed);
    const append_reply: CommandReply = command_execute_at(&engine, &append_command, 1000u64);
    try assert_eq_i32(append_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(append_reply.integer as i32, 7);
    resp_value_free(&append_parsed.value);

    var getrange_parsed: RespParseResult = try parse_resp2(&"*4\r\n$8\r\nGETRANGE\r\n$3\r\nkey\r\n$1\r\n1\r\n$1\r\n3\r\n"[0: 41]);
