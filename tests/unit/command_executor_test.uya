    try assert_eq_i32(fcounter_del_reply.integer as i32, 1);
    resp_value_free(&fcounter_del_parsed.value);

    var echo_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nECHO\r\n$2\r\nhi\r\n"[0: 22]);
    const echo_command: Command = try command_executor_test_command(&router, &echo_parsed);
