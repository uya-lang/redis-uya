export fn test_command_zrank_zrevrank() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var zadd_parsed: RespParseResult = try parse_resp2(&"*8\r\n$4\r\nZADD\r\n$4\r\nzset\r\n$1\r\n2\r\n$1\r\nb\r\n$1\r\n1\r\n$1\r\na\r\n$1\r\n2\r\n$1\r\nc\r\n"[0: 66]);
    const zadd_command: Command = try command_executor_test_command(&router, &zadd_parsed);
    _ = command_execute_at(&engine, &zadd_command, 1000u64);
    resp_value_free(&zadd_parsed.value);

    var zrank_parsed: RespParseResult = try parse_resp2(&"*3\r\n$5\r\nZRANK\r\n$4\r\nzset\r\n$1\r\nb\r\n"[0: 32]);
    const zrank_command: Command = try command_executor_test_command(&router, &zrank_parsed);
    const zrank_reply: CommandReply = command_execute_at(&engine, &zrank_command, 1000u64);
    try assert_eq_i32(zrank_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(zrank_reply.integer as i32, 1);
    resp_value_free(&zrank_parsed.value);

    var zrank_withscore_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nZRANK\r\n$4\r\nzset\r\n$1\r\nb\r\n$9\r\nWITHSCORE\r\n"[0: 47]);
    const zrank_withscore_command: Command = try command_executor_test_command(&router, &zrank_withscore_parsed);
    var zrank_withscore_reply: CommandReply = command_execute_at(&engine, &zrank_withscore_command, 1000u64);
    try assert_eq_i32(zrank_withscore_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(zrank_withscore_reply.data, &"*2\r\n:1\r\n$1\r\n2\r\n"[0: 15]));
    command_reply_cleanup(&zrank_withscore_reply);
    resp_value_free(&zrank_withscore_parsed.value);

    var zrevrank_parsed: RespParseResult = try parse_resp2(&"*3\r\n$8\r\nZREVRANK\r\n$4\r\nzset\r\n$1\r\nc\r\n"[0: 35]);
    const zrevrank_command: Command = try command_executor_test_command(&router, &zrevrank_parsed);
    const zrevrank_reply: CommandReply = command_execute_at(&engine, &zrevrank_command, 1000u64);
    try assert_eq_i32(zrevrank_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(zrevrank_reply.integer as i32, 0);
    resp_value_free(&zrevrank_parsed.value);

    var zrevrank_withscore_parsed: RespParseResult = try parse_resp2(&"*4\r\n$8\r\nZREVRANK\r\n$4\r\nzset\r\n$1\r\nb\r\n$9\r\nWITHSCORE\r\n"[0: 50]);
    const zrevrank_withscore_command: Command = try command_executor_test_command(&router, &zrevrank_withscore_parsed);
    var zrevrank_withscore_reply: CommandReply = command_execute_at(&engine, &zrevrank_withscore_command, 1000u64);
    try assert_eq_i32(zrevrank_withscore_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(zrevrank_withscore_reply.data, &"*2\r\n:1\r\n$1\r\n2\r\n"[0: 15]));
    command_reply_cleanup(&zrevrank_withscore_reply);
    resp_value_free(&zrevrank_withscore_parsed.value);

    var zrank_missing_member_parsed: RespParseResult = try parse_resp2(&"*3\r\n$5\r\nZRANK\r\n$4\r\nzset\r\n$7\r\nmissing\r\n"[0: 38]);
    const zrank_missing_member_command: Command = try command_executor_test_command(&router, &zrank_missing_member_parsed);
    const zrank_missing_member_reply: CommandReply = command_execute_at(&engine, &zrank_missing_member_command, 1000u64);
    try assert_eq_i32(zrank_missing_member_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&zrank_missing_member_parsed.value);

    var zrevrank_missing_key_parsed: RespParseResult = try parse_resp2(&"*3\r\n$8\r\nZREVRANK\r\n$7\r\nmissing\r\n$1\r\na\r\n"[0: 38]);
    const zrevrank_missing_key_command: Command = try command_executor_test_command(&router, &zrevrank_missing_key_parsed);
    const zrevrank_missing_key_reply: CommandReply = command_execute_at(&engine, &zrevrank_missing_key_command, 1000u64);
    try assert_eq_i32(zrevrank_missing_key_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&zrevrank_missing_key_parsed.value);

    var zrank_bad_option_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nZRANK\r\n$4\r\nzset\r\n$1\r\na\r\n$3\r\nBAD\r\n"[0: 41]);
    const zrank_bad_option_command: Command = try command_executor_test_command(&router, &zrank_bad_option_parsed);
    const zrank_bad_option_reply: CommandReply = command_execute_at(&engine, &zrank_bad_option_command, 1000u64);
    try assert_eq_i32(zrank_bad_option_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(zrank_bad_option_reply.data, &"ERR syntax error"[0: 16]));
    resp_value_free(&zrank_bad_option_parsed.value);

    var set_plain_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$5\r\nplain\r\n$5\r\nvalue\r\n"[0: 35]);
    const set_plain_command: Command = try command_executor_test_command(&router, &set_plain_parsed);
    _ = command_execute_at(&engine, &set_plain_command, 1000u64);
    resp_value_free(&set_plain_parsed.value);

    var zrank_wrongtype_parsed: RespParseResult = try parse_resp2(&"*3\r\n$5\r\nZRANK\r\n$5\r\nplain\r\n$1\r\na\r\n"[0: 33]);
    const zrank_wrongtype_command: Command = try command_executor_test_command(&router, &zrank_wrongtype_parsed);
    const zrank_wrongtype_reply: CommandReply = command_execute_at(&engine, &zrank_wrongtype_command, 1000u64);
    try assert_eq_i32(zrank_wrongtype_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(zrank_wrongtype_reply.data, &"WRONGTYPE Operation against a key holding the wrong kind of value"[0: 65]));
    resp_value_free(&zrank_wrongtype_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_zscore_zmscore_zpopmin_zpopmax() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 512] = [];

    var zadd_parsed: RespParseResult = try parse_resp2(&"*8\r\n$4\r\nZADD\r\n$4\r\nzset\r\n$1\r\n2\r\n$1\r\nb\r\n$1\r\n1\r\n$1\r\na\r\n$1\r\n3\r\n$1\r\nc\r\n"[0: 66]);
    const zadd_command: Command = try command_executor_test_command(&router, &zadd_parsed);
    _ = command_execute_at(&engine, &zadd_command, 1000u64);
    resp_value_free(&zadd_parsed.value);

    var zscore_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nZSCORE\r\n$4\r\nzset\r\n$1\r\na\r\n"[0: 33]);
    const zscore_command: Command = try command_executor_test_command(&router, &zscore_parsed);
    const zscore_reply: CommandReply = command_execute_at(&engine, &zscore_command, 1000u64);
    try assert_eq_i32(zscore_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(zscore_reply.data, &"1"[0: 1]));
    command_reply_cleanup(&zscore_reply);
    resp_value_free(&zscore_parsed.value);

    var zscore_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nZSCORE\r\n$4\r\nzset\r\n$7\r\nmissing\r\n"[0: 39]);
    const zscore_missing_command: Command = try command_executor_test_command(&router, &zscore_missing_parsed);
    const zscore_missing_reply: CommandReply = command_execute_at(&engine, &zscore_missing_command, 1000u64);
    try assert_eq_i32(zscore_missing_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&zscore_missing_parsed.value);

    var zmscore_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nZMSCORE\r\n$4\r\nzset\r\n$1\r\na\r\n$7\r\nmissing\r\n$1\r\nc\r\n"[0: 54]);
    const zmscore_command: Command = try command_executor_test_command(&router, &zmscore_parsed);
    var zmscore_reply: CommandReply = command_execute_at(&engine, &zmscore_command, 1000u64);
    const zmscore_len: usize = try connection_encode_reply(&zmscore_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: zmscore_len], &"*3\r\n$1\r\n1\r\n$-1\r\n$1\r\n3\r\n"[0: 23]));
    command_reply_cleanup(&zmscore_reply);
    resp_value_free(&zmscore_parsed.value);

    var zrand_single_parsed: RespParseResult = try parse_resp2(&"*2\r\n$11\r\nZRANDMEMBER\r\n$4\r\nzset\r\n"[0: 32]);
    const zrand_single_command: Command = try command_executor_test_command(&router, &zrand_single_parsed);
    var zrand_single_reply: CommandReply = command_execute_at(&engine, &zrand_single_command, 1000u64);
    const zrand_single_len: usize = try connection_encode_reply(&zrand_single_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: zrand_single_len], &"$1\r\na\r\n"[0: 7]));
