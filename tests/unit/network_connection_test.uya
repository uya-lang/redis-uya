    try assert_true(network_connection_slice_eq(out[0: bzpopmin_result.response_len], &"*3\r\n$6\r\nzblock\r\n$1\r\na\r\n$1\r\n1\r\n"[0: 30]));

    const bzpopmax_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$8\r\nBZPOPMAX\r\n$6\r\nzblock\r\n$1\r\n1\r\n"[0: 37], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bzpopmax_result.response_len], &"*3\r\n$6\r\nzblock\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 30]));

    const zblock2_seed_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*8\r\n$4\r\nZADD\r\n$7\r\nzblock2\r\n$1\r\n1\r\n$1\r\na\r\n$1\r\n2\r\n$1\r\nb\r\n$1\r\n3\r\n$1\r\nc\r\n"[0: 69], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: zblock2_seed_result.response_len], &":3\r\n"[0: 4]));

    const bzmpop_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*8\r\n$6\r\nBZMPOP\r\n$1\r\n1\r\n$1\r\n2\r\n$4\r\nmiss\r\n$7\r\nzblock2\r\n$3\r\nMIN\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n"[0: 80], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bzmpop_result.response_len], &"*2\r\n$7\r\nzblock2\r\n*2\r\n*2\r\n$1\r\na\r\n$1\r\n1\r\n*2\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 57]));

    const bzmpop_last_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$6\r\nBZMPOP\r\n$1\r\n1\r\n$1\r\n1\r\n$7\r\nzblock2\r\n$3\r\nMAX\r\n"[0: 52], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bzmpop_last_result.response_len], &"*2\r\n$7\r\nzblock2\r\n*1\r\n*2\r\n$1\r\nc\r\n$1\r\n3\r\n"[0: 39]));

    const info_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$4\r\nINFO\r\n$6\r\nserver\r\n"[0: 26], &out[0], 256, 1000u64);
    try assert_eq_i32(info_result.response_len as i32, 109);
    try assert_true(network_connection_contains(out[0: info_result.response_len], &"$101\r\n# Server\r\n"[0: 16]));
    try assert_true(network_connection_contains(out[0: info_result.response_len], &"redis_uya_version:"[0: 18]));
    try assert_true(network_connection_contains(out[0: info_result.response_len], redis_uya_version()));
    try assert_true(network_connection_contains(out[0: info_result.response_len], &"tcp_port:6379\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: info_result.response_len], &"uptime_in_seconds:0\r\n\r\n\r\n"[0: 24]));

    const replicaof_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$9\r\nREPLICAOF\r\n$9\r\n127.0.0.1\r\n$4\r\n6381\r\n"[0: 44], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: replicaof_result.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(replicaof_result.request_replicaof as i32, 1);
    try assert_eq_i32(replicaof_result.replicaof_promote as i32, 0);

    const config_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$4\r\nport\r\n"[0: 35], &out[0], 256, 1000u64);
    try assert_eq_i32(config_result.response_len as i32, 24);
    try assert_true(network_connection_slice_eq(out[0: config_result.response_len], &"*2\r\n$4\r\nport\r\n$4\r\n6379\r\n"[0: 24]));

    const rewrite_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$12\r\nBGREWRITEAOF\r\n"[0: 23], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: rewrite_result.response_len], &"+Background AOF rewrite scheduled\r\n"[0: 35]));
    try assert_eq_i32(rewrite_result.request_aof_rewrite as i32, 1);

    const quit: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$4\r\nQUIT\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: quit.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(quit.close_after as i32, 1);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_slowlog() !void {
    reset_memory_stats_for_test();
    slowlog_reset();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 1024] = [];

    const reset_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nSLOWLOG\r\n$5\r\nRESET\r\n"[0: 29], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_result.response_len], &"+OK\r\n"[0: 5]));

    const set_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$4\r\nskey\r\n$5\r\nvalue\r\n"[0: 34], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_result.response_len], &"+OK\r\n"[0: 5]));

    const get_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$4\r\nskey\r\n"[0: 23], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_result.response_len], &"$5\r\nvalue\r\n"[0: 11]));

    const len_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nSLOWLOG\r\n$3\r\nLEN\r\n"[0: 27], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: len_result.response_len], &":2\r\n"[0: 4]));

    const get_one_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$7\r\nSLOWLOG\r\n$3\r\nGET\r\n$1\r\n1\r\n"[0: 34], &out[0], 1024, 1000u64);
    try assert_true(network_connection_contains(out[0: get_one_result.response_len], &"$3\r\nGET\r\n$4\r\nskey\r\n"[0: 19]));

    const reset_again_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nSLOWLOG\r\n$5\r\nRESET\r\n"[0: 29], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_again_result.response_len], &"+OK\r\n"[0: 5]));

    const len_zero_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nSLOWLOG\r\n$3\r\nLEN\r\n"[0: 27], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: len_zero_result.response_len], &":0\r\n"[0: 4]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_latency() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 1024] = [];

    const latest_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nLATENCY\r\n$6\r\nLATEST\r\n"[0: 29], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: latest_result.response_len], &"*0\r\n"[0: 4]));

    const history_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$7\r\nLATENCY\r\n$7\r\nHISTORY\r\n$7\r\ncommand\r\n"[0: 43], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: history_result.response_len], &"*0\r\n"[0: 4]));

    const doctor_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nLATENCY\r\n$6\r\nDOCTOR\r\n"[0: 29], &out[0], 1024, 1000u64);
    try assert_true(network_connection_contains(out[0: doctor_result.response_len], &"No latency events"[0: 17]));

    const reset_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nLATENCY\r\n$5\r\nRESET\r\n"[0: 28], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_result.response_len], &":0\r\n"[0: 4]));

    const unknown_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nLATENCY\r\n$1\r\nX\r\n"[0: 24], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: unknown_result.response_len], &"-ERR unknown subcommand 'X'. Try LATENCY HELP.\r\n"[0: 48]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_monitor() !void {
    reset_memory_stats_for_test();
    connection_monitor_reset_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    var out: [byte: 1024] = [];

    const monitor_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nMONITOR\r\n"[0: 17], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: monitor_result.response_len], &"+OK\r\n"[0: 5]));

    const ping_blocked: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 1024, 1001u64);
    try assert_true(network_connection_contains(out[0: ping_blocked.response_len], &"only RESET / QUIT are allowed in monitor mode"[0: 45]));

    const reset_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nRESET\r\n"[0: 15], &out[0], 1024, 1002u64);
    try assert_true(network_connection_slice_eq(out[0: reset_result.response_len], &"+RESET\r\n"[0: 8]));

    const ping_after_reset: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 1024, 1003u64);
    try assert_true(network_connection_slice_eq(out[0: ping_after_reset.response_len], &"+PONG\r\n"[0: 7]));

    connection_transaction_reset(&tx);
    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

