export fn test_command_role() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    var out: [byte: 256] = [];

    var role_master_parsed: RespParseResult = try parse_resp2(&"*1\r\n$4\r\nROLE\r\n"[0: 14]);
    const role_master_command: Command = try command_executor_test_command(&router, &role_master_parsed);
    var role_master_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &role_master_command, 1000u64);
    const role_master_len: usize = try connection_encode_reply(&role_master_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: role_master_len], &"*3\r\n$6\r\nmaster\r\n:0\r\n*0\r\n"[0: 24]));
    command_reply_cleanup(&role_master_reply);
    resp_value_free(&role_master_parsed.value);

    runtime.replication_role = ReplicationRole.role_replica;
    runtime.replication_state = ReplicationState.repl_state_connected;
    config_copy_bytes(runtime.config.replicaof_host[0: 64], &"127.0.0.1"[0: 9]);
    runtime.config.replicaof_port = 6381;
    runtime.replication_master_offset = 128u64;

    var role_replica_parsed: RespParseResult = try parse_resp2(&"*1\r\n$4\r\nROLE\r\n"[0: 14]);
    const role_replica_command: Command = try command_executor_test_command(&router, &role_replica_parsed);
    var role_replica_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &role_replica_command, 1000u64);
    const role_replica_len: usize = try connection_encode_reply(&role_replica_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: role_replica_len], &"*5\r\n$5\r\nslave\r\n$9\r\n127.0.0.1\r\n:6381\r\n$9\r\nconnected\r\n:128\r\n"[0: 58]));
    command_reply_cleanup(&role_replica_reply);
    resp_value_free(&role_replica_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_expire_and_ttl() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33]);
    const set_command: Command = try command_executor_test_command(&router, &set_parsed);
    _ = command_execute_at(&engine, &set_command, 1000u64);
    resp_value_free(&set_parsed.value);

    var expire_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nEXPIRE\r\n$3\r\nkey\r\n$1\r\n2\r\n"[0: 32]);
    const expire_command: Command = try command_executor_test_command(&router, &expire_parsed);
    const expire_reply: CommandReply = command_execute_at(&engine, &expire_command, 1000u64);
    try assert_eq_i32(expire_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(expire_reply.integer as i32, 1);
    resp_value_free(&expire_parsed.value);

    var ttl_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nTTL\r\n$3\r\nkey\r\n"[0: 22]);
    const ttl_command: Command = try command_executor_test_command(&router, &ttl_parsed);
    const ttl_reply: CommandReply = command_execute_at(&engine, &ttl_command, 1000u64);
    try assert_eq_i32(ttl_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(ttl_reply.integer as i32, 2);
    resp_value_free(&ttl_parsed.value);

    var pttl_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nPTTL\r\n$3\r\nkey\r\n"[0: 24]);
    const pttl_command: Command = try command_executor_test_command(&router, &pttl_parsed);
    const pttl_reply: CommandReply = command_execute_at(&engine, &pttl_command, 1000u64);
    try assert_eq_i32(pttl_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(pttl_reply.integer as i32, 2000);
    resp_value_free(&pttl_parsed.value);

    var expired_get_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22]);
    const expired_get_command: Command = try command_executor_test_command(&router, &expired_get_parsed);
    const expired_get_reply: CommandReply = command_execute_at(&engine, &expired_get_command, 4000u64);
    try assert_eq_i32(expired_get_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&expired_get_parsed.value);

    var missing_ttl_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nTTL\r\n$3\r\nkey\r\n"[0: 22]);
    const missing_ttl_command: Command = try command_executor_test_command(&router, &missing_ttl_parsed);
    const missing_ttl_reply: CommandReply = command_execute_at(&engine, &missing_ttl_command, 4000u64);
    try assert_eq_i32(missing_ttl_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(missing_ttl_reply.integer as i32, -2);
    resp_value_free(&missing_ttl_parsed.value);

    var missing_pttl_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nPTTL\r\n$3\r\nkey\r\n"[0: 24]);
    const missing_pttl_command: Command = try command_executor_test_command(&router, &missing_pttl_parsed);
    const missing_pttl_reply: CommandReply = command_execute_at(&engine, &missing_pttl_command, 4000u64);
    try assert_eq_i32(missing_pttl_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(missing_pttl_reply.integer as i32, -2);
    resp_value_free(&missing_pttl_parsed.value);

    var set_abs_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$3\r\nabs\r\n$5\r\nvalue\r\n"[0: 33]);
