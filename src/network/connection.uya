    var index: usize = 0;
    while index < CONNECTION_ACL_DENIED_COMMAND_MAX {
        if user.denied_commands[index].active &&
            connection_keyword_eq(user.denied_commands[index].name[0: user.denied_commands[index].name_len], name) {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

