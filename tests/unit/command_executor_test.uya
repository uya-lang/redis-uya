export fn test_command_zincrby_zcard_zcount() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var zadd_parsed: RespParseResult = try parse_resp2(&"*6\r\n$4\r\nZADD\r\n$4\r\nzset\r\n$1\r\n2\r\n$1\r\nb\r\n$1\r\n1\r\n$1\r\na\r\n"[0: 52]);
    const zadd_command: Command = try command_executor_test_command(&router, &zadd_parsed);
    _ = command_execute_at(&engine, &zadd_command, 1000u64);
    resp_value_free(&zadd_parsed.value);

    var zcard_parsed: RespParseResult = try parse_resp2(&"*2\r\n$5\r\nZCARD\r\n$4\r\nzset\r\n"[0: 25]);
    const zcard_command: Command = try command_executor_test_command(&router, &zcard_parsed);
    const zcard_reply: CommandReply = command_execute_at(&engine, &zcard_command, 1000u64);
    try assert_eq_i32(zcard_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(zcard_reply.integer as i32, 2);
    resp_value_free(&zcard_parsed.value);

    var zcount_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nZCOUNT\r\n$4\r\nzset\r\n$1\r\n1\r\n$1\r\n2\r\n"[0: 40]);
    const zcount_command: Command = try command_executor_test_command(&router, &zcount_parsed);
    const zcount_reply: CommandReply = command_execute_at(&engine, &zcount_command, 1000u64);
    try assert_eq_i32(zcount_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(zcount_reply.integer as i32, 2);
    resp_value_free(&zcount_parsed.value);

    var zadd_lex_parsed: RespParseResult = try parse_resp2(&"*10\r\n$4\r\nZADD\r\n$3\r\nlex\r\n$1\r\n0\r\n$5\r\nalpha\r\n$1\r\n0\r\n$4\r\nbeta\r\n$1\r\n0\r\n$7\r\ncharlie\r\n$1\r\n0\r\n$5\r\ndelta\r\n"[0: 97]);
    const zadd_lex_command: Command = try command_executor_test_command(&router, &zadd_lex_parsed);
    _ = command_execute_at(&engine, &zadd_lex_command, 1000u64);
    resp_value_free(&zadd_lex_parsed.value);

    var zlex_closed_parsed: RespParseResult = try parse_resp2(&"*4\r\n$9\r\nZLEXCOUNT\r\n$3\r\nlex\r\n$6\r\n[alpha\r\n$8\r\n[charlie\r\n"[0: 54]);
    const zlex_closed_command: Command = try command_executor_test_command(&router, &zlex_closed_parsed);
    const zlex_closed_reply: CommandReply = command_execute_at(&engine, &zlex_closed_command, 1000u64);
    try assert_eq_i32(zlex_closed_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(zlex_closed_reply.integer as i32, 3);
    resp_value_free(&zlex_closed_parsed.value);

    var zlex_excl_parsed: RespParseResult = try parse_resp2(&"*4\r\n$9\r\nZLEXCOUNT\r\n$3\r\nlex\r\n$6\r\n(alpha\r\n$6\r\n[delta\r\n"[0: 52]);
