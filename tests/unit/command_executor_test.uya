export fn test_command_wait() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();

    var wait_zero_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nWAIT\r\n$1\r\n0\r\n$1\r\n0\r\n"[0: 31]);
    const wait_zero_command: Command = try command_executor_test_command(&router, &wait_zero_parsed);
    const wait_zero_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &wait_zero_command, 1000u64);
    try assert_eq_i32(wait_zero_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(wait_zero_reply.integer as i32, 0);
    resp_value_free(&wait_zero_parsed.value);

    var wait_positive_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nWAIT\r\n$1\r\n1\r\n$2\r\n10\r\n"[0: 32]);
    const wait_positive_command: Command = try command_executor_test_command(&router, &wait_positive_parsed);
    const wait_positive_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &wait_positive_command, 1000u64);
    try assert_eq_i32(wait_positive_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(wait_positive_reply.integer as i32, 0);
    resp_value_free(&wait_positive_parsed.value);

    var wait_bad_timeout_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nWAIT\r\n$1\r\n1\r\n$2\r\n-1\r\n"[0: 32]);
    const wait_bad_timeout_command: Command = try command_executor_test_command(&router, &wait_bad_timeout_parsed);
    const wait_bad_timeout_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &wait_bad_timeout_command, 1000u64);
    try assert_eq_i32(wait_bad_timeout_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(wait_bad_timeout_reply.data, &"ERR timeout is negative"[0: 23]));
    resp_value_free(&wait_bad_timeout_parsed.value);

    var waitaof_local_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nWAITAOF\r\n$1\r\n1\r\n$1\r\n0\r\n$1\r\n0\r\n"[0: 38]);
    const waitaof_local_command: Command = try command_executor_test_command(&router, &waitaof_local_parsed);
    var waitaof_local_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &waitaof_local_command, 1000u64);
    try assert_eq_i32(waitaof_local_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(waitaof_local_reply.data, &"*2\r\n:1\r\n:0\r\n"[0: 12]));
    command_reply_cleanup(&waitaof_local_reply);
    resp_value_free(&waitaof_local_parsed.value);

    var waitaof_zero_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nWAITAOF\r\n$1\r\n0\r\n$1\r\n0\r\n$1\r\n0\r\n"[0: 38]);
    const waitaof_zero_command: Command = try command_executor_test_command(&router, &waitaof_zero_parsed);
    var waitaof_zero_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &waitaof_zero_command, 1000u64);
    try assert_eq_i32(waitaof_zero_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(waitaof_zero_reply.data, &"*2\r\n:0\r\n:0\r\n"[0: 12]));
    command_reply_cleanup(&waitaof_zero_reply);
    resp_value_free(&waitaof_zero_parsed.value);

    var waitaof_replicas_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nWAITAOF\r\n$1\r\n1\r\n$1\r\n1\r\n$2\r\n10\r\n"[0: 39]);
    const waitaof_replicas_command: Command = try command_executor_test_command(&router, &waitaof_replicas_parsed);
    var waitaof_replicas_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &waitaof_replicas_command, 1000u64);
    try assert_eq_i32(waitaof_replicas_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(waitaof_replicas_reply.data, &"*2\r\n:1\r\n:0\r\n"[0: 12]));
    command_reply_cleanup(&waitaof_replicas_reply);
    resp_value_free(&waitaof_replicas_parsed.value);

    var waitaof_bad_local_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nWAITAOF\r\n$3\r\nbad\r\n$1\r\n0\r\n$1\r\n0\r\n"[0: 40]);
    const waitaof_bad_local_command: Command = try command_executor_test_command(&router, &waitaof_bad_local_parsed);
    const waitaof_bad_local_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &waitaof_bad_local_command, 1000u64);
    try assert_eq_i32(waitaof_bad_local_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(waitaof_bad_local_reply.data, &"ERR value is not an integer or out of range"[0: 43]));
    resp_value_free(&waitaof_bad_local_parsed.value);

    var waitaof_bad_timeout_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nWAITAOF\r\n$1\r\n1\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 39]);
    const waitaof_bad_timeout_command: Command = try command_executor_test_command(&router, &waitaof_bad_timeout_parsed);
    const waitaof_bad_timeout_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &waitaof_bad_timeout_command, 1000u64);
    try assert_eq_i32(waitaof_bad_timeout_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(waitaof_bad_timeout_reply.data, &"ERR timeout is negative"[0: 23]));
    resp_value_free(&waitaof_bad_timeout_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_sort() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 512] = [];

    var rpush_nums_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nRPUSH\r\n$7\r\nsortnum\r\n$1\r\n3\r\n$1\r\n1\r\n$1\r\n2\r\n"[0: 49]);
    const rpush_nums_command: Command = try command_executor_test_command(&router, &rpush_nums_parsed);
    _ = command_execute_at(&engine, &rpush_nums_command, 1000u64);
    resp_value_free(&rpush_nums_parsed.value);

    var sort_default_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nSORT\r\n$7\r\nsortnum\r\n"[0: 27]);
    const sort_default_command: Command = try command_executor_test_command(&router, &sort_default_parsed);
    var sort_default_reply: CommandReply = command_execute_at(&engine, &sort_default_command, 1000u64);
    const sort_default_len: usize = try connection_encode_reply(&sort_default_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: sort_default_len], &"*3\r\n$1\r\n1\r\n$1\r\n2\r\n$1\r\n3\r\n"[0: 25]));
    command_reply_cleanup(&sort_default_reply);
    resp_value_free(&sort_default_parsed.value);

    var sort_desc_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nSORT\r\n$7\r\nsortnum\r\n$4\r\nDESC\r\n"[0: 37]);
    const sort_desc_command: Command = try command_executor_test_command(&router, &sort_desc_parsed);
    var sort_desc_reply: CommandReply = command_execute_at(&engine, &sort_desc_command, 1000u64);
    const sort_desc_len: usize = try connection_encode_reply(&sort_desc_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: sort_desc_len], &"*3\r\n$1\r\n3\r\n$1\r\n2\r\n$1\r\n1\r\n"[0: 25]));
    command_reply_cleanup(&sort_desc_reply);
    resp_value_free(&sort_desc_parsed.value);

    var sort_limit_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nSORT\r\n$7\r\nsortnum\r\n$5\r\nLIMIT\r\n$1\r\n1\r\n$1\r\n2\r\n"[0: 52]);
    const sort_limit_command: Command = try command_executor_test_command(&router, &sort_limit_parsed);
    var sort_limit_reply: CommandReply = command_execute_at(&engine, &sort_limit_command, 1000u64);
    const sort_limit_len: usize = try connection_encode_reply(&sort_limit_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: sort_limit_len], &"*2\r\n$1\r\n2\r\n$1\r\n3\r\n"[0: 18]));
    command_reply_cleanup(&sort_limit_reply);
    resp_value_free(&sort_limit_parsed.value);

    var set_w1_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$7\r\nsortw_1\r\n$2\r\n20\r\n"[0: 35]);
    const set_w1_command: Command = try command_executor_test_command(&router, &set_w1_parsed);
    _ = command_execute_at(&engine, &set_w1_command, 1000u64);
    resp_value_free(&set_w1_parsed.value);

    var set_w2_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$7\r\nsortw_2\r\n$2\r\n10\r\n"[0: 35]);
    const set_w2_command: Command = try command_executor_test_command(&router, &set_w2_parsed);
    _ = command_execute_at(&engine, &set_w2_command, 1000u64);
    resp_value_free(&set_w2_parsed.value);

    var set_w3_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$7\r\nsortw_3\r\n$2\r\n30\r\n"[0: 35]);
    const set_w3_command: Command = try command_executor_test_command(&router, &set_w3_parsed);
    _ = command_execute_at(&engine, &set_w3_command, 1000u64);
    resp_value_free(&set_w3_parsed.value);

    var sort_by_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nSORT\r\n$7\r\nsortnum\r\n$2\r\nBY\r\n$7\r\nsortw_*\r\n"[0: 48]);
    const sort_by_command: Command = try command_executor_test_command(&router, &sort_by_parsed);
    var sort_by_reply: CommandReply = command_execute_at(&engine, &sort_by_command, 1000u64);
    const sort_by_len: usize = try connection_encode_reply(&sort_by_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: sort_by_len], &"*3\r\n$1\r\n2\r\n$1\r\n1\r\n$1\r\n3\r\n"[0: 25]));
    command_reply_cleanup(&sort_by_reply);
    resp_value_free(&sort_by_parsed.value);

