    _ = command_execute_at(&engine, &sadd_s3_command, 1000u64);
    resp_value_free(&sadd_s3_parsed.value);

    var sinterstore_parsed: RespParseResult = try parse_resp2(&"*5\r\n$11\r\nSINTERSTORE\r\n$2\r\nsi\r\n$2\r\ns1\r\n$2\r\ns2\r\n$2\r\ns3\r\n"[0: 54]);
    const sinterstore_command: Command = try command_executor_test_command(&router, &sinterstore_parsed);
