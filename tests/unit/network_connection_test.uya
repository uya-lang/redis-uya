    try assert_true(network_connection_slice_eq(out[0: zmpop_result.response_len], &"*2\r\n$3\r\nzm2\r\n*2\r\n*2\r\n$1\r\na\r\n$1\r\n1\r\n*2\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 53]));

    const zmpop_last_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$5\r\nZMPOP\r\n$1\r\n1\r\n$3\r\nzm2\r\n$3\r\nMAX\r\n"[0: 40], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: zmpop_last_result.response_len], &"*2\r\n$3\r\nzm2\r\n*1\r\n*2\r\n$1\r\nc\r\n$1\r\n3\r\n"[0: 35]));

    const zblock2_seed_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*8\r\n$4\r\nZADD\r\n$7\r\nzblock2\r\n$1\r\n1\r\n$1\r\na\r\n$1\r\n2\r\n$1\r\nb\r\n$1\r\n3\r\n$1\r\nc\r\n"[0: 69], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: zblock2_seed_result.response_len], &":3\r\n"[0: 4]));

    const bzmpop_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*8\r\n$6\r\nBZMPOP\r\n$1\r\n1\r\n$1\r\n2\r\n$4\r\nmiss\r\n$7\r\nzblock2\r\n$3\r\nMIN\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n"[0: 80], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bzmpop_result.response_len], &"*2\r\n$7\r\nzblock2\r\n*2\r\n*2\r\n$1\r\na\r\n$1\r\n1\r\n*2\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 57]));

    const bzmpop_last_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$6\r\nBZMPOP\r\n$1\r\n1\r\n$1\r\n1\r\n$7\r\nzblock2\r\n$3\r\nMAX\r\n"[0: 52], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bzmpop_last_result.response_len], &"*2\r\n$7\r\nzblock2\r\n*1\r\n*2\r\n$1\r\nc\r\n$1\r\n3\r\n"[0: 39]));

    const info_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$4\r\nINFO\r\n$6\r\nserver\r\n"[0: 26], &out[0], 256, 1000u64);
    try assert_eq_i32(info_result.response_len as i32, 109);
    try assert_true(network_connection_contains(out[0: info_result.response_len], &"$101\r\n# Server\r\n"[0: 16]));
    try assert_true(network_connection_contains(out[0: info_result.response_len], &"redis_uya_version:"[0: 18]));
    try assert_true(network_connection_contains(out[0: info_result.response_len], redis_uya_version()));
    try assert_true(network_connection_contains(out[0: info_result.response_len], &"tcp_port:6379\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: info_result.response_len], &"uptime_in_seconds:0\r\n\r\n\r\n"[0: 24]));

    const replicaof_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$9\r\nREPLICAOF\r\n$9\r\n127.0.0.1\r\n$4\r\n6381\r\n"[0: 44], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: replicaof_result.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(replicaof_result.request_replicaof as i32, 1);
    try assert_eq_i32(replicaof_result.replicaof_promote as i32, 0);

    const replconf_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$8\r\nREPLCONF\r\n$4\r\nCAPA\r\n$6\r\npsync2\r\n"[0: 40], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: replconf_result.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(replconf_result.request_replicaof as i32, 0);

    const config_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$4\r\nport\r\n"[0: 35], &out[0], 256, 1000u64);
    try assert_eq_i32(config_result.response_len as i32, 24);
    try assert_true(network_connection_slice_eq(out[0: config_result.response_len], &"*2\r\n$4\r\nport\r\n$4\r\n6379\r\n"[0: 24]));

    const rewrite_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$12\r\nBGREWRITEAOF\r\n"[0: 23], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: rewrite_result.response_len], &"+Background AOF rewrite scheduled\r\n"[0: 35]));
    try assert_eq_i32(rewrite_result.request_aof_rewrite as i32, 1);

    const quit: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$4\r\nQUIT\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: quit.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(quit.close_after as i32, 1);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_slowlog() !void {
    reset_memory_stats_for_test();
    slowlog_reset();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 1024] = [];
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.slowlog_log_slower_than = 0;

    const reset_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*2\r\n$7\r\nSLOWLOG\r\n$5\r\nRESET\r\n"[0: 29], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_result.response_len], &"+OK\r\n"[0: 5]));

    const set_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*3\r\n$3\r\nSET\r\n$4\r\nskey\r\n$5\r\nvalue\r\n"[0: 34], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_result.response_len], &"+OK\r\n"[0: 5]));

    const get_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*2\r\n$3\r\nGET\r\n$4\r\nskey\r\n"[0: 23], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_result.response_len], &"$5\r\nvalue\r\n"[0: 11]));

    const len_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*2\r\n$7\r\nSLOWLOG\r\n$3\r\nLEN\r\n"[0: 27], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: len_result.response_len], &":2\r\n"[0: 4]));

    const get_one_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*3\r\n$7\r\nSLOWLOG\r\n$3\r\nGET\r\n$1\r\n1\r\n"[0: 34], &out[0], 1024, 1000u64);
    try assert_true(network_connection_contains(out[0: get_one_result.response_len], &"$3\r\nGET\r\n$4\r\nskey\r\n"[0: 19]));

    const reset_again_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*2\r\n$7\r\nSLOWLOG\r\n$5\r\nRESET\r\n"[0: 29], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_again_result.response_len], &"+OK\r\n"[0: 5]));

    const len_zero_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*2\r\n$7\r\nSLOWLOG\r\n$3\r\nLEN\r\n"[0: 27], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: len_zero_result.response_len], &":0\r\n"[0: 4]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_latency() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 2048] = [];

    _ = try connection_process_input_at(&engine, &router, &"*2\r\n$6\r\nCONFIG\r\n$9\r\nRESETSTAT\r\n"[0: 31], &out[0], 2048, 1000u64);
    _ = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nLATENCY\r\n$5\r\nRESET\r\n"[0: 28], &out[0], 1024, 1000u64);

    const latest_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nLATENCY\r\n$6\r\nLATEST\r\n"[0: 29], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: latest_result.response_len], &"*0\r\n"[0: 4]));

    var latency_runtime: CommandRuntimeInfo = command_runtime_default();
    latency_runtime.config.latency_monitor_threshold = 1;
    _ = try connection_process_input_with_runtime_at(&engine, &latency_runtime, &router, &"*3\r\n$3\r\nSET\r\n$5\r\nlat-k\r\n$1\r\n1\r\n"[0: 31], &out[0], 2048, 2000u64);

    const latest_recorded_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nLATENCY\r\n$6\r\nLATEST\r\n"[0: 29], &out[0], 2048, 2000u64);
    try assert_true(network_connection_contains(out[0: latest_recorded_result.response_len], &"$7\r\ncommand\r\n"[0: 13]));
    try assert_true(network_connection_contains(out[0: latest_recorded_result.response_len], &":2\r\n"[0: 4]));

    const history_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$7\r\nLATENCY\r\n$7\r\nHISTORY\r\n$7\r\ncommand\r\n"[0: 43], &out[0], 2048, 2000u64);
    try assert_true(network_connection_contains(out[0: history_result.response_len], &":2\r\n"[0: 4]));

    const histogram_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$7\r\nLATENCY\r\n$9\r\nHISTOGRAM\r\n$3\r\nSET\r\n"[0: 41], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: histogram_result.response_len], &"$3\r\nset\r\n"[0: 9]));
    try assert_true(network_connection_contains(out[0: histogram_result.response_len], &"$5\r\ncalls\r\n:1\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: histogram_result.response_len], &"$14\r\nhistogram_usec\r\n"[0: 21]));

    _ = try connection_process_input_at(&engine, &router, &"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$16\r\nlatency-tracking\r\n$3\r\nyes\r\n"[0: 57], &out[0], 2048, 2000u64);
    const histogram_config_set_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$7\r\nLATENCY\r\n$9\r\nHISTOGRAM\r\n$10\r\nCONFIG|SET\r\n"[0: 49], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: histogram_config_set_result.response_len], &"$10\r\nconfig|set\r\n"[0: 17]));
    try assert_true(network_connection_contains(out[0: histogram_config_set_result.response_len], &"$5\r\ncalls\r\n:1\r\n"[0: 15]));

    const doctor_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nLATENCY\r\n$6\r\nDOCTOR\r\n"[0: 29], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: doctor_result.response_len], &"recorded command events"[0: 23]));

    const reset_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nLATENCY\r\n$5\r\nRESET\r\n"[0: 28], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_result.response_len], &":1\r\n"[0: 4]));

    _ = try connection_process_input_at(&engine, &router, &"*2\r\n$6\r\nCONFIG\r\n$9\r\nRESETSTAT\r\n"[0: 31], &out[0], 2048, 1000u64);
    const histogram_reset_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$7\r\nLATENCY\r\n$9\r\nHISTOGRAM\r\n$3\r\nSET\r\n"[0: 41], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: histogram_reset_result.response_len], &"*0\r\n"[0: 4]));

    const unknown_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$7\r\nLATENCY\r\n$1\r\nX\r\n"[0: 24], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: unknown_result.response_len], &"-ERR unknown subcommand 'X'. Try LATENCY HELP.\r\n"[0: 48]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_monitor() !void {
    reset_memory_stats_for_test();
    connection_monitor_reset_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    var out: [byte: 1024] = [];

    const monitor_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nMONITOR\r\n"[0: 17], &out[0], 1024, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: monitor_result.response_len], &"+OK\r\n"[0: 5]));

    const ping_blocked: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 1024, 1001u64);
    try assert_true(network_connection_contains(out[0: ping_blocked.response_len], &"only RESET / QUIT are allowed in monitor mode"[0: 45]));

    const reset_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nRESET\r\n"[0: 15], &out[0], 1024, 1002u64);
    try assert_true(network_connection_slice_eq(out[0: reset_result.response_len], &"+RESET\r\n"[0: 8]));

    const ping_after_reset: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 1024, 1003u64);
    try assert_true(network_connection_slice_eq(out[0: ping_after_reset.response_len], &"+PONG\r\n"[0: 7]));

    connection_transaction_reset(&tx);
    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_lmpop() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 128] = [];

    const seed_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$5\r\nRPUSH\r\n$5\r\nlmpop\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 47], &out[0], 128, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: seed_result.response_len], &":3\r\n"[0: 4]));

    const lmpop_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*7\r\n$5\r\nLMPOP\r\n$1\r\n2\r\n$4\r\nmiss\r\n$5\r\nlmpop\r\n$4\r\nLEFT\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n"[0: 71], &out[0], 128, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: lmpop_result.response_len], &"*2\r\n$5\r\nlmpop\r\n*2\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 33]));

    const lmpop_tail_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$5\r\nLMPOP\r\n$1\r\n1\r\n$5\r\nlmpop\r\n$5\r\nRIGHT\r\n"[0: 44], &out[0], 128, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: lmpop_tail_result.response_len], &"*2\r\n$5\r\nlmpop\r\n*1\r\n$1\r\nc\r\n"[0: 26]));

    const lmpop_missing_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$5\r\nLMPOP\r\n$1\r\n1\r\n$5\r\nlmpop\r\n$4\r\nLEFT\r\n"[0: 43], &out[0], 128, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: lmpop_missing_result.response_len], &"*-1\r\n"[0: 5]));

    const seed_blmpop_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$5\r\nRPUSH\r\n$6\r\nblmpop\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 48], &out[0], 128, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: seed_blmpop_result.response_len], &":3\r\n"[0: 4]));

    const blmpop_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*8\r\n$6\r\nBLMPOP\r\n$1\r\n1\r\n$1\r\n2\r\n$4\r\nmiss\r\n$6\r\nblmpop\r\n$4\r\nLEFT\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n"[0: 80], &out[0], 128, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: blmpop_result.response_len], &"*2\r\n$6\r\nblmpop\r\n*2\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 34]));

    const blmpop_tail_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$6\r\nBLMPOP\r\n$1\r\n1\r\n$1\r\n1\r\n$6\r\nblmpop\r\n$5\r\nRIGHT\r\n"[0: 53], &out[0], 128, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: blmpop_tail_result.response_len], &"*2\r\n$6\r\nblmpop\r\n*1\r\n$1\r\nc\r\n"[0: 27]));

    var blmpop_tx: ConnectionTransaction = connection_transaction_new();
    const blmpop_block_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &blmpop_tx, &"*5\r\n$6\r\nBLMPOP\r\n$3\r\n0.1\r\n$1\r\n1\r\n$6\r\nblmpop\r\n$4\r\nLEFT\r\n"[0: 54], &out[0], 128, 1000u64);
    try assert_eq_i32(blmpop_block_result.response_len as i32, 0);
    const blmpop_missing_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &blmpop_tx, &"*5\r\n$6\r\nBLMPOP\r\n$3\r\n0.1\r\n$1\r\n1\r\n$6\r\nblmpop\r\n$4\r\nLEFT\r\n"[0: 54], &out[0], 128, 1200u64);
    try assert_true(network_connection_slice_eq(out[0: blmpop_missing_result.response_len], &"*-1\r\n"[0: 5]));
    connection_transaction_reset(&blmpop_tx);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_blocking_list_commands() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    const seed_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$5\r\nRPUSH\r\n$3\r\nblk\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 39], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: seed_result.response_len], &":2\r\n"[0: 4]));

    const blpop_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$5\r\nBLPOP\r\n$4\r\nmiss\r\n$3\r\nblk\r\n$1\r\n1\r\n"[0: 44], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: blpop_result.response_len], &"*2\r\n$3\r\nblk\r\n$1\r\na\r\n"[0: 20]));

    const brpop_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$5\r\nBRPOP\r\n$4\r\nmiss\r\n$3\r\nblk\r\n$1\r\n1\r\n"[0: 44], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: brpop_result.response_len], &"*2\r\n$3\r\nblk\r\n$1\r\nb\r\n"[0: 20]));

    const seed_move_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$5\r\nRPUSH\r\n$3\r\nmov\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 38], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: seed_move_result.response_len], &":2\r\n"[0: 4]));

    const blmove_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*6\r\n$6\r\nBLMOVE\r\n$3\r\nmov\r\n$3\r\ndst\r\n$5\r\nRIGHT\r\n$4\r\nLEFT\r\n$1\r\n1\r\n"[0: 62], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: blmove_result.response_len], &"$1\r\nb\r\n"[0: 7]));

    const dst_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$6\r\nLRANGE\r\n$3\r\ndst\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 40], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: dst_result.response_len], &"*1\r\n$1\r\nb\r\n"[0: 11]));

    const seed_movem_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$5\r\nRPUSH\r\n$3\r\nbmv\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 45], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: seed_movem_result.response_len], &":3\r\n"[0: 4]));

    const blmovem_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*9\r\n$7\r\nBLMOVEM\r\n$3\r\nbmv\r\n$4\r\nbdst\r\n$4\r\nLEFT\r\n$5\r\nRIGHT\r\n$1\r\n1\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n$4\r\nBULK\r\n"[0: 92], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: blmovem_result.response_len], &"*2\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 18]));

    const seed_exact_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$5\r\nRPUSH\r\n$5\r\nexsrc\r\n$1\r\na\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: seed_exact_result.response_len], &":1\r\n"[0: 4]));

    var blmovem_tx: ConnectionTransaction = connection_transaction_new();
    const blmovem_block_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &blmovem_tx, &"*9\r\n$7\r\nBLMOVEM\r\n$5\r\nexsrc\r\n$5\r\nexdst\r\n$4\r\nLEFT\r\n$5\r\nRIGHT\r\n$3\r\n0.1\r\n$7\r\nEXACTLY\r\n$1\r\n2\r\n$4\r\nBULK\r\n"[0: 99], &out[0], 256, 1000u64);
    try assert_eq_i32(blmovem_block_result.response_len as i32, 0);

    const wake_exact_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$5\r\nRPUSH\r\n$5\r\nexsrc\r\n$1\r\nb\r\n"[0: 33], &out[0], 256, 1050u64);
    try assert_true(network_connection_slice_eq(out[0: wake_exact_result.response_len], &":2\r\n"[0: 4]));

    const blmovem_unblock_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &blmovem_tx, &"*9\r\n$7\r\nBLMOVEM\r\n$5\r\nexsrc\r\n$5\r\nexdst\r\n$4\r\nLEFT\r\n$5\r\nRIGHT\r\n$3\r\n0.1\r\n$7\r\nEXACTLY\r\n$1\r\n2\r\n$4\r\nBULK\r\n"[0: 99], &out[0], 256, 1050u64);
    try assert_true(network_connection_slice_eq(out[0: blmovem_unblock_result.response_len], &"*2\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 18]));
    connection_transaction_reset(&blmovem_tx);

    var blmovem_timeout_tx: ConnectionTransaction = connection_transaction_new();
    const blmovem_timeout_block_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &blmovem_timeout_tx, &"*6\r\n$7\r\nBLMOVEM\r\n$7\r\ntimeout\r\n$3\r\nout\r\n$4\r\nLEFT\r\n$5\r\nRIGHT\r\n$3\r\n0.1\r\n"[0: 69], &out[0], 256, 1000u64);
    try assert_eq_i32(blmovem_timeout_block_result.response_len as i32, 0);
    const blmovem_timeout_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &blmovem_timeout_tx, &"*6\r\n$7\r\nBLMOVEM\r\n$7\r\ntimeout\r\n$3\r\nout\r\n$4\r\nLEFT\r\n$5\r\nRIGHT\r\n$3\r\n0.1\r\n"[0: 69], &out[0], 256, 1200u64);
    try assert_true(network_connection_slice_eq(out[0: blmovem_timeout_result.response_len], &"*-1\r\n"[0: 5]));
    connection_transaction_reset(&blmovem_timeout_tx);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_touch_unlink() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 128] = [];

    const set_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$7\r\ntouchme\r\n$5\r\nvalue\r\n"[0: 37], &out[0], 128, 1000u64);
