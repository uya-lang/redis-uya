fn command_executor_georadiusbymember_ro(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 5 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    var options: CommandExecutorGeoSearchOptions = command_executor_geo_search_defaults();
    options.from_member = true;
    options.center_member = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const radius: f64 = command_executor_parse_f64(command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    }) catch {
        return command_executor_error(&"ERR value is not a valid float"[0: 30]);
    };
    const unit: &[byte] = command_executor_arg(command, 4) catch {
        return command_executor_wrong_arity();
    };
    const unit_scale: f64 = command_executor_geo_unit_scale(unit) catch {
        return command_executor_error(&"ERR unsupported unit provided. please use M, KM, FT, MI"[0: 57]);
    };
    options.by_radius = true;
    options.radius_m = radius * unit_scale;
    options.unit_scale = unit_scale;

    var index: usize = 5;
    while index < command.argc {
        const token: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(token, &"ASC"[0: 3]) {
            if options.order != CommandExecutorGeoOrder.geo_order_none {
                return command_executor_syntax_error();
            }
            options.order = CommandExecutorGeoOrder.geo_order_asc;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"DESC"[0: 4]) {
            if options.order != CommandExecutorGeoOrder.geo_order_none {
                return command_executor_syntax_error();
            }
            options.order = CommandExecutorGeoOrder.geo_order_desc;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"COUNT"[0: 5]) {
            if options.has_count || index + 1 >= command.argc {
                return command_executor_syntax_error();
            }
            const count_i64: i64 = command_executor_parse_i64(command_executor_arg(command, index + 1) catch {
                return command_executor_wrong_arity();
            }) catch {
                return command_executor_invalid_integer();
            };
            if count_i64 <= 0 {
                return command_executor_error(&"ERR COUNT must be > 0"[0: 22]);
            }
            options.has_count = true;
            options.count_limit = count_i64 as usize;
            index = index + 2;
            if index < command.argc {
                const any_token: &[byte] = command_executor_arg(command, index) catch {
                    return command_executor_wrong_arity();
                };
                if command_executor_keyword_eq(any_token, &"ANY"[0: 3]) {
                    options.any = true;
                    index = index + 1;
                }
            }
            continue;
        }
        if command_executor_keyword_eq(token, &"WITHCOORD"[0: 9]) {
            options.withcoord = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"WITHDIST"[0: 8]) {
            options.withdist = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"WITHHASH"[0: 8]) {
            options.withhash = true;
            index = index + 1;
            continue;
        }
        return command_executor_syntax_error();
    }

    return command_executor_geo_search_run(engine, key, &options, now_ms);
}

fn command_executor_zadd(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 || ((command.argc - 2) % (2 as usize)) != 0 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        const zset_obj: &RedisObject = create_zset_object() catch {
            return command_executor_oom();
        };
        var added_new: i64 = 0;
        var index_new: usize = 2;
        while index_new + 1 < command.argc {
            const score_data_new: &[byte] = command_executor_arg(command, index_new) catch {
                object_free(zset_obj);
                return command_executor_wrong_arity();
            };
            const member_new: &[byte] = command_executor_arg(command, index_new + 1) catch {
                object_free(zset_obj);
                return command_executor_wrong_arity();
            };
            const score_new: i64 = command_executor_parse_i64(score_data_new) catch {
                object_free(zset_obj);
                return command_executor_invalid_integer();
            };
            const inserted_new: bool = zset_object_add_member(zset_obj, score_new, member_new) catch |err| {
                object_free(zset_obj);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_error(&"ERR zset add failed"[0: 20]);
            };
            if inserted_new {
                added_new = added_new + 1;
            }
            index_new = index_new + 2;
        }
        _ = set_key_at(engine, key, zset_obj, now_ms) catch {
            object_free(zset_obj);
            return command_executor_oom();
        };
        return command_executor_integer(added_new);
    };

    if existing.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    var added: i64 = 0;
    var index: usize = 2;
    while index + 1 < command.argc {
        const score_data: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const member: &[byte] = command_executor_arg(command, index + 1) catch {
            return command_executor_wrong_arity();
        };
        const score: i64 = command_executor_parse_i64(score_data) catch {
            return command_executor_invalid_integer();
        };
        const inserted: bool = zset_object_add_member(existing, score, member) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_error(&"ERR zset add failed"[0: 20]);
        };
        if inserted {
            added = added + 1;
        }
        index = index + 2;
    }
    return command_executor_integer(added);
}

fn command_executor_zrange_rank_reply(obj: &RedisObject, start: i64, stop: i64, reverse: bool, with_scores: bool) CommandReply {
    var ranked: &RedisObject = zset_object_range_reply(obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };

    if reverse {
        const reversed: &RedisObject = create_list_object() catch {
            object_free(ranked);
            return command_executor_oom();
        };
        var reverse_node: &ListNode = ranked.list_tail;
        while reverse_node != null {
            const member: &[byte] = reverse_node.value.value.buf[0: reverse_node.value.value.len];
            _ = list_object_push_tail(reversed, member) catch {
                object_free(ranked);
                object_free(reversed);
                return command_executor_oom();
            };
            reverse_node = reverse_node.prev;
        }
        object_free(ranked);
        ranked = reversed;
    }

    const view: ListRangeView = list_object_range(ranked, start, stop) catch {
        object_free(ranked);
        return command_executor_wrongtype();
    };
    if !with_scores {
        var reply: CommandReply = command_executor_array_bulk(view.head, view.count);
        reply.owned_object = ranked;
        return reply;
    }

    const scored: &RedisObject = create_list_object() catch {
        object_free(ranked);
        return command_executor_oom();
    };
    var current: &ListNode = view.head;
    var emitted: usize = 0;
    while current != null && emitted < view.count {
        const member_scored: &[byte] = current.value.value.buf[0: current.value.value.len];
        const score: i64 = zset_object_get_score(obj, member_scored) catch {
            object_free(ranked);
            object_free(scored);
            return command_executor_wrongtype();
        };
        _ = list_object_push_tail(scored, member_scored) catch {
            object_free(ranked);
            object_free(scored);
            return command_executor_oom();
        };
        _ = command_executor_list_push_i64(scored, score) catch {
            object_free(ranked);
            object_free(scored);
            return command_executor_oom();
        };
        current = current.next;
        emitted = emitted + 1;
    }
    object_free(ranked);
    return command_executor_owned_array(scored);
}

fn command_executor_zrange(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const start_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const stop_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };

    var reverse: bool = false;
    var with_scores: bool = false;
    var by_score: bool = false;
    var by_lex: bool = false;
    var limit_enabled: bool = false;
    var limit_offset: usize = 0;
    var limit_count: i64 = -1;
    var index: usize = 4;
    while index < command.argc {
        const option: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(option, &"REV"[0: 3]) {
            if reverse {
                return command_executor_syntax_error();
            }
            reverse = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(option, &"WITHSCORES"[0: 10]) {
            if with_scores {
                return command_executor_syntax_error();
            }
            with_scores = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(option, &"BYSCORE"[0: 7]) {
            if by_score || by_lex {
                return command_executor_syntax_error();
            }
            by_score = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(option, &"BYLEX"[0: 5]) {
            if by_score || by_lex {
                return command_executor_syntax_error();
            }
            by_lex = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(option, &"LIMIT"[0: 5]) {
            if limit_enabled || index + 2 >= command.argc {
                return command_executor_syntax_error();
            }
            const offset_data: &[byte] = command_executor_arg(command, index + 1) catch {
                return command_executor_wrong_arity();
            };
            const count_data: &[byte] = command_executor_arg(command, index + 2) catch {
                return command_executor_wrong_arity();
            };
            const offset_i64: i64 = command_executor_parse_i64(offset_data) catch {
                return command_executor_invalid_integer();
            };
            if offset_i64 < 0 {
                return command_executor_error(&"ERR offset out of range"[0: 23]);
            }
            limit_enabled = true;
            limit_offset = offset_i64 as usize;
            limit_count = command_executor_parse_i64(count_data) catch {
                return command_executor_invalid_integer();
            };
            index = index + 3;
            continue;
        }
        return command_executor_syntax_error();
    }
    if by_lex && with_scores {
        return command_executor_syntax_error();
    }
    if limit_enabled && !by_score && !by_lex {
        return command_executor_syntax_error();
    }

    if by_score {
        const start_score: i64 = command_executor_parse_i64(start_data) catch {
            return command_executor_invalid_integer();
        };
        const stop_score: i64 = command_executor_parse_i64(stop_data) catch {
            return command_executor_invalid_integer();
        };
        const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
            return command_executor_array_bulk(null as &ListNode, 0);
        };
        if obj.obj_type != ObjectType.object_zset {
            return command_executor_wrongtype();
        }
        if reverse {
            return command_executor_zscore_range_reply(obj, stop_score, start_score, true, with_scores, limit_enabled, limit_offset, limit_count);
        }
        return command_executor_zscore_range_reply(obj, start_score, stop_score, false, with_scores, limit_enabled, limit_offset, limit_count);
    }
    if by_lex {
        if reverse {
            const max_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(start_data) catch {
                return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
            };
            const min_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(stop_data) catch {
                return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
            };
            const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
                return command_executor_array_bulk(null as &ListNode, 0);
            };
            if obj.obj_type != ObjectType.object_zset {
                return command_executor_wrongtype();
            }
            return command_executor_zlex_range_reply(obj, &min_bound, &max_bound, true, limit_enabled, limit_offset, limit_count);
        }
        const min_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(start_data) catch {
            return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
        };
        const max_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(stop_data) catch {
            return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
        };
        const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
            return command_executor_array_bulk(null as &ListNode, 0);
        };
        if obj.obj_type != ObjectType.object_zset {
            return command_executor_wrongtype();
        }
        return command_executor_zlex_range_reply(obj, &min_bound, &max_bound, false, limit_enabled, limit_offset, limit_count);
    }
    const start: i64 = command_executor_parse_i64(start_data) catch {
        return command_executor_invalid_integer();
    };
    const stop: i64 = command_executor_parse_i64(stop_data) catch {
        return command_executor_invalid_integer();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    return command_executor_zrange_rank_reply(obj, start, stop, reverse, with_scores);
}

fn command_executor_zrangestore_add_members(source_obj: &RedisObject, result_zset: &RedisObject, head: &ListNode, count: usize) !void {
    var node: &ListNode = head;
    var copied: usize = 0;
    while node != null && copied < count {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        const score: i64 = try zset_object_get_score(source_obj, member);
        _ = try zset_object_add_member(result_zset, score, member);
        node = node.next;
        copied = copied + 1;
    }
}

fn command_executor_zrangestore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 5 {
        return command_executor_wrong_arity();
    }
    const target: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const source: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const start_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const stop_data: &[byte] = command_executor_arg(command, 4) catch {
        return command_executor_wrong_arity();
    };

    var reverse: bool = false;
    var by_score: bool = false;
    var by_lex: bool = false;
    var limit_enabled: bool = false;
    var limit_offset: usize = 0;
    var limit_count: i64 = -1;
    var index: usize = 5;
    while index < command.argc {
        const option: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(option, &"REV"[0: 3]) {
            if reverse {
                return command_executor_syntax_error();
            }
            reverse = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(option, &"BYSCORE"[0: 7]) {
            if by_score || by_lex {
                return command_executor_syntax_error();
            }
            by_score = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(option, &"BYLEX"[0: 5]) {
            if by_score || by_lex {
                return command_executor_syntax_error();
            }
            by_lex = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(option, &"LIMIT"[0: 5]) {
            if limit_enabled || index + 2 >= command.argc {
                return command_executor_syntax_error();
            }
            const offset_data: &[byte] = command_executor_arg(command, index + 1) catch {
                return command_executor_wrong_arity();
            };
            const count_data: &[byte] = command_executor_arg(command, index + 2) catch {
                return command_executor_wrong_arity();
            };
            const offset_i64: i64 = command_executor_parse_i64(offset_data) catch {
                return command_executor_invalid_integer();
            };
            if offset_i64 < 0 {
                return command_executor_error(&"ERR offset out of range"[0: 23]);
            }
            limit_enabled = true;
            limit_offset = offset_i64 as usize;
            limit_count = command_executor_parse_i64(count_data) catch {
                return command_executor_invalid_integer();
            };
            index = index + 3;
            continue;
        }
        return command_executor_syntax_error();
    }
    if limit_enabled && !by_score && !by_lex {
        return command_executor_syntax_error();
    }
    if by_lex {
        var min_bound: CommandExecutorZLexBound = CommandExecutorZLexBound{
            negative_infinity: false,
            positive_infinity: false,
            exclusive: false,
            value: command_executor_empty_slice(),
        };
        var max_bound: CommandExecutorZLexBound = CommandExecutorZLexBound{
            negative_infinity: false,
            positive_infinity: false,
            exclusive: false,
            value: command_executor_empty_slice(),
        };
        if reverse {
            max_bound = command_executor_zlex_parse_bound(start_data) catch {
                return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
            };
            min_bound = command_executor_zlex_parse_bound(stop_data) catch {
                return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
            };
        } else {
            min_bound = command_executor_zlex_parse_bound(start_data) catch {
                return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
            };
            max_bound = command_executor_zlex_parse_bound(stop_data) catch {
                return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
            };
        }

        const result_zset: &RedisObject = create_zset_object() catch {
            return command_executor_oom();
        };
        const source_obj: &RedisObject = lookup_key_at(engine, source, now_ms) catch {
            return command_executor_zset_store_result(engine, target, result_zset, now_ms);
        };
        if source_obj.obj_type != ObjectType.object_zset {
            object_free(result_zset);
            return command_executor_wrongtype();
        }
        const ranged: &RedisObject = command_executor_zlex_range_members(source_obj, &min_bound, &max_bound, reverse, limit_enabled, limit_offset, limit_count) catch |err| {
            object_free(result_zset);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        const count: usize = list_object_len(ranged) catch {
            object_free(ranged);
            object_free(result_zset);
            return command_executor_wrongtype();
        };
        _ = command_executor_zrangestore_add_members(source_obj, result_zset, ranged.list_head, count) catch |err| {
            object_free(ranged);
            object_free(result_zset);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        object_free(ranged);
        return command_executor_zset_store_result(engine, target, result_zset, now_ms);
    }
    if !by_score {
        const start: i64 = command_executor_parse_i64(start_data) catch {
            return command_executor_invalid_integer();
        };
        const stop: i64 = command_executor_parse_i64(stop_data) catch {
            return command_executor_invalid_integer();
        };

        const result_zset: &RedisObject = create_zset_object() catch {
            return command_executor_oom();
        };
        const source_obj: &RedisObject = lookup_key_at(engine, source, now_ms) catch {
            return command_executor_zset_store_result(engine, target, result_zset, now_ms);
        };
        if source_obj.obj_type != ObjectType.object_zset {
            object_free(result_zset);
            return command_executor_wrongtype();
        }

        if !reverse {
            const ranged: &RedisObject = zset_object_range_reply(source_obj, start, stop) catch |err| {
                object_free(result_zset);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
            const count: usize = list_object_len(ranged) catch {
                object_free(ranged);
                object_free(result_zset);
                return command_executor_wrongtype();
            };
            _ = command_executor_zrangestore_add_members(source_obj, result_zset, ranged.list_head, count) catch |err| {
                object_free(ranged);
                object_free(result_zset);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
            object_free(ranged);
            return command_executor_zset_store_result(engine, target, result_zset, now_ms);
        }

        const ranked: &RedisObject = zset_object_range_reply(source_obj, 0, -1) catch |err| {
            object_free(result_zset);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        const reversed: &RedisObject = create_list_object() catch {
            object_free(ranked);
            object_free(result_zset);
            return command_executor_oom();
        };
        var reverse_node: &ListNode = ranked.list_tail;
        while reverse_node != null {
            const member_reversed: &[byte] = reverse_node.value.value.buf[0: reverse_node.value.value.len];
            _ = list_object_push_tail(reversed, member_reversed) catch {
                object_free(ranked);
                object_free(reversed);
                object_free(result_zset);
                return command_executor_oom();
            };
            reverse_node = reverse_node.prev;
        }
        object_free(ranked);

        const view: ListRangeView = list_object_range(reversed, start, stop) catch {
            object_free(reversed);
            object_free(result_zset);
            return command_executor_wrongtype();
        };
        _ = command_executor_zrangestore_add_members(source_obj, result_zset, view.head, view.count) catch |err| {
            object_free(reversed);
            object_free(result_zset);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        object_free(reversed);
        return command_executor_zset_store_result(engine, target, result_zset, now_ms);
    }

    const start_score: i64 = command_executor_parse_i64(start_data) catch {
        return command_executor_invalid_integer();
    };
    const stop_score: i64 = command_executor_parse_i64(stop_data) catch {
        return command_executor_invalid_integer();
    };
    var min_score: i64 = start_score;
    var max_score: i64 = stop_score;
    if reverse {
        min_score = stop_score;
        max_score = start_score;
    }
    const result_zset: &RedisObject = create_zset_object() catch {
        return command_executor_oom();
    };
    const source_obj: &RedisObject = lookup_key_at(engine, source, now_ms) catch {
        return command_executor_zset_store_result(engine, target, result_zset, now_ms);
    };
    if source_obj.obj_type != ObjectType.object_zset {
        object_free(result_zset);
        return command_executor_wrongtype();
    }

    if min_score > max_score {
        return command_executor_zset_store_result(engine, target, result_zset, now_ms);
    }
    const ranged: &RedisObject = zset_object_range_by_score_reply(source_obj, min_score, max_score, reverse) catch |err| {
        object_free(result_zset);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const count: usize = list_object_len(ranged) catch {
        object_free(ranged);
        object_free(result_zset);
        return command_executor_wrongtype();
    };
    var reply_head: &ListNode = ranged.list_head;
    var reply_count: usize = count;
    if limit_enabled {
        var limit_stop: i64 = -1;
        if limit_count >= 0 {
            limit_stop = (limit_offset as i64) + limit_count - 1;
        }
        const view: ListRangeView = list_object_range(ranged, limit_offset as i64, limit_stop) catch {
            object_free(ranged);
            object_free(result_zset);
            return command_executor_wrongtype();
        };
        reply_head = view.head;
        reply_count = view.count;
    }
    _ = command_executor_zrangestore_add_members(source_obj, result_zset, reply_head, reply_count) catch |err| {
        object_free(ranged);
        object_free(result_zset);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    object_free(ranged);
    return command_executor_zset_store_result(engine, target, result_zset, now_ms);
}

fn command_executor_zrevrange(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 && command.argc != 5 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const start_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const stop_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const start: i64 = command_executor_parse_i64(start_data) catch {
        return command_executor_invalid_integer();
    };
    const stop: i64 = command_executor_parse_i64(stop_data) catch {
        return command_executor_invalid_integer();
    };

    var with_scores: bool = false;
    if command.argc == 5 {
        const option: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(option, &"WITHSCORES"[0: 10]) {
            return command_executor_syntax_error();
        }
        with_scores = true;
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    return command_executor_zrange_rank_reply(obj, start, stop, true, with_scores);
}

fn command_executor_zrem(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    var removed: i64 = 0;
    var index: usize = 2;
    while index < command.argc {
        const member: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const deleted: bool = zset_object_remove_member(obj, member) catch {
            return command_executor_wrongtype();
        };
        if deleted {
            removed = removed + 1;
        }
        index = index + 1;
    }
    return command_executor_integer(removed);
}

fn command_executor_hget(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const field: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_hash {
        return command_executor_wrongtype();
    }
    const field_obj: &RedisObject = hash_object_get_field(obj, field) catch |err| {
        if err == error.ObjectFieldNotFound {
            return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
        }
        return command_executor_wrongtype();
    };
    const data: &[byte] = command_executor_string_value(field_obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_bulk(data);
}

fn command_executor_hdel(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_hash {
        return command_executor_wrongtype();
    }

    var removed: i64 = 0;
    var index: usize = 2;
    while index < command.argc {
        const field: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const deleted: bool = hash_object_delete_field(obj, field) catch {
            return command_executor_wrongtype();
        };
        if deleted {
            removed = removed + 1;
        }
        index = index + 1;
    }

    const remaining: usize = hash_object_len(obj) catch {
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, key);
    }
    return command_executor_integer(removed);
}

fn command_executor_hgetdel(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 5 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const fields_token: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    if !command_executor_keyword_eq(fields_token, &"FIELDS"[0: 6]) {
        return command_executor_syntax_error();
    }
    const numfields_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const numfields_i64: i64 = command_executor_parse_i64(numfields_data) catch {
        return command_executor_invalid_integer();
    };
    if numfields_i64 < 1 {
        return command_executor_invalid_integer();
    }
    const numfields: usize = numfields_i64 as usize;
    if command.argc != numfields + 4 {
        return command_executor_syntax_error();
    }

    const obj: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    if obj != null && obj.obj_type != ObjectType.object_hash {
        return command_executor_wrongtype();
    }

    const reply_list: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    var null_map: Sds = sds_empty() catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    defer {
        sds_free(&null_map);
    }

    var index: usize = 4;
    while index < command.argc {
        const field: &[byte] = command_executor_arg(command, index) catch {
            object_free(reply_list);
            return command_executor_wrong_arity();
        };
        var is_null: bool = false;
        var should_delete: bool = false;
        var data: &[byte] = command_executor_empty_slice();
        if obj == null {
            is_null = true;
        } else {
            const exists: bool = hash_object_exists_field(obj, field) catch {
                object_free(reply_list);
                return command_executor_wrongtype();
            };
            if !exists {
                is_null = true;
            } else {
                const field_obj: &RedisObject = hash_object_get_field(obj, field) catch {
                    object_free(reply_list);
                    return command_executor_wrongtype();
                };
                data = command_executor_string_value(field_obj) catch {
                    object_free(reply_list);
                    return command_executor_wrongtype();
                };
                should_delete = true;
            }
        }
        var flag: [byte: 1] = [];
        if is_null {
            flag[0] = 1 as byte;
        } else {
            flag[0] = 0 as byte;
        }
        _ = list_object_push_tail(reply_list, data) catch {
            object_free(reply_list);
            return command_executor_oom();
        };
        _ = sds_cat(&null_map, flag[0: 1]) catch {
            object_free(reply_list);
            return command_executor_oom();
        };
        if should_delete {
            _ = hash_object_delete_field(obj, field) catch {
                object_free(reply_list);
                return command_executor_wrongtype();
            };
        }
        index = index + 1;
    }

    if obj != null {
        const remaining: usize = hash_object_len(obj) catch {
            object_free(reply_list);
            return command_executor_wrongtype();
        };
        if remaining == 0 {
            _ = delete_key(engine, key);
        }
    }

    const null_map_obj: &RedisObject = create_string_object(null_map.buf[0: null_map.len]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    var reply: CommandReply = command_executor_nullable_array_bulk(reply_list.list_head, numfields, null_map_obj);
    reply.owned_object = reply_list;
    return reply;
}

fn command_executor_hexists(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const field: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_hash {
        return command_executor_wrongtype();
    }
    const exists: bool = hash_object_exists_field(obj, field) catch {
        return command_executor_wrongtype();
    };
    if exists {
        return command_executor_integer(1);
    }
    return command_executor_integer(0);
}

fn command_executor_hlen(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
