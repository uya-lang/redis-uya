    try assert_eq_i32(setnx_dup_reply.integer as i32, 0);
    resp_value_free(&setnx_dup_parsed.value);

    var getset_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nGETSET\r\n$6\r\ngs-key\r\n$5\r\nfirst\r\n"[0: 41]);
    const getset_missing_command: Command = try command_executor_test_command(&router, &getset_missing_parsed);
