    const hgetex_hget_reply: CommandReply = command_execute_at(&engine, &hgetex_hget_command, 1000u64);
    try assert_eq_i32(hgetex_hget_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_contains(hgetex_hget_reply.data, &"value"[0: 5]));
    resp_value_free(&hgetex_hget_parsed.value);

    var hsetex_parsed: RespParseResult = try parse_resp2(&"*8\r\n$6\r\nHSETEX\r\n$4\r\nhash\r\n$2\r\nEX\r\n$2\r\n10\r\n$6\r\nFIELDS\r\n$1\r\n1\r\n$5\r\nfresh\r\n$3\r\none\r\n"[0: 81]);
    const hsetex_command: Command = try command_executor_test_command(&router, &hsetex_parsed);
    const hsetex_reply: CommandReply = command_execute_at(&engine, &hsetex_command, 1000u64);
