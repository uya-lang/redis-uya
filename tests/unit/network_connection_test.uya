fn network_connection_slice_eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len { return false; }
    var i: usize = 0;
    while i < a.len {
        if a.ptr[i] != b.ptr[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn network_connection_contains(haystack: &[byte], needle: &[byte]) bool {
    if needle.len == 0 {
        return true;
    }
    if haystack.len < needle.len {
        return false;
    }
    var start: usize = 0;
    while start + needle.len <= haystack.len {
        var matched: bool = true;
        var i: usize = 0;
        while i < needle.len {
            if haystack.ptr[start + i] != needle.ptr[i] {
                matched = false;
                break;
            }
            i = i + 1;
        }
        if matched {
            return true;
        }
        start = start + 1;
    }
    return false;
}

fn network_connection_parse_resp2_collection_len(data: &[byte], prefix: byte) !u64 {
    if data.len < 4 || data.ptr[0] != prefix {
        return error.AssertionFailed;
    }
    var index: usize = 1;
    var value: u64 = 0u64;
    while index + 1 < data.len {
        const ch: byte = data.ptr[index];
        if ch == 13 as byte {
            if data.ptr[index + 1] != 10 as byte {
                return error.AssertionFailed;
            }
            return value;
        }
        if ch < 48 as byte || ch > 57 as byte {
            return error.AssertionFailed;
        }
        value = value * 10u64 + ((ch - 48 as byte) as u64);
        index = index + 1;
    }
    return error.AssertionFailed;
}

fn network_connection_reply(typ: CommandReplyType, data: &[byte], integer: i64) CommandReply {
    return CommandReply{
        typ: typ,
        data: data,
        integer: integer,
    };
}

export fn test_connection_encode_resp_replies() !void {
    var out: [byte: 128] = [];

    const simple: CommandReply = network_connection_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
    const simple_len: usize = try connection_encode_reply(&simple, &out[0], 128);
    try assert_true(network_connection_slice_eq(out[0: simple_len], &"+OK\r\n"[0: 5]));

    const integer: CommandReply = network_connection_reply(CommandReplyType.reply_integer, (null as &byte)[0: 0], -2);
    const integer_len: usize = try connection_encode_reply(&integer, &out[0], 128);
    try assert_true(network_connection_slice_eq(out[0: integer_len], &":-2\r\n"[0: 5]));

    const max_integer: CommandReply = network_connection_reply(CommandReplyType.reply_integer, (null as &byte)[0: 0], 9223372036854775807);
    var exact_integer_out: [byte: 22] = [];
    const max_integer_len: usize = try connection_encode_reply(&max_integer, &exact_integer_out[0], 22);
    try assert_true(network_connection_slice_eq(exact_integer_out[0: max_integer_len], &":9223372036854775807\r\n"[0: 22]));

    var small_integer_out: [byte: 21] = [];
    var saw_output_too_small: bool = false;
    _ = connection_encode_reply(&max_integer, &small_integer_out[0], 21) catch |err| {
        if err == error.ConnectionOutputTooSmall {
            saw_output_too_small = true;
        }
        return;
    };
    try assert_true(saw_output_too_small);

    const bulk: CommandReply = network_connection_reply(CommandReplyType.reply_bulk_string, &"value"[0: 5], 0);
    const bulk_len: usize = try connection_encode_reply(&bulk, &out[0], 128);
    try assert_true(network_connection_slice_eq(out[0: bulk_len], &"$5\r\nvalue\r\n"[0: 11]));

    const null_bulk: CommandReply = network_connection_reply(CommandReplyType.reply_null_bulk, (null as &byte)[0: 0], 0);
    const null_len: usize = try connection_encode_reply(&null_bulk, &out[0], 128);
    try assert_true(network_connection_slice_eq(out[0: null_len], &"$-1\r\n"[0: 5]));

    const null_array: CommandReply = network_connection_reply(CommandReplyType.reply_null_array, (null as &byte)[0: 0], 0);
    const null_array_len: usize = try connection_encode_reply(&null_array, &out[0], 128);
    try assert_true(network_connection_slice_eq(out[0: null_array_len], &"*-1\r\n"[0: 5]));
}

export fn test_connection_ping_parse_uses_borrowed_storage() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 32] = [];
    const allocations_before: usize = allocator_total_allocations();

    const result: ConnectionProcessResult = try connection_process_input_at(
        &engine,
        &router,
        &"*1\r\n$4\r\nPING\r\n"[0: 14],
        &out[0],
        32,
        1000u64,
    );
    try assert_true(network_connection_slice_eq(out[0: result.response_len], &"+PONG\r\n"[0: 7]));
    try assert_eq_i32(allocator_total_allocations() as i32, allocations_before as i32);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_ping_set_get_quit() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    const ping: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ping.response_len], &"+PONG\r\n"[0: 7]));
    try assert_eq_i32(ping.close_after as i32, 0);

    const time_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$4\r\nTIME\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: time_result.response_len], &"*2\r\n$1\r\n1\r\n$1\r\n0\r\n"[0: 18]));

    const role_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$4\r\nROLE\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: role_result.response_len], &"*3\r\n$6\r\nmaster\r\n:0\r\n*0\r\n"[0: 24]));

    const set_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_result.response_len], &"+OK\r\n"[0: 5]));

    const randomkey_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$9\r\nRANDOMKEY\r\n"[0: 19], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: randomkey_result.response_len], &"$3\r\nkey\r\n"[0: 9]));

    const get_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_result.response_len], &"$5\r\nvalue\r\n"[0: 11]));

    const copy_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$4\r\nCOPY\r\n$3\r\nkey\r\n$7\r\nkeycopy\r\n"[0: 36], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: copy_result.response_len], &":1\r\n"[0: 4]));

    const copy_get_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$7\r\nkeycopy\r\n"[0: 26], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: copy_get_result.response_len], &"$5\r\nvalue\r\n"[0: 11]));

    const copy_cleanup_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nDEL\r\n$7\r\nkeycopy\r\n"[0: 26], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: copy_cleanup_result.response_len], &":1\r\n"[0: 4]));

    const incr_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$4\r\nINCR\r\n$7\r\ncounter\r\n"[0: 28], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: incr_result.response_len], &":1\r\n"[0: 4]));

    const incrby_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$6\r\nINCRBY\r\n$7\r\ncounter\r\n$1\r\n4\r\n"[0: 38], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: incrby_result.response_len], &":5\r\n"[0: 4]));

    const decr_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$4\r\nDECR\r\n$7\r\ncounter\r\n"[0: 28], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: decr_result.response_len], &":4\r\n"[0: 4]));

    const decrby_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$6\r\nDECRBY\r\n$7\r\ncounter\r\n$1\r\n2\r\n"[0: 38], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: decrby_result.response_len], &":2\r\n"[0: 4]));

    const incrbyfloat_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$11\r\nINCRBYFLOAT\r\n$8\r\nfcounter\r\n$3\r\n1.5\r\n"[0: 45], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: incrbyfloat_result.response_len], &"$3\r\n1.5\r\n"[0: 9]));

    const incrbyfloat_existing_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$11\r\nINCRBYFLOAT\r\n$8\r\nfcounter\r\n$1\r\n2\r\n"[0: 43], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: incrbyfloat_existing_result.response_len], &"$3\r\n3.5\r\n"[0: 9]));

    const set_float_overflow_seed_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$8\r\nfcounter\r\n$5\r\n1e308\r\n"[0: 38], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_float_overflow_seed_result.response_len], &"+OK\r\n"[0: 5]));

    const incrbyfloat_overflow_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$11\r\nINCRBYFLOAT\r\n$8\r\nfcounter\r\n$5\r\n1e308\r\n"[0: 47], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: incrbyfloat_overflow_result.response_len], &"-ERR increment would produce NaN or Infinity\r\n"[0: 46]));

    const increx_float_overflow_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$6\r\nINCREX\r\n$8\r\nfcounter\r\n$7\r\nBYFLOAT\r\n$5\r\n1e308\r\n"[0: 54], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: increx_float_overflow_result.response_len], &"-ERR increment would produce NaN or Infinity\r\n"[0: 46]));

    const mset_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$4\r\nMSET\r\n$2\r\nk1\r\n$2\r\nv1\r\n$2\r\nk2\r\n$2\r\nv2\r\n"[0: 46], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: mset_result.response_len], &"+OK\r\n"[0: 5]));

    const mget_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$4\r\nMGET\r\n$2\r\nk1\r\n$7\r\nmissing\r\n$2\r\nk2\r\n"[0: 43], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: mget_result.response_len], &"*3\r\n$2\r\nv1\r\n$-1\r\n$2\r\nv2\r\n"[0: 25]));

    const msetnx_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$6\r\nMSETNX\r\n$3\r\nnx1\r\n$1\r\na\r\n$3\r\nnx2\r\n$1\r\nb\r\n"[0: 48], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: msetnx_result.response_len], &":1\r\n"[0: 4]));

    const msetnx_conflict_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$6\r\nMSETNX\r\n$3\r\nnx1\r\n$1\r\nx\r\n$3\r\nnx3\r\n$1\r\ny\r\n"[0: 48], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: msetnx_conflict_result.response_len], &":0\r\n"[0: 4]));

    const mset_cleanup_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$3\r\nDEL\r\n$2\r\nk1\r\n$2\r\nk2\r\n$3\r\nnx1\r\n$3\r\nnx2\r\n"[0: 47], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: mset_cleanup_result.response_len], &":4\r\n"[0: 4]));

    const setnx_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$5\r\nSETNX\r\n$6\r\nnx-key\r\n$5\r\nfirst\r\n"[0: 40], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: setnx_result.response_len], &":1\r\n"[0: 4]));

    const setnx_dup_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$5\r\nSETNX\r\n$6\r\nnx-key\r\n$6\r\nsecond\r\n"[0: 42], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: setnx_dup_result.response_len], &":0\r\n"[0: 4]));

    const getset_missing_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$6\r\nGETSET\r\n$6\r\ngs-key\r\n$5\r\nfirst\r\n"[0: 41], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: getset_missing_result.response_len], &"$-1\r\n"[0: 5]));

    const getset_existing_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$6\r\nGETSET\r\n$6\r\ngs-key\r\n$6\r\nsecond\r\n"[0: 43], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: getset_existing_result.response_len], &"$5\r\nfirst\r\n"[0: 11]));

    const setex_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$5\r\nSETEX\r\n$6\r\nsx-key\r\n$1\r\n2\r\n$5\r\nvalue\r\n"[0: 45], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: setex_result.response_len], &"+OK\r\n"[0: 5]));

    const psetex_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$6\r\nPSETEX\r\n$6\r\nps-key\r\n$4\r\n1500\r\n$5\r\nvalue\r\n"[0: 49], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: psetex_result.response_len], &"+OK\r\n"[0: 5]));

    const strlen_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$6\r\nSTRLEN\r\n$3\r\nkey\r\n"[0: 25], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: strlen_result.response_len], &":5\r\n"[0: 4]));

    const append_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$6\r\nAPPEND\r\n$3\r\nkey\r\n$2\r\n++\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: append_result.response_len], &":7\r\n"[0: 4]));

    const getrange_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$8\r\nGETRANGE\r\n$3\r\nkey\r\n$1\r\n1\r\n$1\r\n3\r\n"[0: 41], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: getrange_result.response_len], &"$3\r\nalu\r\n"[0: 9]));

