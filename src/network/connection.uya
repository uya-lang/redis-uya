fn connection_handle_publish(command: &Command) CommandReply {
    const channel: &[byte] = command_arg_data(command, 1) catch {
        return connection_error_reply(&"ERR invalid request"[0: 19]);
    };
    const message: &[byte] = command_arg_data(command, 2) catch {
        return connection_error_reply(&"ERR invalid request"[0: 19]);
    };
    const receivers: usize = connection_pubsub_publish(channel, message);
    return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), receivers as i64);
}

fn connection_handle_spublish(command: &Command) CommandReply {
    const channel: &[byte] = command_arg_data(command, 1) catch {
        return connection_error_reply(&"ERR invalid request"[0: 19]);
    };
    const message: &[byte] = command_arg_data(command, 2) catch {
        return connection_error_reply(&"ERR invalid request"[0: 19]);
    };
    const receivers: usize = connection_pubsub_shard_publish(channel, message);
    return connection_make_reply(CommandReplyType.reply_integer, connection_reply_empty_slice(), receivers as i64);
}

fn connection_parse_input_for_protocol(tx: &ConnectionTransaction, input: &[byte]) !RespParseResult {
    if tx != null && tx.protocol_version == 3 {
        return parse_resp3(input);
    }
    return parse_resp2(input);
}

fn connection_parse_batch_for_protocol(tx: &ConnectionTransaction, input: &[byte], max_count: usize) !RespBatchParseResult {
    if tx != null && tx.protocol_version == 3 {
        return parse_resp3_batch(input, max_count);
    }
    return parse_resp2_batch(input, max_count);
}

export fn connection_input_contains_write_command(tx: &ConnectionTransaction, router: &CommandRouter, input: &[byte]) bool {
    if input.len == 0 {
        return false;
    }
    const batch_result: !RespBatchParseResult = connection_parse_batch_for_protocol(tx, input, CONNECTION_BATCH_MAX_COUNT);
    const batch: RespBatchParseResult = batch_result catch {
        return connection_input_single_write_command(tx, router, input);
    };
    defer {
        resp_batch_free(&batch);
    }

    var index: usize = 0;
    while index < batch.count {
        const value: &RespValue = resp_batch_value(&batch, index);
        if connection_resp_value_requests_write(router, value) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn connection_resp_value_requests_write(router: &CommandRouter, value: &RespValue) bool {
    const command_result: !Command = command_from_resp(router, value);
    const command: Command = command_result catch {
        return false;
    };
    return connection_command_requests_write(&command);
}

fn connection_input_single_write_command(tx: &ConnectionTransaction, router: &CommandRouter, input: &[byte]) bool {
    const parsed_result: !RespParseResult = connection_parse_input_for_protocol(tx, input);
    const parsed: RespParseResult = parsed_result catch {
        return false;
    };
    defer {
        resp_value_free(&parsed.value);
    }
    return connection_resp_value_requests_write(router, &parsed.value);
}

export fn connection_process_input_at(
    engine: &Engine,
    router: &CommandRouter,
    input: &[byte],
    out: &byte,
    out_cap: usize,
    now_ms: u64,
) !ConnectionProcessResult {
    var runtime: CommandRuntimeInfo = command_runtime_default();
    return connection_process_input_with_runtime_with_aof_at(engine, &runtime, router, null as &AofWriter, input, out, out_cap, now_ms);
}

export fn connection_process_input_zero_copy_for_test_at(
    engine: &Engine,
    router: &CommandRouter,
    input: &[byte],
    out: &byte,
    out_cap: usize,
    now_ms: u64,
) !ConnectionProcessResult {
    var runtime: CommandRuntimeInfo = command_runtime_default();
    var replicaof_requested: bool = false;
    var replicaof_promote: bool = false;
    var replicaof_host: [byte: 64] = [];
    var replicaof_port: i32 = 0;
    var bgsave_requested: bool = false;
    var rewrite_requested: bool = false;
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    return connection_process_input_with_runtime_with_aof_and_rewrite_and_transaction_internal_at(
        engine,
        &runtime,
        router,
        null as &AofWriter,
        null as &Sds,
        null as &ReplicationBacklog,
        &tx,
        input,
        out,
        out_cap,
        now_ms,
        &replicaof_requested,
        &replicaof_promote,
        replicaof_host[0: 64],
        &replicaof_port,
        &bgsave_requested,
        &rewrite_requested,
        null as &bool,
        true,
    );
}

export fn connection_process_input_with_transaction_at(
    engine: &Engine,
    router: &CommandRouter,
    tx: &ConnectionTransaction,
    input: &[byte],
    out: &byte,
    out_cap: usize,
    now_ms: u64,
) !ConnectionProcessResult {
    var runtime: CommandRuntimeInfo = command_runtime_default();
    return connection_process_input_with_runtime_with_transaction_at(engine, &runtime, router, tx, input, out, out_cap, now_ms);
}

export fn connection_process_input_with_runtime_at(
    engine: &Engine,
    runtime: &CommandRuntimeInfo,
    router: &CommandRouter,
    input: &[byte],
    out: &byte,
    out_cap: usize,
    now_ms: u64,
) !ConnectionProcessResult {
