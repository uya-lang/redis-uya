fn connection_acl_user_denied_command_add(user: &ConnectionAclUser, name: &[byte]) !void {
    if name.len == 0 || name.len > CONNECTION_ACL_COMMAND_NAME_MAX {
        return error.ConnectionInputTooLarge;
    }
    if connection_acl_user_denied_command_find(user, name) >= 0 {
        return;
    }
    const slot: i32 = connection_acl_user_denied_command_find_free(user);
    if slot < 0 {
        return error.ConnectionInputTooLarge;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_DENIED_COMMAND_MAX {
        return error.ConnectionInputTooLarge;
    }
    user.denied_commands[slot_index].active = true;
    user.denied_commands[slot_index].name_len = name.len;
    user.denied_command_count = user.denied_command_count + 1;
    var index: usize = 0;
    while index < name.len {
        user.denied_commands[slot_index].name[index] = connection_ascii_lower(name.ptr[index]);
        index = index + 1;
    }
    while index < CONNECTION_ACL_COMMAND_NAME_MAX {
        user.denied_commands[slot_index].name[index] = 0 as byte;
        index = index + 1;
    }
}

