    try assert_true(command_executor_test_slice_eq(bad_version_reply.data, &"ERR value is not an integer or out of range"[0: 43]));
    resp_value_free(&bad_version_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

