    resp_value_free(&zadd_wrongtype_parsed.value);

    var hset_hash_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nHSET\r\n$4\r\nhash\r\n$5\r\nfield\r\n$5\r\nvalue\r\n"[0: 46]);
    const hset_hash_command: Command = try command_executor_test_command(&router, &hset_hash_parsed);
    _ = command_execute_at(&engine, &hset_hash_command, 1000u64);
    resp_value_free(&hset_hash_parsed.value);

    var getset_bad_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nGETSET\r\n$4\r\nhash\r\n$5\r\nvalue\r\n"[0: 40]);
    const getset_bad_command: Command = try command_executor_test_command(&router, &getset_bad_parsed);
    const getset_bad_reply: CommandReply = command_execute_at(&engine, &getset_bad_command, 1000u64);
    try assert_eq_i32(getset_bad_reply.typ as i32, CommandReplyType.reply_error as i32);
