        return command_executor_xread(engine, command, now_ms);
    }
    if command.info.cmd_type == CommandType.command_xtrim {
        if command.argc != 4 && command.argc != 5 {
            return command_executor_wrong_arity();
        }
        const key: &[byte] = command_executor_arg(command, 1) catch {
            return command_executor_wrong_arity();
        };
        const strategy: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(strategy, &"MAXLEN"[0: 6]) {
            return command_executor_syntax_error();
        }
        var threshold_index: usize = 3;
        if command.argc == 5 {
            const operator: &[byte] = command_executor_arg(command, 3) catch {
                return command_executor_wrong_arity();
            };
            const exact: bool = operator.len == 1 && operator.ptr[0] == 61 as byte;
            const approximate: bool = operator.len == 1 && operator.ptr[0] == 126 as byte;
            if !exact && !approximate {
                return command_executor_syntax_error();
            }
            threshold_index = 4;
        }
        const threshold_data: &[byte] = command_executor_arg(command, threshold_index) catch {
            return command_executor_wrong_arity();
        };
        const threshold: i64 = command_executor_parse_i64(threshold_data) catch {
            return command_executor_invalid_integer();
        };
        if threshold < 0 {
            return command_executor_invalid_integer();
        }
        const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
            return command_executor_integer(0);
        };
        if obj.obj_type != ObjectType.object_stream {
            return command_executor_wrongtype();
        }
        var removed: usize = 0;
        while obj.list_len > threshold as usize {
            const popped: &RedisObject = list_object_pop_head(obj) catch {
                return command_executor_wrongtype();
            };
            object_free(popped);
            removed = removed + 1;
        }
        return command_executor_integer(removed as i64);
    }
