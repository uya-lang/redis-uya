    command_reply_cleanup(&unknown_reply);
    resp_value_free(&unknown_parsed.value);

    var bad_version_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nLOLWUT\r\n$7\r\nVERSION\r\n$3\r\nbad\r\n"[0: 38]);
    const bad_version_command: Command = try command_executor_test_command(&router, &bad_version_parsed);
    const bad_version_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &bad_version_command, 1000u64);
