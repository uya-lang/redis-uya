fn command_executor_module(command: &Command) CommandReply {
    if command.argc < 2 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'module' command"[0: 48]);
    }

    const subcommand: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'module' command"[0: 48]);
    };
    if command_executor_keyword_eq(subcommand, &"HELP"[0: 4]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'module|help' command"[0: 55]);
        }
        return command_executor_module_help();
    }
    if command_executor_keyword_eq(subcommand, &"LIST"[0: 4]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'module|list' command"[0: 55]);
        }
        return command_executor_owned_raw(&"*0\r\n"[0: 4]);
    }

    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR unknown subcommand '"[0: 24]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"'. Try MODULE HELP."[0: 19]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_slowlog(command: &Command) CommandReply {
    if command.argc < 2 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'slowlog' command"[0: 49]);
    }

    const subcommand: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'slowlog' command"[0: 49]);
    };
    if command_executor_keyword_eq(subcommand, &"HELP"[0: 4]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'slowlog|help' command"[0: 56]);
        }
        const reply_list: &RedisObject = create_list_object() catch {
            return command_executor_oom();
        };
        _ = list_object_push_tail(reply_list, &"SLOWLOG GET [count]"[0: 19]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Return top <count> entries from redis-uya slowlog (default: 10)." [0: 68]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"SLOWLOG LEN"[0: 11]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Return the length of the redis-uya slowlog." [0: 48]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"SLOWLOG RESET"[0: 13]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Reset the redis-uya slowlog." [0: 33]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"SLOWLOG HELP"[0: 12]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Prints this help."[0: 21]) catch { object_free(reply_list); return command_executor_oom(); };
        return command_executor_owned_array(reply_list);
    }
    if command_executor_keyword_eq(subcommand, &"LEN"[0: 3]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'slowlog|len' command"[0: 55]);
        }
        return command_executor_integer(slowlog_count() as i64);
    }
    if command_executor_keyword_eq(subcommand, &"RESET"[0: 5]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'slowlog|reset' command"[0: 57]);
        }
        slowlog_reset();
        return command_executor_simple(&"OK"[0: 2]);
    }
    if command_executor_keyword_eq(subcommand, &"GET"[0: 3]) {
        var count_i64: i64 = 10 as i64;
        if command.argc == 3 {
            const count_data: &[byte] = command_executor_arg(command, 2) catch {
                return command_executor_owned_error(&"ERR wrong number of arguments for 'slowlog|get' command"[0: 55]);
            };
            count_i64 = command_executor_parse_i64(count_data) catch {
                return command_executor_owned_error(&"ERR count should be greater than or equal to -1"[0: 47]);
            };
            if count_i64 < -1 {
                return command_executor_owned_error(&"ERR count should be greater than or equal to -1"[0: 47]);
            }
        } else if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'slowlog|get' command"[0: 55]);
        }

        var result_count: usize = slowlog_count();
        if count_i64 >= 0 && (count_i64 as usize) < result_count {
            result_count = count_i64 as usize;
        }

        var raw: Sds = sds_empty() catch {
            return command_executor_oom();
        };
        defer {
            sds_free(&raw);
        }
        _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], result_count) catch {
            return command_executor_oom();
        };
        var index: usize = 0;
        while index < result_count {
            const entry: &SlowlogEntry = slowlog_entry_newest(index);
            if entry != null {
                _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], 6) catch { return command_executor_oom(); };
                _ = command_executor_info_append_u64(&raw, &":%u\r\n"[0: 5], entry.id) catch { return command_executor_oom(); };
                _ = command_executor_info_append_u64(&raw, &":%u\r\n"[0: 5], entry.timestamp_sec) catch { return command_executor_oom(); };
                _ = command_executor_info_append_u64(&raw, &":%u\r\n"[0: 5], entry.duration_us) catch { return command_executor_oom(); };
                _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], entry.argc) catch { return command_executor_oom(); };
                var arg_index: usize = 0;
                while arg_index < entry.argc {
                    _ = command_executor_command_append_bulk(&raw, entry.args[arg_index].data[0: entry.args[arg_index].len]) catch { return command_executor_oom(); };
                    arg_index = arg_index + 1;
                }
                _ = command_executor_command_append_bulk(&raw, entry.client[0: entry.client_len]) catch { return command_executor_oom(); };
                _ = command_executor_command_append_bulk(&raw, entry.name[0: entry.name_len]) catch { return command_executor_oom(); };
            }
            index = index + 1;
        }
        return command_executor_owned_raw(raw.buf[0: raw.len]);
    }

    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR unknown subcommand '"[0: 24]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"'. Try SLOWLOG HELP."[0: 20]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_latency_wrong_subcommand_arity(subcommand: &[byte]) CommandReply {
    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }
    _ = command_executor_info_append(&buf, &"ERR wrong number of arguments for 'latency|"[0: 43]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&buf, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&buf, &"' command"[0: 9]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(buf.buf[0: buf.len]);
}

