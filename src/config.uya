// config.uya - minimal redis.conf parser.

export error ConfigInvalidNumber;
export error ConfigInvalidValue;
export error ConfigOpenFailed;
export error ConfigReadFailed;
export error ConfigFileTooLarge;
export error ConfigPathTooLong;
export error ConfigWriteFailed;
export error ConfigRenameFailed;

use std.io.file.File;
use std.io.file.file_open;
use std.io.file.file_close;
use std.io.file.file_read;
use std.io.file.file_write;
use libc.O_RDONLY;
use libc.O_WRONLY;
use libc.O_CREAT;
use libc.O_TRUNC;
use libc.rename;
use src.util.bytes.bytes_ascii_case_eq;
use src.storage.sds.Sds;
use src.storage.sds.SdsFmtArg;
use src.storage.sds.sds_empty;
use src.storage.sds.sds_free;
use src.storage.sds.sds_cat;
use src.storage.sds.sds_cat_fmt;
use src.storage.sds.sds_fmt_i64;
use src.storage.sds.sds_fmt_u64;

export enum MaxmemoryPolicy {
    maxmemory_noeviction,
    maxmemory_allkeys_lru,
    maxmemory_allkeys_lfu,
    maxmemory_volatile_lru,
    maxmemory_volatile_lfu,
    maxmemory_volatile_ttl,
}

export struct ServerConfig {
    port: i32,
    bind: [byte: 64],
    dir: [byte: 256],
    dbfilename: [byte: 128],
    appendfilename: [byte: 128],
    requirepass: [byte: 128],
    replicaof_host: [byte: 64],
    replicaof_port: i32,
    masterauth: [byte: 128],
    maxmemory: usize,
    maxmemory_policy: MaxmemoryPolicy,
    save_seconds: i32,
    save_changes: i32,
}

fn copy_literal(dst: &[byte], src: &[byte]) void {
    var i: usize = 0;
    while i < dst.len && i < src.len {
        dst.ptr[i] = src.ptr[i];
        i = i + 1;
    }
    if i < dst.len { dst.ptr[i] = 0; }
}

export fn config_copy_bytes(dst: &[byte], src: &[byte]) void {
    copy_literal(dst, src);
}

export fn default_config() ServerConfig {
    var cfg: ServerConfig = ServerConfig{
        port: 6379,
        maxmemory: 0,
        maxmemory_policy: MaxmemoryPolicy.maxmemory_noeviction,
        save_seconds: 900,
        save_changes: 1,
    };
    copy_literal(cfg.bind[0: 64], &"0.0.0.0"[0: 7]);
    copy_literal(cfg.dir[0: 256], &"./"[0: 2]);
    copy_literal(cfg.dbfilename[0: 128], &"dump.rdb"[0: 8]);
    copy_literal(cfg.appendfilename[0: 128], &"appendonly.aof"[0: 14]);
    copy_literal(cfg.requirepass[0: 128], &""[0: 0]);
    copy_literal(cfg.replicaof_host[0: 64], &""[0: 0]);
    cfg.replicaof_port = 0;
    copy_literal(cfg.masterauth[0: 128], &""[0: 0]);
    return cfg;
}

fn is_space(ch: byte) bool {
    return ch == 32 as byte || ch == 9 as byte || ch == 13 as byte || ch == 10 as byte;
}

fn token_eq(token: &[byte], lit: &[byte]) bool {
    return bytes_ascii_case_eq(token, lit);
}

fn parse_i32_token(token: &[byte]) !i32 {
    if token.len == 0 { return error.ConfigInvalidNumber; }
    var value: i32 = 0;
    var i: usize = 0;
    while i < token.len {
        const ch: byte = token.ptr[i];
        if ch < 48 as byte || ch > 57 as byte { return error.ConfigInvalidNumber; }
        value = value * 10 + ((ch - 48 as byte) as i32);
        i = i + 1;
    }
    return value;
}

fn parse_memory_token(token: &[byte]) !usize {
    if token.len == 0 { return error.ConfigInvalidNumber; }
    var value: usize = 0;
    var i: usize = 0;
    while i < token.len {
        const ch: byte = token.ptr[i];
        if ch >= 48 as byte && ch <= 57 as byte {
            value = value * 10 + ((ch - 48 as byte) as usize);
            i = i + 1;
        } else {
            break;
        }
    }
    if i == 0 { return error.ConfigInvalidNumber; }
    const suffix: &[byte] = token[i: token.len - i];
    if suffix.len == 0 { return value; }
    if token_eq(suffix, &"k"[0: 1]) || token_eq(suffix, &"kb"[0: 2]) { return value * 1024; }
    if token_eq(suffix, &"m"[0: 1]) || token_eq(suffix, &"mb"[0: 2]) { return value * 1024 * 1024; }
    if token_eq(suffix, &"g"[0: 1]) || token_eq(suffix, &"gb"[0: 2]) { return value * 1024 * 1024 * 1024; }
    return error.ConfigInvalidNumber;
}

fn parse_maxmemory_policy(token: &[byte]) !MaxmemoryPolicy {
    if token_eq(token, &"noeviction"[0: 10]) {
        return MaxmemoryPolicy.maxmemory_noeviction;
    }
    if token_eq(token, &"allkeys-lru"[0: 11]) {
        return MaxmemoryPolicy.maxmemory_allkeys_lru;
    }
    if token_eq(token, &"allkeys-lfu"[0: 11]) {
        return MaxmemoryPolicy.maxmemory_allkeys_lfu;
    }
    if token_eq(token, &"volatile-lru"[0: 12]) {
        return MaxmemoryPolicy.maxmemory_volatile_lru;
    }
    if token_eq(token, &"volatile-lfu"[0: 12]) {
        return MaxmemoryPolicy.maxmemory_volatile_lfu;
    }
    if token_eq(token, &"volatile-ttl"[0: 12]) {
        return MaxmemoryPolicy.maxmemory_volatile_ttl;
    }
    return error.ConfigInvalidValue;
}

export fn maxmemory_policy_name(policy: MaxmemoryPolicy) &[byte] {
    if policy == MaxmemoryPolicy.maxmemory_volatile_lru {
        return &"volatile-lru"[0: 12];
    }
    if policy == MaxmemoryPolicy.maxmemory_volatile_lfu {
        return &"volatile-lfu"[0: 12];
    }
    if policy == MaxmemoryPolicy.maxmemory_volatile_ttl {
        return &"volatile-ttl"[0: 12];
    }
    if policy == MaxmemoryPolicy.maxmemory_allkeys_lfu {
        return &"allkeys-lfu"[0: 11];
    }
    if policy == MaxmemoryPolicy.maxmemory_allkeys_lru {
        return &"allkeys-lru"[0: 11];
    }
    return &"noeviction"[0: 10];
}

export fn config_apply_runtime_set(cfg: &ServerConfig, key: &[byte], value: &[byte]) !bool {
    if token_eq(key, &"port"[0: 4]) {
        const port: i32 = try parse_i32_token(value);
        if port <= 0 || port > 65535 {
            return error.ConfigInvalidValue;
        }
        cfg.port = port;
        return true;
    }
    if token_eq(key, &"bind"[0: 4]) {
        copy_literal(cfg.bind[0: 64], value);
        return true;
    }
    if token_eq(key, &"dir"[0: 3]) {
        copy_literal(cfg.dir[0: 256], value);
        return true;
    }
    if token_eq(key, &"dbfilename"[0: 10]) {
        copy_literal(cfg.dbfilename[0: 128], value);
        return true;
    }
    if token_eq(key, &"appendfilename"[0: 14]) {
        copy_literal(cfg.appendfilename[0: 128], value);
        return true;
    }
    if token_eq(key, &"requirepass"[0: 11]) {
        copy_literal(cfg.requirepass[0: 128], value);
        return true;
    }
    if token_eq(key, &"replicaof"[0: 9]) {
        var pos: usize = 0;
        const first: &[byte] = next_token(value, &pos);
        const second: &[byte] = next_token(value, &pos);
        const third: &[byte] = next_token(value, &pos);
        if first.len == 0 {
            return error.ConfigInvalidValue;
        }
        if token_eq(first, &"NO"[0: 2]) && token_eq(second, &"ONE"[0: 3]) && third.len == 0 {
            copy_literal(cfg.replicaof_host[0: 64], &""[0: 0]);
            cfg.replicaof_port = 0;
            return true;
        }
        if second.len == 0 || third.len != 0 {
            return error.ConfigInvalidValue;
        }
        copy_literal(cfg.replicaof_host[0: 64], first);
        cfg.replicaof_port = try parse_i32_token(second);
        return true;
    }
    if token_eq(key, &"masterauth"[0: 10]) {
        copy_literal(cfg.masterauth[0: 128], value);
        return true;
    }
    if token_eq(key, &"maxmemory"[0: 9]) {
        cfg.maxmemory = try parse_memory_token(value);
        return true;
    }
    if token_eq(key, &"maxmemory-policy"[0: 16]) {
        cfg.maxmemory_policy = try parse_maxmemory_policy(value);
        return true;
    }
    if token_eq(key, &"save"[0: 4]) {
        if value.len == 0 {
            cfg.save_seconds = 0;
            cfg.save_changes = 0;
            return true;
        }
        var pos: usize = 0;
        const seconds_token: &[byte] = next_token(value, &pos);
        const changes_token: &[byte] = next_token(value, &pos);
        const extra_token: &[byte] = next_token(value, &pos);
        if seconds_token.len == 0 || changes_token.len == 0 || extra_token.len != 0 {
            return error.ConfigInvalidValue;
        }
        cfg.save_seconds = try parse_i32_token(seconds_token);
        cfg.save_changes = try parse_i32_token(changes_token);
        return true;
    }
    return false;
}

fn config_cstring_slice(data: &[byte]) &[byte] {
    var len: usize = 0;
    while len < data.len && data.ptr[len] != 0 as byte {
        len = len + 1;
    }
    return data[0: len];
}

fn config_path_has_sep(data: &[byte]) bool {
    var i: usize = 0;
    while i < data.len {
        if data.ptr[i] == 47 as byte {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn config_append_path_part(dst: &[byte], pos: &usize, part: &[byte]) !void {
    if *pos + part.len + 1 > dst.len {
        return error.ConfigPathTooLong;
    }
    var i: usize = 0;
    while i < part.len {
        dst.ptr[*pos + i] = part.ptr[i];
        i = i + 1;
    }
    *pos = *pos + part.len;
}

fn config_append_tmp_suffix(dst: &[byte], pos: &usize) !void {
    try config_append_path_part(dst, pos, &".tmp"[0: 4]);
}

export fn config_rewrite_path(out: &[byte], cfg: &ServerConfig) !void {
    const appendfilename: &[byte] = config_cstring_slice(cfg.appendfilename[0: 128]);
    const dir: &[byte] = config_cstring_slice(cfg.dir[0: 256]);
    var pos: usize = 0;
    if config_path_has_sep(appendfilename) {
        try config_append_path_part(out, &pos, appendfilename);
    } else {
        try config_append_path_part(out, &pos, dir);
        if pos > 0 && out.ptr[pos - 1] != 47 as byte {
            try config_append_path_part(out, &pos, &"/"[0: 1]);
        }
        try config_append_path_part(out, &pos, appendfilename);
    }
    try config_append_path_part(out, &pos, &".conf"[0: 5]);
    out.ptr[pos] = 0 as byte;
}

fn config_write_all(file: &File, data: &[byte]) !void {
    var written: usize = 0;
    while written < data.len {
        const ptr: &const byte = @ptr_from_usize(@usize_from_ptr(data.ptr as &void) + written) as &const byte;
        const n: usize = file_write(file, ptr, data.len - written) catch {
            return error.ConfigWriteFailed;
        };
        if n == 0 {
            return error.ConfigWriteFailed;
        }
        written = written + n;
    }
}

fn config_append_line(buf: &Sds, key: &[byte], value: &[byte]) !void {
    try sds_cat(buf, key);
    try sds_cat(buf, &" "[0: 1]);
    try sds_cat(buf, value);
    try sds_cat(buf, &"\n"[0: 1]);
}

fn config_append_i32_line(buf: &Sds, key: &[byte], value: i32) !void {
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_i64(value as i64);
    try sds_cat(buf, key);
    try sds_cat(buf, &" "[0: 1]);
    try sds_cat_fmt(buf, &"%i"[0: 2], args[0: 1]);
    try sds_cat(buf, &"\n"[0: 1]);
}

fn config_append_u64_line(buf: &Sds, key: &[byte], value: u64) !void {
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_u64(value);
    try sds_cat(buf, key);
    try sds_cat(buf, &" "[0: 1]);
    try sds_cat_fmt(buf, &"%u"[0: 2], args[0: 1]);
    try sds_cat(buf, &"\n"[0: 1]);
}

fn config_append_pair_i32_line(buf: &Sds, key: &[byte], value1: i32, value2: i32) !void {
    var args: [SdsFmtArg: 2] = [];
    args[0] = sds_fmt_i64(value1 as i64);
    args[1] = sds_fmt_i64(value2 as i64);
    try sds_cat(buf, key);
    try sds_cat(buf, &" "[0: 1]);
    try sds_cat_fmt(buf, &"%i %i"[0: 5], args[0: 2]);
    try sds_cat(buf, &"\n"[0: 1]);
}

fn config_append_replicaof_line(buf: &Sds, host: &[byte], port: i32) !void {
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_i64(port as i64);
    try sds_cat(buf, &"replicaof"[0: 9]);
    try sds_cat(buf, &" "[0: 1]);
    try sds_cat(buf, host);
    try sds_cat(buf, &" "[0: 1]);
    try sds_cat_fmt(buf, &"%i"[0: 2], args[0: 1]);
    try sds_cat(buf, &"\n"[0: 1]);
}

fn config_rewrite_payload(cfg: &ServerConfig) !Sds {
    var buf: Sds = sds_empty() catch {
        return error.ConfigWriteFailed;
    };
    try config_append_i32_line(&buf, &"port"[0: 4], cfg.port);
    try config_append_line(&buf, &"bind"[0: 4], config_cstring_slice(cfg.bind[0: 64]));
    try config_append_line(&buf, &"dir"[0: 3], config_cstring_slice(cfg.dir[0: 256]));
    try config_append_line(&buf, &"dbfilename"[0: 10], config_cstring_slice(cfg.dbfilename[0: 128]));
    try config_append_line(&buf, &"appendfilename"[0: 14], config_cstring_slice(cfg.appendfilename[0: 128]));
    try config_append_u64_line(&buf, &"maxmemory"[0: 9], cfg.maxmemory as u64);
    try config_append_line(&buf, &"maxmemory-policy"[0: 16], maxmemory_policy_name(cfg.maxmemory_policy));
    try config_append_pair_i32_line(&buf, &"save"[0: 4], cfg.save_seconds, cfg.save_changes);
    const requirepass: &[byte] = config_cstring_slice(cfg.requirepass[0: 128]);
    if requirepass.len > 0 {
        try config_append_line(&buf, &"requirepass"[0: 11], requirepass);
    }
    const replicaof_host: &[byte] = config_cstring_slice(cfg.replicaof_host[0: 64]);
    if replicaof_host.len > 0 && cfg.replicaof_port > 0 {
        try config_append_replicaof_line(&buf, replicaof_host, cfg.replicaof_port);
    }
    const masterauth: &[byte] = config_cstring_slice(cfg.masterauth[0: 128]);
    if masterauth.len > 0 {
        try config_append_line(&buf, &"masterauth"[0: 10], masterauth);
    }
    return buf;
}

export fn config_rewrite_file(cfg: &ServerConfig) !void {
    var path_buf: [byte: 512] = [];
    try config_rewrite_path(path_buf[0: 512], cfg);
    var tmp_path_buf: [byte: 512] = [];
    var tmp_pos: usize = 0;
    try config_append_path_part(tmp_path_buf[0: 512], &tmp_pos, config_cstring_slice(path_buf[0: 512]));
    try config_append_tmp_suffix(tmp_path_buf[0: 512], &tmp_pos);
    tmp_path_buf[tmp_pos] = 0 as byte;

    var payload: Sds = try config_rewrite_payload(cfg);
    defer {
        sds_free(&payload);
    }

    const mode: u32 = 0o644u32;
    var file: File = file_open(&tmp_path_buf[0] as &const byte, (O_WRONLY | O_CREAT | O_TRUNC) as i32, mode) catch {
        return error.ConfigWriteFailed;
    };
    defer {
        _ = file_close(&file) catch {};
    }
    try config_write_all(&file, payload.buf[0: payload.len]);
    if rename(&tmp_path_buf[0] as &const byte, &path_buf[0] as &const byte) != 0 {
        return error.ConfigRenameFailed;
    }
}

fn next_token(line: &[byte], pos: &usize) &[byte] {
    while *pos < line.len && is_space(line.ptr[*pos]) {
        *pos = *pos + 1;
    }
    const start: usize = *pos;
    while *pos < line.len && !is_space(line.ptr[*pos]) && line.ptr[*pos] != 35 as byte {
        *pos = *pos + 1;
    }
    return line[start: *pos - start];
}

fn parse_line(cfg: &ServerConfig, line: &[byte]) !void {
    var pos: usize = 0;
    const key: &[byte] = next_token(line, &pos);
    if key.len == 0 { return; }
    if key.ptr[0] == 35 as byte { return; }
    const value: &[byte] = next_token(line, &pos);

    if token_eq(key, &"port"[0: 4]) {
        cfg.port = try parse_i32_token(value);
    } else if token_eq(key, &"bind"[0: 4]) {
        copy_literal(cfg.bind[0: 64], value);
    } else if token_eq(key, &"dir"[0: 3]) {
        copy_literal(cfg.dir[0: 256], value);
    } else if token_eq(key, &"dbfilename"[0: 10]) {
        copy_literal(cfg.dbfilename[0: 128], value);
    } else if token_eq(key, &"appendfilename"[0: 14]) {
        copy_literal(cfg.appendfilename[0: 128], value);
    } else if token_eq(key, &"requirepass"[0: 11]) {
        copy_literal(cfg.requirepass[0: 128], value);
    } else if token_eq(key, &"replicaof"[0: 9]) {
        copy_literal(cfg.replicaof_host[0: 64], value);
        const port_token: &[byte] = next_token(line, &pos);
        cfg.replicaof_port = try parse_i32_token(port_token);
    } else if token_eq(key, &"masterauth"[0: 10]) {
        copy_literal(cfg.masterauth[0: 128], value);
    } else if token_eq(key, &"maxmemory"[0: 9]) {
        cfg.maxmemory = try parse_memory_token(value);
    } else if token_eq(key, &"maxmemory-policy"[0: 16]) {
        cfg.maxmemory_policy = try parse_maxmemory_policy(value);
    } else if token_eq(key, &"save"[0: 4]) {
        cfg.save_seconds = try parse_i32_token(value);
        const changes: &[byte] = next_token(line, &pos);
        cfg.save_changes = try parse_i32_token(changes);
    }
}

export fn parse_config_text(text: &[byte]) !ServerConfig {
    var cfg: ServerConfig = default_config();
    var start: usize = 0;
    var i: usize = 0;
    while i <= text.len {
        if i == text.len || text.ptr[i] == 10 as byte {
            try parse_line(&cfg, text[start: i - start]);
            start = i + 1;
        }
        i = i + 1;
    }
    return cfg;
}

export fn parse_config_file(path: &const byte) !ServerConfig {
    const max_size: usize = 8192;
    var file: File = file_open(path, O_RDONLY as i32, 0u32) catch {
        return error.ConfigOpenFailed;
    };
    defer {
        _ = file_close(&file) catch {};
    }

    var buf: [byte: 8192] = [];
    var total: usize = 0;
    while total < max_size {
        const n: isize = file_read(&file, &buf[total], max_size - total);
        if n < 0 {
            return error.ConfigReadFailed;
        }
        if n == 0 {
            break;
        }
        total = total + (n as usize);
    }
    if total == max_size {
        const extra: isize = file_read(&file, &buf[0], 1);
        if extra > 0 {
            return error.ConfigFileTooLarge;
        }
        if extra < 0 {
            return error.ConfigReadFailed;
        }
    }
    return parse_config_text(buf[0: total]);
}
