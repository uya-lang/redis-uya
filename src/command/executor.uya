            return command_executor_error(&"ERR count should be greater than 0"[0: 34]);
        }
        requested_count = count_i64 as usize;
    } else if command.argc != keys_end + 1 {
        return command_executor_syntax_error();
    }

    var source: &[byte] = command_executor_empty_slice();
    var source_obj: &RedisObject = null as &RedisObject;
    var arg_index: usize = 3;
    while arg_index < keys_end {
        const key: &[byte] = command_executor_arg(command, arg_index) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        const obj: &RedisObject = obj_result catch {
            arg_index = arg_index + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_list {
            return command_executor_wrongtype();
        }
        const available: usize = list_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if available > 0 {
            source = key;
            source_obj = obj;
            break;
        }
        arg_index = arg_index + 1;
    }

    if source_obj == null {
        return command_executor_reply(CommandReplyType.reply_null_array, command_executor_empty_slice(), 0);
    }

    var actual_count: usize = requested_count;
    const available_count: usize = list_object_len(source_obj) catch {
        return command_executor_wrongtype();
    };
    if actual_count > available_count {
        actual_count = available_count;
    }
    if actual_count == 0 {
        _ = delete_key(engine, source);
        return command_executor_reply(CommandReplyType.reply_null_array, command_executor_empty_slice(), 0);
    }

    var reply: CommandReply = command_executor_lmpop_reply(source, source_obj, pop_left, actual_count);
    if reply.typ == CommandReplyType.reply_error {
        return reply;
    }

    var popped_count: usize = 0;
    while popped_count < actual_count {
        const popped: &RedisObject = command_executor_list_pop_direction(source_obj, pop_left) catch {
            command_reply_cleanup(&reply);
            return command_executor_wrongtype();
        };
        object_free(popped);
        popped_count = popped_count + 1;
    }

    const remaining: usize = list_object_len(source_obj) catch {
        command_reply_cleanup(&reply);
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, source);
    }
    return reply;
}

fn command_executor_set_any_member(obj: &RedisObject) !&[byte] {
    if obj == null || obj.obj_type != ObjectType.object_set {
        return error.ObjectWrongType;
    }
    var iter: DictIterator = dict_iter_new();
    const entry: &DictEntry = dict_iter_next(&obj.hash_dict, &iter);
    if entry == null {
        return error.ObjectFieldNotFound;
    }
    return entry.key.buf[0: entry.key.len];
}

fn command_executor_set_contains(obj: &RedisObject, member: &[byte]) !bool {
    if obj == null || obj.obj_type != ObjectType.object_set {
        return error.ObjectWrongType;
    }
    _ = dict_lookup(&obj.hash_dict, member) catch {
        return false;
    };
    return true;
}

fn command_executor_set_sorted_members(obj: &RedisObject) !&RedisObject {
    if obj == null || obj.obj_type != ObjectType.object_set {
        return error.ObjectWrongType;
    }
    const members: &RedisObject = try create_list_object();
    var iter: DictIterator = dict_iter_new();
    var entry: &DictEntry = dict_iter_next(&obj.hash_dict, &iter);
    while entry != null {
        _ = list_object_insert_sorted_lex(members, entry.key.buf[0: entry.key.len]) catch {
            object_free(members);
            return error.AllocOutOfMemory;
        };
        entry = dict_iter_next(&obj.hash_dict, &iter);
    }
    return members;
}

fn command_executor_set_reply_from_set(obj: &RedisObject) CommandReply {
    const members: &RedisObject = command_executor_set_sorted_members(obj) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const count: usize = list_object_len(members) catch {
        object_free(members);
        return command_executor_wrongtype();
    };
    var reply: CommandReply = command_executor_array_bulk(members.list_head, count);
    reply.owned_object = members;
    return reply;
}

fn command_executor_sadd(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        const set_obj: &RedisObject = create_set_object() catch {
            return command_executor_oom();
        };
        var added_new: i64 = 0;
        var index_new: usize = 2;
        while index_new < command.argc {
            const member_new: &[byte] = command_executor_arg(command, index_new) catch {
                object_free(set_obj);
                return command_executor_wrong_arity();
            };
            const inserted_new: bool = set_object_add_member(set_obj, member_new) catch |err| {
                object_free(set_obj);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_error(&"ERR set add failed"[0: 19]);
            };
            if inserted_new {
                added_new = added_new + 1;
            }
            index_new = index_new + 1;
        }
        _ = set_key_at(engine, key, set_obj, now_ms) catch {
            object_free(set_obj);
            return command_executor_oom();
        };
        return command_executor_integer(added_new);
    };

    if existing.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    var added: i64 = 0;
    var index: usize = 2;
    while index < command.argc {
        const member: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const inserted: bool = set_object_add_member(existing, member) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_error(&"ERR set add failed"[0: 19]);
        };
        if inserted {
            added = added + 1;
        }
        index = index + 1;
    }
    return command_executor_integer(added);
}

fn command_executor_srem(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    var removed: i64 = 0;
    var index: usize = 2;
    while index < command.argc {
        const member: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const deleted: bool = set_object_remove_member(obj, member) catch {
            return command_executor_wrongtype();
        };
        if deleted {
            removed = removed + 1;
        }
        index = index + 1;
    }
    return command_executor_integer(removed);
}

fn command_executor_smembers(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const members_obj: &RedisObject = set_object_members_reply(obj) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_error(&"ERR set members failed"[0: 23]);
    };
    const count: usize = list_object_len(members_obj) catch {
        object_free(members_obj);
        return command_executor_error(&"ERR set members failed"[0: 23]);
    };
    var reply: CommandReply = command_executor_array_bulk(members_obj.list_head, count);
    reply.owned_object = members_obj;
    return reply;
}

fn command_executor_scard(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }
    const count: usize = set_object_len(obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_integer(count as i64);
}

fn command_executor_sismember(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const member: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }
    const present: bool = command_executor_set_contains(obj, member) catch {
        return command_executor_wrongtype();
    };
    if present {
        return command_executor_integer(1);
    }
    return command_executor_integer(0);
}

fn command_executor_smismember(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        var empty_reply: Sds = sds_empty() catch {
            return command_executor_oom();
        };
        defer {
            sds_free(&empty_reply);
        }
        _ = command_executor_resp_collection_prefix(&empty_reply, &"*"[0: 1], command.argc - 2) catch {
            return command_executor_oom();
        };
        var missing_index: usize = 2;
        while missing_index < command.argc {
            _ = command_executor_info_append_i64(&empty_reply, &":%i\r\n"[0: 5], 0) catch {
                return command_executor_oom();
            };
            missing_index = missing_index + 1;
        }
        return command_executor_owned_raw(empty_reply.buf[0: empty_reply.len]);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], command.argc - 2) catch {
        return command_executor_oom();
    };
    var index: usize = 2;
    while index < command.argc {
        const member: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const present: bool = command_executor_set_contains(obj, member) catch {
            return command_executor_wrongtype();
        };
        var integer_value: i64 = 0;
        if present {
            integer_value = 1;
        }
        _ = command_executor_info_append_i64(&raw, &":%i\r\n"[0: 5], integer_value) catch {
            return command_executor_oom();
        };
        index = index + 1;
    }
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_sscan(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 && command.argc != 5 {
        return command_executor_wrong_arity();
    }

    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_scan(0u64, null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const cursor_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const cursor_i64: i64 = command_executor_parse_i64(cursor_data) catch {
        return command_executor_invalid_integer();
    };
    if cursor_i64 < 0 {
        return command_executor_invalid_integer();
    }

    var count_hint: usize = 10;
    if command.argc == 5 {
        const option: &[byte] = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(option, &"COUNT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const count_data: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        const count_i64: i64 = command_executor_parse_i64(count_data) catch {
            return command_executor_invalid_integer();
        };
        if count_i64 <= 0 {
            return command_executor_invalid_integer();
        }
        count_hint = count_i64 as usize;
    }

    const members: &RedisObject = command_executor_set_sorted_members(obj) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const total: usize = list_object_len(members) catch {
        object_free(members);
        return command_executor_wrongtype();
    };

    const cursor: usize = cursor_i64 as usize;
    var emit_head: &ListNode = null as &ListNode;
    var emit_count: usize = 0;
    var next_cursor: u64 = 0u64;

    if cursor < total {
        const stop_index: i64 = cursor_i64 + (count_hint as i64) - 1;
        const view: ListRangeView = list_object_range(members, cursor_i64, stop_index) catch {
            object_free(members);
            return command_executor_wrongtype();
        };
        emit_head = view.head;
        emit_count = view.count;
        if cursor + emit_count < total {
            next_cursor = (cursor + emit_count) as u64;
        }
    }

    var reply: CommandReply = command_executor_scan(next_cursor, emit_head, emit_count);
    reply.owned_object = members;
    return reply;
}

fn command_executor_smove(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }

    const source: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const destination: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const member: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };

    const source_obj: &RedisObject = lookup_key_at(engine, source, now_ms) catch {
        return command_executor_integer(0);
    };
    if source_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const source_has_member: bool = command_executor_set_contains(source_obj, member) catch {
        return command_executor_wrongtype();
    };

    if bytes_eq(source, destination) {
        if source_has_member {
            return command_executor_integer(1);
        }
        return command_executor_integer(0);
    }

    const destination_result: !&RedisObject = lookup_key_at(engine, destination, now_ms);
    const destination_obj: &RedisObject = destination_result catch {
        null as &RedisObject;
    };
    if destination_obj != null && destination_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    if !source_has_member {
        return command_executor_integer(0);
    }

    if destination_obj == null {
        const new_destination: &RedisObject = create_set_object() catch {
            return command_executor_oom();
        };
        _ = set_object_add_member(new_destination, member) catch |err| {
            object_free(new_destination);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };

        const removed_missing: bool = set_object_remove_member(source_obj, member) catch {
            object_free(new_destination);
            return command_executor_wrongtype();
        };
        if !removed_missing {
            object_free(new_destination);
            return command_executor_integer(0);
        }

        _ = set_key_at(engine, destination, new_destination, now_ms) catch {
            _ = set_object_add_member(source_obj, member) catch {};
            object_free(new_destination);
            return command_executor_oom();
        };

        const source_remaining: usize = set_object_len(source_obj) catch {
            return command_executor_wrongtype();
        };
        if source_remaining == 0 {
            _ = delete_key(engine, source);
        }
        return command_executor_integer(1);
    }

    const destination_has_member: bool = command_executor_set_contains(destination_obj, member) catch {
        return command_executor_wrongtype();
    };
    if !destination_has_member {
        _ = set_object_add_member(destination_obj, member) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
    }

    const removed_existing: bool = set_object_remove_member(source_obj, member) catch {
        if !destination_has_member {
            _ = set_object_remove_member(destination_obj, member) catch {};
        }
        return command_executor_wrongtype();
    };
    if !removed_existing {
        if !destination_has_member {
            _ = set_object_remove_member(destination_obj, member) catch {};
        }
        return command_executor_integer(0);
    }

    const remaining: usize = set_object_len(source_obj) catch {
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, source);
    }
    return command_executor_integer(1);
}

fn command_executor_spop(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const member: &[byte] = command_executor_set_any_member(obj) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    const reply_obj: &RedisObject = create_string_object(member) catch {
        return command_executor_oom();
    };
    _ = set_object_remove_member(obj, member) catch {
        object_free(reply_obj);
        return command_executor_wrongtype();
    };
    const remaining: usize = set_object_len(obj) catch {
        object_free(reply_obj);
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, key);
    }
    const data: &[byte] = reply_obj.value.buf[0: reply_obj.value.len];
    var reply: CommandReply = command_executor_bulk(data);
    reply.owned_object = reply_obj;
    return reply;
}

fn command_executor_srandmember(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const member: &[byte] = command_executor_set_any_member(obj) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    return command_executor_bulk(member);
}

fn command_executor_sinter(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }

    const first_key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const first_obj: &RedisObject = lookup_key_at(engine, first_key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if first_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    const members: &RedisObject = command_executor_set_sorted_members(first_obj) catch |err| {
        object_free(result_set);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var present_everywhere: bool = true;
        var arg_index: usize = 2;
        while arg_index < command.argc {
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                present_everywhere = false;
                null as &RedisObject;
            };
            if obj == null {
                present_everywhere = false;
                break;
            }
            if obj.obj_type != ObjectType.object_set {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            }
            const present: bool = command_executor_set_contains(obj, member) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            };
            if !present {
                present_everywhere = false;
                break;
            }
            arg_index = arg_index + 1;
        }
        if present_everywhere {
            _ = set_object_add_member(result_set, member) catch |err| {
                object_free(members);
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        }
        node = node.next;
    }
    object_free(members);
    const reply: CommandReply = command_executor_set_reply_from_set(result_set);
    object_free(result_set);
    return reply;
}

fn command_executor_sdiff(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }

    const first_key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const first_obj: &RedisObject = lookup_key_at(engine, first_key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if first_obj.obj_type != ObjectType.object_set {
        return command_executor_wrongtype();
    }

    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    const members: &RedisObject = command_executor_set_sorted_members(first_obj) catch |err| {
        object_free(result_set);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var seen_elsewhere: bool = false;
        var arg_index: usize = 2;
        while arg_index < command.argc {
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                arg_index = arg_index + 1;
                null as &RedisObject;
            };
            if obj == null {
                continue;
            }
            if obj.obj_type != ObjectType.object_set {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            }
            const present: bool = command_executor_set_contains(obj, member) catch {
                object_free(members);
                object_free(result_set);
                return command_executor_wrongtype();
            };
            if present {
                seen_elsewhere = true;
                break;
            }
            arg_index = arg_index + 1;
        }
        if !seen_elsewhere {
            _ = set_object_add_member(result_set, member) catch |err| {
                object_free(members);
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        }
        node = node.next;
    }
    object_free(members);
    const reply: CommandReply = command_executor_set_reply_from_set(result_set);
    object_free(result_set);
    return reply;
}

fn command_executor_sunion(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }

    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    var arg_index: usize = 1;
    while arg_index < command.argc {
        const key: &[byte] = command_executor_arg(command, arg_index) catch {
            object_free(result_set);
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        const obj: &RedisObject = obj_result catch {
            arg_index = arg_index + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_set {
            object_free(result_set);
            return command_executor_wrongtype();
        }
        var iter: DictIterator = dict_iter_new();
        var entry: &DictEntry = dict_iter_next(&obj.hash_dict, &iter);
        while entry != null {
            _ = set_object_add_member(result_set, entry.key.buf[0: entry.key.len]) catch |err| {
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
            entry = dict_iter_next(&obj.hash_dict, &iter);
        }
        arg_index = arg_index + 1;
    }
    const reply: CommandReply = command_executor_set_reply_from_set(result_set);
    object_free(result_set);
    return reply;
}

fn command_executor_sintercard(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }

    const numkeys_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }

    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 2 + numkeys;
    if command.argc < keys_end {
        return command_executor_error(&"ERR Number of keys can't be greater than number of args"[0: 55]);
    }

    var limit: usize = 0;
    if command.argc > keys_end {
        if command.argc != keys_end + 2 {
            return command_executor_syntax_error();
        }
        const option: &[byte] = command_executor_arg(command, keys_end) catch {
            return command_executor_syntax_error();
        };
        if !command_executor_keyword_eq(option, &"LIMIT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const limit_data: &[byte] = command_executor_arg(command, keys_end + 1) catch {
            return command_executor_syntax_error();
        };
        const limit_i64: i64 = command_executor_parse_i64(limit_data) catch {
            return command_executor_error(&"ERR LIMIT can't be negative"[0: 27]);
        };
        if limit_i64 < 0 {
            return command_executor_error(&"ERR LIMIT can't be negative"[0: 27]);
        }
        limit = limit_i64 as usize;
    }

    var missing_any: bool = false;
    var candidate: &RedisObject = null as &RedisObject;
    var candidate_arg_index: usize = 2;
    var candidate_len: usize = 0;
    var arg_index_check: usize = 2;
    while arg_index_check < keys_end {
        const key_check: &[byte] = command_executor_arg(command, arg_index_check) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key_check, now_ms);
        const obj: &RedisObject = obj_result catch {
            missing_any = true;
            arg_index_check = arg_index_check + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_set {
            return command_executor_wrongtype();
        }
        const obj_len: usize = set_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if candidate == null || obj_len < candidate_len {
            candidate = obj;
            candidate_arg_index = arg_index_check;
            candidate_len = obj_len;
        }
        arg_index_check = arg_index_check + 1;
    }

    if candidate == null || missing_any {
        return command_executor_integer(0);
    }

    if numkeys == 1 {
        if limit > 0 && candidate_len > limit {
            return command_executor_integer(limit as i64);
        }
        return command_executor_integer(candidate_len as i64);
    }

    const members: &RedisObject = command_executor_set_sorted_members(candidate) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(members);
    }

    var count: usize = 0;
    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var present_everywhere: bool = true;
        var arg_index: usize = 2;
        while arg_index < keys_end {
            if arg_index == candidate_arg_index {
                arg_index = arg_index + 1;
                continue;
            }
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                present_everywhere = false;
                null as &RedisObject;
            };
            if obj == null {
                break;
            }
            if obj.obj_type != ObjectType.object_set {
                return command_executor_wrongtype();
            }
            const present: bool = command_executor_set_contains(obj, member) catch {
                return command_executor_wrongtype();
            };
            if !present {
                present_everywhere = false;
                break;
            }
            arg_index = arg_index + 1;
        }
        if present_everywhere {
            count = count + 1;
            if limit > 0 && count >= limit {
                return command_executor_integer(limit as i64);
            }
        }
        node = node.next;
    }
    return command_executor_integer(count as i64);
}

fn command_executor_set_store_result(engine: &Engine, target: &[byte], result_set: &RedisObject, now_ms: u64) CommandReply {
    const len: usize = set_object_len(result_set) catch {
        object_free(result_set);
        return command_executor_wrongtype();
    };
    if len == 0 {
        object_free(result_set);
        _ = delete_key(engine, target);
        return command_executor_integer(0);
    }
    _ = set_key_at(engine, target, result_set, now_ms) catch {
        object_free(result_set);
        return command_executor_oom();
    };
    return command_executor_integer(len as i64);
}

fn command_executor_bulk_i64(value: i64) CommandReply {
    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_i64(value);
    _ = sds_cat_fmt(&buf, &"%i"[0: 2], args[0: 1]) catch {
        return command_executor_oom();
    };
    const obj: &RedisObject = create_string_object(buf.buf[0: buf.len]) catch {
        return command_executor_oom();
    };
    var reply: CommandReply = command_executor_bulk(obj.value.buf[0: obj.value.len]);
    reply.owned_object = obj;
    return reply;
}

fn command_executor_rename_common(engine: &Engine, command: &Command, now_ms: u64, overwrite: bool) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const source: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const target: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const result: EngineRenameResult = engine_rename_key(engine, source, target, overwrite) catch {
        return command_executor_oom();
    };
    _ = now_ms;
    match result {
        EngineRenameResult.rename_ok => {
            if overwrite {
                return command_executor_simple(&"OK"[0: 2]);
            }
            return command_executor_integer(1);
        },
        EngineRenameResult.rename_source_missing => {
            return command_executor_error(&"ERR no such key"[0: 14]);
        },
        EngineRenameResult.rename_target_exists => {
            return command_executor_integer(0);
        },
        EngineRenameResult.rename_same_key => {
            return command_executor_error(&"ERR source and destination objects are the same"[0: 47]);
        },
        else => {
            return command_executor_error(&"ERR rename failed"[0: 17]);
        }
    }
}

fn command_executor_copy_store(engine: &Engine, source: &[byte], target: &[byte], source_obj: &RedisObject, now_ms: u64) CommandReply {
    const cloned: &RedisObject = object_clone(source_obj) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    _ = set_key_at(engine, target, cloned, now_ms) catch {
        object_free(cloned);
        return command_executor_oom();
    };
    const expire_at: u64 = get_key_expire_at(engine, source) catch {
        _ = clear_key_expire(engine, target);
        return command_executor_integer(1);
    };
    _ = set_key_expire_at(engine, target, expire_at) catch {
        return command_executor_oom();
    };
    return command_executor_integer(1);
}

fn command_executor_copy(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const source: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const target: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    if command_executor_slice_eq(source, target) {
        return command_executor_error(&"ERR source and destination objects are the same"[0: 47]);
    }

    var replace: bool = false;
    var db_index: i64 = 0;
    var index: usize = 3;
    while index < command.argc {
        const option: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(option, &"REPLACE"[0: 7]) {
            replace = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(option, &"DB"[0: 2]) {
            if index + 1 >= command.argc {
                return command_executor_syntax_error();
            }
            db_index = command_executor_parse_i64(command_executor_arg(command, index + 1) catch {
                return command_executor_wrong_arity();
            }) catch {
                return command_executor_invalid_integer();
            };
            index = index + 2;
            continue;
        }
        return command_executor_syntax_error();
    }
    if db_index != 0 {
        return command_executor_error(&"ERR DB index is out of range"[0: 28]);
    }

    const source_obj: &RedisObject = lookup_key_at(engine, source, now_ms) catch {
        return command_executor_integer(0);
    };
    if !replace {
        const target_obj: &RedisObject = lookup_key_at(engine, target, now_ms) catch {
            return command_executor_copy_store(engine, source, target, source_obj, now_ms);
        };
        _ = target_obj;
        return command_executor_integer(0);
    }
    return command_executor_copy_store(engine, source, target, source_obj, now_ms);
}

fn command_executor_select(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    _ = runtime;
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const db_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const db_index: i64 = command_executor_parse_i64(db_data) catch {
        return command_executor_invalid_integer();
    };
    if db_index != 0 {
        return command_executor_error(&"ERR DB index is out of range"[0: 28]);
    }
    return command_executor_simple(&"OK"[0: 2]);
}

