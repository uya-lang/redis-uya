    var getkeys_fcall_ro_flags_parsed: RespParseResult = try parse_resp2(&"*7\r\n$7\r\nCOMMAND\r\n$15\r\nGETKEYSANDFLAGS\r\n$8\r\nFCALL_RO\r\n$7\r\nmissing\r\n$1\r\n1\r\n$2\r\nk1\r\n$3\r\narg\r\n"[0: 90]);
