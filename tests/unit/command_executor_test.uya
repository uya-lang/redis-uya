    _ = command_execute_at(&engine, &sadd_s3_command, 1000u64);
    resp_value_free(&sadd_s3_parsed.value);

    var sinter_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nSINTER\r\n$2\r\ns1\r\n$2\r\ns2\r\n$2\r\ns3\r\n"[0: 40]);
    const sinter_command: Command = try command_executor_test_command(&router, &sinter_parsed);
    const sinter_reply: CommandReply = command_execute_at(&engine, &sinter_command, 1000u64);
