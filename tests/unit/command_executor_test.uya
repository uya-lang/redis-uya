    try assert_true(command_executor_test_slice_eq(appended_get_reply.data, &"value__"[0: 7]));
    resp_value_free(&appended_get_parsed.value);

    var getdel_set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$6\r\ngd-key\r\n$4\r\nonce\r\n"[0: 36]);
    const getdel_set_command: Command = try command_executor_test_command(&router, &getdel_set_parsed);
    _ = command_execute_at(&engine, &getdel_set_command, 1000u64);
