    try assert_true(command_executor_test_slice_eq(move_range_reply.data, &"ERR DB index is out of range"[0: 28]));
    resp_value_free(&move_range_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_wait() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();

    var wait_zero_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nWAIT\r\n$1\r\n0\r\n$1\r\n0\r\n"[0: 31]);
    const wait_zero_command: Command = try command_executor_test_command(&router, &wait_zero_parsed);
    const wait_zero_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &wait_zero_command, 1000u64);
    try assert_eq_i32(wait_zero_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(wait_zero_reply.integer as i32, 0);
    resp_value_free(&wait_zero_parsed.value);

    var wait_positive_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nWAIT\r\n$1\r\n1\r\n$2\r\n10\r\n"[0: 32]);
    const wait_positive_command: Command = try command_executor_test_command(&router, &wait_positive_parsed);
    const wait_positive_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &wait_positive_command, 1000u64);
    try assert_eq_i32(wait_positive_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(wait_positive_reply.integer as i32, 0);
    resp_value_free(&wait_positive_parsed.value);

    var wait_bad_timeout_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nWAIT\r\n$1\r\n1\r\n$2\r\n-1\r\n"[0: 32]);
    const wait_bad_timeout_command: Command = try command_executor_test_command(&router, &wait_bad_timeout_parsed);
    const wait_bad_timeout_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &wait_bad_timeout_command, 1000u64);
    try assert_eq_i32(wait_bad_timeout_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(wait_bad_timeout_reply.data, &"ERR timeout is negative"[0: 23]));
    resp_value_free(&wait_bad_timeout_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_sort() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 512] = [];

    var rpush_nums_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nRPUSH\r\n$7\r\nsortnum\r\n$1\r\n3\r\n$1\r\n1\r\n$1\r\n2\r\n"[0: 49]);
    const rpush_nums_command: Command = try command_executor_test_command(&router, &rpush_nums_parsed);
    _ = command_execute_at(&engine, &rpush_nums_command, 1000u64);
    resp_value_free(&rpush_nums_parsed.value);

    var sort_default_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nSORT\r\n$7\r\nsortnum\r\n"[0: 27]);
    const sort_default_command: Command = try command_executor_test_command(&router, &sort_default_parsed);
    var sort_default_reply: CommandReply = command_execute_at(&engine, &sort_default_command, 1000u64);
    const sort_default_len: usize = try connection_encode_reply(&sort_default_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: sort_default_len], &"*3\r\n$1\r\n1\r\n$1\r\n2\r\n$1\r\n3\r\n"[0: 25]));
    command_reply_cleanup(&sort_default_reply);
    resp_value_free(&sort_default_parsed.value);

    var sort_desc_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nSORT\r\n$7\r\nsortnum\r\n$4\r\nDESC\r\n"[0: 37]);
    const sort_desc_command: Command = try command_executor_test_command(&router, &sort_desc_parsed);
