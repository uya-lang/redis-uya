    try assert_true(command_executor_test_contains(getkeys_fcall_ro_flags_reply.data, &"$2\r\nk1\r\n*2\r\n$2\r\nRO\r\n$6\r\naccess\r\n"[0: 32]));
    command_reply_cleanup(&getkeys_fcall_ro_flags_reply);
    resp_value_free(&getkeys_fcall_ro_flags_parsed.value);

    var getkeys_eval_invalid_parsed: RespParseResult = try parse_resp2(&"*6\r\n$7\r\nCOMMAND\r\n$7\r\nGETKEYS\r\n$4\r\nEVAL\r\n$8\r\nreturn 1\r\n$1\r\nx\r\n$2\r\nk1\r\n"[0: 69]);
    const getkeys_eval_invalid_command: Command = try command_executor_test_command(&router, &getkeys_eval_invalid_parsed);
    var getkeys_eval_invalid_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &getkeys_eval_invalid_command, 1000u64);
    try assert_true(command_executor_test_slice_eq(getkeys_eval_invalid_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&getkeys_eval_invalid_reply);
    resp_value_free(&getkeys_eval_invalid_parsed.value);

    var getkeys_memory_usage_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nCOMMAND\r\n$7\r\nGETKEYS\r\n$6\r\nMEMORY\r\n$5\r\nUSAGE\r\n$3\r\nkey\r\n"[0: 62]);
    const getkeys_memory_usage_command: Command = try command_executor_test_command(&router, &getkeys_memory_usage_parsed);
    var getkeys_memory_usage_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &getkeys_memory_usage_command, 1000u64);
    try assert_true(command_executor_test_slice_eq(getkeys_memory_usage_reply.data, &"*1\r\n$3\r\nkey\r\n"[0: 13]));
    command_reply_cleanup(&getkeys_memory_usage_reply);
    resp_value_free(&getkeys_memory_usage_parsed.value);

    var getkeys_memory_usage_flags_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nCOMMAND\r\n$15\r\nGETKEYSANDFLAGS\r\n$6\r\nMEMORY\r\n$5\r\nUSAGE\r\n$3\r\nkey\r\n"[0: 71]);
    const getkeys_memory_usage_flags_command: Command = try command_executor_test_command(&router, &getkeys_memory_usage_flags_parsed);
    var getkeys_memory_usage_flags_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &getkeys_memory_usage_flags_command, 1000u64);
    try assert_true(command_executor_test_slice_eq(getkeys_memory_usage_flags_reply.data, &"*1\r\n*2\r\n$3\r\nkey\r\n*2\r\n$2\r\nRO\r\n$6\r\naccess\r\n"[0: 41]));
    command_reply_cleanup(&getkeys_memory_usage_flags_reply);
    resp_value_free(&getkeys_memory_usage_flags_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

