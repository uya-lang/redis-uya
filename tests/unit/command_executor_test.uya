    const zlex_inf_reply: CommandReply = command_execute_at(&engine, &zlex_inf_command, 1000u64);
    try assert_eq_i32(zlex_inf_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(zlex_inf_reply.integer as i32, 4);
    resp_value_free(&zlex_inf_parsed.value);

    var zrangebylex_closed_parsed: RespParseResult = try parse_resp2(&"*4\r\n$11\r\nZRANGEBYLEX\r\n$3\r\nlex\r\n$6\r\n[alpha\r\n$8\r\n[charlie\r\n"[0: 57]);
