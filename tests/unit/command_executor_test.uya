    var lset_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nLSET\r\n$5\r\nrlist\r\n$1\r\n1\r\n$3\r\nmid\r\n"[0: 41]);
    const lset_command: Command = try command_executor_test_command(&router, &lset_parsed);
    const lset_reply: CommandReply = command_execute_at(&engine, &lset_command, 1000u64);
    try assert_eq_i32(lset_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(lset_reply.data, &"OK"[0: 2]));
    resp_value_free(&lset_parsed.value);

    var lrange_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nLRANGE\r\n$5\r\nrlist\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 42]);
