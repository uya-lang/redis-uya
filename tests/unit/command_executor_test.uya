    var sort_store_parsed: RespParseResult = try parse_resp2(&"*6\r\n$4\r\nSORT\r\n$7\r\nsortnum\r\n$2\r\nBY\r\n$7\r\nsortw_*\r\n$5\r\nSTORE\r\n$7\r\nsortout\r\n"[0: 72]);
