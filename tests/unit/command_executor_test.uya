export fn test_command_scan() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var set_b_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$1\r\nb\r\n$1\r\n1\r\n"[0: 29]);
    const set_b_command: Command = try command_executor_test_command(&router, &set_b_parsed);
    _ = command_execute_at(&engine, &set_b_command, 1000u64);
    resp_value_free(&set_b_parsed.value);

    var set_a_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$1\r\na\r\n$1\r\n2\r\n"[0: 29]);
    const set_a_command: Command = try command_executor_test_command(&router, &set_a_parsed);
    _ = command_execute_at(&engine, &set_a_command, 1000u64);
    resp_value_free(&set_a_parsed.value);

    var set_c_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$1\r\nc\r\n$1\r\n3\r\n"[0: 29]);
    const set_c_command: Command = try command_executor_test_command(&router, &set_c_parsed);
    _ = command_execute_at(&engine, &set_c_command, 1000u64);
    resp_value_free(&set_c_parsed.value);

    var scan_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nSCAN\r\n$1\r\n0\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n"[0: 39]);
    const scan_command: Command = try command_executor_test_command(&router, &scan_parsed);
    var scan_reply: CommandReply = command_execute_at(&engine, &scan_command, 1000u64);
    try assert_eq_i32(scan_reply.typ as i32, CommandReplyType.reply_scan as i32);
    const scan_len: usize = try connection_encode_reply(&scan_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: scan_len], &"*2\r\n$1\r\n2\r\n*2\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 29]));
    command_reply_cleanup(&scan_reply);
    resp_value_free(&scan_parsed.value);

    var scan_tail_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nSCAN\r\n$1\r\n2\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n"[0: 39]);
    const scan_tail_command: Command = try command_executor_test_command(&router, &scan_tail_parsed);
    var scan_tail_reply: CommandReply = command_execute_at(&engine, &scan_tail_command, 1000u64);
    const scan_tail_len: usize = try connection_encode_reply(&scan_tail_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: scan_tail_len], &"*2\r\n$1\r\n0\r\n*1\r\n$1\r\nc\r\n"[0: 22]));
    command_reply_cleanup(&scan_tail_reply);
    resp_value_free(&scan_tail_parsed.value);

    var scan_empty_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nSCAN\r\n$1\r\n9\r\n"[0: 21]);
    const scan_empty_command: Command = try command_executor_test_command(&router, &scan_empty_parsed);
    var scan_empty_reply: CommandReply = command_execute_at(&engine, &scan_empty_command, 1000u64);
    const scan_empty_len: usize = try connection_encode_reply(&scan_empty_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: scan_empty_len], &"*2\r\n$1\r\n0\r\n*0\r\n"[0: 15]));
    command_reply_cleanup(&scan_empty_reply);
    resp_value_free(&scan_empty_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_randomkey_and_time() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var randomkey_empty_parsed: RespParseResult = try parse_resp2(&"*1\r\n$9\r\nRANDOMKEY\r\n"[0: 19]);
    const randomkey_empty_command: Command = try command_executor_test_command(&router, &randomkey_empty_parsed);
    const randomkey_empty_reply: CommandReply = command_execute_at(&engine, &randomkey_empty_command, 1000u64);
    try assert_eq_i32(randomkey_empty_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&randomkey_empty_parsed.value);

    var set_a_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$1\r\na\r\n$1\r\n1\r\n"[0: 29]);
    const set_a_command: Command = try command_executor_test_command(&router, &set_a_parsed);
    _ = command_execute_at(&engine, &set_a_command, 1000u64);
    resp_value_free(&set_a_parsed.value);

    var set_b_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 29]);
    const set_b_command: Command = try command_executor_test_command(&router, &set_b_parsed);
    _ = command_execute_at(&engine, &set_b_command, 1000u64);
    resp_value_free(&set_b_parsed.value);

    var set_c_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$1\r\nc\r\n$1\r\n3\r\n"[0: 29]);
    const set_c_command: Command = try command_executor_test_command(&router, &set_c_parsed);
    _ = command_execute_at(&engine, &set_c_command, 1000u64);
    resp_value_free(&set_c_parsed.value);

    var randomkey_parsed: RespParseResult = try parse_resp2(&"*1\r\n$9\r\nRANDOMKEY\r\n"[0: 19]);
    const randomkey_command: Command = try command_executor_test_command(&router, &randomkey_parsed);
    var randomkey_reply: CommandReply = command_execute_at(&engine, &randomkey_command, 1001u64);
    try assert_eq_i32(randomkey_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(randomkey_reply.data, &"c"[0: 1]));
    command_reply_cleanup(&randomkey_reply);
    resp_value_free(&randomkey_parsed.value);

    var time_parsed: RespParseResult = try parse_resp2(&"*1\r\n$4\r\nTIME\r\n"[0: 14]);
    const time_command: Command = try command_executor_test_command(&router, &time_parsed);
    var time_reply: CommandReply = command_execute_at(&engine, &time_command, 123456789u64);
    const time_len: usize = try connection_encode_reply(&time_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: time_len], &"*2\r\n$6\r\n123456\r\n$6\r\n789000\r\n"[0: 28]));
    command_reply_cleanup(&time_reply);
    resp_value_free(&time_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_touch_and_unlink() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$5\r\ntouch\r\n$5\r\nvalue\r\n"[0: 35]);
    const set_command: Command = try command_executor_test_command(&router, &set_parsed);
    _ = command_execute_at(&engine, &set_command, 1000u64);
    resp_value_free(&set_parsed.value);

    var set_two_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$6\r\nunlink\r\n$5\r\nvalue\r\n"[0: 36]);
    const set_two_command: Command = try command_executor_test_command(&router, &set_two_parsed);
    _ = command_execute_at(&engine, &set_two_command, 1000u64);
    resp_value_free(&set_two_parsed.value);

    var touch_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nTOUCH\r\n$5\r\ntouch\r\n$7\r\nmissing\r\n$6\r\nunlink\r\n"[0: 51]);
    const touch_command: Command = try command_executor_test_command(&router, &touch_parsed);
    const touch_reply: CommandReply = command_execute_at(&engine, &touch_command, 1000u64);
    try assert_eq_i32(touch_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(touch_reply.integer as i32, 2);
    resp_value_free(&touch_parsed.value);

    var unlink_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nUNLINK\r\n$6\r\nunlink\r\n$7\r\nmissing\r\n$5\r\ntouch\r\n"[0: 52]);
    const unlink_command: Command = try command_executor_test_command(&router, &unlink_parsed);
    const unlink_reply: CommandReply = command_execute_at(&engine, &unlink_command, 1000u64);
    try assert_eq_i32(unlink_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(unlink_reply.integer as i32, 2);
    resp_value_free(&unlink_parsed.value);

    try assert_true(command_executor_test_key_missing_at(&engine, &"touch"[0: 5], 1000u64));
    try assert_true(command_executor_test_key_missing_at(&engine, &"unlink"[0: 6], 1000u64));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

