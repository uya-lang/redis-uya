    try assert_true(command_executor_test_slice_eq(hincrbyfloat_missing_reply.data, &"1.5"[0: 3]));
    resp_value_free(&hincrbyfloat_missing_parsed.value);

    var hincrbyfloat_existing_parsed: RespParseResult = try parse_resp2(&"*4\r\n$12\r\nHINCRBYFLOAT\r\n$4\r\nhash\r\n$5\r\nratio\r\n$1\r\n2\r\n"[0: 51]);
    const hincrbyfloat_existing_command: Command = try command_executor_test_command(&router, &hincrbyfloat_existing_parsed);
    const hincrbyfloat_existing_reply: CommandReply = command_execute_at(&engine, &hincrbyfloat_existing_command, 1000u64);
    try assert_eq_i32(hincrbyfloat_existing_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(hincrbyfloat_existing_reply.data, &"3.5"[0: 3]));
    resp_value_free(&hincrbyfloat_existing_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_hkeys_hvals_hgetall() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var hset_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nHSET\r\n$4\r\nhash\r\n$5\r\nfield\r\n$5\r\nvalue\r\n"[0: 46]);
    const hset_command: Command = try command_executor_test_command(&router, &hset_parsed);
    _ = command_execute_at(&engine, &hset_command, 1000u64);
    resp_value_free(&hset_parsed.value);

    var hincrby_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nHINCRBY\r\n$4\r\nhash\r\n$7\r\ncounter\r\n$1\r\n2\r\n"[0: 47]);
    const hincrby_command: Command = try command_executor_test_command(&router, &hincrby_parsed);
    _ = command_execute_at(&engine, &hincrby_command, 1000u64);
    resp_value_free(&hincrby_parsed.value);

    var hincrbyfloat_parsed: RespParseResult = try parse_resp2(&"*4\r\n$12\r\nHINCRBYFLOAT\r\n$4\r\nhash\r\n$5\r\nratio\r\n$3\r\n1.5\r\n"[0: 53]);
    const hincrbyfloat_command: Command = try command_executor_test_command(&router, &hincrbyfloat_parsed);
    _ = command_execute_at(&engine, &hincrbyfloat_command, 1000u64);
    resp_value_free(&hincrbyfloat_parsed.value);

    var hkeys_parsed: RespParseResult = try parse_resp2(&"*2\r\n$5\r\nHKEYS\r\n$4\r\nhash\r\n"[0: 25]);
    const hkeys_command: Command = try command_executor_test_command(&router, &hkeys_parsed);
    var hkeys_reply: CommandReply = command_execute_at(&engine, &hkeys_command, 1000u64);
    const hkeys_len: usize = try connection_encode_reply(&hkeys_reply, &out[0], 256);
    try assert_true(command_executor_test_contains(out[0: hkeys_len], &"*3\r\n"[0: 4]));
    try assert_true(command_executor_test_contains(out[0: hkeys_len], &"$7\r\ncounter\r\n"[0: 13]));
    try assert_true(command_executor_test_contains(out[0: hkeys_len], &"$5\r\nfield\r\n"[0: 11]));
    try assert_true(command_executor_test_contains(out[0: hkeys_len], &"$5\r\nratio\r\n"[0: 11]));
    command_reply_cleanup(&hkeys_reply);
    resp_value_free(&hkeys_parsed.value);

    var hvals_parsed: RespParseResult = try parse_resp2(&"*2\r\n$5\r\nHVALS\r\n$4\r\nhash\r\n"[0: 25]);
    const hvals_command: Command = try command_executor_test_command(&router, &hvals_parsed);
    var hvals_reply: CommandReply = command_execute_at(&engine, &hvals_command, 1000u64);
    const hvals_len: usize = try connection_encode_reply(&hvals_reply, &out[0], 256);
    try assert_true(command_executor_test_contains(out[0: hvals_len], &"*3\r\n"[0: 4]));
    try assert_true(command_executor_test_contains(out[0: hvals_len], &"$1\r\n2\r\n"[0: 7]));
    try assert_true(command_executor_test_contains(out[0: hvals_len], &"$5\r\nvalue\r\n"[0: 11]));
    try assert_true(command_executor_test_contains(out[0: hvals_len], &"$3\r\n1.5\r\n"[0: 9]));
    command_reply_cleanup(&hvals_reply);
    resp_value_free(&hvals_parsed.value);

    var hgetall_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nHGETALL\r\n$4\r\nhash\r\n"[0: 27]);
    const hgetall_command: Command = try command_executor_test_command(&router, &hgetall_parsed);
    var hgetall_reply: CommandReply = command_execute_at(&engine, &hgetall_command, 1000u64);
    const hgetall_len: usize = try connection_encode_reply(&hgetall_reply, &out[0], 256);
    try assert_true(command_executor_test_contains(out[0: hgetall_len], &"*6\r\n"[0: 4]));
    try assert_true(command_executor_test_contains(out[0: hgetall_len], &"$7\r\ncounter\r\n$1\r\n2\r\n"[0: 20]));
    try assert_true(command_executor_test_contains(out[0: hgetall_len], &"$5\r\nfield\r\n$5\r\nvalue\r\n"[0: 22]));
    try assert_true(command_executor_test_contains(out[0: hgetall_len], &"$5\r\nratio\r\n$3\r\n1.5\r\n"[0: 20]));
    command_reply_cleanup(&hgetall_reply);
    resp_value_free(&hgetall_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

