    _ = command_execute_at(&engine, &set_key_command, 1000u64);
    resp_value_free(&set_key_parsed.value);

    var set_foo_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$5\r\nvalue\r\n"[0: 33]);
