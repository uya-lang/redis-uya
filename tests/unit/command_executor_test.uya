    const zscan_len: usize = try connection_encode_reply(&zscan_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zscan_len], &"*2\r\n$1\r\n0\r\n*6\r\n$1\r\na\r\n$1\r\n1\r\n$1\r\nb\r\n$1\r\n2\r\n$1\r\nc\r\n$1\r\n3\r\n"[0: 57]));
    command_reply_cleanup(&zscan_reply);
    resp_value_free(&zscan_parsed.value);

    var zremrangebyrank_parsed: RespParseResult = try parse_resp2(&"*4\r\n$15\r\nZREMRANGEBYRANK\r\n$4\r\nzset\r\n$1\r\n0\r\n$1\r\n1\r\n"[0: 50]);
