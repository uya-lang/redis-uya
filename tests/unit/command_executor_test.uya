export fn test_command_command_getkeys() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();

    var getkeys_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nCOMMAND\r\n$7\r\nGETKEYS\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 59]);
    const getkeys_command: Command = try command_executor_test_command(&router, &getkeys_parsed);
    var getkeys_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &getkeys_command, 1000u64);
    try assert_eq_i32(getkeys_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(getkeys_reply.data, &"*1\r\n$3\r\nkey\r\n"[0: 13]));
    command_reply_cleanup(&getkeys_reply);
    resp_value_free(&getkeys_parsed.value);

    var getkeys_multi_parsed: RespParseResult = try parse_resp2(&"*7\r\n$7\r\nCOMMAND\r\n$7\r\nGETKEYS\r\n$4\r\nMSET\r\n$1\r\na\r\n$1\r\n1\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 68]);
    const getkeys_multi_command: Command = try command_executor_test_command(&router, &getkeys_multi_parsed);
    var getkeys_multi_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &getkeys_multi_command, 1000u64);
    try assert_true(command_executor_test_slice_eq(getkeys_multi_reply.data, &"*2\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 18]));
    command_reply_cleanup(&getkeys_multi_reply);
    resp_value_free(&getkeys_multi_parsed.value);

    var getkeys_sort_parsed: RespParseResult = try parse_resp2(&"*7\r\n$7\r\nCOMMAND\r\n$7\r\nGETKEYS\r\n$4\r\nSORT\r\n$6\r\nmylist\r\n$5\r\nALPHA\r\n$5\r\nSTORE\r\n$3\r\nout\r\n"[0: 83]);
    const getkeys_sort_command: Command = try command_executor_test_command(&router, &getkeys_sort_parsed);
    var getkeys_sort_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &getkeys_sort_command, 1000u64);
    try assert_true(command_executor_test_slice_eq(getkeys_sort_reply.data, &"*2\r\n$6\r\nmylist\r\n$3\r\nout\r\n"[0: 25]));
    command_reply_cleanup(&getkeys_sort_reply);
