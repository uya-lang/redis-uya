export fn test_command_hotkeys() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 4096] = [];

    var hotkeys_help_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nHOTKEYS\r\n$4\r\nHELP\r\n"[0: 27]);
    const hotkeys_help_command: Command = try command_executor_test_command(&router, &hotkeys_help_parsed);
    var hotkeys_help_reply: CommandReply = command_execute_at(&engine, &hotkeys_help_command, 1000u64);
    const hotkeys_help_len: usize = try connection_encode_reply(&hotkeys_help_reply, &out[0], 4096);
    try assert_true(command_executor_test_contains(out[0: hotkeys_help_len], &"HOTKEYS HELP"[0: 12]));
    try assert_true(command_executor_test_contains(out[0: hotkeys_help_len], &"HOTKEYS GET"[0: 11]));
    try assert_true(command_executor_test_contains(out[0: hotkeys_help_len], &"HOTKEYS START"[0: 13]));
    try assert_true(command_executor_test_contains(out[0: hotkeys_help_len], &"HOTKEYS STOP"[0: 12]));
    command_reply_cleanup(&hotkeys_help_reply);
    resp_value_free(&hotkeys_help_parsed.value);

    var hotkeys_get_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nHOTKEYS\r\n$3\r\nGET\r\n"[0: 26]);
    const hotkeys_get_command: Command = try command_executor_test_command(&router, &hotkeys_get_parsed);
    var hotkeys_get_reply: CommandReply = command_execute_at(&engine, &hotkeys_get_command, 1000u64);
    try assert_eq_i32(hotkeys_get_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(hotkeys_get_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&hotkeys_get_reply);
    resp_value_free(&hotkeys_get_parsed.value);

    var hotkeys_reset_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nHOTKEYS\r\n$5\r\nRESET\r\n"[0: 28]);
    const hotkeys_reset_command: Command = try command_executor_test_command(&router, &hotkeys_reset_parsed);
    const hotkeys_reset_reply: CommandReply = command_execute_at(&engine, &hotkeys_reset_command, 1000u64);
    try assert_eq_i32(hotkeys_reset_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(hotkeys_reset_reply.data, &"OK"[0: 2]));
    resp_value_free(&hotkeys_reset_parsed.value);

    var hotkeys_start_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nHOTKEYS\r\n$5\r\nSTART\r\n$6\r\nSAMPLE\r\n$1\r\n1\r\n"[0: 47]);
    const hotkeys_start_command: Command = try command_executor_test_command(&router, &hotkeys_start_parsed);
    const hotkeys_start_reply: CommandReply = command_execute_at(&engine, &hotkeys_start_command, 1000u64);
    try assert_eq_i32(hotkeys_start_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(hotkeys_start_reply.data, &"OK"[0: 2]));
    resp_value_free(&hotkeys_start_parsed.value);

    var hotkeys_stop_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nHOTKEYS\r\n$4\r\nSTOP\r\n"[0: 27]);
    const hotkeys_stop_command: Command = try command_executor_test_command(&router, &hotkeys_stop_parsed);
    const hotkeys_stop_reply: CommandReply = command_execute_at(&engine, &hotkeys_stop_command, 1000u64);
    try assert_eq_i32(hotkeys_stop_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(hotkeys_stop_reply.data, &"OK"[0: 2]));
    resp_value_free(&hotkeys_stop_parsed.value);

    var hotkeys_unknown_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nHOTKEYS\r\n$1\r\nX\r\n"[0: 24]);
    const hotkeys_unknown_command: Command = try command_executor_test_command(&router, &hotkeys_unknown_parsed);
    var hotkeys_unknown_reply: CommandReply = command_execute_at(&engine, &hotkeys_unknown_command, 1000u64);
    try assert_eq_i32(hotkeys_unknown_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(hotkeys_unknown_reply.data, &"ERR unknown subcommand 'X'. Try HOTKEYS HELP."[0: 45]));
    command_reply_cleanup(&hotkeys_unknown_reply);
    resp_value_free(&hotkeys_unknown_parsed.value);

    var hotkeys_get_wrong_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nHOTKEYS\r\n$3\r\nGET\r\n$1\r\nX\r\n"[0: 33]);
    const hotkeys_get_wrong_command: Command = try command_executor_test_command(&router, &hotkeys_get_wrong_parsed);
    var hotkeys_get_wrong_reply: CommandReply = command_execute_at(&engine, &hotkeys_get_wrong_command, 1000u64);
    try assert_eq_i32(hotkeys_get_wrong_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(hotkeys_get_wrong_reply.data, &"ERR wrong number of arguments for 'hotkeys|get' command"[0: 55]));
    command_reply_cleanup(&hotkeys_get_wrong_reply);
    resp_value_free(&hotkeys_get_wrong_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_slowlog() !void {
    reset_memory_stats_for_test();
    slowlog_reset();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 1024] = [];
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.slowlog_log_slower_than = 0;

    var slowlog_help_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nSLOWLOG\r\n$4\r\nHELP\r\n"[0: 27]);
    const slowlog_help_command: Command = try command_executor_test_command(&router, &slowlog_help_parsed);
    var slowlog_help_reply: CommandReply = command_execute_at(&engine, &slowlog_help_command, 1000u64);
    const slowlog_help_len: usize = try connection_encode_reply(&slowlog_help_reply, &out[0], 1024);
    try assert_true(command_executor_test_contains(out[0: slowlog_help_len], &"SLOWLOG GET [count]"[0: 19]));
    try assert_true(command_executor_test_contains(out[0: slowlog_help_len], &"SLOWLOG RESET"[0: 13]));
    command_reply_cleanup(&slowlog_help_reply);
    resp_value_free(&slowlog_help_parsed.value);

    var slowlog_empty_get_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nSLOWLOG\r\n$3\r\nGET\r\n"[0: 26]);
    const slowlog_empty_get_command: Command = try command_executor_test_command(&router, &slowlog_empty_get_parsed);
    var slowlog_empty_get_reply: CommandReply = command_execute_at(&engine, &slowlog_empty_get_command, 1000u64);
    try assert_true(command_executor_test_slice_eq(slowlog_empty_get_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&slowlog_empty_get_reply);
    resp_value_free(&slowlog_empty_get_parsed.value);

    var set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$1\r\nk\r\n$1\r\nv\r\n"[0: 27]);
    const set_command: Command = try command_executor_test_command(&router, &set_parsed);
    _ = command_execute_with_runtime_at(&engine, &runtime, &set_command, 1000u64);
    resp_value_free(&set_parsed.value);

    var get_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nGET\r\n$1\r\nk\r\n"[0: 20]);
    const get_command: Command = try command_executor_test_command(&router, &get_parsed);
    var get_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &get_command, 1000u64);
    command_reply_cleanup(&get_reply);
    resp_value_free(&get_parsed.value);

    const newest_entry: &SlowlogEntry = slowlog_entry_newest(0);
    try assert_true(newest_entry != null);
    try assert_eq_u64(newest_entry.timestamp_sec, 1u64);
    try assert_true(command_executor_test_slice_eq(newest_entry.args[0].data[0: newest_entry.args[0].len], &"GET"[0: 3]));
    try assert_true(command_executor_test_slice_eq(newest_entry.args[1].data[0: newest_entry.args[1].len], &"k"[0: 1]));

    var slowlog_len_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nSLOWLOG\r\n$3\r\nLEN\r\n"[0: 26]);
    const slowlog_len_command: Command = try command_executor_test_command(&router, &slowlog_len_parsed);
    const slowlog_len_reply: CommandReply = command_execute_at(&engine, &slowlog_len_command, 1000u64);
    try assert_eq_i32(slowlog_len_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(slowlog_len_reply.integer as i32, 2);
    resp_value_free(&slowlog_len_parsed.value);

    var slowlog_get_one_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nSLOWLOG\r\n$3\r\nGET\r\n$1\r\n1\r\n"[0: 33]);
    const slowlog_get_one_command: Command = try command_executor_test_command(&router, &slowlog_get_one_parsed);
    var slowlog_get_one_reply: CommandReply = command_execute_at(&engine, &slowlog_get_one_command, 1000u64);
    try assert_true(command_executor_test_contains(slowlog_get_one_reply.data, &"$3\r\nGET\r\n$1\r\nk\r\n"[0: 16]));
    try assert_true(command_executor_test_contains(slowlog_get_one_reply.data, &"$11\r\n127.0.0.1:0\r\n"[0: 18]));
    command_reply_cleanup(&slowlog_get_one_reply);
    resp_value_free(&slowlog_get_one_parsed.value);

    var slowlog_get_all_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nSLOWLOG\r\n$3\r\nGET\r\n$2\r\n-1\r\n"[0: 34]);
    const slowlog_get_all_command: Command = try command_executor_test_command(&router, &slowlog_get_all_parsed);
    var slowlog_get_all_reply: CommandReply = command_execute_at(&engine, &slowlog_get_all_command, 1000u64);
    try assert_true(command_executor_test_contains(slowlog_get_all_reply.data, &"$3\r\nSET\r\n$1\r\nk\r\n$1\r\nv\r\n"[0: 23]));
    command_reply_cleanup(&slowlog_get_all_reply);
    resp_value_free(&slowlog_get_all_parsed.value);

    var slowlog_reset_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nSLOWLOG\r\n$5\r\nRESET\r\n"[0: 28]);
    const slowlog_reset_command: Command = try command_executor_test_command(&router, &slowlog_reset_parsed);
    const slowlog_reset_reply: CommandReply = command_execute_at(&engine, &slowlog_reset_command, 1000u64);
    try assert_eq_i32(slowlog_reset_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(slowlog_reset_reply.data, &"OK"[0: 2]));
    resp_value_free(&slowlog_reset_parsed.value);

    var slowlog_len_zero_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nSLOWLOG\r\n$3\r\nLEN\r\n"[0: 26]);
    const slowlog_len_zero_command: Command = try command_executor_test_command(&router, &slowlog_len_zero_parsed);
    const slowlog_len_zero_reply: CommandReply = command_execute_at(&engine, &slowlog_len_zero_command, 1000u64);
    try assert_eq_i32(slowlog_len_zero_reply.integer as i32, 0);
    resp_value_free(&slowlog_len_zero_parsed.value);

    runtime.config.slowlog_log_slower_than = 0;
    runtime.config.slowlog_max_len = 1;
    var trim_set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$6\r\ntrim-k\r\n$1\r\n1\r\n"[0: 32]);
    const trim_set_command: Command = try command_executor_test_command(&router, &trim_set_parsed);
    var trim_set_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &trim_set_command, 1000u64);
    command_reply_cleanup(&trim_set_reply);
    resp_value_free(&trim_set_parsed.value);

    var trim_get_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nGET\r\n$6\r\ntrim-k\r\n"[0: 25]);
    const trim_get_command: Command = try command_executor_test_command(&router, &trim_get_parsed);
    var trim_get_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &trim_get_command, 1000u64);
    command_reply_cleanup(&trim_get_reply);
    resp_value_free(&trim_get_parsed.value);

    var slowlog_trimmed_len_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nSLOWLOG\r\n$3\r\nLEN\r\n"[0: 26]);
    const slowlog_trimmed_len_command: Command = try command_executor_test_command(&router, &slowlog_trimmed_len_parsed);
    const slowlog_trimmed_len_reply: CommandReply = command_execute_at(&engine, &slowlog_trimmed_len_command, 1000u64);
    try assert_eq_i32(slowlog_trimmed_len_reply.integer as i32, 1);
    resp_value_free(&slowlog_trimmed_len_parsed.value);

    const trimmed_entry: &SlowlogEntry = slowlog_entry_newest(0);
    try assert_true(trimmed_entry != null);
    try assert_true(command_executor_test_slice_eq(trimmed_entry.args[0].data[0: trimmed_entry.args[0].len], &"GET"[0: 3]));

    slowlog_reset();
    runtime.config.slowlog_log_slower_than = -1;
    var disabled_set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$8\r\ndisabled\r\n$1\r\n1\r\n"[0: 34]);
    const disabled_set_command: Command = try command_executor_test_command(&router, &disabled_set_parsed);
    var disabled_set_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &disabled_set_command, 1000u64);
    command_reply_cleanup(&disabled_set_reply);
    resp_value_free(&disabled_set_parsed.value);

    var slowlog_disabled_len_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nSLOWLOG\r\n$3\r\nLEN\r\n"[0: 26]);
    const slowlog_disabled_len_command: Command = try command_executor_test_command(&router, &slowlog_disabled_len_parsed);
    const slowlog_disabled_len_reply: CommandReply = command_execute_at(&engine, &slowlog_disabled_len_command, 1000u64);
    try assert_eq_i32(slowlog_disabled_len_reply.integer as i32, 0);
    resp_value_free(&slowlog_disabled_len_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_latency() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var config_resetstat_seed_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nCONFIG\r\n$9\r\nRESETSTAT\r\n"[0: 31]);
    const config_resetstat_seed_command: Command = try command_executor_test_command(&router, &config_resetstat_seed_parsed);
    const config_resetstat_seed_reply: CommandReply = command_execute_at(&engine, &config_resetstat_seed_command, 1000u64);
    try assert_eq_i32(config_resetstat_seed_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    resp_value_free(&config_resetstat_seed_parsed.value);

    var reset_seed_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nLATENCY\r\n$5\r\nRESET\r\n"[0: 28]);
    const reset_seed_command: Command = try command_executor_test_command(&router, &reset_seed_parsed);
    _ = command_execute_at(&engine, &reset_seed_command, 1000u64);
    resp_value_free(&reset_seed_parsed.value);

    var latest_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nLATENCY\r\n$6\r\nLATEST\r\n"[0: 29]);
    const latest_command: Command = try command_executor_test_command(&router, &latest_parsed);
    var latest_reply: CommandReply = command_execute_at(&engine, &latest_command, 1000u64);
    try assert_eq_i32(latest_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(latest_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&latest_reply);
    resp_value_free(&latest_parsed.value);

    var latency_runtime: CommandRuntimeInfo = command_runtime_default();
    latency_runtime.config.latency_monitor_threshold = 1;
    var seed_set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$5\r\nlat-k\r\n$1\r\n1\r\n"[0: 31]);
    const seed_set_command: Command = try command_executor_test_command(&router, &seed_set_parsed);
    const seed_set_reply: CommandReply = command_execute_with_runtime_at(&engine, &latency_runtime, &seed_set_command, 2000u64);
    try assert_eq_i32(seed_set_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    resp_value_free(&seed_set_parsed.value);

    var latest_recorded_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nLATENCY\r\n$6\r\nLATEST\r\n"[0: 29]);
    const latest_recorded_command: Command = try command_executor_test_command(&router, &latest_recorded_parsed);
    var latest_recorded_reply: CommandReply = command_execute_at(&engine, &latest_recorded_command, 2000u64);
    try assert_eq_i32(latest_recorded_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_contains(latest_recorded_reply.data, &"$7\r\ncommand\r\n"[0: 13]));
    try assert_true(command_executor_test_contains(latest_recorded_reply.data, &":2\r\n"[0: 4]));
    command_reply_cleanup(&latest_recorded_reply);
    resp_value_free(&latest_recorded_parsed.value);

    var history_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nLATENCY\r\n$7\r\nHISTORY\r\n$7\r\ncommand\r\n"[0: 43]);
    const history_command: Command = try command_executor_test_command(&router, &history_parsed);
    var history_reply: CommandReply = command_execute_at(&engine, &history_command, 2000u64);
    try assert_eq_i32(history_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_contains(history_reply.data, &":2\r\n"[0: 4]));
    command_reply_cleanup(&history_reply);
    resp_value_free(&history_parsed.value);

    var histogram_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nLATENCY\r\n$9\r\nHISTOGRAM\r\n$3\r\nSET\r\n"[0: 41]);
    const histogram_command: Command = try command_executor_test_command(&router, &histogram_parsed);
    var histogram_reply: CommandReply = command_execute_at(&engine, &histogram_command, 1000u64);
    try assert_eq_i32(histogram_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_contains(histogram_reply.data, &"$3\r\nset\r\n"[0: 9]));
    try assert_true(command_executor_test_contains(histogram_reply.data, &"$5\r\ncalls\r\n:1\r\n"[0: 15]));
    try assert_true(command_executor_test_contains(histogram_reply.data, &"$14\r\nhistogram_usec\r\n"[0: 21]));
    command_reply_cleanup(&histogram_reply);
    resp_value_free(&histogram_parsed.value);

    var config_set_latency_histogram_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$16\r\nlatency-tracking\r\n$3\r\nyes\r\n"[0: 57]);
    const config_set_latency_histogram_command: Command = try command_executor_test_command(&router, &config_set_latency_histogram_parsed);
    const config_set_latency_histogram_reply: CommandReply = command_execute_at(&engine, &config_set_latency_histogram_command, 2000u64);
    try assert_eq_i32(config_set_latency_histogram_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    resp_value_free(&config_set_latency_histogram_parsed.value);

    var histogram_config_set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nLATENCY\r\n$9\r\nHISTOGRAM\r\n$10\r\nCONFIG|SET\r\n"[0: 49]);
    const histogram_config_set_command: Command = try command_executor_test_command(&router, &histogram_config_set_parsed);
    var histogram_config_set_reply: CommandReply = command_execute_at(&engine, &histogram_config_set_command, 1000u64);
    try assert_eq_i32(histogram_config_set_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_contains(histogram_config_set_reply.data, &"$10\r\nconfig|set\r\n"[0: 17]));
    try assert_true(command_executor_test_contains(histogram_config_set_reply.data, &"$5\r\ncalls\r\n:1\r\n"[0: 15]));
    command_reply_cleanup(&histogram_config_set_reply);
    resp_value_free(&histogram_config_set_parsed.value);

    var histogram_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nLATENCY\r\n$9\r\nHISTOGRAM\r\n$7\r\nmissing\r\n"[0: 45]);
    const histogram_missing_command: Command = try command_executor_test_command(&router, &histogram_missing_parsed);
    var histogram_missing_reply: CommandReply = command_execute_at(&engine, &histogram_missing_command, 1000u64);
    try assert_eq_i32(histogram_missing_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(histogram_missing_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&histogram_missing_reply);
    resp_value_free(&histogram_missing_parsed.value);

    var config_resetstat_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nCONFIG\r\n$9\r\nRESETSTAT\r\n"[0: 31]);
    const config_resetstat_command: Command = try command_executor_test_command(&router, &config_resetstat_parsed);
    const config_resetstat_reply: CommandReply = command_execute_at(&engine, &config_resetstat_command, 1000u64);
    try assert_eq_i32(config_resetstat_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    resp_value_free(&config_resetstat_parsed.value);

    var histogram_reset_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nLATENCY\r\n$9\r\nHISTOGRAM\r\n$3\r\nSET\r\n"[0: 41]);
    const histogram_reset_command: Command = try command_executor_test_command(&router, &histogram_reset_parsed);
    var histogram_reset_reply: CommandReply = command_execute_at(&engine, &histogram_reset_command, 1000u64);
    try assert_eq_i32(histogram_reset_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(histogram_reset_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&histogram_reset_reply);
    resp_value_free(&histogram_reset_parsed.value);

    var disabled_runtime: CommandRuntimeInfo = command_runtime_default();
    disabled_runtime.config.latency_tracking = false;
    var disabled_set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$14\r\nlat-disabled-k\r\n$1\r\n1\r\n"[0: 41]);
    const disabled_set_command: Command = try command_executor_test_command(&router, &disabled_set_parsed);
    const disabled_set_reply: CommandReply = command_execute_with_runtime_at(&engine, &disabled_runtime, &disabled_set_command, 2000u64);
    try assert_eq_i32(disabled_set_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    resp_value_free(&disabled_set_parsed.value);

    var histogram_disabled_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nLATENCY\r\n$9\r\nHISTOGRAM\r\n$3\r\nSET\r\n"[0: 41]);
    const histogram_disabled_command: Command = try command_executor_test_command(&router, &histogram_disabled_parsed);
    var histogram_disabled_reply: CommandReply = command_execute_at(&engine, &histogram_disabled_command, 1000u64);
    try assert_eq_i32(histogram_disabled_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(histogram_disabled_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&histogram_disabled_reply);
    resp_value_free(&histogram_disabled_parsed.value);

    var graph_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nLATENCY\r\n$5\r\nGRAPH\r\n$7\r\ncommand\r\n"[0: 41]);
    const graph_command: Command = try command_executor_test_command(&router, &graph_parsed);
    var graph_reply: CommandReply = command_execute_at(&engine, &graph_command, 1000u64);
    try assert_eq_i32(graph_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_contains(graph_reply.data, &"command latency history"[0: 23]));
    command_reply_cleanup(&graph_reply);
    resp_value_free(&graph_parsed.value);

    var doctor_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nLATENCY\r\n$6\r\nDOCTOR\r\n"[0: 29]);
    const doctor_command: Command = try command_executor_test_command(&router, &doctor_parsed);
    var doctor_reply: CommandReply = command_execute_at(&engine, &doctor_command, 1000u64);
    try assert_eq_i32(doctor_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_contains(doctor_reply.data, &"recorded command events"[0: 23]));
    command_reply_cleanup(&doctor_reply);
    resp_value_free(&doctor_parsed.value);

    var reset_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nLATENCY\r\n$5\r\nRESET\r\n"[0: 28]);
    const reset_command: Command = try command_executor_test_command(&router, &reset_parsed);
    const reset_reply: CommandReply = command_execute_at(&engine, &reset_command, 1000u64);
    try assert_eq_i32(reset_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(reset_reply.integer as i32, 1);
    resp_value_free(&reset_parsed.value);

    var unknown_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nLATENCY\r\n$1\r\nX\r\n"[0: 24]);
    const unknown_command: Command = try command_executor_test_command(&router, &unknown_parsed);
    var unknown_reply: CommandReply = command_execute_at(&engine, &unknown_command, 1000u64);
    try assert_eq_i32(unknown_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(unknown_reply.data, &"ERR unknown subcommand 'X'. Try LATENCY HELP."[0: 45]));
    command_reply_cleanup(&unknown_reply);
    resp_value_free(&unknown_parsed.value);

    var history_bad_arity_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nLATENCY\r\n$7\r\nHISTORY\r\n"[0: 30]);
    const history_bad_arity_command: Command = try command_executor_test_command(&router, &history_bad_arity_parsed);
    var history_bad_arity_reply: CommandReply = command_execute_at(&engine, &history_bad_arity_command, 1000u64);
    try assert_eq_i32(history_bad_arity_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(history_bad_arity_reply.data, &"ERR wrong number of arguments for 'latency|history' command"[0: 59]));
    command_reply_cleanup(&history_bad_arity_reply);
    resp_value_free(&history_bad_arity_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_move() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();

    var move_same_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nMOVE\r\n$7\r\nmissing\r\n$1\r\n0\r\n"[0: 34]);
    const move_same_missing_command: Command = try command_executor_test_command(&router, &move_same_missing_parsed);
