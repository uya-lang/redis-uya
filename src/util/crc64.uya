// util/crc64.uya - Redis CRC64 implementation.

const CRC64_POLY: u64 = 0x95ac9329ac4bc9b5u64;

var crc64_table_ready: bool = false;
var crc64_table_0: [u64: 256] = [];
var crc64_table_1: [u64: 256] = [];
var crc64_table_2: [u64: 256] = [];
var crc64_table_3: [u64: 256] = [];

fn crc64_byte(crc: u64, value: byte) u64 {
    var c: u64 = crc ^ (value as u64);
    var bit: i32 = 0;
    while bit < 8 {
        if (c & 1u64) != 0u64 {
            c = (c >> 1) ^ CRC64_POLY;
        } else {
            c = c >> 1;
        }
        bit = bit + 1;
    }
    return c;
}

fn crc64_init_table() void {
    if crc64_table_ready {
        return;
    }
    var i: usize = 0;
    while i < 256 {
        crc64_table_0[i] = crc64_byte(0u64, i as byte);
        i = i + 1;
    }
    i = 0;
    while i < 256 {
        const value_0: u64 = crc64_table_0[i];
        crc64_table_1[i] = crc64_table_0[(value_0 & 255u64) as usize] ^ (value_0 >> 8);
        const value_1: u64 = crc64_table_1[i];
        crc64_table_2[i] = crc64_table_0[(value_1 & 255u64) as usize] ^ (value_1 >> 8);
        const value_2: u64 = crc64_table_2[i];
        crc64_table_3[i] = crc64_table_0[(value_2 & 255u64) as usize] ^ (value_2 >> 8);
        i = i + 1;
    }
    crc64_table_ready = true;
}

export fn crc64_update_scalar_for_test(crc: u64, data: &[byte]) u64 {
    var c: u64 = crc;
    var i: usize = 0;
    while i < data.len {
        c = crc64_byte(c, data.ptr[i]);
        i = i + 1;
    }
    return c;
}

export fn crc64_update(crc: u64, data: &[byte]) u64 {
    if !crc64_table_ready {
        crc64_init_table();
    }
    var c: u64 = crc;
    var i: usize = 0;
    while i + 4usize <= data.len {
        const word: u64 = c ^ ((data.ptr[i] as u64) |
            ((data.ptr[i + 1usize] as u64) << 8) |
            ((data.ptr[i + 2usize] as u64) << 16) |
            ((data.ptr[i + 3usize] as u64) << 24));
        c = crc64_table_3[(word & 255u64) as usize] ^
            crc64_table_2[((word >> 8) & 255u64) as usize] ^
            crc64_table_1[((word >> 16) & 255u64) as usize] ^
            crc64_table_0[((word >> 24) & 255u64) as usize] ^
            (c >> 32);
        i = i + 4usize;
    }
    while i < data.len {
        const index: usize = ((c ^ (data.ptr[i] as u64)) & 255u64) as usize;
        c = crc64_table_0[index] ^ (c >> 8);
        i = i + 1;
    }
    return c;
}

export fn crc64(data: &[byte]) u64 {
    return crc64_update(0u64, data);
}
