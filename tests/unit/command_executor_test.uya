    var sscan_bad_option_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nSSCAN\r\n$3\r\nkey\r\n$1\r\n0\r\n$5\r\nMATCH\r\n$1\r\n*\r\n"[0: 49]);
    const sscan_bad_option_command: Command = try command_executor_test_command(&router, &sscan_bad_option_parsed);
    const sscan_bad_option_reply: CommandReply = command_execute_at(&engine, &sscan_bad_option_command, 1000u64);
    try assert_eq_i32(sscan_bad_option_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&sscan_bad_option_parsed.value);

    var zadd_wrongtype_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nZADD\r\n$3\r\nkey\r\n$1\r\n1\r\n$1\r\na\r\n"[0: 37]);
