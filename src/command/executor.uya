    _ = list_object_push_tail(reply_list, &"geo"[0: 3]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"stream"[0: 6]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"pubsub"[0: 6]) catch { object_free(reply_list); return command_executor_oom(); };
