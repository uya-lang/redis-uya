    var requested_count: usize = 1;
    if command.argc == keys_end + 3 {
        const option: &[byte] = command_executor_arg(command, keys_end + 1) catch {
            return command_executor_syntax_error();
        };
        if !command_executor_keyword_eq(option, &"COUNT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const count_data: &[byte] = command_executor_arg(command, keys_end + 2) catch {
