    var msetex_bad_ttl_parsed: RespParseResult = try parse_resp2(&"*6\r\n$6\r\nMSETEX\r\n$1\r\n1\r\n$3\r\nbad\r\n$1\r\nv\r\n$2\r\nPX\r\n$1\r\n0\r\n"[0: 54]);
