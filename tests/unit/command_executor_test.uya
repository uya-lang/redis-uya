export fn test_command_sort_ro() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 512] = [];

    var rpush_nums_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nRPUSH\r\n$7\r\nsortnum\r\n$1\r\n3\r\n$1\r\n1\r\n$1\r\n2\r\n"[0: 49]);
    const rpush_nums_command: Command = try command_executor_test_command(&router, &rpush_nums_parsed);
    _ = command_execute_at(&engine, &rpush_nums_command, 1000u64);
    resp_value_free(&rpush_nums_parsed.value);

    var sort_ro_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nSORT_RO\r\n$7\r\nsortnum\r\n"[0: 30]);
    const sort_ro_command: Command = try command_executor_test_command(&router, &sort_ro_parsed);
    var sort_ro_reply: CommandReply = command_execute_at(&engine, &sort_ro_command, 1000u64);
    const sort_ro_len: usize = try connection_encode_reply(&sort_ro_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: sort_ro_len], &"*3\r\n$1\r\n1\r\n$1\r\n2\r\n$1\r\n3\r\n"[0: 25]));
    command_reply_cleanup(&sort_ro_reply);
    resp_value_free(&sort_ro_parsed.value);

    var sort_ro_store_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nSORT_RO\r\n$7\r\nsortnum\r\n$5\r\nSTORE\r\n$7\r\nsortout\r\n"[0: 56]);
    const sort_ro_store_command: Command = try command_executor_test_command(&router, &sort_ro_store_parsed);
    const sort_ro_store_reply: CommandReply = command_execute_at(&engine, &sort_ro_store_command, 1000u64);
    try assert_eq_i32(sort_ro_store_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(sort_ro_store_reply.data, &"ERR syntax error"[0: 16]));
    resp_value_free(&sort_ro_store_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_hscan() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];
    _ = out;

    var hset_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nHSET\r\n$5\r\nhscan\r\n$1\r\na\r\n$1\r\n1\r\n"[0: 39]);
    const hset_command: Command = try command_executor_test_command(&router, &hset_parsed);
    _ = command_execute_at(&engine, &hset_command, 1000u64);
    resp_value_free(&hset_parsed.value);

    var hset_b_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nHSET\r\n$5\r\nhscan\r\n$1\r\nb\r\n$1\r\n2\r\n"[0: 39]);
    const hset_b_command: Command = try command_executor_test_command(&router, &hset_b_parsed);
    _ = command_execute_at(&engine, &hset_b_command, 1000u64);
    resp_value_free(&hset_b_parsed.value);

    var hset_c_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nHSET\r\n$5\r\nhscan\r\n$1\r\nc\r\n$1\r\n3\r\n"[0: 39]);
    const hset_c_command: Command = try command_executor_test_command(&router, &hset_c_parsed);
    _ = command_execute_at(&engine, &hset_c_command, 1000u64);
    resp_value_free(&hset_c_parsed.value);

    var hscan_parsed: RespParseResult = try parse_resp2(&"*3\r\n$5\r\nHSCAN\r\n$5\r\nhscan\r\n$1\r\n0\r\n"[0: 33]);
    const hscan_command: Command = try command_executor_test_command(&router, &hscan_parsed);
    var hscan_reply: CommandReply = command_execute_at(&engine, &hscan_command, 1000u64);
    try assert_eq_i32(hscan_reply.typ as i32, CommandReplyType.reply_scan as i32);
    try assert_eq_i32(hscan_reply.scan_cursor as i32, 0);
    try assert_eq_i32(hscan_reply.array_count as i32, 6);
    command_reply_cleanup(&hscan_reply);
    resp_value_free(&hscan_parsed.value);

    var hscan_partial_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nHSCAN\r\n$5\r\nhscan\r\n$1\r\n0\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n"[0: 51]);
    const hscan_partial_command: Command = try command_executor_test_command(&router, &hscan_partial_parsed);
    var hscan_partial_reply: CommandReply = command_execute_at(&engine, &hscan_partial_command, 1000u64);
    try assert_eq_i32(hscan_partial_reply.typ as i32, CommandReplyType.reply_scan as i32);
    try assert_eq_i32(hscan_partial_reply.scan_cursor as i32, 2);
    try assert_eq_i32(hscan_partial_reply.array_count as i32, 4);
    command_reply_cleanup(&hscan_partial_reply);
    resp_value_free(&hscan_partial_parsed.value);

    var hscan_empty_parsed: RespParseResult = try parse_resp2(&"*3\r\n$5\r\nHSCAN\r\n$4\r\nnone\r\n$1\r\n0\r\n"[0: 32]);
    const hscan_empty_command: Command = try command_executor_test_command(&router, &hscan_empty_parsed);
    var hscan_empty_reply: CommandReply = command_execute_at(&engine, &hscan_empty_command, 1000u64);
    try assert_eq_i32(hscan_empty_reply.typ as i32, CommandReplyType.reply_scan as i32);
    try assert_eq_i32(hscan_empty_reply.scan_cursor as i32, 0);
    try assert_eq_i32(hscan_empty_reply.array_count as i32, 0);
    command_reply_cleanup(&hscan_empty_reply);
    resp_value_free(&hscan_empty_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_error_paths() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var bad_ping_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nPING\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 30]);
