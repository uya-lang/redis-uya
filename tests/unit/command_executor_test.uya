    const lrange_after_ltrim_reply: CommandReply = command_execute_at(&engine, &lrange_after_ltrim_command, 1000u64);
    const lrange_after_ltrim_len: usize = try connection_encode_reply(&lrange_after_ltrim_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: lrange_after_ltrim_len], &"*3\r\n$1\r\nx\r\n$1\r\nc\r\n$1\r\nb\r\n"[0: 25]));
    command_reply_cleanup(&lrange_after_ltrim_reply);
    resp_value_free(&lrange_after_ltrim_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

