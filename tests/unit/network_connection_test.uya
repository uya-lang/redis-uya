    const geoadd_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*8\r\n$6\r\nGEOADD\r\n$3\r\ngeo\r\n$9\r\n13.361389\r\n$9\r\n38.115556\r\n$7\r\nPalermo\r\n$9\r\n15.087269\r\n$9\r\n37.502669\r\n$7\r\nCatania\r\n"[0: 111], &out[0], 512, 1000u64);
