    command_reply_cleanup(&lrange_before_reply);
    resp_value_free(&lrange_before_parsed.value);

    var lrem_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nLREM\r\n$5\r\nwlist\r\n$1\r\n1\r\n$1\r\nb\r\n"[0: 39]);
    const lrem_command: Command = try command_executor_test_command(&router, &lrem_parsed);
    const lrem_reply: CommandReply = command_execute_at(&engine, &lrem_command, 1000u64);
    try assert_eq_i32(lrem_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(lrem_reply.integer as i32, 1);
    resp_value_free(&lrem_parsed.value);

    var lrange_after_lrem_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nLRANGE\r\n$5\r\nwlist\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 42]);
    const lrange_after_lrem_command: Command = try command_executor_test_command(&router, &lrange_after_lrem_parsed);
    const lrange_after_lrem_reply: CommandReply = command_execute_at(&engine, &lrange_after_lrem_command, 1000u64);
    const lrange_after_lrem_len: usize = try connection_encode_reply(&lrange_after_lrem_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: lrange_after_lrem_len], &"*5\r\n$1\r\na\r\n$1\r\nx\r\n$1\r\nc\r\n$1\r\nb\r\n$1\r\nd\r\n"[0: 39]));
    command_reply_cleanup(&lrange_after_lrem_reply);
    resp_value_free(&lrange_after_lrem_parsed.value);

    var ltrim_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nLTRIM\r\n$5\r\nwlist\r\n$1\r\n1\r\n$1\r\n3\r\n"[0: 40]);
    const ltrim_command: Command = try command_executor_test_command(&router, &ltrim_parsed);
    const ltrim_reply: CommandReply = command_execute_at(&engine, &ltrim_command, 1000u64);
    try assert_eq_i32(ltrim_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
