    var hrandfield_missing_single_parsed: RespParseResult = try parse_resp2(&"*2\r\n$10\r\nHRANDFIELD\r\n$7\r\nmissing\r\n"[0: 34]);
    const hrandfield_missing_single_command: Command = try command_executor_test_command(&router, &hrandfield_missing_single_parsed);
