    _ = list_object_push_tail(reply_list, &"    Show the ACL log entries."[0: 29]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"SAVE"[0: 4]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"    Save the current config to the ACL file."[0: 44]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"SETUSER <username> <attribute> [<attribute> ...]"[0: 48]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"    Create or modify a user with the specified attributes."[0: 58]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"USERS"[0: 5]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"    List all the registered usernames."[0: 38]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"WHOAMI"[0: 6]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"    Return the current connection username."[0: 43]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"HELP"[0: 4]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"    Prints this help."[0: 21]) catch { object_free(reply_list); return command_executor_oom(); };
    return command_executor_owned_array(reply_list);
}

fn command_executor_acl_category_known(category: &[byte]) bool {
    return command_executor_keyword_eq(category, &"keyspace"[0: 8]) ||
        command_executor_keyword_eq(category, &"read"[0: 4]) ||
        command_executor_keyword_eq(category, &"write"[0: 5]) ||
        command_executor_keyword_eq(category, &"set"[0: 3]) ||
        command_executor_keyword_eq(category, &"sortedset"[0: 9]) ||
        command_executor_keyword_eq(category, &"list"[0: 4]) ||
        command_executor_keyword_eq(category, &"hash"[0: 4]) ||
        command_executor_keyword_eq(category, &"string"[0: 6]) ||
        command_executor_keyword_eq(category, &"bitmap"[0: 6]) ||
        command_executor_keyword_eq(category, &"hyperloglog"[0: 11]) ||
        command_executor_keyword_eq(category, &"geo"[0: 3]) ||
        command_executor_keyword_eq(category, &"stream"[0: 6]) ||
        command_executor_keyword_eq(category, &"pubsub"[0: 6]) ||
        command_executor_keyword_eq(category, &"admin"[0: 5]) ||
        command_executor_keyword_eq(category, &"fast"[0: 4]) ||
        command_executor_keyword_eq(category, &"slow"[0: 4]) ||
        command_executor_keyword_eq(category, &"blocking"[0: 8]) ||
        command_executor_keyword_eq(category, &"dangerous"[0: 9]) ||
        command_executor_keyword_eq(category, &"connection"[0: 10]) ||
        command_executor_keyword_eq(category, &"transaction"[0: 11]) ||
        command_executor_keyword_eq(category, &"scripting"[0: 9]);
}

fn command_executor_acl_unknown_category(category: &[byte]) CommandReply {
    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR Unknown category '"[0: 22]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, category) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"'"[0: 1]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

