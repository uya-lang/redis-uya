    resp_value_free(&zcard_empty_parsed.value);

    var zadd_lexdel_parsed: RespParseResult = try parse_resp2(&"*10\r\n$4\r\nZADD\r\n$6\r\nlexdel\r\n$1\r\n0\r\n$5\r\nalpha\r\n$1\r\n0\r\n$4\r\nbeta\r\n$1\r\n0\r\n$7\r\ncharlie\r\n$1\r\n0\r\n$5\r\ndelta\r\n"[0: 100]);
