    var bitcount_bad_mode_parsed: RespParseResult = try parse_resp2(&"*5\r\n$8\r\nBITCOUNT\r\n$3\r\nkey\r\n$1\r\n0\r\n$1\r\n0\r\n$3\r\nBAD\r\n"[0: 50]);
    const bitcount_bad_mode_command: Command = try command_executor_test_command(&router, &bitcount_bad_mode_parsed);
    const bitcount_bad_mode_reply: CommandReply = command_execute_at(&engine, &bitcount_bad_mode_command, 1000u64);
    try assert_eq_i32(bitcount_bad_mode_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&bitcount_bad_mode_parsed.value);

