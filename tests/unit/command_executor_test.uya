    try assert_eq_i32(hlen_reply.integer as i32, 2);
    resp_value_free(&hlen_parsed.value);

    var hstrlen_field_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nHSTRLEN\r\n$4\r\nhash\r\n$5\r\nfield\r\n"[0: 38]);
    const hstrlen_field_command: Command = try command_executor_test_command(&router, &hstrlen_field_parsed);
