    const bitpos_zero_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$6\r\nBITPOS\r\n$3\r\nkey\r\n$1\r\n0\r\n"[0: 32], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bitpos_zero_result.response_len], &":0\r\n"[0: 4]));

    const bitpos_one_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$6\r\nBITPOS\r\n$3\r\nkey\r\n$1\r\n1\r\n"[0: 32], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bitpos_one_result.response_len], &":1\r\n"[0: 4]));

    const srca_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$4\r\nsrca\r\n$3\r\nfoo\r\n"[0: 32], &out[0], 256, 1000u64);
