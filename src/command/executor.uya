    return command_executor_slice_eq(name, &"help"[0: 4]) ||
        command_executor_slice_eq(name, &"doctor"[0: 6]) ||
        command_executor_slice_eq(name, &"graph"[0: 5]) ||
        command_executor_slice_eq(name, &"histogram"[0: 9]) ||
        command_executor_slice_eq(name, &"history"[0: 7]) ||
        command_executor_slice_eq(name, &"latest"[0: 6]) ||
        command_executor_slice_eq(name, &"reset"[0: 5]);
}

fn command_executor_command_visible_subcommand(parent_name: &[byte], subcommand_name: &[byte]) bool {
    if command_executor_slice_eq(parent_name, &"client"[0: 6]) {
        return command_executor_command_visible_client_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"cluster"[0: 7]) {
        return command_executor_command_visible_cluster_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"command"[0: 7]) {
        return command_executor_command_visible_command_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"config"[0: 6]) {
        return command_executor_command_visible_config_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"object"[0: 6]) {
        return command_executor_command_visible_object_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"pubsub"[0: 6]) {
        return command_executor_command_visible_pubsub_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"script"[0: 6]) {
        return command_executor_command_visible_script_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"function"[0: 8]) {
        return command_executor_command_visible_function_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"acl"[0: 3]) {
        return command_executor_command_visible_acl_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"memory"[0: 6]) {
        return command_executor_command_visible_memory_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"module"[0: 6]) {
        return command_executor_command_visible_module_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"slowlog"[0: 7]) {
        return command_executor_command_visible_slowlog_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"latency"[0: 7]) {
        return command_executor_command_visible_latency_subcommand(subcommand_name);
    }
    if command_executor_slice_eq(parent_name, &"xgroup"[0: 6]) {
        return command_executor_slice_eq(subcommand_name, &"create"[0: 6]) ||
            command_executor_slice_eq(subcommand_name, &"destroy"[0: 7]) ||
            command_executor_slice_eq(subcommand_name, &"help"[0: 4]) ||
            command_executor_slice_eq(subcommand_name, &"setid"[0: 5]);
    }
    if command_executor_slice_eq(parent_name, &"xinfo"[0: 5]) {
        return command_executor_slice_eq(subcommand_name, &"help"[0: 4]) ||
            command_executor_slice_eq(subcommand_name, &"consumers"[0: 9]) ||
            command_executor_slice_eq(subcommand_name, &"groups"[0: 6]) ||
            command_executor_slice_eq(subcommand_name, &"stream"[0: 6]);
    }
    return false;
}

fn command_executor_command_entry_visible(router: &CommandRouter, entry: &CommandCatalogEntry) bool {
    if entry.is_top_level {
        return command_executor_command_visible_top_level_name(router, entry.name);
    }

    var pipe_index: usize = 0;
    while pipe_index < entry.name.len {
        if entry.name.ptr[pipe_index] == 124 as byte {
            break;
        }
        pipe_index = pipe_index + 1;
    }
    if pipe_index == 0 || pipe_index + 1 >= entry.name.len {
        return false;
    }

    const parent_name: &[byte] = entry.name[0: pipe_index];
    const subcommand_name: &[byte] = entry.name[pipe_index + 1: entry.name.len - pipe_index - 1];
    if !command_executor_command_visible_top_level_name(router, parent_name) {
        return false;
    }
    return command_executor_command_visible_subcommand(parent_name, subcommand_name);
}

fn command_executor_command_visible_top_level_count(router: &CommandRouter) usize {
    var count: usize = 0;
    var index: usize = 0;
    while index < command_catalog_total_count() {
        const entry: CommandCatalogEntry = command_catalog_entry(index) catch {
            return count;
        };
        if entry.is_top_level && command_executor_command_entry_visible(router, &entry) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn command_executor_command_visible_total_count(router: &CommandRouter) usize {
    var count: usize = 0;
    var index: usize = 0;
    while index < command_catalog_total_count() {
        const entry: CommandCatalogEntry = command_catalog_entry(index) catch {
            return count;
        };
        if command_executor_command_entry_visible(router, &entry) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn command_executor_command_subcommand_count(router: &CommandRouter, parent_name: &[byte]) usize {
    var count: usize = 0;
    var index: usize = 0;
    while index < command_catalog_total_count() {
        const entry: CommandCatalogEntry = command_catalog_entry(index) catch {
            return count;
        };
        if entry.is_top_level || entry.name.len <= parent_name.len + 1 {
            index = index + 1;
            continue;
        }
        if command_executor_slice_eq(entry.name[0: parent_name.len], parent_name) &&
            entry.name.ptr[parent_name.len] == 124 as byte &&
            command_executor_command_entry_visible(router, &entry) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn command_executor_command_append_info_payload(buf: &Sds, runtime: &CommandRuntimeInfo, router: &CommandRouter, entry: &CommandCatalogEntry) !void {
    try command_executor_resp_collection_prefix(buf, &"*"[0: 1], 10);
    try command_executor_command_append_bulk(buf, entry.name);
    try command_executor_info_append_i64(buf, &":%i\r\n"[0: 5], entry.arity as i64);
    try command_executor_command_append_tag_sequence(buf, entry.flag_tags, runtime.protocol_version);
    try command_executor_info_append_i64(buf, &":%i\r\n"[0: 5], entry.first_key as i64);
    try command_executor_info_append_i64(buf, &":%i\r\n"[0: 5], entry.last_key as i64);
    try command_executor_info_append_i64(buf, &":%i\r\n"[0: 5], entry.key_step as i64);
    try command_executor_command_append_tag_sequence(buf, entry.acl_tags, runtime.protocol_version);
    try command_executor_command_append_empty_collection(buf, runtime.protocol_version);
    try command_executor_command_append_empty_collection(buf, runtime.protocol_version);

    const subcommand_count: usize = command_executor_command_subcommand_count(router, entry.name);
    if runtime.protocol_version == 3 {
        try command_executor_resp_collection_prefix(buf, &"~"[0: 1], subcommand_count);
    } else {
        try command_executor_resp_collection_prefix(buf, &"*"[0: 1], subcommand_count);
    }
    var index: usize = 0;
    while index < command_catalog_total_count() {
        const subcommand: CommandCatalogEntry = command_catalog_entry(index) catch {
            return;
        };
        if subcommand.is_top_level || subcommand.name.len <= entry.name.len + 1 {
            index = index + 1;
            continue;
        }
        if command_executor_slice_eq(subcommand.name[0: entry.name.len], entry.name) &&
            subcommand.name.ptr[entry.name.len] == 124 as byte &&
            command_executor_command_entry_visible(router, &subcommand) {
            try command_executor_command_append_info_payload(buf, runtime, router, &subcommand);
        }
        index = index + 1;
    }
}

fn command_executor_command_append_docs_payload(buf: &Sds, runtime: &CommandRuntimeInfo, entry: &CommandCatalogEntry) !void {
    try command_executor_command_append_bulk(buf, entry.name);
    if runtime.protocol_version == 3 {
        try command_executor_resp_collection_prefix(buf, &"%"[0: 1], 4);
    } else {
        try command_executor_resp_collection_prefix(buf, &"*"[0: 1], 8);
    }
    try command_executor_command_append_bulk(buf, &"summary"[0: 7]);
    try command_executor_command_append_bulk(buf, entry.summary);
    try command_executor_command_append_bulk(buf, &"since"[0: 5]);
    try command_executor_command_append_bulk(buf, entry.since);
    try command_executor_command_append_bulk(buf, &"group"[0: 5]);
    try command_executor_command_append_bulk(buf, entry.group);
    try command_executor_command_append_bulk(buf, &"complexity"[0: 10]);
    try command_executor_command_append_bulk(buf, entry.complexity);
}

fn command_executor_command_selected_docs_count(router: &CommandRouter, command: &Command) usize {
    var count: usize = 0;
    var index: usize = 2;
    while index < command.argc {
        const name: &[byte] = command_executor_arg(command, index) catch {
            return count;
        };
        var found: bool = true;
        const entry: CommandCatalogEntry = command_catalog_lookup(name) catch {
            found = false;
            CommandCatalogEntry{
                name: command_executor_empty_slice(),
                group: command_executor_empty_slice(),
                module_name: command_executor_empty_slice(),
                acl_tags: command_executor_empty_slice(),
                flag_tags: command_executor_empty_slice(),
                status: CommandCatalogStatus.status_deferred,
                target_version: command_executor_empty_slice(),
                summary: command_executor_empty_slice(),
                since: command_executor_empty_slice(),
                complexity: command_executor_empty_slice(),
                is_pattern: false,
                is_top_level: false,
                arity: 0,
                first_key: 0,
                last_key: 0,
                key_step: 0,
            };
        };
        if found && command_executor_command_entry_visible(router, &entry) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn command_executor_command_info_all(runtime: &CommandRuntimeInfo) CommandReply {
    const router: CommandRouter = command_router_new();
    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }
    _ = command_executor_resp_collection_prefix(&buf, &"*"[0: 1], command_executor_command_visible_top_level_count(&router)) catch {
        return command_executor_oom();
    };

    var index: usize = 0;
    while index < command_catalog_total_count() {
        const entry: CommandCatalogEntry = command_catalog_entry(index) catch {
            return command_executor_error(&"ERR command catalog error"[0: 25]);
        };
        if entry.is_top_level && command_executor_command_entry_visible(&router, &entry) {
            _ = command_executor_command_append_info_payload(&buf, runtime, &router, &entry) catch {
                return command_executor_oom();
            };
        }
        index = index + 1;
    }
    return command_executor_owned_raw(buf.buf[0: buf.len]);
}

fn command_executor_command_info(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    if command.argc == 2 {
        return command_executor_command_info_all(runtime);
    }

    const router: CommandRouter = command_router_new();
    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }
    const result_count: usize = command.argc - 2;
    _ = command_executor_resp_collection_prefix(&buf, &"*"[0: 1], result_count) catch {
        return command_executor_oom();
    };

    var index: usize = 2;
    while index < command.argc {
        const name: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        var found: bool = true;
        const entry: CommandCatalogEntry = command_catalog_lookup(name) catch {
            _ = command_executor_command_append_null(&buf, runtime.protocol_version) catch {
                return command_executor_oom();
            };
            found = false;
            CommandCatalogEntry{
                name: command_executor_empty_slice(),
                group: command_executor_empty_slice(),
                module_name: command_executor_empty_slice(),
                acl_tags: command_executor_empty_slice(),
                flag_tags: command_executor_empty_slice(),
                status: CommandCatalogStatus.status_deferred,
                target_version: command_executor_empty_slice(),
                summary: command_executor_empty_slice(),
                since: command_executor_empty_slice(),
                complexity: command_executor_empty_slice(),
                is_pattern: false,
                is_top_level: false,
                arity: 0,
                first_key: 0,
                last_key: 0,
                key_step: 0,
            };
        };
        if found && command_executor_command_entry_visible(&router, &entry) {
            _ = command_executor_command_append_info_payload(&buf, runtime, &router, &entry) catch {
                return command_executor_oom();
            };
        } else if found {
            _ = command_executor_command_append_null(&buf, runtime.protocol_version) catch {
                return command_executor_oom();
            };
        }
        index = index + 1;
    }
    return command_executor_owned_raw(buf.buf[0: buf.len]);
}

fn command_executor_command_docs(runtime: &CommandRuntimeInfo, command: &Command) CommandReply {
    const router: CommandRouter = command_router_new();
    var pair_count: usize = 0;
    if command.argc == 2 {
        pair_count = command_executor_command_visible_total_count(&router);
    } else if command.argc > 2 {
        pair_count = command_executor_command_selected_docs_count(&router, command);
    }

    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }

    if runtime.protocol_version == 3 {
        _ = command_executor_resp_collection_prefix(&buf, &"%"[0: 1], pair_count) catch {
            return command_executor_oom();
        };
    } else {
        _ = command_executor_resp_collection_prefix(&buf, &"*"[0: 1], pair_count * 2) catch {
            return command_executor_oom();
        };
    }

    if command.argc == 2 {
        var all_index: usize = 0;
        while all_index < command_catalog_total_count() {
            const entry: CommandCatalogEntry = command_catalog_entry(all_index) catch {
                return command_executor_error(&"ERR command catalog error"[0: 25]);
            };
            if command_executor_command_entry_visible(&router, &entry) {
                _ = command_executor_command_append_docs_payload(&buf, runtime, &entry) catch {
                    return command_executor_oom();
                };
            }
            all_index = all_index + 1;
        }
        return command_executor_owned_raw(buf.buf[0: buf.len]);
    }

    var index: usize = 2;
    while index < command.argc {
        const name: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        var found: bool = true;
        const entry: CommandCatalogEntry = command_catalog_lookup(name) catch {
            found = false;
            CommandCatalogEntry{
                name: command_executor_empty_slice(),
                group: command_executor_empty_slice(),
                module_name: command_executor_empty_slice(),
                acl_tags: command_executor_empty_slice(),
                flag_tags: command_executor_empty_slice(),
                status: CommandCatalogStatus.status_deferred,
                target_version: command_executor_empty_slice(),
                summary: command_executor_empty_slice(),
                since: command_executor_empty_slice(),
                complexity: command_executor_empty_slice(),
                is_pattern: false,
                is_top_level: false,
                arity: 0,
                first_key: 0,
                last_key: 0,
                key_step: 0,
            };
        };
        if found && command_executor_command_entry_visible(&router, &entry) {
            _ = command_executor_command_append_docs_payload(&buf, runtime, &entry) catch {
                return command_executor_oom();
            };
        }
        index = index + 1;
    }
    return command_executor_owned_raw(buf.buf[0: buf.len]);
}

fn command_executor_command_list_matches_filter(entry: &CommandCatalogEntry, filter_kind: &[byte], filter_value: &[byte]) bool {
    if filter_kind.len == 0 {
        return true;
    }
    if command_executor_keyword_eq(filter_kind, &"MODULE"[0: 6]) {
        return command_catalog_matches_module(entry, filter_value);
    }
    if command_executor_keyword_eq(filter_kind, &"ACLCAT"[0: 6]) {
        return command_catalog_has_acl_category(entry, filter_value);
    }
    if command_executor_keyword_eq(filter_kind, &"PATTERN"[0: 7]) {
        return command_catalog_matches_pattern(entry, filter_value);
    }
    return false;
}

fn command_executor_command_list(command: &Command) CommandReply {
    const router: CommandRouter = command_router_new();
    var filter_kind: &[byte] = command_executor_empty_slice();
    var filter_value: &[byte] = command_executor_empty_slice();
    if command.argc != 2 {
        if command.argc != 5 {
            return command_executor_syntax_error();
        }
        const filterby: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(filterby, &"FILTERBY"[0: 8]) {
            return command_executor_syntax_error();
        }
        filter_kind = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
        filter_value = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        if !(command_executor_keyword_eq(filter_kind, &"MODULE"[0: 6]) ||
            command_executor_keyword_eq(filter_kind, &"ACLCAT"[0: 6]) ||
            command_executor_keyword_eq(filter_kind, &"PATTERN"[0: 7])) {
            return command_executor_syntax_error();
        }
    }

    var match_count: usize = 0;
    var index: usize = 0;
    while index < command_catalog_total_count() {
        const entry: CommandCatalogEntry = command_catalog_entry(index) catch {
            return command_executor_error(&"ERR command catalog error"[0: 25]);
        };
        if command_executor_command_entry_visible(&router, &entry) &&
            command_executor_command_list_matches_filter(&entry, filter_kind, filter_value) {
            match_count = match_count + 1;
        }
        index = index + 1;
    }

    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }
    _ = command_executor_resp_collection_prefix(&buf, &"*"[0: 1], match_count) catch {
        return command_executor_oom();
    };

    index = 0;
    while index < command_catalog_total_count() {
        const entry: CommandCatalogEntry = command_catalog_entry(index) catch {
            return command_executor_error(&"ERR command catalog error"[0: 25]);
        };
        if command_executor_command_entry_visible(&router, &entry) &&
            command_executor_command_list_matches_filter(&entry, filter_kind, filter_value) {
            _ = command_executor_info_append(&buf, &"$"[0: 1]) catch {
                return command_executor_oom();
            };
            _ = command_executor_info_append_u64(&buf, &"%u"[0: 2], entry.name.len as u64) catch {
                return command_executor_oom();
            };
            _ = command_executor_info_append(&buf, &"\r\n"[0: 2]) catch {
                return command_executor_oom();
            };
            _ = command_executor_info_append(&buf, entry.name) catch {
                return command_executor_oom();
            };
            _ = command_executor_info_append(&buf, &"\r\n"[0: 2]) catch {
                return command_executor_oom();
            };
        }
        index = index + 1;
    }
    return command_executor_owned_raw(buf.buf[0: buf.len]);
}

fn command_executor_command_invalid_command() CommandReply {
    return command_executor_error(&"ERR Invalid command specified"[0: 29]);
}

fn command_executor_command_invalid_command_arity() CommandReply {
    return command_executor_error(&"ERR Invalid number of arguments specified for command"[0: 53]);
}

fn command_executor_command_wrong_subcommand_arity(subcommand: &[byte]) CommandReply {
    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }
    _ = command_executor_info_append(&buf, &"ERR wrong number of arguments for 'command|"[0: 43]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&buf, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&buf, &"' command"[0: 9]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(buf.buf[0: buf.len]);
}

fn command_executor_command_full_arg(command: &Command, index: usize) !&[byte] {
    return command_executor_arg(command, index + 2);
}

fn command_executor_command_full_argc(command: &Command) usize {
    if command.argc < 2 {
        return 0;
    }
    return command.argc - 2;
}

fn command_executor_command_lookup_full_command(command: &Command) !CommandInfo {
    const full_name: &[byte] = try command_executor_command_full_arg(command, 0);
    const router: CommandRouter = command_router_new();
    const info: CommandInfo = try command_router_lookup(&router, full_name);
    try command_validate_arity(&info, command_executor_command_full_argc(command));
    return info;
}

fn command_executor_command_count_range_keys(info: &CommandInfo, full_argc: usize) usize {
    if info.first_key <= 0 || info.key_step <= 0 {
        return 0;
    }
    var last_index: i32 = info.last_key;
    if info.last_key < 0 {
        last_index = full_argc as i32 + info.last_key;
    }
    if last_index < info.first_key {
        return 0;
    }
    return (((last_index - info.first_key) / info.key_step) + 1) as usize;
}

fn command_executor_command_eval_numkeys(command: &Command) !usize {
    const full_argc: usize = command_executor_command_full_argc(command);
    if full_argc < 3 {
        return error.CommandWrongArity;
    }
    const numkeys_data: &[byte] = try command_executor_command_full_arg(command, 2);
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return error.CommandWrongArity;
    };
    if numkeys_i64 <= 0 {
        return error.CommandWrongArity;
    }
    const numkeys: usize = numkeys_i64 as usize;
    if full_argc < 3 + numkeys {
        return error.CommandWrongArity;
    }
    return numkeys;
}

fn command_executor_command_fcall_numkeys(command: &Command) !usize {
    const full_argc: usize = command_executor_command_full_argc(command);
    if full_argc < 3 {
        return error.CommandWrongArity;
    }
    const numkeys_data: &[byte] = try command_executor_command_full_arg(command, 2);
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return error.CommandWrongArity;
    };
    if numkeys_i64 < 0 {
        return error.CommandWrongArity;
    }
    const numkeys: usize = numkeys_i64 as usize;
    if full_argc < 3 + numkeys {
        return error.CommandWrongArity;
    }
    return numkeys;
}

fn command_executor_command_memory_usage_has_key(command: &Command) !bool {
    const full_argc: usize = command_executor_command_full_argc(command);
    if full_argc < 2 {
        return error.CommandWrongArity;
    }
    const subcommand: &[byte] = try command_executor_command_full_arg(command, 1);
    if !command_executor_keyword_eq(subcommand, &"USAGE"[0: 5]) {
        return false;
    }
    if full_argc == 3 {
        return true;
    }
    if full_argc != 5 {
        return error.CommandWrongArity;
    }
    const token: &[byte] = try command_executor_command_full_arg(command, 3);
    if !command_executor_keyword_eq(token, &"SAMPLES"[0: 7]) {
        return error.CommandWrongArity;
    }
    const samples_i64: i64 = command_executor_parse_i64((command_executor_command_full_arg(command, 4) catch {
        return error.CommandWrongArity;
    })) catch {
        return error.CommandWrongArity;
    };
    if samples_i64 < 0 {
        return error.CommandWrongArity;
    }
    return true;
}

fn command_executor_command_sort_store_index(command: &Command) !i32 {
    const full_argc: usize = command_executor_command_full_argc(command);
    if full_argc < 2 {
        return error.CommandWrongArity;
    }

    var index: usize = 2;
    var store_index: i32 = -1;
    while index < full_argc {
        const token: &[byte] = try command_executor_command_full_arg(command, index);
        if command_executor_keyword_eq(token, &"ASC"[0: 3]) ||
            command_executor_keyword_eq(token, &"DESC"[0: 4]) ||
            command_executor_keyword_eq(token, &"ALPHA"[0: 5]) {
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"BY"[0: 2]) ||
            command_executor_keyword_eq(token, &"GET"[0: 3]) {
            if index + 1 >= full_argc {
                return error.CommandWrongArity;
            }
            index = index + 2;
            continue;
        }
        if command_executor_keyword_eq(token, &"LIMIT"[0: 5]) {
            if index + 2 >= full_argc {
                return error.CommandWrongArity;
            }
            index = index + 3;
            continue;
        }
        if command_executor_keyword_eq(token, &"STORE"[0: 5]) {
            if index + 1 >= full_argc {
                return error.CommandWrongArity;
            }
            store_index = (index + 1) as i32;
            index = index + 2;
            continue;
        }
        return error.CommandWrongArity;
    }
    return store_index;
}

fn command_executor_command_key_flags(info: &CommandInfo, key_ordinal: usize) &[byte] {
    if info.cmd_type == CommandType.command_type ||
        info.cmd_type == CommandType.command_exists ||
        info.cmd_type == CommandType.command_object ||
        info.cmd_type == CommandType.command_watch ||
        info.cmd_type == CommandType.command_scard ||
        info.cmd_type == CommandType.command_sismember ||
        info.cmd_type == CommandType.command_smismember ||
        info.cmd_type == CommandType.command_touch {
        return &"RO"[0: 2];
    }
    if info.cmd_type == CommandType.command_del ||
        info.cmd_type == CommandType.command_delex {
        return &"RM|delete"[0: 9];
    }
    if info.cmd_type == CommandType.command_unlink {
        return &"RM|delete"[0: 9];
    }
    if info.cmd_type == CommandType.command_rename || info.cmd_type == CommandType.command_renamenx || info.cmd_type == CommandType.command_copy {
        if key_ordinal == 0 {
            if info.cmd_type == CommandType.command_copy {
                return &"RO|access"[0: 9];
            }
            return &"RW|access|delete"[0: 16];
        }
        return &"OW|update"[0: 9];
    }
    if info.cmd_type == CommandType.command_bitop {
        if key_ordinal == 0 {
            return &"OW|update"[0: 9];
        }
        return &"RO|access"[0: 9];
    }
    if info.cmd_type == CommandType.command_bitfield {
        return &"RW|access|update"[0: 16];
    }
    if info.cmd_type == CommandType.command_pfmerge {
        if key_ordinal == 0 {
            return &"OW|update"[0: 9];
        }
        return &"RO|access"[0: 9];
    }
    if info.cmd_type == CommandType.command_lmove ||
        info.cmd_type == CommandType.command_blmove ||
        info.cmd_type == CommandType.command_rpoplpush ||
        info.cmd_type == CommandType.command_brpoplpush {
        if key_ordinal == 0 {
            return &"RW|access|delete"[0: 16];
        }
        return &"RW|insert"[0: 9];
    }
    if info.cmd_type == CommandType.command_lmpop ||
        info.cmd_type == CommandType.command_blmpop {
        return &"RW|access|delete"[0: 16];
    }
    if info.cmd_type == CommandType.command_zmpop ||
        info.cmd_type == CommandType.command_bzmpop {
        return &"RW|access|delete"[0: 16];
    }
    if info.cmd_type == CommandType.command_sinterstore {
        if key_ordinal == 0 {
            return &"RW|update"[0: 9];
        }
        return &"RO|access"[0: 9];
    }
    if info.cmd_type == CommandType.command_sdiffstore || info.cmd_type == CommandType.command_sunionstore {
        if key_ordinal == 0 {
            return &"OW|update"[0: 9];
        }
        return &"RO|access"[0: 9];
    }
    if info.cmd_type == CommandType.command_getdel ||
        info.cmd_type == CommandType.command_hgetdel ||
        info.cmd_type == CommandType.command_move ||
        info.cmd_type == CommandType.command_lpop ||
        info.cmd_type == CommandType.command_blpop ||
        info.cmd_type == CommandType.command_rpop ||
        info.cmd_type == CommandType.command_brpop ||
        info.cmd_type == CommandType.command_spop ||
        info.cmd_type == CommandType.command_bzpopmax ||
        info.cmd_type == CommandType.command_bzpopmin ||
        info.cmd_type == CommandType.command_zpopmax ||
        info.cmd_type == CommandType.command_zpopmin {
        return &"RW|access|delete"[0: 16];
    }
    if info.cmd_type == CommandType.command_getset ||
        info.cmd_type == CommandType.command_getex ||
        info.cmd_type == CommandType.command_incr ||
        info.cmd_type == CommandType.command_decr ||
        info.cmd_type == CommandType.command_incrby ||
        info.cmd_type == CommandType.command_decrby ||
        info.cmd_type == CommandType.command_incrbyfloat ||
        info.cmd_type == CommandType.command_hincrby ||
        info.cmd_type == CommandType.command_hincrbyfloat ||
        info.cmd_type == CommandType.command_zincrby {
        return &"RW|access|update"[0: 16];
    }
    if info.cmd_type == CommandType.command_append ||
        info.cmd_type == CommandType.command_setbit ||
        info.cmd_type == CommandType.command_lpush ||
        info.cmd_type == CommandType.command_rpush ||
        info.cmd_type == CommandType.command_linsert ||
        info.cmd_type == CommandType.command_lpushx ||
        info.cmd_type == CommandType.command_rpushx ||
        info.cmd_type == CommandType.command_sadd {
        return &"RW|insert"[0: 9];
    }
    if info.cmd_type == CommandType.command_setnx ||
        info.cmd_type == CommandType.command_msetnx ||
        info.cmd_type == CommandType.command_hsetnx {
        return &"OW|insert"[0: 9];
    }
    if info.cmd_type == CommandType.command_ltrim ||
        info.cmd_type == CommandType.command_lrem ||
        info.cmd_type == CommandType.command_hdel ||
        info.cmd_type == CommandType.command_srem ||
        info.cmd_type == CommandType.command_zrem ||
        info.cmd_type == CommandType.command_zremrangebylex ||
        info.cmd_type == CommandType.command_zremrangebyrank ||
        info.cmd_type == CommandType.command_zremrangebyscore {
        return &"RW|delete"[0: 9];
    }
    if info.cmd_type == CommandType.command_expire ||
        info.cmd_type == CommandType.command_expireat ||
        info.cmd_type == CommandType.command_pexpire ||
        info.cmd_type == CommandType.command_persist ||
        info.cmd_type == CommandType.command_pexpireat ||
        info.cmd_type == CommandType.command_lset ||
        info.cmd_type == CommandType.command_hset ||
        info.cmd_type == CommandType.command_zadd {
        return &"RW|update"[0: 9];
    }
    if info.cmd_type == CommandType.command_set ||
        info.cmd_type == CommandType.command_setex ||
        info.cmd_type == CommandType.command_psetex ||
        info.cmd_type == CommandType.command_mset ||
        info.cmd_type == CommandType.command_setrange ||
        info.cmd_type == CommandType.command_restore {
        return &"OW|update"[0: 9];
    }
    if info.flags == 0u64 {
        return command_executor_empty_slice();
    }
    return &"RO|access"[0: 9];
}

fn command_executor_command_append_getkeys_key(buf: &Sds, key: &[byte]) !void {
    try command_executor_command_append_bulk(buf, key);
}

fn command_executor_command_append_getkeysandflags_item(
    buf: &Sds,
    key: &[byte],
    flag_tags: &[byte],
    protocol_version: i32,
) !void {
    try command_executor_resp_collection_prefix(buf, &"*"[0: 1], 2);
    try command_executor_command_append_bulk(buf, key);
    try command_executor_command_append_tag_sequence(buf, flag_tags, protocol_version);
}

fn command_executor_command_getkeys_generic(info: &CommandInfo, command: &Command, buf: &Sds) !void {
    const full_argc: usize = command_executor_command_full_argc(command);
    const key_count: usize = command_executor_command_count_range_keys(info, full_argc);
    try command_executor_resp_collection_prefix(buf, &"*"[0: 1], key_count);
    if key_count == 0 {
        return;
    }
    var last_index: i32 = info.last_key;
    if info.last_key < 0 {
        last_index = full_argc as i32 + info.last_key;
    }
    var key_index: i32 = info.first_key;
    while key_index <= last_index {
        const key: &[byte] = try command_executor_command_full_arg(command, key_index as usize);
        try command_executor_command_append_getkeys_key(buf, key);
        key_index = key_index + info.key_step;
    }
}

fn command_executor_command_getkeysandflags_generic(
    runtime: &CommandRuntimeInfo,
    info: &CommandInfo,
    command: &Command,
    buf: &Sds,
) !void {
    const full_argc: usize = command_executor_command_full_argc(command);
    const key_count: usize = command_executor_command_count_range_keys(info, full_argc);
    try command_executor_resp_collection_prefix(buf, &"*"[0: 1], key_count);
    if key_count == 0 {
        return;
    }
    var last_index: i32 = info.last_key;
    if info.last_key < 0 {
        last_index = full_argc as i32 + info.last_key;
    }
    var key_index: i32 = info.first_key;
    var key_ordinal: usize = 0;
    while key_index <= last_index {
        const key: &[byte] = try command_executor_command_full_arg(command, key_index as usize);
        try command_executor_command_append_getkeysandflags_item(buf, key, command_executor_command_key_flags(info, key_ordinal), runtime.protocol_version);
        key_ordinal = key_ordinal + 1;
        key_index = key_index + info.key_step;
    }
}

fn command_executor_command_getkeys_sort(command: &Command, buf: &Sds) !void {
    const store_index: i32 = try command_executor_command_sort_store_index(command);
    if store_index >= 0 {
        try command_executor_resp_collection_prefix(buf, &"*"[0: 1], 2);
    } else {
        try command_executor_resp_collection_prefix(buf, &"*"[0: 1], 1);
    }
    const source: &[byte] = try command_executor_command_full_arg(command, 1);
    try command_executor_command_append_getkeys_key(buf, source);
    if store_index >= 0 {
        const destination: &[byte] = try command_executor_command_full_arg(command, store_index as usize);
        try command_executor_command_append_getkeys_key(buf, destination);
    }
}

fn command_executor_command_getkeysandflags_sort(runtime: &CommandRuntimeInfo, command: &Command, buf: &Sds) !void {
    const store_index: i32 = try command_executor_command_sort_store_index(command);
    if store_index >= 0 {
        try command_executor_resp_collection_prefix(buf, &"*"[0: 1], 2);
    } else {
        try command_executor_resp_collection_prefix(buf, &"*"[0: 1], 1);
    }
    const source: &[byte] = try command_executor_command_full_arg(command, 1);
    try command_executor_command_append_getkeysandflags_item(buf, source, &"RO|access"[0: 9], runtime.protocol_version);
    if store_index >= 0 {
        const destination: &[byte] = try command_executor_command_full_arg(command, store_index as usize);
        try command_executor_command_append_getkeysandflags_item(buf, destination, &"OW|update"[0: 9], runtime.protocol_version);
    }
}

fn command_executor_command_lmpop_numkeys(command: &Command) !usize {
    const full_argc: usize = command_executor_command_full_argc(command);
    if full_argc < 4 {
        return error.CommandWrongArity;
    }
    const numkeys_data: &[byte] = try command_executor_command_full_arg(command, 1);
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return error.CommandWrongArity;
    };
    if numkeys_i64 <= 0 {
        return error.CommandWrongArity;
    }
    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 2 + numkeys;
    if full_argc <= keys_end {
        return error.CommandWrongArity;
    }
    return numkeys;
}

fn command_executor_command_getkeys_lmpop(command: &Command, buf: &Sds) !void {
    const numkeys: usize = try command_executor_command_lmpop_numkeys(command);
    try command_executor_resp_collection_prefix(buf, &"*"[0: 1], numkeys);
    var key_index: usize = 2;
    while key_index < 2 + numkeys {
        const key: &[byte] = try command_executor_command_full_arg(command, key_index);
        try command_executor_command_append_getkeys_key(buf, key);
        key_index = key_index + 1;
    }
}

