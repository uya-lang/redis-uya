fn command_executor_memory_purge() CommandReply {
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_memory_usage(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_memory_wrong_subcommand_arity(&"usage"[0: 5]);
    }
    if command.argc != 3 && command.argc != 5 {
        return command_executor_syntax_error();
    }
    if command.argc == 5 {
        const token: &[byte] = command_executor_arg(command, 3) catch {
            return command_executor_syntax_error();
        };
        if !command_executor_keyword_eq(token, &"SAMPLES"[0: 7]) {
            return command_executor_syntax_error();
        }
        const samples_i64: i64 = command_executor_parse_i64((command_executor_arg(command, 4) catch {
            return command_executor_invalid_integer();
        })) catch {
            return command_executor_invalid_integer();
        };
        if samples_i64 < 0 {
            return command_executor_syntax_error();
        }
    }

    const key: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_memory_wrong_subcommand_arity(&"usage"[0: 5]);
    };
    const obj: &RedisObject = lookup_key_no_touch_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    return command_executor_integer(command_executor_memory_object_usage(obj) as i64);
}

fn command_executor_memory(runtime: &CommandRuntimeInfo, engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    _ = runtime;
    if command.argc < 2 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'memory' command"[0: 48]);
    }

    const subcommand: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'memory' command"[0: 48]);
    };
    if command_executor_keyword_eq(subcommand, &"HELP"[0: 4]) {
        if command.argc != 2 {
            return command_executor_memory_wrong_subcommand_arity(&"help"[0: 4]);
        }
        return command_executor_memory_help();
    }
    if command_executor_keyword_eq(subcommand, &"DOCTOR"[0: 6]) {
        if command.argc != 2 {
            return command_executor_memory_wrong_subcommand_arity(&"doctor"[0: 6]);
        }
        return command_executor_memory_doctor(engine);
    }
    if command_executor_keyword_eq(subcommand, &"STATS"[0: 5]) {
        if command.argc != 2 {
            return command_executor_memory_wrong_subcommand_arity(&"stats"[0: 5]);
        }
        return command_executor_memory_stats(engine, runtime);
    }
    if command_executor_keyword_eq(subcommand, &"MALLOC-STATS"[0: 12]) {
        if command.argc != 2 {
            return command_executor_memory_wrong_subcommand_arity(&"malloc-stats"[0: 12]);
        }
        return command_executor_memory_malloc_stats();
    }
    if command_executor_keyword_eq(subcommand, &"PURGE"[0: 5]) {
        if command.argc != 2 {
            return command_executor_memory_wrong_subcommand_arity(&"purge"[0: 5]);
        }
        return command_executor_memory_purge();
    }
    if command_executor_keyword_eq(subcommand, &"USAGE"[0: 5]) {
        return command_executor_memory_usage(engine, command, now_ms);
    }

    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR unknown subcommand '"[0: 24]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"'. Try MEMORY HELP."[0: 19]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

