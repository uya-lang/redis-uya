    const flushdb_command: Command = try command_executor_test_command(&router, &flushdb_parsed);
    const flushdb_reply: CommandReply = command_execute_at(&engine, &flushdb_command, 1000u64);
    try assert_eq_i32(flushdb_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(flushdb_reply.data, &"OK"[0: 2]));
    try assert_eq_i32(engine_len(&engine) as i32, 0);
    resp_value_free(&flushdb_parsed.value);

    var set_c_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$1\r\nc\r\n$1\r\n3\r\n"[0: 29]);
    const set_c_command: Command = try command_executor_test_command(&router, &set_c_parsed);
    _ = command_execute_at(&engine, &set_c_command, 1000u64);
    resp_value_free(&set_c_parsed.value);

    var flushall_parsed: RespParseResult = try parse_resp2(&"*1\r\n$8\r\nFLUSHALL\r\n"[0: 18]);
    const flushall_command: Command = try command_executor_test_command(&router, &flushall_parsed);
    const flushall_reply: CommandReply = command_execute_at(&engine, &flushall_command, 1000u64);
    try assert_eq_i32(flushall_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(flushall_reply.data, &"OK"[0: 2]));
    try assert_eq_i32(engine_len(&engine) as i32, 0);
    resp_value_free(&flushall_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_dump() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$4\r\nkey1\r\n$5\r\nvalue\r\n"[0: 34]);
    const set_command: Command = try command_executor_test_command(&router, &set_parsed);
    _ = command_execute_at(&engine, &set_command, 1000u64);
    resp_value_free(&set_parsed.value);

    var dump_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nDUMP\r\n$4\r\nkey1\r\n"[0: 25]);
    const dump_command: Command = try command_executor_test_command(&router, &dump_parsed);
    const dump_reply: CommandReply = command_execute_at(&engine, &dump_command, 1000u64);
    try assert_eq_i32(dump_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(dump_reply.data[0: 8], &"RUYARDB1"[0: 8]));
    command_reply_cleanup(&dump_reply);
    resp_value_free(&dump_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_select_and_object() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    var out: [byte: 512] = [];

    var set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$4\r\nokey\r\n$5\r\nvalue\r\n"[0: 34]);
    const set_command: Command = try command_executor_test_command(&router, &set_parsed);
    _ = command_execute_with_runtime_at(&engine, &runtime, &set_command, 1000u64);
    resp_value_free(&set_parsed.value);

    var select_zero_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nSELECT\r\n$1\r\n0\r\n"[0: 23]);
    const select_zero_command: Command = try command_executor_test_command(&router, &select_zero_parsed);
    const select_zero_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &select_zero_command, 1000u64);
    try assert_eq_i32(select_zero_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(select_zero_reply.data, &"OK"[0: 2]));
    resp_value_free(&select_zero_parsed.value);

    var select_bad_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nSELECT\r\n$1\r\n1\r\n"[0: 23]);
    const select_bad_command: Command = try command_executor_test_command(&router, &select_bad_parsed);
    const select_bad_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &select_bad_command, 1000u64);
    try assert_eq_i32(select_bad_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(select_bad_reply.data, &"ERR DB index is out of range"[0: 28]));
    resp_value_free(&select_bad_parsed.value);

    var object_encoding_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nOBJECT\r\n$8\r\nENCODING\r\n$4\r\nokey\r\n"[0: 40]);
    const object_encoding_command: Command = try command_executor_test_command(&router, &object_encoding_parsed);
    const object_encoding_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &object_encoding_command, 3500u64);
    try assert_eq_i32(object_encoding_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(object_encoding_reply.data, &"raw"[0: 3]));
    resp_value_free(&object_encoding_parsed.value);

    var object_refcount_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nOBJECT\r\n$8\r\nREFCOUNT\r\n$4\r\nokey\r\n"[0: 40]);
    const object_refcount_command: Command = try command_executor_test_command(&router, &object_refcount_parsed);
    const object_refcount_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &object_refcount_command, 3500u64);
    try assert_eq_i32(object_refcount_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(object_refcount_reply.integer as i32, 1);
    resp_value_free(&object_refcount_parsed.value);

    var object_idletime_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nOBJECT\r\n$8\r\nIDLETIME\r\n$4\r\nokey\r\n"[0: 40]);
    const object_idletime_command: Command = try command_executor_test_command(&router, &object_idletime_parsed);
    const object_idletime_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &object_idletime_command, 3500u64);
    try assert_eq_i32(object_idletime_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(object_idletime_reply.integer as i32, 2);
    resp_value_free(&object_idletime_parsed.value);

    var object_freq_err_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nOBJECT\r\n$4\r\nFREQ\r\n$4\r\nokey\r\n"[0: 36]);
    const object_freq_err_command: Command = try command_executor_test_command(&router, &object_freq_err_parsed);
    const object_freq_err_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &object_freq_err_command, 3500u64);
    try assert_eq_i32(object_freq_err_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_contains(object_freq_err_reply.data, &"LFU maxmemory policy is not selected"[0: 36]));
    resp_value_free(&object_freq_err_parsed.value);

    runtime.config.maxmemory_policy = MaxmemoryPolicy.maxmemory_allkeys_lfu;

    var object_freq_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nOBJECT\r\n$4\r\nFREQ\r\n$4\r\nokey\r\n"[0: 36]);
    const object_freq_command: Command = try command_executor_test_command(&router, &object_freq_parsed);
    const object_freq_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &object_freq_command, 3600u64);
    try assert_eq_i32(object_freq_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(object_freq_reply.integer as i32, 1);
    resp_value_free(&object_freq_parsed.value);

    var get_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nGET\r\n$4\r\nokey\r\n"[0: 23]);
    const get_command: Command = try command_executor_test_command(&router, &get_parsed);
    _ = command_execute_with_runtime_at(&engine, &runtime, &get_command, 4000u64);
    resp_value_free(&get_parsed.value);

    var object_freq_after_get_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nOBJECT\r\n$4\r\nFREQ\r\n$4\r\nokey\r\n"[0: 36]);
    const object_freq_after_get_command: Command = try command_executor_test_command(&router, &object_freq_after_get_parsed);
    const object_freq_after_get_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &object_freq_after_get_command, 4000u64);
    try assert_eq_i32(object_freq_after_get_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(object_freq_after_get_reply.integer as i32, 2);
    resp_value_free(&object_freq_after_get_parsed.value);

    var object_idletime_lfu_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nOBJECT\r\n$8\r\nIDLETIME\r\n$4\r\nokey\r\n"[0: 40]);
    const object_idletime_lfu_command: Command = try command_executor_test_command(&router, &object_idletime_lfu_parsed);
    const object_idletime_lfu_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &object_idletime_lfu_command, 4000u64);
    try assert_eq_i32(object_idletime_lfu_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_contains(object_idletime_lfu_reply.data, &"LFU maxmemory policy is selected"[0: 32]));
    resp_value_free(&object_idletime_lfu_parsed.value);

    runtime.config.maxmemory_policy = MaxmemoryPolicy.maxmemory_noeviction;

    var get_refresh_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nGET\r\n$4\r\nokey\r\n"[0: 23]);
    const get_refresh_command: Command = try command_executor_test_command(&router, &get_refresh_parsed);
    _ = command_execute_with_runtime_at(&engine, &runtime, &get_refresh_command, 6000u64);
    resp_value_free(&get_refresh_parsed.value);

    var object_idletime_after_get_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nOBJECT\r\n$8\r\nIDLETIME\r\n$4\r\nokey\r\n"[0: 40]);
    const object_idletime_after_get_command: Command = try command_executor_test_command(&router, &object_idletime_after_get_parsed);
    const object_idletime_after_get_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &object_idletime_after_get_command, 6500u64);
    try assert_eq_i32(object_idletime_after_get_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(object_idletime_after_get_reply.integer as i32, 0);
    resp_value_free(&object_idletime_after_get_parsed.value);

    var object_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nOBJECT\r\n$8\r\nENCODING\r\n$7\r\nmissing\r\n"[0: 43]);
    const object_missing_command: Command = try command_executor_test_command(&router, &object_missing_parsed);
    const object_missing_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &object_missing_command, 6500u64);
    try assert_eq_i32(object_missing_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&object_missing_parsed.value);

    var object_help_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nOBJECT\r\n$4\r\nHELP\r\n"[0: 26]);
    const object_help_command: Command = try command_executor_test_command(&router, &object_help_parsed);
    var object_help_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &object_help_command, 6500u64);
    const object_help_len: usize = try connection_encode_reply(&object_help_reply, &out[0], 512);
    try assert_true(command_executor_test_contains(out[0: object_help_len], &"OBJECT ENCODING <key>"[0: 21]));
    try assert_true(command_executor_test_contains(out[0: object_help_len], &"OBJECT HELP"[0: 11]));
    command_reply_cleanup(&object_help_reply);
    resp_value_free(&object_help_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_memory() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    var out: [byte: 1024] = [];

    var memory_help_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nMEMORY\r\n$4\r\nHELP\r\n"[0: 26]);
    const memory_help_command: Command = try command_executor_test_command(&router, &memory_help_parsed);
    var memory_help_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &memory_help_command, 1000u64);
    const memory_help_len: usize = try connection_encode_reply(&memory_help_reply, &out[0], 1024);
    try assert_true(command_executor_test_contains(out[0: memory_help_len], &"MEMORY USAGE <key> [SAMPLES <count>]"[0: 36]));
    try assert_true(command_executor_test_contains(out[0: memory_help_len], &"MEMORY MALLOC-STATS"[0: 19]));
    try assert_true(command_executor_test_contains(out[0: memory_help_len], &"MEMORY PURGE"[0: 12]));
    try assert_true(command_executor_test_contains(out[0: memory_help_len], &"MEMORY HELP"[0: 11]));
    command_reply_cleanup(&memory_help_reply);
    resp_value_free(&memory_help_parsed.value);

    var memory_doctor_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nMEMORY\r\n$6\r\nDOCTOR\r\n"[0: 28]);
    const memory_doctor_command: Command = try command_executor_test_command(&router, &memory_doctor_parsed);
    var memory_doctor_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &memory_doctor_command, 1000u64);
    try assert_eq_i32(memory_doctor_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_contains(memory_doctor_reply.data, &"too small for a useful diagnosis"[0: 32]));
    command_reply_cleanup(&memory_doctor_reply);
    resp_value_free(&memory_doctor_parsed.value);

    var set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$4\r\nmkey\r\n$5\r\nvalue\r\n"[0: 34]);
    const set_command: Command = try command_executor_test_command(&router, &set_parsed);
    _ = command_execute_with_runtime_at(&engine, &runtime, &set_command, 1000u64);
    resp_value_free(&set_parsed.value);

    var memory_usage_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nMEMORY\r\n$5\r\nUSAGE\r\n$4\r\nmkey\r\n"[0: 37]);
    const memory_usage_command: Command = try command_executor_test_command(&router, &memory_usage_parsed);
    const memory_usage_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &memory_usage_command, 1000u64);
    try assert_eq_i32(memory_usage_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_true(memory_usage_reply.integer > 0);
    resp_value_free(&memory_usage_parsed.value);

    var memory_usage_samples_parsed: RespParseResult = try parse_resp2(&"*5\r\n$6\r\nMEMORY\r\n$5\r\nUSAGE\r\n$4\r\nmkey\r\n$7\r\nSAMPLES\r\n$1\r\n0\r\n"[0: 57]);
    const memory_usage_samples_command: Command = try command_executor_test_command(&router, &memory_usage_samples_parsed);
    const memory_usage_samples_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &memory_usage_samples_command, 1000u64);
    try assert_eq_i32(memory_usage_samples_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_true(memory_usage_samples_reply.integer > 0);
    resp_value_free(&memory_usage_samples_parsed.value);

    var memory_usage_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nMEMORY\r\n$5\r\nUSAGE\r\n$7\r\nmissing\r\n"[0: 40]);
    const memory_usage_missing_command: Command = try command_executor_test_command(&router, &memory_usage_missing_parsed);
    const memory_usage_missing_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &memory_usage_missing_command, 1000u64);
    try assert_eq_i32(memory_usage_missing_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    resp_value_free(&memory_usage_missing_parsed.value);

    var memory_stats_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nMEMORY\r\n$5\r\nSTATS\r\n"[0: 27]);
    const memory_stats_command: Command = try command_executor_test_command(&router, &memory_stats_parsed);
    var memory_stats_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &memory_stats_command, 1000u64);
    try assert_eq_i32(memory_stats_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_contains(memory_stats_reply.data, &"$11\r\nused_memory\r\n"[0: 18]));
    try assert_true(command_executor_test_contains(memory_stats_reply.data, &"$16\r\nmaxmemory_policy\r\n"[0: 23]));
    try assert_true(command_executor_test_contains(memory_stats_reply.data, &"$10\r\nkeys.count\r\n"[0: 17]));
    command_reply_cleanup(&memory_stats_reply);
    resp_value_free(&memory_stats_parsed.value);

    var memory_malloc_stats_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nMEMORY\r\n$12\r\nMALLOC-STATS\r\n"[0: 35]);
    const memory_malloc_stats_command: Command = try command_executor_test_command(&router, &memory_malloc_stats_parsed);
    var memory_malloc_stats_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &memory_malloc_stats_command, 1000u64);
    try assert_eq_i32(memory_malloc_stats_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_contains(memory_malloc_stats_reply.data, &"redis-uya allocator stats"[0: 25]));
    try assert_true(command_executor_test_contains(memory_malloc_stats_reply.data, &"allocator_slab_cached_bytes"[0: 27]));
    command_reply_cleanup(&memory_malloc_stats_reply);
    resp_value_free(&memory_malloc_stats_parsed.value);

    var memory_purge_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nMEMORY\r\n$5\r\nPURGE\r\n"[0: 27]);
    const memory_purge_command: Command = try command_executor_test_command(&router, &memory_purge_parsed);
    const memory_purge_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &memory_purge_command, 1000u64);
    try assert_eq_i32(memory_purge_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(memory_purge_reply.data, &"OK"[0: 2]));
    resp_value_free(&memory_purge_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_module() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 4096] = [];

    var module_help_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nMODULE\r\n$4\r\nHELP\r\n"[0: 26]);
    const module_help_command: Command = try command_executor_test_command(&router, &module_help_parsed);
    var module_help_reply: CommandReply = command_execute_at(&engine, &module_help_command, 1000u64);
    const module_help_len: usize = try connection_encode_reply(&module_help_reply, &out[0], 4096);
    try assert_true(command_executor_test_contains(out[0: module_help_len], &"MODULE HELP"[0: 11]));
    try assert_true(command_executor_test_contains(out[0: module_help_len], &"MODULE LIST"[0: 11]));
    try assert_true(command_executor_test_contains(out[0: module_help_len], &"MODULE LOAD"[0: 11]));
    try assert_true(command_executor_test_contains(out[0: module_help_len], &"MODULE LOADEX"[0: 13]));
    try assert_true(command_executor_test_contains(out[0: module_help_len], &"MODULE UNLOAD"[0: 13]));
    command_reply_cleanup(&module_help_reply);
    resp_value_free(&module_help_parsed.value);

    var module_list_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nMODULE\r\n$4\r\nLIST\r\n"[0: 26]);
    const module_list_command: Command = try command_executor_test_command(&router, &module_list_parsed);
    var module_list_reply: CommandReply = command_execute_at(&engine, &module_list_command, 1000u64);
    try assert_eq_i32(module_list_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(module_list_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&module_list_reply);
    resp_value_free(&module_list_parsed.value);

    var module_load_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nMODULE\r\n$4\r\nLOAD\r\n$8\r\nredis.so\r\n"[0: 40]);
    const module_load_command: Command = try command_executor_test_command(&router, &module_load_parsed);
    var module_load_reply: CommandReply = command_execute_at(&engine, &module_load_command, 1000u64);
    try assert_eq_i32(module_load_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(module_load_reply.data, &"ERR MODULE LOAD command not allowed by redis-uya standalone profile"[0: 67]));
    command_reply_cleanup(&module_load_reply);
    resp_value_free(&module_load_parsed.value);

    var module_loadex_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nMODULE\r\n$6\r\nLOADEX\r\n$8\r\nredis.so\r\n"[0: 42]);
    const module_loadex_command: Command = try command_executor_test_command(&router, &module_loadex_parsed);
    var module_loadex_reply: CommandReply = command_execute_at(&engine, &module_loadex_command, 1000u64);
    try assert_eq_i32(module_loadex_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(module_loadex_reply.data, &"ERR MODULE LOADEX command not allowed by redis-uya standalone profile"[0: 69]));
    command_reply_cleanup(&module_loadex_reply);
    resp_value_free(&module_loadex_parsed.value);

    var module_unload_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nMODULE\r\n$6\r\nUNLOAD\r\n$4\r\njson\r\n"[0: 38]);
    const module_unload_command: Command = try command_executor_test_command(&router, &module_unload_parsed);
    var module_unload_reply: CommandReply = command_execute_at(&engine, &module_unload_command, 1000u64);
    try assert_eq_i32(module_unload_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(module_unload_reply.data, &"ERR MODULE UNLOAD command not allowed by redis-uya standalone profile"[0: 69]));
    command_reply_cleanup(&module_unload_reply);
    resp_value_free(&module_unload_parsed.value);

    var module_unknown_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nMODULE\r\n$1\r\nX\r\n"[0: 23]);
    const module_unknown_command: Command = try command_executor_test_command(&router, &module_unknown_parsed);
    var module_unknown_reply: CommandReply = command_execute_at(&engine, &module_unknown_command, 1000u64);
    try assert_eq_i32(module_unknown_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(module_unknown_reply.data, &"ERR unknown subcommand 'X'. Try MODULE HELP."[0: 44]));
    command_reply_cleanup(&module_unknown_reply);
    resp_value_free(&module_unknown_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

