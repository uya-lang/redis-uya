    resp_value_free(&linsert_parsed.value);

    var lrange_before_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nLRANGE\r\n$5\r\nwlist\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 42]);
    const lrange_before_command: Command = try command_executor_test_command(&router, &lrange_before_parsed);
