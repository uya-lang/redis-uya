    var bad_payload_parsed: RespParseResult = try parse_resp2(&"*3\r\n$8\r\nFUNCTION\r\n$7\r\nRESTORE\r\n$3\r\nbad\r\n"[0: 40]);
    const bad_payload_command: Command = try command_executor_test_command(&router, &bad_payload_parsed);
