    try assert_true(command_executor_test_slice_eq(getrange_reply.data, &"alu"[0: 3]));
    resp_value_free(&getrange_parsed.value);

    var setrange_parsed: RespParseResult = try parse_resp2(&"*4\r\n$8\r\nSETRANGE\r\n$3\r\nkey\r\n$1\r\n5\r\n$2\r\n__\r\n"[0: 42]);
    const setrange_command: Command = try command_executor_test_command(&router, &setrange_parsed);
    const setrange_reply: CommandReply = command_execute_at(&engine, &setrange_command, 1000u64);
    try assert_eq_i32(setrange_reply.typ as i32, CommandReplyType.reply_integer as i32);
