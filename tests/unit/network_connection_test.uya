    const selector_setup: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*8\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nsel\r\n$2\r\non\r\n$6\r\nnopass\r\n$5\r\n-copy\r\n$9\r\nresetkeys\r\n$25\r\n(%R~sel:* %W~out:* +copy)\r\n"[0: 113], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: selector_setup.response_len], &"+OK\r\n"[0: 5]));
    const selector_copy: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*6\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$3\r\nsel\r\n$4\r\nCOPY\r\n$5\r\nsel:a\r\n$5\r\nout:a\r\n"[0: 66], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: selector_copy.response_len], &"+OK\r\n"[0: 5]));
    const selector_bad_source: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*6\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$3\r\nsel\r\n$4\r\nCOPY\r\n$5\r\nout:a\r\n$5\r\nout:b\r\n"[0: 66], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: selector_bad_source.response_len], &"NOPERM"[0: 6]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_acl_default_user_state() !void {
    reset_memory_stats_for_test();
    connection_acl_reset_for_test();
    defer { connection_acl_reset_for_test(); }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    var default_tx: ConnectionTransaction = connection_transaction_new();
    var operator_tx: ConnectionTransaction = connection_transaction_new();
    var fresh_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&default_tx);
        connection_transaction_reset(&operator_tx);
        connection_transaction_reset(&fresh_tx);
    }
    var out: [byte: 4096] = [];

    const establish_default: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &default_tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: establish_default.response_len], &"+PONG\r\n"[0: 7]));

    const create_operator: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &default_tx, &"*8\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$8\r\noperator\r\n$2\r\non\r\n$6\r\nnopass\r\n$5\r\n+@all\r\n$7\r\nallkeys\r\n$11\r\nallchannels\r\n"[0: 102], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: create_operator.response_len], &"+OK\r\n"[0: 5]));
    const auth_operator: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*3\r\n$4\r\nAUTH\r\n$8\r\noperator\r\n$1\r\nx\r\n"[0: 35], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_operator.response_len], &"+OK\r\n"[0: 5]));

    const default_off: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$3\r\noff\r\n"[0: 48], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: default_off.response_len], &"+OK\r\n"[0: 5]));
    const existing_default_ping: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &default_tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: existing_default_ping.response_len], &"+PONG\r\n"[0: 7]));
    const fresh_default_ping: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &fresh_tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: fresh_default_ping.response_len], &"-NOAUTH Authentication required.\r\n"[0: 34]));
    const disabled_default_auth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &fresh_tx, &"*3\r\n$4\r\nAUTH\r\n$7\r\ndefault\r\n$1\r\nx\r\n"[0: 34], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: disabled_default_auth.response_len], &"-WRONGPASS invalid username-password pair or user is disabled.\r\n"[0: 64]));

    const getuser_off: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n"[0: 39], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_off.response_len], &"*2\r\n$3\r\noff\r\n$6\r\nnopass\r\n"[0: 25]));

    const default_on: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$2\r\non\r\n"[0: 47], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: default_on.response_len], &"+OK\r\n"[0: 5]));
    const fresh_after_on: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &fresh_tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: fresh_after_on.response_len], &"+PONG\r\n"[0: 7]));

    const default_reset: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$5\r\nreset\r\n"[0: 50], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: default_reset.response_len], &"+OK\r\n"[0: 5]));
    const getuser_reset: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n"[0: 39], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: getuser_reset.response_len], &"*1\r\n$3\r\noff\r\n"[0: 13]));
    try assert_true(!network_connection_contains(out[0: getuser_reset.response_len], &"nopass"[0: 6]));
    try assert_true(network_connection_contains(out[0: getuser_reset.response_len], &"$8\r\ncommands\r\n$5\r\n-@all\r\n"[0: 25]));
    try assert_true(network_connection_contains(out[0: getuser_reset.response_len], &"$4\r\nkeys\r\n$9\r\nresetkeys\r\n"[0: 25]));
    try assert_true(network_connection_contains(out[0: getuser_reset.response_len], &"$8\r\nchannels\r\n$13\r\nresetchannels\r\n"[0: 34]));
    const list_reset: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*2\r\n$3\r\nACL\r\n$4\r\nLIST\r\n"[0: 23], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: list_reset.response_len], &"user default off resetpass resetkeys resetchannels -@all"[0: 56]));

    var reset_fresh_tx: ConnectionTransaction = connection_transaction_new();
    defer { connection_transaction_reset(&reset_fresh_tx); }
    const reset_default_ping: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &reset_fresh_tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_default_ping.response_len], &"-NOAUTH Authentication required.\r\n"[0: 34]));
    const reset_default_auth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &reset_fresh_tx, &"*2\r\n$4\r\nAUTH\r\n$1\r\nx\r\n"[0: 21], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset_default_auth.response_len], &"-WRONGPASS invalid username-password pair or user is disabled.\r\n"[0: 64]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_acl_setuser_atomic() !void {
    reset_memory_stats_for_test();
    connection_acl_reset_for_test();
    defer { connection_acl_reset_for_test(); }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    var default_tx: ConnectionTransaction = connection_transaction_new();
    var operator_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&default_tx);
        connection_transaction_reset(&operator_tx);
    }
    var out: [byte: 4096] = [];

    const create_operator: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &default_tx, &"*8\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$8\r\noperator\r\n$2\r\non\r\n$6\r\nnopass\r\n$5\r\n+@all\r\n$7\r\nallkeys\r\n$11\r\nallchannels\r\n"[0: 102], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: create_operator.response_len], &"+OK\r\n"[0: 5]));
    const auth_operator: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*3\r\n$4\r\nAUTH\r\n$8\r\noperator\r\n$1\r\nx\r\n"[0: 35], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_operator.response_len], &"+OK\r\n"[0: 5]));

    const default_error: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*6\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$7\r\ndefault\r\n$3\r\noff\r\n$9\r\nresetpass\r\n$5\r\nbogus\r\n"[0: 74], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: default_error.response_len], &"modifier 'bogus': Syntax error"[0: 30]));
    const default_ping: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &default_tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: default_ping.response_len], &"+PONG\r\n"[0: 7]));
    const default_user: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n"[0: 39], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: default_user.response_len], &"*2\r\n$2\r\non\r\n$6\r\nnopass\r\n"[0: 24]));
    try assert_true(network_connection_contains(out[0: default_user.response_len], &"$5\r\n+@all\r\n"[0: 11]));

    const create_atomic: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*9\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$6\r\natomic\r\n$5\r\nreset\r\n$2\r\non\r\n$6\r\nnopass\r\n$4\r\n+set\r\n$7\r\nallkeys\r\n$11\r\nallchannels\r\n"[0: 110], &out[0], 4096, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: create_atomic.response_len], &"+OK\r\n"[0: 5]));
    const named_error: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*6\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$6\r\natomic\r\n$3\r\noff\r\n$4\r\n+get\r\n$8\r\n<missing\r\n"[0: 71], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: named_error.response_len], &"password you are trying to remove"[0: 33]));
    const named_user: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &operator_tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$6\r\natomic\r\n"[0: 38], &out[0], 4096, 1000u64);
    try assert_true(network_connection_contains(out[0: named_user.response_len], &"*2\r\n$2\r\non\r\n$6\r\nnopass\r\n"[0: 24]));
    try assert_true(network_connection_contains(out[0: named_user.response_len], &"$10\r\n-@all +set\r\n"[0: 17]));
    try assert_true(!network_connection_contains(out[0: named_user.response_len], &"+get"[0: 4]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_command_docs_all_large_reply() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 262144] = [];

    const docs_all: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$7\r\nCOMMAND\r\n$4\r\nDOCS\r\n"[0: 27], &out[0], 262144, 1000u64);
    try assert_true(docs_all.response_len > 0);
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$3\r\nget\r\n"[0: 9]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$9\r\nclient|id\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$12\r\nclient|reply\r\n"[0: 19]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$14\r\nclient|unblock\r\n"[0: 21]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$14\r\nclient|caching\r\n"[0: 21]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$15\r\nclient|no-evict\r\n"[0: 22]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$15\r\nclient|no-touch\r\n"[0: 22]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$7\r\nsummary\r\n"[0: 13]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$3\r\nacl\r\n"[0: 9]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$7\r\nacl|cat\r\n"[0: 13]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$11\r\nacl|deluser\r\n"[0: 18]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$10\r\nacl|dryrun\r\n"[0: 17]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$11\r\nacl|genpass\r\n"[0: 18]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$11\r\nacl|getuser\r\n"[0: 18]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$8\r\nacl|help\r\n"[0: 14]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$8\r\nacl|list\r\n"[0: 14]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$8\r\nacl|load\r\n"[0: 14]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$7\r\nacl|log\r\n"[0: 13]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$8\r\nacl|save\r\n"[0: 14]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$11\r\nacl|setuser\r\n"[0: 18]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$9\r\nacl|users\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$10\r\nacl|whoami\r\n"[0: 17]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$19\r\nmemory|malloc-stats\r\n"[0: 26]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$12\r\nmemory|purge\r\n"[0: 19]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$6\r\nmodule\r\n"[0: 12]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$11\r\nmodule|help\r\n"[0: 18]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$11\r\nmodule|list\r\n"[0: 18]));
    try assert_true(network_connection_contains(out[0: docs_all.response_len], &"$5\r\nblpop\r\n"[0: 11]));
    const docs_all_len: u64 = try network_connection_parse_resp2_collection_len(out[0: docs_all.response_len], 42 as byte);
    try assert_true(docs_all_len > 100u64);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_auth_requirepass_shutdown() !void {
    reset_memory_stats_for_test();
    connection_acl_reset_for_test();
    defer {
        connection_acl_reset_for_test();
    }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.requirepass[0] = 115 as byte; // s
    runtime.config.requirepass[1] = 101 as byte; // e
    runtime.config.requirepass[2] = 99 as byte;  // c
    runtime.config.requirepass[3] = 114 as byte; // r
    runtime.config.requirepass[4] = 101 as byte; // e
    runtime.config.requirepass[5] = 116 as byte; // t
    runtime.config.requirepass[6] = 0 as byte;
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 512] = [];

    const ping_noauth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ping_noauth.response_len], &"-NOAUTH Authentication required.\r\n"[0: 34]));

    var quit_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&quit_tx);
    }
    const quit_before_auth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &quit_tx, &"*1\r\n$4\r\nQUIT\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: quit_before_auth.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(quit_before_auth.close_after as i32, 1);

    const hello_noauth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n3\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: hello_noauth.response_len], &"-NOAUTH Authentication required.\r\n"[0: 34]));

    var hello_auth_bad_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&hello_auth_bad_tx);
    }
    const hello_auth_bad: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &hello_auth_bad_tx, &"*5\r\n$5\r\nHELLO\r\n$1\r\n3\r\n$4\r\nAUTH\r\n$7\r\ndefault\r\n$5\r\nwrong\r\n"[0: 56], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: hello_auth_bad.response_len], &"-WRONGPASS invalid username-password pair or user is disabled.\r\n"[0: 64]));
    try assert_eq_i32(hello_auth_bad_tx.authenticated as i32, 0);
    try assert_eq_i32(hello_auth_bad_tx.protocol_version, 2);

    var hello_auth_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&hello_auth_tx);
    }
    const hello_auth_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &hello_auth_tx, &"*5\r\n$5\r\nHELLO\r\n$1\r\n3\r\n$4\r\nAUTH\r\n$7\r\ndefault\r\n$6\r\nsecret\r\n"[0: 57], &out[0], 512, 1000u64);
    try assert_true(out[0] == 37 as byte);
    try assert_eq_i32(hello_auth_tx.authenticated as i32, 1);
    try assert_eq_i32(hello_auth_tx.protocol_version, 3);

    var hello_auth_name_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&hello_auth_name_tx);
    }
    const hello_auth_setname: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &hello_auth_name_tx, &"*7\r\n$5\r\nHELLO\r\n$1\r\n2\r\n$4\r\nAUTH\r\n$7\r\ndefault\r\n$6\r\nsecret\r\n$7\r\nSETNAME\r\n$10\r\nhello-auth\r\n"[0: 87], &out[0], 512, 1000u64);
    try assert_true(out[0] == 42 as byte);
    try assert_eq_i32(hello_auth_name_tx.authenticated as i32, 1);
    try assert_eq_i32(hello_auth_name_tx.protocol_version, 2);
    const hello_auth_getname: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &hello_auth_name_tx, &"*2\r\n$6\r\nCLIENT\r\n$7\r\nGETNAME\r\n"[0: 29], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: hello_auth_getname.response_len], &"$10\r\nhello-auth\r\n"[0: 17]));

    const auth_wrong: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$4\r\nAUTH\r\n$5\r\nwrong\r\n"[0: 25], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_wrong.response_len], &"-WRONGPASS invalid username-password pair or user is disabled.\r\n"[0: 64]));

    const auth_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$4\r\nAUTH\r\n$7\r\ndefault\r\n$6\r\nsecret\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_ok.response_len], &"+OK\r\n"[0: 5]));

    const ping_after_auth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ping_after_auth.response_len], &"+PONG\r\n"[0: 7]));

    const config_requirepass: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$11\r\nrequirepass\r\n"[0: 43], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: config_requirepass.response_len], &"requirepass"[0: 11]));
    try assert_true(network_connection_contains(out[0: config_requirepass.response_len], &"secret"[0: 6]));

    const acl_auth_getuser: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: acl_auth_getuser.response_len], &"$9\r\npasswords\r\n*1\r\n$64\r\n"[0: 24]));
    try assert_true(!network_connection_contains(out[0: acl_auth_getuser.response_len], &"nopass"[0: 6]));
    try assert_true(!network_connection_contains(out[0: acl_auth_getuser.response_len], &"secret"[0: 6]));

    const acl_auth_list: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$3\r\nACL\r\n$4\r\nLIST\r\n"[0: 23], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: acl_auth_list.response_len], &"#"[0: 1]));
    try assert_true(!network_connection_contains(out[0: acl_auth_list.response_len], &"nopass"[0: 6]));
    try assert_true(!network_connection_contains(out[0: acl_auth_list.response_len], &"secret"[0: 6]));

    const requirepass_set_bob: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*6\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$2\r\non\r\n$7\r\n>secret\r\n$4\r\n+acl\r\n"[0: 66], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: requirepass_set_bob.response_len], &"+OK\r\n"[0: 5]));

    var requirepass_bob_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&requirepass_bob_tx);
    }
    const requirepass_auth_bob: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &requirepass_bob_tx, &"*3\r\n$4\r\nAUTH\r\n$3\r\nbob\r\n$6\r\nsecret\r\n"[0: 35], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: requirepass_auth_bob.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(requirepass_bob_tx.authenticated as i32, 1);

    const requirepass_bob_whoami: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &requirepass_bob_tx, &"*2\r\n$3\r\nACL\r\n$6\r\nWHOAMI\r\n"[0: 25], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: requirepass_bob_whoami.response_len], &"$3\r\nbob\r\n"[0: 9]));

    const requirepass_bob_off: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*4\r\n$3\r\nACL\r\n$7\r\nSETUSER\r\n$3\r\nbob\r\n$3\r\noff\r\n"[0: 44], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: requirepass_bob_off.response_len], &"+OK\r\n"[0: 5]));

    const requirepass_bob_after_off: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &requirepass_bob_tx, &"*2\r\n$3\r\nACL\r\n$6\r\nWHOAMI\r\n"[0: 25], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: requirepass_bob_after_off.response_len], &"$3\r\nbob\r\n"[0: 9]));

    var requirepass_bob_new_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&requirepass_bob_new_tx);
    }
    const requirepass_bob_auth_after_off: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &requirepass_bob_new_tx, &"*3\r\n$4\r\nAUTH\r\n$3\r\nbob\r\n$6\r\nsecret\r\n"[0: 35], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: requirepass_bob_auth_after_off.response_len], &"-WRONGPASS invalid username-password pair or user is disabled.\r\n"[0: 64]));

    const multi_auth: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_auth.response_len], &"+OK\r\n"[0: 5]));

    const shutdown_in_multi: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$8\r\nSHUTDOWN\r\n$6\r\nNOSAVE\r\n"[0: 30], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: shutdown_in_multi.response_len], &"-ERR Command not allowed inside a transaction\r\n"[0: 47]));

    const discard_after_shutdown_err: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*1\r\n$7\r\nDISCARD\r\n"[0: 17], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard_after_shutdown_err.response_len], &"+OK\r\n"[0: 5]));

    const shutdown_ok: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &runtime, &router, &tx, &"*2\r\n$8\r\nSHUTDOWN\r\n$6\r\nNOSAVE\r\n"[0: 30], &out[0], 512, 1000u64);
    try assert_eq_i32(shutdown_ok.response_len as i32, 0);
    try assert_eq_i32(shutdown_ok.close_after as i32, 1);
    try assert_eq_i32(shutdown_ok.request_shutdown as i32, 1);

    var no_pass_runtime: CommandRuntimeInfo = command_runtime_default();
    var no_pass_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&no_pass_tx);
    }
    const auth_no_pass: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &no_pass_runtime, &router, &no_pass_tx, &"*2\r\n$4\r\nAUTH\r\n$6\r\nsecret\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: auth_no_pass.response_len], &"-ERR AUTH <password> called without any password configured for the default user. Are you sure your configuration is correct?\r\n"[0: 127]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_pubsub_commands() !void {
    reset_memory_stats_for_test();
    connection_pubsub_reset_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    tx.client_fd = 11;
    defer {
        connection_transaction_reset(&tx);
        connection_pubsub_reset_for_test();
    }
    var out: [byte: 256] = [];

    const subscribe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$5\r\nchan1\r\n"[0: 30], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: subscribe.response_len], &"subscribe"[0: 9]));
    try assert_true(network_connection_contains(out[0: subscribe.response_len], &"chan1"[0: 5]));
    try assert_true(network_connection_contains(out[0: subscribe.response_len], &":1\r\n"[0: 4]));

    const psubscribe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$10\r\nPSUBSCRIBE\r\n$5\r\nchan*\r\n"[0: 32], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: psubscribe.response_len], &"psubscribe"[0: 10]));
    try assert_true(network_connection_contains(out[0: psubscribe.response_len], &"chan*"[0: 5]));
    try assert_true(network_connection_contains(out[0: psubscribe.response_len], &":2\r\n"[0: 4]));

    const ssubscribe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$10\r\nSSUBSCRIBE\r\n$6\r\nshard1\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: ssubscribe.response_len], &"ssubscribe"[0: 10]));
    try assert_true(network_connection_contains(out[0: ssubscribe.response_len], &"shard1"[0: 6]));
    try assert_true(network_connection_contains(out[0: ssubscribe.response_len], &":3\r\n"[0: 4]));

    const blocked_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: blocked_get.response_len], &"only SUBSCRIBE / PSUBSCRIBE / SSUBSCRIBE / UNSUBSCRIBE / PUNSUBSCRIBE / SUNSUBSCRIBE / PING / QUIT are allowed in this context"[0: 126]));

    const blocked_publish: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$7\r\nPUBLISH\r\n$5\r\nchan1\r\n$5\r\nhello\r\n"[0: 39], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: blocked_publish.response_len], &"only SUBSCRIBE / PSUBSCRIBE / SSUBSCRIBE / UNSUBSCRIBE / PUNSUBSCRIBE / SUNSUBSCRIBE / PING / QUIT are allowed in this context"[0: 126]));

    const blocked_spublish: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$8\r\nSPUBLISH\r\n$6\r\nshard1\r\n$5\r\nhello\r\n"[0: 41], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: blocked_spublish.response_len], &"only SUBSCRIBE / PSUBSCRIBE / SSUBSCRIBE / UNSUBSCRIBE / PUNSUBSCRIBE / SUNSUBSCRIBE / PING / QUIT are allowed in this context"[0: 126]));

    const ping_subscribed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nPING\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: ping_subscribed.response_len], &"+PONG\r\n"[0: 7]));

    const sunsubscribe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$12\r\nSUNSUBSCRIBE\r\n$6\r\nshard1\r\n"[0: 35], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: sunsubscribe.response_len], &"sunsubscribe"[0: 12]));
    try assert_true(network_connection_contains(out[0: sunsubscribe.response_len], &"shard1"[0: 6]));
    try assert_true(network_connection_contains(out[0: sunsubscribe.response_len], &":2\r\n"[0: 4]));

    const punsubscribe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$12\r\nPUNSUBSCRIBE\r\n$5\r\nchan*\r\n"[0: 34], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: punsubscribe.response_len], &"punsubscribe"[0: 12]));
    try assert_true(network_connection_contains(out[0: punsubscribe.response_len], &"chan*"[0: 5]));
    try assert_true(network_connection_contains(out[0: punsubscribe.response_len], &":1\r\n"[0: 4]));

    const unsubscribe: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$11\r\nUNSUBSCRIBE\r\n$5\r\nchan1\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: unsubscribe.response_len], &"unsubscribe"[0: 11]));
    try assert_true(network_connection_contains(out[0: unsubscribe.response_len], &"chan1"[0: 5]));
    try assert_true(network_connection_contains(out[0: unsubscribe.response_len], &":0\r\n"[0: 4]));

    const unsubscribe_all: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$11\r\nUNSUBSCRIBE\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: unsubscribe_all.response_len], &"unsubscribe"[0: 11]));
    try assert_true(network_connection_contains(out[0: unsubscribe_all.response_len], &"$-1\r\n"[0: 5]));
    try assert_true(network_connection_contains(out[0: unsubscribe_all.response_len], &":0\r\n"[0: 4]));

    const punsubscribe_all: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$12\r\nPUNSUBSCRIBE\r\n"[0: 23], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: punsubscribe_all.response_len], &"punsubscribe"[0: 12]));
    try assert_true(network_connection_contains(out[0: punsubscribe_all.response_len], &"$-1\r\n"[0: 5]));
    try assert_true(network_connection_contains(out[0: punsubscribe_all.response_len], &":0\r\n"[0: 4]));

    var resp3_tx: ConnectionTransaction = connection_transaction_new();
    resp3_tx.client_fd = 13;
    defer {
        connection_transaction_reset(&resp3_tx);
    }
    var resp3_out: [byte: 512] = [];
    const hello3: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &resp3_tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n3\r\n"[0: 22], &resp3_out[0], 512, 1000u64);
    try assert_true(resp3_out[0] == 37 as byte);
    _ = hello3;

    const subscribe_resp3: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &resp3_tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$5\r\nchan1\r\n"[0: 30], &resp3_out[0], 512, 1000u64);
    try assert_true(network_connection_contains(resp3_out[0: subscribe_resp3.response_len], &"subscribe"[0: 9]));

    const get_resp3_subscribed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &resp3_tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &resp3_out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(resp3_out[0: get_resp3_subscribed.response_len], &"_\r\n"[0: 3]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_pubsub_introspection() !void {
    reset_memory_stats_for_test();
    connection_pubsub_reset_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var sub_tx: ConnectionTransaction = connection_transaction_new();
    sub_tx.client_fd = 21;
    var direct_tx: ConnectionTransaction = connection_transaction_new();
    direct_tx.client_fd = 22;
    var shard_tx: ConnectionTransaction = connection_transaction_new();
    shard_tx.client_fd = 24;
    var info_tx: ConnectionTransaction = connection_transaction_new();
    info_tx.client_fd = 23;
    defer {
        connection_transaction_reset(&sub_tx);
        connection_transaction_reset(&direct_tx);
        connection_transaction_reset(&shard_tx);
        connection_transaction_reset(&info_tx);
        connection_pubsub_reset_for_test();
    }
    var out: [byte: 2048] = [];

    _ = try connection_process_input_with_transaction_at(&engine, &router, &sub_tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$5\r\nchan1\r\n"[0: 30], &out[0], 2048, 1000u64);
    _ = try connection_process_input_with_transaction_at(&engine, &router, &sub_tx, &"*2\r\n$10\r\nPSUBSCRIBE\r\n$5\r\nchan*\r\n"[0: 32], &out[0], 2048, 1000u64);
    _ = try connection_process_input_with_transaction_at(&engine, &router, &direct_tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$5\r\nchan1\r\n"[0: 30], &out[0], 2048, 1000u64);
    _ = try connection_process_input_with_transaction_at(&engine, &router, &direct_tx, &"*2\r\n$9\r\nSUBSCRIBE\r\n$3\r\nzed\r\n"[0: 28], &out[0], 2048, 1000u64);
    _ = try connection_process_input_with_transaction_at(&engine, &router, &shard_tx, &"*2\r\n$10\r\nSSUBSCRIBE\r\n$6\r\nshard1\r\n"[0: 33], &out[0], 2048, 1000u64);

    const channels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$8\r\nCHANNELS\r\n"[0: 30], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: channels.response_len], &"*2\r\n$5\r\nchan1\r\n$3\r\nzed\r\n"[0: 24]));

    const channels_pattern: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*3\r\n$6\r\nPUBSUB\r\n$8\r\nCHANNELS\r\n$5\r\nchan?\r\n"[0: 41], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: channels_pattern.response_len], &"*1\r\n$5\r\nchan1\r\n"[0: 15]));

    const numpat: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$6\r\nNUMPAT\r\n"[0: 28], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: numpat.response_len], &":1\r\n"[0: 4]));

    const numsub: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*5\r\n$6\r\nPUBSUB\r\n$6\r\nNUMSUB\r\n$5\r\nchan1\r\n$3\r\nzed\r\n$5\r\nghost\r\n"[0: 59], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: numsub.response_len], &"*6\r\n$5\r\nchan1\r\n:2\r\n$3\r\nzed\r\n:1\r\n$5\r\nghost\r\n:0\r\n"[0: 47]));

    const numsub_empty: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$6\r\nNUMSUB\r\n"[0: 28], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: numsub_empty.response_len], &"*0\r\n"[0: 4]));

    const shardchannels: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$13\r\nSHARDCHANNELS\r\n"[0: 36], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: shardchannels.response_len], &"*1\r\n$6\r\nshard1\r\n"[0: 16]));

    const shardchannels_pattern: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*3\r\n$6\r\nPUBSUB\r\n$13\r\nSHARDCHANNELS\r\n$6\r\nshard?\r\n"[0: 48], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: shardchannels_pattern.response_len], &"*1\r\n$6\r\nshard1\r\n"[0: 16]));

    const shardnumsub: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*4\r\n$6\r\nPUBSUB\r\n$11\r\nSHARDNUMSUB\r\n$6\r\nshard1\r\n$6\r\nshard2\r\n"[0: 58], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: shardnumsub.response_len], &"*4\r\n$6\r\nshard1\r\n:1\r\n$6\r\nshard2\r\n:0\r\n"[0: 36]));

    const help: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$4\r\nHELP\r\n"[0: 26], &out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(out[0: help.response_len], &"PUBSUB <subcommand> [<arg> [value] [opt] ...]. Subcommands are:"[0: 63]));
    try assert_true(network_connection_contains(out[0: help.response_len], &"SHARDCHANNELS [<pattern>]"[0: 25]));

    const missing_subcommand: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*1\r\n$6\r\nPUBSUB\r\n"[0: 16], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: missing_subcommand.response_len], &"-ERR wrong number of arguments for 'pubsub' command\r\n"[0: 53]));

    const bad_subcommand: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*2\r\n$6\r\nPUBSUB\r\n$4\r\nNOPE\r\n"[0: 26], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bad_subcommand.response_len], &"-ERR unknown subcommand 'nope'. Try PUBSUB HELP.\r\n"[0: 50]));

    const bad_channels_arity: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &info_tx, &"*4\r\n$6\r\nPUBSUB\r\n$8\r\nCHANNELS\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 44], &out[0], 2048, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bad_channels_arity.response_len], &"-ERR unknown subcommand or wrong number of arguments for 'channels'. Try PUBSUB HELP.\r\n"[0: 87]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_himport() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    var other_tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&other_tx);
        connection_transaction_reset(&tx);
    }
    var out: [byte: 512] = [];

    const prepare: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$7\r\nHIMPORT\r\n$7\r\nPREPARE\r\n$2\r\nfs\r\n$1\r\nb\r\n$2\r\naa\r\n"[0: 53], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: prepare.response_len], &"+OK\r\n"[0: 5]));

    const set_result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*6\r\n$7\r\nHIMPORT\r\n$3\r\nSET\r\n$3\r\nkey\r\n$2\r\nfs\r\n$3\r\none\r\n$3\r\ntwo\r\n"[0: 61], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_result.response_len], &"+OK\r\n"[0: 5]));

    const hget_b: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$4\r\nHGET\r\n$3\r\nkey\r\n$1\r\nb\r\n"[0: 30], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: hget_b.response_len], &"$3\r\none\r\n"[0: 9]));

    const hget_aa: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$4\r\nHGET\r\n$3\r\nkey\r\n$2\r\naa\r\n"[0: 31], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: hget_aa.response_len], &"$3\r\ntwo\r\n"[0: 9]));

    const duplicate: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$7\r\nHIMPORT\r\n$7\r\nPREPARE\r\n$3\r\ndup\r\n$1\r\na\r\n$1\r\na\r\n"[0: 53], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: duplicate.response_len], &"-ERR duplicate field name in fieldset\r\n"[0: 39]));

    const unknown: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &other_tx, &"*5\r\n$7\r\nHIMPORT\r\n$3\r\nSET\r\n$1\r\nk\r\n$7\r\nmissing\r\n$1\r\nv\r\n"[0: 53], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: unknown.response_len], &"-ERR no such fieldset\r\n"[0: 23]));

    const wrong_count: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$7\r\nHIMPORT\r\n$3\r\nSET\r\n$3\r\nkey\r\n$2\r\nfs\r\n$3\r\none\r\n"[0: 52], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: wrong_count.response_len], &"-ERR value count does not match fieldset field count\r\n"[0: 54]));

    const replace_prepare: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$7\r\nHIMPORT\r\n$7\r\nPREPARE\r\n$2\r\nfs\r\n$1\r\nx\r\n"[0: 45], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: replace_prepare.response_len], &"+OK\r\n"[0: 5]));

    const replace_set: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$7\r\nHIMPORT\r\n$3\r\nSET\r\n$3\r\nkey\r\n$2\r\nfs\r\n$3\r\nnew\r\n"[0: 52], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: replace_set.response_len], &"+OK\r\n"[0: 5]));

    const removed_old: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$4\r\nHGET\r\n$3\r\nkey\r\n$2\r\naa\r\n"[0: 31], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: removed_old.response_len], &"$-1\r\n"[0: 5]));

    const hget_x: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$4\r\nHGET\r\n$3\r\nkey\r\n$1\r\nx\r\n"[0: 30], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: hget_x.response_len], &"$3\r\nnew\r\n"[0: 9]));

    const discard: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$7\r\nHIMPORT\r\n$7\r\nDISCARD\r\n$2\r\nfs\r\n"[0: 38], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard.response_len], &":1\r\n"[0: 4]));
    const discard_missing: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$7\r\nHIMPORT\r\n$7\r\nDISCARD\r\n$2\r\nfs\r\n"[0: 38], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard_missing.response_len], &":0\r\n"[0: 4]));

    _ = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$7\r\nHIMPORT\r\n$7\r\nPREPARE\r\n$2\r\nf1\r\n$1\r\na\r\n"[0: 45], &out[0], 512, 1000u64);
    _ = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$7\r\nHIMPORT\r\n$7\r\nPREPARE\r\n$2\r\nf2\r\n$1\r\nb\r\n"[0: 45], &out[0], 512, 1000u64);
    const discard_all: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$7\r\nHIMPORT\r\n$10\r\nDISCARDALL\r\n"[0: 34], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard_all.response_len], &":2\r\n"[0: 4]));

    _ = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$7\r\nHIMPORT\r\n$7\r\nPREPARE\r\n$2\r\nfs\r\n$1\r\nx\r\n"[0: 45], &out[0], 512, 1000u64);
    const reset: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nRESET\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: reset.response_len], &"+RESET\r\n"[0: 8]));
    const after_reset: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$7\r\nHIMPORT\r\n$3\r\nSET\r\n$3\r\nkey\r\n$2\r\nfs\r\n$3\r\nnew\r\n"[0: 52], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: after_reset.response_len], &"-ERR no such fieldset\r\n"[0: 23]));

    const wrong_seed: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nSET\r\n$5\r\nwrong\r\n$1\r\nx\r\n"[0: 31], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: wrong_seed.response_len], &"+OK\r\n"[0: 5]));
    const wrong_type: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$7\r\nHIMPORT\r\n$3\r\nSET\r\n$5\r\nwrong\r\n$7\r\nmissing\r\n$1\r\nv\r\n"[0: 57], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: wrong_type.response_len], &"-WRONGTYPE Operation against a key holding the wrong kind of value\r\n"[0: 68]));

    const multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi.response_len], &"+OK\r\n"[0: 5]));
    const queued_prepare: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$7\r\nHIMPORT\r\n$7\r\nPREPARE\r\n$3\r\ntxf\r\n$1\r\ny\r\n"[0: 46], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_prepare.response_len], &"+QUEUED\r\n"[0: 9]));
    const queued_set: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$7\r\nHIMPORT\r\n$3\r\nSET\r\n$4\r\ntkey\r\n$3\r\ntxf\r\n$3\r\nval\r\n"[0: 54], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_set.response_len], &"+QUEUED\r\n"[0: 9]));
    const exec: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec.response_len], &"*2\r\n+OK\r\n+OK\r\n"[0: 14]));
    const tx_hget: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$4\r\nHGET\r\n$4\r\ntkey\r\n$1\r\ny\r\n"[0: 31], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: tx_hget.response_len], &"$3\r\nval\r\n"[0: 9]));

    connection_transaction_reset(&other_tx);
    connection_transaction_reset(&tx);
    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}
