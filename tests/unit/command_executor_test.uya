fn command_executor_test_slice_eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len { return false; }
    var i: usize = 0;
    while i < a.len {
        if a.ptr[i] != b.ptr[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn command_executor_test_contains(haystack: &[byte], needle: &[byte]) bool {
    if needle.len == 0 {
        return true;
    }
    if haystack.len < needle.len {
        return false;
    }
    var start: usize = 0;
    while start + needle.len <= haystack.len {
        var matched: bool = true;
        var i: usize = 0;
        while i < needle.len {
            if haystack.ptr[start + i] != needle.ptr[i] {
                matched = false;
                break;
            }
            i = i + 1;
        }
        if matched {
            return true;
        }
        start = start + 1;
    }
    return false;
}

fn command_executor_test_starts_with(haystack: &[byte], prefix: &[byte]) bool {
    if haystack.len < prefix.len {
        return false;
    }
    var i: usize = 0;
    while i < prefix.len {
        if haystack.ptr[i] != prefix.ptr[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn command_executor_test_parse_resp2_collection_len(data: &[byte], prefix: byte) !u64 {
    if data.len < 4 || data.ptr[0] != prefix {
        return error.AssertionFailed;
    }
    var index: usize = 1;
    var value: u64 = 0u64;
    while index + 1 < data.len {
        const ch: byte = data.ptr[index];
        if ch == 13 as byte {
            if data.ptr[index + 1] != 10 as byte {
                return error.AssertionFailed;
            }
            return value;
        }
        if ch < 48 as byte || ch > 57 as byte {
            return error.AssertionFailed;
        }
        value = value * 10u64 + ((ch - 48 as byte) as u64);
        index = index + 1;
    }
    return error.AssertionFailed;
}

fn command_executor_test_fill_bytes(data: &[byte], ch: byte) void {
    var i: usize = 0;
    while i < data.len {
        data.ptr[i] = ch;
        i = i + 1;
    }
}

fn command_executor_test_is_lower_hex(data: &[byte]) bool {
    var i: usize = 0;
    while i < data.len {
        const ch: byte = data.ptr[i];
        if !((ch >= 48 as byte && ch <= 57 as byte) || (ch >= 97 as byte && ch <= 102 as byte)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn command_executor_test_key_missing_at(engine: &Engine, key: &[byte], now_ms: u64) bool {
    const found: &RedisObject = lookup_key_at(engine, key, now_ms) catch |err| {
        if err == error.EngineKeyNotFound {
            return true;
        }
        return false;
    };
    _ = found;
    return false;
}

fn command_executor_test_command(router: &CommandRouter, parsed: &RespParseResult) !Command {
    return command_from_resp(router, &parsed.value);
}

fn command_executor_test_assert_catalog_status(name: &[byte], expected: CommandCatalogStatus) !void {
    const entry: CommandCatalogEntry = try command_catalog_lookup(name);
    try assert_eq_i32(entry.status as i32, expected as i32);
}

export fn test_command_ping_and_info() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var ping_parsed: RespParseResult = try parse_resp2(&"*1\r\n$4\r\nPING\r\n"[0: 14]);
    const ping_command: Command = try command_executor_test_command(&router, &ping_parsed);
    const ping_reply: CommandReply = command_execute_at(&engine, &ping_command, 1000u64);
    try assert_eq_i32(ping_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(ping_reply.data, &"PONG"[0: 4]));
    resp_value_free(&ping_parsed.value);

    var ping_msg_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nPING\r\n$2\r\nhi\r\n"[0: 22]);
    const ping_msg_command: Command = try command_executor_test_command(&router, &ping_msg_parsed);
    const ping_msg_reply: CommandReply = command_execute_at(&engine, &ping_msg_command, 1000u64);
    try assert_eq_i32(ping_msg_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(ping_msg_reply.data, &"hi"[0: 2]));
    resp_value_free(&ping_msg_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_info_and_config() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 512] = [];
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.port = 6380;
    runtime.active_clients = 2;
    runtime.maxclients = 8;
    runtime.served_clients = 5;
    runtime.cron_ticks = 9u64;
    runtime.start_ms = 1000u64;
    config_copy_bytes(runtime.replication_replid[0: 41], &"0123456789abcdef0123456789abcdef01234567"[0: 40]);
    runtime.replication_backlog_active = true;
    runtime.replication_master_offset = 128u64;
    runtime.replication_backlog_first_offset = 64u64;
    runtime.replication_backlog_histlen = 64;

    var set_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33]);
    const set_command: Command = try command_executor_test_command(&router, &set_parsed);
    _ = command_execute_with_runtime_at(&engine, &runtime, &set_command, 5000u64);
    resp_value_free(&set_parsed.value);

    var expire_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nEXPIRE\r\n$3\r\nkey\r\n$1\r\n2\r\n"[0: 32]);
    const expire_command: Command = try command_executor_test_command(&router, &expire_parsed);
    _ = command_execute_with_runtime_at(&engine, &runtime, &expire_command, 5000u64);
    resp_value_free(&expire_parsed.value);

    var info_server_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nINFO\r\n$6\r\nserver\r\n"[0: 26]);
    const info_server_command: Command = try command_executor_test_command(&router, &info_server_parsed);
    var info_server_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &info_server_command, 5000u64);
    try assert_eq_i32(info_server_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_eq_i32(info_server_reply.data.len as i32, 101);
    try assert_true(command_executor_test_contains(info_server_reply.data, &"# Server\r\n"[0: 10]));
    try assert_true(command_executor_test_contains(info_server_reply.data, &"redis_uya_version:"[0: 18]));
    try assert_true(command_executor_test_contains(info_server_reply.data, redis_uya_version()));
    try assert_true(command_executor_test_contains(info_server_reply.data, &"redis_mode:standalone\r\n"[0: 23]));
    try assert_true(command_executor_test_contains(info_server_reply.data, &"tcp_port:6380\r\n"[0: 15]));
    try assert_true(command_executor_test_contains(info_server_reply.data, &"uptime_in_seconds:4\r\n\r\n"[0: 23]));
    command_reply_cleanup(&info_server_reply);
    resp_value_free(&info_server_parsed.value);

    var info_memory_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nINFO\r\n$6\r\nmemory\r\n"[0: 26]);
    const info_memory_command: Command = try command_executor_test_command(&router, &info_memory_parsed);
    var info_memory_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &info_memory_command, 5000u64);
    try assert_eq_i32(info_memory_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"# Memory\r\n"[0: 10]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"used_memory_peak:"[0: 17]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"total_allocated:"[0: 16]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"total_freed:"[0: 12]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"allocator_total_allocations:"[0: 28]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"allocator_active_allocations:"[0: 29]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"allocator_slab_cached_blocks:"[0: 29]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"allocator_slab_cached_bytes:"[0: 28]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"allocator_slab_reuse_count:"[0: 27]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"object_pool_cached_objects:"[0: 27]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"object_pool_cached_list_nodes:"[0: 30]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"object_pool_reuse_count:"[0: 24]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"object_layout_size:"[0: 19]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"list_node_layout_size:"[0: 22]));
    try assert_true(command_executor_test_contains(info_memory_reply.data, &"maxmemory_policy:noeviction\r\n"[0: 29]));
    command_reply_cleanup(&info_memory_reply);
    resp_value_free(&info_memory_parsed.value);

    var info_keyspace_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nINFO\r\n$8\r\nkeyspace\r\n"[0: 28]);
    const info_keyspace_command: Command = try command_executor_test_command(&router, &info_keyspace_parsed);
    var info_keyspace_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &info_keyspace_command, 5000u64);
    try assert_eq_i32(info_keyspace_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_eq_i32(info_keyspace_reply.data.len as i32, 46);
    try assert_true(command_executor_test_slice_eq(info_keyspace_reply.data, &"# Keyspace\r\ndb0:keys=1,expires=1,avg_ttl=0\r\n\r\n"[0: 46]));
    command_reply_cleanup(&info_keyspace_reply);
    resp_value_free(&info_keyspace_parsed.value);

    var info_repl_master_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nINFO\r\n$11\r\nreplication\r\n"[0: 32]);
    const info_repl_master_command: Command = try command_executor_test_command(&router, &info_repl_master_parsed);
    var info_repl_master_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &info_repl_master_command, 5000u64);
    try assert_eq_i32(info_repl_master_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_contains(info_repl_master_reply.data, &"role:master\r\n"[0: 13]));
    command_reply_cleanup(&info_repl_master_reply);
    resp_value_free(&info_repl_master_parsed.value);

    var config_port_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$4\r\nport\r\n"[0: 35]);
    const config_port_command: Command = try command_executor_test_command(&router, &config_port_parsed);
    var config_port_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_port_command, 5000u64);
    const config_port_len: usize = try connection_encode_reply(&config_port_reply, &out[0], 512);
    try assert_eq_i32(config_port_len as i32, 24);
    try assert_true(command_executor_test_slice_eq(out[0: config_port_len], &"*2\r\n$4\r\nport\r\n$4\r\n6380\r\n"[0: 24]));
    command_reply_cleanup(&config_port_reply);
    resp_value_free(&config_port_parsed.value);

    var config_append_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$7\r\nappend*\r\n"[0: 38]);
    const config_append_command: Command = try command_executor_test_command(&router, &config_append_parsed);
    var config_append_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_append_command, 5000u64);
    const config_append_len: usize = try connection_encode_reply(&config_append_reply, &out[0], 512);
    try assert_eq_i32(config_append_len as i32, 46);
    try assert_true(command_executor_test_slice_eq(out[0: config_append_len], &"*2\r\n$14\r\nappendfilename\r\n$14\r\nappendonly.aof\r\n"[0: 46]));
    command_reply_cleanup(&config_append_reply);
    resp_value_free(&config_append_parsed.value);

    var config_max_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$4\r\nmax*\r\n"[0: 35]);
    const config_max_command: Command = try command_executor_test_command(&router, &config_max_parsed);
    var config_max_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_max_command, 5000u64);
    const config_max_len: usize = try connection_encode_reply(&config_max_reply, &out[0], 512);
    try assert_true(command_executor_test_contains(out[0: config_max_len], &"$9\r\nmaxmemory\r\n$1\r\n0\r\n"[0: 22]));
    try assert_true(command_executor_test_contains(out[0: config_max_len], &"$10\r\nmaxclients\r\n$1\r\n8\r\n"[0: 24]));
    command_reply_cleanup(&config_max_reply);
    resp_value_free(&config_max_parsed.value);

    var config_databases_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$9\r\ndatabases\r\n"[0: 40]);
    const config_databases_command: Command = try command_executor_test_command(&router, &config_databases_parsed);
    var config_databases_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_databases_command, 5000u64);
    const config_databases_len: usize = try connection_encode_reply(&config_databases_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: config_databases_len], &"*2\r\n$9\r\ndatabases\r\n$1\r\n1\r\n"[0: 26]));
    command_reply_cleanup(&config_databases_reply);
    resp_value_free(&config_databases_parsed.value);

    var config_help_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nCONFIG\r\n$4\r\nHELP\r\n"[0: 26]);
    const config_help_command: Command = try command_executor_test_command(&router, &config_help_parsed);
    var config_help_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_help_command, 5000u64);
    const config_help_len: usize = try connection_encode_reply(&config_help_reply, &out[0], 512);
    try assert_true(command_executor_test_contains(out[0: config_help_len], &"$20\r\nCONFIG GET <pattern>\r\n"[0: 27]));
    try assert_true(command_executor_test_contains(out[0: config_help_len], &"CONFIG SET <parameter> <value> [<parameter> <value> ...]"[0: 56]));
    try assert_true(command_executor_test_contains(out[0: config_help_len], &"CONFIG REWRITE"[0: 14]));
    command_reply_cleanup(&config_help_reply);
    resp_value_free(&config_help_parsed.value);

    var config_resetstat_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nCONFIG\r\n$9\r\nRESETSTAT\r\n"[0: 31]);
    const config_resetstat_command: Command = try command_executor_test_command(&router, &config_resetstat_parsed);
    const config_resetstat_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_resetstat_command, 5000u64);
    try assert_eq_i32(config_resetstat_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(config_resetstat_reply.data, &"OK"[0: 2]));
    resp_value_free(&config_resetstat_parsed.value);

    var config_set_max_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$9\r\nmaxmemory\r\n$3\r\n1mb\r\n"[0: 49]);
    const config_set_max_command: Command = try command_executor_test_command(&router, &config_set_max_parsed);
    const config_set_max_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_max_command, 5000u64);
    try assert_eq_i32(config_set_max_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(config_set_max_reply.data, &"OK"[0: 2]));
    try assert_eq_i32(config_set_max_reply.request_config_set as i32, 1);
    try assert_eq_i32(config_set_max_reply.config_after.maxmemory as i32, 1048576);
    resp_value_free(&config_set_max_parsed.value);

    var config_set_policy_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$16\r\nmaxmemory-policy\r\n$11\r\nallkeys-lru\r\n"[0: 73]);
    const config_set_policy_command: Command = try command_executor_test_command(&router, &config_set_policy_parsed);
    const config_set_policy_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_policy_command, 5000u64);
    try assert_eq_i32(config_set_policy_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_eq_i32(config_set_policy_reply.request_config_set as i32, 1);
    try assert_eq_i32(config_set_policy_reply.config_after.maxmemory_policy as i32, MaxmemoryPolicy.maxmemory_allkeys_lru as i32);
    resp_value_free(&config_set_policy_parsed.value);

    var config_set_save_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$4\r\nsave\r\n$5\r\n60 10\r\n"[0: 46]);
    const config_set_save_command: Command = try command_executor_test_command(&router, &config_set_save_parsed);
    const config_set_save_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_save_command, 5000u64);
    try assert_eq_i32(config_set_save_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_eq_i32(config_set_save_reply.request_config_set as i32, 1);
    try assert_eq_i32(config_set_save_reply.config_after.save_seconds, 60);
    try assert_eq_i32(config_set_save_reply.config_after.save_changes, 10);
    resp_value_free(&config_set_save_parsed.value);

    var config_set_requirepass_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$11\r\nrequirepass\r\n$4\r\nnext\r\n"[0: 56]);
    const config_set_requirepass_command: Command = try command_executor_test_command(&router, &config_set_requirepass_parsed);
    const config_set_requirepass_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_requirepass_command, 5000u64);
    try assert_eq_i32(config_set_requirepass_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_eq_i32(config_set_requirepass_reply.request_config_set as i32, 1);
    try assert_true(command_executor_test_slice_eq(config_set_requirepass_reply.config_after.requirepass[0: 4], &"next"[0: 4]));
    resp_value_free(&config_set_requirepass_parsed.value);

    var config_set_bad_value_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$9\r\nmaxmemory\r\n$5\r\nbogus\r\n"[0: 51]);
    const config_set_bad_value_command: Command = try command_executor_test_command(&router, &config_set_bad_value_parsed);
    const config_set_bad_value_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_bad_value_command, 5000u64);
    try assert_eq_i32(config_set_bad_value_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(config_set_bad_value_reply.data, &"ERR Invalid argument for CONFIG SET"[0: 35]));
    resp_value_free(&config_set_bad_value_parsed.value);

    var config_set_unknown_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$6\r\nfoobar\r\n$1\r\n1\r\n"[0: 44]);
    const config_set_unknown_command: Command = try command_executor_test_command(&router, &config_set_unknown_parsed);
    const config_set_unknown_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_unknown_command, 5000u64);
    try assert_eq_i32(config_set_unknown_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(config_set_unknown_reply.data, &"ERR Unsupported CONFIG parameter"[0: 32]));
    resp_value_free(&config_set_unknown_parsed.value);

    var config_set_port_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$4\r\nport\r\n$4\r\n6391\r\n"[0: 45]);
    const config_set_port_command: Command = try command_executor_test_command(&router, &config_set_port_parsed);
    const config_set_port_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_port_command, 5000u64);
    try assert_eq_i32(config_set_port_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_eq_i32(config_set_port_reply.config_after.port, 6391);
    resp_value_free(&config_set_port_parsed.value);

    var config_set_bind_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$4\r\nbind\r\n$7\r\n0.0.0.0\r\n"[0: 48]);
    const config_set_bind_command: Command = try command_executor_test_command(&router, &config_set_bind_parsed);
    const config_set_bind_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_bind_command, 5000u64);
    try assert_eq_i32(config_set_bind_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(config_set_bind_reply.config_after.bind[0: 7], &"0.0.0.0"[0: 7]));
    resp_value_free(&config_set_bind_parsed.value);

    var config_set_dir_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$3\r\ndir\r\n$11\r\nbuild/cache\r\n"[0: 52]);
    const config_set_dir_command: Command = try command_executor_test_command(&router, &config_set_dir_parsed);
    const config_set_dir_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_dir_command, 5000u64);
    try assert_eq_i32(config_set_dir_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(config_set_dir_reply.config_after.dir[0: 11], &"build/cache"[0: 11]));
    resp_value_free(&config_set_dir_parsed.value);

    var config_set_dbfilename_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$10\r\ndbfilename\r\n$11\r\nruntime.rdb\r\n"[0: 60]);
    const config_set_dbfilename_command: Command = try command_executor_test_command(&router, &config_set_dbfilename_parsed);
    const config_set_dbfilename_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_dbfilename_command, 5000u64);
    try assert_eq_i32(config_set_dbfilename_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(config_set_dbfilename_reply.config_after.dbfilename[0: 11], &"runtime.rdb"[0: 11]));
    resp_value_free(&config_set_dbfilename_parsed.value);

    var config_set_appendfilename_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$14\r\nappendfilename\r\n$11\r\nnextlog.aof\r\n"[0: 64]);
    const config_set_appendfilename_command: Command = try command_executor_test_command(&router, &config_set_appendfilename_parsed);
    const config_set_appendfilename_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_appendfilename_command, 5000u64);
    try assert_eq_i32(config_set_appendfilename_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(config_set_appendfilename_reply.config_after.appendfilename[0: 11], &"nextlog.aof"[0: 11]));
    resp_value_free(&config_set_appendfilename_parsed.value);

    var config_set_masterauth_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$10\r\nmasterauth\r\n$13\r\nupstream-pass\r\n"[0: 62]);
    const config_set_masterauth_command: Command = try command_executor_test_command(&router, &config_set_masterauth_parsed);
    const config_set_masterauth_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_masterauth_command, 5000u64);
    try assert_eq_i32(config_set_masterauth_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(config_set_masterauth_reply.config_after.masterauth[0: 13], &"upstream-pass"[0: 13]));
    resp_value_free(&config_set_masterauth_parsed.value);

    var config_set_maxclients_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$10\r\nmaxclients\r\n$2\r\n16\r\n"[0: 50]);
    const config_set_maxclients_command: Command = try command_executor_test_command(&router, &config_set_maxclients_parsed);
    const config_set_maxclients_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_maxclients_command, 5000u64);
    try assert_eq_i32(config_set_maxclients_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_eq_i32(config_set_maxclients_reply.request_maxclients_set as i32, 1);
    try assert_eq_i32(config_set_maxclients_reply.maxclients_after, 16);
    try assert_eq_i32(config_set_maxclients_reply.config_after.maxclients, 16);
    resp_value_free(&config_set_maxclients_parsed.value);

    var config_set_databases_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$9\r\ndatabases\r\n$1\r\n1\r\n"[0: 47]);
    const config_set_databases_command: Command = try command_executor_test_command(&router, &config_set_databases_parsed);
    const config_set_databases_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_databases_command, 5000u64);
    try assert_eq_i32(config_set_databases_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_eq_i32(config_set_databases_reply.config_after.databases, 1);
    resp_value_free(&config_set_databases_parsed.value);

    var config_set_replicaof_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$9\r\nreplicaof\r\n$14\r\n127.0.0.1 6381\r\n"[0: 61]);
    const config_set_replicaof_command: Command = try command_executor_test_command(&router, &config_set_replicaof_parsed);
    const config_set_replicaof_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_replicaof_command, 5000u64);
    try assert_eq_i32(config_set_replicaof_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_eq_i32(config_set_replicaof_reply.request_replicaof as i32, 1);
    try assert_eq_i32(config_set_replicaof_reply.replicaof_promote as i32, 0);
    try assert_eq_i32(config_set_replicaof_reply.replicaof_port, 6381);
    try assert_true(command_executor_test_slice_eq(config_set_replicaof_reply.config_after.replicaof_host[0: 9], &"127.0.0.1"[0: 9]));
    resp_value_free(&config_set_replicaof_parsed.value);

    var config_set_replicaof_none_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$9\r\nreplicaof\r\n$6\r\nNO ONE\r\n"[0: 52]);
    const config_set_replicaof_none_command: Command = try command_executor_test_command(&router, &config_set_replicaof_none_parsed);
    const config_set_replicaof_none_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_set_replicaof_none_command, 5000u64);
    try assert_eq_i32(config_set_replicaof_none_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_eq_i32(config_set_replicaof_none_reply.request_replicaof as i32, 1);
    try assert_eq_i32(config_set_replicaof_none_reply.replicaof_promote as i32, 1);
    try assert_eq_i32(config_set_replicaof_none_reply.config_after.replicaof_port, 0);
    resp_value_free(&config_set_replicaof_none_parsed.value);

    config_copy_bytes(runtime.config.dir[0: 256], &"build/"[0: 6]);
    config_copy_bytes(runtime.config.appendfilename[0: 128], &"build/test-command-config-rewrite.aof"[0: 37]);
    runtime.config.maxmemory = 1048576;
    runtime.config.maxmemory_policy = MaxmemoryPolicy.maxmemory_allkeys_lru;
    runtime.config.save_seconds = 60;
    runtime.config.save_changes = 10;
    config_copy_bytes(runtime.config.requirepass[0: 128], &"next"[0: 4]);

    var rewrite_path_buf: [byte: 512] = [];
    try config_rewrite_path(rewrite_path_buf[0: 512], &runtime.config);
    _ = unlink(&rewrite_path_buf[0] as &const byte);

    var config_rewrite_parsed: RespParseResult = try parse_resp2(&"*2\r\n$6\r\nCONFIG\r\n$7\r\nREWRITE\r\n"[0: 29]);
    const config_rewrite_command: Command = try command_executor_test_command(&router, &config_rewrite_parsed);
    const config_rewrite_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_rewrite_command, 5000u64);
    try assert_eq_i32(config_rewrite_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(config_rewrite_reply.data, &"OK"[0: 2]));
    resp_value_free(&config_rewrite_parsed.value);

    const rewritten_cfg: ServerConfig = try parse_config_file(&rewrite_path_buf[0] as &const byte);
    try assert_eq_i32(rewritten_cfg.port, runtime.config.port);
    try assert_eq_i32(rewritten_cfg.maxclients, runtime.config.maxclients);
    try assert_eq_i32(rewritten_cfg.databases, runtime.config.databases);
    try assert_eq_i32(rewritten_cfg.maxmemory as i32, 1048576);
    try assert_eq_i32(rewritten_cfg.maxmemory_policy as i32, MaxmemoryPolicy.maxmemory_allkeys_lru as i32);
    try assert_eq_i32(rewritten_cfg.save_seconds, 60);
    try assert_eq_i32(rewritten_cfg.save_changes, 10);
    try assert_true(command_executor_test_slice_eq(rewritten_cfg.requirepass[0: 4], &"next"[0: 4]));
    _ = unlink(&rewrite_path_buf[0] as &const byte);

    runtime.replication_role = ReplicationRole.role_replica;
    runtime.replication_state = ReplicationState.repl_state_configured;
    runtime.config.replicaof_host[0] = 49 as byte; // 1
    runtime.config.replicaof_host[1] = 50 as byte; // 2
    runtime.config.replicaof_host[2] = 55 as byte; // 7
    runtime.config.replicaof_host[3] = 46 as byte; // .
    runtime.config.replicaof_host[4] = 48 as byte; // 0
    runtime.config.replicaof_host[5] = 46 as byte; // .
    runtime.config.replicaof_host[6] = 48 as byte; // 0
    runtime.config.replicaof_host[7] = 46 as byte; // .
    runtime.config.replicaof_host[8] = 49 as byte; // 1
    runtime.config.replicaof_host[9] = 0 as byte;
    runtime.config.replicaof_port = 6381;
    runtime.config.masterauth[0] = 115 as byte; // s
    runtime.config.masterauth[1] = 101 as byte; // e
    runtime.config.masterauth[2] = 99 as byte;  // c
    runtime.config.masterauth[3] = 114 as byte; // r
    runtime.config.masterauth[4] = 101 as byte; // e
    runtime.config.masterauth[5] = 116 as byte; // t
    runtime.config.masterauth[6] = 0 as byte;
    runtime.config.requirepass[0] = 108 as byte; // l
    runtime.config.requirepass[1] = 111 as byte; // o
    runtime.config.requirepass[2] = 99 as byte;  // c
    runtime.config.requirepass[3] = 107 as byte; // k
    runtime.config.requirepass[4] = 0 as byte;

    var info_repl_replica_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nINFO\r\n$11\r\nreplication\r\n"[0: 32]);
    const info_repl_replica_command: Command = try command_executor_test_command(&router, &info_repl_replica_parsed);
    var info_repl_replica_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &info_repl_replica_command, 5000u64);
    try assert_eq_i32(info_repl_replica_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_contains(info_repl_replica_reply.data, &"role:slave\r\n"[0: 12]));
    command_reply_cleanup(&info_repl_replica_reply);
    resp_value_free(&info_repl_replica_parsed.value);

    var config_replicaof_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$9\r\nreplicaof\r\n"[0: 40]);
    const config_replicaof_command: Command = try command_executor_test_command(&router, &config_replicaof_parsed);
    var config_replicaof_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_replicaof_command, 5000u64);
    const config_replicaof_len: usize = try connection_encode_reply(&config_replicaof_reply, &out[0], 512);
    try assert_true(config_replicaof_len > 0);
    try assert_eq_i32(out[0] as i32, 42);
    command_reply_cleanup(&config_replicaof_reply);
    resp_value_free(&config_replicaof_parsed.value);

    var config_masterauth_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$10\r\nmasterauth\r\n"[0: 42]);
    const config_masterauth_command: Command = try command_executor_test_command(&router, &config_masterauth_parsed);
    var config_masterauth_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_masterauth_command, 5000u64);
    const config_masterauth_len: usize = try connection_encode_reply(&config_masterauth_reply, &out[0], 512);
    try assert_true(config_masterauth_len > 0);
    try assert_eq_i32(out[0] as i32, 42);
    command_reply_cleanup(&config_masterauth_reply);
    resp_value_free(&config_masterauth_parsed.value);

    var config_requirepass_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$11\r\nrequirepass\r\n"[0: 43]);
    const config_requirepass_command: Command = try command_executor_test_command(&router, &config_requirepass_parsed);
    var config_requirepass_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &config_requirepass_command, 5000u64);
    const config_requirepass_len: usize = try connection_encode_reply(&config_requirepass_reply, &out[0], 512);
    try assert_true(config_requirepass_len > 0);
    try assert_eq_i32(out[0] as i32, 42);
    command_reply_cleanup(&config_requirepass_reply);
    resp_value_free(&config_requirepass_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_command_catalog_core() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();

    var count_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nCOMMAND\r\n$5\r\nCOUNT\r\n"[0: 28]);
    const count_command: Command = try command_executor_test_command(&router, &count_parsed);
    const count_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &count_command, 1000u64);
    try assert_eq_i32(count_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_true(count_reply.integer > 0);
    resp_value_free(&count_parsed.value);

    var list_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nCOMMAND\r\n$4\r\nLIST\r\n$8\r\nFILTERBY\r\n$7\r\nPATTERN\r\n$3\r\nCL*\r\n"[0: 63]);
    const list_command: Command = try command_executor_test_command(&router, &list_parsed);
    var list_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &list_command, 1000u64);
    try assert_eq_i32(list_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_contains(list_reply.data, &"$6\r\nclient\r\n"[0: 12]));
    try assert_true(command_executor_test_contains(list_reply.data, &"$7\r\ncluster\r\n"[0: 13]));
    command_reply_cleanup(&list_reply);
    resp_value_free(&list_parsed.value);

    var info_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nCOMMAND\r\n$4\r\nINFO\r\n$3\r\nGET\r\n$3\r\nFOO\r\n$9\r\nCLIENT|ID\r\n"[0: 60]);
    const info_command: Command = try command_executor_test_command(&router, &info_parsed);
    var info_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &info_command, 1000u64);
    try assert_eq_i32(info_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_starts_with(info_reply.data, &"*3\r\n"[0: 4]));
    try assert_true(command_executor_test_contains(info_reply.data, &"$3\r\nget\r\n"[0: 9]));
    try assert_true(command_executor_test_contains(info_reply.data, &"$9\r\nclient|id\r\n"[0: 15]));
    try assert_true(command_executor_test_contains(info_reply.data, &"$-1\r\n"[0: 5]));
    command_reply_cleanup(&info_reply);
    resp_value_free(&info_parsed.value);

    var info_unsupported_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nCOMMAND\r\n$4\r\nINFO\r\n$13\r\nFUNCTION|LOAD\r\n$6\r\nBLMOVE\r\n$13\r\nCLUSTER|RESET\r\n"[0: 79]);
    const info_unsupported_command: Command = try command_executor_test_command(&router, &info_unsupported_parsed);
    var info_unsupported_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &info_unsupported_command, 1000u64);
    try assert_eq_i32(info_unsupported_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(info_unsupported_reply.data, &"*3\r\n$-1\r\n$-1\r\n$-1\r\n"[0: 19]));
    command_reply_cleanup(&info_unsupported_reply);
    resp_value_free(&info_unsupported_parsed.value);

    var docs_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nCOMMAND\r\n$4\r\nDOCS\r\n$3\r\nGET\r\n$3\r\nFOO\r\n"[0: 45]);
    const docs_command: Command = try command_executor_test_command(&router, &docs_parsed);
    var docs_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &docs_command, 1000u64);
    try assert_eq_i32(docs_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_starts_with(docs_reply.data, &"*2\r\n"[0: 4]));
    try assert_true(command_executor_test_contains(docs_reply.data, &"$3\r\nget\r\n"[0: 9]));
    try assert_true(command_executor_test_contains(docs_reply.data, &"$7\r\nsummary\r\n"[0: 13]));
    command_reply_cleanup(&docs_reply);
    resp_value_free(&docs_parsed.value);

    var docs_all_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nCOMMAND\r\n$4\r\nDOCS\r\n"[0: 27]);
    const docs_all_command: Command = try command_executor_test_command(&router, &docs_all_parsed);
    var docs_all_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &docs_all_command, 1000u64);
    try assert_eq_i32(docs_all_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    const docs_all_len: u64 = try command_executor_test_parse_resp2_collection_len(docs_all_reply.data, 42 as byte);
    try assert_true(command_executor_test_contains(docs_all_reply.data, &"$3\r\nget\r\n"[0: 9]));
    try assert_true(command_executor_test_contains(docs_all_reply.data, &"$9\r\nclient|id\r\n"[0: 15]));
    try assert_true(command_executor_test_contains(docs_all_reply.data, &"$7\r\nsummary\r\n"[0: 13]));
    command_reply_cleanup(&docs_all_reply);
    resp_value_free(&docs_all_parsed.value);

    var docs_unsupported_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nCOMMAND\r\n$4\r\nDOCS\r\n$13\r\nFUNCTION|LOAD\r\n$6\r\nBLMOVE\r\n$13\r\nCLUSTER|RESET\r\n"[0: 79]);
    const docs_unsupported_command: Command = try command_executor_test_command(&router, &docs_unsupported_parsed);
    var docs_unsupported_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &docs_unsupported_command, 1000u64);
    try assert_eq_i32(docs_unsupported_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(docs_unsupported_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&docs_unsupported_reply);
    resp_value_free(&docs_unsupported_parsed.value);

    runtime.protocol_version = 3;
    var docs_resp3_parsed: RespParseResult = try parse_resp2(&"*3\r\n$7\r\nCOMMAND\r\n$4\r\nDOCS\r\n$3\r\nGET\r\n"[0: 36]);
    const docs_resp3_command: Command = try command_executor_test_command(&router, &docs_resp3_parsed);
    var docs_resp3_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &docs_resp3_command, 1000u64);
    try assert_eq_i32(docs_resp3_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_starts_with(docs_resp3_reply.data, &"%1\r\n"[0: 4]));
    command_reply_cleanup(&docs_resp3_reply);
    resp_value_free(&docs_resp3_parsed.value);

    var docs_all_resp3_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nCOMMAND\r\n$4\r\nDOCS\r\n"[0: 27]);
    const docs_all_resp3_command: Command = try command_executor_test_command(&router, &docs_all_resp3_parsed);
    var docs_all_resp3_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &docs_all_resp3_command, 1000u64);
    try assert_eq_i32(docs_all_resp3_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    const docs_all_resp3_len: u64 = try command_executor_test_parse_resp2_collection_len(docs_all_resp3_reply.data, 37 as byte);
    try assert_eq_u64(docs_all_len, docs_all_resp3_len * 2u64);
    try assert_true(command_executor_test_contains(docs_all_resp3_reply.data, &"$3\r\nget\r\n"[0: 9]));
    try assert_true(command_executor_test_contains(docs_all_resp3_reply.data, &"$9\r\nclient|id\r\n"[0: 15]));
    command_reply_cleanup(&docs_all_resp3_reply);
    resp_value_free(&docs_all_resp3_parsed.value);
    runtime.protocol_version = 2;

    var root_parsed: RespParseResult = try parse_resp2(&"*1\r\n$7\r\nCOMMAND\r\n"[0: 17]);
    const root_command: Command = try command_executor_test_command(&router, &root_parsed);
    var root_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &root_command, 1000u64);
    try assert_eq_i32(root_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    const root_len: u64 = try command_executor_test_parse_resp2_collection_len(root_reply.data, 42 as byte);
    try assert_eq_i32(count_reply.integer as i32, root_len as i32);
    try assert_true(command_executor_test_contains(root_reply.data, &"$7\r\ncommand\r\n"[0: 13]));
    command_reply_cleanup(&root_reply);
    resp_value_free(&root_parsed.value);

    var list_hidden_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nCOMMAND\r\n$4\r\nLIST\r\n$8\r\nFILTERBY\r\n$7\r\nPATTERN\r\n$4\r\nBLM*\r\n"[0: 64]);
    const list_hidden_command: Command = try command_executor_test_command(&router, &list_hidden_parsed);
    var list_hidden_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &list_hidden_command, 1000u64);
    try assert_eq_i32(list_hidden_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(list_hidden_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&list_hidden_reply);
    resp_value_free(&list_hidden_parsed.value);

    try command_executor_test_assert_catalog_status(&"acl"[0: 3], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|cat"[0: 7], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|deluser"[0: 11], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|dryrun"[0: 10], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|genpass"[0: 11], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|getuser"[0: 11], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|help"[0: 8], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|list"[0: 8], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|load"[0: 8], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|log"[0: 7], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|save"[0: 8], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|setuser"[0: 11], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|users"[0: 9], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"acl|whoami"[0: 10], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"config|set"[0: 10], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"config|rewrite"[0: 14], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"client|kill"[0: 11], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"client|pause"[0: 12], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"client|unpause"[0: 14], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"client|tracking"[0: 15], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"client|trackinginfo"[0: 19], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"eval_ro"[0: 7], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"evalsha_ro"[0: 10], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"fcall"[0: 5], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"fcall_ro"[0: 8], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"function"[0: 8], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"function|delete"[0: 15], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"function|dump"[0: 13], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"function|flush"[0: 14], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"function|help"[0: 13], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"function|kill"[0: 13], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"function|list"[0: 13], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"function|stats"[0: 14], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xack"[0: 4], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xclaim"[0: 6], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xgroup"[0: 6], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xgroup|create"[0: 13], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xgroup|destroy"[0: 14], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xgroup|help"[0: 11], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xgroup|setid"[0: 12], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xinfo"[0: 5], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xinfo|consumers"[0: 15], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xinfo|groups"[0: 12], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xinfo|help"[0: 10], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xinfo|stream"[0: 12], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"xpending"[0: 8], CommandCatalogStatus.status_partial);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_acl_help() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 2048] = [];

    var help_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nACL\r\n$4\r\nHELP\r\n"[0: 23]);
    const help_command: Command = try command_executor_test_command(&router, &help_parsed);
    var help_reply: CommandReply = command_execute_at(&engine, &help_command, 1000u64);
    const help_len: usize = try connection_encode_reply(&help_reply, &out[0], 2048);
    try assert_true(command_executor_test_contains(out[0: help_len], &"ACL <subcommand> [<arg> [value] [opt] ...]. Subcommands are:"[0: 60]));
    try assert_true(command_executor_test_contains(out[0: help_len], &"CAT [<category>]"[0: 16]));
    try assert_true(command_executor_test_contains(out[0: help_len], &"SETUSER <username> <attribute> [<attribute> ...]"[0: 48]));
    try assert_true(command_executor_test_contains(out[0: help_len], &"WHOAMI"[0: 6]));
    command_reply_cleanup(&help_reply);
    resp_value_free(&help_parsed.value);

    var extra_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$4\r\nHELP\r\n$1\r\nX\r\n"[0: 30]);
    const extra_command: Command = try command_executor_test_command(&router, &extra_parsed);
    var extra_reply: CommandReply = command_execute_at(&engine, &extra_command, 1000u64);
    try assert_eq_i32(extra_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(extra_reply.data, &"ERR wrong number of arguments for 'acl|help' command"[0: 52]));
    command_reply_cleanup(&extra_reply);
    resp_value_free(&extra_parsed.value);

    var unknown_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nACL\r\n$1\r\nX\r\n"[0: 20]);
    const unknown_command: Command = try command_executor_test_command(&router, &unknown_parsed);
    var unknown_reply: CommandReply = command_execute_at(&engine, &unknown_command, 1000u64);
    try assert_eq_i32(unknown_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(unknown_reply.data, &"ERR unknown subcommand 'X'. Try ACL HELP."[0: 41]));
    command_reply_cleanup(&unknown_reply);
    resp_value_free(&unknown_parsed.value);

    var whoami_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nACL\r\n$6\r\nWHOAMI\r\n"[0: 25]);
    const whoami_command: Command = try command_executor_test_command(&router, &whoami_parsed);
    var whoami_reply: CommandReply = command_execute_at(&engine, &whoami_command, 1000u64);
    try assert_eq_i32(whoami_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(whoami_reply.data, &"default"[0: 7]));
    command_reply_cleanup(&whoami_reply);
    resp_value_free(&whoami_parsed.value);

    var whoami_extra_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$6\r\nWHOAMI\r\n$1\r\nX\r\n"[0: 32]);
    const whoami_extra_command: Command = try command_executor_test_command(&router, &whoami_extra_parsed);
    var whoami_extra_reply: CommandReply = command_execute_at(&engine, &whoami_extra_command, 1000u64);
    try assert_eq_i32(whoami_extra_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(whoami_extra_reply.data, &"ERR wrong number of arguments for 'acl|whoami' command"[0: 54]));
    command_reply_cleanup(&whoami_extra_reply);
    resp_value_free(&whoami_extra_parsed.value);

    var users_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nACL\r\n$5\r\nUSERS\r\n"[0: 24]);
    const users_command: Command = try command_executor_test_command(&router, &users_parsed);
    var users_reply: CommandReply = command_execute_at(&engine, &users_command, 1000u64);
    const users_len: usize = try connection_encode_reply(&users_reply, &out[0], 2048);
    try assert_true(command_executor_test_slice_eq(out[0: users_len], &"*1\r\n$7\r\ndefault\r\n"[0: 17]));
    command_reply_cleanup(&users_reply);
    resp_value_free(&users_parsed.value);

    var users_extra_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$5\r\nUSERS\r\n$1\r\nX\r\n"[0: 31]);
    const users_extra_command: Command = try command_executor_test_command(&router, &users_extra_parsed);
    var users_extra_reply: CommandReply = command_execute_at(&engine, &users_extra_command, 1000u64);
    try assert_eq_i32(users_extra_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(users_extra_reply.data, &"ERR wrong number of arguments for 'acl|users' command"[0: 53]));
    command_reply_cleanup(&users_extra_reply);
    resp_value_free(&users_extra_parsed.value);

    var list_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nACL\r\n$4\r\nLIST\r\n"[0: 23]);
    const list_command: Command = try command_executor_test_command(&router, &list_parsed);
    var list_reply: CommandReply = command_execute_at(&engine, &list_command, 1000u64);
    const list_len: usize = try connection_encode_reply(&list_reply, &out[0], 2048);
    try assert_true(command_executor_test_slice_eq(out[0: list_len], &"*1\r\n$34\r\nuser default on nopass ~* &* +@all\r\n"[0: 45]));
    command_reply_cleanup(&list_reply);
    resp_value_free(&list_parsed.value);

    var list_extra_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$4\r\nLIST\r\n$1\r\nX\r\n"[0: 30]);
    const list_extra_command: Command = try command_executor_test_command(&router, &list_extra_parsed);
    var list_extra_reply: CommandReply = command_execute_at(&engine, &list_extra_command, 1000u64);
    try assert_eq_i32(list_extra_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(list_extra_reply.data, &"ERR wrong number of arguments for 'acl|list' command"[0: 52]));
    command_reply_cleanup(&list_extra_reply);
    resp_value_free(&list_extra_parsed.value);

    var cat_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nACL\r\n$3\r\nCAT\r\n"[0: 22]);
    const cat_command: Command = try command_executor_test_command(&router, &cat_parsed);
    var cat_reply: CommandReply = command_execute_at(&engine, &cat_command, 1000u64);
    const cat_len: usize = try connection_encode_reply(&cat_reply, &out[0], 2048);
    try assert_true(command_executor_test_contains(out[0: cat_len], &"$6\r\nstring\r\n"[0: 11]));
    try assert_true(command_executor_test_contains(out[0: cat_len], &"$11\r\ntransaction\r\n"[0: 18]));
    command_reply_cleanup(&cat_reply);
    resp_value_free(&cat_parsed.value);

    var cat_string_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$3\r\nCAT\r\n$6\r\nstring\r\n"[0: 34]);
    const cat_string_command: Command = try command_executor_test_command(&router, &cat_string_parsed);
    var cat_string_reply: CommandReply = command_execute_at(&engine, &cat_string_command, 1000u64);
    const cat_string_len: usize = try connection_encode_reply(&cat_string_reply, &out[0], 2048);
    try assert_true(command_executor_test_contains(out[0: cat_string_len], &"$3\r\nget\r\n"[0: 9]));
    try assert_true(command_executor_test_contains(out[0: cat_string_len], &"$3\r\nset\r\n"[0: 9]));
    command_reply_cleanup(&cat_string_reply);
    resp_value_free(&cat_string_parsed.value);

    var cat_at_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$3\r\nCAT\r\n$7\r\n@string\r\n"[0: 35]);
    const cat_at_command: Command = try command_executor_test_command(&router, &cat_at_parsed);
    var cat_at_reply: CommandReply = command_execute_at(&engine, &cat_at_command, 1000u64);
    try assert_eq_i32(cat_at_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(cat_at_reply.data, &"ERR Unknown category '@string'"[0: 30]));
    command_reply_cleanup(&cat_at_reply);
    resp_value_free(&cat_at_parsed.value);

    var cat_extra_parsed: RespParseResult = try parse_resp2(&"*4\r\n$3\r\nACL\r\n$3\r\nCAT\r\n$6\r\nstring\r\n$1\r\nX\r\n"[0: 41]);
    const cat_extra_command: Command = try command_executor_test_command(&router, &cat_extra_parsed);
    var cat_extra_reply: CommandReply = command_execute_at(&engine, &cat_extra_command, 1000u64);
    try assert_eq_i32(cat_extra_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(cat_extra_reply.data, &"ERR unknown subcommand or wrong number of arguments for 'cat'. Try ACL HELP."[0: 76]));
    command_reply_cleanup(&cat_extra_reply);
    resp_value_free(&cat_extra_parsed.value);

    var getuser_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n"[0: 39]);
    const getuser_command: Command = try command_executor_test_command(&router, &getuser_parsed);
    var getuser_reply: CommandReply = command_execute_at(&engine, &getuser_command, 1000u64);
    try assert_eq_i32(getuser_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_contains(getuser_reply.data, &"$5\r\nflags\r\n*2\r\n$2\r\non\r\n$6\r\nnopass\r\n"[0: 35]));
    try assert_true(command_executor_test_contains(getuser_reply.data, &"$8\r\ncommands\r\n$5\r\n+@all\r\n"[0: 25]));
    try assert_true(command_executor_test_contains(getuser_reply.data, &"$9\r\nselectors\r\n*0\r\n"[0: 19]));
    command_reply_cleanup(&getuser_reply);
    resp_value_free(&getuser_parsed.value);

    var getuser_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\nmissing\r\n"[0: 39]);
    const getuser_missing_command: Command = try command_executor_test_command(&router, &getuser_missing_parsed);
    var getuser_missing_reply: CommandReply = command_execute_at(&engine, &getuser_missing_command, 1000u64);
    try assert_eq_i32(getuser_missing_reply.typ as i32, CommandReplyType.reply_null_bulk as i32);
    command_reply_cleanup(&getuser_missing_reply);
    resp_value_free(&getuser_missing_parsed.value);

    var getuser_short_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n"[0: 26]);
    const getuser_short_command: Command = try command_executor_test_command(&router, &getuser_short_parsed);
    var getuser_short_reply: CommandReply = command_execute_at(&engine, &getuser_short_command, 1000u64);
    try assert_eq_i32(getuser_short_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(getuser_short_reply.data, &"ERR wrong number of arguments for 'acl|getuser' command"[0: 55]));
    command_reply_cleanup(&getuser_short_reply);
    resp_value_free(&getuser_short_parsed.value);

    var getuser_extra_parsed: RespParseResult = try parse_resp2(&"*4\r\n$3\r\nACL\r\n$7\r\nGETUSER\r\n$7\r\ndefault\r\n$1\r\nX\r\n"[0: 46]);
    const getuser_extra_command: Command = try command_executor_test_command(&router, &getuser_extra_parsed);
    var getuser_extra_reply: CommandReply = command_execute_at(&engine, &getuser_extra_command, 1000u64);
    try assert_eq_i32(getuser_extra_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(getuser_extra_reply.data, &"ERR wrong number of arguments for 'acl|getuser' command"[0: 55]));
    command_reply_cleanup(&getuser_extra_reply);
    resp_value_free(&getuser_extra_parsed.value);

    var log_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nACL\r\n$3\r\nLOG\r\n"[0: 22]);
    const log_command: Command = try command_executor_test_command(&router, &log_parsed);
    var log_reply: CommandReply = command_execute_at(&engine, &log_command, 1000u64);
    try assert_eq_i32(log_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(log_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&log_reply);
    resp_value_free(&log_parsed.value);

    var log_count_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$3\r\nLOG\r\n$2\r\n10\r\n"[0: 30]);
    const log_count_command: Command = try command_executor_test_command(&router, &log_count_parsed);
    var log_count_reply: CommandReply = command_execute_at(&engine, &log_count_command, 1000u64);
    try assert_eq_i32(log_count_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(log_count_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&log_count_reply);
    resp_value_free(&log_count_parsed.value);

    var log_reset_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$3\r\nLOG\r\n$5\r\nRESET\r\n"[0: 33]);
    const log_reset_command: Command = try command_executor_test_command(&router, &log_reset_parsed);
    var log_reset_reply: CommandReply = command_execute_at(&engine, &log_reset_command, 1000u64);
    try assert_eq_i32(log_reset_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(log_reset_reply.data, &"OK"[0: 2]));
    command_reply_cleanup(&log_reset_reply);
    resp_value_free(&log_reset_parsed.value);

    var log_bad_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nACL\r\n$3\r\nLOG\r\n$1\r\nx\r\n"[0: 29]);
    const log_bad_command: Command = try command_executor_test_command(&router, &log_bad_parsed);
    var log_bad_reply: CommandReply = command_execute_at(&engine, &log_bad_command, 1000u64);
    try assert_eq_i32(log_bad_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(log_bad_reply.data, &"ERR value is not an integer or out of range"[0: 43]));
    command_reply_cleanup(&log_bad_reply);
    resp_value_free(&log_bad_parsed.value);

    var log_extra_parsed: RespParseResult = try parse_resp2(&"*4\r\n$3\r\nACL\r\n$3\r\nLOG\r\n$1\r\n1\r\n$1\r\n2\r\n"[0: 36]);
    const log_extra_command: Command = try command_executor_test_command(&router, &log_extra_parsed);
    var log_extra_reply: CommandReply = command_execute_at(&engine, &log_extra_command, 1000u64);
    try assert_eq_i32(log_extra_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(log_extra_reply.data, &"ERR unknown subcommand or wrong number of arguments for 'log'. Try ACL HELP."[0: 76]));
    command_reply_cleanup(&log_extra_reply);
    resp_value_free(&log_extra_parsed.value);

    var genpass_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nACL\r\n$7\r\nGENPASS\r\n"[0: 26]);
    const genpass_command: Command = try command_executor_test_command(&router, &genpass_parsed);
    var genpass_reply: CommandReply = command_execute_at(&engine, &genpass_command, 1000u64);
    try assert_eq_i32(genpass_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_eq_i32(genpass_reply.data.len as i32, 64);
    try assert_true(command_executor_test_is_lower_hex(genpass_reply.data));
    command_reply_cleanup(&genpass_reply);
    resp_value_free(&genpass_parsed.value);

