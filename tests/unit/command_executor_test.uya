    resp_value_free(&ltrim_parsed.value);

    var lrange_after_ltrim_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nLRANGE\r\n$5\r\nwlist\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 42]);
