export fn test_command_linsert_ltrim_lrem() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var rpush_parsed: RespParseResult = try parse_resp2(&"*7\r\n$5\r\nRPUSH\r\n$5\r\nwlist\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n$1\r\nb\r\n$1\r\nd\r\n"[0: 61]);
