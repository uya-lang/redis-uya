        return command_executor_wrong_arity();
    };
    const max_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(max_data) catch {
        return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
    };
    const min_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(min_data) catch {
        return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
    };

    var limit_enabled: bool = false;
    var limit_offset: usize = 0;
    var limit_count: i64 = -1;
    if command.argc == 7 {
        const limit_keyword: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(limit_keyword, &"LIMIT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const offset_data: &[byte] = command_executor_arg(command, 5) catch {
            return command_executor_wrong_arity();
        };
        const count_data: &[byte] = command_executor_arg(command, 6) catch {
            return command_executor_wrong_arity();
        };
        const offset_i64: i64 = command_executor_parse_i64(offset_data) catch {
            return command_executor_invalid_integer();
        };
        if offset_i64 < 0 {
            return command_executor_error(&"ERR offset out of range"[0: 23]);
        }
        limit_enabled = true;
        limit_offset = offset_i64 as usize;
        limit_count = command_executor_parse_i64(count_data) catch {
            return command_executor_invalid_integer();
        };
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    return command_executor_zlex_range_reply(obj, &min_bound, &max_bound, true, limit_enabled, limit_offset, limit_count);
}

fn command_executor_zremrangebylex(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const min_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const max_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const min_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(min_data) catch {
        return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
    };
    const max_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(max_data) catch {
        return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
    };

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    const sorted_members: &RedisObject = zset_object_range_reply(obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var removed: i64 = 0;
    var node: &ListNode = sorted_members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        if command_executor_zlex_member_in_range(member, &min_bound, &max_bound) {
            const deleted: bool = zset_object_remove_member(obj, member) catch {
                object_free(sorted_members);
                return command_executor_wrongtype();
            };
            if deleted {
                removed = removed + 1;
            }
        }
        node = node.next;
    }
    object_free(sorted_members);
    if removed > 0 {
        const remaining: usize = zset_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if remaining == 0 {
            _ = delete_key(engine, key);
        } else {
            _ = touch_key_watch_version(engine, key) catch {};
        }
    }
    return command_executor_integer(removed);
}

fn command_executor_zset_score_or_missing(obj: &RedisObject, member: &[byte], score_out: &i64) !bool {
    const score_result: !i64 = zset_object_get_score(obj, member);
    const score: i64 = score_result catch |err| {
        if err == error.ObjectFieldNotFound {
            return false;
        }
        return err;
    };
    *score_out = score;
    return true;
}

fn command_executor_zrank_withscore_reply(rank: i64, score: i64) CommandReply {
    var score_buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&score_buf);
    }
    _ = command_executor_info_append_i64(&score_buf, &"%i"[0: 2], score) catch {
        return command_executor_oom();
    };

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = sds_cat(&raw, &"*2\r\n"[0: 4]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append_i64(&raw, &":%i\r\n"[0: 5], rank) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append_u64(&raw, &"$%u\r\n"[0: 5], score_buf.len as u64) catch {
        return command_executor_oom();
    };
    _ = sds_cat(&raw, score_buf.buf[0: score_buf.len]) catch {
        return command_executor_oom();
    };
    _ = sds_cat(&raw, &"\r\n"[0: 2]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_zrank(engine: &Engine, command: &Command, now_ms: u64, reverse: bool) CommandReply {
    if command.argc != 3 && command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const member: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };

    var withscore: bool = false;
    if command.argc == 4 {
        const option: &[byte] = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(option, &"WITHSCORE"[0: 9]) {
            return command_executor_syntax_error();
        }
        withscore = true;
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    var rank: i64 = zset_object_rank(obj, member) catch |err| {
        if err == error.ObjectFieldNotFound {
            return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
        }
        return command_executor_wrongtype();
    };
    if reverse {
        const total: usize = zset_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        rank = total as i64 - rank - 1;
    }
    if !withscore {
        return command_executor_integer(rank);
    }

    const score: i64 = zset_object_get_score(obj, member) catch |err| {
        if err == error.ObjectFieldNotFound {
            return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
        }
        return command_executor_wrongtype();
    };
    return command_executor_zrank_withscore_reply(rank, score);
}

fn command_executor_zscore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const member: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    const score: i64 = zset_object_get_score(obj, member) catch |err| {
        if err == error.ObjectFieldNotFound {
            return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
        }
        return command_executor_wrongtype();
    };
    return command_executor_bulk_i64(score);
}

fn command_executor_zmscore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const obj: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    if obj != null && obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    const reply_list: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    var null_map: Sds = sds_empty() catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    defer {
        sds_free(&null_map);
    }

    var index: usize = 2;
    while index < command.argc {
        const member: &[byte] = command_executor_arg(command, index) catch {
            object_free(reply_list);
            return command_executor_wrong_arity();
        };
        var is_null: bool = obj == null;
        var score: i64 = 0;
        if !is_null {
            const found: bool = command_executor_zset_score_or_missing(obj, member, &score) catch {
                object_free(reply_list);
                return command_executor_wrongtype();
            };
            is_null = !found;
        }

        if is_null {
            _ = list_object_push_tail(reply_list, command_executor_empty_slice()) catch {
                object_free(reply_list);
                return command_executor_oom();
            };
        } else {
            _ = command_executor_list_push_i64(reply_list, score) catch {
                object_free(reply_list);
                return command_executor_oom();
            };
        }

        var flag: [byte: 1] = [];
        if is_null {
            flag[0] = 1 as byte;
        } else {
            flag[0] = 0 as byte;
        }
        _ = sds_cat(&null_map, flag[0: 1]) catch {
            object_free(reply_list);
            return command_executor_oom();
        };
        index = index + 1;
    }

    const null_map_obj: &RedisObject = create_string_object(null_map.buf[0: null_map.len]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    var reply: CommandReply = command_executor_nullable_array_bulk(reply_list.list_head, command.argc - 2, null_map_obj);
    reply.owned_object = reply_list;
    return reply;
}

fn command_executor_zpop_key(engine: &Engine, key: &[byte], requested_count: usize, now_ms: u64, reverse: bool) CommandReply {
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    const sorted_members: &RedisObject = zset_object_range_reply(obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const available: usize = list_object_len(sorted_members) catch {
        object_free(sorted_members);
        return command_executor_wrongtype();
    };
    if available == 0 {
        object_free(sorted_members);
        return command_executor_array_bulk(null as &ListNode, 0);
    }

    var actual_count: usize = requested_count;
    if actual_count > available {
        actual_count = available;
    }

    const reply_list: &RedisObject = create_list_object() catch {
        object_free(sorted_members);
        return command_executor_oom();
    };

    var build_node: &ListNode = sorted_members.list_head;
    if reverse {
        build_node = sorted_members.list_tail;
    }
    var built: usize = 0;
    while build_node != null && built < actual_count {
        const member: &[byte] = build_node.value.value.buf[0: build_node.value.value.len];
        const score: i64 = zset_object_get_score(obj, member) catch {
            object_free(sorted_members);
            object_free(reply_list);
            return command_executor_wrongtype();
        };
        _ = list_object_push_tail(reply_list, member) catch {
            object_free(sorted_members);
            object_free(reply_list);
            return command_executor_oom();
        };
        _ = command_executor_list_push_i64(reply_list, score) catch {
            object_free(sorted_members);
            object_free(reply_list);
            return command_executor_oom();
        };
        if reverse {
            build_node = build_node.prev;
        } else {
            build_node = build_node.next;
        }
        built = built + 1;
    }

    var remove_node: &ListNode = sorted_members.list_head;
    if reverse {
        remove_node = sorted_members.list_tail;
    }
    var removed: usize = 0;
    while remove_node != null && removed < built {
        const member: &[byte] = remove_node.value.value.buf[0: remove_node.value.value.len];
        _ = zset_object_remove_member(obj, member) catch {
            object_free(sorted_members);
            object_free(reply_list);
            return command_executor_wrongtype();
        };
        if reverse {
            remove_node = remove_node.prev;
        } else {
            remove_node = remove_node.next;
        }
        removed = removed + 1;
    }
    object_free(sorted_members);

    const remaining: usize = zset_object_len(obj) catch {
        object_free(reply_list);
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, key);
    }
    return command_executor_owned_array(reply_list);
}

fn command_executor_zpop(engine: &Engine, command: &Command, now_ms: u64, reverse: bool) CommandReply {
    if command.argc != 2 && command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    var requested_count: usize = 1;
    if command.argc == 3 {
        const count_data: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
        const count_i64: i64 = command_executor_parse_i64(count_data) catch {
            return command_executor_invalid_integer();
        };
        if count_i64 < 0 {
            return command_executor_error(&"ERR value is out of range, must be positive"[0: 43]);
        }
        requested_count = count_i64 as usize;
        if requested_count == 0 {
            return command_executor_array_bulk(null as &ListNode, 0);
        }
    }

    return command_executor_zpop_key(engine, key, requested_count, now_ms, reverse);
}

fn command_executor_zrandmember(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 || command.argc > 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    var count_enabled: bool = false;
    var allow_duplicates: bool = false;
    var requested_count: usize = 1;
    var withscores: bool = false;
    if command.argc >= 3 {
        count_enabled = true;
        const count_data: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
        const count_i64: i64 = command_executor_parse_i64(count_data) catch {
            return command_executor_invalid_integer();
        };
        if count_i64 < 0 {
            allow_duplicates = true;
            requested_count = (0 - count_i64) as usize;
        } else {
            requested_count = count_i64 as usize;
        }
    }
    if command.argc == 4 {
        const option: &[byte] = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(option, &"WITHSCORES"[0: 10]) {
            return command_executor_syntax_error();
        }
        withscores = true;
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        if count_enabled {
            return command_executor_array_bulk(null as &ListNode, 0);
        }
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    const sorted_members: &RedisObject = zset_object_range_reply(obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const available: usize = list_object_len(sorted_members) catch {
        object_free(sorted_members);
        return command_executor_wrongtype();
    };
    if available == 0 {
        object_free(sorted_members);
        if count_enabled {
            return command_executor_array_bulk(null as &ListNode, 0);
        }
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    }
    if !count_enabled {
        const member: &[byte] = sorted_members.list_head.value.value.buf[0: sorted_members.list_head.value.value.len];
        const reply_obj: &RedisObject = create_string_object(member) catch {
            object_free(sorted_members);
            return command_executor_oom();
        };
        object_free(sorted_members);
        const data: &[byte] = reply_obj.value.buf[0: reply_obj.value.len];
        var reply: CommandReply = command_executor_bulk(data);
        reply.owned_object = reply_obj;
        return reply;
    }
    if requested_count == 0 {
        object_free(sorted_members);
        return command_executor_array_bulk(null as &ListNode, 0);
    }

    var actual_count: usize = requested_count;
    if !allow_duplicates && actual_count > available {
        actual_count = available;
    }
    const reply_list: &RedisObject = create_list_object() catch {
        object_free(sorted_members);
        return command_executor_oom();
    };
    var emitted: usize = 0;
    var node: &ListNode = sorted_members.list_head;
    while emitted < actual_count {
        if node == null {
            node = sorted_members.list_head;
        }
        const member_data: &[byte] = node.value.value.buf[0: node.value.value.len];
        _ = list_object_push_tail(reply_list, member_data) catch {
            object_free(sorted_members);
            object_free(reply_list);
            return command_executor_oom();
        };
        if withscores {
            const score: i64 = zset_object_get_score(obj, member_data) catch {
                object_free(sorted_members);
                object_free(reply_list);
                return command_executor_wrongtype();
            };
            _ = command_executor_list_push_i64(reply_list, score) catch {
                object_free(sorted_members);
                object_free(reply_list);
                return command_executor_oom();
            };
        }
        node = node.next;
        emitted = emitted + 1;
    }
    object_free(sorted_members);
    return command_executor_owned_array(reply_list);
}

fn command_executor_bzpop(engine: &Engine, command: &Command, now_ms: u64, reverse: bool) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const timeout_data: &[byte] = command_executor_arg(command, command.argc - 1) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_validate_blocking_timeout(timeout_data) catch {
        return command_executor_error(&"ERR value is not a valid float"[0: 30]);
    };

    var index: usize = 1;
    while index + 1 < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        if obj_result.error_id != 0 {
            index = index + 1;
            continue;
        }
        const obj: &RedisObject = obj_result.value;
        if obj.obj_type != ObjectType.object_zset {
            return command_executor_wrongtype();
        }
        const zset_len: usize = zset_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if zset_len == 0 {
            index = index + 1;
            continue;
        }

        const zpop_reply: CommandReply = command_executor_zpop_key(engine, key, 1, now_ms, reverse);
        if zpop_reply.typ == CommandReplyType.reply_error || zpop_reply.typ == CommandReplyType.reply_null_array {
            return zpop_reply;
        }
        if zpop_reply.typ != CommandReplyType.reply_array_bulk || zpop_reply.owned_object == null {
            return command_executor_error(&"ERR zset pop failed"[0: 19]);
        }

        const reply_list: &RedisObject = create_list_object() catch {
            command_reply_cleanup(&zpop_reply);
            return command_executor_oom();
        };
        _ = list_object_push_tail(reply_list, key) catch {
            command_reply_cleanup(&zpop_reply);
            object_free(reply_list);
            return command_executor_oom();
        };
        var node: &ListNode = zpop_reply.owned_object.list_head;
        while node != null {
            const data: &[byte] = node.value.value.buf[0: node.value.value.len];
            _ = list_object_push_tail(reply_list, data) catch {
                command_reply_cleanup(&zpop_reply);
                object_free(reply_list);
                return command_executor_oom();
            };
            node = node.next;
        }
        command_reply_cleanup(&zpop_reply);
        return command_executor_owned_array(reply_list);
    }

    return command_executor_reply(CommandReplyType.reply_null_array, command_executor_empty_slice(), 0);
}

fn command_executor_bzmpop_key(
    engine: &Engine,
    key: &[byte],
    obj: &RedisObject,
    reverse: bool,
    count: usize,
) CommandReply {
    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }

    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], 2) catch {
        return command_executor_oom();
    };
    _ = command_executor_command_append_bulk(&raw, key) catch {
        return command_executor_oom();
    };
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], count) catch {
        return command_executor_oom();
    };

    const sorted_members: &RedisObject = zset_object_range_reply(obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(sorted_members);
    }

    var node: &ListNode = sorted_members.list_head;
    if reverse {
        node = sorted_members.list_tail;
    }

    var moved: usize = 0;
    while node != null && moved < count {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        const score: i64 = zset_object_get_score(obj, member) catch {
            return command_executor_wrongtype();
        };
        _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], 2) catch {
            return command_executor_oom();
        };
        _ = command_executor_command_append_bulk(&raw, member) catch {
            return command_executor_oom();
        };
        var score_buf: Sds = sds_empty() catch {
            return command_executor_oom();
        };
        defer {
            sds_free(&score_buf);
        }
        _ = command_executor_info_append_i64(&score_buf, &"%i"[0: 2], score) catch {
            return command_executor_oom();
        };
        _ = command_executor_command_append_bulk(&raw, score_buf.buf[0: score_buf.len]) catch {
            return command_executor_oom();
        };
        _ = zset_object_remove_member(obj, member) catch {
            return command_executor_wrongtype();
        };
        if reverse {
            node = node.prev;
        } else {
            node = node.next;
        }
        moved = moved + 1;
    }

    const remaining: usize = zset_object_len(obj) catch {
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, key);
    }
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_bzmpop(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 5 {
        return command_executor_wrong_arity();
    }
    const timeout_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_validate_blocking_timeout(timeout_data) catch {
        return command_executor_error(&"ERR value is not a valid float"[0: 30]);
    };

    const numkeys_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }

    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 3 + numkeys;
    if command.argc <= keys_end {
        return command_executor_syntax_error();
    }

    const direction: &[byte] = command_executor_arg(command, keys_end) catch {
        return command_executor_syntax_error();
    };
    var reverse: bool = false;
    if command_executor_keyword_eq(direction, &"MIN"[0: 3]) {
        reverse = false;
    } else if command_executor_keyword_eq(direction, &"MAX"[0: 3]) {
        reverse = true;
    } else {
        return command_executor_syntax_error();
    }

    var requested_count: usize = 1;
    if command.argc == keys_end + 3 {
        const option: &[byte] = command_executor_arg(command, keys_end + 1) catch {
            return command_executor_syntax_error();
        };
        if !command_executor_keyword_eq(option, &"COUNT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const count_data: &[byte] = command_executor_arg(command, keys_end + 2) catch {
            return command_executor_syntax_error();
        };
        const count_i64: i64 = command_executor_parse_i64(count_data) catch {
            return command_executor_error(&"ERR count should be greater than 0"[0: 34]);
        };
        if count_i64 <= 0 {
            return command_executor_error(&"ERR count should be greater than 0"[0: 34]);
        }
        requested_count = count_i64 as usize;
    } else if command.argc != keys_end + 1 {
        return command_executor_syntax_error();
    }

    var key_index: usize = 3;
    while key_index < keys_end {
        const key: &[byte] = command_executor_arg(command, key_index) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        if obj_result.error_id != 0 {
            key_index = key_index + 1;
            continue;
        }
        const obj: &RedisObject = obj_result.value;
        if obj.obj_type != ObjectType.object_zset {
            return command_executor_wrongtype();
        }
        const available: usize = zset_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if available == 0 {
            key_index = key_index + 1;
            continue;
        }

        var actual_count: usize = requested_count;
        if actual_count > available {
            actual_count = available;
        }
        return command_executor_bzmpop_key(engine, key, obj, reverse, actual_count);
    }

    return command_executor_reply(CommandReplyType.reply_null_array, command_executor_empty_slice(), 0);
}

fn command_executor_zmpop(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }

    const numkeys_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }

    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 2 + numkeys;
    if command.argc <= keys_end {
        return command_executor_syntax_error();
    }

    const direction: &[byte] = command_executor_arg(command, keys_end) catch {
        return command_executor_syntax_error();
    };
    var reverse: bool = false;
    if command_executor_keyword_eq(direction, &"MIN"[0: 3]) {
        reverse = false;
    } else if command_executor_keyword_eq(direction, &"MAX"[0: 3]) {
        reverse = true;
    } else {
        return command_executor_syntax_error();
    }

    var requested_count: usize = 1;
    if command.argc == keys_end + 3 {
        const option: &[byte] = command_executor_arg(command, keys_end + 1) catch {
            return command_executor_syntax_error();
        };
        if !command_executor_keyword_eq(option, &"COUNT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const count_data: &[byte] = command_executor_arg(command, keys_end + 2) catch {
            return command_executor_syntax_error();
        };
        const count_i64: i64 = command_executor_parse_i64(count_data) catch {
            return command_executor_error(&"ERR count should be greater than 0"[0: 34]);
        };
        if count_i64 <= 0 {
            return command_executor_error(&"ERR count should be greater than 0"[0: 34]);
        }
        requested_count = count_i64 as usize;
    } else if command.argc != keys_end + 1 {
        return command_executor_syntax_error();
    }

    var key_index: usize = 2;
    while key_index < keys_end {
        const key: &[byte] = command_executor_arg(command, key_index) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        if obj_result.error_id != 0 {
            key_index = key_index + 1;
            continue;
        }
        const obj: &RedisObject = obj_result.value;
        if obj.obj_type != ObjectType.object_zset {
            return command_executor_wrongtype();
        }
        const available: usize = zset_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if available == 0 {
            key_index = key_index + 1;
            continue;
        }

        var actual_count: usize = requested_count;
        if actual_count > available {
            actual_count = available;
        }
        return command_executor_bzmpop_key(engine, key, obj, reverse, actual_count);
    }

    return command_executor_reply(CommandReplyType.reply_null_array, command_executor_empty_slice(), 0);
}

fn command_executor_zset_members_with_scores_reply(obj: &RedisObject, members: &RedisObject, head: &ListNode, count: usize) CommandReply {
    const scored: &RedisObject = create_list_object() catch {
        object_free(members);
        return command_executor_oom();
    };
    var current: &ListNode = head;
    var emitted: usize = 0;
    while current != null && emitted < count {
        const member: &[byte] = current.value.value.buf[0: current.value.value.len];
        const score: i64 = zset_object_get_score(obj, member) catch {
            object_free(members);
            object_free(scored);
            return command_executor_wrongtype();
        };
        _ = list_object_push_tail(scored, member) catch {
            object_free(members);
            object_free(scored);
            return command_executor_oom();
        };
        _ = command_executor_list_push_i64(scored, score) catch {
            object_free(members);
            object_free(scored);
            return command_executor_oom();
        };
        current = current.next;
        emitted = emitted + 1;
    }
    object_free(members);
    return command_executor_owned_array(scored);
}

fn command_executor_zscore_range_reply(obj: &RedisObject, min_score: i64, max_score: i64, reverse: bool, with_scores: bool, limit_enabled: bool, limit_offset: usize, limit_count: i64) CommandReply {
    if min_score > max_score {
        return command_executor_array_bulk(null as &ListNode, 0);
    }
    const ranged: &RedisObject = zset_object_range_by_score_reply(obj, min_score, max_score, reverse) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const count: usize = list_object_len(ranged) catch {
        object_free(ranged);
        return command_executor_wrongtype();
    };
    var reply_head: &ListNode = ranged.list_head;
    var reply_count: usize = count;
    if limit_enabled {
        var limit_stop: i64 = -1;
        if limit_count >= 0 {
            limit_stop = (limit_offset as i64) + limit_count - 1;
        }
        const view: ListRangeView = list_object_range(ranged, limit_offset as i64, limit_stop) catch {
            object_free(ranged);
            return command_executor_wrongtype();
        };
        reply_head = view.head;
        reply_count = view.count;
    }
    if with_scores {
        return command_executor_zset_members_with_scores_reply(obj, ranged, reply_head, reply_count);
    }
    var reply: CommandReply = command_executor_array_bulk(reply_head, reply_count);
    reply.owned_object = ranged;
    return reply;
}

fn command_executor_zrangebyscore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const min_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const max_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const min_score: i64 = command_executor_parse_i64(min_data) catch {
        return command_executor_invalid_integer();
    };
    const max_score: i64 = command_executor_parse_i64(max_data) catch {
        return command_executor_invalid_integer();
    };
    var with_scores: bool = false;
    var limit_enabled: bool = false;
    var limit_offset: usize = 0;
    var limit_count: i64 = -1;
    var option_index: usize = 4;
    while option_index < command.argc {
        const option: &[byte] = command_executor_arg(command, option_index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(option, &"WITHSCORES"[0: 10]) {
            if with_scores {
                return command_executor_syntax_error();
            }
            with_scores = true;
            option_index = option_index + 1;
            continue;
        }
        if command_executor_keyword_eq(option, &"LIMIT"[0: 5]) {
            if limit_enabled || option_index + 2 >= command.argc {
                return command_executor_syntax_error();
            }
            const offset_data: &[byte] = command_executor_arg(command, option_index + 1) catch {
                return command_executor_wrong_arity();
            };
            const count_data: &[byte] = command_executor_arg(command, option_index + 2) catch {
                return command_executor_wrong_arity();
            };
            const offset_i64: i64 = command_executor_parse_i64(offset_data) catch {
                return command_executor_invalid_integer();
            };
            if offset_i64 < 0 {
                return command_executor_error(&"ERR offset out of range"[0: 23]);
            }
            limit_enabled = true;
            limit_offset = offset_i64 as usize;
            limit_count = command_executor_parse_i64(count_data) catch {
                return command_executor_invalid_integer();
            };
            option_index = option_index + 3;
            continue;
        }
        return command_executor_syntax_error();
    }
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    return command_executor_zscore_range_reply(obj, min_score, max_score, false, with_scores, limit_enabled, limit_offset, limit_count);
}

fn command_executor_zremrangebyrank(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const start_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const stop_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const start: i64 = command_executor_parse_i64(start_data) catch {
        return command_executor_invalid_integer();
    };
    const stop: i64 = command_executor_parse_i64(stop_data) catch {
        return command_executor_invalid_integer();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    const ranged: &RedisObject = zset_object_range_reply(obj, start, stop) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var removed: i64 = 0;
    var node: &ListNode = ranged.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        const deleted: bool = zset_object_remove_member(obj, member) catch {
            object_free(ranged);
            return command_executor_wrongtype();
        };
        if deleted {
            removed = removed + 1;
        }
        node = node.next;
    }
    object_free(ranged);
    if removed > 0 {
        const remaining: usize = zset_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if remaining == 0 {
            _ = delete_key(engine, key);
        } else {
            _ = touch_key_watch_version(engine, key) catch {};
        }
    }
    return command_executor_integer(removed);
}

fn command_executor_zremrangebyscore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const min_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const max_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const min_score: i64 = command_executor_parse_i64(min_data) catch {
        return command_executor_invalid_integer();
    };
    const max_score: i64 = command_executor_parse_i64(max_data) catch {
        return command_executor_invalid_integer();
    };
    if min_score > max_score {
        return command_executor_integer(0);
    }
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    const ranged: &RedisObject = zset_object_range_by_score_reply(obj, min_score, max_score, false) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var removed: i64 = 0;
    var node: &ListNode = ranged.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        const deleted: bool = zset_object_remove_member(obj, member) catch {
            object_free(ranged);
            return command_executor_wrongtype();
        };
        if deleted {
            removed = removed + 1;
        }
        node = node.next;
    }
    object_free(ranged);
    if removed > 0 {
        const remaining: usize = zset_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if remaining == 0 {
            _ = delete_key(engine, key);
        } else {
            _ = touch_key_watch_version(engine, key) catch {};
        }
    }
    return command_executor_integer(removed);
}

fn command_executor_zrevrangebyscore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const max_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const min_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const max_score: i64 = command_executor_parse_i64(max_data) catch {
        return command_executor_invalid_integer();
    };
    const min_score: i64 = command_executor_parse_i64(min_data) catch {
        return command_executor_invalid_integer();
    };
    var with_scores: bool = false;
    var limit_enabled: bool = false;
    var limit_offset: usize = 0;
    var limit_count: i64 = -1;
    var option_index: usize = 4;
    while option_index < command.argc {
        const option: &[byte] = command_executor_arg(command, option_index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(option, &"WITHSCORES"[0: 10]) {
            if with_scores {
                return command_executor_syntax_error();
            }
            with_scores = true;
            option_index = option_index + 1;
            continue;
        }
        if command_executor_keyword_eq(option, &"LIMIT"[0: 5]) {
            if limit_enabled || option_index + 2 >= command.argc {
                return command_executor_syntax_error();
            }
            const offset_data: &[byte] = command_executor_arg(command, option_index + 1) catch {
                return command_executor_wrong_arity();
            };
            const count_data: &[byte] = command_executor_arg(command, option_index + 2) catch {
                return command_executor_wrong_arity();
            };
            const offset_i64: i64 = command_executor_parse_i64(offset_data) catch {
                return command_executor_invalid_integer();
            };
            if offset_i64 < 0 {
                return command_executor_error(&"ERR offset out of range"[0: 23]);
            }
            limit_enabled = true;
            limit_offset = offset_i64 as usize;
            limit_count = command_executor_parse_i64(count_data) catch {
                return command_executor_invalid_integer();
            };
            option_index = option_index + 3;
            continue;
        }
        return command_executor_syntax_error();
    }
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    return command_executor_zscore_range_reply(obj, min_score, max_score, true, with_scores, limit_enabled, limit_offset, limit_count);
}

fn command_executor_zscan(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const cursor_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const cursor_i64: i64 = command_executor_parse_i64(cursor_data) catch {
        return command_executor_invalid_integer();
    };
    if cursor_i64 < 0 {
        return command_executor_invalid_integer();
    }
    var count_hint: usize = 10;
    if command.argc == 5 {
        const option: &[byte] = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(option, &"COUNT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const count_data: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        const count_i64: i64 = command_executor_parse_i64(count_data) catch {
            return command_executor_invalid_integer();
        };
        if count_i64 <= 0 {
            return command_executor_invalid_integer();
        }
        count_hint = count_i64 as usize;
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_scan(0u64, null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    const members: &RedisObject = zset_object_range_reply(obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const combined: &RedisObject = create_list_object() catch {
        object_free(members);
        return command_executor_oom();
    };
    var member_node: &ListNode = members.list_head;
    while member_node != null {
        const member: &[byte] = member_node.value.value.buf[0: member_node.value.value.len];
        const score: i64 = zset_object_get_score(obj, member) catch {
            object_free(members);
            object_free(combined);
            return command_executor_wrongtype();
        };
        _ = list_object_push_tail(combined, member) catch {
            object_free(members);
            object_free(combined);
            return command_executor_oom();
        };
        _ = command_executor_list_push_i64(combined, score) catch {
            object_free(members);
            object_free(combined);
            return command_executor_oom();
        };
        member_node = member_node.next;
    }
    object_free(members);

    const total_pairs_data: usize = list_object_len(combined) catch {
        object_free(combined);
        return command_executor_wrongtype();
    };
    const total: usize = total_pairs_data / 2;
    const cursor: usize = cursor_i64 as usize;
    var emit_head: &ListNode = null as &ListNode;
    var emit_count: usize = 0;
    var next_cursor: u64 = 0u64;
    if cursor < total {
        const start_offset: i64 = cursor_i64 * 2;
        const stop_offset: i64 = start_offset + (count_hint as i64) * 2 - 1;
        const view: ListRangeView = list_object_range(combined, start_offset, stop_offset) catch {
            object_free(combined);
            return command_executor_wrongtype();
        };
        emit_head = view.head;
        emit_count = view.count;
        if cursor + (emit_count / 2) < total {
            next_cursor = (cursor + (emit_count / 2)) as u64;
        }
    }
    var reply: CommandReply = command_executor_scan(next_cursor, emit_head, emit_count);
    reply.owned_object = combined;
    return reply;
}

fn command_executor_geo_search_candidate(
    center: &CommandExecutorGeoPoint,
    point: &CommandExecutorGeoPoint,
    options: &CommandExecutorGeoSearchOptions,
) bool {
    if options.by_radius {
        return command_executor_geo_distance_meters(center, point) <= options.radius_m;
    }
    const lat_delta: f64 = (options.box_height_m / 2.0) / COMMAND_EXECUTOR_GEO_METERS_PER_DEGREE;
    var lon_scale: f64 = COMMAND_EXECUTOR_GEO_METERS_PER_DEGREE * cos(center.lat * COMMAND_EXECUTOR_GEO_DEG_TO_RAD);
    if lon_scale < 0.000001 && lon_scale > -0.000001 {
        lon_scale = 0.000001;
    }
    const lon_delta: f64 = (options.box_width_m / 2.0) / lon_scale;
    return fabs(point.lat - center.lat) <= lat_delta && fabs(point.lon - center.lon) <= lon_delta;
}

fn command_executor_geoadd(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 5 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    var nx: bool = false;
    var xx: bool = false;
    var ch: bool = false;
    var index: usize = 2;
    while index < command.argc {
        const token: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(token, &"NX"[0: 2]) {
            if xx || nx {
                return command_executor_syntax_error();
            }
            nx = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"XX"[0: 2]) {
            if nx || xx {
                return command_executor_syntax_error();
            }
            xx = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"CH"[0: 2]) {
            if ch {
                return command_executor_syntax_error();
            }
            ch = true;
            index = index + 1;
            continue;
        }
        break;
    }
    if index >= command.argc || ((command.argc - index) % (3 as usize)) != 0 {
        return command_executor_wrong_arity();
    }

    const existing_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
    var target: &RedisObject = null as &RedisObject;
    var created: &RedisObject = null as &RedisObject;
    if existing_result.error_id == 0 {
        target = existing_result.value;
        if target.obj_type != ObjectType.object_zset {
            return command_executor_wrongtype();
        }
    }

    var reply_count: i64 = 0;
    while index + 2 < command.argc {
        const lon_data: &[byte] = command_executor_arg(command, index) catch {
            if created != null {
                object_free(created);
            }
            return command_executor_wrong_arity();
        };
        const lat_data: &[byte] = command_executor_arg(command, index + 1) catch {
            if created != null {
                object_free(created);
            }
            return command_executor_wrong_arity();
        };
        const member: &[byte] = command_executor_arg(command, index + 2) catch {
            if created != null {
                object_free(created);
            }
            return command_executor_wrong_arity();
        };
        const lon: f64 = command_executor_parse_f64(lon_data) catch {
            if created != null {
                object_free(created);
            }
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        const lat: f64 = command_executor_parse_f64(lat_data) catch {
            if created != null {
                object_free(created);
            }
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        if !command_executor_geo_validate_lonlat(lon, lat) {
            if created != null {
                object_free(created);
            }
            return command_executor_geo_invalid_lonlat(lon, lat);
        }

        var exists: bool = false;
        var old_score: i64 = 0;
        if target != null {
            const old_score_result: !i64 = zset_object_get_score(target, member);
            if old_score_result.error_id == 0 {
                exists = true;
                old_score = old_score_result.value;
            }
        }
        if nx && exists {
            index = index + 3;
            continue;
        }
        if xx && !exists {
            index = index + 3;
            continue;
        }

        const packed: i64 = command_executor_geo_pack(lon, lat);
        if target == null {
            created = create_zset_object() catch {
                return command_executor_oom();
            };
            target = created;
        }
        const inserted: bool = zset_object_add_member(target, packed, member) catch |err| {
            if created != null {
                object_free(created);
            }
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_error(&"ERR geo add failed"[0: 18]);
        };
        if ch {
            if inserted || old_score != packed {
                reply_count = reply_count + 1;
            }
        } else if inserted {
            reply_count = reply_count + 1;
        }
        index = index + 3;
    }

    if created != null {
        _ = set_key_at(engine, key, created, now_ms) catch {
            object_free(created);
            return command_executor_oom();
        };
    }
    return command_executor_integer(reply_count);
}

fn command_executor_geodist(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 && command.argc != 5 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const member_a: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const member_b: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    var unit_scale: f64 = 1.0;
    if command.argc == 5 {
        const unit: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        unit_scale = command_executor_geo_unit_scale(unit) catch {
            return command_executor_error(&"ERR unsupported unit provided. please use M, KM, FT, MI"[0: 57]);
        };
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    const point_a: CommandExecutorGeoPoint = command_executor_geo_decode_member(obj, member_a) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    const point_b: CommandExecutorGeoPoint = command_executor_geo_decode_member(obj, member_b) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    return command_executor_geo_format_bulk(command_executor_geo_distance_meters(&point_a, &point_b) / unit_scale, &"%.4f"[0: 4]);
}

fn command_executor_geopos(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
    var obj: &RedisObject = null as &RedisObject;
    if obj_result.error_id == 0 {
        obj = obj_result.value;
        if obj.obj_type != ObjectType.object_zset {
            return command_executor_wrongtype();
        }
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    const result_count: usize = command.argc - 2;
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], result_count) catch {
        return command_executor_oom();
    };

    var index: usize = 2;
    while index < command.argc {
        const member: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if obj == null {
            _ = command_executor_command_append_null(&raw, 2) catch {
                return command_executor_oom();
            };
            index = index + 1;
            continue;
        }
        const point_result: !CommandExecutorGeoPoint = command_executor_geo_decode_member(obj, member);
        if point_result.error_id != 0 {
            _ = command_executor_command_append_null(&raw, 2) catch {
                return command_executor_oom();
            };
            index = index + 1;
            continue;
        }
        const point: CommandExecutorGeoPoint = point_result.value;
        _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], 2) catch {
            return command_executor_oom();
        };
        _ = command_executor_geo_append_formatted_bulk(&raw, point.lon, &"%.6f"[0: 4]) catch {
            return command_executor_oom();
        };
        _ = command_executor_geo_append_formatted_bulk(&raw, point.lat, &"%.6f"[0: 4]) catch {
            return command_executor_oom();
        };
        index = index + 1;
    }
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_geohash(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
    var obj: &RedisObject = null as &RedisObject;
    if obj_result.error_id == 0 {
        obj = obj_result.value;
        if obj.obj_type != ObjectType.object_zset {
            return command_executor_wrongtype();
        }
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    const result_count: usize = command.argc - 2;
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], result_count) catch {
        return command_executor_oom();
    };

    var index: usize = 2;
    while index < command.argc {
        const member: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if obj == null {
            _ = command_executor_command_append_null(&raw, 2) catch {
                return command_executor_oom();
            };
            index = index + 1;
            continue;
        }
        const point_result: !CommandExecutorGeoPoint = command_executor_geo_decode_member(obj, member);
        if point_result.error_id != 0 {
            _ = command_executor_command_append_null(&raw, 2) catch {
                return command_executor_oom();
            };
            index = index + 1;
            continue;
        }
        const point: CommandExecutorGeoPoint = point_result.value;
        _ = command_executor_geo_append_geohash(&raw, &point) catch {
            return command_executor_oom();
        };
        index = index + 1;
    }
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_geo_search_run(engine: &Engine, key: &[byte], options: &CommandExecutorGeoSearchOptions, now_ms: u64) CommandReply {
    const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
    const obj: &RedisObject = obj_result catch {
        if options.from_member {
            return command_executor_error(&"ERR could not decode requested zset member"[0: 41]);
        }
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    var center: CommandExecutorGeoPoint = CommandExecutorGeoPoint{ lon: options.center_lon, lat: options.center_lat, packed: 0 };
    if options.from_member {
        center = command_executor_geo_decode_member(obj, options.center_member) catch {
            return command_executor_error(&"ERR could not decode requested zset member"[0: 41]);
        };
    }

    const sorted_members: &RedisObject = zset_object_range_reply(obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(sorted_members);
    }

    var items: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&items);
    }
    var result_count: usize = 0;

    if options.order == CommandExecutorGeoOrder.geo_order_none {
        var node: &ListNode = sorted_members.list_head;
        while node != null {
            const member: &[byte] = node.value.value.buf[0: node.value.value.len];
            const point: CommandExecutorGeoPoint = command_executor_geo_decode_member(obj, member) catch {
                return command_executor_wrongtype();
            };
            const distance_m: f64 = command_executor_geo_distance_meters(&center, &point);
            if command_executor_geo_search_candidate(&center, &point, options) {
                _ = command_executor_geo_append_search_item(&items, member, &point, distance_m, options) catch {
                    return command_executor_oom();
                };
                result_count = result_count + 1;
                if options.has_count && result_count >= options.count_limit {
                    break;
                }
            }
            node = node.next;
        }
    } else {
        const emitted: &RedisObject = create_set_object() catch {
            return command_executor_oom();
        };
        defer {
            object_free(emitted);
        }

        while !options.has_count || result_count < options.count_limit {
            var best_found: bool = false;
            var best_member: &[byte] = command_executor_empty_slice();
            var best_point: CommandExecutorGeoPoint = CommandExecutorGeoPoint{ lon: 0.0, lat: 0.0, packed: 0 };
            var best_distance: f64 = 0.0;

            var node_search: &ListNode = sorted_members.list_head;
            while node_search != null {
                const member_search: &[byte] = node_search.value.value.buf[0: node_search.value.value.len];
                const already_emitted: bool = command_executor_set_contains(emitted, member_search) catch {
                    return command_executor_oom();
                };
                if already_emitted {
                    node_search = node_search.next;
                    continue;
                }
                const point_search: CommandExecutorGeoPoint = command_executor_geo_decode_member(obj, member_search) catch {
                    return command_executor_wrongtype();
                };
                const distance_search: f64 = command_executor_geo_distance_meters(&center, &point_search);
                if !command_executor_geo_search_candidate(&center, &point_search, options) {
                    node_search = node_search.next;
                    continue;
                }
                if !best_found ||
                    (options.order == CommandExecutorGeoOrder.geo_order_asc && distance_search < best_distance) ||
                    (options.order == CommandExecutorGeoOrder.geo_order_desc && distance_search > best_distance) {
                    best_found = true;
                    best_member = member_search;
                    best_point.lon = point_search.lon;
                    best_point.lat = point_search.lat;
                    best_point.packed = point_search.packed;
                    best_distance = distance_search;
                }
                node_search = node_search.next;
            }
            if !best_found {
                break;
            }
            _ = command_executor_geo_append_search_item(&items, best_member, &best_point, best_distance, options) catch {
                return command_executor_oom();
            };
            _ = set_object_add_member(emitted, best_member) catch {
                return command_executor_oom();
            };
            result_count = result_count + 1;
        }
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], result_count) catch {
        return command_executor_oom();
    };
    _ = sds_cat(&raw, items.buf[0: items.len]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_geo_store_add_result(
    stored: &RedisObject,
    member: &[byte],
    point: &CommandExecutorGeoPoint,
    distance_m: f64,
    options: &CommandExecutorGeoSearchOptions,
) CommandReply {
    var score: i64 = point.packed;
    if options.storedist {
        score = (distance_m / options.unit_scale) as i64;
    }
    _ = zset_object_add_member(stored, score, member) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_error(&"ERR zset add failed"[0: 20]);
    };
    return command_executor_integer(1);
}

fn command_executor_geo_search_store_run(engine: &Engine, destination: &[byte], source: &[byte], options: &CommandExecutorGeoSearchOptions, now_ms: u64) CommandReply {
    const obj_result: !&RedisObject = lookup_key_at(engine, source, now_ms);
    const obj: &RedisObject = obj_result catch {
        if options.from_member {
            return command_executor_error(&"ERR could not decode requested zset member"[0: 41]);
        }
        _ = delete_key(engine, destination);
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    var center: CommandExecutorGeoPoint = CommandExecutorGeoPoint{ lon: options.center_lon, lat: options.center_lat, packed: 0 };
    if options.from_member {
        center = command_executor_geo_decode_member(obj, options.center_member) catch {
            return command_executor_error(&"ERR could not decode requested zset member"[0: 41]);
        };
    }

    const sorted_members: &RedisObject = zset_object_range_reply(obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(sorted_members);
    }

    const stored: &RedisObject = create_zset_object() catch {
        return command_executor_oom();
    };

    var result_count: usize = 0;
    if options.order == CommandExecutorGeoOrder.geo_order_none {
        var node: &ListNode = sorted_members.list_head;
        while node != null {
            const member: &[byte] = node.value.value.buf[0: node.value.value.len];
            const point: CommandExecutorGeoPoint = command_executor_geo_decode_member(obj, member) catch {
                object_free(stored);
                return command_executor_wrongtype();
            };
            const distance_m: f64 = command_executor_geo_distance_meters(&center, &point);
            if command_executor_geo_search_candidate(&center, &point, options) {
                const add_reply: CommandReply = command_executor_geo_store_add_result(stored, member, &point, distance_m, options);
                if add_reply.typ != CommandReplyType.reply_integer {
                    object_free(stored);
                    return add_reply;
                }
                result_count = result_count + 1;
                if options.has_count && result_count >= options.count_limit {
                    break;
                }
            }
            node = node.next;
        }
    } else {
        const emitted: &RedisObject = create_set_object() catch {
            object_free(stored);
            return command_executor_oom();
        };
        defer {
            object_free(emitted);
        }

        while !options.has_count || result_count < options.count_limit {
            var best_found: bool = false;
            var best_member: &[byte] = command_executor_empty_slice();
            var best_point: CommandExecutorGeoPoint = CommandExecutorGeoPoint{ lon: 0.0, lat: 0.0, packed: 0 };
            var best_distance: f64 = 0.0;

            var node_search: &ListNode = sorted_members.list_head;
            while node_search != null {
                const member_search: &[byte] = node_search.value.value.buf[0: node_search.value.value.len];
                const already_emitted: bool = command_executor_set_contains(emitted, member_search) catch {
                    object_free(stored);
                    return command_executor_oom();
                };
                if already_emitted {
                    node_search = node_search.next;
                    continue;
                }
                const point_search: CommandExecutorGeoPoint = command_executor_geo_decode_member(obj, member_search) catch {
                    object_free(stored);
                    return command_executor_wrongtype();
                };
                const distance_search: f64 = command_executor_geo_distance_meters(&center, &point_search);
                if !command_executor_geo_search_candidate(&center, &point_search, options) {
                    node_search = node_search.next;
                    continue;
                }
                if !best_found ||
                    (options.order == CommandExecutorGeoOrder.geo_order_asc && distance_search < best_distance) ||
                    (options.order == CommandExecutorGeoOrder.geo_order_desc && distance_search > best_distance) {
                    best_found = true;
                    best_member = member_search;
                    best_point.lon = point_search.lon;
                    best_point.lat = point_search.lat;
                    best_point.packed = point_search.packed;
                    best_distance = distance_search;
                }
                node_search = node_search.next;
            }
            if !best_found {
                break;
            }
            const best_add_reply: CommandReply = command_executor_geo_store_add_result(stored, best_member, &best_point, best_distance, options);
            if best_add_reply.typ != CommandReplyType.reply_integer {
                object_free(stored);
                return best_add_reply;
            }
            _ = set_object_add_member(emitted, best_member) catch {
                object_free(stored);
                return command_executor_oom();
            };
            result_count = result_count + 1;
        }
    }

    if result_count == 0 {
        object_free(stored);
        _ = delete_key(engine, destination);
        return command_executor_integer(0);
    }

    _ = set_key_at(engine, destination, stored, now_ms) catch {
        object_free(stored);
        return command_executor_oom();
    };
    return command_executor_integer(result_count as i64);
}

fn command_executor_geosearch(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 7 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    var options: CommandExecutorGeoSearchOptions = command_executor_geo_search_defaults();

    var index: usize = 2;
    const from_token: &[byte] = command_executor_arg(command, index) catch {
        return command_executor_wrong_arity();
    };
    if command_executor_keyword_eq(from_token, &"FROMMEMBER"[0: 10]) {
        if index + 1 >= command.argc {
            return command_executor_wrong_arity();
        }
        options.from_member = true;
        options.center_member = command_executor_arg(command, index + 1) catch {
            return command_executor_wrong_arity();
        };
        index = index + 2;
    } else if command_executor_keyword_eq(from_token, &"FROMLONLAT"[0: 10]) {
        if index + 2 >= command.argc {
            return command_executor_wrong_arity();
        }
        options.center_lon = command_executor_parse_f64(command_executor_arg(command, index + 1) catch {
            return command_executor_wrong_arity();
        }) catch {
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        options.center_lat = command_executor_parse_f64(command_executor_arg(command, index + 2) catch {
            return command_executor_wrong_arity();
        }) catch {
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        if !command_executor_geo_validate_lonlat(options.center_lon, options.center_lat) {
            return command_executor_geo_invalid_lonlat(options.center_lon, options.center_lat);
        }
        index = index + 3;
    } else {
        return command_executor_wrong_arity();
    }

    const by_token: &[byte] = command_executor_arg(command, index) catch {
        return command_executor_wrong_arity();
    };
    if command_executor_keyword_eq(by_token, &"BYRADIUS"[0: 8]) {
        if index + 2 >= command.argc {
            return command_executor_wrong_arity();
        }
        const radius: f64 = command_executor_parse_f64(command_executor_arg(command, index + 1) catch {
            return command_executor_wrong_arity();
        }) catch {
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        const unit: &[byte] = command_executor_arg(command, index + 2) catch {
            return command_executor_wrong_arity();
        };
        const unit_scale: f64 = command_executor_geo_unit_scale(unit) catch {
            return command_executor_error(&"ERR unsupported unit provided. please use M, KM, FT, MI"[0: 57]);
        };
        options.by_radius = true;
        options.radius_m = radius * unit_scale;
        options.unit_scale = unit_scale;
        index = index + 3;
    } else if command_executor_keyword_eq(by_token, &"BYBOX"[0: 5]) {
        if index + 3 >= command.argc {
            return command_executor_wrong_arity();
        }
        const width: f64 = command_executor_parse_f64(command_executor_arg(command, index + 1) catch {
            return command_executor_wrong_arity();
        }) catch {
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        const height: f64 = command_executor_parse_f64(command_executor_arg(command, index + 2) catch {
            return command_executor_wrong_arity();
        }) catch {
            return command_executor_error(&"ERR value is not a valid float"[0: 30]);
        };
        const unit: &[byte] = command_executor_arg(command, index + 3) catch {
            return command_executor_wrong_arity();
        };
        const unit_scale: f64 = command_executor_geo_unit_scale(unit) catch {
            return command_executor_error(&"ERR unsupported unit provided. please use M, KM, FT, MI"[0: 57]);
        };
        options.by_radius = false;
        options.box_width_m = width * unit_scale;
        options.box_height_m = height * unit_scale;
        options.unit_scale = unit_scale;
        index = index + 4;
    } else {
        return command_executor_wrong_arity();
    }

    while index < command.argc {
        const token: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(token, &"ASC"[0: 3]) {
            if options.order != CommandExecutorGeoOrder.geo_order_none {
                return command_executor_syntax_error();
            }
            options.order = CommandExecutorGeoOrder.geo_order_asc;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"DESC"[0: 4]) {
            if options.order != CommandExecutorGeoOrder.geo_order_none {
                return command_executor_syntax_error();
            }
            options.order = CommandExecutorGeoOrder.geo_order_desc;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"COUNT"[0: 5]) {
            if options.has_count || index + 1 >= command.argc {
                return command_executor_syntax_error();
            }
            const count_i64: i64 = command_executor_parse_i64(command_executor_arg(command, index + 1) catch {
                return command_executor_wrong_arity();
            }) catch {
                return command_executor_invalid_integer();
            };
            if count_i64 <= 0 {
                return command_executor_error(&"ERR COUNT must be > 0"[0: 22]);
            }
            options.has_count = true;
            options.count_limit = count_i64 as usize;
            index = index + 2;
            if index < command.argc {
                const any_token: &[byte] = command_executor_arg(command, index) catch {
                    return command_executor_wrong_arity();
                };
                if command_executor_keyword_eq(any_token, &"ANY"[0: 3]) {
                    options.any = true;
                    index = index + 1;
                }
            }
            continue;
        }
        if command_executor_keyword_eq(token, &"WITHCOORD"[0: 9]) {
            options.withcoord = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"WITHDIST"[0: 8]) {
            options.withdist = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"WITHHASH"[0: 8]) {
            options.withhash = true;
            index = index + 1;
            continue;
        }
        return command_executor_syntax_error();
    }

    return command_executor_geo_search_run(engine, key, &options, now_ms);
}

fn command_executor_geosearchstore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 8 {
        return command_executor_wrong_arity();
    }
    const destination: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const source: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    var options: CommandExecutorGeoSearchOptions = command_executor_geo_search_defaults();

    var index: usize = 3;
