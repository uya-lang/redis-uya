    _ = list_object_push_tail(reply_list, &"    Generate a secure 256-bit user password. The optional `bits` argument can"[0: 77]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"    be used to specify a different size."[0: 40]) catch { object_free(reply_list); return command_executor_oom(); };
