    var index: usize = 0;
    while index < patterns.len {
        if patterns.ptr[index].active == false {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_acl_key_pattern_add(patterns: &[ConnectionAclKeyPattern], pattern: &[byte]) !void {
    if pattern.len == 0 || pattern.len > CONNECTION_ACL_KEY_PATTERN_BYTES_MAX {
        return error.ConnectionInputTooLarge;
    }
    if connection_acl_key_pattern_find(patterns, pattern) >= 0 {
        return;
    }
    const slot: i32 = connection_acl_key_pattern_find_free(patterns);
    if slot < 0 {
        return error.ConnectionInputTooLarge;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= patterns.len {
        return error.ConnectionInputTooLarge;
    }
    patterns.ptr[slot_index].active = true;
    patterns.ptr[slot_index].pattern_len = pattern.len;
    var i: usize = 0;
    while i < pattern.len {
        patterns.ptr[slot_index].pattern[i] = pattern.ptr[i];
        i = i + 1;
    }
    while i < CONNECTION_ACL_KEY_PATTERN_BYTES_MAX {
        patterns.ptr[slot_index].pattern[i] = 0 as byte;
        i = i + 1;
    }
}

fn connection_acl_glob_match(pattern: &[byte], pattern_index: usize, value: &[byte], value_index: usize) bool {
    if pattern_index == pattern.len {
        return value_index == value.len;
    }
    const current: byte = pattern.ptr[pattern_index];
    if current == 42 as byte {
        var next_index: usize = pattern_index;
        while next_index < pattern.len && pattern.ptr[next_index] == 42 as byte {
            next_index = next_index + 1;
        }
        if next_index == pattern.len {
            return true;
        }
        var scan: usize = value_index;
        while scan <= value.len {
            if connection_acl_glob_match(pattern, next_index, value, scan) {
                return true;
            }
            if scan == value.len {
                break;
            }
            scan = scan + 1;
        }
        return false;
    }
    if value_index >= value.len {
        return false;
    }
    if current == 63 as byte {
        return connection_acl_glob_match(pattern, pattern_index + 1, value, value_index + 1);
    }
    return current == value.ptr[value_index] && connection_acl_glob_match(pattern, pattern_index + 1, value, value_index + 1);
}

fn connection_acl_key_allowed_by_patterns(allkeys: bool, patterns: &[ConnectionAclKeyPattern], key: &[byte]) bool {
    if allkeys {
        return true;
    }
    var index: usize = 0;
    while index < patterns.len {
        if patterns.ptr[index].active && connection_acl_glob_match(patterns.ptr[index].pattern[0: patterns.ptr[index].pattern_len], 0, key, 0) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn connection_acl_channel_allowed_by_patterns(allchannels: bool, patterns: &[ConnectionAclChannelPattern], channel: &[byte]) bool {
    if allchannels {
        return true;
    }
    var index: usize = 0;
    while index < patterns.len {
        if patterns.ptr[index].active && connection_acl_glob_match(patterns.ptr[index].pattern[0: patterns.ptr[index].pattern_len], 0, channel, 0) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn connection_acl_log_clear_all() void {
    var index: usize = 0;
    while index < CONNECTION_ACL_LOG_MAX {
        connection_acl_log_entries[index].active = false;
        connection_acl_log_entries[index].sequence = 0u64;
        connection_acl_log_entries[index].created_ms = 0u64;
        connection_acl_log_entries[index].client_id = 0;
        connection_acl_log_entries[index].username_len = 0;
        connection_acl_log_entries[index].client_addr_len = 0;
        connection_acl_log_entries[index].client_local_addr_len = 0;
        connection_acl_log_entries[index].count = 0u64;
        connection_acl_log_entries[index].command_len = 0;
        connection_acl_log_entries[index].context_len = 0;
        connection_client_registry_copy_bytes(connection_acl_log_entries[index].client_addr[0: CONNECTION_CLIENT_ADDR_MAX], connection_reply_empty_slice(), 0);
        connection_client_registry_copy_bytes(connection_acl_log_entries[index].client_local_addr[0: CONNECTION_CLIENT_ADDR_MAX], connection_reply_empty_slice(), 0);
        index = index + 1;
    }
    connection_acl_log_next_index = 0;
    connection_acl_log_count = 0;
    connection_acl_log_next_sequence = 1u64;
}

fn connection_acl_users_clear_all() void {
    var index: usize = 0;
    while index < CONNECTION_ACL_USER_MAX {
        connection_acl_users[index].active = false;
        connection_acl_users[index].enabled = false;
        connection_acl_users[index].nopass = true;
        connection_acl_users[index].allkeys = true;
        connection_acl_users[index].allchannels = true;
        connection_acl_users[index].name_len = 0;
        connection_acl_users[index].password_hash_set = false;
        var i: usize = 0;
        while i < CONNECTION_ACL_USER_NAME_MAX {
            connection_acl_users[index].name[i] = 0 as byte;
            i = i + 1;
        }
        i = 0;
        while i < CONNECTION_ACL_PASSWORD_HASH_BYTES {
            connection_acl_users[index].password_hash[i] = 0 as byte;
            i = i + 1;
        }
        connection_acl_user_clear_rules(&connection_acl_users[index]);
        connection_acl_key_patterns_clear(connection_acl_users[index].key_patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]);
        connection_acl_channel_patterns_clear(connection_acl_users[index].channel_patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]);
        index = index + 1;
    }
}

fn connection_acl_user_find(username: &[byte]) i32 {
    var index: usize = 0;
    while index < CONNECTION_ACL_USER_MAX {
        if connection_acl_users[index].active &&
            connection_slice_eq(connection_acl_users[index].name[0: connection_acl_users[index].name_len], username) {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_acl_user_selector(username: &[byte]) i32 {
    if connection_slice_eq(username, &"default"[0: 7]) {
        return CONNECTION_CLIENT_KILL_USER_DEFAULT;
    }
    const selector: i32 = connection_acl_user_find(username);
    if selector < 0 {
        return CONNECTION_CLIENT_KILL_USER_UNKNOWN;
    }
    return selector;
}

fn connection_acl_user_find_free() i32 {
    var index: usize = 0;
    while index < CONNECTION_ACL_USER_MAX {
        if !connection_acl_users[index].active {
            return index as i32;
        }
        index = index + 1;
    }
    return -1;
}

fn connection_acl_user_create_or_get(username: &[byte]) !usize {
    if username.len == 0 || username.len > CONNECTION_ACL_USER_NAME_MAX {
        return error.ConnectionInputTooLarge;
    }
    var slot: i32 = connection_acl_user_find(username);
    if slot < 0 {
        slot = connection_acl_user_find_free();
        if slot < 0 {
            return error.ConnectionInputTooLarge;
        }
        const slot_index_new: usize = slot as usize;
        if slot_index_new >= CONNECTION_ACL_USER_MAX {
            return error.ConnectionInputTooLarge;
        }
        connection_acl_users[slot_index_new].active = true;
        connection_acl_users[slot_index_new].enabled = false;
        connection_acl_users[slot_index_new].nopass = true;
        connection_acl_users[slot_index_new].allkeys = true;
        connection_acl_users[slot_index_new].allchannels = true;
        connection_acl_users[slot_index_new].name_len = username.len;
        connection_acl_users[slot_index_new].password_hash_set = false;
        var i: usize = 0;
        while i < username.len {
            connection_acl_users[slot_index_new].name[i] = username.ptr[i];
            i = i + 1;
        }
        while i < CONNECTION_ACL_USER_NAME_MAX {
            connection_acl_users[slot_index_new].name[i] = 0 as byte;
            i = i + 1;
        }
        i = 0;
        while i < CONNECTION_ACL_PASSWORD_HASH_BYTES {
            connection_acl_users[slot_index_new].password_hash[i] = 0 as byte;
            i = i + 1;
        }
        connection_acl_user_clear_rules(&connection_acl_users[slot_index_new]);
        connection_acl_key_patterns_clear(connection_acl_users[slot_index_new].key_patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]);
        connection_acl_channel_patterns_clear(connection_acl_users[slot_index_new].channel_patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]);
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_USER_MAX {
        return error.ConnectionInputTooLarge;
    }
    return slot_index;
}

fn connection_acl_user_delete(username: &[byte]) bool {
    const slot: i32 = connection_acl_user_find(username);
    if slot < 0 {
        return false;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_USER_MAX {
        return false;
    }
    connection_acl_users[slot_index].active = false;
    connection_acl_users[slot_index].enabled = false;
    connection_acl_users[slot_index].nopass = true;
    connection_acl_users[slot_index].allkeys = true;
    connection_acl_users[slot_index].allchannels = true;
    connection_acl_users[slot_index].name_len = 0;
    connection_acl_users[slot_index].password_hash_set = false;
    var i: usize = 0;
    while i < CONNECTION_ACL_PASSWORD_HASH_BYTES {
        connection_acl_users[slot_index].password_hash[i] = 0 as byte;
        i = i + 1;
    }
    connection_acl_user_clear_rules(&connection_acl_users[slot_index]);
    connection_acl_key_patterns_clear(connection_acl_users[slot_index].key_patterns[0: CONNECTION_ACL_KEY_PATTERN_MAX]);
    connection_acl_channel_patterns_clear(connection_acl_users[slot_index].channel_patterns[0: CONNECTION_ACL_CHANNEL_PATTERN_MAX]);
    return true;
}

export fn connection_acl_reset_for_test() void {
    connection_acl_default_denied_clear_all();
    connection_acl_default_categories_clear_all();
    connection_acl_default_key_patterns_reset_allkeys();
    connection_acl_default_channel_patterns_reset_allchannels();
    connection_acl_users_clear_all();
    connection_acl_log_clear_all();
}

fn connection_acl_default_denied_add(name: &[byte]) !void {
    if name.len == 0 || name.len > CONNECTION_ACL_COMMAND_NAME_MAX {
        return error.ConnectionInputTooLarge;
    }
    if connection_acl_default_denied_find(name) >= 0 {
        return;
    }
    const slot: i32 = connection_acl_default_denied_find_free();
    if slot < 0 {
        return error.ConnectionInputTooLarge;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_DENIED_COMMAND_MAX {
        return error.ConnectionInputTooLarge;
    }
    connection_acl_default_denied_commands[slot_index].active = true;
    connection_acl_default_denied_commands[slot_index].name_len = name.len;
    connection_acl_default_denied_command_count = connection_acl_default_denied_command_count + 1;
    var i: usize = 0;
    while i < name.len {
        connection_acl_default_denied_commands[slot_index].name[i] = connection_ascii_lower(name.ptr[i]);
        i = i + 1;
    }
    while i < CONNECTION_ACL_COMMAND_NAME_MAX {
        connection_acl_default_denied_commands[slot_index].name[i] = 0 as byte;
        i = i + 1;
    }
}

fn connection_acl_default_denied_remove(name: &[byte]) void {
    const slot: i32 = connection_acl_default_denied_find(name);
    if slot < 0 {
        return;
    }
    const slot_index: usize = slot as usize;
    if slot_index >= CONNECTION_ACL_DENIED_COMMAND_MAX {
        return;
    }
    connection_acl_default_denied_commands[slot_index].active = false;
    connection_acl_default_denied_commands[slot_index].name_len = 0;
    if connection_acl_default_denied_command_count > 0 {
        connection_acl_default_denied_command_count = connection_acl_default_denied_command_count - 1;
    }
}

fn connection_acl_default_category_add(name: &[byte]) !void {
    if name.len == 0 || name.len > CONNECTION_ACL_COMMAND_NAME_MAX {
        return error.ConnectionInputTooLarge;
