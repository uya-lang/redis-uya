export fn test_command_function_help() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 2048] = [];

    var help_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nFUNCTION\r\n$4\r\nHELP\r\n"[0: 28]);
    const help_command: Command = try command_executor_test_command(&router, &help_parsed);
    var help_reply: CommandReply = command_execute_at(&engine, &help_command, 1000u64);
    const help_len: usize = try connection_encode_reply(&help_reply, &out[0], 2048);
    try assert_true(command_executor_test_contains(out[0: help_len], &"FUNCTION HELP"[0: 13]));
    try assert_true(command_executor_test_contains(out[0: help_len], &"FUNCTION LIST"[0: 13]));
    try assert_true(command_executor_test_contains(out[0: help_len], &"FUNCTION LOAD"[0: 13]));
    try assert_true(command_executor_test_contains(out[0: help_len], &"FUNCTION DUMP"[0: 13]));
    try assert_true(command_executor_test_contains(out[0: help_len], &"FUNCTION RESTORE"[0: 16]));
    try assert_true(command_executor_test_contains(out[0: help_len], &"FUNCTION KILL"[0: 13]));
    command_reply_cleanup(&help_reply);
    resp_value_free(&help_parsed.value);

    var unknown_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nFUNCTION\r\n$1\r\nX\r\n"[0: 25]);
    const unknown_command: Command = try command_executor_test_command(&router, &unknown_parsed);
    var unknown_reply: CommandReply = command_execute_at(&engine, &unknown_command, 1000u64);
    try assert_eq_i32(unknown_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(unknown_reply.data, &"ERR unknown subcommand 'X'. Try FUNCTION HELP."[0: 46]));
    command_reply_cleanup(&unknown_reply);
    resp_value_free(&unknown_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_function_list() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var list_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nFUNCTION\r\n$4\r\nLIST\r\n"[0: 28]);
    const list_command: Command = try command_executor_test_command(&router, &list_parsed);
    var list_reply: CommandReply = command_execute_at(&engine, &list_command, 1000u64);
    try assert_eq_i32(list_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(list_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&list_reply);
    resp_value_free(&list_parsed.value);

    var withcode_parsed: RespParseResult = try parse_resp2(&"*3\r\n$8\r\nFUNCTION\r\n$4\r\nLIST\r\n$8\r\nWITHCODE\r\n"[0: 42]);
    const withcode_command: Command = try command_executor_test_command(&router, &withcode_parsed);
    var withcode_reply: CommandReply = command_execute_at(&engine, &withcode_command, 1000u64);
    try assert_eq_i32(withcode_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(withcode_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&withcode_reply);
    resp_value_free(&withcode_parsed.value);

    var pattern_parsed: RespParseResult = try parse_resp2(&"*5\r\n$8\r\nFUNCTION\r\n$4\r\nLIST\r\n$11\r\nLIBRARYNAME\r\n$1\r\n*\r\n$8\r\nWITHCODE\r\n"[0: 67]);
    const pattern_command: Command = try command_executor_test_command(&router, &pattern_parsed);
    var pattern_reply: CommandReply = command_execute_at(&engine, &pattern_command, 1000u64);
    try assert_eq_i32(pattern_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_slice_eq(pattern_reply.data, &"*0\r\n"[0: 4]));
    command_reply_cleanup(&pattern_reply);
    resp_value_free(&pattern_parsed.value);

    var missing_pattern_parsed: RespParseResult = try parse_resp2(&"*3\r\n$8\r\nFUNCTION\r\n$4\r\nLIST\r\n$11\r\nLIBRARYNAME\r\n"[0: 46]);
    const missing_pattern_command: Command = try command_executor_test_command(&router, &missing_pattern_parsed);
    var missing_pattern_reply: CommandReply = command_execute_at(&engine, &missing_pattern_command, 1000u64);
    try assert_eq_i32(missing_pattern_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(missing_pattern_reply.data, &"ERR syntax error"[0: 16]));
    command_reply_cleanup(&missing_pattern_reply);
    resp_value_free(&missing_pattern_parsed.value);

    var unknown_arg_parsed: RespParseResult = try parse_resp2(&"*3\r\n$8\r\nFUNCTION\r\n$4\r\nLIST\r\n$1\r\nX\r\n"[0: 35]);
    const unknown_arg_command: Command = try command_executor_test_command(&router, &unknown_arg_parsed);
    var unknown_arg_reply: CommandReply = command_execute_at(&engine, &unknown_arg_command, 1000u64);
    try assert_eq_i32(unknown_arg_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(unknown_arg_reply.data, &"ERR syntax error"[0: 16]));
    command_reply_cleanup(&unknown_arg_reply);
    resp_value_free(&unknown_arg_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_function_stats() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var stats_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nFUNCTION\r\n$5\r\nSTATS\r\n"[0: 29]);
    const stats_command: Command = try command_executor_test_command(&router, &stats_parsed);
    var stats_reply: CommandReply = command_execute_at(&engine, &stats_command, 1000u64);
    try assert_eq_i32(stats_reply.typ as i32, CommandReplyType.reply_raw_bytes as i32);
    try assert_true(command_executor_test_contains(stats_reply.data, &"running_script"[0: 14]));
    try assert_true(command_executor_test_contains(stats_reply.data, &"libraries_count"[0: 15]));
    try assert_true(command_executor_test_contains(stats_reply.data, &"functions_count"[0: 15]));
    command_reply_cleanup(&stats_reply);
    resp_value_free(&stats_parsed.value);

    var bad_arity_parsed: RespParseResult = try parse_resp2(&"*3\r\n$8\r\nFUNCTION\r\n$5\r\nSTATS\r\n$1\r\nX\r\n"[0: 36]);
    const bad_arity_command: Command = try command_executor_test_command(&router, &bad_arity_parsed);
    var bad_arity_reply: CommandReply = command_execute_at(&engine, &bad_arity_command, 1000u64);
    try assert_eq_i32(bad_arity_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(bad_arity_reply.data, &"ERR wrong number of arguments for 'function' command"[0: 52]));
    command_reply_cleanup(&bad_arity_reply);
    resp_value_free(&bad_arity_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

