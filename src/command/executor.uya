fn command_executor_memory_wrong_subcommand_arity(subcommand: &[byte]) CommandReply {
    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }
    _ = command_executor_info_append(&buf, &"ERR wrong number of arguments for 'memory|"[0: 42]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&buf, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&buf, &"' command"[0: 9]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(buf.buf[0: buf.len]);
}

fn command_executor_memory_stats_append_u64(buf: &Sds, name: &[byte], value: u64) !void {
    try command_executor_command_append_bulk(buf, name);
    try command_executor_info_append_u64(buf, &":%u\r\n"[0: 5], value);
}

fn command_executor_memory_stats_append_bulk(buf: &Sds, name: &[byte], value: &[byte]) !void {
    try command_executor_command_append_bulk(buf, name);
    try command_executor_command_append_bulk(buf, value);
}

fn command_executor_memory_stats(engine: &Engine, runtime: &CommandRuntimeInfo) CommandReply {
    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }

    const pair_count: usize = 17;
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], pair_count * 2) catch {
        return command_executor_oom();
    };
    _ = command_executor_memory_stats_append_u64(&raw, &"used_memory"[0: 11], used_memory() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"used_memory_peak"[0: 16], used_memory_peak() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"total_allocated"[0: 15], total_allocated_memory() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"total_freed"[0: 11], total_freed_memory() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"allocator_total_allocations"[0: 27], allocator_total_allocations() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"allocator_active_allocations"[0: 28], allocator_active_allocations() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"allocator_slab_cached_blocks"[0: 28], allocator_slab_cached_blocks() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"allocator_slab_cached_bytes"[0: 27], allocator_slab_cached_bytes() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"allocator_slab_reuse_count"[0: 26], allocator_slab_reuse_count() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"object_pool_cached_objects"[0: 26], object_pool_cached_objects() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"object_pool_cached_list_nodes"[0: 29], object_pool_cached_list_nodes() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"object_pool_reuse_count"[0: 23], object_pool_reuse_count() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"object_layout_size"[0: 18], object_layout_size() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"list_node_layout_size"[0: 21], list_node_layout_size() as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"maxmemory"[0: 9], runtime.config.maxmemory as u64) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_bulk(&raw, &"maxmemory_policy"[0: 16], maxmemory_policy_name(runtime.config.maxmemory_policy)) catch { return command_executor_oom(); };
    _ = command_executor_memory_stats_append_u64(&raw, &"keys.count"[0: 10], engine_len(engine) as u64) catch { return command_executor_oom(); };
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_memory_doctor(engine: &Engine) CommandReply {
    if engine_len(engine) == 0 || used_memory() < 1024usize {
        return command_executor_owned_bulk_copy(&"Memory usage is too small for a useful diagnosis. Load more data and retry."[0: 75]);
    }
    return command_executor_owned_bulk_copy(&"No obvious allocator, object-pool, or maxmemory anomaly was detected by redis-uya's minimal MEMORY DOCTOR." [0: 106]);
}

