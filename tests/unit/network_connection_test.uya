export fn test_connection_zero_copy_get_reply_metadata() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];
    const value: &[byte] = &"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGH"[0: 70];

    const set_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$70\r\nabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGH\r\n"[0: 99], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_result.response_len], &"+OK\r\n"[0: 5]));

    const get_result: ConnectionProcessResult = try connection_process_input_zero_copy_for_test_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_eq_i32(get_result.response_len as i32, 77);
    try assert_eq_i32(get_result.response_head_len as i32, 5);
    try assert_eq_i32(get_result.zero_copy_tail_len as i32, 2);
    try assert_true(network_connection_slice_eq(out[0: get_result.response_head_len], &"$70\r\n"[0: 5]));
    try assert_true(network_connection_slice_eq(get_result.zero_copy_body, value));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_maxmemory() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var runtime: CommandRuntimeInfo = command_runtime_default();
    runtime.config.maxmemory = 1;
    var out: [byte: 256] = [];

    const set_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_contains(out[0: set_result.response_len], &"OOM command not allowed"[0: 23]));

    runtime.config.maxmemory = 0;
    const config_set_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$9\r\nmaxmemory\r\n$3\r\n1mb\r\n"[0: 49], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: config_set_result.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(config_set_result.request_config_set as i32, 1);
    try assert_eq_i32(runtime.config.maxmemory as i32, 1048576);

    var saw_output_too_small: bool = false;
    _ = connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$9\r\nmaxmemory\r\n$3\r\n2mb\r\n"[0: 49], &out[0], 1, 1000u64) catch |err| {
        if err == error.ConnectionOutputTooSmall {
            saw_output_too_small = true;
        }
        return;
    };
    try assert_true(saw_output_too_small);
    try assert_eq_i32(runtime.config.maxmemory as i32, 1048576);

    runtime.config.maxmemory = 0;
    const get_result: ConnectionProcessResult = try connection_process_input_with_runtime_at(&engine, &runtime, &router, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_result.response_len], &"$-1\r\n"[0: 5]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_error_paths() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    const unknown: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$7\r\nMISSING\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: 1], &"-"[0: 1]));
    try assert_eq_i32(unknown.close_after as i32, 0);

    const memory_wrong_arity: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$6\r\nMEMORY\r\n"[0: 16], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: memory_wrong_arity.response_len], &"-ERR wrong number of arguments for 'memory' command\r\n"[0: 53]));

    const module_wrong_arity: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$6\r\nMODULE\r\n"[0: 16], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: module_wrong_arity.response_len], &"-ERR wrong number of arguments for 'module' command\r\n"[0: 53]));

    const slowlog_wrong_arity: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*1\r\n$7\r\nSLOWLOG\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: slowlog_wrong_arity.response_len], &"-ERR wrong number of arguments for 'slowlog' command\r\n"[0: 54]));

    const bad_proto: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"?bad\r\n"[0: 6], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bad_proto.response_len], &"-ERR protocol error\r\n"[0: 21]));
    try assert_eq_i32(bad_proto.close_after as i32, 1);

    var saw_incomplete: bool = false;
    _ = connection_process_input_at(&engine, &router, &"$6\r\nfoo"[0: 7], &out[0], 256, 1000u64) catch |err| {
        if err == error.ConnectionIncomplete {
            saw_incomplete = true;
        }
        return;
    };
    try assert_true(saw_incomplete);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_multi_exec_discard() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 256] = [];

    const multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi.response_len], &"+OK\r\n"[0: 5]));

    const queued_set: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_set.response_len], &"+QUEUED\r\n"[0: 9]));

    const queued_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$3\r\nkey\r\n"[0: 22], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_get.response_len], &"+QUEUED\r\n"[0: 9]));

    const exec: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec.response_len], &"*2\r\n+OK\r\n$5\r\nvalue\r\n"[0: 20]));

    const multi_discard: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_discard.response_len], &"+OK\r\n"[0: 5]));

    const discard_queue: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nSET\r\n$5\r\nother\r\n$3\r\nabc\r\n"[0: 33], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard_queue.response_len], &"+QUEUED\r\n"[0: 9]));

    const discard: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nDISCARD\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard.response_len], &"+OK\r\n"[0: 5]));

    const get_other: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$5\r\nother\r\n"[0: 24], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_other.response_len], &"$-1\r\n"[0: 5]));

    const exec_without_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec_without_multi.response_len], &"-ERR EXEC without MULTI\r\n"[0: 25]));

    const discard_without_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nDISCARD\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: discard_without_multi.response_len], &"-ERR DISCARD without MULTI\r\n"[0: 28]));

    const multi_again: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_again.response_len], &"+OK\r\n"[0: 5]));

    const nested_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: nested_multi.response_len], &"-ERR MULTI calls can not be nested\r\n"[0: 36]));

    const empty_exec: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: empty_exec.response_len], &"*0\r\n"[0: 4]));

    const multi_script: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_script.response_len], &"+OK\r\n"[0: 5]));

    const queued_eval: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*5\r\n$4\r\nEVAL\r\n$42\r\nreturn redis.call('SET', KEYS[1], ARGV[1])\r\n$1\r\n1\r\n$6\r\ntx-lua\r\n$3\r\ntxv\r\n"[0: 91], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_eval.response_len], &"+QUEUED\r\n"[0: 9]));

    const queued_script_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$6\r\ntx-lua\r\n"[0: 25], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_script_get.response_len], &"+QUEUED\r\n"[0: 9]));

    const exec_script: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec_script.response_len], &"*2\r\n+OK\r\n$3\r\ntxv\r\n"[0: 18]));

    const script_flush: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nSCRIPT\r\n$5\r\nFLUSH\r\n"[0: 27], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: script_flush.response_len], &"+OK\r\n"[0: 5]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_pipeline_batch() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 4096] = [];

    const pipeline: &[byte] = &"*1\r\n$5\r\nMULTI\r\n*3\r\n$3\r\nSET\r\n$4\r\nmkey\r\n$4\r\nmval\r\n*2\r\n$3\r\nGET\r\n$4\r\nmkey\r\n*1\r\n$4\r\nEXEC\r\n"[0: 85];
    const result: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, pipeline, &out[0], 512, 1000u64);
    try assert_eq_i32(result.consumed as i32, pipeline.len as i32);
    try assert_true(network_connection_slice_eq(out[0: result.response_len], &"+OK\r\n+QUEUED\r\n+QUEUED\r\n*2\r\n+OK\r\n$4\r\nmval\r\n"[0: 42]));

    const get_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$4\r\nmkey\r\n"[0: 23], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_result.response_len], &"$4\r\nmval\r\n"[0: 10]));

    var config_runtime: CommandRuntimeInfo = command_runtime_default();
    const config_pipeline: &[byte] = &"*4\r\n$6\r\nCONFIG\r\n$3\r\nSET\r\n$9\r\nmaxmemory\r\n$3\r\n1mb\r\n*3\r\n$6\r\nCONFIG\r\n$3\r\nGET\r\n$9\r\nmaxmemory\r\n"[0: 89];
    const config_result: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &config_runtime, &router, &tx, config_pipeline, &out[0], 512, 1000u64);
    try assert_eq_i32(config_result.consumed as i32, config_pipeline.len as i32);
    try assert_true(network_connection_slice_eq(out[0: config_result.response_len], &"+OK\r\n*2\r\n$9\r\nmaxmemory\r\n$7\r\n1048576\r\n"[0: 37]));
    try assert_eq_i32(config_runtime.config.maxmemory as i32, 1048576);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_watch_unwatch() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 512] = [];

    const watch: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nWATCH\r\n$7\r\nwatched\r\n"[0: 28], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 1);

    const watch_duplicate_and_second: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$5\r\nWATCH\r\n$7\r\nwatched\r\n$11\r\nwatched-two\r\n"[0: 46], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch_duplicate_and_second.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 1);

    const outside_set: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$7\r\nwatched\r\n$7\r\noutside\r\n"[0: 41], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: outside_set.response_len], &"+OK\r\n"[0: 5]));

    const dirty_info: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$4\r\nINFO\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: dirty_info.response_len], &"flags=d"[0: 7]));
    try assert_true(network_connection_contains(out[0: dirty_info.response_len], &"watch=2"[0: 7]));

    const multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi.response_len], &"+OK\r\n"[0: 5]));

    const watch_inside_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nWATCH\r\n$7\r\nwatched\r\n"[0: 28], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch_inside_multi.response_len], &"-ERR WATCH inside MULTI is not allowed\r\n"[0: 40]));

    const queued_set: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nSET\r\n$7\r\nwatched\r\n$3\r\ntxn\r\n"[0: 37], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_set.response_len], &"+QUEUED\r\n"[0: 9]));

    const exec_abort: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec_abort.response_len], &"*-1\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 0);

    const clean_info: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$4\r\nINFO\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: clean_info.response_len], &"flags=N"[0: 7]));
    try assert_true(network_connection_contains(out[0: clean_info.response_len], &"watch=0"[0: 7]));

    const get_outside: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$7\r\nwatched\r\n"[0: 26], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_outside.response_len], &"$7\r\noutside\r\n"[0: 13]));

    const watch_again: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nWATCH\r\n$7\r\nwatched\r\n"[0: 28], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch_again.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 1);

    const unwatch: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nUNWATCH\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: unwatch.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 0);

    const multi_again: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: multi_again.response_len], &"+OK\r\n"[0: 5]));

    const unwatch_inside_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$7\r\nUNWATCH\r\n"[0: 17], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: unwatch_inside_multi.response_len], &"-ERR UNWATCH inside MULTI is not allowed\r\n"[0: 42]));

    const queued_set_again: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$3\r\nSET\r\n$7\r\nwatched\r\n$2\r\nok\r\n"[0: 36], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_set_again.response_len], &"+QUEUED\r\n"[0: 9]));

    const outside_set_again: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$7\r\nwatched\r\n$5\r\nother\r\n"[0: 39], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: outside_set_again.response_len], &"+OK\r\n"[0: 5]));

    const exec_ok: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: exec_ok.response_len], &"*1\r\n+OK\r\n"[0: 9]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 0);

    const get_ok: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$7\r\nwatched\r\n"[0: 26], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_ok.response_len], &"$2\r\nok\r\n"[0: 8]));

    const set_copy_source: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$7\r\nsrc2cpy\r\n$5\r\nvalue\r\n"[0: 37], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_copy_source.response_len], &"+OK\r\n"[0: 5]));

    const watch_copy_target: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nWATCH\r\n$8\r\ncopydest\r\n"[0: 29], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch_copy_target.response_len], &"+OK\r\n"[0: 5]));

    const copy_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: copy_multi.response_len], &"+OK\r\n"[0: 5]));

    const queued_copy_get: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$8\r\ncopydest\r\n"[0: 27], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_copy_get.response_len], &"+QUEUED\r\n"[0: 9]));

    const outside_copy: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$4\r\nCOPY\r\n$7\r\nsrc2cpy\r\n$8\r\ncopydest\r\n"[0: 41], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: outside_copy.response_len], &":1\r\n"[0: 4]));

    const copy_exec_abort: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: copy_exec_abort.response_len], &"*-1\r\n"[0: 5]));

    const get_copy_dest: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$8\r\ncopydest\r\n"[0: 27], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_copy_dest.response_len], &"$5\r\nvalue\r\n"[0: 11]));

    const zadd_watchlex: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*10\r\n$4\r\nZADD\r\n$8\r\nwatchlex\r\n$1\r\n0\r\n$5\r\nalpha\r\n$1\r\n0\r\n$4\r\nbeta\r\n$1\r\n0\r\n$7\r\ncharlie\r\n$1\r\n0\r\n$5\r\ndelta\r\n"[0: 102], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: zadd_watchlex.response_len], &":4\r\n"[0: 4]));

    const watch_lex: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nWATCH\r\n$8\r\nwatchlex\r\n"[0: 29], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: watch_lex.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 1);

    const lex_multi: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$5\r\nMULTI\r\n"[0: 15], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: lex_multi.response_len], &"+OK\r\n"[0: 5]));

    const queued_lex_read: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$11\r\nZRANGEBYLEX\r\n$8\r\nwatchlex\r\n$1\r\n-\r\n$1\r\n+\r\n"[0: 50], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: queued_lex_read.response_len], &"+QUEUED\r\n"[0: 9]));

    const outside_zremrangebylex: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$14\r\nZREMRANGEBYLEX\r\n$8\r\nwatchlex\r\n$6\r\n[alpha\r\n$8\r\n[charlie\r\n"[0: 65], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: outside_zremrangebylex.response_len], &":3\r\n"[0: 4]));

    const lex_exec_abort: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*1\r\n$4\r\nEXEC\r\n"[0: 14], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: lex_exec_abort.response_len], &"*-1\r\n"[0: 5]));
    try assert_eq_i32(engine_watch_client_count(&engine) as i32, 0);

    const lex_after_rem: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*4\r\n$11\r\nZRANGEBYLEX\r\n$8\r\nwatchlex\r\n$1\r\n-\r\n$1\r\n+\r\n"[0: 50], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: lex_after_rem.response_len], &"*1\r\n$5\r\ndelta\r\n"[0: 15]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_resp3_hello() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 512] = [];

    const hello3: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n3\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_eq_i32(hello3.response_len as i32, 154);
    try assert_true(network_connection_contains(out[0: hello3.response_len], &"%7\r\n$6\r\nserver\r\n$9\r\nredis-uya\r\n"[0: 31]));
    try assert_true(network_connection_contains(out[0: hello3.response_len], &"$7\r\nversion\r\n$10\r\n"[0: 18]));
    try assert_true(network_connection_contains(out[0: hello3.response_len], redis_uya_version()));
    try assert_true(network_connection_contains(out[0: hello3.response_len], &"$5\r\nproto\r\n:3\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: hello3.response_len], &"$7\r\nmodules\r\n*0\r\n"[0: 17]));

    const missing_resp3: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: missing_resp3.response_len], &"_\r\n"[0: 3]));

    const hello2: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n2\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_eq_i32(hello2.response_len as i32, 155);
    try assert_true(network_connection_contains(out[0: hello2.response_len], &"*14\r\n$6\r\nserver\r\n$9\r\nredis-uya\r\n"[0: 32]));
    try assert_true(network_connection_contains(out[0: hello2.response_len], &"$7\r\nversion\r\n$10\r\n"[0: 18]));
    try assert_true(network_connection_contains(out[0: hello2.response_len], redis_uya_version()));
    try assert_true(network_connection_contains(out[0: hello2.response_len], &"$5\r\nproto\r\n:2\r\n"[0: 15]));
    try assert_true(network_connection_contains(out[0: hello2.response_len], &"$7\r\nmodules\r\n*0\r\n"[0: 17]));

    const missing_resp2: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: missing_resp2.response_len], &"$-1\r\n"[0: 5]));

    const bad_hello: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$5\r\nHELLO\r\n$1\r\n4\r\n"[0: 22], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bad_hello.response_len], &"-NOPROTO unsupported protocol version\r\n"[0: 39]));

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_connection_process_client_commands() !void {
    reset_memory_stats_for_test();
    connection_pubsub_reset_for_test();
    connection_client_registry_reset_for_test();
    defer {
        connection_pubsub_reset_for_test();
        connection_client_registry_reset_for_test();
    }
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var tx: ConnectionTransaction = connection_transaction_new();
    tx.client_fd = 42;
    connection_transaction_set_client_addresses(&tx, &"127.0.0.1:50000"[0: 15], &"127.0.0.1:6380"[0: 14]);
    defer {
        connection_transaction_reset(&tx);
    }
    var out: [byte: 1024] = [];

    const client_id: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$2\r\nID\r\n"[0: 24], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: client_id.response_len], &":1\r\n"[0: 4]));

    const get_empty: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$7\r\nGETNAME\r\n"[0: 29], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_empty.response_len], &"$-1\r\n"[0: 5]));

    const set_name: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$7\r\nSETNAME\r\n$6\r\nworker\r\n"[0: 41], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_name.response_len], &"+OK\r\n"[0: 5]));

    const get_name: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$7\r\nGETNAME\r\n"[0: 29], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: get_name.response_len], &"$6\r\nworker\r\n"[0: 12]));

    var client_help_out: [byte: 2048] = [];
    const client_help: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$4\r\nHELP\r\n"[0: 26], &client_help_out[0], 2048, 1000u64);
    try assert_true(network_connection_contains(client_help_out[0: client_help.response_len], &"CLIENT REPLY <ON|OFF|SKIP>"[0: 26]));
    try assert_true(network_connection_contains(client_help_out[0: client_help.response_len], &"CLIENT LIST [TYPE NORMAL|MASTER|REPLICA|PUBSUB] | [ID <id> ...]"[0: 63]));
    try assert_true(network_connection_contains(client_help_out[0: client_help.response_len], &"CLIENT KILL [ID <id>] [ADDR <ip:port>] [LADDR <ip:port>] [USER <username>] [TYPE <normal|master|replica|pubsub>] [MAXAGE <seconds>] [SKIPME yes|no]"[0: 147]));
    try assert_true(network_connection_contains(client_help_out[0: client_help.response_len], &"CLIENT TRACKINGINFO"[0: 19]));

    const caching_yes: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$7\r\nCACHING\r\n$3\r\nYES\r\n"[0: 38], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: caching_yes.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(tx.caching_enabled as i32, 1);

    const caching_no: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$7\r\nCACHING\r\n$2\r\nNO\r\n"[0: 37], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: caching_no.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(tx.caching_enabled as i32, 0);

    const caching_bad: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$7\r\nCACHING\r\n$3\r\nBAD\r\n"[0: 38], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: caching_bad.response_len], &"-ERR syntax error\r\n"[0: 19]));

    const no_touch_on: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nNO-TOUCH\r\n$2\r\nON\r\n"[0: 38], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_on.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(tx.no_touch_enabled as i32, 1);
    const no_touch_info: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$4\r\nINFO\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: no_touch_info.response_len], &"flags=T"[0: 7]));

    const no_touch_off: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nNO-TOUCH\r\n$3\r\nOFF\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_off.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(tx.no_touch_enabled as i32, 0);

    const no_touch_bad: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nNO-TOUCH\r\n$3\r\nBAD\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_bad.response_len], &"-ERR syntax error\r\n"[0: 19]));

    var lfu_runtime: CommandRuntimeInfo = command_runtime_default();
    lfu_runtime.config.maxmemory_policy = MaxmemoryPolicy.maxmemory_allkeys_lfu;
    const no_touch_set: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &lfu_runtime, &router, &tx, &"*3\r\n$3\r\nSET\r\n$5\r\nntkey\r\n$5\r\nvalue\r\n"[0: 35], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_set.response_len], &"+OK\r\n"[0: 5]));

    const no_touch_freq_before: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &lfu_runtime, &router, &tx, &"*3\r\n$6\r\nOBJECT\r\n$4\r\nFREQ\r\n$5\r\nntkey\r\n"[0: 37], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_freq_before.response_len], &":1\r\n"[0: 4]));

    const no_touch_enable: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &lfu_runtime, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nNO-TOUCH\r\n$2\r\nON\r\n"[0: 38], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_enable.response_len], &"+OK\r\n"[0: 5]));

    const no_touch_get: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &lfu_runtime, &router, &tx, &"*2\r\n$3\r\nGET\r\n$5\r\nntkey\r\n"[0: 24], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_get.response_len], &"$5\r\nvalue\r\n"[0: 11]));

    const no_touch_freq_after_get: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &lfu_runtime, &router, &tx, &"*3\r\n$6\r\nOBJECT\r\n$4\r\nFREQ\r\n$5\r\nntkey\r\n"[0: 37], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_freq_after_get.response_len], &":1\r\n"[0: 4]));

    const no_touch_disable: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &lfu_runtime, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nNO-TOUCH\r\n$3\r\nOFF\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_disable.response_len], &"+OK\r\n"[0: 5]));

    const no_touch_get_after_off: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &lfu_runtime, &router, &tx, &"*2\r\n$3\r\nGET\r\n$5\r\nntkey\r\n"[0: 24], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_get_after_off.response_len], &"$5\r\nvalue\r\n"[0: 11]));

    const no_touch_freq_after_off: ConnectionProcessResult = try connection_process_input_with_runtime_with_transaction_at(&engine, &lfu_runtime, &router, &tx, &"*3\r\n$6\r\nOBJECT\r\n$4\r\nFREQ\r\n$5\r\nntkey\r\n"[0: 37], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_touch_freq_after_off.response_len], &":2\r\n"[0: 4]));

    const no_evict_on: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nNO-EVICT\r\n$2\r\nON\r\n"[0: 38], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_evict_on.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(tx.no_evict_enabled as i32, 1);
    const no_evict_info: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$4\r\nINFO\r\n"[0: 26], &out[0], 512, 1000u64);
    try assert_true(network_connection_contains(out[0: no_evict_info.response_len], &"flags=e"[0: 7]));

    const no_evict_off: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nNO-EVICT\r\n$3\r\nOFF\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_evict_off.response_len], &"+OK\r\n"[0: 5]));
    try assert_eq_i32(tx.no_evict_enabled as i32, 0);

    const no_evict_bad: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*3\r\n$6\r\nCLIENT\r\n$8\r\nNO-EVICT\r\n$3\r\nBAD\r\n"[0: 39], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: no_evict_bad.response_len], &"-ERR syntax error\r\n"[0: 19]));

    const set_lib_name: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$14\r\nredis-uya-test\r\n"[0: 64], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_lib_name.response_len], &"+OK\r\n"[0: 5]));

    const set_lib_ver: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n0.5.0\r\n"[0: 53], &out[0], 512, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: set_lib_ver.response_len], &"+OK\r\n"[0: 5]));
    connection_transaction_set_client_times(&tx, 1000u64, 10000u64);
    connection_transaction_set_query_buffer(&tx, 26, 8192);
    connection_transaction_set_output_buffer(&tx, 4096);

    const client_info: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*2\r\n$6\r\nCLIENT\r\n$4\r\nINFO\r\n"[0: 26], &out[0], 512, 10000u64);
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"id=1"[0: 4]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"addr=127.0.0.1:50000"[0: 20]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"laddr=127.0.0.1:6380"[0: 20]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"fd=42"[0: 5]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"db=0"[0: 4]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"user=default"[0: 12]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"flags=N"[0: 7]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"cmd=client|info"[0: 15]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"redir=-1"[0: 8]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"multi=-1"[0: 8]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"sub=0"[0: 5]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"psub=0"[0: 6]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"ssub=0"[0: 6]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"qbuf=26"[0: 7]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"qbuf-free=8166"[0: 14]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"argv-mem=0"[0: 10]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"multi-mem=0"[0: 11]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"rbs=81920"[0: 9]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"rbp=81920"[0: 9]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"obl=4096"[0: 8]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"oll=0"[0: 5]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"omem=0"[0: 6]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"tot-mem="[0: 8]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"events=w"[0: 8]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"age=9 idle=0"[0: 12]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"name=worker"[0: 11]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"lib-name=redis-uya-test"[0: 23]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"lib-ver=0.5.0"[0: 13]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"io-thread=0"[0: 11]));
    try assert_true(network_connection_contains(out[0: client_info.response_len], &"tot-net-in=0"[0: 12]));

    var tx2: ConnectionTransaction = connection_transaction_new();
    tx2.client_fd = 43;
    connection_transaction_set_client_addresses(&tx2, &"127.0.0.1:50001"[0: 15], &"127.0.0.1:6380"[0: 14]);
    connection_transaction_set_client_times(&tx2, 2000u64, 7000u64);
    defer {
        connection_transaction_reset(&tx2);
