fn command_executor_latency_latest() CommandReply {
    if !latency_command_is_active() {
        return command_executor_owned_raw(&"*0\r\n"[0: 4]);
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], 1) catch { return command_executor_oom(); };
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], 4) catch { return command_executor_oom(); };
    _ = command_executor_command_append_bulk(&raw, &"command"[0: 7]) catch { return command_executor_oom(); };
    _ = command_executor_info_append_u64(&raw, &":%u\r\n"[0: 5], latency_command_latest_timestamp_sec()) catch { return command_executor_oom(); };
    _ = command_executor_info_append_u64(&raw, &":%u\r\n"[0: 5], latency_command_latest_latency_ms()) catch { return command_executor_oom(); };
    _ = command_executor_info_append_u64(&raw, &":%u\r\n"[0: 5], latency_command_max_latency_ms()) catch { return command_executor_oom(); };
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_latency_history(event: &[byte]) CommandReply {
    const count: usize = latency_history_count(event);
    if count == 0 {
        return command_executor_owned_raw(&"*0\r\n"[0: 4]);
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], count) catch { return command_executor_oom(); };
    var index: usize = 0;
    while index < count {
        const entry: &LatencyHistoryEntry = latency_history_entry(event, index);
        if entry != null {
            _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], 2) catch { return command_executor_oom(); };
            _ = command_executor_info_append_u64(&raw, &":%u\r\n"[0: 5], entry.timestamp_sec) catch { return command_executor_oom(); };
            _ = command_executor_info_append_u64(&raw, &":%u\r\n"[0: 5], entry.latency_ms) catch { return command_executor_oom(); };
        }
        index = index + 1;
    }
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_latency_histogram_bucket_pair_count(entry: &LatencyHistogramEntry) usize {
    var count: usize = 0;
    var index: usize = 0;
    while index < LATENCY_HISTOGRAM_BUCKET_COUNT {
        if latency_histogram_entry_bucket_count(entry, index) > 0u64 {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn command_executor_latency_histogram_append_entry(raw: &Sds, entry: &LatencyHistogramEntry) !void {
    try command_executor_command_append_bulk(raw, latency_histogram_entry_name(entry));
    try command_executor_resp_collection_prefix(raw, &"*"[0: 1], 4);
    try command_executor_command_append_bulk(raw, &"calls"[0: 5]);
    try command_executor_info_append_u64(raw, &":%u\r\n"[0: 5], entry.calls);
    try command_executor_command_append_bulk(raw, &"histogram_usec"[0: 14]);

    const pair_count: usize = command_executor_latency_histogram_bucket_pair_count(entry);
    try command_executor_resp_collection_prefix(raw, &"*"[0: 1], pair_count * 2);
    var cumulative: u64 = 0u64;
    var index: usize = 0;
    while index < LATENCY_HISTOGRAM_BUCKET_COUNT {
        const bucket_count: u64 = latency_histogram_entry_bucket_count(entry, index);
        cumulative = cumulative + bucket_count;
        if bucket_count > 0u64 {
            try command_executor_info_append_u64(raw, &":%u\r\n"[0: 5], latency_histogram_bucket_usec(index));
            try command_executor_info_append_u64(raw, &":%u\r\n"[0: 5], cumulative);
        }
        index = index + 1;
    }
}

fn command_executor_latency_histogram_result_count(command: &Command) usize {
    if command.argc == 2 {
        return latency_histogram_count();
    }
    var count: usize = 0;
    var index: usize = 2;
    while index < command.argc {
        const name: &[byte] = command_executor_arg(command, index) catch {
            return count;
        };
        if latency_histogram_find_entry(name) != null {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn command_executor_latency_histogram(command: &Command) CommandReply {
    const result_count: usize = command_executor_latency_histogram_result_count(command);
    if result_count == 0 {
        return command_executor_owned_raw(&"*0\r\n"[0: 4]);
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], result_count * 2) catch { return command_executor_oom(); };

    if command.argc == 2 {
        var index: usize = 0;
        while index < latency_histogram_count() {
            const entry: &LatencyHistogramEntry = latency_histogram_entry_at(index);
            if entry != null {
                _ = command_executor_latency_histogram_append_entry(&raw, entry) catch { return command_executor_oom(); };
            }
            index = index + 1;
        }
    } else {
        var arg_index: usize = 2;
        while arg_index < command.argc {
            const name: &[byte] = command_executor_arg(command, arg_index) catch {
                return command_executor_latency_wrong_subcommand_arity(&"histogram"[0: 9]);
            };
            const entry: &LatencyHistogramEntry = latency_histogram_find_entry(name);
            if entry != null {
                _ = command_executor_latency_histogram_append_entry(&raw, entry) catch { return command_executor_oom(); };
            }
            arg_index = arg_index + 1;
        }
    }
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_latency_graph(event: &[byte]) CommandReply {
    const count: usize = latency_history_count(event);
    if count == 0 {
        return command_executor_owned_bulk_copy(&"LATENCY GRAPH is empty because redis-uya has not recorded latency events for this event."[0: 88]);
    }
    return command_executor_owned_bulk_copy(&"command latency history is available via LATENCY HISTORY command; redis-uya graph rendering is still a minimal text compatibility surface."[0: 130]);
}

fn command_executor_latency_doctor() CommandReply {
    if !latency_command_is_active() {
        return command_executor_owned_bulk_copy(&"No latency events are available yet. redis-uya currently exposes a minimal LATENCY compatibility surface; event sampling and histograms are planned after the v0.9.2 command gap pass."[0: 182]);
    }
    return command_executor_owned_bulk_copy(&"Latency monitor has recorded command events. redis-uya currently samples command execution duration with millisecond-granularity runtime time and keeps an in-process command event history."[0: 174]);
}

fn command_executor_latency(command: &Command) CommandReply {
    if command.argc < 2 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'latency' command"[0: 51]);
    }

    const subcommand: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'latency' command"[0: 51]);
    };
    if command_executor_keyword_eq(subcommand, &"HELP"[0: 4]) {
        if command.argc != 2 {
            return command_executor_latency_wrong_subcommand_arity(&"help"[0: 4]);
        }
        return command_executor_latency_help();
    }
    if command_executor_keyword_eq(subcommand, &"DOCTOR"[0: 6]) {
        if command.argc != 2 {
            return command_executor_latency_wrong_subcommand_arity(&"doctor"[0: 6]);
        }
        return command_executor_latency_doctor();
    }
    if command_executor_keyword_eq(subcommand, &"LATEST"[0: 6]) {
        if command.argc != 2 {
            return command_executor_latency_wrong_subcommand_arity(&"latest"[0: 6]);
        }
        return command_executor_latency_latest();
    }
    if command_executor_keyword_eq(subcommand, &"HISTORY"[0: 7]) {
        if command.argc != 3 {
            return command_executor_latency_wrong_subcommand_arity(&"history"[0: 7]);
        }
        const event: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_latency_wrong_subcommand_arity(&"history"[0: 7]);
        };
        return command_executor_latency_history(event);
    }
    if command_executor_keyword_eq(subcommand, &"GRAPH"[0: 5]) {
        if command.argc != 3 {
            return command_executor_latency_wrong_subcommand_arity(&"graph"[0: 5]);
        }
        const event: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_latency_wrong_subcommand_arity(&"graph"[0: 5]);
        };
        return command_executor_latency_graph(event);
    }
    if command_executor_keyword_eq(subcommand, &"HISTOGRAM"[0: 9]) {
        return command_executor_latency_histogram(command);
    }
    if command_executor_keyword_eq(subcommand, &"RESET"[0: 5]) {
        if command.argc == 2 {
            return command_executor_integer(latency_reset_all() as i64);
        }
        var removed: usize = 0;
        var index: usize = 2;
        while index < command.argc {
            const event: &[byte] = command_executor_arg(command, index) catch {
                return command_executor_latency_wrong_subcommand_arity(&"reset"[0: 5]);
            };
            removed = removed + latency_reset_event(event);
            index = index + 1;
        }
        return command_executor_integer(removed as i64);
    }

    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR unknown subcommand '"[0: 24]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"'. Try LATENCY HELP."[0: 20]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

