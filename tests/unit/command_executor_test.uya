    resp_value_free(&hset_parsed.value);

    var hincrby_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nHINCRBY\r\n$4\r\nhash\r\n$7\r\ncounter\r\n$1\r\n2\r\n"[0: 47]);
