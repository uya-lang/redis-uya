    try assert_eq_i32(zremrangebylex_missing_reply.integer as i32, 0);
    resp_value_free(&zremrangebylex_missing_parsed.value);

    var zremrangebylex_bad_parsed: RespParseResult = try parse_resp2(&"*4\r\n$14\r\nZREMRANGEBYLEX\r\n$7\r\nmissing\r\n$5\r\nalpha\r\n$1\r\n+\r\n"[0: 56]);
