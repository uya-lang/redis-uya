    command_reply_cleanup(&lrange_after_ltrim_reply);
    resp_value_free(&lrange_after_ltrim_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_lpushx_rpushx_lpos() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var rpush_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nRPUSH\r\n$5\r\nxlist\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 40]);
    const rpush_command: Command = try command_executor_test_command(&router, &rpush_parsed);
    const rpush_reply: CommandReply = command_execute_at(&engine, &rpush_command, 1000u64);
    try assert_eq_i32(rpush_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(rpush_reply.integer as i32, 2);
    resp_value_free(&rpush_parsed.value);

    var lpushx_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nLPUSHX\r\n$7\r\nmissing\r\n$1\r\nz\r\n"[0: 36]);
    const lpushx_missing_command: Command = try command_executor_test_command(&router, &lpushx_missing_parsed);
    const lpushx_missing_reply: CommandReply = command_execute_at(&engine, &lpushx_missing_command, 1000u64);
    try assert_eq_i32(lpushx_missing_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(lpushx_missing_reply.integer as i32, 0);
    resp_value_free(&lpushx_missing_parsed.value);

    var lpushx_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nLPUSHX\r\n$5\r\nxlist\r\n$4\r\nhead\r\n"[0: 37]);
    const lpushx_command: Command = try command_executor_test_command(&router, &lpushx_parsed);
    const lpushx_reply: CommandReply = command_execute_at(&engine, &lpushx_command, 1000u64);
    try assert_eq_i32(lpushx_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(lpushx_reply.integer as i32, 3);
    resp_value_free(&lpushx_parsed.value);

    var rpushx_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nRPUSHX\r\n$5\r\nxlist\r\n$4\r\ntail\r\n"[0: 37]);
    const rpushx_command: Command = try command_executor_test_command(&router, &rpushx_parsed);
    const rpushx_reply: CommandReply = command_execute_at(&engine, &rpushx_command, 1000u64);
    try assert_eq_i32(rpushx_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(rpushx_reply.integer as i32, 4);
    resp_value_free(&rpushx_parsed.value);

    var lpos_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nLPOS\r\n$5\r\nxlist\r\n$1\r\nb\r\n"[0: 32]);
    const lpos_command: Command = try command_executor_test_command(&router, &lpos_parsed);
    const lpos_reply: CommandReply = command_execute_at(&engine, &lpos_command, 1000u64);
    try assert_eq_i32(lpos_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(lpos_reply.integer as i32, 2);
    resp_value_free(&lpos_parsed.value);

    var lrange_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nLRANGE\r\n$5\r\nxlist\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 42]);
    const lrange_command: Command = try command_executor_test_command(&router, &lrange_parsed);
    const lrange_reply: CommandReply = command_execute_at(&engine, &lrange_command, 1000u64);
    const lrange_len: usize = try connection_encode_reply(&lrange_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: lrange_len], &"*4\r\n$4\r\nhead\r\n$1\r\na\r\n$1\r\nb\r\n$4\r\ntail\r\n"[0: 38]));
    command_reply_cleanup(&lrange_reply);
    resp_value_free(&lrange_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_lmove_rpoplpush() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 512] = [];

    var rpush_src_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nRPUSH\r\n$3\r\nsrc\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 45]);
    const rpush_src_command: Command = try command_executor_test_command(&router, &rpush_src_parsed);
    _ = command_execute_at(&engine, &rpush_src_command, 1000u64);
    resp_value_free(&rpush_src_parsed.value);

    var rpoplpush_parsed: RespParseResult = try parse_resp2(&"*3\r\n$9\r\nRPOPLPUSH\r\n$3\r\nsrc\r\n$3\r\ndst\r\n"[0: 37]);
    const rpoplpush_command: Command = try command_executor_test_command(&router, &rpoplpush_parsed);
    const rpoplpush_reply: CommandReply = command_execute_at(&engine, &rpoplpush_command, 1000u64);
    try assert_eq_i32(rpoplpush_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(rpoplpush_reply.data, &"c"[0: 1]));
    command_reply_cleanup(&rpoplpush_reply);
    resp_value_free(&rpoplpush_parsed.value);

    var lmove_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nLMOVE\r\n$3\r\nsrc\r\n$3\r\ndst\r\n$4\r\nLEFT\r\n$5\r\nRIGHT\r\n"[0: 54]);
    const lmove_command: Command = try command_executor_test_command(&router, &lmove_parsed);
    const lmove_reply: CommandReply = command_execute_at(&engine, &lmove_command, 1000u64);
    try assert_eq_i32(lmove_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(lmove_reply.data, &"a"[0: 1]));
    command_reply_cleanup(&lmove_reply);
    resp_value_free(&lmove_parsed.value);

    var lrange_src_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nLRANGE\r\n$3\r\nsrc\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 40]);
    const lrange_src_command: Command = try command_executor_test_command(&router, &lrange_src_parsed);
    var lrange_src_reply: CommandReply = command_execute_at(&engine, &lrange_src_command, 1000u64);
    const lrange_src_len: usize = try connection_encode_reply(&lrange_src_reply, &out[0], 512);
    try assert_true(command_executor_test_slice_eq(out[0: lrange_src_len], &"*1\r\n$1\r\nb\r\n"[0: 11]));
    command_reply_cleanup(&lrange_src_reply);
    resp_value_free(&lrange_src_parsed.value);

    var blmove_parsed: RespParseResult = try parse_resp2(&"*6\r\n$6\r\nBLMOVE\r\n$3\r\nsrc\r\n$3\r\ndst\r\n$5\r\nRIGHT\r\n$5\r\nRIGHT\r\n$1\r\n1\r\n"[0: 63]);
    const blmove_command: Command = try command_executor_test_command(&router, &blmove_parsed);
    const blmove_reply: CommandReply = command_execute_at(&engine, &blmove_command, 1000u64);
    try assert_eq_i32(blmove_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(blmove_reply.data, &"b"[0: 1]));
    command_reply_cleanup(&blmove_reply);
    resp_value_free(&blmove_parsed.value);

    var lrange_dst_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nLRANGE\r\n$3\r\ndst\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 40]);
