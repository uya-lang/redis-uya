    var getkeys_memory_usage_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &getkeys_memory_usage_command, 1000u64);
    try assert_true(command_executor_test_slice_eq(getkeys_memory_usage_reply.data, &"*1\r\n$3\r\nkey\r\n"[0: 13]));
    command_reply_cleanup(&getkeys_memory_usage_reply);
    resp_value_free(&getkeys_memory_usage_parsed.value);

    var getkeys_memory_usage_flags_parsed: RespParseResult = try parse_resp2(&"*5\r\n$7\r\nCOMMAND\r\n$15\r\nGETKEYSANDFLAGS\r\n$6\r\nMEMORY\r\n$5\r\nUSAGE\r\n$3\r\nkey\r\n"[0: 71]);
    const getkeys_memory_usage_flags_command: Command = try command_executor_test_command(&router, &getkeys_memory_usage_flags_parsed);
    var getkeys_memory_usage_flags_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &getkeys_memory_usage_flags_command, 1000u64);
    try assert_true(command_executor_test_slice_eq(getkeys_memory_usage_flags_reply.data, &"*1\r\n*2\r\n$3\r\nkey\r\n*2\r\n$2\r\nRO\r\n$6\r\naccess\r\n"[0: 41]));
    command_reply_cleanup(&getkeys_memory_usage_flags_reply);
    resp_value_free(&getkeys_memory_usage_flags_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

