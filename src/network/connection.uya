            runtime,
            router,
            aof,
            rewrite_buf,
            backlog,
            tx,
            &parsed,
            &command,
            out,
            out_cap,
            now_ms,
            rewrite_failed,
        );
    }
    if connection_command_is_blocking_pop(command.info.cmd_type) {
        return connection_execute_blocking_pop_command_at(
            engine,
            runtime,
            router,
            aof,
            rewrite_buf,
            backlog,
            tx,
            &parsed,
            &command,
            input,
            out,
            out_cap,
            now_ms,
            replicaof_requested,
            replicaof_promote,
            replicaof_host,
            replicaof_port,
            bgsave_requested,
            rewrite_requested,
            rewrite_failed,
            zero_copy_bulk,
        );
    }
    if command.info.cmd_type == CommandType.command_ping ||
        command.info.cmd_type == CommandType.command_get ||
        command.info.cmd_type == CommandType.command_set {
        return connection_execute_standard_command_at(
            engine,
            runtime,
            router,
            aof,
            rewrite_buf,
            backlog,
            tx,
            &parsed,
            &command,
            input,
            out,
            out_cap,
            now_ms,
            replicaof_requested,
            replicaof_promote,
            replicaof_host,
            replicaof_port,
            bgsave_requested,
            rewrite_requested,
            rewrite_failed,
            zero_copy_bulk,
        );
    }
    if command.info.cmd_type == CommandType.command_shutdown {
        _ = connection_handle_shutdown(&command) catch {
            const shutdown_err: CommandReply = connection_error_reply(&"ERR syntax error"[0: 16]);
            const shutdown_err_n: usize = try connection_encode_reply_for_command(tx, &command, &shutdown_err, out, out_cap, reply_off_before, reply_skip_before);
            resp_value_free(&parsed.value);
            return ConnectionProcessResult{ response_len: shutdown_err_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
        };
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{
            response_len: 0,
            response_head_len: 0,
            zero_copy_body: connection_reply_empty_slice(),
            zero_copy_tail_len: 0,
            consumed: parsed.consumed,
            close_after: true,
            request_replicaof: false,
            replicaof_promote: false,
            request_bgsave: false,
            request_aof_rewrite: false,
            request_shutdown: true,
        };
    }

    if command.info.cmd_type == CommandType.command_hello {
        var hello_reply: CommandReply = connection_handle_hello(tx, runtime, &command);
        const hello_n: usize = try connection_encode_reply_for_command(tx, &command, &hello_reply, out, out_cap, reply_off_before, reply_skip_before);
        command_reply_cleanup(&hello_reply);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: hello_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_reset {
        const reset_reply: CommandReply = connection_handle_reset(tx, &command);
        const reset_n: usize = try connection_encode_reply_for_command(tx, &command, &reset_reply, out, out_cap, reply_off_before, reply_skip_before);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: reset_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_client {
        var client_reply: CommandReply = connection_handle_client(tx, &command, now_ms);
        const client_request_kill: bool = client_reply.request_client_kill;
        const client_kill_id: i64 = client_reply.client_kill_id;
        const client_request_pause: bool = client_reply.request_client_pause;
        const client_pause_timeout_ms: u64 = client_reply.client_pause_timeout_ms;
        const client_pause_write_only: bool = client_reply.client_pause_write_only;
        const client_pause_owner_id: i64 = client_reply.client_pause_owner_id;
        const client_request_unpause: bool = client_reply.request_client_unpause;
        const client_n: usize = try connection_encode_reply_for_command(tx, &command, &client_reply, out, out_cap, reply_off_before, reply_skip_before);
        command_reply_cleanup(&client_reply);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{
            response_len: client_n,
            consumed: parsed.consumed,
            close_after: client_request_kill && client_kill_id == connection_client_id(tx),
            request_replicaof: false,
            replicaof_promote: false,
            request_bgsave: false,
            request_aof_rewrite: false,
            request_shutdown: false,
            request_client_kill: client_request_kill,
            client_kill_id: client_kill_id,
            request_client_pause: client_request_pause,
            client_pause_timeout_ms: client_pause_timeout_ms,
            client_pause_write_only: client_pause_write_only,
            client_pause_owner_id: client_pause_owner_id,
            request_client_unpause: client_request_unpause,
        };
    }
    if command.info.cmd_type == CommandType.command_subscribe {
        var subscribe_reply: CommandReply = connection_handle_subscribe(tx, &command);
        const subscribe_n: usize = try connection_encode_reply_for_command(tx, &command, &subscribe_reply, out, out_cap, reply_off_before, reply_skip_before);
        command_reply_cleanup(&subscribe_reply);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: subscribe_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_unsubscribe {
        var unsubscribe_reply: CommandReply = connection_handle_unsubscribe(tx, &command);
        const unsubscribe_n: usize = try connection_encode_reply_for_command(tx, &command, &unsubscribe_reply, out, out_cap, reply_off_before, reply_skip_before);
        command_reply_cleanup(&unsubscribe_reply);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: unsubscribe_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_psubscribe {
        var psubscribe_reply: CommandReply = connection_handle_psubscribe(tx, &command);
        const psubscribe_n: usize = try connection_encode_reply_for_command(tx, &command, &psubscribe_reply, out, out_cap, reply_off_before, reply_skip_before);
        command_reply_cleanup(&psubscribe_reply);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: psubscribe_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_punsubscribe {
        var punsubscribe_reply: CommandReply = connection_handle_punsubscribe(tx, &command);
        const punsubscribe_n: usize = try connection_encode_reply_for_command(tx, &command, &punsubscribe_reply, out, out_cap, reply_off_before, reply_skip_before);
        command_reply_cleanup(&punsubscribe_reply);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: punsubscribe_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_ssubscribe {
        var ssubscribe_reply: CommandReply = connection_handle_ssubscribe(tx, &command);
        const ssubscribe_n: usize = try connection_encode_reply_for_command(tx, &command, &ssubscribe_reply, out, out_cap, reply_off_before, reply_skip_before);
        command_reply_cleanup(&ssubscribe_reply);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: ssubscribe_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_sunsubscribe {
        var sunsubscribe_reply: CommandReply = connection_handle_sunsubscribe(tx, &command);
        const sunsubscribe_n: usize = try connection_encode_reply_for_command(tx, &command, &sunsubscribe_reply, out, out_cap, reply_off_before, reply_skip_before);
        command_reply_cleanup(&sunsubscribe_reply);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: sunsubscribe_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_publish {
        const publish_reply: CommandReply = connection_handle_publish(&command);
        const publish_n: usize = try connection_encode_reply_for_command(tx, &command, &publish_reply, out, out_cap, reply_off_before, reply_skip_before);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: publish_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_spublish {
        const spublish_reply: CommandReply = connection_handle_spublish(&command);
        const spublish_n: usize = try connection_encode_reply_for_command(tx, &command, &spublish_reply, out, out_cap, reply_off_before, reply_skip_before);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: spublish_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_pubsub {
        var pubsub_reply: CommandReply = connection_handle_pubsub(&command);
        const pubsub_n: usize = try connection_encode_reply_for_command(tx, &command, &pubsub_reply, out, out_cap, reply_off_before, reply_skip_before);
        command_reply_cleanup(&pubsub_reply);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: pubsub_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_multi {
        connection_transaction_clear_queue(tx);
        tx.active = true;
        const multi_reply: CommandReply = connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        const multi_n: usize = try connection_encode_reply_for_command(tx, &command, &multi_reply, out, out_cap, reply_off_before, reply_skip_before);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: multi_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_watch {
        var watch_index: usize = 1;
        while watch_index < command.argc {
            const key: &[byte] = command_arg_data(&command, watch_index) catch {
                const watch_wrong_arity: CommandReply = connection_error_reply(&"ERR wrong number of arguments"[0: 29]);
                const watch_wrong_n: usize = try connection_encode_reply_for_command(tx, &command, &watch_wrong_arity, out, out_cap, reply_off_before, reply_skip_before);
                resp_value_free(&parsed.value);
                return ConnectionProcessResult{ response_len: watch_wrong_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
            };
            _ = connection_transaction_watch_key(tx, engine, key) catch {
                const watch_oom: CommandReply = connection_error_reply(&"ERR out of memory"[0: 17]);
                const watch_oom_n: usize = try connection_encode_reply_for_command(tx, &command, &watch_oom, out, out_cap, reply_off_before, reply_skip_before);
                resp_value_free(&parsed.value);
                return ConnectionProcessResult{ response_len: watch_oom_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
            };
            watch_index = watch_index + 1;
        }
        const watch_ok: CommandReply = connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        const watch_ok_n: usize = try connection_encode_reply_for_command(tx, &command, &watch_ok, out, out_cap, reply_off_before, reply_skip_before);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: watch_ok_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_unwatch {
        connection_transaction_clear_watches(tx);
        const unwatch_ok: CommandReply = connection_make_reply(CommandReplyType.reply_simple_string, &"OK"[0: 2], 0);
        const unwatch_ok_n: usize = try connection_encode_reply_for_command(tx, &command, &unwatch_ok, out, out_cap, reply_off_before, reply_skip_before);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: unwatch_ok_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_exec {
        const exec_without_multi: CommandReply = connection_error_reply(&"ERR EXEC without MULTI"[0: 22]);
        const exec_without_multi_n: usize = try connection_encode_reply_for_command(tx, &command, &exec_without_multi, out, out_cap, reply_off_before, reply_skip_before);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: exec_without_multi_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }
    if command.info.cmd_type == CommandType.command_discard {
        const discard_without_multi: CommandReply = connection_error_reply(&"ERR DISCARD without MULTI"[0: 25]);
        const discard_without_multi_n: usize = try connection_encode_reply_for_command(tx, &command, &discard_without_multi, out, out_cap, reply_off_before, reply_skip_before);
        resp_value_free(&parsed.value);
        return ConnectionProcessResult{ response_len: discard_without_multi_n, consumed: parsed.consumed, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false, request_shutdown: false };
    }

    return connection_execute_standard_command_at(
        engine,
        runtime,
        router,
        aof,
        rewrite_buf,
        backlog,
        tx,
        &parsed,
        &command,
        input,
        out,
        out_cap,
        now_ms,
        replicaof_requested,
        replicaof_promote,
        replicaof_host,
        replicaof_port,
        bgsave_requested,
        rewrite_requested,
        rewrite_failed,
        zero_copy_bulk,
    );
}

export fn connection_empty_reply() CommandReply {
    return connection_make_reply(CommandReplyType.reply_bulk_string, connection_reply_empty_slice(), 0);
}

export fn connection_shift_buffer(base: &byte, filled: &usize, consumed: usize) void {
    if consumed >= *filled {
        *filled = 0;
        return;
    }

    const remaining: usize = *filled - consumed;
    var i: usize = 0;
    while i < remaining {
        base[i] = base[consumed + i];
        i = i + 1;
    }
    *filled = remaining;
}

fn connection_send_all(fd: i32, base: &byte, total: usize) !void {
    var written: usize = 0;
    while written < total {
        const ptr: *const byte = @ptr_from_usize(@usize_from_ptr(base as &void) + written) as *const byte;
        const n: isize = sys_send(fd, ptr, total - written, 0) catch {
            return error.ConnectionIoFailed;
        };
        if n <= 0 {
            return error.ConnectionIoFailed;
        }
        written = written + (n as usize);
    }
}

fn connection_send_progress_nonblocking(fd: i32, base: &byte, total: usize, start: usize) !ConnectionSendProgress {
    var written: usize = start;
    while written < total {
        const ptr: *const byte = @ptr_from_usize(@usize_from_ptr(base as &void) + written) as *const byte;
        const n_result: !isize = sys_send(fd, ptr, total - written, 0);
        const n: isize = n_result catch |err| {
            const eid: i32 = @error_id(err) as i32;
            if eid == EAGAIN || eid == EWOULDBLOCK {
                return ConnectionSendProgress{ next_offset: written, blocked: true };
            }
            if eid == EINTR {
                continue;
            }
            return error.ConnectionIoFailed;
        };
        if n <= 0 {
            return error.ConnectionIoFailed;
        }
        written = written + (n as usize);
    }
    return ConnectionSendProgress{ next_offset: written, blocked: false };
}

fn connection_send_zero_copy_bulk_all(fd: i32, head: &byte, head_len: usize, body: &[byte], tail_len: usize) !void {
    var head_sent: usize = 0;
    var body_sent: usize = 0;
    var tail_sent: usize = 0;
    const tail: &[byte] = &"\r\n"[0: 2];
    while head_sent < head_len || body_sent < body.len || tail_sent < tail_len {
        var iov: [IOVec: 3] = [];
        var iovcnt: i32 = 0;
        if head_sent < head_len {
            iov[iovcnt as usize] = IOVec{
                iov_base: @ptr_from_usize(@usize_from_ptr(head as &void) + head_sent) as *const byte,
                iov_len: head_len - head_sent,
            };
            iovcnt = iovcnt + 1;
        }
        if body_sent < body.len {
            iov[iovcnt as usize] = IOVec{
                iov_base: @ptr_from_usize(@usize_from_ptr(body.ptr as &void) + body_sent) as *const byte,
                iov_len: body.len - body_sent,
            };
            iovcnt = iovcnt + 1;
        }
        if tail_sent < tail_len {
            iov[iovcnt as usize] = IOVec{
                iov_base: @ptr_from_usize(@usize_from_ptr(tail.ptr as &void) + tail_sent) as *const byte,
                iov_len: tail_len - tail_sent,
            };
            iovcnt = iovcnt + 1;
        }

        const wr: isize = sys_writev(fd, &iov[0], iovcnt) catch {
            return error.ConnectionIoFailed;
        };
        if wr <= 0 {
            return error.ConnectionIoFailed;
        }

        var advanced: usize = wr as usize;
        if head_sent < head_len {
            const head_remaining: usize = head_len - head_sent;
            if advanced >= head_remaining {
                head_sent = head_len;
                advanced = advanced - head_remaining;
            } else {
                head_sent = head_sent + advanced;
                advanced = 0;
            }
        }
        if advanced > 0 && body_sent < body.len {
            const body_remaining: usize = body.len - body_sent;
            if advanced >= body_remaining {
                body_sent = body.len;
                advanced = advanced - body_remaining;
            } else {
                body_sent = body_sent + advanced;
                advanced = 0;
            }
        }
        if advanced > 0 && tail_sent < tail_len {
            tail_sent = tail_sent + advanced;
        }
    }
}

fn connection_send_zero_copy_bulk_nonblocking(fd: i32, head: &byte, head_len: usize, body: &[byte], tail_len: usize) !ConnectionSendProgress {
    const total: usize = head_len + body.len + tail_len;
    const tail: &[byte] = &"\r\n"[0: 2];
    while true {
        var iov: [IOVec: 3] = [];
        var iovcnt: i32 = 0;
        if head_len > 0 {
            iov[iovcnt as usize] = IOVec{ iov_base: head as *const byte, iov_len: head_len };
            iovcnt = iovcnt + 1;
        }
        if body.len > 0 {
            iov[iovcnt as usize] = IOVec{ iov_base: body.ptr as *const byte, iov_len: body.len };
            iovcnt = iovcnt + 1;
        }
        if tail_len > 0 {
            iov[iovcnt as usize] = IOVec{ iov_base: tail.ptr as *const byte, iov_len: tail_len };
            iovcnt = iovcnt + 1;
        }
        const n_result: !isize = sys_writev(fd, &iov[0], iovcnt);
        const n: isize = n_result catch |err| {
            const eid: i32 = @error_id(err) as i32;
            if eid == EAGAIN || eid == EWOULDBLOCK {
                return ConnectionSendProgress{ next_offset: 0, blocked: true };
            }
            if eid == EINTR {
                continue;
            }
            return error.ConnectionIoFailed;
        };
        if n <= 0 {
            return error.ConnectionIoFailed;
        }
        const sent: usize = n as usize;
        if sent >= total {
            return ConnectionSendProgress{ next_offset: total, blocked: false };
        }
        return ConnectionSendProgress{ next_offset: sent, blocked: true };
    }
}

fn connection_store_pending_output(
    pending: &byte,
    pending_cap: usize,
    pending_len: &usize,
    pending_sent: &usize,
    data: &byte,
    total: usize,
    sent: usize,
) !void {
    if sent >= total {
        *pending_len = 0;
        *pending_sent = 0;
        return;
    }

    const remaining: usize = total - sent;
    if remaining > pending_cap {
        return error.ConnectionOutputTooSmall;
    }

    var i: usize = 0;
    while i < remaining {
        pending[i] = data[sent + i];
        i = i + 1;
    }
    *pending_len = remaining;
    *pending_sent = 0;
}

fn connection_store_zero_copy_pending(
    pending: &byte,
    pending_cap: usize,
    pending_len: &usize,
    pending_sent: &usize,
    head: &byte,
    head_len: usize,
    body: &[byte],
    tail_len: usize,
    sent: usize,
) !void {
    const total: usize = head_len + body.len + tail_len;
    if sent >= total {
        *pending_len = 0;
        *pending_sent = 0;
        return;
    }

    const remaining: usize = total - sent;
    if remaining > pending_cap {
        return error.ConnectionOutputTooSmall;
    }

    var copied: usize = 0;
    var offset: usize = sent;
    if offset < head_len {
        var h: usize = offset;
        while h < head_len {
            pending[copied] = head[h];
            copied = copied + 1;
            h = h + 1;
        }
        offset = head_len;
    }
    offset = offset - head_len;
    if offset < body.len {
        var b: usize = offset;
        while b < body.len {
            pending[copied] = body.ptr[b];
            copied = copied + 1;
            b = b + 1;
        }
        offset = body.len;
    }
    offset = offset - body.len;
    if offset < tail_len {
        const tail: &[byte] = &"\r\n"[0: 2];
        var t: usize = offset;
        while t < tail_len {
            pending[copied] = tail.ptr[t];
            copied = copied + 1;
            t = t + 1;
        }
    }
    *pending_len = copied;
    *pending_sent = 0;
}

fn connection_flush_pending_output(
    fd: i32,
    pending: &byte,
    pending_len: &usize,
    pending_sent: &usize,
) !bool {
    if *pending_sent >= *pending_len {
        *pending_len = 0;
        *pending_sent = 0;
        return true;
    }

    const progress: ConnectionSendProgress = try connection_send_progress_nonblocking(fd, pending, *pending_len, *pending_sent);
    *pending_sent = progress.next_offset;
    if progress.blocked {
        return false;
    }
    *pending_len = 0;
    *pending_sent = 0;
    return true;
}

fn connection_send_all_nonblocking(fd: i32, base: &byte, total: usize) !void {
    const progress: ConnectionSendProgress = try connection_send_progress_nonblocking(fd, base, total, 0);
    if progress.blocked {
        return error.ConnectionWouldBlock;
    }
}

fn connection_recv_available(fd: i32, base: &byte, cap: usize, filled: &usize) !bool {
    while true {
        if *filled >= cap {
            return error.ConnectionInputTooLarge;
        }

        const dst: *byte = @ptr_from_usize(@usize_from_ptr(base as &void) + *filled) as *byte;
        const n_result: !isize = sys_recv(fd, dst, cap - *filled, 0);
        const n: isize = n_result catch |err| {
            const eid: i32 = @error_id(err) as i32;
            if eid == EAGAIN || eid == EWOULDBLOCK {
                return true;
            }
            if eid == EINTR {
                continue;
            }
            return error.ConnectionIoFailed;
        };
        if n == 0 {
            return false;
        }
        if n < 0 {
            return error.ConnectionIoFailed;
        }
        *filled = *filled + (n as usize);
    }
}

export fn connection_handle_fd_nonblocking_with_aof(
    engine: &Engine,
    router: &CommandRouter,
    aof: &AofWriter,
    backlog: &ReplicationBacklog,
    tx: &ConnectionTransaction,
    fd: i32,
    input: &byte,
    input_cap: usize,
    filled: &usize,
    pending: &byte,
    pending_cap: usize,
    pending_len: &usize,
    pending_sent: &usize,
    close_after_write: &bool,
    replicaof_requested: &bool,
    replicaof_promote: &bool,
    replicaof_host: &[byte],
    replicaof_port: &i32,
    bgsave_requested: &bool,
    rewrite_requested: &bool,
    output: &byte,
    output_cap: usize,
) !bool {
    var runtime: CommandRuntimeInfo = command_runtime_default();
    return connection_handle_fd_nonblocking_with_runtime_with_aof(engine, &runtime, router, aof, null as &Sds, backlog, tx, fd, input, input_cap, filled, pending, pending_cap, pending_len, pending_sent, close_after_write, replicaof_requested, replicaof_promote, replicaof_host, replicaof_port, bgsave_requested, rewrite_requested, null as &bool, output, output_cap);
}

export fn connection_handle_fd_nonblocking_with_runtime_with_aof(
    engine: &Engine,
    runtime: &CommandRuntimeInfo,
    router: &CommandRouter,
    aof: &AofWriter,
    rewrite_buf: &Sds,
    backlog: &ReplicationBacklog,
    tx: &ConnectionTransaction,
    fd: i32,
    input: &byte,
    input_cap: usize,
    filled: &usize,
    pending: &byte,
    pending_cap: usize,
    pending_len: &usize,
    pending_sent: &usize,
    close_after_write: &bool,
    replicaof_requested: &bool,
    replicaof_promote: &bool,
    replicaof_host: &[byte],
    replicaof_port: &i32,
    bgsave_requested: &bool,
    rewrite_requested: &bool,
    rewrite_failed: &bool,
    output: &byte,
    output_cap: usize,
) !bool {
    tx.client_fd = fd;
    const pending_flushed: bool = try connection_flush_pending_output(fd, pending, pending_len, pending_sent);
    if !pending_flushed {
        return true;
    }
    if *close_after_write {
        *close_after_write = false;
        return false;
    }

    const open: bool = try connection_recv_available(fd, input, input_cap, filled);
    if !open {
        return false;
    }

    var close_after: bool = false;
    var can_continue: bool = true;
    while can_continue && *filled > 0 && *pending_len == 0 {
        var incomplete: bool = false;
        const result_value: !ConnectionProcessResult = connection_process_input_with_runtime_with_aof_and_rewrite_and_transaction_internal_at(
            engine,
            runtime,
            router,
            aof,
            rewrite_buf,
            backlog,
            tx,
            input[0: *filled],
            output,
            output_cap,
            now_ms_safe(),
            replicaof_requested,
            replicaof_promote,
            replicaof_host,
            replicaof_port,
            bgsave_requested,
            rewrite_requested,
            rewrite_failed,
            true,
        );
        const result: ConnectionProcessResult = result_value catch |err| {
            if err == error.ConnectionIncomplete {
                incomplete = true;
                can_continue = false;
            } else {
                return err;
            }
                ConnectionProcessResult{ response_len: 0, consumed: 0, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false };
        };

        if !incomplete {
            if result.request_replicaof {
                *replicaof_requested = true;
                *replicaof_promote = result.replicaof_promote;
            }
            if result.request_bgsave {
                *bgsave_requested = true;
            }
            if result.request_aof_rewrite {
                *rewrite_requested = true;
            }
            var progress: ConnectionSendProgress = ConnectionSendProgress{ next_offset: 0, blocked: false };
            if result.zero_copy_body.len > 0 {
                progress = try connection_send_zero_copy_bulk_nonblocking(fd, output, result.response_head_len, result.zero_copy_body, result.zero_copy_tail_len);
            } else {
                progress = try connection_send_progress_nonblocking(fd, output, result.response_len, 0);
            }
            connection_shift_buffer(input, filled, result.consumed);
            if progress.blocked {
                if result.zero_copy_body.len > 0 {
                    try connection_store_zero_copy_pending(pending, pending_cap, pending_len, pending_sent, output, result.response_head_len, result.zero_copy_body, result.zero_copy_tail_len, progress.next_offset);
                } else {
                    try connection_store_pending_output(pending, pending_cap, pending_len, pending_sent, output, result.response_len, progress.next_offset);
                }
                *close_after_write = result.close_after;
                can_continue = false;
            } else {
                close_after = result.close_after;
                if close_after {
                    can_continue = false;
                }
            }
        }
    }

    return !close_after;
}

export fn connection_handle_fd_nonblocking(
    engine: &Engine,
    router: &CommandRouter,
    fd: i32,
    input: &byte,
    input_cap: usize,
    filled: &usize,
    pending: &byte,
    pending_cap: usize,
    pending_len: &usize,
    pending_sent: &usize,
    close_after_write: &bool,
    output: &byte,
    output_cap: usize,
) !bool {
    var replicaof_requested: bool = false;
    var replicaof_promote: bool = false;
    var replicaof_host: [byte: 64] = [];
    var replicaof_port: i32 = 0;
    var bgsave_requested: bool = false;
    var rewrite_requested: bool = false;
    var tx: ConnectionTransaction = connection_transaction_new();
    defer {
        connection_transaction_reset(&tx);
    }
    return connection_handle_fd_nonblocking_with_aof(engine, router, null as &AofWriter, null as &ReplicationBacklog, &tx, fd, input, input_cap, filled, pending, pending_cap, pending_len, pending_sent, close_after_write, &replicaof_requested, &replicaof_promote, replicaof_host[0: 64], &replicaof_port, &bgsave_requested, &rewrite_requested, output, output_cap);
}

export fn connection_handle_fd(engine: &Engine, router: &CommandRouter, fd: i32) !void {
    try connection_handle_fd_with_aof(engine, router, null as &AofWriter, fd);
}

export fn connection_handle_fd_with_aof(engine: &Engine, router: &CommandRouter, aof: &AofWriter, fd: i32) !void {
    var input: [byte: CONNECTION_BLOCKING_INPUT_CAP] = [];
    var output: [byte: CONNECTION_BLOCKING_OUTPUT_CAP] = [];
    var filled: usize = 0;
    var close_after: bool = false;
    var tx: ConnectionTransaction = connection_transaction_new();
    tx.client_fd = fd;
    defer {
        connection_transaction_reset(&tx);
    }

    while !close_after {
        if filled >= CONNECTION_BLOCKING_INPUT_CAP {
            return error.ConnectionInputTooLarge;
        }

        const n: isize = sys_recv(fd, &input[filled] as *byte, CONNECTION_BLOCKING_INPUT_CAP - filled, 0) catch {
            return error.ConnectionIoFailed;
        };
        if n <= 0 {
            return;
        }
        filled = filled + (n as usize);

        var can_continue: bool = true;
        while can_continue && filled > 0 {
            var incomplete: bool = false;
            var runtime: CommandRuntimeInfo = command_runtime_default();
            var replicaof_requested: bool = false;
            var replicaof_promote: bool = false;
            var replicaof_host: [byte: 64] = [];
            var replicaof_port: i32 = 0;
            var bgsave_requested: bool = false;
            var rewrite_requested: bool = false;
            const result_aof_value: !ConnectionProcessResult = connection_process_input_with_runtime_with_aof_and_rewrite_and_transaction_internal_at(
                engine,
                &runtime,
                router,
                aof,
                null as &Sds,
                null as &ReplicationBacklog,
                &tx,
                input[0: filled],
                &output[0],
                CONNECTION_BLOCKING_OUTPUT_CAP,
                now_ms_safe(),
                &replicaof_requested,
                &replicaof_promote,
                replicaof_host[0: 64],
                &replicaof_port,
                &bgsave_requested,
                &rewrite_requested,
                null as &bool,
                true,
            );
            const result: ConnectionProcessResult = result_aof_value catch |err| {
                if err == error.ConnectionIncomplete {
                    incomplete = true;
                    can_continue = false;
                } else {
                    return error.ConnectionIoFailed;
                }
                ConnectionProcessResult{ response_len: 0, consumed: 0, close_after: false, request_replicaof: false, replicaof_promote: false, request_bgsave: false, request_aof_rewrite: false };
            };

            if !incomplete {
                if result.zero_copy_body.len > 0 {
                    try connection_send_zero_copy_bulk_all(fd, &output[0], result.response_head_len, result.zero_copy_body, result.zero_copy_tail_len);
                } else {
                    try connection_send_all(fd, &output[0], result.response_len);
                }
                connection_shift_buffer(&input[0], &filled, result.consumed);
                close_after = result.close_after;
                if close_after {
                    can_continue = false;
                }
            }
        }
    }
}
