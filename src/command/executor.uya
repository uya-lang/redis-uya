export enum CommandReplyType {
    reply_simple_string,
    reply_error,
    reply_integer,
    reply_bulk_string,
    reply_null_bulk,
    reply_array_bulk,
    reply_array_nullable_bulk,
    reply_scan,
    reply_raw_bytes,
}

export struct CommandReply {
    typ: CommandReplyType,
    data: &[byte],
    integer: i64,
    scan_cursor: u64,
    array_head: &ListNode,
    array_count: usize,
    owned_object: &RedisObject,
    owned_aux_object: &RedisObject,
    request_replicaof: bool,
    replicaof_promote: bool,
    replicaof_host: [byte: 64],
    replicaof_port: i32,
    request_bgsave: bool,
    request_aof_rewrite: bool,
    request_config_set: bool,
    config_after: ServerConfig,
    request_client_kill: bool,
    client_kill_id: i64,
    request_client_pause: bool,
    client_pause_timeout_ms: u64,
    client_pause_write_only: bool,
    client_pause_owner_id: i64,
    request_client_unpause: bool,
    request_maxclients_set: bool,
    maxclients_after: i32,
}

export struct CommandRuntimeInfo {
    config: ServerConfig,
    active_clients: i32,
    maxclients: i32,
    served_clients: i32,
    cron_ticks: u64,
    start_ms: u64,
    replication_role: ReplicationRole,
    replication_state: ReplicationState,
    replication_replid: [byte: 41],
    replication_master_offset: u64,
    replication_backlog_first_offset: u64,
    replication_backlog_histlen: usize,
    replication_backlog_active: bool,
