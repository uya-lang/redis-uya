    _ = list_object_push_tail(reply_list, &"write"[0: 5]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"set"[0: 3]) catch { object_free(reply_list); return command_executor_oom(); };
    _ = list_object_push_tail(reply_list, &"sortedset"[0: 9]) catch { object_free(reply_list); return command_executor_oom(); };
