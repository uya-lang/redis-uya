    engine_free(&engine);
    _ = unlink(path);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_aof_replay_restore_command() !void {
    reset_memory_stats_for_test();
    var source_engine: Engine = engine_new();
    const source_obj: &RedisObject = try create_string_object(&"value"[0: 5]);
    try set_key_at(&source_engine, &"src"[0: 3], source_obj, 1000u64);
    const dump_obj: &RedisObject = try rdb_dump_object_at(&source_engine, 1000u64);
    engine_free(&source_engine);

    const path: &const byte = "build/test-aof-restore.aof";
    _ = unlink(path);
    var writer: AofWriter = try aof_open_truncate(path);
    var raw: [byte: 4096] = [];
    var raw_len: usize = 0;
    raw_len = aof_test_copy(&raw[0], raw_len, &"*4\r\n$7\r\nRESTORE\r\n$6\r\nkeyout\r\n$1\r\n0\r\n$"[0: 37]);
    raw_len = try aof_test_append_decimal(&raw[0], raw_len, dump_obj.value.len);
    raw_len = aof_test_copy(&raw[0], raw_len, &"\r\n"[0: 2]);
    raw_len = aof_test_copy(&raw[0], raw_len, dump_obj.value.buf[0: dump_obj.value.len]);
    raw_len = aof_test_copy(&raw[0], raw_len, &"\r\n"[0: 2]);
    try aof_append_raw(&writer, raw[0: raw_len]);
    aof_close(&writer);
    object_free(dump_obj);

    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    try aof_replay_file_at(path, &engine, &router, 1000u64);
    const found: &RedisObject = try lookup_key_at(&engine, &"keyout"[0: 6], 1000u64);
    try assert_true(aof_test_slice_eq(found.value.buf[0: found.value.len], &"value"[0: 5]));
    engine_free(&engine);
    _ = unlink(path);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_aof_replay_sort_store_command() !void {
    reset_memory_stats_for_test();
    const path: &const byte = "build/test-aof-sort-store.aof";
    _ = unlink(path);

    var writer: AofWriter = try aof_open_truncate(path);
    try aof_append_raw(&writer, &"*5\r\n$5\r\nRPUSH\r\n$7\r\nsortsrc\r\n$1\r\n3\r\n$1\r\n1\r\n$1\r\n2\r\n"[0: 49]);
    try aof_append_raw(&writer, &"*4\r\n$4\r\nSORT\r\n$7\r\nsortsrc\r\n$5\r\nSTORE\r\n$7\r\nsortout\r\n"[0: 51]);
    aof_close(&writer);

    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    try aof_replay_file_at(path, &engine, &router, 1000u64);
    const found: &RedisObject = try lookup_key_at(&engine, &"sortout"[0: 7], 1000u64);
    try assert_eq_i32(found.obj_type as i32, ObjectType.object_list as i32);
    const first: &RedisObject = try list_object_index_value(found, 0);
    const second: &RedisObject = try list_object_index_value(found, 1);
    const third: &RedisObject = try list_object_index_value(found, 2);
    try assert_true(aof_test_slice_eq(first.value.buf[0: first.value.len], &"1"[0: 1]));
    try assert_true(aof_test_slice_eq(second.value.buf[0: second.value.len], &"2"[0: 1]));
    try assert_true(aof_test_slice_eq(third.value.buf[0: third.value.len], &"3"[0: 1]));
    engine_free(&engine);
    _ = unlink(path);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_aof_replay_smove_command() !void {
    reset_memory_stats_for_test();
    const path: &const byte = "build/test-aof-smove.aof";
    _ = unlink(path);

    var writer: AofWriter = try aof_open_truncate(path);
    try aof_append_raw(&writer, &"*3\r\n$4\r\nSADD\r\n$3\r\nsrc\r\n$1\r\na\r\n"[0: 30]);
    try aof_append_raw(&writer, &"*4\r\n$5\r\nSMOVE\r\n$3\r\nsrc\r\n$3\r\ndst\r\n$1\r\na\r\n"[0: 40]);
