    command_reply_cleanup(&getkeys_evalsha_ro_flags_reply);
    resp_value_free(&getkeys_evalsha_ro_flags_parsed.value);

    var getkeys_fcall_parsed: RespParseResult = try parse_resp2(&"*8\r\n$7\r\nCOMMAND\r\n$7\r\nGETKEYS\r\n$5\r\nFCALL\r\n$7\r\nmissing\r\n$1\r\n2\r\n$2\r\nk1\r\n$2\r\nk2\r\n$3\r\narg\r\n"[0: 86]);
    const getkeys_fcall_command: Command = try command_executor_test_command(&router, &getkeys_fcall_parsed);
