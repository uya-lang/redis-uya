    try assert_true(command_executor_test_slice_eq(zrange_limit_no_byscore_reply.data, &"ERR syntax error"[0: 16]));
    resp_value_free(&zrange_limit_no_byscore_parsed.value);

    var zrange_dup_rev_parsed: RespParseResult = try parse_resp2(&"*6\r\n$6\r\nZRANGE\r\n$4\r\nzset\r\n$1\r\n0\r\n$1\r\n1\r\n$3\r\nREV\r\n$3\r\nREV\r\n"[0: 58]);
    const zrange_dup_rev_command: Command = try command_executor_test_command(&router, &zrange_dup_rev_parsed);
    const zrange_dup_rev_reply: CommandReply = command_execute_at(&engine, &zrange_dup_rev_command, 1000u64);
    try assert_eq_i32(zrange_dup_rev_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(zrange_dup_rev_reply.data, &"ERR syntax error"[0: 16]));
    resp_value_free(&zrange_dup_rev_parsed.value);

    var zrevrange_parsed: RespParseResult = try parse_resp2(&"*4\r\n$9\r\nZREVRANGE\r\n$4\r\nzset\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 44]);
    const zrevrange_command: Command = try command_executor_test_command(&router, &zrevrange_parsed);
    var zrevrange_reply: CommandReply = command_execute_at(&engine, &zrevrange_command, 1000u64);
