    const hmset_reply: CommandReply = command_execute_at(&engine, &hmset_command, 1000u64);
    try assert_eq_i32(hmset_reply.typ as i32, CommandReplyType.reply_simple_string as i32);
    try assert_true(command_executor_test_slice_eq(hmset_reply.data, &"OK"[0: 2]));
    resp_value_free(&hmset_parsed.value);

    var hmset_hmget_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nHMGET\r\n$4\r\nhash\r\n$5\r\nmulti\r\n$6\r\nsecond\r\n"[0: 48]);
    const hmset_hmget_command: Command = try command_executor_test_command(&router, &hmset_hmget_parsed);
    var hmset_hmget_reply: CommandReply = command_execute_at(&engine, &hmset_hmget_command, 1000u64);
