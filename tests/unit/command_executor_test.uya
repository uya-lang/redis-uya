    try assert_eq_i32(nx_del_reply.integer as i32, 1);
    resp_value_free(&nx_del_parsed.value);

    var gs_del_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nDEL\r\n$6\r\ngs-key\r\n"[0: 25]);
    const gs_del_command: Command = try command_executor_test_command(&router, &gs_del_parsed);
    const gs_del_reply: CommandReply = command_execute_at(&engine, &gs_del_command, 1000u64);
    try assert_eq_i32(gs_del_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(gs_del_reply.integer as i32, 1);
    resp_value_free(&gs_del_parsed.value);

    var fcounter_del_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nDEL\r\n$8\r\nfcounter\r\n"[0: 27]);
    const fcounter_del_command: Command = try command_executor_test_command(&router, &fcounter_del_parsed);
    const fcounter_del_reply: CommandReply = command_execute_at(&engine, &fcounter_del_command, 1000u64);
