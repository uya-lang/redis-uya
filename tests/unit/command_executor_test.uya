    try assert_true(command_executor_test_contains(zrangebylex_bad_offset_reply.data, &"offset out of range"[0: 19]));
    resp_value_free(&zrangebylex_bad_offset_parsed.value);

    var zrevrangebylex_closed_parsed: RespParseResult = try parse_resp2(&"*4\r\n$14\r\nZREVRANGEBYLEX\r\n$3\r\nlex\r\n$6\r\n[delta\r\n$6\r\n(alpha\r\n"[0: 58]);
