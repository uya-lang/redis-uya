    resp_value_free(&version_parsed.value);

    var unknown_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nLOLWUT\r\n$3\r\nbad\r\n$1\r\n5\r\n"[0: 32]);
    const unknown_command: Command = try command_executor_test_command(&router, &unknown_parsed);
    var unknown_reply: CommandReply = command_execute_with_runtime_at(&engine, &runtime, &unknown_command, 1000u64);
