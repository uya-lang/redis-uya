    try assert_eq_i32(sinterstore_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(sinterstore_reply.integer as i32, 1);
    resp_value_free(&sinterstore_parsed.value);

    var smembers_si_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nSMEMBERS\r\n$2\r\nsi\r\n"[0: 26]);
    const smembers_si_command: Command = try command_executor_test_command(&router, &smembers_si_parsed);
    const smembers_si_reply: CommandReply = command_execute_at(&engine, &smembers_si_command, 1000u64);
    const smembers_si_len: usize = try connection_encode_reply(&smembers_si_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: smembers_si_len], &"*1\r\n$1\r\nc\r\n"[0: 11]));
    command_reply_cleanup(&smembers_si_reply);
    resp_value_free(&smembers_si_parsed.value);

    var sdiffstore_parsed: RespParseResult = try parse_resp2(&"*4\r\n$10\r\nSDIFFSTORE\r\n$2\r\nsd\r\n$2\r\ns1\r\n$2\r\ns2\r\n"[0: 45]);
    const sdiffstore_command: Command = try command_executor_test_command(&router, &sdiffstore_parsed);
    const sdiffstore_reply: CommandReply = command_execute_at(&engine, &sdiffstore_command, 1000u64);
    try assert_eq_i32(sdiffstore_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(sdiffstore_reply.integer as i32, 2);
    resp_value_free(&sdiffstore_parsed.value);

    var smembers_sd_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nSMEMBERS\r\n$2\r\nsd\r\n"[0: 26]);
    const smembers_sd_command: Command = try command_executor_test_command(&router, &smembers_sd_parsed);
    const smembers_sd_reply: CommandReply = command_execute_at(&engine, &smembers_sd_command, 1000u64);
    const smembers_sd_len: usize = try connection_encode_reply(&smembers_sd_reply, &out[0], 256);
    try assert_true(command_executor_test_contains(out[0: smembers_sd_len], &"*2\r\n"[0: 4]));
    try assert_true(command_executor_test_contains(out[0: smembers_sd_len], &"$1\r\na\r\n"[0: 7]));
    try assert_true(command_executor_test_contains(out[0: smembers_sd_len], &"$1\r\nd\r\n"[0: 7]));
    command_reply_cleanup(&smembers_sd_reply);
    resp_value_free(&smembers_sd_parsed.value);

    var sunionstore_parsed: RespParseResult = try parse_resp2(&"*5\r\n$11\r\nSUNIONSTORE\r\n$2\r\nsu\r\n$2\r\ns1\r\n$2\r\ns2\r\n$2\r\ns3\r\n"[0: 54]);
    const sunionstore_command: Command = try command_executor_test_command(&router, &sunionstore_parsed);
    const sunionstore_reply: CommandReply = command_execute_at(&engine, &sunionstore_command, 1000u64);
    try assert_eq_i32(sunionstore_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(sunionstore_reply.integer as i32, 4);
    resp_value_free(&sunionstore_parsed.value);

    var smembers_su_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nSMEMBERS\r\n$2\r\nsu\r\n"[0: 26]);
    const smembers_su_command: Command = try command_executor_test_command(&router, &smembers_su_parsed);
    const smembers_su_reply: CommandReply = command_execute_at(&engine, &smembers_su_command, 1000u64);
    const smembers_su_len: usize = try connection_encode_reply(&smembers_su_reply, &out[0], 256);
    try assert_true(command_executor_test_contains(out[0: smembers_su_len], &"*4\r\n"[0: 4]));
    try assert_true(command_executor_test_contains(out[0: smembers_su_len], &"$1\r\na\r\n"[0: 7]));
    try assert_true(command_executor_test_contains(out[0: smembers_su_len], &"$1\r\nb\r\n"[0: 7]));
    try assert_true(command_executor_test_contains(out[0: smembers_su_len], &"$1\r\nc\r\n"[0: 7]));
    try assert_true(command_executor_test_contains(out[0: smembers_su_len], &"$1\r\nd\r\n"[0: 7]));
    command_reply_cleanup(&smembers_su_reply);
    resp_value_free(&smembers_su_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_scard_sismember_smismember_sscan() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var sadd_parsed: RespParseResult = try parse_resp2(&"*6\r\n$4\r\nSADD\r\n$3\r\nset\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n$1\r\nd\r\n"[0: 51]);
    const sadd_command: Command = try command_executor_test_command(&router, &sadd_parsed);
    _ = command_execute_at(&engine, &sadd_command, 1000u64);
    resp_value_free(&sadd_parsed.value);

    var scard_parsed: RespParseResult = try parse_resp2(&"*2\r\n$5\r\nSCARD\r\n$3\r\nset\r\n"[0: 24]);
    const scard_command: Command = try command_executor_test_command(&router, &scard_parsed);
    const scard_reply: CommandReply = command_execute_at(&engine, &scard_command, 1000u64);
    try assert_eq_i32(scard_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(scard_reply.integer as i32, 4);
    resp_value_free(&scard_parsed.value);

    var sismember_yes_parsed: RespParseResult = try parse_resp2(&"*3\r\n$9\r\nSISMEMBER\r\n$3\r\nset\r\n$1\r\na\r\n"[0: 35]);
    const sismember_yes_command: Command = try command_executor_test_command(&router, &sismember_yes_parsed);
    const sismember_yes_reply: CommandReply = command_execute_at(&engine, &sismember_yes_command, 1000u64);
    try assert_eq_i32(sismember_yes_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(sismember_yes_reply.integer as i32, 1);
    resp_value_free(&sismember_yes_parsed.value);

    var sismember_no_parsed: RespParseResult = try parse_resp2(&"*3\r\n$9\r\nSISMEMBER\r\n$3\r\nset\r\n$1\r\nz\r\n"[0: 35]);
    const sismember_no_command: Command = try command_executor_test_command(&router, &sismember_no_parsed);
    const sismember_no_reply: CommandReply = command_execute_at(&engine, &sismember_no_command, 1000u64);
    try assert_eq_i32(sismember_no_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(sismember_no_reply.integer as i32, 0);
    resp_value_free(&sismember_no_parsed.value);

    var smismember_parsed: RespParseResult = try parse_resp2(&"*5\r\n$10\r\nSMISMEMBER\r\n$3\r\nset\r\n$1\r\na\r\n$1\r\nz\r\n$1\r\nd\r\n"[0: 51]);
    const smismember_command: Command = try command_executor_test_command(&router, &smismember_parsed);
    var smismember_reply: CommandReply = command_execute_at(&engine, &smismember_command, 1000u64);
    const smismember_len: usize = try connection_encode_reply(&smismember_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: smismember_len], &"*3\r\n:1\r\n:0\r\n:1\r\n"[0: 16]));
    command_reply_cleanup(&smismember_reply);
    resp_value_free(&smismember_parsed.value);

    var sscan_parsed: RespParseResult = try parse_resp2(&"*3\r\n$5\r\nSSCAN\r\n$3\r\nset\r\n$1\r\n0\r\n"[0: 31]);
    const sscan_command: Command = try command_executor_test_command(&router, &sscan_parsed);
    var sscan_reply: CommandReply = command_execute_at(&engine, &sscan_command, 1000u64);
    try assert_eq_i32(sscan_reply.typ as i32, CommandReplyType.reply_scan as i32);
    try assert_eq_i32(sscan_reply.scan_cursor as i32, 0);
    try assert_eq_i32(sscan_reply.array_count as i32, 4);
    command_reply_cleanup(&sscan_reply);
    resp_value_free(&sscan_parsed.value);

    var sscan_partial_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nSSCAN\r\n$3\r\nset\r\n$1\r\n0\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n"[0: 49]);
    const sscan_partial_command: Command = try command_executor_test_command(&router, &sscan_partial_parsed);
    var sscan_partial_reply: CommandReply = command_execute_at(&engine, &sscan_partial_command, 1000u64);
    try assert_eq_i32(sscan_partial_reply.typ as i32, CommandReplyType.reply_scan as i32);
    try assert_eq_i32(sscan_partial_reply.scan_cursor as i32, 2);
    try assert_eq_i32(sscan_partial_reply.array_count as i32, 2);
    command_reply_cleanup(&sscan_partial_reply);
    resp_value_free(&sscan_partial_parsed.value);

    var missing_scard_parsed: RespParseResult = try parse_resp2(&"*2\r\n$5\r\nSCARD\r\n$7\r\nmissing\r\n"[0: 28]);
    const missing_scard_command: Command = try command_executor_test_command(&router, &missing_scard_parsed);
    const missing_scard_reply: CommandReply = command_execute_at(&engine, &missing_scard_command, 1000u64);
    try assert_eq_i32(missing_scard_reply.integer as i32, 0);
    resp_value_free(&missing_scard_parsed.value);

    var missing_sscan_parsed: RespParseResult = try parse_resp2(&"*3\r\n$5\r\nSSCAN\r\n$7\r\nmissing\r\n$1\r\n0\r\n"[0: 35]);
    const missing_sscan_command: Command = try command_executor_test_command(&router, &missing_sscan_parsed);
    var missing_sscan_reply: CommandReply = command_execute_at(&engine, &missing_sscan_command, 1000u64);
    try assert_eq_i32(missing_sscan_reply.typ as i32, CommandReplyType.reply_scan as i32);
    try assert_eq_i32(missing_sscan_reply.scan_cursor as i32, 0);
    try assert_eq_i32(missing_sscan_reply.array_count as i32, 0);
    command_reply_cleanup(&missing_sscan_reply);
    resp_value_free(&missing_sscan_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_smove() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var same_seed_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nSADD\r\n$4\r\nsame\r\n$1\r\na\r\n"[0: 31]);
    const same_seed_command: Command = try command_executor_test_command(&router, &same_seed_parsed);
    _ = command_execute_at(&engine, &same_seed_command, 1000u64);
    resp_value_free(&same_seed_parsed.value);

    var smove_same_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nSMOVE\r\n$4\r\nsame\r\n$4\r\nsame\r\n$1\r\na\r\n"[0: 42]);
    const smove_same_command: Command = try command_executor_test_command(&router, &smove_same_parsed);
    const smove_same_reply: CommandReply = command_execute_at(&engine, &smove_same_command, 1000u64);
    try assert_eq_i32(smove_same_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(smove_same_reply.integer as i32, 1);
    resp_value_free(&smove_same_parsed.value);

    var same_members_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nSMEMBERS\r\n$4\r\nsame\r\n"[0: 28]);
    const same_members_command: Command = try command_executor_test_command(&router, &same_members_parsed);
    var same_members_reply: CommandReply = command_execute_at(&engine, &same_members_command, 1000u64);
    const same_members_len: usize = try connection_encode_reply(&same_members_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: same_members_len], &"*1\r\n$1\r\na\r\n"[0: 11]));
    command_reply_cleanup(&same_members_reply);
    resp_value_free(&same_members_parsed.value);

    var smove_same_missing_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nSMOVE\r\n$4\r\nsame\r\n$4\r\nsame\r\n$1\r\nz\r\n"[0: 42]);
    const smove_same_missing_command: Command = try command_executor_test_command(&router, &smove_same_missing_parsed);
    const smove_same_missing_reply: CommandReply = command_execute_at(&engine, &smove_same_missing_command, 1000u64);
    try assert_eq_i32(smove_same_missing_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(smove_same_missing_reply.integer as i32, 0);
    resp_value_free(&smove_same_missing_parsed.value);

    var bad_dst_seed_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$7\r\nbad-dst\r\n$5\r\nvalue\r\n"[0: 37]);
    const bad_dst_seed_command: Command = try command_executor_test_command(&router, &bad_dst_seed_parsed);
    _ = command_execute_at(&engine, &bad_dst_seed_command, 1000u64);
    resp_value_free(&bad_dst_seed_parsed.value);

    var smove_missing_source_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nSMOVE\r\n$7\r\nmissing\r\n$7\r\nbad-dst\r\n$1\r\na\r\n"[0: 48]);
    const smove_missing_source_command: Command = try command_executor_test_command(&router, &smove_missing_source_parsed);
    const smove_missing_source_reply: CommandReply = command_execute_at(&engine, &smove_missing_source_command, 1000u64);
    try assert_eq_i32(smove_missing_source_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(smove_missing_source_reply.integer as i32, 0);
    resp_value_free(&smove_missing_source_parsed.value);

    var bad_source_seed_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$7\r\nbad-src\r\n$5\r\nvalue\r\n"[0: 37]);
    const bad_source_seed_command: Command = try command_executor_test_command(&router, &bad_source_seed_parsed);
    _ = command_execute_at(&engine, &bad_source_seed_command, 1000u64);
    resp_value_free(&bad_source_seed_parsed.value);

    var smove_bad_source_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nSMOVE\r\n$7\r\nbad-src\r\n$4\r\ndst0\r\n$1\r\na\r\n"[0: 45]);
    const smove_bad_source_command: Command = try command_executor_test_command(&router, &smove_bad_source_parsed);
    const smove_bad_source_reply: CommandReply = command_execute_at(&engine, &smove_bad_source_command, 1000u64);
    try assert_eq_i32(smove_bad_source_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(smove_bad_source_reply.data, &"WRONGTYPE Operation against a key holding the wrong kind of value"[0: 65]));
    resp_value_free(&smove_bad_source_parsed.value);

    var src_seed_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nSADD\r\n$3\r\nsrc\r\n$1\r\na\r\n$1\r\nb\r\n"[0: 37]);
    const src_seed_command: Command = try command_executor_test_command(&router, &src_seed_parsed);
    _ = command_execute_at(&engine, &src_seed_command, 1000u64);
    resp_value_free(&src_seed_parsed.value);

    var smove_bad_destination_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nSMOVE\r\n$3\r\nsrc\r\n$7\r\nbad-dst\r\n$1\r\nz\r\n"[0: 44]);
    const smove_bad_destination_command: Command = try command_executor_test_command(&router, &smove_bad_destination_parsed);
    const smove_bad_destination_reply: CommandReply = command_execute_at(&engine, &smove_bad_destination_command, 1000u64);
    try assert_eq_i32(smove_bad_destination_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(smove_bad_destination_reply.data, &"WRONGTYPE Operation against a key holding the wrong kind of value"[0: 65]));
    resp_value_free(&smove_bad_destination_parsed.value);

    var dst_seed_parsed: RespParseResult = try parse_resp2(&"*4\r\n$4\r\nSADD\r\n$3\r\ndst\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 37]);
    const dst_seed_command: Command = try command_executor_test_command(&router, &dst_seed_parsed);
    _ = command_execute_at(&engine, &dst_seed_command, 1000u64);
    resp_value_free(&dst_seed_parsed.value);

    var smove_existing_destination_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nSMOVE\r\n$3\r\nsrc\r\n$3\r\ndst\r\n$1\r\nb\r\n"[0: 40]);
    const smove_existing_destination_command: Command = try command_executor_test_command(&router, &smove_existing_destination_parsed);
    const smove_existing_destination_reply: CommandReply = command_execute_at(&engine, &smove_existing_destination_command, 1000u64);
    try assert_eq_i32(smove_existing_destination_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(smove_existing_destination_reply.integer as i32, 1);
    resp_value_free(&smove_existing_destination_parsed.value);

    var src_members_after_first_move_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nSMEMBERS\r\n$3\r\nsrc\r\n"[0: 27]);
    const src_members_after_first_move_command: Command = try command_executor_test_command(&router, &src_members_after_first_move_parsed);
    var src_members_after_first_move_reply: CommandReply = command_execute_at(&engine, &src_members_after_first_move_command, 1000u64);
    const src_members_after_first_move_len: usize = try connection_encode_reply(&src_members_after_first_move_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: src_members_after_first_move_len], &"*1\r\n$1\r\na\r\n"[0: 11]));
    command_reply_cleanup(&src_members_after_first_move_reply);
    resp_value_free(&src_members_after_first_move_parsed.value);

    var dst_members_after_first_move_parsed: RespParseResult = try parse_resp2(&"*2\r\n$8\r\nSMEMBERS\r\n$3\r\ndst\r\n"[0: 27]);
    const dst_members_after_first_move_command: Command = try command_executor_test_command(&router, &dst_members_after_first_move_parsed);
    var dst_members_after_first_move_reply: CommandReply = command_execute_at(&engine, &dst_members_after_first_move_command, 1000u64);
    const dst_members_after_first_move_len: usize = try connection_encode_reply(&dst_members_after_first_move_reply, &out[0], 256);
    try assert_true(
        command_executor_test_slice_eq(out[0: dst_members_after_first_move_len], &"*2\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 18]) ||
        command_executor_test_slice_eq(out[0: dst_members_after_first_move_len], &"*2\r\n$1\r\nc\r\n$1\r\nb\r\n"[0: 18])
    );
    command_reply_cleanup(&dst_members_after_first_move_reply);
    resp_value_free(&dst_members_after_first_move_parsed.value);

    var smove_new_destination_parsed: RespParseResult = try parse_resp2(&"*4\r\n$5\r\nSMOVE\r\n$3\r\nsrc\r\n$5\r\nfresh\r\n$1\r\na\r\n"[0: 42]);
    const smove_new_destination_command: Command = try command_executor_test_command(&router, &smove_new_destination_parsed);
