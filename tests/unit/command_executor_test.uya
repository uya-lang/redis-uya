    var zremrangebylex_missing_parsed: RespParseResult = try parse_resp2(&"*4\r\n$14\r\nZREMRANGEBYLEX\r\n$7\r\nmissing\r\n$1\r\n-\r\n$1\r\n+\r\n"[0: 52]);
