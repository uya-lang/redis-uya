    try command_executor_test_assert_catalog_status(&"georadiusbymember"[0: 17], CommandCatalogStatus.status_partial);
    try command_executor_test_assert_catalog_status(&"georadius_ro"[0: 12], CommandCatalogStatus.status_partial);
