    try assert_true(command_executor_test_slice_eq(type_reply.data, &"string"[0: 6]));
    resp_value_free(&type_parsed.value);

    var dbsize_parsed: RespParseResult = try parse_resp2(&"*1\r\n$6\r\nDBSIZE\r\n"[0: 16]);
    const dbsize_command: Command = try command_executor_test_command(&router, &dbsize_parsed);
