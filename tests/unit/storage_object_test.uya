fn object_slice_eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len { return false; }
    var i: usize = 0;
    while i < a.len {
        if a.ptr[i] != b.ptr[i] { return false; }
        i = i + 1;
    }
    return true;
}

export fn test_object_string_create_free() !void {
    reset_memory_stats_for_test();
    const obj: &RedisObject = try create_string_object(&"hello"[0: 5]);
    try assert_eq_i32(obj.obj_type as i32, ObjectType.object_string as i32);
    try assert_eq_i32(obj.encoding as i32, Encoding.encoding_raw as i32);
    try assert_true(object_slice_eq(obj.value.buf[0: obj.value.len], &"hello"[0: 5]));
    try assert_true(object_slice_eq(object_type_name(obj.obj_type), &"string"[0: 6]));
    try assert_true(object_slice_eq(object_encoding_name(obj.encoding), &"raw"[0: 3]));
    object_free(obj);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_object_string_integer_encoding() !void {
    reset_memory_stats_for_test();
    const positive: &RedisObject = try create_string_object(&"12345"[0: 5]);
    const negative: &RedisObject = try create_string_object(&"-42"[0: 3]);
    try assert_eq_i32(positive.encoding as i32, Encoding.encoding_int as i32);
    try assert_eq_i32(positive.int_value as i32, 12345);
    try assert_true(object_slice_eq(object_encoding_name(positive.encoding), &"int"[0: 3]));
    try assert_eq_i32(negative.encoding as i32, Encoding.encoding_int as i32);
    try assert_eq_i32(negative.int_value as i32, -42);
    object_free(positive);
    object_free(negative);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_object_string_raw_encoding_edges() !void {
    reset_memory_stats_for_test();
    const leading_zero: &RedisObject = try create_string_object(&"001"[0: 3]);
    const mixed: &RedisObject = try create_string_object(&"12x"[0: 3]);
    const empty: &RedisObject = try create_string_object(&""[0: 0]);
    try assert_eq_i32(leading_zero.encoding as i32, Encoding.encoding_raw as i32);
    try assert_eq_i32(mixed.encoding as i32, Encoding.encoding_raw as i32);
    try assert_eq_i32(empty.encoding as i32, Encoding.encoding_raw as i32);
    object_free(leading_zero);
    object_free(mixed);
    object_free(empty);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_object_hash_create_set_get_free() !void {
    reset_memory_stats_for_test();
    const obj: &RedisObject = try create_hash_object();
    try assert_eq_i32(obj.obj_type as i32, ObjectType.object_hash as i32);
    try assert_eq_i32(obj.encoding as i32, Encoding.encoding_hash_table as i32);
    try assert_true(object_slice_eq(object_type_name(obj.obj_type), &"hash"[0: 4]));
    try assert_true(object_slice_eq(object_encoding_name(obj.encoding), &"hashtable"[0: 9]));

    const inserted: bool = try hash_object_set_field(obj, &"field"[0: 5], &"value"[0: 5]);
    try assert_eq_i32(inserted as i32, 1);
    try assert_eq_i32((try hash_object_len(obj)) as i32, 1);
    try assert_eq_i32((try hash_object_exists_field(obj, &"field"[0: 5])) as i32, 1);
    const field_obj: &RedisObject = try hash_object_get_field(obj, &"field"[0: 5]);
    try assert_eq_i32(field_obj.obj_type as i32, ObjectType.object_string as i32);
    try assert_true(object_slice_eq(field_obj.value.buf[0: field_obj.value.len], &"value"[0: 5]));

    const updated: bool = try hash_object_set_field(obj, &"field"[0: 5], &"next"[0: 4]);
    try assert_eq_i32(updated as i32, 0);
    const field_obj_next: &RedisObject = try hash_object_get_field(obj, &"field"[0: 5]);
    try assert_true(object_slice_eq(field_obj_next.value.buf[0: field_obj_next.value.len], &"next"[0: 4]));
    try assert_eq_i32((try hash_object_delete_field(obj, &"field"[0: 5])) as i32, 1);
    try assert_eq_i32((try hash_object_len(obj)) as i32, 0);
    try assert_eq_i32((try hash_object_exists_field(obj, &"field"[0: 5])) as i32, 0);

    object_free(obj);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_object_list_create_push_pop_range_free() !void {
    reset_memory_stats_for_test();
    const obj: &RedisObject = try create_list_object();
    try assert_eq_i32(obj.obj_type as i32, ObjectType.object_list as i32);
    try assert_eq_i32(obj.encoding as i32, Encoding.encoding_linked_list as i32);
    try assert_true(object_slice_eq(object_type_name(obj.obj_type), &"list"[0: 4]));
    try assert_true(object_slice_eq(object_encoding_name(obj.encoding), &"linkedlist"[0: 10]));

    try assert_eq_i32((try list_object_push_head(obj, &"a"[0: 1])) as i32, 1);
    try assert_eq_i32((try list_object_push_head(obj, &"b"[0: 1])) as i32, 2);
    try assert_eq_i32((try list_object_push_head(obj, &"c"[0: 1])) as i32, 3);
    try assert_eq_i32((try list_object_len(obj)) as i32, 3);

    const view: ListRangeView = try list_object_range(obj, 0, 1);
    try assert_eq_i32(view.count as i32, 2);
    const head: &ListNode = view.head;
    try assert_true(object_slice_eq(head.value.value.buf[0: head.value.value.len], &"c"[0: 1]));
    try assert_true(object_slice_eq(head.next.value.value.buf[0: head.next.value.value.len], &"b"[0: 1]));

    const popped: &RedisObject = try list_object_pop_head(obj);
    try assert_true(object_slice_eq(popped.value.buf[0: popped.value.len], &"c"[0: 1]));
    object_free(popped);
    try assert_eq_i32((try list_object_len(obj)) as i32, 2);

    object_free(obj);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_object_set_create_add_remove_members_free() !void {
    reset_memory_stats_for_test();
    const obj: &RedisObject = try create_set_object();
    try assert_eq_i32(obj.obj_type as i32, ObjectType.object_set as i32);
    try assert_eq_i32(obj.encoding as i32, Encoding.encoding_set_table as i32);
    try assert_true(object_slice_eq(object_type_name(obj.obj_type), &"set"[0: 3]));
    try assert_true(object_slice_eq(object_encoding_name(obj.encoding), &"settable"[0: 8]));

    try assert_eq_i32((try set_object_add_member(obj, &"a"[0: 1])) as i32, 1);
    try assert_eq_i32((try set_object_add_member(obj, &"b"[0: 1])) as i32, 1);
    try assert_eq_i32((try set_object_add_member(obj, &"a"[0: 1])) as i32, 0);
    try assert_eq_i32((try set_object_len(obj)) as i32, 2);

    const members_obj: &RedisObject = try set_object_members_reply(obj);
    try assert_eq_i32((try list_object_len(members_obj)) as i32, 2);
    object_free(members_obj);

    try assert_eq_i32((try set_object_remove_member(obj, &"a"[0: 1])) as i32, 1);
    try assert_eq_i32((try set_object_remove_member(obj, &"missing"[0: 7])) as i32, 0);
    try assert_eq_i32((try set_object_len(obj)) as i32, 1);

    object_free(obj);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_object_zset_create_add_remove_range_free() !void {
    reset_memory_stats_for_test();
    const obj: &RedisObject = try create_zset_object();
    try assert_eq_i32(obj.obj_type as i32, ObjectType.object_zset as i32);
    try assert_eq_i32(obj.encoding as i32, Encoding.encoding_zset_table as i32);
    try assert_true(object_slice_eq(object_type_name(obj.obj_type), &"zset"[0: 4]));
    try assert_true(object_slice_eq(object_encoding_name(obj.encoding), &"zsettable"[0: 9]));

    try assert_eq_i32((try zset_object_add_member(obj, 2, &"b"[0: 1])) as i32, 1);
    try assert_eq_i32((try zset_object_add_member(obj, 1, &"a"[0: 1])) as i32, 1);
    try assert_eq_i32((try zset_object_add_member(obj, 3, &"c"[0: 1])) as i32, 1);
    try assert_eq_i32((try zset_object_add_member(obj, 5, &"a"[0: 1])) as i32, 0);
    try assert_eq_i32((try zset_object_len(obj)) as i32, 3);

    const ranged: &RedisObject = try zset_object_range_reply(obj, 0, 1);
    try assert_eq_i32((try list_object_len(ranged)) as i32, 2);
    try assert_true(object_slice_eq(ranged.list_head.value.value.buf[0: ranged.list_head.value.value.len], &"b"[0: 1]));
    try assert_true(object_slice_eq(ranged.list_head.next.value.value.buf[0: ranged.list_head.next.value.value.len], &"c"[0: 1]));
    object_free(ranged);

    try assert_eq_i32((try zset_object_remove_member(obj, &"b"[0: 1])) as i32, 1);
    try assert_eq_i32((try zset_object_remove_member(obj, &"missing"[0: 7])) as i32, 0);
    try assert_eq_i32((try zset_object_len(obj)) as i32, 2);

    object_free(obj);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_object_stream_create_append_free() !void {
    reset_memory_stats_for_test();
    const stream: &RedisObject = try create_stream_object();
    try assert_eq_i32(stream.obj_type as i32, ObjectType.object_stream as i32);
    try assert_eq_i32(stream.encoding as i32, Encoding.encoding_stream_list as i32);
    try assert_true(object_slice_eq(object_type_name(stream.obj_type), &"stream"[0: 6]));
    try assert_true(object_slice_eq(object_encoding_name(stream.encoding), &"streamlist"[0: 10]));

    const entry: &RedisObject = try create_list_object();
    _ = try list_object_push_head(entry, &"value"[0: 5]);
    _ = try list_object_push_head(entry, &"field"[0: 5]);
    _ = try list_object_push_head(entry, &"1000-0"[0: 6]);
    try assert_eq_i32((try stream_object_append_entry(stream, entry, 1000u64, 0u64)) as i32, 1);
    try assert_eq_i32((try stream_object_len(stream)) as i32, 1);
    try assert_eq_i32(stream.stream_last_ms as i32, 1000);
    try assert_eq_i32(stream.stream_last_seq as i32, 0);

    const second_entry: &RedisObject = try create_list_object();
    _ = try list_object_push_head(second_entry, &"next"[0: 4]);
    _ = try list_object_push_head(second_entry, &"field"[0: 5]);
    _ = try list_object_push_head(second_entry, &"1000-1"[0: 6]);
    try assert_eq_i32((try stream_object_append_entry(stream, second_entry, 1000u64, 1u64)) as i32, 2);
    const popped: &RedisObject = try list_object_pop_head(stream);
    object_free(popped);
    try assert_eq_i32((try stream_object_len(stream)) as i32, 1);
    try assert_true(object_slice_eq(stream.list_head.value.list_head.value.value.buf[0: stream.list_head.value.list_head.value.value.len], &"1000-1"[0: 6]));

    object_free(stream);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_object_stream_group_lifecycle_clone_free() !void {
    reset_memory_stats_for_test();
    const stream: &RedisObject = try create_stream_object();
    try assert_eq_i32((try stream_object_group_count(stream)) as i32, 0);

    try assert_true(try stream_object_group_create(stream, &"alpha"[0: 5], 10u64, 2u64, true, 3));
    try assert_true(try stream_object_group_create(stream, &"beta"[0: 4], 20u64, 0u64, false, 0));
    try assert_eq_i32((try stream_object_group_create(stream, &"alpha"[0: 5], 99u64, 9u64, true, 99)) as i32, 0);
    try assert_eq_i32((try stream_object_group_count(stream)) as i32, 2);

    const alpha: &StreamGroup = try stream_object_group_lookup(stream, &"alpha"[0: 5]);
    try assert_true(object_slice_eq(alpha.name.buf[0: alpha.name.len], &"alpha"[0: 5]));
    try assert_eq_i32(alpha.last_delivered_ms as i32, 10);
    try assert_eq_i32(alpha.last_delivered_seq as i32, 2);
    try assert_true(alpha.entries_read_valid);
    try assert_eq_i32(alpha.entries_read as i32, 3);

    try stream_object_group_set_id(stream, &"alpha"[0: 5], 11u64, 4u64, false, 0);
    try assert_eq_i32(alpha.last_delivered_ms as i32, 11);
    try assert_eq_i32(alpha.last_delivered_seq as i32, 4);
    try assert_eq_i32(alpha.entries_read_valid as i32, 0);

    const cloned: &RedisObject = try object_clone(stream);
    try assert_eq_i32((try stream_object_group_count(cloned)) as i32, 2);
    const cloned_alpha: &StreamGroup = try stream_object_group_lookup(cloned, &"alpha"[0: 5]);
    try assert_eq_i32(cloned_alpha.last_delivered_ms as i32, 11);
    try assert_eq_i32(cloned_alpha.last_delivered_seq as i32, 4);
    try assert_eq_i32(cloned_alpha.entries_read_valid as i32, 0);

    var iter: DictIterator = stream_object_group_iter_new();
    var group: &StreamGroup = stream_object_group_iter_next(stream, &iter);
    var seen_alpha: i32 = 0;
    var seen_beta: i32 = 0;
    while group != null {
        if object_slice_eq(group.name.buf[0: group.name.len], &"alpha"[0: 5]) {
            seen_alpha = 1;
        }
        if object_slice_eq(group.name.buf[0: group.name.len], &"beta"[0: 4]) {
            seen_beta = 1;
        }
        group = stream_object_group_iter_next(stream, &iter);
    }
    try assert_eq_i32(seen_alpha, 1);
    try assert_eq_i32(seen_beta, 1);

    try assert_true(try stream_object_group_delete(stream, &"alpha"[0: 5]));
    try assert_eq_i32((try stream_object_group_delete(stream, &"alpha"[0: 5])) as i32, 0);
    try assert_eq_i32((try stream_object_group_count(stream)) as i32, 1);

    object_free(cloned);
    object_free(stream);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_object_stream_consumer_pending_lifecycle_clone_free() !void {
    reset_memory_stats_for_test();
    const stream: &RedisObject = try create_stream_object();
    try assert_true(try stream_object_group_create(stream, &"group"[0: 5], 10u64, 0u64, true, 1));
    try assert_eq_i32((try stream_object_group_consumer_count(stream, &"group"[0: 5])) as i32, 0);

    try assert_true(try stream_object_group_create_consumer(stream, &"group"[0: 5], &"alice"[0: 5], 100u64, 101u64));
    try assert_eq_i32((try stream_object_group_create_consumer(stream, &"group"[0: 5], &"alice"[0: 5], 200u64, 201u64)) as i32, 0);
    try assert_eq_i32((try stream_object_group_consumer_count(stream, &"group"[0: 5])) as i32, 1);
    const alice: &StreamConsumer = try stream_object_group_lookup_consumer(stream, &"group"[0: 5], &"alice"[0: 5]);
    try assert_true(object_slice_eq(alice.name.buf[0: alice.name.len], &"alice"[0: 5]));
    try assert_eq_i32(alice.seen_time_ms as i32, 100);
    try assert_eq_i32(alice.active_time_ms as i32, 101);
    try assert_eq_i32(alice.pending_count as i32, 0);

    try assert_true(try stream_object_group_pending_add(stream, &"group"[0: 5], &"alice"[0: 5], 10u64, 2u64, 300u64, 1u64));
    try assert_eq_i32((try stream_object_group_pending_add(stream, &"group"[0: 5], &"alice"[0: 5], 10u64, 2u64, 400u64, 2u64)) as i32, 0);
    try assert_eq_i32((try stream_object_group_pending_count(stream, &"group"[0: 5])) as i32, 1);
    try assert_eq_i32(alice.pending_count as i32, 1);
    const pending: &StreamPending = try stream_object_group_pending_lookup(stream, &"group"[0: 5], 10u64, 2u64);
    try assert_eq_i32(pending.id_ms as i32, 10);
    try assert_eq_i32(pending.id_seq as i32, 2);
    try assert_eq_i32(pending.delivery_time_ms as i32, 400);
    try assert_eq_i32(pending.delivery_count as i32, 2);
    try assert_true(object_slice_eq(pending.consumer_name.buf[0: pending.consumer_name.len], &"alice"[0: 5]));

    const cloned: &RedisObject = try object_clone(stream);
    const cloned_alice: &StreamConsumer = try stream_object_group_lookup_consumer(cloned, &"group"[0: 5], &"alice"[0: 5]);
    try assert_eq_i32(cloned_alice.pending_count as i32, 1);
    const cloned_pending: &StreamPending = try stream_object_group_pending_lookup(cloned, &"group"[0: 5], 10u64, 2u64);
    try assert_eq_i32(cloned_pending.delivery_count as i32, 2);
    try assert_true(object_slice_eq(cloned_pending.consumer_name.buf[0: cloned_pending.consumer_name.len], &"alice"[0: 5]));

    try assert_true(try stream_object_group_pending_delete(stream, &"group"[0: 5], 10u64, 2u64));
    try assert_eq_i32((try stream_object_group_pending_count(stream, &"group"[0: 5])) as i32, 0);
    try assert_eq_i32(alice.pending_count as i32, 0);
    try assert_eq_i32((try stream_object_group_pending_delete(stream, &"group"[0: 5], 10u64, 2u64)) as i32, 0);

    try assert_true(try stream_object_group_pending_add(stream, &"group"[0: 5], &"alice"[0: 5], 11u64, 0u64, 500u64, 1u64));
    try assert_eq_i32((try stream_object_group_delete_consumer(stream, &"group"[0: 5], &"alice"[0: 5])) as i32, 1);
    try assert_eq_i32((try stream_object_group_consumer_count(stream, &"group"[0: 5])) as i32, 0);
    try assert_eq_i32((try stream_object_group_pending_count(stream, &"group"[0: 5])) as i32, 0);
    try assert_eq_i32((try stream_object_group_delete_consumer(stream, &"group"[0: 5], &"alice"[0: 5])) as i32, 0);

    const cloned_group: &StreamGroup = try stream_object_group_lookup(cloned, &"group"[0: 5]);
    var consumer_iter: DictIterator = stream_object_group_consumer_iter_new();
    var cloned_consumer: &StreamConsumer = stream_object_group_consumer_iter_next(cloned_group, &consumer_iter);
    try assert_true(cloned_consumer != null);
    try assert_true(object_slice_eq(cloned_consumer.name.buf[0: cloned_consumer.name.len], &"alice"[0: 5]));
    cloned_consumer = stream_object_group_consumer_iter_next(cloned_group, &consumer_iter);
    try assert_true(cloned_consumer == null);

    object_free(cloned);
    object_free(stream);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_object_pool_reuses_objects_and_list_nodes() !void {
    reset_memory_stats_for_test();
    object_pool_reset_for_test();
    try assert_true(object_layout_size() > 0);
    try assert_true(list_node_layout_size() > 0);

    const first: &RedisObject = try create_string_object(&"first"[0: 5]);
    object_free(first);
    try assert_eq_i32(used_memory() as i32, 0);
    try assert_eq_i32(object_pool_cached_objects() as i32, 1);
    try assert_eq_i32(object_pool_reuse_count() as i32, 0);

    const second: &RedisObject = try create_string_object(&"second"[0: 6]);
    try assert_eq_i32(object_pool_reuse_count() as i32, 1);
    object_free(second);
    try assert_eq_i32(used_memory() as i32, 0);
    try assert_eq_i32(object_pool_cached_objects() as i32, 1);

    const list: &RedisObject = try create_list_object();
    try assert_eq_i32((try list_object_push_head(list, &"a"[0: 1])) as i32, 1);
    object_free(list);
    try assert_eq_i32(used_memory() as i32, 0);
    try assert_true(object_pool_cached_objects() >= 2);
    try assert_eq_i32(object_pool_cached_list_nodes() as i32, 1);

    const list_again: &RedisObject = try create_list_object();
    try assert_eq_i32((try list_object_push_head(list_again, &"b"[0: 1])) as i32, 1);
    try assert_true(object_pool_reuse_count() >= 3);
    object_free(list_again);
    try assert_eq_i32(used_memory() as i32, 0);

    object_pool_reset_for_test();
    try assert_eq_i32(object_pool_cached_objects() as i32, 0);
    try assert_eq_i32(object_pool_cached_list_nodes() as i32, 0);
    try assert_eq_i32(object_pool_reuse_count() as i32, 0);
    try assert_eq_i32(used_memory() as i32, 0);
}
