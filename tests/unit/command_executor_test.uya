    var counter_del_parsed: RespParseResult = try parse_resp2(&"*2\r\n$3\r\nDEL\r\n$7\r\ncounter\r\n"[0: 26]);
    const counter_del_command: Command = try command_executor_test_command(&router, &counter_del_parsed);
    const counter_del_reply: CommandReply = command_execute_at(&engine, &counter_del_command, 1000u64);
    try assert_eq_i32(counter_del_reply.typ as i32, CommandReplyType.reply_integer as i32);
