// command/latency.uya - minimal in-process latency event history.

const LATENCY_HISTORY_MAX_ENTRIES: usize = 160;
const LATENCY_HISTOGRAM_MAX_COMMANDS: usize = 128;
export const LATENCY_HISTOGRAM_BUCKET_COUNT: usize = 30;
const LATENCY_HISTOGRAM_COMMAND_NAME_MAX: usize = 64;

export struct LatencyHistoryEntry {
    active: bool,
    timestamp_sec: u64,
    latency_ms: u64,
}

export struct LatencyHistogramEntry {
    active: bool,
    name: [byte: LATENCY_HISTOGRAM_COMMAND_NAME_MAX],
    name_len: usize,
    calls: u64,
    buckets: [u64: LATENCY_HISTOGRAM_BUCKET_COUNT],
}

var latency_command_active: bool = false;
var latency_command_latest_timestamp_sec: u64 = 0u64;
var latency_command_latest_latency_ms: u64 = 0u64;
var latency_command_max_latency_ms: u64 = 0u64;
var latency_command_entries: [LatencyHistoryEntry: LATENCY_HISTORY_MAX_ENTRIES] = [];
var latency_command_start: usize = 0;
var latency_command_count: usize = 0;
var latency_histogram_entries: [LatencyHistogramEntry: LATENCY_HISTOGRAM_MAX_COMMANDS] = [];
var latency_histogram_count_value: usize = 0;

fn latency_ascii_lower(ch: byte) byte {
    if ch >= 65 as byte && ch <= 90 as byte {
        return ch + 32 as byte;
    }
    return ch;
}

fn latency_event_is_command(event: &[byte]) bool {
    if event.len != 7 {
        return false;
    }
    return
        (event.ptr[0] == 99 as byte || event.ptr[0] == 67 as byte) &&
        (event.ptr[1] == 111 as byte || event.ptr[1] == 79 as byte) &&
        (event.ptr[2] == 109 as byte || event.ptr[2] == 77 as byte) &&
        (event.ptr[3] == 109 as byte || event.ptr[3] == 77 as byte) &&
        (event.ptr[4] == 97 as byte || event.ptr[4] == 65 as byte) &&
        (event.ptr[5] == 110 as byte || event.ptr[5] == 78 as byte) &&
        (event.ptr[6] == 100 as byte || event.ptr[6] == 68 as byte);
}

fn latency_histogram_entry_name_eq(entry: &LatencyHistogramEntry, name: &[byte]) bool {
    if entry.name_len != name.len {
        return false;
    }
    var i: usize = 0;
    while i < name.len {
        if entry.name[i] != latency_ascii_lower(name.ptr[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn latency_histogram_find_slot(name: &[byte]) usize {
    var index: usize = 0;
    while index < LATENCY_HISTOGRAM_MAX_COMMANDS {
        if latency_histogram_entries[index].active && latency_histogram_entry_name_eq(&latency_histogram_entries[index], name) {
            return index;
        }
        index = index + 1;
    }
    return LATENCY_HISTOGRAM_MAX_COMMANDS;
}

fn latency_histogram_first_free_slot() usize {
    var index: usize = 0;
    while index < LATENCY_HISTOGRAM_MAX_COMMANDS {
        if !latency_histogram_entries[index].active {
            return index;
        }
        index = index + 1;
    }
    return LATENCY_HISTOGRAM_MAX_COMMANDS;
}

fn latency_histogram_init_entry(slot: usize, command_name: &[byte]) void {
    if slot >= LATENCY_HISTOGRAM_MAX_COMMANDS {
        return;
    }
    var name_len: usize = command_name.len;
    if name_len > LATENCY_HISTOGRAM_COMMAND_NAME_MAX {
        name_len = LATENCY_HISTOGRAM_COMMAND_NAME_MAX;
    }
    var i: usize = 0;
    while i < LATENCY_HISTOGRAM_COMMAND_NAME_MAX {
        latency_histogram_entries[slot].name[i] = 0 as byte;
        i = i + 1;
    }
    i = 0;
    while i < name_len {
        latency_histogram_entries[slot].name[i] = latency_ascii_lower(command_name.ptr[i]);
        i = i + 1;
    }
    i = 0;
    while i < LATENCY_HISTOGRAM_BUCKET_COUNT {
        latency_histogram_entries[slot].buckets[i] = 0u64;
        i = i + 1;
    }
    latency_histogram_entries[slot].active = true;
    latency_histogram_entries[slot].name_len = name_len;
    latency_histogram_entries[slot].calls = 0u64;
    latency_histogram_count_value = latency_histogram_count_value + 1;
}

export fn latency_histogram_bucket_usec(index: usize) u64 {
    var value: u64 = 1u64;
    var i: usize = 0;
    while i < index {
        if value == 16u64 {
            value = 33u64;
        } else {
            value = value * 2u64;
        }
        i = i + 1;
    }
    return value;
}

fn latency_histogram_bucket_index(duration_us: u64) usize {
    var sample_us: u64 = duration_us;
    if sample_us == 0u64 {
        sample_us = 1u64;
    }
    var index: usize = 0;
    while index + 1 < LATENCY_HISTOGRAM_BUCKET_COUNT {
        if sample_us <= latency_histogram_bucket_usec(index) {
            return index;
        }
        index = index + 1;
    }
    return LATENCY_HISTOGRAM_BUCKET_COUNT - 1;
}

fn latency_histogram_record(command_name: &[byte], duration_us: u64) void {
    if command_name.len == 0 {
        return;
    }
    var slot: usize = latency_histogram_find_slot(command_name);
    if slot >= LATENCY_HISTOGRAM_MAX_COMMANDS {
        slot = latency_histogram_first_free_slot();
        if slot >= LATENCY_HISTOGRAM_MAX_COMMANDS {
            return;
        }
        latency_histogram_init_entry(slot, command_name);
    }
    if slot >= LATENCY_HISTOGRAM_MAX_COMMANDS {
        return;
    }
    const bucket: usize = latency_histogram_bucket_index(duration_us);
    latency_histogram_entries[slot].calls = latency_histogram_entries[slot].calls + 1u64;
    if bucket < LATENCY_HISTOGRAM_BUCKET_COUNT {
        latency_histogram_entries[slot].buckets[bucket] = latency_histogram_entries[slot].buckets[bucket] + 1u64;
    }
}

export fn latency_record_command(timestamp_sec: u64, duration_us: u64, command_name: &[byte], track_histogram: bool, monitor_threshold_ms: i64) void {
    var latency_ms: u64 = duration_us / 1000u64;
    if duration_us > 0u64 && latency_ms == 0u64 {
        latency_ms = 1u64;
    }
    if monitor_threshold_ms > 0 && latency_ms == 0u64 {
        latency_ms = 1u64;
    }

    if monitor_threshold_ms > 0 && latency_ms >= monitor_threshold_ms as u64 {
        latency_command_active = true;
        latency_command_latest_timestamp_sec = timestamp_sec;
        latency_command_latest_latency_ms = latency_ms;
        if latency_ms > latency_command_max_latency_ms {
            latency_command_max_latency_ms = latency_ms;
        }

        var slot: usize = 0;
        if latency_command_count < LATENCY_HISTORY_MAX_ENTRIES {
            slot = (latency_command_start + latency_command_count) % LATENCY_HISTORY_MAX_ENTRIES;
            latency_command_count = latency_command_count + 1;
        } else {
            slot = latency_command_start;
            latency_command_start = (latency_command_start + 1) % LATENCY_HISTORY_MAX_ENTRIES;
        }
        latency_command_entries[slot].active = true;
        latency_command_entries[slot].timestamp_sec = timestamp_sec;
        latency_command_entries[slot].latency_ms = latency_ms;
    }
    if track_histogram {
        latency_histogram_record(command_name, duration_us);
    }
}

export fn latency_command_is_active() bool {
    return latency_command_active;
}

export fn latency_command_latest_timestamp_sec() u64 {
    return latency_command_latest_timestamp_sec;
}

export fn latency_command_latest_latency_ms() u64 {
    return latency_command_latest_latency_ms;
}

export fn latency_command_max_latency_ms() u64 {
    return latency_command_max_latency_ms;
}

export fn latency_history_count(event: &[byte]) usize {
    if !latency_event_is_command(event) || !latency_command_active {
        return 0;
    }
    return latency_command_count;
}

export fn latency_history_entry(event: &[byte], offset: usize) &LatencyHistoryEntry {
    if !latency_event_is_command(event) || offset >= latency_command_count {
        return null as &LatencyHistoryEntry;
    }
    const slot: usize = (latency_command_start + offset) % LATENCY_HISTORY_MAX_ENTRIES;
    if !latency_command_entries[slot].active {
        return null as &LatencyHistoryEntry;
    }
    return &latency_command_entries[slot];
}

export fn latency_histogram_count() usize {
    return latency_histogram_count_value;
}

export fn latency_histogram_entry_at(offset: usize) &LatencyHistogramEntry {
    var seen: usize = 0;
    var index: usize = 0;
    while index < LATENCY_HISTOGRAM_MAX_COMMANDS {
        if latency_histogram_entries[index].active {
            if seen == offset {
                return &latency_histogram_entries[index];
            }
            seen = seen + 1;
        }
        index = index + 1;
    }
    return null as &LatencyHistogramEntry;
}

export fn latency_histogram_find_entry(command_name: &[byte]) &LatencyHistogramEntry {
    const slot: usize = latency_histogram_find_slot(command_name);
    if slot >= LATENCY_HISTOGRAM_MAX_COMMANDS {
        return null as &LatencyHistogramEntry;
    }
    return &latency_histogram_entries[slot];
}

export fn latency_histogram_entry_name(entry: &LatencyHistogramEntry) &[byte] {
    return entry.name[0: entry.name_len];
}

export fn latency_histogram_entry_bucket_count(entry: &LatencyHistogramEntry, index: usize) u64 {
    if index >= LATENCY_HISTOGRAM_BUCKET_COUNT {
        return 0u64;
    }
    return entry.buckets[index];
}

export fn latency_reset_histogram_all() void {
    var index: usize = 0;
    while index < LATENCY_HISTOGRAM_MAX_COMMANDS {
        latency_histogram_entries[index].active = false;
        latency_histogram_entries[index].name_len = 0;
        latency_histogram_entries[index].calls = 0u64;
        var bucket: usize = 0;
        while bucket < LATENCY_HISTOGRAM_BUCKET_COUNT {
            latency_histogram_entries[index].buckets[bucket] = 0u64;
            bucket = bucket + 1;
        }
        index = index + 1;
    }
    latency_histogram_count_value = 0;
}

fn latency_reset_command() bool {
    if !latency_command_active {
        return false;
    }
    var index: usize = 0;
    while index < LATENCY_HISTORY_MAX_ENTRIES {
        latency_command_entries[index].active = false;
        latency_command_entries[index].timestamp_sec = 0u64;
        latency_command_entries[index].latency_ms = 0u64;
        index = index + 1;
    }
    latency_command_active = false;
    latency_command_latest_timestamp_sec = 0u64;
    latency_command_latest_latency_ms = 0u64;
    latency_command_max_latency_ms = 0u64;
    latency_command_start = 0;
    latency_command_count = 0;
    return true;
}

export fn latency_reset_all() usize {
    if latency_reset_command() {
        return 1;
    }
    return 0;
}

export fn latency_reset_event(event: &[byte]) usize {
    if latency_event_is_command(event) && latency_reset_command() {
        return 1;
    }
    return 0;
}
