    try assert_true(network_connection_contains(out[0: set_read.response_len], &"NOPERM"[0: 6]));
    const set_write: ConnectionProcessResult = try connection_process_input_with_transaction_at(&engine, &router, &tx, &"*6\r\n$3\r\nACL\r\n$6\r\nDRYRUN\r\n$9\r\ndirection\r\n$3\r\nSET\r\n$9\r\nwrite:key\r\n$1\r\nx\r\n"[0: 71], &out[0], 4096, 1000u64);
