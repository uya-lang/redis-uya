    try assert_true(command_executor_test_slice_eq(out[0: zrange_after_rank_len], &"*1\r\n$1\r\nc\r\n"[0: 11]));
    command_reply_cleanup(&zrange_after_rank_reply);
    resp_value_free(&zrange_after_rank_parsed.value);

    var zremrangebyscore_parsed: RespParseResult = try parse_resp2(&"*4\r\n$16\r\nZREMRANGEBYSCORE\r\n$4\r\nzset\r\n$1\r\n3\r\n$1\r\n3\r\n"[0: 51]);
