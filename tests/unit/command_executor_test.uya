    const copy_db0_get_command: Command = try command_executor_test_command(&router, &copy_db0_get_parsed);
    const copy_db0_get_reply: CommandReply = command_execute_at(&engine, &copy_db0_get_command, 1000u64);
    try assert_eq_i32(copy_db0_get_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(copy_db0_get_reply.data, &"value"[0: 5]));
    resp_value_free(&copy_db0_get_parsed.value);

    var copy_missing_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nCOPY\r\n$7\r\nmissing\r\n$4\r\nnone\r\n"[0: 37]);
    const copy_missing_command: Command = try command_executor_test_command(&router, &copy_missing_parsed);
    const copy_missing_reply: CommandReply = command_execute_at(&engine, &copy_missing_command, 1000u64);
    try assert_eq_i32(copy_missing_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(copy_missing_reply.integer as i32, 0);
