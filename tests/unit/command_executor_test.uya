    var zscan_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nZSCAN\r\n$4\r\nzset\r\n$1\r\n0\r\n$5\r\nCOUNT\r\n$2\r\n16\r\n"[0: 51]);
