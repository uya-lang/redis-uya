    try assert_eq_i32(setex_ttl_reply.integer as i32, 2);
    resp_value_free(&setex_ttl_parsed.value);

    var psetex_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nPSETEX\r\n$6\r\nps-key\r\n$4\r\n1500\r\n$5\r\nvalue\r\n"[0: 49]);
    const psetex_command: Command = try command_executor_test_command(&router, &psetex_parsed);
