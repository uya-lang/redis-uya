export fn test_command_rpush_rpop_lindex_lset_llen() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var rpush_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nRPUSH\r\n$5\r\nrlist\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 47]);
    const rpush_command: Command = try command_executor_test_command(&router, &rpush_parsed);
    const rpush_reply: CommandReply = command_execute_at(&engine, &rpush_command, 1000u64);
    try assert_eq_i32(rpush_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(rpush_reply.integer as i32, 3);
    resp_value_free(&rpush_parsed.value);

    var llen_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nLLEN\r\n$5\r\nrlist\r\n"[0: 25]);
    const llen_command: Command = try command_executor_test_command(&router, &llen_parsed);
    const llen_reply: CommandReply = command_execute_at(&engine, &llen_command, 1000u64);
    try assert_eq_i32(llen_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(llen_reply.integer as i32, 3);
    resp_value_free(&llen_parsed.value);

    var lindex_head_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nLINDEX\r\n$5\r\nrlist\r\n$1\r\n0\r\n"[0: 34]);
    const lindex_head_command: Command = try command_executor_test_command(&router, &lindex_head_parsed);
    const lindex_head_reply: CommandReply = command_execute_at(&engine, &lindex_head_command, 1000u64);
