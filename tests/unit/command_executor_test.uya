    try assert_eq_i32(hstrlen_missing_reply.integer as i32, 0);
    resp_value_free(&hstrlen_missing_parsed.value);

    var hmget_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nHMGET\r\n$4\r\nhash\r\n$5\r\nfield\r\n$7\r\nmissing\r\n$7\r\ncounter\r\n"[0: 62]);
