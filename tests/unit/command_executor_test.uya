    var setrange_bad_parsed: RespParseResult = try parse_resp2(&"*4\r\n$8\r\nSETRANGE\r\n$3\r\nkey\r\n$2\r\n-1\r\n$1\r\nx\r\n"[0: 42]);
    const setrange_bad_command: Command = try command_executor_test_command(&router, &setrange_bad_parsed);
    const setrange_bad_reply: CommandReply = command_execute_at(&engine, &setrange_bad_command, 1000u64);
    try assert_eq_i32(setrange_bad_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&setrange_bad_parsed.value);

    var getbit_wrongtype_parsed: RespParseResult = try parse_resp2(&"*3\r\n$6\r\nGETBIT\r\n$4\r\nhash\r\n$1\r\n0\r\n"[0: 33]);
    const getbit_wrongtype_command: Command = try command_executor_test_command(&router, &getbit_wrongtype_parsed);
    const getbit_wrongtype_reply: CommandReply = command_execute_at(&engine, &getbit_wrongtype_command, 1000u64);
    try assert_eq_i32(getbit_wrongtype_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&getbit_wrongtype_parsed.value);

    var setbit_bad_offset_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nSETBIT\r\n$3\r\nkey\r\n$2\r\n-1\r\n$1\r\n1\r\n"[0: 40]);
    const setbit_bad_offset_command: Command = try command_executor_test_command(&router, &setbit_bad_offset_parsed);
    const setbit_bad_offset_reply: CommandReply = command_execute_at(&engine, &setbit_bad_offset_command, 1000u64);
    try assert_eq_i32(setbit_bad_offset_reply.typ as i32, CommandReplyType.reply_error as i32);
    resp_value_free(&setbit_bad_offset_parsed.value);

