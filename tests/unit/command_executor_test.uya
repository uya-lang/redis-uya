    resp_value_free(&hmget_parsed.value);

    var hmset_parsed: RespParseResult = try parse_resp2(&"*6\r\n$5\r\nHMSET\r\n$4\r\nhash\r\n$5\r\nmulti\r\n$3\r\none\r\n$6\r\nsecond\r\n$3\r\ntwo\r\n"[0: 66]);
