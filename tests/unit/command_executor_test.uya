    var hlen_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nHLEN\r\n$4\r\nhash\r\n"[0: 24]);
    const hlen_command: Command = try command_executor_test_command(&router, &hlen_parsed);
