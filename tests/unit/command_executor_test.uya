    resp_value_free(&psetex_parsed.value);

    var psetex_pttl_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nPTTL\r\n$6\r\nps-key\r\n"[0: 26]);
    const psetex_pttl_command: Command = try command_executor_test_command(&router, &psetex_pttl_parsed);
