fn command_executor_sunionstore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const target: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const result_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    var arg_index: usize = 2;
    while arg_index < command.argc {
        const key: &[byte] = command_executor_arg(command, arg_index) catch {
            object_free(result_set);
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        const obj: &RedisObject = obj_result catch {
            arg_index = arg_index + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_set {
            object_free(result_set);
            return command_executor_wrongtype();
        }
        var iter: DictIterator = dict_iter_new();
        var entry: &DictEntry = dict_iter_next(&obj.hash_dict, &iter);
        while entry != null {
            _ = set_object_add_member(result_set, entry.key.buf[0: entry.key.len]) catch |err| {
                object_free(result_set);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
            entry = dict_iter_next(&obj.hash_dict, &iter);
        }
        arg_index = arg_index + 1;
    }
    return command_executor_set_store_result(engine, target, result_set, now_ms);
}

fn command_executor_zincrby(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const increment_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const member: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const increment: i64 = command_executor_parse_i64(increment_data) catch {
        return command_executor_invalid_integer();
    };

    const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
    const obj: &RedisObject = obj_result catch {
        const zset_obj: &RedisObject = create_zset_object() catch {
            return command_executor_oom();
        };
        _ = zset_object_add_member(zset_obj, increment, member) catch |err| {
            object_free(zset_obj);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        _ = set_key_at(engine, key, zset_obj, now_ms) catch {
            object_free(zset_obj);
            return command_executor_oom();
        };
        return command_executor_bulk_i64(increment);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    const current_score_result: !i64 = zset_object_get_score(obj, member);
    const current_score: i64 = current_score_result catch {
        _ = zset_object_add_member(obj, increment, member) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        return command_executor_bulk_i64(increment);
    };
    const next_score: i64 = current_score + increment;
    _ = zset_object_add_member(obj, next_score, member) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    return command_executor_bulk_i64(next_score);
}

fn command_executor_zcard(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    const len: usize = zset_object_len(obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_integer(len as i64);
}

fn command_executor_zcount(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const min_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const max_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const min_score: i64 = command_executor_parse_i64(min_data) catch {
        return command_executor_invalid_integer();
    };
    const max_score: i64 = command_executor_parse_i64(max_data) catch {
        return command_executor_invalid_integer();
    };
    if min_score > max_score {
        return command_executor_integer(0);
    }
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }
    var count: i64 = 0;
    var iter: DictIterator = dict_iter_new();
    var entry: &DictEntry = dict_iter_next(&obj.hash_dict, &iter);
    while entry != null {
        const score: i64 = zset_object_get_score(obj, entry.key.buf[0: entry.key.len]) catch {
            return command_executor_wrongtype();
        };
        if score >= min_score && score <= max_score {
            count = count + 1;
        }
        entry = dict_iter_next(&obj.hash_dict, &iter);
    }
    return command_executor_integer(count);
}

fn command_executor_zdiff(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const numkeys_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }
    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 2 + numkeys;
    if command.argc != keys_end && command.argc != keys_end + 1 {
        return command_executor_syntax_error();
    }

    var withscores: bool = false;
    if command.argc == keys_end + 1 {
        const option: &[byte] = command_executor_arg(command, keys_end) catch {
            return command_executor_syntax_error();
        };
        if !command_executor_keyword_eq(option, &"WITHSCORES"[0: 10]) {
            return command_executor_syntax_error();
        }
        withscores = true;
    }

    const first_key: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const first_obj: &RedisObject = lookup_key_at(engine, first_key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if first_obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    const sorted_members: &RedisObject = zset_object_range_reply(first_obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const reply_list: &RedisObject = create_list_object() catch {
        object_free(sorted_members);
        return command_executor_oom();
    };

    var node: &ListNode = sorted_members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var seen_elsewhere: bool = false;
        var key_index: usize = 3;
        while key_index < keys_end {
            const key: &[byte] = command_executor_arg(command, key_index) catch {
                object_free(sorted_members);
                object_free(reply_list);
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                key_index = key_index + 1;
                null as &RedisObject;
            };
            if obj == null {
                continue;
            }
            if obj.obj_type != ObjectType.object_zset {
                object_free(sorted_members);
                object_free(reply_list);
                return command_executor_wrongtype();
            }
            var other_score: i64 = 0;
            const present: bool = command_executor_zset_score_or_missing(obj, member, &other_score) catch {
                object_free(sorted_members);
                object_free(reply_list);
                return command_executor_wrongtype();
            };
            if present {
                seen_elsewhere = true;
                break;
            }
            key_index = key_index + 1;
        }
        if !seen_elsewhere {
            _ = list_object_push_tail(reply_list, member) catch {
                object_free(sorted_members);
                object_free(reply_list);
                return command_executor_oom();
            };
            if withscores {
                const score: i64 = zset_object_get_score(first_obj, member) catch {
                    object_free(sorted_members);
                    object_free(reply_list);
                    return command_executor_wrongtype();
                };
                _ = command_executor_list_push_i64(reply_list, score) catch {
                    object_free(sorted_members);
                    object_free(reply_list);
                    return command_executor_oom();
                };
            }
        }
        node = node.next;
    }
    object_free(sorted_members);
    return command_executor_owned_array(reply_list);
}

fn command_executor_zset_store_result(engine: &Engine, target: &[byte], result_zset: &RedisObject, now_ms: u64) CommandReply {
    const len: usize = zset_object_len(result_zset) catch {
        object_free(result_zset);
        return command_executor_wrongtype();
    };
    if len == 0 {
        object_free(result_zset);
        _ = delete_key(engine, target);
        return command_executor_integer(0);
    }
    _ = set_key_at(engine, target, result_zset, now_ms) catch {
        object_free(result_zset);
        return command_executor_oom();
    };
    return command_executor_integer(len as i64);
}

fn command_executor_zdiffstore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }
    const target: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }
    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 3 + numkeys;
    if command.argc != keys_end {
        return command_executor_syntax_error();
    }

    const first_key: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const first_obj: &RedisObject = lookup_key_at(engine, first_key, now_ms) catch {
        _ = delete_key(engine, target);
        return command_executor_integer(0);
    };
    if first_obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    const sorted_members: &RedisObject = zset_object_range_reply(first_obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const result_zset: &RedisObject = create_zset_object() catch {
        object_free(sorted_members);
        return command_executor_oom();
    };

    var node: &ListNode = sorted_members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var seen_elsewhere: bool = false;
        var key_index: usize = 4;
        while key_index < keys_end {
            const key: &[byte] = command_executor_arg(command, key_index) catch {
                object_free(sorted_members);
                object_free(result_zset);
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                key_index = key_index + 1;
                null as &RedisObject;
            };
            if obj == null {
                continue;
            }
            if obj.obj_type != ObjectType.object_zset {
                object_free(sorted_members);
                object_free(result_zset);
                return command_executor_wrongtype();
            }
            var other_score: i64 = 0;
            const present: bool = command_executor_zset_score_or_missing(obj, member, &other_score) catch {
                object_free(sorted_members);
                object_free(result_zset);
                return command_executor_wrongtype();
            };
            if present {
                seen_elsewhere = true;
                break;
            }
            key_index = key_index + 1;
        }
        if !seen_elsewhere {
            const score: i64 = zset_object_get_score(first_obj, member) catch {
                object_free(sorted_members);
                object_free(result_zset);
                return command_executor_wrongtype();
            };
            _ = zset_object_add_member(result_zset, score, member) catch |err| {
                object_free(sorted_members);
                object_free(result_zset);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        }
        node = node.next;
    }
    object_free(sorted_members);
    return command_executor_zset_store_result(engine, target, result_zset, now_ms);
}

fn command_executor_zintercard(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }

    const numkeys_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }

    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 2 + numkeys;
    if command.argc < keys_end {
        return command_executor_error(&"ERR Number of keys can't be greater than number of args"[0: 55]);
    }

    var limit: usize = 0;
    if command.argc > keys_end {
        if command.argc != keys_end + 2 {
            return command_executor_syntax_error();
        }
        const option: &[byte] = command_executor_arg(command, keys_end) catch {
            return command_executor_syntax_error();
        };
        if !command_executor_keyword_eq(option, &"LIMIT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const limit_data: &[byte] = command_executor_arg(command, keys_end + 1) catch {
            return command_executor_syntax_error();
        };
        const limit_i64: i64 = command_executor_parse_i64(limit_data) catch {
            return command_executor_error(&"ERR LIMIT can't be negative"[0: 27]);
        };
        if limit_i64 < 0 {
            return command_executor_error(&"ERR LIMIT can't be negative"[0: 27]);
        }
        limit = limit_i64 as usize;
    }

    var missing_any: bool = false;
    var candidate: &RedisObject = null as &RedisObject;
    var candidate_arg_index: usize = 2;
    var candidate_len: usize = 0;
    var arg_index_check: usize = 2;
    while arg_index_check < keys_end {
        const key_check: &[byte] = command_executor_arg(command, arg_index_check) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key_check, now_ms);
        const obj: &RedisObject = obj_result catch {
            missing_any = true;
            arg_index_check = arg_index_check + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_zset {
            return command_executor_wrongtype();
        }
        const obj_len: usize = zset_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if candidate == null || obj_len < candidate_len {
            candidate = obj;
            candidate_arg_index = arg_index_check;
            candidate_len = obj_len;
        }
        arg_index_check = arg_index_check + 1;
    }

    if candidate == null || missing_any {
        return command_executor_integer(0);
    }

    if numkeys == 1 {
        if limit > 0 && candidate_len > limit {
            return command_executor_integer(limit as i64);
        }
        return command_executor_integer(candidate_len as i64);
    }

    const members: &RedisObject = zset_object_range_reply(candidate, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    defer {
        object_free(members);
    }

    var count: usize = 0;
    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        var present_everywhere: bool = true;
        var arg_index: usize = 2;
        while arg_index < keys_end {
            if arg_index == candidate_arg_index {
                arg_index = arg_index + 1;
                continue;
            }
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                present_everywhere = false;
                null as &RedisObject;
            };
            if obj == null {
                break;
            }
            if obj.obj_type != ObjectType.object_zset {
                return command_executor_wrongtype();
            }
            var score: i64 = 0;
            const present: bool = command_executor_zset_score_or_missing(obj, member, &score) catch {
                return command_executor_wrongtype();
            };
            if !present {
                present_everywhere = false;
                break;
            }
            arg_index = arg_index + 1;
        }
        if present_everywhere {
            count = count + 1;
            if limit > 0 && count >= limit {
                return command_executor_integer(limit as i64);
            }
        }
        node = node.next;
    }
    return command_executor_integer(count as i64);
}

fn command_executor_zset_result_array(result_zset: &RedisObject, withscores: bool) CommandReply {
    const sorted_members: &RedisObject = zset_object_range_reply(result_zset, 0, -1) catch |err| {
        object_free(result_zset);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    if !withscores {
        object_free(result_zset);
        return command_executor_owned_array(sorted_members);
    }

    const reply_list: &RedisObject = create_list_object() catch {
        object_free(sorted_members);
        object_free(result_zset);
        return command_executor_oom();
    };
    var reply_node: &ListNode = sorted_members.list_head;
    while reply_node != null {
        const member: &[byte] = reply_node.value.value.buf[0: reply_node.value.value.len];
        _ = list_object_push_tail(reply_list, member) catch {
            object_free(sorted_members);
            object_free(result_zset);
            object_free(reply_list);
            return command_executor_oom();
        };
        const score: i64 = zset_object_get_score(result_zset, member) catch {
            object_free(sorted_members);
            object_free(result_zset);
            object_free(reply_list);
            return command_executor_wrongtype();
        };
        _ = command_executor_list_push_i64(reply_list, score) catch {
            object_free(sorted_members);
            object_free(result_zset);
            object_free(reply_list);
            return command_executor_oom();
        };
        reply_node = reply_node.next;
    }
    object_free(sorted_members);
    object_free(result_zset);
    return command_executor_owned_array(reply_list);
}

fn command_executor_zaggregate_parse_options(command: &Command, keys_start: usize, keys_end: usize, allow_withscores: bool) !CommandExecutorZAggregateOptions {
    var options: CommandExecutorZAggregateOptions = CommandExecutorZAggregateOptions{
        keys_start: keys_start,
        keys_end: keys_end,
        weights_start: 0,
        aggregate: CommandExecutorZAggregateMode.zaggregate_sum,
        withscores: false,
    };
    const numkeys: usize = keys_end - keys_start;
    var index: usize = keys_end;
    while index < command.argc {
        const option: &[byte] = command_executor_arg(command, index) catch {
            return error.InvalidCommand;
        };
        if command_executor_keyword_eq(option, &"WEIGHTS"[0: 7]) {
            if options.weights_start != 0 {
                return error.InvalidCommand;
            }
            if index + 1 + numkeys > command.argc {
                return error.InvalidCommand;
            }
            options.weights_start = index + 1;
            var weight_index: usize = 0;
            while weight_index < numkeys {
                const weight_data: &[byte] = command_executor_arg(command, options.weights_start + weight_index) catch {
                    return error.InvalidCommand;
                };
                _ = command_executor_parse_i64(weight_data) catch {
                    return error.InvalidCommand;
                };
                weight_index = weight_index + 1;
            }
            index = index + 1 + numkeys;
            continue;
        }
        if command_executor_keyword_eq(option, &"AGGREGATE"[0: 9]) {
            if index + 1 >= command.argc {
                return error.InvalidCommand;
            }
            const mode_data: &[byte] = command_executor_arg(command, index + 1) catch {
                return error.InvalidCommand;
            };
            if command_executor_keyword_eq(mode_data, &"SUM"[0: 3]) {
                options.aggregate = CommandExecutorZAggregateMode.zaggregate_sum;
            } else if command_executor_keyword_eq(mode_data, &"MIN"[0: 3]) {
                options.aggregate = CommandExecutorZAggregateMode.zaggregate_min;
            } else if command_executor_keyword_eq(mode_data, &"MAX"[0: 3]) {
                options.aggregate = CommandExecutorZAggregateMode.zaggregate_max;
            } else {
                return error.InvalidCommand;
            }
            index = index + 2;
            continue;
        }
        if allow_withscores && command_executor_keyword_eq(option, &"WITHSCORES"[0: 10]) {
            if options.withscores {
                return error.InvalidCommand;
            }
            options.withscores = true;
            index = index + 1;
            continue;
        }
        return error.InvalidCommand;
    }
    return options;
}

fn command_executor_zaggregate_weight(command: &Command, options: &CommandExecutorZAggregateOptions, key_arg_index: usize) !i64 {
    if options.weights_start == 0 {
        return 1i64;
    }
    const weight_arg_index: usize = options.weights_start + (key_arg_index - options.keys_start);
    const weight_data: &[byte] = command_executor_arg(command, weight_arg_index) catch {
        return error.InvalidCommand;
    };
    return command_executor_parse_i64(weight_data);
}

fn command_executor_zaggregate_apply(current_score: i64, next_score: i64, aggregate: CommandExecutorZAggregateMode) i64 {
    if aggregate == CommandExecutorZAggregateMode.zaggregate_min {
        if next_score < current_score {
            return next_score;
        }
        return current_score;
    }
    if aggregate == CommandExecutorZAggregateMode.zaggregate_max {
        if next_score > current_score {
            return next_score;
        }
        return current_score;
    }
    return current_score + next_score;
}

fn command_executor_zinter_build_result(engine: &Engine, command: &Command, options: &CommandExecutorZAggregateOptions, now_ms: u64) CommandReply {
    const result_zset: &RedisObject = create_zset_object() catch {
        return command_executor_oom();
    };

    var missing_any: bool = false;
    var candidate: &RedisObject = null as &RedisObject;
    var candidate_arg_index: usize = options.keys_start;
    var candidate_len: usize = 0;
    var arg_index_check: usize = options.keys_start;
    while arg_index_check < options.keys_end {
        const key_check: &[byte] = command_executor_arg(command, arg_index_check) catch {
            object_free(result_zset);
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key_check, now_ms);
        const obj: &RedisObject = obj_result catch {
            missing_any = true;
            arg_index_check = arg_index_check + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_zset {
            object_free(result_zset);
            return command_executor_wrongtype();
        }
        const obj_len: usize = zset_object_len(obj) catch {
            object_free(result_zset);
            return command_executor_wrongtype();
        };
        if candidate == null || obj_len < candidate_len {
            candidate = obj;
            candidate_arg_index = arg_index_check;
            candidate_len = obj_len;
        }
        arg_index_check = arg_index_check + 1;
    }

    if candidate == null || missing_any {
        var empty_reply: CommandReply = command_executor_integer(0);
        empty_reply.owned_object = result_zset;
        return empty_reply;
    }

    const members: &RedisObject = zset_object_range_reply(candidate, 0, -1) catch |err| {
        object_free(result_zset);
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };

    var node: &ListNode = members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        const candidate_score: i64 = zset_object_get_score(candidate, member) catch {
            object_free(members);
            object_free(result_zset);
            return command_executor_wrongtype();
        };
        const candidate_weight: i64 = command_executor_zaggregate_weight(command, options, candidate_arg_index) catch {
            object_free(members);
            object_free(result_zset);
            return command_executor_syntax_error();
        };
        var total_score: i64 = candidate_score * candidate_weight;
        var present_everywhere: bool = true;
        var arg_index: usize = options.keys_start;
        while arg_index < options.keys_end {
            if arg_index == candidate_arg_index {
                arg_index = arg_index + 1;
                continue;
            }
            const key: &[byte] = command_executor_arg(command, arg_index) catch {
                object_free(members);
                object_free(result_zset);
                return command_executor_wrong_arity();
            };
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            const obj: &RedisObject = obj_result catch {
                present_everywhere = false;
                null as &RedisObject;
            };
            if obj == null {
                break;
            }
            if obj.obj_type != ObjectType.object_zset {
                object_free(members);
                object_free(result_zset);
                return command_executor_wrongtype();
            }
            var score: i64 = 0;
            const present: bool = command_executor_zset_score_or_missing(obj, member, &score) catch {
                object_free(members);
                object_free(result_zset);
                return command_executor_wrongtype();
            };
            if !present {
                present_everywhere = false;
                break;
            }
            const weight: i64 = command_executor_zaggregate_weight(command, options, arg_index) catch {
                object_free(members);
                object_free(result_zset);
                return command_executor_syntax_error();
            };
            total_score = command_executor_zaggregate_apply(total_score, score * weight, options.aggregate);
            arg_index = arg_index + 1;
        }
        if present_everywhere {
            _ = zset_object_add_member(result_zset, total_score, member) catch |err| {
                object_free(members);
                object_free(result_zset);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        }
        node = node.next;
    }
    object_free(members);

    var reply: CommandReply = command_executor_integer(0);
    reply.owned_object = result_zset;
    return reply;
}

fn command_executor_zinter(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const numkeys_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }
    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 2 + numkeys;
    if command.argc < keys_end {
        return command_executor_syntax_error();
    }

    const options: CommandExecutorZAggregateOptions = command_executor_zaggregate_parse_options(command, 2, keys_end, true) catch {
        return command_executor_syntax_error();
    };

    const build_reply: CommandReply = command_executor_zinter_build_result(engine, command, &options, now_ms);
    if build_reply.owned_object == null {
        return build_reply;
    }
    return command_executor_zset_result_array(build_reply.owned_object, options.withscores);
}

fn command_executor_zinterstore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }
    const target: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }
    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 3 + numkeys;
    if command.argc < keys_end {
        return command_executor_syntax_error();
    }
    const options: CommandExecutorZAggregateOptions = command_executor_zaggregate_parse_options(command, 3, keys_end, false) catch {
        return command_executor_syntax_error();
    };

    const build_reply: CommandReply = command_executor_zinter_build_result(engine, command, &options, now_ms);
    if build_reply.owned_object == null {
        return build_reply;
    }
    const result_zset: &RedisObject = build_reply.owned_object;
    return command_executor_zset_store_result(engine, target, result_zset, now_ms);
}

fn command_executor_zunion_build_result(engine: &Engine, command: &Command, options: &CommandExecutorZAggregateOptions, now_ms: u64) CommandReply {
    const result_zset: &RedisObject = create_zset_object() catch {
        return command_executor_oom();
    };

    var key_index: usize = options.keys_start;
    while key_index < options.keys_end {
        const key: &[byte] = command_executor_arg(command, key_index) catch {
            object_free(result_zset);
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        const obj: &RedisObject = obj_result catch {
            key_index = key_index + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_zset {
            object_free(result_zset);
            return command_executor_wrongtype();
        }

        const members: &RedisObject = zset_object_range_reply(obj, 0, -1) catch |err| {
            object_free(result_zset);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        var node: &ListNode = members.list_head;
        while node != null {
            const member: &[byte] = node.value.value.buf[0: node.value.value.len];
            const score: i64 = zset_object_get_score(obj, member) catch {
                object_free(members);
                object_free(result_zset);
                return command_executor_wrongtype();
            };
            const weight: i64 = command_executor_zaggregate_weight(command, options, key_index) catch {
                object_free(members);
                object_free(result_zset);
                return command_executor_syntax_error();
            };
            var current_score: i64 = 0;
            const present: bool = command_executor_zset_score_or_missing(result_zset, member, &current_score) catch {
                object_free(members);
                object_free(result_zset);
                return command_executor_wrongtype();
            };
            var next_score: i64 = score * weight;
            if present {
                next_score = command_executor_zaggregate_apply(current_score, next_score, options.aggregate);
            }
            _ = zset_object_add_member(result_zset, next_score, member) catch |err| {
                object_free(members);
                object_free(result_zset);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
            node = node.next;
        }
        object_free(members);
        key_index = key_index + 1;
    }

    var reply: CommandReply = command_executor_integer(0);
    reply.owned_object = result_zset;
    return reply;
}

fn command_executor_zunion(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const numkeys_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }
    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 2 + numkeys;
    if command.argc < keys_end {
        return command_executor_syntax_error();
    }

    const options: CommandExecutorZAggregateOptions = command_executor_zaggregate_parse_options(command, 2, keys_end, true) catch {
        return command_executor_syntax_error();
    };

    const build_reply: CommandReply = command_executor_zunion_build_result(engine, command, &options, now_ms);
    if build_reply.owned_object == null {
        return build_reply;
    }
    return command_executor_zset_result_array(build_reply.owned_object, options.withscores);
}

fn command_executor_zunionstore(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }
    const target: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }
    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 3 + numkeys;
    if command.argc < keys_end {
        return command_executor_syntax_error();
    }
    const options: CommandExecutorZAggregateOptions = command_executor_zaggregate_parse_options(command, 3, keys_end, false) catch {
        return command_executor_syntax_error();
    };

    const build_reply: CommandReply = command_executor_zunion_build_result(engine, command, &options, now_ms);
    if build_reply.owned_object == null {
        return build_reply;
    }
    const result_zset: &RedisObject = build_reply.owned_object;
    return command_executor_zset_store_result(engine, target, result_zset, now_ms);
}

fn command_executor_zlex_parse_bound(data: &[byte]) !CommandExecutorZLexBound {
    if data.len == 1 && data.ptr[0] == '-' as byte {
        return CommandExecutorZLexBound{
            negative_infinity: true,
            positive_infinity: false,
            exclusive: false,
            value: command_executor_empty_slice(),
        };
    }
    if data.len == 1 && data.ptr[0] == '+' as byte {
        return CommandExecutorZLexBound{
            negative_infinity: false,
            positive_infinity: true,
            exclusive: false,
            value: command_executor_empty_slice(),
        };
    }
    if data.len == 0 {
        return error.CommandInvalidRequest;
    }
    if data.ptr[0] == '[' as byte {
        return CommandExecutorZLexBound{
            negative_infinity: false,
            positive_infinity: false,
            exclusive: false,
            value: data[1: data.len - 1],
        };
    }
    if data.ptr[0] == '(' as byte {
        return CommandExecutorZLexBound{
            negative_infinity: false,
            positive_infinity: false,
            exclusive: true,
            value: data[1: data.len - 1],
        };
    }
    return error.CommandInvalidRequest;
}

fn command_executor_zlex_member_after_min(member: &[byte], bound: &CommandExecutorZLexBound) bool {
    if bound.negative_infinity {
        return true;
    }
    if bound.positive_infinity {
        return false;
    }
    const cmp: i32 = bytes_cmp(member, bound.value);
    if bound.exclusive {
        return cmp > 0;
    }
    return cmp >= 0;
}

fn command_executor_zlex_member_before_max(member: &[byte], bound: &CommandExecutorZLexBound) bool {
    if bound.positive_infinity {
        return true;
    }
    if bound.negative_infinity {
        return false;
    }
    const cmp: i32 = bytes_cmp(member, bound.value);
    if bound.exclusive {
        return cmp < 0;
    }
    return cmp <= 0;
}

fn command_executor_zlex_member_in_range(member: &[byte], min_bound: &CommandExecutorZLexBound, max_bound: &CommandExecutorZLexBound) bool {
    return command_executor_zlex_member_after_min(member, min_bound) && command_executor_zlex_member_before_max(member, max_bound);
}

fn command_executor_zlexcount(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const min_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const max_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const min_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(min_data) catch {
        return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
    };
    const max_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(max_data) catch {
        return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
    };

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    const sorted_members: &RedisObject = zset_object_range_reply(obj, 0, -1) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    var count: i64 = 0;
    var node: &ListNode = sorted_members.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        if command_executor_zlex_member_in_range(member, &min_bound, &max_bound) {
            count = count + 1;
        }
        node = node.next;
    }
    object_free(sorted_members);
    return command_executor_integer(count);
}

fn command_executor_zlex_range_members(obj: &RedisObject, min_bound: &CommandExecutorZLexBound, max_bound: &CommandExecutorZLexBound, reverse: bool, limit_enabled: bool, limit_offset: usize, limit_count: i64) !&RedisObject {
    const sorted_members: &RedisObject = try zset_object_range_reply(obj, 0, -1);
    const ranged: &RedisObject = create_list_object() catch {
        object_free(sorted_members);
        return error.AllocOutOfMemory;
    };
    var skipped: usize = 0;
    var emitted: i64 = 0;
    var node: &ListNode = sorted_members.list_head;
    if reverse {
        node = sorted_members.list_tail;
    }
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        if command_executor_zlex_member_in_range(member, min_bound, max_bound) {
            if limit_enabled && skipped < limit_offset {
                skipped = skipped + 1;
            } else if !limit_enabled || limit_count < 0 || emitted < limit_count {
                _ = list_object_push_tail(ranged, member) catch {
                    object_free(sorted_members);
                    object_free(ranged);
                    return error.AllocOutOfMemory;
                };
                emitted = emitted + 1;
            }
        }
        if reverse {
            node = node.prev;
        } else {
            node = node.next;
        }
    }
    object_free(sorted_members);
    return ranged;
}

fn command_executor_zlex_range_reply(obj: &RedisObject, min_bound: &CommandExecutorZLexBound, max_bound: &CommandExecutorZLexBound, reverse: bool, limit_enabled: bool, limit_offset: usize, limit_count: i64) CommandReply {
    const ranged: &RedisObject = command_executor_zlex_range_members(obj, min_bound, max_bound, reverse, limit_enabled, limit_offset, limit_count) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    return command_executor_owned_array(ranged);
}

fn command_executor_zrangebylex(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 && command.argc != 7 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const min_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const max_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const min_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(min_data) catch {
        return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
    };
    const max_bound: CommandExecutorZLexBound = command_executor_zlex_parse_bound(max_data) catch {
        return command_executor_error(&"ERR min or max not valid string range item"[0: 42]);
    };

    var limit_enabled: bool = false;
    var limit_offset: usize = 0;
    var limit_count: i64 = -1;
    if command.argc == 7 {
        const limit_keyword: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(limit_keyword, &"LIMIT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const offset_data: &[byte] = command_executor_arg(command, 5) catch {
            return command_executor_wrong_arity();
        };
        const count_data: &[byte] = command_executor_arg(command, 6) catch {
            return command_executor_wrong_arity();
        };
        const offset_i64: i64 = command_executor_parse_i64(offset_data) catch {
            return command_executor_invalid_integer();
        };
        if offset_i64 < 0 {
            return command_executor_error(&"ERR offset out of range"[0: 23]);
        }
        limit_enabled = true;
        limit_offset = offset_i64 as usize;
        limit_count = command_executor_parse_i64(count_data) catch {
            return command_executor_invalid_integer();
        };
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_zset {
        return command_executor_wrongtype();
    }

    return command_executor_zlex_range_reply(obj, &min_bound, &max_bound, false, limit_enabled, limit_offset, limit_count);
}

fn command_executor_zrevrangebylex(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 && command.argc != 7 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
