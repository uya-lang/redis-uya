    try assert_true(command_executor_test_slice_eq(out[0: hpttl_len], &"*2\r\n:-1\r\n:-2\r\n"[0: 14]));
    command_reply_cleanup(&hpttl_reply);
    resp_value_free(&hpttl_parsed.value);

    var hexpiretime_parsed: RespParseResult = try parse_resp2(&"*5\r\n$11\r\nHEXPIRETIME\r\n$4\r\nhash\r\n$6\r\nFIELDS\r\n$1\r\n1\r\n$5\r\nfield\r\n"[0: 62]);
    const hexpiretime_command: Command = try command_executor_test_command(&router, &hexpiretime_parsed);
    var hexpiretime_reply: CommandReply = command_execute_at(&engine, &hexpiretime_command, 1000u64);
    const hexpiretime_len: usize = try connection_encode_reply(&hexpiretime_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: hexpiretime_len], &"*1\r\n:-1\r\n"[0: 9]));
    command_reply_cleanup(&hexpiretime_reply);
    resp_value_free(&hexpiretime_parsed.value);

    var hpexpiretime_parsed: RespParseResult = try parse_resp2(&"*5\r\n$12\r\nHPEXPIRETIME\r\n$4\r\nhash\r\n$6\r\nFIELDS\r\n$1\r\n1\r\n$5\r\nfield\r\n"[0: 63]);
    const hpexpiretime_command: Command = try command_executor_test_command(&router, &hpexpiretime_parsed);
    var hpexpiretime_reply: CommandReply = command_execute_at(&engine, &hpexpiretime_command, 1000u64);
    const hpexpiretime_len: usize = try connection_encode_reply(&hpexpiretime_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: hpexpiretime_len], &"*1\r\n:-1\r\n"[0: 9]));
    command_reply_cleanup(&hpexpiretime_reply);
    resp_value_free(&hpexpiretime_parsed.value);

    var hpersist_parsed: RespParseResult = try parse_resp2(&"*6\r\n$8\r\nHPERSIST\r\n$4\r\nhash\r\n$6\r\nFIELDS\r\n$1\r\n2\r\n$5\r\nfield\r\n$7\r\nmissing\r\n"[0: 71]);
    const hpersist_command: Command = try command_executor_test_command(&router, &hpersist_parsed);
    var hpersist_reply: CommandReply = command_execute_at(&engine, &hpersist_command, 1000u64);
    const hpersist_len: usize = try connection_encode_reply(&hpersist_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: hpersist_len], &"*2\r\n:-1\r\n:-2\r\n"[0: 14]));
    command_reply_cleanup(&hpersist_reply);
    resp_value_free(&hpersist_parsed.value);

    var missing_key_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nHTTL\r\n$7\r\nmissing\r\n$6\r\nFIELDS\r\n$1\r\n1\r\n$1\r\na\r\n"[0: 53]);
    const missing_key_command: Command = try command_executor_test_command(&router, &missing_key_parsed);
    var missing_key_reply: CommandReply = command_execute_at(&engine, &missing_key_command, 1000u64);
    const missing_key_len: usize = try connection_encode_reply(&missing_key_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: missing_key_len], &"*1\r\n:-2\r\n"[0: 9]));
    command_reply_cleanup(&missing_key_reply);
    resp_value_free(&missing_key_parsed.value);

    var bad_token_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nHTTL\r\n$4\r\nhash\r\n$3\r\nBAD\r\n$1\r\n1\r\n$5\r\nfield\r\n"[0: 51]);
    const bad_token_command: Command = try command_executor_test_command(&router, &bad_token_parsed);
    const bad_token_reply: CommandReply = command_execute_at(&engine, &bad_token_command, 1000u64);
    try assert_eq_i32(bad_token_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(bad_token_reply.data, &"ERR syntax error"[0: 16]));
    resp_value_free(&bad_token_parsed.value);

    var bad_count_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nHTTL\r\n$4\r\nhash\r\n$6\r\nFIELDS\r\n$1\r\nx\r\n$5\r\nfield\r\n"[0: 54]);
    const bad_count_command: Command = try command_executor_test_command(&router, &bad_count_parsed);
    const bad_count_reply: CommandReply = command_execute_at(&engine, &bad_count_command, 1000u64);
    try assert_eq_i32(bad_count_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(bad_count_reply.data, &"ERR value is not an integer or out of range"[0: 43]));
    resp_value_free(&bad_count_parsed.value);

    var bad_mismatch_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nHTTL\r\n$4\r\nhash\r\n$6\r\nFIELDS\r\n$1\r\n2\r\n$5\r\nfield\r\n"[0: 54]);
    const bad_mismatch_command: Command = try command_executor_test_command(&router, &bad_mismatch_parsed);
    const bad_mismatch_reply: CommandReply = command_execute_at(&engine, &bad_mismatch_command, 1000u64);
    try assert_eq_i32(bad_mismatch_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_slice_eq(bad_mismatch_reply.data, &"ERR syntax error"[0: 16]));
    resp_value_free(&bad_mismatch_parsed.value);

    var set_str_parsed: RespParseResult = try parse_resp2(&"*3\r\n$3\r\nSET\r\n$3\r\nstr\r\n$5\r\nvalue\r\n"[0: 33]);
    const set_str_command: Command = try command_executor_test_command(&router, &set_str_parsed);
    _ = command_execute_at(&engine, &set_str_command, 1000u64);
    resp_value_free(&set_str_parsed.value);

    var hgetex_wrongtype_parsed: RespParseResult = try parse_resp2(&"*5\r\n$6\r\nHGETEX\r\n$3\r\nstr\r\n$6\r\nFIELDS\r\n$1\r\n1\r\n$5\r\nfield\r\n"[0: 55]);
    const hgetex_wrongtype_command: Command = try command_executor_test_command(&router, &hgetex_wrongtype_parsed);
    const hgetex_wrongtype_reply: CommandReply = command_execute_at(&engine, &hgetex_wrongtype_command, 1000u64);
    try assert_eq_i32(hgetex_wrongtype_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_contains(hgetex_wrongtype_reply.data, &"WRONGTYPE"[0: 9]));
    resp_value_free(&hgetex_wrongtype_parsed.value);

    var hsetex_wrongtype_parsed: RespParseResult = try parse_resp2(&"*6\r\n$6\r\nHSETEX\r\n$3\r\nstr\r\n$6\r\nFIELDS\r\n$1\r\n1\r\n$1\r\nf\r\n$1\r\nv\r\n"[0: 58]);
    const hsetex_wrongtype_command: Command = try command_executor_test_command(&router, &hsetex_wrongtype_parsed);
    const hsetex_wrongtype_reply: CommandReply = command_execute_at(&engine, &hsetex_wrongtype_command, 1000u64);
    try assert_eq_i32(hsetex_wrongtype_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_contains(hsetex_wrongtype_reply.data, &"WRONGTYPE"[0: 9]));
    resp_value_free(&hsetex_wrongtype_parsed.value);

    var hexpire_wrongtype_parsed: RespParseResult = try parse_resp2(&"*6\r\n$7\r\nHEXPIRE\r\n$3\r\nstr\r\n$2\r\n10\r\n$6\r\nFIELDS\r\n$1\r\n1\r\n$1\r\nf\r\n"[0: 60]);
    const hexpire_wrongtype_command: Command = try command_executor_test_command(&router, &hexpire_wrongtype_parsed);
    const hexpire_wrongtype_reply: CommandReply = command_execute_at(&engine, &hexpire_wrongtype_command, 1000u64);
    try assert_eq_i32(hexpire_wrongtype_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_contains(hexpire_wrongtype_reply.data, &"WRONGTYPE"[0: 9]));
    resp_value_free(&hexpire_wrongtype_parsed.value);

    var wrongtype_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nHTTL\r\n$3\r\nstr\r\n$6\r\nFIELDS\r\n$1\r\n1\r\n$5\r\nfield\r\n"[0: 53]);
    const wrongtype_command: Command = try command_executor_test_command(&router, &wrongtype_parsed);
    const wrongtype_reply: CommandReply = command_execute_at(&engine, &wrongtype_command, 1000u64);
    try assert_eq_i32(wrongtype_reply.typ as i32, CommandReplyType.reply_error as i32);
    try assert_true(command_executor_test_contains(wrongtype_reply.data, &"WRONGTYPE"[0: 9]));
    resp_value_free(&wrongtype_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_lpush_lpop_lrange() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 256] = [];

    var lpush_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nLPUSH\r\n$4\r\nlist\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 47]);
    const lpush_command: Command = try command_executor_test_command(&router, &lpush_parsed);
    const lpush_reply: CommandReply = command_execute_at(&engine, &lpush_command, 1000u64);
    try assert_eq_i32(lpush_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(lpush_reply.integer as i32, 3);
    resp_value_free(&lpush_parsed.value);

    var lrange_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nLRANGE\r\n$4\r\nlist\r\n$1\r\n0\r\n$2\r\n-1\r\n"[0: 41]);
    const lrange_command: Command = try command_executor_test_command(&router, &lrange_parsed);
    const lrange_reply: CommandReply = command_execute_at(&engine, &lrange_command, 1000u64);
    try assert_eq_i32(lrange_reply.typ as i32, CommandReplyType.reply_array_bulk as i32);
    const lrange_len: usize = try connection_encode_reply(&lrange_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: lrange_len], &"*3\r\n$1\r\nc\r\n$1\r\nb\r\n$1\r\na\r\n"[0: 25]));
    command_reply_cleanup(&lrange_reply);
    resp_value_free(&lrange_parsed.value);

    var lpop_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nLPOP\r\n$4\r\nlist\r\n"[0: 24]);
    const lpop_command: Command = try command_executor_test_command(&router, &lpop_parsed);
    const lpop_reply: CommandReply = command_execute_at(&engine, &lpop_command, 1000u64);
    try assert_eq_i32(lpop_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(lpop_reply.data, &"c"[0: 1]));
    command_reply_cleanup(&lpop_reply);
    resp_value_free(&lpop_parsed.value);

    var lrange_tail_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nLRANGE\r\n$4\r\nlist\r\n$1\r\n0\r\n$1\r\n0\r\n"[0: 40]);
    const lrange_tail_command: Command = try command_executor_test_command(&router, &lrange_tail_parsed);
    const lrange_tail_reply: CommandReply = command_execute_at(&engine, &lrange_tail_command, 1000u64);
    const lrange_tail_len: usize = try connection_encode_reply(&lrange_tail_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: lrange_tail_len], &"*1\r\n$1\r\nb\r\n"[0: 11]));
    command_reply_cleanup(&lrange_tail_reply);
    resp_value_free(&lrange_tail_parsed.value);

    var lpush_count_parsed: RespParseResult = try parse_resp2(&"*5\r\n$5\r\nLPUSH\r\n$9\r\ncountlist\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 51]);
    const lpush_count_command: Command = try command_executor_test_command(&router, &lpush_count_parsed);
    _ = command_execute_at(&engine, &lpush_count_command, 1000u64);
    resp_value_free(&lpush_count_parsed.value);

    var lpop_count_parsed: RespParseResult = try parse_resp2(&"*3\r\n$4\r\nLPOP\r\n$9\r\ncountlist\r\n$1\r\n3\r\n"[0: 36]);
    const lpop_count_command: Command = try command_executor_test_command(&router, &lpop_count_parsed);
    var lpop_count_reply: CommandReply = command_execute_at(&engine, &lpop_count_command, 1000u64);
    try assert_eq_i32(lpop_count_reply.typ as i32, CommandReplyType.reply_array_bulk as i32);
    const lpop_count_len: usize = try connection_encode_reply(&lpop_count_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: lpop_count_len], &"*3\r\n$1\r\nc\r\n$1\r\nb\r\n$1\r\na\r\n"[0: 25]));
    command_reply_cleanup(&lpop_count_reply);
    resp_value_free(&lpop_count_parsed.value);

    engine_free(&engine);
    try assert_eq_i32(used_memory() as i32, 0);
}

export fn test_command_streams_first_batch() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();
    var out: [byte: 1024] = [];

    var xadd_parsed: RespParseResult = try parse_resp2(&"*7\r\n$4\r\nXADD\r\n$6\r\nstream\r\n$1\r\n*\r\n$2\r\nf1\r\n$2\r\nv1\r\n$2\r\nf2\r\n$2\r\nv2\r\n"[0: 65]);
    const xadd_command: Command = try command_executor_test_command(&router, &xadd_parsed);
    const xadd_reply: CommandReply = command_execute_at(&engine, &xadd_command, 1000u64);
    try assert_eq_i32(xadd_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(xadd_reply.data, &"1000-0"[0: 6]));
    command_reply_cleanup(&xadd_reply);
    resp_value_free(&xadd_parsed.value);

    var xadd_second_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nXADD\r\n$6\r\nstream\r\n$1\r\n*\r\n$1\r\nf\r\n$2\r\nv3\r\n"[0: 48]);
    const xadd_second_command: Command = try command_executor_test_command(&router, &xadd_second_parsed);
    const xadd_second_reply: CommandReply = command_execute_at(&engine, &xadd_second_command, 1000u64);
    try assert_eq_i32(xadd_second_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(xadd_second_reply.data, &"1000-1"[0: 6]));
    command_reply_cleanup(&xadd_second_reply);
    resp_value_free(&xadd_second_parsed.value);

    var xadd_trim_seed_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nXADD\r\n$10\r\ntrimstream\r\n$3\r\n1-0\r\n$1\r\nf\r\n$1\r\na\r\n"[0: 54]);
    const xadd_trim_seed_command: Command = try command_executor_test_command(&router, &xadd_trim_seed_parsed);
    const xadd_trim_seed_reply: CommandReply = command_execute_at(&engine, &xadd_trim_seed_command, 1000u64);
    try assert_eq_i32(xadd_trim_seed_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(xadd_trim_seed_reply.data, &"1-0"[0: 3]));
    command_reply_cleanup(&xadd_trim_seed_reply);
    resp_value_free(&xadd_trim_seed_parsed.value);

    var xadd_trim_parsed: RespParseResult = try parse_resp2(&"*8\r\n$4\r\nXADD\r\n$10\r\ntrimstream\r\n$6\r\nMAXLEN\r\n$1\r\n=\r\n$1\r\n1\r\n$3\r\n1-1\r\n$1\r\nf\r\n$1\r\nb\r\n"[0: 80]);
    const xadd_trim_command: Command = try command_executor_test_command(&router, &xadd_trim_parsed);
    const xadd_trim_reply: CommandReply = command_execute_at(&engine, &xadd_trim_command, 1000u64);
    try assert_eq_i32(xadd_trim_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(xadd_trim_reply.data, &"1-1"[0: 3]));
    command_reply_cleanup(&xadd_trim_reply);
    resp_value_free(&xadd_trim_parsed.value);

    var xlen_trim_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nXLEN\r\n$10\r\ntrimstream\r\n"[0: 31]);
    const xlen_trim_command: Command = try command_executor_test_command(&router, &xlen_trim_parsed);
    const xlen_trim_reply: CommandReply = command_execute_at(&engine, &xlen_trim_command, 1000u64);
    try assert_eq_i32(xlen_trim_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(xlen_trim_reply.integer as i32, 1);
    resp_value_free(&xlen_trim_parsed.value);

    var xrange_trim_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nXRANGE\r\n$10\r\ntrimstream\r\n$1\r\n-\r\n$1\r\n+\r\n"[0: 47]);
    const xrange_trim_command: Command = try command_executor_test_command(&router, &xrange_trim_parsed);
    const xrange_trim_reply: CommandReply = command_execute_at(&engine, &xrange_trim_command, 1000u64);
    const xrange_trim_len: usize = try connection_encode_reply(&xrange_trim_reply, &out[0], 1024);
    try assert_true(!command_executor_test_contains(out[0: xrange_trim_len], &"$3\r\n1-0\r\n"[0: 9]));
    try assert_true(command_executor_test_contains(out[0: xrange_trim_len], &"$3\r\n1-1\r\n"[0: 9]));
    command_reply_cleanup(&xrange_trim_reply);
    resp_value_free(&xrange_trim_parsed.value);

    var xadd_limit_seed_a_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nXADD\r\n$11\r\nlimitstream\r\n$3\r\n1-0\r\n$1\r\nf\r\n$1\r\na\r\n"[0: 55]);
    const xadd_limit_seed_a_command: Command = try command_executor_test_command(&router, &xadd_limit_seed_a_parsed);
    _ = command_execute_at(&engine, &xadd_limit_seed_a_command, 1000u64);
    resp_value_free(&xadd_limit_seed_a_parsed.value);

    var xadd_limit_seed_b_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nXADD\r\n$11\r\nlimitstream\r\n$3\r\n1-1\r\n$1\r\nf\r\n$1\r\nb\r\n"[0: 55]);
    const xadd_limit_seed_b_command: Command = try command_executor_test_command(&router, &xadd_limit_seed_b_parsed);
    _ = command_execute_at(&engine, &xadd_limit_seed_b_command, 1000u64);
    resp_value_free(&xadd_limit_seed_b_parsed.value);

    var xadd_limit_parsed: RespParseResult = try parse_resp2(&"*10\r\n$4\r\nXADD\r\n$11\r\nlimitstream\r\n$6\r\nMAXLEN\r\n$1\r\n~\r\n$1\r\n1\r\n$5\r\nLIMIT\r\n$1\r\n1\r\n$3\r\n1-2\r\n$1\r\nf\r\n$1\r\nc\r\n"[0: 100]);
    const xadd_limit_command: Command = try command_executor_test_command(&router, &xadd_limit_parsed);
    const xadd_limit_reply: CommandReply = command_execute_at(&engine, &xadd_limit_command, 1000u64);
    try assert_eq_i32(xadd_limit_reply.typ as i32, CommandReplyType.reply_bulk_string as i32);
    try assert_true(command_executor_test_slice_eq(xadd_limit_reply.data, &"1-2"[0: 3]));
    command_reply_cleanup(&xadd_limit_reply);
    resp_value_free(&xadd_limit_parsed.value);

    var xlen_limit_parsed: RespParseResult = try parse_resp2(&"*2\r\n$4\r\nXLEN\r\n$11\r\nlimitstream\r\n"[0: 32]);
    const xlen_limit_command: Command = try command_executor_test_command(&router, &xlen_limit_parsed);
    const xlen_limit_reply: CommandReply = command_execute_at(&engine, &xlen_limit_command, 1000u64);
    try assert_eq_i32(xlen_limit_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(xlen_limit_reply.integer as i32, 2);
    resp_value_free(&xlen_limit_parsed.value);

    var xrange_limit_parsed: RespParseResult = try parse_resp2(&"*4\r\n$6\r\nXRANGE\r\n$11\r\nlimitstream\r\n$1\r\n-\r\n$1\r\n+\r\n"[0: 48]);
    const xrange_limit_command: Command = try command_executor_test_command(&router, &xrange_limit_parsed);
    const xrange_limit_reply: CommandReply = command_execute_at(&engine, &xrange_limit_command, 1000u64);
    const xrange_limit_len: usize = try connection_encode_reply(&xrange_limit_reply, &out[0], 1024);
    try assert_true(!command_executor_test_contains(out[0: xrange_limit_len], &"$3\r\n1-0\r\n"[0: 9]));
    try assert_true(command_executor_test_contains(out[0: xrange_limit_len], &"$3\r\n1-1\r\n"[0: 9]));
    try assert_true(command_executor_test_contains(out[0: xrange_limit_len], &"$3\r\n1-2\r\n"[0: 9]));
    command_reply_cleanup(&xrange_limit_reply);
    resp_value_free(&xrange_limit_parsed.value);

    var xadd_minid_seed_a_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nXADD\r\n$11\r\nminidstream\r\n$3\r\n1-0\r\n$1\r\nf\r\n$1\r\na\r\n"[0: 55]);
    const xadd_minid_seed_a_command: Command = try command_executor_test_command(&router, &xadd_minid_seed_a_parsed);
    _ = command_execute_at(&engine, &xadd_minid_seed_a_command, 1000u64);
    resp_value_free(&xadd_minid_seed_a_parsed.value);

    var xadd_minid_seed_b_parsed: RespParseResult = try parse_resp2(&"*5\r\n$4\r\nXADD\r\n$11\r\nminidstream\r\n$3\r\n1-1\r\n$1\r\nf\r\n$1\r\nb\r\n"[0: 55]);
