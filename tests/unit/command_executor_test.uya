export fn test_command_hincrby_hincrbyfloat() !void {
    reset_memory_stats_for_test();
    const router: CommandRouter = command_router_new();
    var engine: Engine = engine_new();

    var hincrby_missing_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nHINCRBY\r\n$4\r\nhash\r\n$7\r\ncounter\r\n$1\r\n2\r\n"[0: 47]);
    const hincrby_missing_command: Command = try command_executor_test_command(&router, &hincrby_missing_parsed);
    const hincrby_missing_reply: CommandReply = command_execute_at(&engine, &hincrby_missing_command, 1000u64);
    try assert_eq_i32(hincrby_missing_reply.typ as i32, CommandReplyType.reply_integer as i32);
    try assert_eq_i32(hincrby_missing_reply.integer as i32, 2);
    resp_value_free(&hincrby_missing_parsed.value);

    var hincrby_existing_parsed: RespParseResult = try parse_resp2(&"*4\r\n$7\r\nHINCRBY\r\n$4\r\nhash\r\n$7\r\ncounter\r\n$2\r\n-1\r\n"[0: 48]);
