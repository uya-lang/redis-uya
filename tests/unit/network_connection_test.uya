    const srcb_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$3\r\nSET\r\n$4\r\nsrcb\r\n$3\r\nbar\r\n"[0: 32], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: srcb_result.response_len], &"+OK\r\n"[0: 5]));

    const bitop_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*5\r\n$5\r\nBITOP\r\n$3\r\nAND\r\n$6\r\ndstbit\r\n$4\r\nsrca\r\n$4\r\nsrcb\r\n"[0: 56], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bitop_result.response_len], &":3\r\n"[0: 4]));

    const bitop_get_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*2\r\n$3\r\nGET\r\n$6\r\ndstbit\r\n"[0: 25], &out[0], 256, 1000u64);
    try assert_true(network_connection_slice_eq(out[0: bitop_get_result.response_len], &"$3\r\nbab\r\n"[0: 9]));

