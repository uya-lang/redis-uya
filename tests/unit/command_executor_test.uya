    var zrange_byscore_reply: CommandReply = command_execute_at(&engine, &zrange_byscore_command, 1000u64);
    const zrange_byscore_len: usize = try connection_encode_reply(&zrange_byscore_reply, &out[0], 256);
    try assert_true(command_executor_test_slice_eq(out[0: zrange_byscore_len], &"*2\r\n$1\r\nb\r\n$1\r\nc\r\n"[0: 18]));
    command_reply_cleanup(&zrange_byscore_reply);
    resp_value_free(&zrange_byscore_parsed.value);

    var zrange_byscore_rev_scores_parsed: RespParseResult = try parse_resp2(&"*7\r\n$6\r\nZRANGE\r\n$4\r\nzset\r\n$1\r\n3\r\n$1\r\n1\r\n$7\r\nBYSCORE\r\n$3\r\nREV\r\n$10\r\nWITHSCORES\r\n"[0: 79]);
