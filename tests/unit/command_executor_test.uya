    command_reply_cleanup(&slowlog_get_all_reply);
    resp_value_free(&slowlog_get_all_parsed.value);

    var slowlog_reset_parsed: RespParseResult = try parse_resp2(&"*2\r\n$7\r\nSLOWLOG\r\n$5\r\nRESET\r\n"[0: 28]);
    const slowlog_reset_command: Command = try command_executor_test_command(&router, &slowlog_reset_parsed);
    const slowlog_reset_reply: CommandReply = command_execute_at(&engine, &slowlog_reset_command, 1000u64);
