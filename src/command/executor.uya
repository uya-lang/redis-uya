export fn command_runtime_default() CommandRuntimeInfo {
    return CommandRuntimeInfo{
        config: default_config(),
        active_clients: 0,
        maxclients: 0,
        served_clients: 0,
        cron_ticks: 0u64,
        start_ms: 0u64,
        replication_role: ReplicationRole.role_master,
        replication_state: ReplicationState.repl_state_none,
        replication_replid: [],
        replication_master_offset: 0u64,
        replication_backlog_first_offset: 0u64,
        replication_backlog_histlen: 0,
        replication_backlog_active: false,
        bgsave_requested: false,
        bgsave_in_progress: false,
        aof_rewrite_requested: false,
        aof_rewrite_in_progress: false,
        cluster_topology: null as &ClusterTopology,
        lastsave_ms: 0u64,
        protocol_version: 2,
    };
}

fn command_executor_empty_slice() &[byte] {
    return (null as &byte)[0: 0];
}

fn command_executor_reply(typ: CommandReplyType, data: &[byte], integer: i64) CommandReply {
    return CommandReply{
        typ: typ,
        data: data,
        integer: integer,
        scan_cursor: 0u64,
        array_head: null as &ListNode,
        array_count: 0,
        owned_object: null as &RedisObject,
        owned_aux_object: null as &RedisObject,
        request_replicaof: false,
        replicaof_promote: false,
        replicaof_host: [],
        replicaof_port: 0,
        request_bgsave: false,
        request_aof_rewrite: false,
        request_config_set: false,
        config_after: default_config(),
        request_client_kill: false,
        client_kill_id: 0,
        request_client_pause: false,
        client_pause_timeout_ms: 0u64,
        client_pause_write_only: false,
        client_pause_owner_id: 0,
        request_client_unpause: false,
        request_maxclients_set: false,
        maxclients_after: 0,
    };
}

fn command_executor_simple(data: &[byte]) CommandReply {
    return command_executor_reply(CommandReplyType.reply_simple_string, data, 0);
}

fn command_executor_error(data: &[byte]) CommandReply {
    return command_executor_reply(CommandReplyType.reply_error, data, 0);
}

fn command_executor_integer(value: i64) CommandReply {
    return command_executor_reply(CommandReplyType.reply_integer, command_executor_empty_slice(), value);
}

fn command_executor_bulk(data: &[byte]) CommandReply {
    return command_executor_reply(CommandReplyType.reply_bulk_string, data, 0);
}

fn command_executor_array_bulk(head: &ListNode, count: usize) CommandReply {
    var reply: CommandReply = command_executor_reply(CommandReplyType.reply_array_bulk, command_executor_empty_slice(), 0);
    reply.array_head = head;
    reply.array_count = count;
    return reply;
}

fn command_executor_nullable_array_bulk(head: &ListNode, count: usize, null_map_obj: &RedisObject) CommandReply {
    var reply: CommandReply = command_executor_reply(CommandReplyType.reply_array_nullable_bulk, command_executor_empty_slice(), 0);
    reply.array_head = head;
    reply.array_count = count;
    reply.data = null_map_obj.value.buf[0: null_map_obj.value.len];
    reply.owned_aux_object = null_map_obj;
    return reply;
}

fn command_executor_scan(cursor: u64, head: &ListNode, count: usize) CommandReply {
    var reply: CommandReply = command_executor_reply(CommandReplyType.reply_scan, command_executor_empty_slice(), 0);
    reply.scan_cursor = cursor;
    reply.array_head = head;
    reply.array_count = count;
    return reply;
}

fn command_executor_wrong_arity() CommandReply {
    return command_executor_error(&"ERR wrong number of arguments"[0: 29]);
}

fn command_executor_oom() CommandReply {
    return command_executor_error(&"ERR out of memory"[0: 17]);
}

fn command_executor_wrongtype() CommandReply {
    return command_executor_error(&"WRONGTYPE Operation against a key holding the wrong kind of value"[0: 65]);
}

fn command_executor_invalid_integer() CommandReply {
    return command_executor_error(&"ERR value is not an integer or out of range"[0: 43]);
}

fn command_executor_geo_invalid_lonlat(lon: f64, lat: f64) CommandReply {
    var buf: [byte: 160] = [];
    const written: i32 = snprintf(&buf[0] as *byte, 160usize, "ERR invalid longitude,latitude pair %.6f,%.6f" as *byte, lon, lat);
    if written <= 0 {
        return command_executor_syntax_error();
    }
    return command_executor_owned_error(buf[0: written as usize]);
}

fn command_executor_syntax_error() CommandReply {
    return command_executor_error(&"ERR syntax error"[0: 16]);
}

fn command_executor_parse_i64(data: &[byte]) !i64 {
    if data.len == 0 {
        return error.CommandInvalidInteger;
    }

    var negative: bool = false;
    var index: usize = 0;
    if data.ptr[0] == 45 as byte {
        negative = true;
        index = 1;
        if data.len == 1 {
            return error.CommandInvalidInteger;
        }
    }

    if data.len - index > 18 {
        return error.CommandInvalidInteger;
    }

    var value: i64 = 0;
    while index < data.len {
        const ch: byte = data.ptr[index];
        if ch < 48 as byte || ch > 57 as byte {
            return error.CommandInvalidInteger;
        }
        value = value * 10 + ((ch - 48 as byte) as i64);
        index = index + 1;
    }

    if negative {
        value = 0 - value;
    }
    return value;
}

fn command_executor_arg(command: &Command, index: usize) !&[byte] {
    return command_arg_data(command, index);
}

fn command_executor_validate_float_token(data: &[byte]) bool {
    if data.len == 0 {
        return false;
    }
    var index: usize = 0;
    if data.ptr[index] == 43 as byte || data.ptr[index] == 45 as byte {
        index = index + 1;
        if index >= data.len {
            return false;
        }
    }

    var digits_before: usize = 0;
    while index < data.len && data.ptr[index] >= 48 as byte && data.ptr[index] <= 57 as byte {
        digits_before = digits_before + 1;
        index = index + 1;
    }

    var digits_after: usize = 0;
    if index < data.len && data.ptr[index] == 46 as byte {
        index = index + 1;
        while index < data.len && data.ptr[index] >= 48 as byte && data.ptr[index] <= 57 as byte {
            digits_after = digits_after + 1;
            index = index + 1;
        }
    }

    if digits_before + digits_after == 0 {
        return false;
    }

    if index < data.len && (data.ptr[index] == 101 as byte || data.ptr[index] == 69 as byte) {
        index = index + 1;
        if index >= data.len {
            return false;
        }
        if data.ptr[index] == 43 as byte || data.ptr[index] == 45 as byte {
            index = index + 1;
            if index >= data.len {
                return false;
            }
        }
        var exp_digits: usize = 0;
        while index < data.len && data.ptr[index] >= 48 as byte && data.ptr[index] <= 57 as byte {
            exp_digits = exp_digits + 1;
            index = index + 1;
        }
        if exp_digits == 0 {
            return false;
        }
    }

    return index == data.len;
}

fn command_executor_parse_f64(data: &[byte]) !f64 {
    if !command_executor_validate_float_token(data) {
        return error.CommandInvalidFloat;
    }
    if data.len >= 255usize {
        return error.CommandInvalidFloat;
    }
    var buf: [byte: 256] = [];
    var index: usize = 0;
    while index < data.len {
        buf[index] = data.ptr[index];
        index = index + 1;
    }
    buf[data.len] = 0 as byte;
    const parsed: f64 = strtod(&buf[0], null);
    if isnan(parsed) != 0 || isinf(parsed) != 0 {
        return error.CommandInvalidFloat;
    }
    return parsed;
}

fn command_executor_set_float_string(engine: &Engine, key: &[byte], value: f64, now_ms: u64) CommandReply {
    if isnan(value) != 0 || isinf(value) != 0 {
        return command_executor_error(&"ERR increment would produce NaN or Infinity"[0: 42]);
    }
    if value == 0.0 {
        const zero_obj: &RedisObject = create_string_object(&"0"[0: 1]) catch {
            return command_executor_oom();
        };
        _ = set_key_at(engine, key, zero_obj, now_ms) catch {
            object_free(zero_obj);
            return command_executor_oom();
        };
        return command_executor_bulk(&"0"[0: 1]);
    }

    var buf: [byte: 128] = [];
    const written: i32 = snprintf(&buf[0] as *byte, 128usize, "%.17g" as *byte, value);
    if written <= 0 || written >= 128 {
        return command_executor_error(&"ERR increment would produce NaN or Infinity"[0: 42]);
    }
    var text_len: usize = written as usize;
    var exp_index: usize = text_len;
    var scan: usize = 0;
    while scan < text_len {
        if buf[scan] == 101 as byte || buf[scan] == 69 as byte {
            exp_index = scan;
            break;
        }
        scan = scan + 1;
    }
    var dot_index: usize = exp_index;
    scan = 0;
    while scan < exp_index {
        if buf[scan] == 46 as byte {
            dot_index = scan;
            break;
        }
        scan = scan + 1;
    }
    if dot_index < exp_index {
        var frac_end: usize = exp_index;
        while frac_end > dot_index + 1 && frac_end <= text_len && frac_end - 1 < 128usize && buf[frac_end - 1] == 48 as byte {
            frac_end = frac_end - 1;
        }
        if frac_end == dot_index + 1 {
            frac_end = dot_index;
        }
        if exp_index < text_len {
            var move_src: usize = exp_index;
            var move_dst: usize = frac_end;
            while move_src < text_len && move_src < 128usize && move_dst < 128usize {
                buf[move_dst] = buf[move_src];
                move_dst = move_dst + 1;
                move_src = move_src + 1;
            }
            text_len = move_dst;
        } else {
            text_len = frac_end;
        }
    }
    const text: &[byte] = buf[0: text_len];
    const obj: &RedisObject = create_string_object(text) catch {
        return command_executor_oom();
    };
    _ = set_key_at(engine, key, obj, now_ms) catch {
        object_free(obj);
        return command_executor_oom();
    };
    return command_executor_bulk(obj.value.buf[0: obj.value.len]);
}

fn command_executor_hash_lookup_or_create(engine: &Engine, key: &[byte], now_ms: u64) !&RedisObject {
    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        const hash_obj: &RedisObject = try create_hash_object();
        _ = set_key_at(engine, key, hash_obj, now_ms) catch |err| {
            object_free(hash_obj);
            return err;
        };
        return hash_obj;
    };
    if existing.obj_type != ObjectType.object_hash {
        return error.CommandWrongType;
    }
    return existing;
}

fn command_executor_hash_set_integer_field(obj: &RedisObject, field: &[byte], value: i64) CommandReply {
    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_i64(value);
    _ = sds_cat_fmt(&buf, &"%i"[0: 2], args[0: 1]) catch {
        return command_executor_oom();
    };
    _ = hash_object_set_field(obj, field, buf.buf[0: buf.len]) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    return command_executor_integer(value);
}

fn command_executor_hash_set_float_field(obj: &RedisObject, field: &[byte], value: f64) CommandReply {
    if isnan(value) != 0 || isinf(value) != 0 {
        return command_executor_error(&"ERR increment would produce NaN or Infinity"[0: 42]);
    }
    var buf: [byte: 128] = [];
    const written: i32 = snprintf(&buf[0] as *byte, 128usize, "%.17g" as *byte, value);
    if written <= 0 || written >= 128 {
        return command_executor_error(&"ERR increment would produce NaN or Infinity"[0: 42]);
    }
    var text_len: usize = written as usize;
    var exp_index: usize = text_len;
    var scan: usize = 0;
    while scan < text_len {
        if buf[scan] == 101 as byte || buf[scan] == 69 as byte {
            exp_index = scan;
            break;
        }
        scan = scan + 1;
    }
    var dot_index: usize = exp_index;
    scan = 0;
    while scan < exp_index {
        if buf[scan] == 46 as byte {
            dot_index = scan;
            break;
        }
        scan = scan + 1;
    }
    if dot_index < exp_index {
        var frac_end: usize = exp_index;
        while frac_end > dot_index + 1 && frac_end <= text_len && frac_end - 1 < 128usize && buf[frac_end - 1] == 48 as byte {
            frac_end = frac_end - 1;
        }
        if frac_end == dot_index + 1 {
            frac_end = dot_index;
        }
        if exp_index < text_len {
            var move_src: usize = exp_index;
            var move_dst: usize = frac_end;
            while move_src < text_len && move_src < 128usize && move_dst < 128usize {
                buf[move_dst] = buf[move_src];
                move_dst = move_dst + 1;
                move_src = move_src + 1;
            }
            text_len = move_dst;
        } else {
            text_len = frac_end;
        }
    }
    _ = hash_object_set_field(obj, field, buf[0: text_len]) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_wrongtype();
    };
    const field_obj: &RedisObject = hash_object_get_field(obj, field) catch {
        return command_executor_wrongtype();
    };
    const data: &[byte] = command_executor_string_value(field_obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_bulk(data);
}

fn command_executor_hash_sorted_fields(obj: &RedisObject) !&RedisObject {
    if obj == null || obj.obj_type != ObjectType.object_hash {
        return error.ObjectWrongType;
    }
    const fields: &RedisObject = try create_list_object();
    var iter: DictIterator = dict_iter_new();
    var entry: &DictEntry = dict_iter_next(&obj.hash_dict, &iter);
    while entry != null {
        _ = list_object_insert_sorted_lex(fields, entry.key.buf[0: entry.key.len]) catch {
            object_free(fields);
            return error.AllocOutOfMemory;
        };
        entry = dict_iter_next(&obj.hash_dict, &iter);
    }
    return fields;
}

fn command_executor_ascii_lower(ch: byte) byte {
    if ch >= 65 as byte && ch <= 90 as byte {
        return ch + 32 as byte;
    }
    return ch;
}

fn command_executor_keyword_eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }

    var i: usize = 0;
    while i < a.len {
        if command_executor_ascii_lower(a.ptr[i]) != command_executor_ascii_lower(b.ptr[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

struct StreamId {
    ms: u64,
    seq: u64,
    is_min: bool,
    is_max: bool,
    is_dollar: bool,
}

const STREAM_ID_MAX_SEQ: u64 = 9223372036854775807u64;

fn command_executor_parse_u64_token(data: &[byte]) !u64 {
    if data.len == 0 || data.len > 18 {
        return error.CommandInvalidInteger;
    }
    var value: u64 = 0u64;
    var index: usize = 0;
    while index < data.len {
        const ch: byte = data.ptr[index];
        if ch < 48 as byte || ch > 57 as byte {
            return error.CommandInvalidInteger;
        }
        value = value * 10u64 + ((ch - 48 as byte) as u64);
        index = index + 1;
    }
    return value;
}

fn command_executor_parse_stream_id(data: &[byte], default_seq: u64, allow_special: bool, allow_dollar: bool) !StreamId {
    if allow_special && data.len == 1 && data.ptr[0] == 45 as byte {
        return StreamId{ ms: 0u64, seq: 0u64, is_min: true, is_max: false, is_dollar: false };
    }
    if allow_special && data.len == 1 && data.ptr[0] == 43 as byte {
        return StreamId{ ms: 0u64, seq: 0u64, is_min: false, is_max: true, is_dollar: false };
    }
    if allow_dollar && data.len == 1 && data.ptr[0] == 36 as byte {
        return StreamId{ ms: 0u64, seq: 0u64, is_min: false, is_max: false, is_dollar: true };
    }

    var dash_index: usize = data.len;
    var index: usize = 0;
    while index < data.len {
        if data.ptr[index] == 45 as byte {
            dash_index = index;
            break;
        }
        index = index + 1;
    }
    if dash_index == 0 || dash_index == data.len - 1 {
        return error.CommandInvalidInteger;
    }
    if dash_index < data.len {
        const ms: u64 = try command_executor_parse_u64_token(data[0: dash_index]);
        const seq: u64 = try command_executor_parse_u64_token(data[dash_index + 1: data.len - dash_index - 1]);
        return StreamId{ ms: ms, seq: seq, is_min: false, is_max: false, is_dollar: false };
    }

    const ms_only: u64 = try command_executor_parse_u64_token(data);
    return StreamId{ ms: ms_only, seq: default_seq, is_min: false, is_max: false, is_dollar: false };
}

fn command_executor_stream_id_cmp(a: &StreamId, b: &StreamId) i32 {
    if a.is_min {
        if b.is_min { return 0; }
        return -1;
    }
    if b.is_min {
        return 1;
    }
    if a.is_max {
        if b.is_max { return 0; }
        return 1;
    }
    if b.is_max {
        return -1;
    }
    if a.ms < b.ms { return -1; }
    if a.ms > b.ms { return 1; }
    if a.seq < b.seq { return -1; }
    if a.seq > b.seq { return 1; }
    return 0;
}

fn command_executor_resp_append_array_header(buf: &Sds, count: usize) !void {
    try sds_cat(buf, &"*"[0: 1]);
    try command_executor_info_append_u64(buf, &"%u"[0: 2], count as u64);
    try sds_cat(buf, &"\r\n"[0: 2]);
}

fn command_executor_resp_append_bulk(buf: &Sds, data: &[byte]) !void {
    try sds_cat(buf, &"$"[0: 1]);
    try command_executor_info_append_u64(buf, &"%u"[0: 2], data.len as u64);
    try sds_cat(buf, &"\r\n"[0: 2]);
    try sds_cat(buf, data);
    try sds_cat(buf, &"\r\n"[0: 2]);
}

fn command_executor_resp_append_integer(buf: &Sds, value: i64) !void {
    try command_executor_info_append_i64(buf, &":%i\r\n"[0: 5], value);
}

fn command_executor_stream_id_sds(ms: u64, seq: u64) !Sds {
    var out: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    errdefer sds_free(&out);
    try command_executor_info_append_u64(&out, &"%u"[0: 2], ms);
    try sds_cat(&out, &"-"[0: 1]);
    try command_executor_info_append_u64(&out, &"%u"[0: 2], seq);
    return out;
}

fn command_executor_stream_append_entry_resp(buf: &Sds, entry: &RedisObject) !void {
    const entry_len: usize = list_object_len(entry) catch {
        return error.ObjectWrongType;
    };
    if entry_len < 1 {
        return error.ObjectWrongType;
    }
    try command_executor_resp_append_array_header(buf, 2);
    const id_data: &[byte] = entry.list_head.value.value.buf[0: entry.list_head.value.value.len];
    try command_executor_resp_append_bulk(buf, id_data);
    try command_executor_resp_append_array_header(buf, entry_len - 1);
    var node: &ListNode = entry.list_head.next;
    while node != null {
        const data: &[byte] = node.value.value.buf[0: node.value.value.len];
        try command_executor_resp_append_bulk(buf, data);
        node = node.next;
    }
}

fn command_executor_xinfo_append_entry_or_null(buf: &Sds, entry: &RedisObject) !void {
    if entry == null {
        try sds_cat(buf, &"*-1\r\n"[0: 5]);
        return;
    }
    try command_executor_stream_append_entry_resp(buf, entry);
}

fn command_executor_keyword_match(pattern: &[byte], value: &[byte]) bool {
    if pattern.len == 0 {
        return value.len == 0;
    }
    if pattern.ptr[0] == 42 as byte {
        if pattern.len == 1 {
            return true;
        }
        var skip: usize = 0;
        while skip <= value.len {
            if command_executor_keyword_match(pattern[1: pattern.len - 1], value[skip: value.len - skip]) {
                return true;
            }
            skip = skip + 1;
        }
        return false;
    }
    if value.len == 0 {
        return false;
    }
    if command_executor_ascii_lower(pattern.ptr[0]) != command_executor_ascii_lower(value.ptr[0]) {
        return false;
    }
    return command_executor_keyword_match(pattern[1: pattern.len - 1], value[1: value.len - 1]);
}

fn command_executor_glob_match(pattern: &[byte], pattern_index: usize, value: &[byte], value_index: usize) bool {
    if pattern_index == pattern.len {
        return value_index == value.len;
    }

    const current: byte = pattern.ptr[pattern_index];
    if current == 42 as byte {
        var next_index: usize = pattern_index;
        while next_index < pattern.len && pattern.ptr[next_index] == 42 as byte {
            next_index = next_index + 1;
        }
        if next_index == pattern.len {
            return true;
        }
        var scan: usize = value_index;
        while scan <= value.len {
            if command_executor_glob_match(pattern, next_index, value, scan) {
                return true;
            }
            if scan == value.len {
                break;
            }
            scan = scan + 1;
        }
        return false;
    }

    if value_index >= value.len {
        return false;
    }

    if current == 63 as byte {
        return command_executor_glob_match(pattern, pattern_index + 1, value, value_index + 1);
    }

    return command_executor_ascii_lower(current) == command_executor_ascii_lower(value.ptr[value_index]) &&
        command_executor_glob_match(pattern, pattern_index + 1, value, value_index + 1);
}

fn command_executor_sort_options_default() SortOptions {
    return SortOptions{
        alpha: false,
        desc: false,
        limit_enabled: false,
        limit_offset: 0,
        limit_count: 0,
        by_pattern: command_executor_empty_slice(),
        by_nosort: false,
        get_patterns: null as &RedisObject,
        get_count: 0,
        store_enabled: false,
        store_destination: command_executor_empty_slice(),
    };
}

fn command_executor_sort_cleanup_options(options: &SortOptions) void {
    if options == null {
        return;
    }
    if options.get_patterns != null {
        object_free(options.get_patterns);
        options.get_patterns = null as &RedisObject;
        options.get_count = 0;
    }
}

fn command_executor_sort_has_store(command: &Command) bool {
    if command == null || command.info.cmd_type != CommandType.command_sort || command.argc < 4 {
        return false;
    }
    var index: usize = 2;
    while index < command.argc {
        const token: &[byte] = command_executor_arg(command, index) catch {
            return false;
        };
        if command_executor_keyword_eq(token, &"STORE"[0: 5]) {
            return index + 1 < command.argc;
        }
        if command_executor_keyword_eq(token, &"LIMIT"[0: 5]) {
            index = index + 3;
        } else if command_executor_keyword_eq(token, &"BY"[0: 2]) || command_executor_keyword_eq(token, &"GET"[0: 3]) {
            index = index + 2;
        } else {
            index = index + 1;
        }
    }
    return false;
}

fn command_executor_sort_parse_options(command: &Command) !SortOptions {
    var options: SortOptions = command_executor_sort_options_default();
    options.get_patterns = create_list_object() catch {
        return error.AllocOutOfMemory;
    };

    var index: usize = 2;
    while index < command.argc {
        const token: &[byte] = command_executor_arg(command, index) catch {
            command_executor_sort_cleanup_options(&options);
            return error.CommandInvalidRequest;
        };
        if command_executor_keyword_eq(token, &"ASC"[0: 3]) {
            options.desc = false;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"DESC"[0: 4]) {
            options.desc = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"ALPHA"[0: 5]) {
            options.alpha = true;
            index = index + 1;
            continue;
        }
        if command_executor_keyword_eq(token, &"LIMIT"[0: 5]) {
            if index + 2 >= command.argc {
                command_executor_sort_cleanup_options(&options);
                return error.CommandInvalidRequest;
            }
            const offset_data: &[byte] = command_executor_arg(command, index + 1) catch {
                command_executor_sort_cleanup_options(&options);
                return error.CommandInvalidRequest;
            };
            const count_data: &[byte] = command_executor_arg(command, index + 2) catch {
                command_executor_sort_cleanup_options(&options);
                return error.CommandInvalidRequest;
            };
            options.limit_offset = command_executor_parse_i64(offset_data) catch |err| {
                command_executor_sort_cleanup_options(&options);
                return err;
            };
            options.limit_count = command_executor_parse_i64(count_data) catch |err| {
                command_executor_sort_cleanup_options(&options);
                return err;
            };
            options.limit_enabled = true;
            index = index + 3;
            continue;
        }
        if command_executor_keyword_eq(token, &"BY"[0: 2]) {
            if index + 1 >= command.argc {
                command_executor_sort_cleanup_options(&options);
                return error.CommandInvalidRequest;
            }
            const pattern: &[byte] = command_executor_arg(command, index + 1) catch {
                command_executor_sort_cleanup_options(&options);
                return error.CommandInvalidRequest;
            };
            options.by_pattern = pattern;
            options.by_nosort = command_executor_keyword_eq(pattern, &"nosort"[0: 6]);
            index = index + 2;
            continue;
        }
        if command_executor_keyword_eq(token, &"GET"[0: 3]) {
            if index + 1 >= command.argc {
                command_executor_sort_cleanup_options(&options);
                return error.CommandInvalidRequest;
            }
            const pattern: &[byte] = command_executor_arg(command, index + 1) catch {
                command_executor_sort_cleanup_options(&options);
                return error.CommandInvalidRequest;
            };
            _ = list_object_push_tail(options.get_patterns, pattern) catch {
                command_executor_sort_cleanup_options(&options);
                return error.AllocOutOfMemory;
            };
            options.get_count = options.get_count + 1;
            index = index + 2;
            continue;
        }
        if command_executor_keyword_eq(token, &"STORE"[0: 5]) {
            if index + 1 >= command.argc {
                command_executor_sort_cleanup_options(&options);
                return error.CommandInvalidRequest;
            }
            const destination: &[byte] = command_executor_arg(command, index + 1) catch {
                command_executor_sort_cleanup_options(&options);
                return error.CommandInvalidRequest;
            };
            options.store_enabled = true;
            options.store_destination = destination;
            index = index + 2;
            continue;
        }
        command_executor_sort_cleanup_options(&options);
        return error.CommandInvalidRequest;
    }

    return options;
}

fn command_executor_sort_pattern_parts(pattern: &[byte]) SortPatternParts {
    var index: usize = 0;
    while index + 1 < pattern.len {
        if pattern.ptr[index] == 45 as byte && pattern.ptr[index + 1] == 62 as byte {
            return SortPatternParts{
                key_pattern: pattern[0: index],
                field_pattern: pattern[(index + 2): pattern.len - (index + 2)],
                has_field: true,
            };
        }
        index = index + 1;
    }
    return SortPatternParts{
        key_pattern: pattern,
        field_pattern: command_executor_empty_slice(),
        has_field: false,
    };
}

fn command_executor_sort_expand_pattern(pattern: &[byte], member: &[byte]) !&RedisObject {
    var has_wildcard: bool = false;
    var scan: usize = 0;
    while scan < pattern.len {
        if pattern.ptr[scan] == 42 as byte {
            has_wildcard = true;
            break;
        }
        scan = scan + 1;
    }
    if !has_wildcard {
        return create_string_object(pattern);
    }

    var key: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&key);
    }

    var start: usize = 0;
    var index: usize = 0;
    while index < pattern.len {
        if pattern.ptr[index] == 42 as byte {
            if index > start {
                _ = sds_cat(&key, pattern[start: index - start]) catch {
                    return error.AllocOutOfMemory;
                };
            }
            _ = sds_cat(&key, member) catch {
                return error.AllocOutOfMemory;
            };
            start = index + 1;
        }
        index = index + 1;
    }
    if start < pattern.len {
        _ = sds_cat(&key, pattern[start: pattern.len - start]) catch {
            return error.AllocOutOfMemory;
        };
    }
    return create_string_object(key.buf[0: key.len]);
}

fn command_executor_sort_lookup_value(engine: &Engine, pattern: &[byte], member: &[byte], now_ms: u64) !SortValueResult {
    if command_executor_slice_eq(pattern, &"#"[0: 1]) {
        return SortValueResult{
            found: true,
            data: member,
        };
    }

    const parts: SortPatternParts = command_executor_sort_pattern_parts(pattern);
    const key_obj: &RedisObject = command_executor_sort_expand_pattern(parts.key_pattern, member) catch |err| {
        return err;
    };
    defer {
        object_free(key_obj);
    }

    const key: &[byte] = key_obj.value.buf[0: key_obj.value.len];
    const value_obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return SortValueResult{
            found: false,
            data: command_executor_empty_slice(),
        };
    };

    if !parts.has_field {
        const data: &[byte] = command_executor_string_value(value_obj) catch {
            return error.CommandWrongType;
        };
        return SortValueResult{
            found: true,
            data: data,
        };
    }

    const field_obj: &RedisObject = hash_object_get_field(value_obj, parts.field_pattern) catch |err| {
        if err == error.ObjectFieldNotFound {
            return SortValueResult{
                found: false,
                data: command_executor_empty_slice(),
            };
        }
        return error.CommandWrongType;
    };
    const field_data: &[byte] = command_executor_string_value(field_obj) catch {
        return error.CommandWrongType;
    };
    return SortValueResult{
        found: true,
        data: field_data,
    };
}

fn command_executor_sort_numeric_error() CommandReply {
    return command_executor_error(&"ERR One or more scores can't be converted into double"[0: 53]);
}

fn command_executor_sort_compare_members(
    engine: &Engine,
    by_pattern: &[byte],
    alpha: bool,
    member_a: &[byte],
    member_b: &[byte],
    now_ms: u64,
) !i32 {
    var value_a: SortValueResult = SortValueResult{ found: true, data: member_a };
    var value_b: SortValueResult = SortValueResult{ found: true, data: member_b };
    if by_pattern.len > 0 && !command_executor_keyword_eq(by_pattern, &"nosort"[0: 6]) {
        value_a = command_executor_sort_lookup_value(engine, by_pattern, member_a, now_ms) catch |err| {
            return err;
        };
        value_b = command_executor_sort_lookup_value(engine, by_pattern, member_b, now_ms) catch |err| {
            return err;
        };
    }

    if alpha {
        var alpha_a: &[byte] = command_executor_empty_slice();
        var alpha_b: &[byte] = command_executor_empty_slice();
        if value_a.found {
            alpha_a = value_a.data;
        }
        if value_b.found {
            alpha_b = value_b.data;
        }
        const cmp_alpha: i32 = bytes_cmp(alpha_a, alpha_b);
        if cmp_alpha != 0 {
            return cmp_alpha;
        }
        return bytes_cmp(member_a, member_b);
    }

    var numeric_a: f64 = 0.0;
    if value_a.found {
        numeric_a = command_executor_parse_f64(value_a.data) catch {
            return error.CommandInvalidFloat;
        };
    }
    var numeric_b: f64 = 0.0;
    if value_b.found {
        numeric_b = command_executor_parse_f64(value_b.data) catch {
            return error.CommandInvalidFloat;
        };
    }
    if numeric_a < numeric_b {
        return -1;
    }
    if numeric_a > numeric_b {
        return 1;
    }
    return bytes_cmp(member_a, member_b);
}

fn command_executor_sort_collect_source(engine: &Engine, key: &[byte], now_ms: u64) !&RedisObject {
    const source_obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return create_list_object();
    };
    if source_obj.obj_type == ObjectType.object_list {
        return object_clone(source_obj);
    }
    if source_obj.obj_type == ObjectType.object_set {
        return command_executor_set_sorted_members(source_obj);
    }
    if source_obj.obj_type == ObjectType.object_zset {
        return zset_object_range_reply(source_obj, 0, -1);
    }
    return error.CommandWrongType;
}

fn command_executor_sort_insert_member(
    engine: &Engine,
    ordered: &RedisObject,
    member: &[byte],
    options: &SortOptions,
    now_ms: u64,
) !void {
    var index: i64 = 0;
    var current: &ListNode = ordered.list_head;
    while current != null {
        const current_member: &[byte] = current.value.value.buf[0: current.value.value.len];
        const cmp: i32 = command_executor_sort_compare_members(engine, options.by_pattern, options.alpha, member, current_member, now_ms) catch |err| {
            return err;
        };
        if (!options.desc && cmp < 0) || (options.desc && cmp > 0) {
            _ = list_object_insert_at(ordered, member, index) catch |err| {
                return err;
            };
            return;
        }
        index = index + 1;
        current = current.next;
    }
    _ = list_object_push_tail(ordered, member) catch |err| {
        return err;
    };
}

fn command_executor_sort_order_members(engine: &Engine, source: &RedisObject, options: &SortOptions, now_ms: u64) !&RedisObject {
    const ordered: &RedisObject = create_list_object() catch {
        return error.AllocOutOfMemory;
    };
    if source.list_len == 0 {
        return ordered;
    }

    if options.by_nosort {
        if options.desc {
            var node_desc: &ListNode = source.list_tail;
            while node_desc != null {
                const member_desc: &[byte] = node_desc.value.value.buf[0: node_desc.value.value.len];
                _ = list_object_push_tail(ordered, member_desc) catch |err| {
                    object_free(ordered);
                    return err;
                };
                node_desc = node_desc.prev;
            }
            return ordered;
        }

        var node_plain: &ListNode = source.list_head;
        while node_plain != null {
            const member_plain: &[byte] = node_plain.value.value.buf[0: node_plain.value.value.len];
            _ = list_object_push_tail(ordered, member_plain) catch |err| {
                object_free(ordered);
                return err;
            };
            node_plain = node_plain.next;
        }
        return ordered;
    }

    var node: &ListNode = source.list_head;
    while node != null {
        const member: &[byte] = node.value.value.buf[0: node.value.value.len];
        _ = command_executor_sort_insert_member(engine, ordered, member, options, now_ms) catch |err| {
            object_free(ordered);
            return err;
        };
        node = node.next;
    }
    return ordered;
}

fn command_executor_sort_emit_window(total: usize, options: &SortOptions) SortEmitWindow {
    var start: i64 = 0;
    var count: usize = total;
    if !options.limit_enabled {
        return SortEmitWindow{
            start: start,
            count: count,
        };
    }

    start = options.limit_offset;
    if start < 0 {
        start = 0;
    }
    if start >= total as i64 {
        return SortEmitWindow{
            start: start,
            count: 0,
        };
    }
    if options.limit_count < 0 {
        return SortEmitWindow{
            start: start,
            count: total - (start as usize),
        };
    }
    count = options.limit_count as usize;
    if count > total - (start as usize) {
        count = total - (start as usize);
    }
    return SortEmitWindow{
        start: start,
        count: count,
    };
}

fn command_executor_growth_write_command(command: &Command) bool {
    const cmd_type: CommandType = command.info.cmd_type;
    if cmd_type == CommandType.command_set {
        return command.argc == 3;
    }
    if cmd_type == CommandType.command_getset || cmd_type == CommandType.command_setnx {
        return command.argc == 3;
    }
    if cmd_type == CommandType.command_setex || cmd_type == CommandType.command_psetex {
        return command.argc == 4;
    }
    if cmd_type == CommandType.command_mset || cmd_type == CommandType.command_msetnx {
        return command.argc >= 3;
    }
    if cmd_type == CommandType.command_hincrby || cmd_type == CommandType.command_hincrbyfloat {
        return command.argc == 4;
    }
    if cmd_type == CommandType.command_setrange {
        return command.argc == 4;
    }
    if cmd_type == CommandType.command_incrbyfloat {
        return command.argc == 3;
    }
    if cmd_type == CommandType.command_lpush {
        return command.argc >= 3;
    }
    if cmd_type == CommandType.command_sadd {
        return command.argc >= 3;
    }
    if cmd_type == CommandType.command_zadd {
        return command.argc >= 4;
    }
    if cmd_type == CommandType.command_hset || cmd_type == CommandType.command_hsetnx {
        return command.argc == 4;
    }
    if cmd_type == CommandType.command_expire || cmd_type == CommandType.command_pexpireat {
        return command.argc == 3;
    }
    if cmd_type == CommandType.command_sort {
        return command_executor_sort_has_store(command);
    }
    if cmd_type == CommandType.command_copy {
        return command.argc >= 3;
    }
    return false;
}

fn command_executor_memory_fits(maxmemory: usize, growth: usize) bool {
    if maxmemory == 0 {
        return true;
    }
    const current: usize = used_memory();
    if current >= maxmemory {
        return false;
    }
    return growth <= maxmemory - current;
}

fn command_executor_write_is_noop(engine: &Engine, command: &Command, now_ms: u64) bool {
    if command.info.cmd_type == CommandType.command_setnx {
        const key: &[byte] = command_executor_arg(command, 1) catch {
            return false;
        };
        return command_executor_key_exists(engine, key, now_ms);
    }
    if command.info.cmd_type == CommandType.command_msetnx {
        var index: usize = 1;
        while index < command.argc {
            const key: &[byte] = command_executor_arg(command, index) catch {
                return false;
            };
            if command_executor_key_exists(engine, key, now_ms) {
                return true;
            }
            index = index + 2;
        }
    }
    if command.info.cmd_type == CommandType.command_copy {
        const source: &[byte] = command_executor_arg(command, 1) catch {
            return false;
        };
        const target: &[byte] = command_executor_arg(command, 2) catch {
            return false;
        };
        if command_executor_slice_eq(source, target) {
            return true;
        }
        _ = lookup_key_no_touch_at(engine, source, now_ms) catch {
            return true;
        };
        var replace: bool = false;
        var index: usize = 3;
        while index < command.argc {
            const option: &[byte] = command_executor_arg(command, index) catch {
                return false;
            };
            if command_executor_keyword_eq(option, &"REPLACE"[0: 7]) {
                replace = true;
                index = index + 1;
                continue;
            }
            if command_executor_keyword_eq(option, &"DB"[0: 2]) {
                if index + 1 >= command.argc {
                    return true;
                }
                const db_index: i64 = command_executor_parse_i64(command_executor_arg(command, index + 1) catch {
                    return true;
                }) catch {
                    return true;
                };
                if db_index != 0 {
                    return true;
                }
                index = index + 2;
                continue;
            }
            return true;
        }
        if !replace && command_executor_key_exists(engine, target, now_ms) {
            return true;
        }
    }
    return false;
}

fn command_executor_estimate_copy_growth(engine: &Engine, command: &Command, now_ms: u64) usize {
    const source: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_estimate_request_growth(command);
    };
    const target: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_estimate_request_growth(command);
    };
    const obj: &RedisObject = lookup_key_no_touch_at(engine, source, now_ms) catch {
        return command_executor_estimate_request_growth(command);
    };
    return 512usize + command_executor_estimate_sds_allocation(target.len) + command_executor_memory_object_usage(obj);
}

fn command_executor_prepare_maxmemory(engine: &Engine, runtime: &CommandRuntimeInfo, command: &Command, now_ms: u64) bool {
    if runtime.config.maxmemory == 0 {
        return true;
    }
    if !command_executor_growth_write_command(command) {
        return true;
    }
    if command_executor_write_is_noop(engine, command, now_ms) {
        return true;
    }

    var estimated: usize = command_executor_estimate_request_growth(command);
    if command.info.cmd_type == CommandType.command_copy {
        estimated = command_executor_estimate_copy_growth(engine, command, now_ms);
    }
    if command_executor_memory_fits(runtime.config.maxmemory, estimated) {
        return true;
    }
    if runtime.config.maxmemory_policy == MaxmemoryPolicy.maxmemory_allkeys_lru {
        _ = engine_evict_allkeys_lru(engine, runtime.config.maxmemory, estimated, now_ms);
        return command_executor_memory_fits(runtime.config.maxmemory, estimated);
    }
    if runtime.config.maxmemory_policy == MaxmemoryPolicy.maxmemory_allkeys_lfu {
        _ = engine_evict_allkeys_lfu(engine, runtime.config.maxmemory, estimated, now_ms);
        return command_executor_memory_fits(runtime.config.maxmemory, estimated);
    }
    if runtime.config.maxmemory_policy == MaxmemoryPolicy.maxmemory_volatile_lru {
        _ = engine_evict_volatile_lru(engine, runtime.config.maxmemory, estimated, now_ms);
        return command_executor_memory_fits(runtime.config.maxmemory, estimated);
    }
    if runtime.config.maxmemory_policy == MaxmemoryPolicy.maxmemory_volatile_lfu {
        _ = engine_evict_volatile_lfu(engine, runtime.config.maxmemory, estimated, now_ms);
        return command_executor_memory_fits(runtime.config.maxmemory, estimated);
    }
    if runtime.config.maxmemory_policy == MaxmemoryPolicy.maxmemory_volatile_ttl {
        _ = engine_evict_volatile_ttl(engine, runtime.config.maxmemory, estimated, now_ms);
        return command_executor_memory_fits(runtime.config.maxmemory, estimated);
    }
    return false;
}

fn command_executor_estimate_sds_allocation(len: usize) usize {
    if len < 16 {
        return 17;
    }
    return len + 1;
}

fn command_executor_estimate_request_growth(command: &Command) usize {
    var estimated: usize = 512;
    var index: usize = 1;
    while index < command.argc {
        const arg: &[byte] = command_executor_arg(command, index) catch {
            return estimated;
        };
        estimated = estimated + command_executor_estimate_sds_allocation(arg.len);
        index = index + 1;
    }
    return estimated;
}

fn command_executor_slice_eq(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if a.ptr[i] != b.ptr[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn command_executor_cstring_slice(data: &[byte]) &[byte] {
    var len: usize = 0;
    while len < data.len && data.ptr[len] != 0 as byte {
        len = len + 1;
    }
    return data[0: len];
}

fn command_executor_owned_bulk(obj: &RedisObject) CommandReply {
    var reply: CommandReply = command_executor_bulk(obj.value.buf[0: obj.value.len]);
    reply.owned_object = obj;
    return reply;
}

fn command_executor_owned_bulk_copy(data: &[byte]) CommandReply {
    const obj: &RedisObject = create_string_object(data) catch {
        return command_executor_oom();
    };
    return command_executor_owned_bulk(obj);
}

fn command_executor_owned_raw(data: &[byte]) CommandReply {
    const obj: &RedisObject = create_string_object(data) catch {
        return command_executor_oom();
    };
    var reply: CommandReply = command_executor_reply(CommandReplyType.reply_raw_bytes, obj.value.buf[0: obj.value.len], 0);
    reply.owned_object = obj;
    return reply;
}

fn command_executor_owned_error(data: &[byte]) CommandReply {
    const obj: &RedisObject = create_string_object(data) catch {
        return command_executor_oom();
    };
    var reply: CommandReply = command_executor_error(obj.value.buf[0: obj.value.len]);
    reply.owned_object = obj;
    return reply;
}

fn command_executor_owned_array(obj: &RedisObject) CommandReply {
    const count: usize = list_object_len(obj) catch {
        return command_executor_error(&"ERR reply encode failed"[0: 23]);
    };
    var reply: CommandReply = command_executor_array_bulk(obj.list_head, count);
    reply.owned_object = obj;
    return reply;
}

fn command_executor_info_append(buf: &Sds, data: &[byte]) !void {
    try sds_cat(buf, data);
}

fn command_executor_info_append_bytes(buf: &Sds, fmt: &[byte], value: &[byte]) !void {
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_bytes(value);
    try sds_cat_fmt(buf, fmt, args[0: 1]);
}

fn command_executor_info_append_i64(buf: &Sds, fmt: &[byte], value: i64) !void {
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_i64(value);
    try sds_cat_fmt(buf, fmt, args[0: 1]);
}

fn command_executor_info_append_u64(buf: &Sds, fmt: &[byte], value: u64) !void {
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_u64(value);
    try sds_cat_fmt(buf, fmt, args[0: 1]);
}

fn command_executor_info_append_two_u64(buf: &Sds, fmt: &[byte], first: u64, second: u64) !void {
    var args: [SdsFmtArg: 2] = [];
    args[0] = sds_fmt_u64(first);
    args[1] = sds_fmt_u64(second);
    try sds_cat_fmt(buf, fmt, args[0: 2]);
}

fn command_executor_info_emit_section(requested: &[byte], name: &[byte]) bool {
    if requested.len == 0 {
        return true;
    }
    if command_executor_keyword_eq(requested, &"all"[0: 3]) || command_executor_keyword_eq(requested, &"default"[0: 7]) {
        return true;
    }
    return command_executor_keyword_eq(requested, name);
}

fn command_executor_config_replicaof_value(runtime: &CommandRuntimeInfo, out: &Sds) !void {
    const host: &[byte] = command_executor_cstring_slice(runtime.config.replicaof_host[0: 64]);
    if host.len == 0 || runtime.config.replicaof_port <= 0 {
        try sds_cat(out, &"no one"[0: 6]);
        return;
    }
    var host_args: [SdsFmtArg: 2] = [];
    host_args[0] = sds_fmt_bytes(host);
    host_args[1] = sds_fmt_i64(runtime.config.replicaof_port as i64);
    try sds_cat_fmt(out, &"%s %i"[0: 5], host_args[0: 2]);
}

fn command_executor_config_append_pair(reply: &RedisObject, key: &[byte], value: &[byte]) !void {
    _ = try list_object_push_tail(reply, key);
    _ = try list_object_push_tail(reply, value);
}

fn command_executor_config_append_i64(reply: &RedisObject, key: &[byte], value: i64) !void {
    var tmp: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&tmp);
    }
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_i64(value);
    try sds_cat_fmt(&tmp, &"%i"[0: 2], args[0: 1]);
    try command_executor_config_append_pair(reply, key, tmp.buf[0: tmp.len]);
}

fn command_executor_config_append_u64(reply: &RedisObject, key: &[byte], value: u64) !void {
    var tmp: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&tmp);
    }
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_u64(value);
    try sds_cat_fmt(&tmp, &"%u"[0: 2], args[0: 1]);
    try command_executor_config_append_pair(reply, key, tmp.buf[0: tmp.len]);
}

fn command_executor_config_append_save(reply: &RedisObject, seconds: i32, changes: i32) !void {
    var tmp: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&tmp);
    }
    var args: [SdsFmtArg: 2] = [];
    args[0] = sds_fmt_i64(seconds as i64);
    args[1] = sds_fmt_i64(changes as i64);
    try sds_cat_fmt(&tmp, &"%i %i"[0: 5], args[0: 2]);
    try command_executor_config_append_pair(reply, &"save"[0: 4], tmp.buf[0: tmp.len]);
}

fn command_executor_config_append_replicaof(reply: &RedisObject, runtime: &CommandRuntimeInfo) !void {
    var tmp: Sds = sds_empty() catch {
        return error.AllocOutOfMemory;
    };
    defer {
        sds_free(&tmp);
    }
    try command_executor_config_replicaof_value(runtime, &tmp);
    try command_executor_config_append_pair(reply, &"replicaof"[0: 9], tmp.buf[0: tmp.len]);
}

fn command_executor_config_help() CommandReply {
    const reply_list: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    _ = list_object_push_tail(reply_list, &"CONFIG GET <pattern>"[0: 20]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    _ = list_object_push_tail(reply_list, &"CONFIG SET <parameter> <value> [<parameter> <value> ...]"[0: 56]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    _ = list_object_push_tail(reply_list, &"CONFIG REWRITE"[0: 14]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    _ = list_object_push_tail(reply_list, &"CONFIG RESETSTAT"[0: 16]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    _ = list_object_push_tail(reply_list, &"CONFIG HELP"[0: 11]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    return command_executor_owned_array(reply_list);
}

fn command_executor_owned_simple(data: &[byte]) CommandReply {
    const obj: &RedisObject = create_string_object(data) catch {
        return command_executor_oom();
    };
    var reply: CommandReply = command_executor_simple(obj.value.buf[0: obj.value.len]);
    reply.owned_object = obj;
    return reply;
}

fn command_executor_string_value(obj: &RedisObject) !&[byte] {
    if obj == null || obj.obj_type != ObjectType.object_string {
        return error.CommandWrongType;
    }
    return obj.value.buf[0: obj.value.len];
}

const COMMAND_EXECUTOR_I64_MAX: i64 = 9223372036854775807;
const COMMAND_EXECUTOR_I64_MIN: i64 = -9223372036854775807 - 1;

fn command_executor_add_i64_checked(base: i64, delta: i64) !i64 {
    if delta > 0 && base > COMMAND_EXECUTOR_I64_MAX - delta {
        return error.CommandInvalidInteger;
    }
    if delta < 0 && base < COMMAND_EXECUTOR_I64_MIN - delta {
        return error.CommandInvalidInteger;
    }
    return base + delta;
}

fn command_executor_set_integer_string(engine: &Engine, key: &[byte], value: i64, now_ms: u64) CommandReply {
    var buf: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&buf);
    }
    var args: [SdsFmtArg: 1] = [];
    args[0] = sds_fmt_i64(value);
    _ = sds_cat_fmt(&buf, &"%i"[0: 2], args[0: 1]) catch {
        return command_executor_oom();
    };
    const obj: &RedisObject = create_string_object(buf.buf[0: buf.len]) catch {
        return command_executor_oom();
    };
    _ = set_key_at(engine, key, obj, now_ms) catch {
        object_free(obj);
        return command_executor_oom();
    };
    return command_executor_integer(value);
}

fn command_executor_string_counter_apply(engine: &Engine, key: &[byte], delta: i64, now_ms: u64) CommandReply {
    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_set_integer_string(engine, key, delta, now_ms);
    };
    const data: &[byte] = command_executor_string_value(existing) catch {
        return command_executor_wrongtype();
    };
    const current: i64 = command_executor_parse_i64(data) catch {
        return command_executor_invalid_integer();
    };
    const next: i64 = command_executor_add_i64_checked(current, delta) catch {
        return command_executor_invalid_integer();
    };
    return command_executor_set_integer_string(engine, key, next, now_ms);
}

fn command_executor_store_string(engine: &Engine, key: &[byte], value: &[byte], now_ms: u64) CommandReply {
    const obj: &RedisObject = create_string_object(value) catch {
        return command_executor_oom();
    };
    _ = set_key_at(engine, key, obj, now_ms) catch {
        object_free(obj);
        return command_executor_oom();
    };
    _ = clear_key_expire(engine, key);
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_replace_string_preserve_ttl(engine: &Engine, key: &[byte], value: &[byte], now_ms: u64) CommandReply {
    const obj: &RedisObject = create_string_object(value) catch {
        return command_executor_oom();
    };
    _ = set_key_at(engine, key, obj, now_ms) catch {
        object_free(obj);
        return command_executor_oom();
    };
    return command_executor_simple(&"OK"[0: 2]);
}

struct CommandExecutorIndexRange {
    ok: bool,
    start: usize,
    stop: usize,
}

struct CommandExecutorBitfieldEncoding {
    is_signed: bool,
    width: usize,
}

enum CommandExecutorBitfieldOverflowMode {
    overflow_wrap,
    overflow_sat,
    overflow_fail,
}

const COMMAND_EXECUTOR_GEO_SCALE: f64 = 1000000.0;
const COMMAND_EXECUTOR_GEO_MAX_LON: f64 = 180.0;
const COMMAND_EXECUTOR_GEO_MIN_LON: f64 = -180.0;
const COMMAND_EXECUTOR_GEO_MAX_LAT: f64 = 85.05112878;
const COMMAND_EXECUTOR_GEO_MIN_LAT: f64 = -85.05112878;
const COMMAND_EXECUTOR_GEO_DEG_TO_RAD: f64 = 0.01745329251994329577;
const COMMAND_EXECUTOR_GEO_EARTH_RADIUS_M: f64 = 6372797.560856;
const COMMAND_EXECUTOR_GEO_METERS_PER_DEGREE: f64 = 111320.0;
const COMMAND_EXECUTOR_GEOHASH_LEN: usize = 11;

struct CommandExecutorGeoPoint {
    lon: f64,
    lat: f64,
    packed: i64,
}

enum CommandExecutorGeoOrder {
    geo_order_none,
    geo_order_asc,
    geo_order_desc,
}

struct CommandExecutorGeoSearchOptions {
    from_member: bool,
    center_member: &[byte],
    center_lon: f64,
    center_lat: f64,
    by_radius: bool,
    radius_m: f64,
    box_width_m: f64,
    box_height_m: f64,
    unit_scale: f64,
    order: CommandExecutorGeoOrder,
    has_count: bool,
    count_limit: usize,
    any: bool,
    withcoord: bool,
    withdist: bool,
    withhash: bool,
    storedist: bool,
}

fn command_executor_normalize_index_range(total_len: usize, start: i64, stop: i64) CommandExecutorIndexRange {
    if total_len == 0 {
        return CommandExecutorIndexRange{ ok: false, start: 0, stop: 0 };
    }

    const len_i64: i64 = total_len as i64;
    var start_index: i64 = start;
    var stop_index: i64 = stop;
    if start_index < 0 {
        start_index = len_i64 + start_index;
    }
    if stop_index < 0 {
        stop_index = len_i64 + stop_index;
    }
    if start_index < 0 {
        start_index = 0;
    }
    if stop_index < 0 || start_index >= len_i64 || start_index > stop_index {
        return CommandExecutorIndexRange{ ok: false, start: 0, stop: 0 };
    }
    if stop_index >= len_i64 {
        stop_index = len_i64 - 1;
    }
    return CommandExecutorIndexRange{
        ok: true,
        start: start_index as usize,
        stop: stop_index as usize,
    };
}

fn command_executor_bit_mask(bit_index: usize) u32 {
    return 128u32 >> (bit_index as i32);
}

fn command_executor_popcount_byte(value: byte) i64 {
    var bits: u32 = value as u32;
    var count: i64 = 0;
    while bits != 0u32 {
        count = count + ((bits & 1u32) as i64);
        bits = bits >> 1;
    }
    return count;
}

fn command_executor_string_bit_get(data: &[byte], bit_offset: usize) i64 {
    const byte_index: usize = bit_offset / (8 as usize);
    if byte_index >= data.len {
        return 0;
    }
    const mask: u32 = command_executor_bit_mask(bit_offset % (8 as usize));
    if ((data.ptr[byte_index] as u32) & mask) != 0u32 {
        return 1;
    }
    return 0;
}

fn command_executor_bitcount_bits_in_byte(value: byte, start_bit: usize, stop_bit: usize) i64 {
    var count: i64 = 0;
    var bit_index: usize = start_bit;
    while bit_index <= stop_bit {
        if ((value as u32) & command_executor_bit_mask(bit_index)) != 0u32 {
            count = count + 1;
        }
        bit_index = bit_index + 1;
    }
    return count;
}

fn command_executor_bitcount_range_bits(data: &[byte], start_bit: usize, stop_bit: usize) i64 {
    const start_byte: usize = start_bit / (8 as usize);
    const stop_byte: usize = stop_bit / (8 as usize);
    const start_offset: usize = start_bit % (8 as usize);
    const stop_offset: usize = stop_bit % (8 as usize);

    if start_byte == stop_byte {
        return command_executor_bitcount_bits_in_byte(data.ptr[start_byte], start_offset, stop_offset);
    }

    var count: i64 = command_executor_bitcount_bits_in_byte(data.ptr[start_byte], start_offset, 7);
    var byte_index: usize = start_byte + 1;
    while byte_index < stop_byte {
        count = count + command_executor_popcount_byte(data.ptr[byte_index]);
        byte_index = byte_index + 1;
    }
    count = count + command_executor_bitcount_bits_in_byte(data.ptr[stop_byte], 0, stop_offset);
    return count;
}

fn command_executor_bitpos_bits_in_byte(value: byte, target_bit: i64, start_bit: usize, stop_bit: usize) i64 {
    var bit_index: usize = start_bit;
    while bit_index <= stop_bit {
        var current_bit: i64 = 0;
        if ((value as u32) & command_executor_bit_mask(bit_index)) != 0u32 {
            current_bit = 1;
        }
        if current_bit == target_bit {
            return bit_index as i64;
        }
        bit_index = bit_index + 1;
    }
    return -1;
}

fn command_executor_bitpos_range_bits(data: &[byte], target_bit: i64, start_bit: usize, stop_bit: usize) i64 {
    const start_byte: usize = start_bit / (8 as usize);
    const stop_byte: usize = stop_bit / (8 as usize);
    const start_offset: usize = start_bit % (8 as usize);
    const stop_offset: usize = stop_bit % (8 as usize);

    var byte_index: usize = start_byte;
    while byte_index <= stop_byte {
        var bit_start: usize = 0;
        if byte_index == start_byte {
            bit_start = start_offset;
        }
        var bit_stop: usize = 7;
        if byte_index == stop_byte {
            bit_stop = stop_offset;
        }
        const found_bit: i64 = command_executor_bitpos_bits_in_byte(data.ptr[byte_index], target_bit, bit_start, bit_stop);
        if found_bit >= 0 {
            return (byte_index * 8 + found_bit as usize) as i64;
        }
        byte_index = byte_index + 1;
    }
    return -1;
}

fn command_executor_bitpos_byte_mode(data: &[byte], target_bit: i64, start: i64, has_end: bool, end: i64) i64 {
    var stop: i64 = -1;
    if has_end {
        stop = end;
    }
    const range: CommandExecutorIndexRange = command_executor_normalize_index_range(data.len, start, stop);
    if !range.ok {
        return -1;
    }
    const found: i64 = command_executor_bitpos_range_bits(data, target_bit, range.start * 8, range.stop * 8 + 7);
    if found >= 0 {
        return found;
    }
    if target_bit == 0 && !has_end {
        return (data.len * 8) as i64;
    }
    return -1;
}

fn command_executor_bitpos_bit_mode(data: &[byte], target_bit: i64, start: i64, end: i64) i64 {
    const total_bits: usize = data.len * 8;
    const range: CommandExecutorIndexRange = command_executor_normalize_index_range(total_bits, start, end);
    if !range.ok {
        return -1;
    }
    return command_executor_bitpos_range_bits(data, target_bit, range.start, range.stop);
}

fn command_executor_string_value_or_empty(engine: &Engine, key: &[byte], now_ms: u64) !&[byte] {
    const obj: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    if obj == null {
        return command_executor_empty_slice();
    }
    return command_executor_string_value(obj);
}

fn command_executor_geo_scale_coord(value: f64) i64 {
    const scaled: f64 = value * COMMAND_EXECUTOR_GEO_SCALE;
    if scaled >= 0.0 {
        return (scaled + 0.5) as i64;
    }
    return (scaled - 0.5) as i64;
}

fn command_executor_geo_validate_lonlat(lon: f64, lat: f64) bool {
    return lon >= COMMAND_EXECUTOR_GEO_MIN_LON &&
        lon <= COMMAND_EXECUTOR_GEO_MAX_LON &&
        lat >= COMMAND_EXECUTOR_GEO_MIN_LAT &&
        lat <= COMMAND_EXECUTOR_GEO_MAX_LAT;
}

fn command_executor_geo_pack(lon: f64, lat: f64) i64 {
    const lon_i64: i64 = command_executor_geo_scale_coord(lon);
    const lat_i64: i64 = command_executor_geo_scale_coord(lat);
    const lon_u64: u64 = (lon_i64 as u64) & (0xFFFFFFFF as u64);
    const lat_u64: u64 = (lat_i64 as u64) & (0xFFFFFFFF as u64);
    const packed: u64 = (lon_u64 << 32) | lat_u64;
    return packed as i64;
}

fn command_executor_geo_unpack_component(value: u64) i64 {
    if value >= (0x80000000 as u64) {
        return value as i64 - 4294967296;
    }
    return value as i64;
}

fn command_executor_geo_unpack(score: i64) CommandExecutorGeoPoint {
    const packed_u64: u64 = score as u64;
    const lon_raw: u64 = (packed_u64 >> 32) & (0xFFFFFFFF as u64);
    const lat_raw: u64 = packed_u64 & (0xFFFFFFFF as u64);
    const lon_i64: i64 = command_executor_geo_unpack_component(lon_raw);
    const lat_i64: i64 = command_executor_geo_unpack_component(lat_raw);
    return CommandExecutorGeoPoint{
        lon: (lon_i64 as f64) / COMMAND_EXECUTOR_GEO_SCALE,
        lat: (lat_i64 as f64) / COMMAND_EXECUTOR_GEO_SCALE,
        packed: score,
    };
}

fn command_executor_geo_distance_meters(a: &CommandExecutorGeoPoint, b: &CommandExecutorGeoPoint) f64 {
    const lat1_rad: f64 = a.lat * COMMAND_EXECUTOR_GEO_DEG_TO_RAD;
    const lat2_rad: f64 = b.lat * COMMAND_EXECUTOR_GEO_DEG_TO_RAD;
    const dlat: f64 = (b.lat - a.lat) * COMMAND_EXECUTOR_GEO_DEG_TO_RAD;
    const dlon: f64 = (b.lon - a.lon) * COMMAND_EXECUTOR_GEO_DEG_TO_RAD;
    const sin_dlat: f64 = sin(dlat / 2.0);
    const sin_dlon: f64 = sin(dlon / 2.0);
    var h: f64 = sin_dlat * sin_dlat + cos(lat1_rad) * cos(lat2_rad) * sin_dlon * sin_dlon;
    if h > 1.0 {
        h = 1.0;
    }
    return 2.0 * COMMAND_EXECUTOR_GEO_EARTH_RADIUS_M * asin(sqrt(h));
}

fn command_executor_geo_unit_scale(unit: &[byte]) !f64 {
    if command_executor_keyword_eq(unit, &"M"[0: 1]) {
        return 1.0;
    }
    if command_executor_keyword_eq(unit, &"KM"[0: 2]) {
        return 1000.0;
    }
    if command_executor_keyword_eq(unit, &"FT"[0: 2]) {
        return 0.3048;
    }
    if command_executor_keyword_eq(unit, &"MI"[0: 2]) {
        return 1609.34;
    }
    return error.CommandInvalidFloat;
}

fn command_executor_geo_format_bulk(value: f64, fmt: &[byte]) CommandReply {
    var buf: [byte: 128] = [];
    const written: i32 = snprintf(&buf[0] as *byte, 128usize, fmt.ptr as *byte, value);
    if written <= 0 {
        return command_executor_oom();
    }
    return command_executor_owned_bulk_copy(buf[0: written as usize]);
}

fn command_executor_geo_append_formatted_bulk(buf: &Sds, value: f64, fmt: &[byte]) !void {
    var tmp: [byte: 128] = [];
    const written: i32 = snprintf(&tmp[0] as *byte, 128usize, fmt.ptr as *byte, value);
    if written <= 0 {
        return error.AllocOutOfMemory;
    }
    try command_executor_command_append_bulk(buf, tmp[0: written as usize]);
}

fn command_executor_geo_append_geohash(buf: &Sds, point: &CommandExecutorGeoPoint) !void {
    const alphabet: &[byte] = &"0123456789bcdefghjkmnpqrstuvwxyz"[0: 32];
    var hash: [byte: COMMAND_EXECUTOR_GEOHASH_LEN] = [];
    var lon_min: f64 = -180.0;
    var lon_max: f64 = 180.0;
    var lat_min: f64 = -90.0;
    var lat_max: f64 = 90.0;
    var lon: f64 = point.lon;
    if lon >= 180.0 {
        lon = -180.0;
    }
    var bit_index: usize = 0;
    var out_index: usize = 0;
    while out_index < 10 {
        var value: usize = 0;
        var bit: usize = 0;
        while bit < 5 {
            value = value << 1;
            if (bit_index % 2usize) == 0usize {
                const mid_lon: f64 = (lon_min + lon_max) / 2.0;
                if lon >= mid_lon {
                    value = value | 1usize;
                    lon_min = mid_lon;
                } else {
                    lon_max = mid_lon;
                }
            } else {
                const mid_lat: f64 = (lat_min + lat_max) / 2.0;
                if point.lat >= mid_lat {
                    value = value | 1usize;
                    lat_min = mid_lat;
                } else {
                    lat_max = mid_lat;
                }
            }
            bit = bit + 1;
            bit_index = bit_index + 1;
        }
        hash[out_index] = alphabet.ptr[value];
        out_index = out_index + 1;
    }
    hash[10] = 48 as byte;
    try command_executor_command_append_bulk(buf, hash[0: COMMAND_EXECUTOR_GEOHASH_LEN]);
}

fn command_executor_geo_decode_member(obj: &RedisObject, member: &[byte]) !CommandExecutorGeoPoint {
    const score: i64 = try zset_object_get_score(obj, member);
    return command_executor_geo_unpack(score);
}

fn command_executor_geo_search_defaults() CommandExecutorGeoSearchOptions {
    return CommandExecutorGeoSearchOptions{
        from_member: false,
        center_member: command_executor_empty_slice(),
        center_lon: 0.0,
        center_lat: 0.0,
        by_radius: false,
        radius_m: 0.0,
        box_width_m: 0.0,
        box_height_m: 0.0,
        unit_scale: 1.0,
        order: CommandExecutorGeoOrder.geo_order_none,
        has_count: false,
        count_limit: 0,
        any: false,
        withcoord: false,
        withdist: false,
        withhash: false,
        storedist: false,
    };
}

fn command_executor_geo_append_search_item(
    buf: &Sds,
    member: &[byte],
    point: &CommandExecutorGeoPoint,
    distance_m: f64,
    options: &CommandExecutorGeoSearchOptions,
) !void {
    var nested_count: usize = 1;
    if options.withdist {
        nested_count = nested_count + 1;
    }
    if options.withhash {
        nested_count = nested_count + 1;
    }
    if options.withcoord {
        nested_count = nested_count + 1;
    }

    if nested_count == 1 {
        try command_executor_command_append_bulk(buf, member);
        return;
    }

    try command_executor_resp_collection_prefix(buf, &"*"[0: 1], nested_count);
    try command_executor_command_append_bulk(buf, member);
    if options.withdist {
        try command_executor_geo_append_formatted_bulk(buf, distance_m / options.unit_scale, &"%.4f"[0: 4]);
    }
    if options.withhash {
        try command_executor_info_append_i64(buf, &":%i\r\n"[0: 5], point.packed);
    }
    if options.withcoord {
        try command_executor_resp_collection_prefix(buf, &"*"[0: 1], 2);
        try command_executor_geo_append_formatted_bulk(buf, point.lon, &"%.6f"[0: 4]);
        try command_executor_geo_append_formatted_bulk(buf, point.lat, &"%.6f"[0: 4]);
    }
}

fn command_executor_bitfield_mask(width: usize) u64 {
    if width >= 64 {
        return 0xFFFFFFFFFFFFFFFF as u64;
    }
    return (1u64 << (width as i32)) - 1u64;
}

fn command_executor_bitfield_parse_encoding(data: &[byte]) !CommandExecutorBitfieldEncoding {
    if data.len < 2 {
        return error.CommandInvalidInteger;
    }
    const head: byte = data.ptr[0];
    var is_signed: bool = false;
    if head == 'i' as byte || head == 'I' as byte {
        is_signed = true;
    } else if head == 'u' as byte || head == 'U' as byte {
        is_signed = false;
    } else {
        return error.CommandInvalidInteger;
    }

    const width_i64: i64 = command_executor_parse_i64(data[1: data.len - 1]) catch {
        return error.CommandInvalidInteger;
    };
    if is_signed {
        if width_i64 <= 0 || width_i64 > 64 {
            return error.CommandInvalidInteger;
        }
    } else {
        if width_i64 <= 0 || width_i64 > 63 {
            return error.CommandInvalidInteger;
        }
    }
    return CommandExecutorBitfieldEncoding{
        is_signed: is_signed,
        width: width_i64 as usize,
    };
}

fn command_executor_bitfield_parse_offset(data: &[byte], width: usize) !usize {
    if data.len == 0 {
        return error.CommandInvalidInteger;
    }
    var offset_value: i64 = 0;
    if data.ptr[0] == '#' as byte {
        if data.len == 1 {
            return error.CommandInvalidInteger;
        }
        offset_value = command_executor_parse_i64(data[1: data.len - 1]) catch {
            return error.CommandInvalidInteger;
        };
        if offset_value < 0 {
            return error.CommandInvalidInteger;
        }
        return (offset_value as usize) * width;
    }
    offset_value = command_executor_parse_i64(data) catch {
        return error.CommandInvalidInteger;
    };
    if offset_value < 0 {
        return error.CommandInvalidInteger;
    }
    return offset_value as usize;
}

fn command_executor_bitfield_read_raw(data: &[byte], offset: usize, width: usize) u64 {
    var raw: u64 = 0u64;
    var bit_index: usize = 0;
    while bit_index < width {
        raw = raw << 1;
        if command_executor_string_bit_get(data, offset + bit_index) != 0 {
            raw = raw | 1u64;
        }
        bit_index = bit_index + 1;
    }
    return raw;
}

fn command_executor_bitfield_decode_value(raw: u64, encoding: &CommandExecutorBitfieldEncoding) i64 {
    if !encoding.is_signed {
        return raw as i64;
    }
    if encoding.width >= 64 {
        return raw as i64;
    }
    const shift: i32 = (64 - encoding.width) as i32;
    return ((raw << shift) as i64) >> shift;
}

fn command_executor_bitfield_min_value(encoding: &CommandExecutorBitfieldEncoding) i64 {
    if !encoding.is_signed {
        return 0;
    }
    if encoding.width >= 64 {
        return COMMAND_EXECUTOR_I64_MIN;
    }
    return 0 - ((1u64 << ((encoding.width - 1) as i32)) as i64);
}

fn command_executor_bitfield_max_value(encoding: &CommandExecutorBitfieldEncoding) i64 {
    if !encoding.is_signed {
        return command_executor_bitfield_mask(encoding.width) as i64;
    }
    if encoding.width >= 64 {
        return COMMAND_EXECUTOR_I64_MAX;
    }
    return ((1u64 << ((encoding.width - 1) as i32)) - 1u64) as i64;
}

fn command_executor_bitfield_in_range(encoding: &CommandExecutorBitfieldEncoding, value: i64) bool {
    if !encoding.is_signed && value < 0 {
        return false;
    }
    return value >= command_executor_bitfield_min_value(encoding) &&
        value <= command_executor_bitfield_max_value(encoding);
}

fn command_executor_bitfield_encode_value(encoding: &CommandExecutorBitfieldEncoding, value: i64) u64 {
    if encoding.width >= 64 {
        return value as u64;
    }
    return (value as u64) & command_executor_bitfield_mask(encoding.width);
}

fn command_executor_bitfield_add_overflow(current: i64, increment: i64) bool {
    if increment > 0 {
        return current > COMMAND_EXECUTOR_I64_MAX - increment;
    }
    if increment < 0 {
        return current < COMMAND_EXECUTOR_I64_MIN - increment;
    }
    return false;
}

fn command_executor_bitfield_incrby_overflow(
    current: i64,
    increment: i64,
    encoding: &CommandExecutorBitfieldEncoding,
) bool {
    if command_executor_bitfield_add_overflow(current, increment) {
        return true;
    }
    const next: i64 = current + increment;
    return !command_executor_bitfield_in_range(encoding, next);
}

fn command_executor_bitfield_wrap_add(
    current_raw: u64,
    increment: i64,
    encoding: &CommandExecutorBitfieldEncoding,
) u64 {
    var next_raw: u64 = current_raw + command_executor_bitfield_encode_value(encoding, increment);
    if encoding.width < 64 {
        next_raw = next_raw & command_executor_bitfield_mask(encoding.width);
    }
    return next_raw;
}

fn command_executor_bitfield_ensure_len(buf: &Sds, bit_end_exclusive: usize) !void {
    const required_len: usize = (bit_end_exclusive + 7) / 8;
    _ = sds_grow(buf, required_len) catch {
        return error.AllocOutOfMemory;
    };
    var fill_index: usize = buf.len;
    while fill_index < required_len {
        buf.buf.ptr[fill_index] = 0 as byte;
        fill_index = fill_index + 1;
    }
    if required_len > buf.len {
        buf.len = required_len;
        buf.buf.ptr[buf.len] = 0 as byte;
    }
}

fn command_executor_bitfield_write_raw(buf: &Sds, offset: usize, width: usize, raw: u64) !void {
    try command_executor_bitfield_ensure_len(buf, offset + width);
    var bit_index: usize = 0;
    while bit_index < width {
        const byte_index: usize = (offset + bit_index) / 8;
        const inner_bit_index: usize = (offset + bit_index) % (8 as usize);
        const mask: u32 = command_executor_bit_mask(inner_bit_index);
        const source_shift: i32 = (width - bit_index - 1) as i32;
        const bit_value: u64 = (raw >> source_shift) & 1u64;
        var current_byte: u32 = buf.buf.ptr[byte_index] as u32;
        if bit_value == 0u64 {
            current_byte = current_byte & (255u32 ^ mask);
        } else {
            current_byte = current_byte | mask;
        }
        buf.buf.ptr[byte_index] = current_byte as byte;
        bit_index = bit_index + 1;
    }
}

fn command_executor_key_exists(engine: &Engine, key: &[byte], now_ms: u64) bool {
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return false;
    };
    _ = obj;
    return true;
}

fn command_executor_lookup_key_now_or_null(engine: &Engine, key: &[byte], now_ms: u64) &RedisObject {
    const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
    const obj: &RedisObject = obj_result catch {
        return null as &RedisObject;
    };
    return obj;
}

fn command_executor_ping(command: &Command) CommandReply {
    if command.argc == 1 {
        return command_executor_simple(&"PONG"[0: 4]);
    }
    if command.argc == 2 {
        const message: &[byte] = command_executor_arg(command, 1) catch {
            return command_executor_wrong_arity();
        };
        return command_executor_bulk(message);
    }
    return command_executor_wrong_arity();
}

fn command_executor_echo(command: &Command) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const message: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    return command_executor_bulk(message);
}

fn command_executor_get(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    const data: &[byte] = command_executor_string_value(obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_bulk(data);
}

fn command_executor_incr(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    return command_executor_string_counter_apply(engine, key, 1, now_ms);
}

fn command_executor_decr(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    return command_executor_string_counter_apply(engine, key, -1, now_ms);
}

fn command_executor_incrby(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const delta_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const delta: i64 = command_executor_parse_i64(delta_data) catch {
        return command_executor_invalid_integer();
    };
    return command_executor_string_counter_apply(engine, key, delta, now_ms);
}

fn command_executor_decrby(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const delta_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const delta: i64 = command_executor_parse_i64(delta_data) catch {
        return command_executor_invalid_integer();
    };
    return command_executor_string_counter_apply(engine, key, 0 - delta, now_ms);
}

fn command_executor_getset(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const value: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };

    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        const set_reply: CommandReply = command_executor_store_string(engine, key, value, now_ms);
        if set_reply.typ == CommandReplyType.reply_error {
            return set_reply;
        }
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    const old_value: &[byte] = command_executor_string_value(existing) catch {
        return command_executor_wrongtype();
    };
    var reply: CommandReply = command_executor_owned_bulk_copy(old_value);
    if reply.typ == CommandReplyType.reply_error {
        return reply;
    }
    const set_reply: CommandReply = command_executor_store_string(engine, key, value, now_ms);
    if set_reply.typ == CommandReplyType.reply_error {
        command_reply_cleanup(&reply);
        return set_reply;
    }
    return reply;
}

fn command_executor_setnx(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const value: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    if command_executor_key_exists(engine, key, now_ms) {
        return command_executor_integer(0);
    }
    const set_reply: CommandReply = command_executor_store_string(engine, key, value, now_ms);
    if set_reply.typ == CommandReplyType.reply_error {
        return set_reply;
    }
    return command_executor_integer(1);
}

fn command_executor_setex(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const seconds_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const value: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const seconds: i64 = command_executor_parse_i64(seconds_data) catch {
        return command_executor_invalid_integer();
    };
    if seconds <= 0 {
        return command_executor_invalid_integer();
    }
    const set_reply: CommandReply = command_executor_store_string(engine, key, value, now_ms);
    if set_reply.typ == CommandReplyType.reply_error {
        return set_reply;
    }
    _ = set_key_expire_at(engine, key, now_ms + (seconds as u64) * 1000u64) catch {
        return command_executor_oom();
    };
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_psetex(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const milliseconds_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const value: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const milliseconds: i64 = command_executor_parse_i64(milliseconds_data) catch {
        return command_executor_invalid_integer();
    };
    if milliseconds <= 0 {
        return command_executor_invalid_integer();
    }
    const set_reply: CommandReply = command_executor_store_string(engine, key, value, now_ms);
    if set_reply.typ == CommandReplyType.reply_error {
        return set_reply;
    }
    _ = set_key_expire_at(engine, key, now_ms + (milliseconds as u64)) catch {
        return command_executor_oom();
    };
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_getrange(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const start_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const end_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const start: i64 = command_executor_parse_i64(start_data) catch {
        return command_executor_invalid_integer();
    };
    const stop: i64 = command_executor_parse_i64(end_data) catch {
        return command_executor_invalid_integer();
    };
    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_bulk(command_executor_empty_slice());
    };
    const data: &[byte] = command_executor_string_value(existing) catch {
        return command_executor_wrongtype();
    };
    if data.len == 0 {
        return command_executor_bulk(command_executor_empty_slice());
    }

    const len_i64: i64 = data.len as i64;
    var start_index: i64 = start;
    var stop_index: i64 = stop;
    if start_index < 0 {
        start_index = len_i64 + start_index;
    }
    if stop_index < 0 {
        stop_index = len_i64 + stop_index;
    }
    if start_index < 0 {
        start_index = 0;
    }
    if stop_index < 0 || start_index >= len_i64 || start_index > stop_index {
        return command_executor_bulk(command_executor_empty_slice());
    }
    if stop_index >= len_i64 {
        stop_index = len_i64 - 1;
    }
    const start_usize: usize = start_index as usize;
    const slice_len: usize = (stop_index - start_index + 1) as usize;
    return command_executor_bulk(data[start_usize: slice_len]);
}

fn command_executor_getbit(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const offset_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const offset_i64: i64 = command_executor_parse_i64(offset_data) catch {
        return command_executor_error(&"ERR bit offset is not an integer or out of range"[0: 48]);
    };
    if offset_i64 < 0 {
        return command_executor_error(&"ERR bit offset is not an integer or out of range"[0: 48]);
    }
    const obj: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    if obj == null {
        return command_executor_integer(0);
    }
    const data: &[byte] = command_executor_string_value(obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_integer(command_executor_string_bit_get(data, offset_i64 as usize));
}

fn command_executor_setbit(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const offset_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const bit_value_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const offset_i64: i64 = command_executor_parse_i64(offset_data) catch {
        return command_executor_error(&"ERR bit offset is not an integer or out of range"[0: 48]);
    };
    if offset_i64 < 0 {
        return command_executor_error(&"ERR bit offset is not an integer or out of range"[0: 48]);
    }
    const bit_value_i64: i64 = command_executor_parse_i64(bit_value_data) catch {
        return command_executor_error(&"ERR bit is not an integer or out of range"[0: 41]);
    };
    if bit_value_i64 != 0 && bit_value_i64 != 1 {
        return command_executor_error(&"ERR bit is not an integer or out of range"[0: 41]);
    }

    const bit_offset: usize = offset_i64 as usize;
    const byte_index: usize = bit_offset / (8 as usize);
    const previous_obj: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    var previous_data: &[byte] = command_executor_empty_slice();
    if previous_obj != null {
        previous_data = command_executor_string_value(previous_obj) catch {
            return command_executor_wrongtype();
        };
    }
    const previous_bit: i64 = command_executor_string_bit_get(previous_data, bit_offset);

    var updated: Sds = sds_new(previous_data) catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&updated);
    }
    const required_len: usize = byte_index + 1;
    _ = sds_grow(&updated, required_len) catch {
        return command_executor_oom();
    };
    var fill: usize = updated.len;
    while fill < required_len {
        updated.buf.ptr[fill] = 0 as byte;
        fill = fill + 1;
    }
    if required_len > updated.len {
        updated.len = required_len;
        updated.buf.ptr[updated.len] = 0 as byte;
    }

    const mask: u32 = command_executor_bit_mask(bit_offset % (8 as usize));
    var current_byte: u32 = updated.buf.ptr[byte_index] as u32;
    if bit_value_i64 == 0 {
        current_byte = current_byte & (255u32 ^ mask);
    } else {
        current_byte = current_byte | mask;
    }
    updated.buf.ptr[byte_index] = current_byte as byte;

    const set_reply: CommandReply = command_executor_replace_string_preserve_ttl(engine, key, updated.buf[0: updated.len], now_ms);
    if set_reply.typ == CommandReplyType.reply_error {
        return set_reply;
    }
    return command_executor_integer(previous_bit);
}

fn command_executor_setrange(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const offset_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const value: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const offset_i64: i64 = command_executor_parse_i64(offset_data) catch {
        return command_executor_invalid_integer();
    };
    if offset_i64 < 0 {
        return command_executor_invalid_integer();
    }
    const offset: usize = offset_i64 as usize;

    const existing: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    if existing == null {
        if value.len == 0 {
            return command_executor_integer(0);
        }
        var created: Sds = sds_empty() catch {
            return command_executor_oom();
        };
        defer {
            sds_free(&created);
        }
        _ = sds_grow(&created, offset + value.len) catch {
            return command_executor_oom();
        };
        var fill: usize = 0;
        while fill < offset {
            created.buf.ptr[fill] = 0 as byte;
            fill = fill + 1;
        }
        var copy: usize = 0;
        while copy < value.len {
            created.buf.ptr[offset + copy] = value.ptr[copy];
            copy = copy + 1;
        }
        created.len = offset + value.len;
        created.buf.ptr[created.len] = 0 as byte;
        const set_reply_created: CommandReply = command_executor_replace_string_preserve_ttl(engine, key, created.buf[0: created.len], now_ms);
        if set_reply_created.typ == CommandReplyType.reply_error {
            return set_reply_created;
        }
        return command_executor_integer(created.len as i64);
    }

    const data: &[byte] = command_executor_string_value(existing) catch {
        return command_executor_wrongtype();
    };
    if value.len == 0 {
        return command_executor_integer(data.len as i64);
    }

    var updated: Sds = sds_new(data) catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&updated);
    }
    const needed_len: usize = offset + value.len;
    _ = sds_grow(&updated, needed_len) catch {
        return command_executor_oom();
    };
    var fill_existing: usize = updated.len;
    while fill_existing < offset {
        updated.buf.ptr[fill_existing] = 0 as byte;
        fill_existing = fill_existing + 1;
    }
    var copy_existing: usize = 0;
    while copy_existing < value.len {
        updated.buf.ptr[offset + copy_existing] = value.ptr[copy_existing];
        copy_existing = copy_existing + 1;
    }
    if needed_len > updated.len {
        updated.len = needed_len;
        updated.buf.ptr[updated.len] = 0 as byte;
    }
    const set_reply_updated: CommandReply = command_executor_replace_string_preserve_ttl(engine, key, updated.buf[0: updated.len], now_ms);
    if set_reply_updated.typ == CommandReplyType.reply_error {
        return set_reply_updated;
    }
    return command_executor_integer(updated.len as i64);
}

fn command_executor_bitcount(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 && command.argc != 4 && command.argc != 5 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    if obj == null {
        return command_executor_integer(0);
    }
    const data: &[byte] = command_executor_string_value(obj) catch {
        return command_executor_wrongtype();
    };
    if data.len == 0 {
        return command_executor_integer(0);
    }

    if command.argc == 2 {
        var total_count: i64 = 0;
        var byte_index: usize = 0;
        while byte_index < data.len {
            total_count = total_count + command_executor_popcount_byte(data.ptr[byte_index]);
            byte_index = byte_index + 1;
        }
        return command_executor_integer(total_count);
    }

    const start_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const stop_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const start: i64 = command_executor_parse_i64(start_data) catch {
        return command_executor_invalid_integer();
    };
    const stop: i64 = command_executor_parse_i64(stop_data) catch {
        return command_executor_invalid_integer();
    };

    var bit_mode: bool = false;
    if command.argc == 5 {
        const mode_data: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(mode_data, &"BIT"[0: 3]) {
            bit_mode = true;
        } else if command_executor_keyword_eq(mode_data, &"BYTE"[0: 4]) {
            bit_mode = false;
        } else {
            return command_executor_syntax_error();
        }
    }

    if !bit_mode {
        const range: CommandExecutorIndexRange = command_executor_normalize_index_range(data.len, start, stop);
        if !range.ok {
            return command_executor_integer(0);
        }
        var total_count: i64 = 0;
        var byte_index: usize = range.start;
        while byte_index <= range.stop {
            total_count = total_count + command_executor_popcount_byte(data.ptr[byte_index]);
            byte_index = byte_index + 1;
        }
        return command_executor_integer(total_count);
    }

    const total_bits: usize = data.len * 8;
    const range_bits: CommandExecutorIndexRange = command_executor_normalize_index_range(total_bits, start, stop);
    if !range_bits.ok {
        return command_executor_integer(0);
    }
    return command_executor_integer(command_executor_bitcount_range_bits(data, range_bits.start, range_bits.stop));
}

fn command_executor_bitpos(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 || command.argc > 6 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const bit_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const target_bit: i64 = command_executor_parse_i64(bit_data) catch {
        return command_executor_error(&"ERR bit is not an integer or out of range"[0: 41]);
    };
    if target_bit != 0 && target_bit != 1 {
        return command_executor_error(&"ERR bit is not an integer or out of range"[0: 41]);
    }

    const obj: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    if obj == null {
        if target_bit == 0 {
            return command_executor_integer(0);
        }
        return command_executor_integer(-1);
    }
    const data: &[byte] = command_executor_string_value(obj) catch {
        return command_executor_wrongtype();
    };

    var start: i64 = 0;
    var end: i64 = 0;
    var has_end: bool = false;
    var bit_mode: bool = false;
    if command.argc >= 4 {
        const start_data: &[byte] = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
        start = command_executor_parse_i64(start_data) catch {
            return command_executor_invalid_integer();
        };
    }
    if command.argc >= 5 {
        const end_data: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        end = command_executor_parse_i64(end_data) catch {
            return command_executor_invalid_integer();
        };
        has_end = true;
    }
    if command.argc == 6 {
        const mode_data: &[byte] = command_executor_arg(command, 5) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(mode_data, &"BIT"[0: 3]) {
            bit_mode = true;
        } else if command_executor_keyword_eq(mode_data, &"BYTE"[0: 4]) {
            bit_mode = false;
        } else {
            return command_executor_syntax_error();
        }
    }

    if data.len == 0 {
        return command_executor_integer(-1);
    }
    if bit_mode {
        return command_executor_integer(command_executor_bitpos_bit_mode(data, target_bit, start, end));
    }
    return command_executor_integer(command_executor_bitpos_byte_mode(data, target_bit, start, has_end, end));
}

fn command_executor_bitop(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }
    const operation: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const destination: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };

    var op_code: i32 = 0;
    if command_executor_keyword_eq(operation, &"AND"[0: 3]) {
        op_code = 1;
    } else if command_executor_keyword_eq(operation, &"OR"[0: 2]) {
        op_code = 2;
    } else if command_executor_keyword_eq(operation, &"XOR"[0: 3]) {
        op_code = 3;
    } else if command_executor_keyword_eq(operation, &"NOT"[0: 3]) {
        op_code = 4;
        if command.argc != 4 {
            return command_executor_error(&"ERR BITOP NOT must be called with a single source key."[0: 52]);
        }
    } else {
        return command_executor_syntax_error();
    }

    var max_len: usize = 0;
    var source_index: usize = 3;
    while source_index < command.argc {
        const source: &[byte] = command_executor_arg(command, source_index) catch {
            return command_executor_wrong_arity();
        };
        const source_data: &[byte] = command_executor_string_value_or_empty(engine, source, now_ms) catch {
            return command_executor_wrongtype();
        };
        if source_data.len > max_len {
            max_len = source_data.len;
        }
        source_index = source_index + 1;
    }

    if max_len == 0 {
        _ = delete_key(engine, destination);
        return command_executor_integer(0);
    }

    var output: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&output);
    }
    _ = sds_grow(&output, max_len) catch {
        return command_executor_oom();
    };
    output.len = max_len;
    output.buf.ptr[output.len] = 0 as byte;

    var byte_index: usize = 0;
    while byte_index < max_len {
        var combined: u32 = 0;
        if op_code == 1 {
            combined = 255u32;
        }

        var current_source_index: usize = 3;
        while current_source_index < command.argc {
            const source: &[byte] = command_executor_arg(command, current_source_index) catch {
                return command_executor_wrong_arity();
            };
            const source_data: &[byte] = command_executor_string_value_or_empty(engine, source, now_ms) catch {
                return command_executor_wrongtype();
            };
            var source_byte: u32 = 0u32;
            if byte_index < source_data.len {
                source_byte = source_data.ptr[byte_index] as u32;
            }
            if op_code == 1 {
                combined = combined & source_byte;
            } else if op_code == 2 {
                combined = combined | source_byte;
            } else if op_code == 3 {
                combined = combined ^ source_byte;
            } else {
                combined = 255u32 ^ source_byte;
            }
            current_source_index = current_source_index + 1;
        }

        output.buf.ptr[byte_index] = combined as byte;
        byte_index = byte_index + 1;
    }

    const set_reply: CommandReply = command_executor_store_string(engine, destination, output.buf[0: output.len], now_ms);
    if set_reply.typ == CommandReplyType.reply_error {
        return set_reply;
    }
    return command_executor_integer(max_len as i64);
}

fn command_executor_bitfield(engine: &Engine, command: &Command, now_ms: u64, readonly_only: bool) CommandReply {
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    var existing_data: &[byte] = command_executor_empty_slice();
    if obj != null {
        existing_data = command_executor_string_value(obj) catch {
            return command_executor_wrongtype();
        };
    }

    var working: Sds = sds_new(existing_data) catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&working);
    }

    var items: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&items);
    }

    var overflow_mode: CommandExecutorBitfieldOverflowMode = CommandExecutorBitfieldOverflowMode.overflow_wrap;
    var result_count: usize = 0;
    var wrote: bool = false;
    var index: usize = 2;
    while index < command.argc {
        const token: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };

        if command_executor_keyword_eq(token, &"OVERFLOW"[0: 8]) {
            if index + 1 >= command.argc {
                return command_executor_syntax_error();
            }
            const mode_token_result: !&[byte] = command_executor_arg(command, index + 1);
            if mode_token_result.error_id != 0 {
                return command_executor_syntax_error();
            }
            const mode_token: &[byte] = mode_token_result.value;
            if command_executor_keyword_eq(mode_token, &"WRAP"[0: 4]) {
                overflow_mode = CommandExecutorBitfieldOverflowMode.overflow_wrap;
                index = index + 2;
                continue;
            }
            if command_executor_keyword_eq(mode_token, &"SAT"[0: 3]) {
                overflow_mode = CommandExecutorBitfieldOverflowMode.overflow_sat;
                index = index + 2;
                continue;
            }
            if command_executor_keyword_eq(mode_token, &"FAIL"[0: 4]) {
                overflow_mode = CommandExecutorBitfieldOverflowMode.overflow_fail;
                index = index + 2;
                continue;
            }
            return command_executor_error(&"ERR Invalid OVERFLOW type specified"[0: 35]);
        }

        if command_executor_keyword_eq(token, &"GET"[0: 3]) {
            if index + 2 >= command.argc {
                return command_executor_syntax_error();
            }
            const encoding_result: !&[byte] = command_executor_arg(command, index + 1);
            if encoding_result.error_id != 0 {
                return command_executor_syntax_error();
            }
            const offset_result: !&[byte] = command_executor_arg(command, index + 2);
            if offset_result.error_id != 0 {
                return command_executor_syntax_error();
            }
            const encoding_data: &[byte] = encoding_result.value;
            const offset_data: &[byte] = offset_result.value;
            const encoding: CommandExecutorBitfieldEncoding = command_executor_bitfield_parse_encoding(encoding_data) catch {
                return command_executor_error(&"ERR Invalid bitfield type. Use something like i16 u8. Note that u64 is not supported but i64 is."[0: 96]);
            };
            const offset: usize = command_executor_bitfield_parse_offset(offset_data, encoding.width) catch {
                return command_executor_error(&"ERR bit offset is not an integer or out of range"[0: 48]);
            };
            const raw_value: u64 = command_executor_bitfield_read_raw(working.buf[0: working.len], offset, encoding.width);
            const decoded: i64 = command_executor_bitfield_decode_value(raw_value, &encoding);
            _ = command_executor_info_append_i64(&items, &":%i\r\n"[0: 5], decoded) catch {
                return command_executor_oom();
            };
            result_count = result_count + 1;
            index = index + 3;
            continue;
        }

        if command_executor_keyword_eq(token, &"SET"[0: 3]) || command_executor_keyword_eq(token, &"INCRBY"[0: 6]) {
            if readonly_only {
                return command_executor_error(&"ERR BITFIELD_RO only supports the GET subcommand"[0: 48]);
            }
            if index + 3 >= command.argc {
                return command_executor_syntax_error();
            }

            const encoding_result: !&[byte] = command_executor_arg(command, index + 1);
            if encoding_result.error_id != 0 {
                return command_executor_syntax_error();
            }
            const offset_result: !&[byte] = command_executor_arg(command, index + 2);
            if offset_result.error_id != 0 {
                return command_executor_syntax_error();
            }
            const value_result: !&[byte] = command_executor_arg(command, index + 3);
            if value_result.error_id != 0 {
                return command_executor_syntax_error();
            }
            const encoding_data: &[byte] = encoding_result.value;
            const offset_data: &[byte] = offset_result.value;
            const value_data: &[byte] = value_result.value;
            const encoding: CommandExecutorBitfieldEncoding = command_executor_bitfield_parse_encoding(encoding_data) catch {
                return command_executor_error(&"ERR Invalid bitfield type. Use something like i16 u8. Note that u64 is not supported but i64 is."[0: 96]);
            };
            const offset: usize = command_executor_bitfield_parse_offset(offset_data, encoding.width) catch {
                return command_executor_error(&"ERR bit offset is not an integer or out of range"[0: 48]);
            };
            const operand: i64 = command_executor_parse_i64(value_data) catch {
                return command_executor_invalid_integer();
            };
            const previous_raw: u64 = command_executor_bitfield_read_raw(working.buf[0: working.len], offset, encoding.width);
            const previous_value: i64 = command_executor_bitfield_decode_value(previous_raw, &encoding);

            if command_executor_keyword_eq(token, &"SET"[0: 3]) {
                var store_value: i64 = operand;
                var should_store: bool = true;
                if !command_executor_bitfield_in_range(&encoding, operand) {
                    if overflow_mode == CommandExecutorBitfieldOverflowMode.overflow_fail {
                        should_store = false;
                    } else if overflow_mode == CommandExecutorBitfieldOverflowMode.overflow_sat {
                        if operand < command_executor_bitfield_min_value(&encoding) {
                            store_value = command_executor_bitfield_min_value(&encoding);
                        } else {
                            store_value = command_executor_bitfield_max_value(&encoding);
                        }
                    }
                }
                if should_store {
                    _ = command_executor_bitfield_write_raw(&working, offset, encoding.width, command_executor_bitfield_encode_value(&encoding, store_value)) catch {
                        return command_executor_oom();
                    };
                    wrote = true;
                    _ = command_executor_info_append_i64(&items, &":%i\r\n"[0: 5], previous_value) catch {
                        return command_executor_oom();
                    };
                } else {
                    _ = command_executor_command_append_null(&items, 2) catch {
                        return command_executor_oom();
                    };
                }
                result_count = result_count + 1;
                index = index + 4;
                continue;
            }

            var next_value: i64 = previous_value;
            var should_store_incr: bool = true;
            if overflow_mode == CommandExecutorBitfieldOverflowMode.overflow_wrap {
                const wrapped_raw: u64 = command_executor_bitfield_wrap_add(previous_raw, operand, &encoding);
                next_value = command_executor_bitfield_decode_value(wrapped_raw, &encoding);
                _ = command_executor_bitfield_write_raw(&working, offset, encoding.width, wrapped_raw) catch {
                    return command_executor_oom();
                };
                wrote = true;
                _ = command_executor_info_append_i64(&items, &":%i\r\n"[0: 5], next_value) catch {
                    return command_executor_oom();
                };
            } else {
                if command_executor_bitfield_incrby_overflow(previous_value, operand, &encoding) {
                    if overflow_mode == CommandExecutorBitfieldOverflowMode.overflow_fail {
                        should_store_incr = false;
                    } else if operand < 0 {
                        next_value = command_executor_bitfield_min_value(&encoding);
                    } else {
                        next_value = command_executor_bitfield_max_value(&encoding);
                    }
                } else {
                    next_value = previous_value + operand;
                }

                if should_store_incr {
                    _ = command_executor_bitfield_write_raw(&working, offset, encoding.width, command_executor_bitfield_encode_value(&encoding, next_value)) catch {
                        return command_executor_oom();
                    };
                    wrote = true;
                    _ = command_executor_info_append_i64(&items, &":%i\r\n"[0: 5], next_value) catch {
                        return command_executor_oom();
                    };
                } else {
                    _ = command_executor_command_append_null(&items, 2) catch {
                        return command_executor_oom();
                    };
                }
            }
            result_count = result_count + 1;
            index = index + 4;
            continue;
        }

        if readonly_only {
            return command_executor_syntax_error();
        }
        return command_executor_syntax_error();
    }

    if wrote {
        const set_reply: CommandReply = command_executor_replace_string_preserve_ttl(engine, key, working.buf[0: working.len], now_ms);
        if set_reply.typ == CommandReplyType.reply_error {
            return set_reply;
        }
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], result_count) catch {
        return command_executor_oom();
    };
    _ = sds_cat(&raw, items.buf[0: items.len]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_hll_members_into_set(source_obj: &RedisObject, destination_set: &RedisObject) !void {
    if source_obj == null || source_obj.obj_type != ObjectType.object_set {
        return error.ObjectWrongType;
    }
    var iter: DictIterator = dict_iter_new();
    var entry: &DictEntry = dict_iter_next(&source_obj.hash_dict, &iter);
    while entry != null {
        _ = try set_object_add_member(destination_set, entry.key.buf[0: entry.key.len]);
        entry = dict_iter_next(&source_obj.hash_dict, &iter);
    }
}

fn command_executor_pfadd(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        const hll_obj: &RedisObject = create_set_object() catch {
            return command_executor_oom();
        };
        var added_any_new: i64 = 1;
        var index_new: usize = 2;
        while index_new < command.argc {
            const member_new: &[byte] = command_executor_arg(command, index_new) catch {
                object_free(hll_obj);
                return command_executor_wrong_arity();
            };
            const inserted_new: bool = set_object_add_member(hll_obj, member_new) catch |err| {
                object_free(hll_obj);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_error(&"ERR PFADD failed"[0: 16]);
            };
            if inserted_new {
                added_any_new = 1;
            }
            index_new = index_new + 1;
        }
        _ = set_key_at(engine, key, hll_obj, now_ms) catch {
            object_free(hll_obj);
            return command_executor_oom();
        };
        return command_executor_integer(added_any_new);
    };

    if existing.obj_type != ObjectType.object_set {
        return command_executor_error(&"WRONGTYPE Key is not a valid HyperLogLog string value."[0: 54]);
    }

    var added_any: i64 = 0;
    var index: usize = 2;
    while index < command.argc {
        const member: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const inserted: bool = set_object_add_member(existing, member) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_error(&"ERR PFADD failed"[0: 16]);
        };
        if inserted {
            added_any = 1;
        }
        index = index + 1;
    }
    return command_executor_integer(added_any);
}

fn command_executor_pfcount(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    if command.argc == 2 {
        const key: &[byte] = command_executor_arg(command, 1) catch {
            return command_executor_wrong_arity();
        };
        const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
            return command_executor_integer(0);
        };
        if obj.obj_type != ObjectType.object_set {
            return command_executor_error(&"WRONGTYPE Key is not a valid HyperLogLog string value."[0: 54]);
        }
        const count: usize = set_object_len(obj) catch {
            return command_executor_error(&"WRONGTYPE Key is not a valid HyperLogLog string value."[0: 54]);
        };
        return command_executor_integer(count as i64);
    }

    const union_set: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    defer {
        object_free(union_set);
    }

    var index: usize = 1;
    while index < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        if obj_result.error_id != 0 {
            index = index + 1;
            continue;
        }
        const obj: &RedisObject = obj_result.value;
        if obj.obj_type != ObjectType.object_set {
            return command_executor_error(&"WRONGTYPE Key is not a valid HyperLogLog string value."[0: 54]);
        }
        _ = command_executor_hll_members_into_set(obj, union_set) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_error(&"WRONGTYPE Key is not a valid HyperLogLog string value."[0: 54]);
        };
        index = index + 1;
    }

    const count: usize = set_object_len(union_set) catch {
        return command_executor_error(&"WRONGTYPE Key is not a valid HyperLogLog string value."[0: 54]);
    };
    return command_executor_integer(count as i64);
}

fn command_executor_pfmerge(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    const destination: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const merged: &RedisObject = create_set_object() catch {
        return command_executor_oom();
    };
    defer {
        object_free(merged);
    }

    var index: usize = 2;
    while index < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        if obj_result.error_id != 0 {
            index = index + 1;
            continue;
        }
        const obj: &RedisObject = obj_result.value;
        if obj.obj_type != ObjectType.object_set {
            return command_executor_error(&"WRONGTYPE Key is not a valid HyperLogLog string value."[0: 54]);
        }
        _ = command_executor_hll_members_into_set(obj, merged) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_error(&"WRONGTYPE Key is not a valid HyperLogLog string value."[0: 54]);
        };
        index = index + 1;
    }

    const stored: &RedisObject = object_clone(merged) catch |err| {
        if err == error.AllocOutOfMemory {
            return command_executor_oom();
        }
        return command_executor_error(&"ERR PFMERGE failed"[0: 18]);
    };
    _ = set_key_at(engine, destination, stored, now_ms) catch {
        object_free(stored);
        return command_executor_oom();
    };
    _ = clear_key_expire(engine, destination);
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_pfselftest(command: &Command) CommandReply {
    if command.argc != 1 {
        return command_executor_wrong_arity();
    }
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_pfdebug(command: &Command) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    return command_executor_error(&"ERR PFDEBUG command not allowed by redis-uya standalone profile"[0: 63]);
}

fn command_executor_incrbyfloat(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const increment_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const increment: f64 = command_executor_parse_f64(increment_data) catch {
        return command_executor_error(&"ERR value is not a valid float"[0: 30]);
    };

    const existing: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
    if existing == null {
        return command_executor_set_float_string(engine, key, increment, now_ms);
    }
    const current_data: &[byte] = command_executor_string_value(existing) catch {
        return command_executor_wrongtype();
    };
    const current: f64 = command_executor_parse_f64(current_data) catch {
        return command_executor_error(&"ERR value is not a valid float"[0: 30]);
    };
    return command_executor_set_float_string(engine, key, current + increment, now_ms);
}

fn command_executor_mget(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_wrong_arity();
    }
    const reply_list: &RedisObject = create_list_object() catch {
        return command_executor_oom();
    };
    var null_map: Sds = sds_empty() catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    defer {
        sds_free(&null_map);
    }

    var index: usize = 1;
    while index < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            object_free(reply_list);
            return command_executor_wrong_arity();
        };
        const existing: &RedisObject = command_executor_lookup_key_now_or_null(engine, key, now_ms);
        if existing == null {
            var zero_flag: [byte: 1] = [];
            zero_flag[0] = 1 as byte;
            _ = list_object_push_tail(reply_list, command_executor_empty_slice()) catch {
                object_free(reply_list);
                return command_executor_oom();
            };
            _ = sds_cat(&null_map, zero_flag[0: 1]) catch {
                object_free(reply_list);
                return command_executor_oom();
            };
            index = index + 1;
            continue;
        }
        const value: &[byte] = command_executor_string_value(existing) catch {
            object_free(reply_list);
            return command_executor_wrongtype();
        };
        var one_flag: [byte: 1] = [];
        one_flag[0] = 0 as byte;
        _ = list_object_push_tail(reply_list, value) catch {
            object_free(reply_list);
            return command_executor_oom();
        };
        _ = sds_cat(&null_map, one_flag[0: 1]) catch {
            object_free(reply_list);
            return command_executor_oom();
        };
        index = index + 1;
    }

    const null_map_obj: &RedisObject = create_string_object(null_map.buf[0: null_map.len]) catch {
        object_free(reply_list);
        return command_executor_oom();
    };
    var reply: CommandReply = command_executor_nullable_array_bulk(reply_list.list_head, command.argc - 1, null_map_obj);
    reply.owned_object = reply_list;
    return reply;
}

fn command_executor_mset(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 || ((command.argc - 1) % (2 as usize)) != 0 {
        return command_executor_wrong_arity();
    }
    var index: usize = 1;
    while index + 1 < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const value: &[byte] = command_executor_arg(command, index + 1) catch {
            return command_executor_wrong_arity();
        };
        const set_reply: CommandReply = command_executor_store_string(engine, key, value, now_ms);
        if set_reply.typ == CommandReplyType.reply_error {
            return set_reply;
        }
        index = index + 2;
    }
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_msetnx(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 || ((command.argc - 1) % (2 as usize)) != 0 {
        return command_executor_wrong_arity();
    }
    var index_check: usize = 1;
    while index_check < command.argc {
        const key_check: &[byte] = command_executor_arg(command, index_check) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_key_exists(engine, key_check, now_ms) {
            return command_executor_integer(0);
        }
        index_check = index_check + 2;
    }

    var index: usize = 1;
    while index + 1 < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const value: &[byte] = command_executor_arg(command, index + 1) catch {
            return command_executor_wrong_arity();
        };
        const set_reply: CommandReply = command_executor_store_string(engine, key, value, now_ms);
        if set_reply.typ == CommandReplyType.reply_error {
            return set_reply;
        }
        index = index + 2;
    }
    return command_executor_integer(1);
}

fn command_executor_append(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const suffix: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };

    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        const new_obj: &RedisObject = create_string_object(suffix) catch {
            return command_executor_oom();
        };
        _ = set_key_at(engine, key, new_obj, now_ms) catch {
            object_free(new_obj);
            return command_executor_oom();
        };
        return command_executor_integer(suffix.len as i64);
    };

    const current: &[byte] = command_executor_string_value(existing) catch {
        return command_executor_wrongtype();
    };
    var combined: Sds = sds_new(current) catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&combined);
    }
    _ = sds_cat(&combined, suffix) catch {
        return command_executor_oom();
    };

    const new_obj: &RedisObject = create_string_object(combined.buf[0: combined.len]) catch {
        return command_executor_oom();
    };
    _ = set_key_at(engine, key, new_obj, now_ms) catch {
        object_free(new_obj);
        return command_executor_oom();
    };
    return command_executor_integer(combined.len as i64);
}

fn command_executor_strlen(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    const data: &[byte] = command_executor_string_value(obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_integer(data.len as i64);
}

fn command_executor_getdel(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    const data: &[byte] = command_executor_string_value(obj) catch {
        return command_executor_wrongtype();
    };
    var reply: CommandReply = command_executor_owned_bulk_copy(data);
    if reply.typ == CommandReplyType.reply_error {
        return reply;
    }
    _ = delete_key(engine, key);
    return reply;
}

fn command_executor_delex(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 && command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    if command.argc == 2 {
        if delete_key(engine, key) {
            return command_executor_integer(1);
        }
        return command_executor_integer(0);
    }

    var expect_match: bool = true;
    const option: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    if command_executor_keyword_eq(option, &"IFEQ"[0: 4]) {
        expect_match = true;
    } else if command_executor_keyword_eq(option, &"IFNE"[0: 4]) {
        expect_match = false;
    } else if command_executor_keyword_eq(option, &"IFDEQ"[0: 5]) ||
        command_executor_keyword_eq(option, &"IFDNE"[0: 5]) {
        return command_executor_error(&"ERR DELEX digest conditions are not supported by redis-uya partial"[0: 66]);
    } else {
        return command_executor_syntax_error();
    }
    const value: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    const current: &[byte] = command_executor_string_value(obj) catch {
        return command_executor_wrongtype();
    };
    const matched: bool = command_executor_slice_eq(current, value);
    if expect_match {
        if !matched {
            return command_executor_integer(0);
        }
    } else {
        if matched {
            return command_executor_integer(0);
        }
    }
    if delete_key(engine, key) {
        return command_executor_integer(1);
    }
    return command_executor_integer(0);
}

fn command_executor_getex(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 && command.argc != 3 && command.argc != 4 {
        return command_executor_wrong_arity();
    }

    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    var persist: bool = false;
    var set_expire: bool = false;
    var expire_at_ms: u64 = 0u64;

    if command.argc == 3 {
        const option: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(option, &"PERSIST"[0: 7]) {
            return command_executor_syntax_error();
        }
        persist = true;
    }

    if command.argc == 4 {
        const option: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_wrong_arity();
        };
        const expire_data: &[byte] = command_executor_arg(command, 3) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(option, &"EX"[0: 2]) {
            const seconds: i64 = command_executor_parse_i64(expire_data) catch {
                return command_executor_invalid_integer();
            };
            if seconds <= 0 {
                return command_executor_invalid_integer();
            }
            set_expire = true;
            expire_at_ms = now_ms + (seconds as u64) * 1000u64;
        } else if command_executor_keyword_eq(option, &"PX"[0: 2]) {
            const milliseconds: i64 = command_executor_parse_i64(expire_data) catch {
                return command_executor_invalid_integer();
            };
            if milliseconds <= 0 {
                return command_executor_invalid_integer();
            }
            set_expire = true;
            expire_at_ms = now_ms + (milliseconds as u64);
        } else if command_executor_keyword_eq(option, &"EXAT"[0: 4]) {
            const seconds_at: i64 = command_executor_parse_i64(expire_data) catch {
                return command_executor_invalid_integer();
            };
            if seconds_at < 0 {
                return command_executor_invalid_integer();
            }
            set_expire = true;
            expire_at_ms = (seconds_at as u64) * 1000u64;
        } else if command_executor_keyword_eq(option, &"PXAT"[0: 4]) {
            const milliseconds_at: i64 = command_executor_parse_i64(expire_data) catch {
                return command_executor_invalid_integer();
            };
            if milliseconds_at < 0 {
                return command_executor_invalid_integer();
            }
            set_expire = true;
            expire_at_ms = milliseconds_at as u64;
        } else {
            return command_executor_syntax_error();
        }
    }

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    const data: &[byte] = command_executor_string_value(obj) catch {
        return command_executor_wrongtype();
    };
    var reply: CommandReply = command_executor_owned_bulk_copy(data);
    if reply.typ == CommandReplyType.reply_error {
        return reply;
    }

    if persist {
        _ = persist_key_expire(engine, key);
        return reply;
    }

    if !set_expire {
        return reply;
    }

    if expire_at_ms <= now_ms {
        _ = delete_key(engine, key);
        return reply;
    }

    _ = set_key_expire_at(engine, key, expire_at_ms) catch {
        command_reply_cleanup(&reply);
        return command_executor_oom();
    };
    return reply;
}

fn command_executor_type(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_simple(&"none"[0: 4]);
    };
    return command_executor_simple(object_type_name(obj.obj_type));
}

fn command_executor_lpush(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        const list_obj: &RedisObject = create_list_object() catch {
            return command_executor_oom();
        };
        var index_new: usize = 2;
        var new_len: usize = 0;
        while index_new < command.argc {
            const value_new: &[byte] = command_executor_arg(command, index_new) catch {
                object_free(list_obj);
                return command_executor_wrong_arity();
            };
            new_len = list_object_push_head(list_obj, value_new) catch |err| {
                object_free(list_obj);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_error(&"ERR list push failed"[0: 20]);
            };
            index_new = index_new + 1;
        }
        _ = set_key_at(engine, key, list_obj, now_ms) catch {
            object_free(list_obj);
            return command_executor_oom();
        };
        return command_executor_integer(new_len as i64);
    };

    if existing.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }

    var index: usize = 2;
    var new_len_existing: usize = 0;
    while index < command.argc {
        const value: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        new_len_existing = list_object_push_head(existing, value) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_error(&"ERR list push failed"[0: 20]);
        };
        index = index + 1;
    }
    return command_executor_integer(new_len_existing as i64);
}

fn command_executor_lpop(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }

    const popped: &RedisObject = list_object_pop_head(obj) catch |err| {
        if err == error.ObjectListEmpty {
            return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
        }
        return command_executor_wrongtype();
    };
    const data: &[byte] = command_executor_string_value(popped) catch {
        object_free(popped);
        return command_executor_wrongtype();
    };
    const remaining: usize = list_object_len(obj) catch {
        object_free(popped);
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, key);
    }
    var reply: CommandReply = command_executor_bulk(data);
    reply.owned_object = popped;
    return reply;
}

fn command_executor_lrange(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const start_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const stop_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const start: i64 = command_executor_parse_i64(start_data) catch {
        return command_executor_invalid_integer();
    };
    const stop: i64 = command_executor_parse_i64(stop_data) catch {
        return command_executor_invalid_integer();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_array_bulk(null as &ListNode, 0);
    };
    if obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }
    const view: ListRangeView = list_object_range(obj, start, stop) catch {
        return command_executor_wrongtype();
    };
    return command_executor_array_bulk(view.head, view.count);
}

fn command_executor_stream_lookup_or_create(engine: &Engine, key: &[byte], now_ms: u64, created: &bool) !&RedisObject {
    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        const stream_obj: &RedisObject = try create_stream_object();
        _ = set_key_at(engine, key, stream_obj, now_ms) catch |err| {
            object_free(stream_obj);
            return err;
        };
        *created = true;
        return stream_obj;
    };
    if existing.obj_type != ObjectType.object_stream {
        return error.ObjectWrongType;
    }
    *created = false;
    return existing;
}

fn command_executor_xadd(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 5 || ((command.argc - 3) % 2usize) != 0usize {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const id_token: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };

    var created: bool = false;
    const stream_obj: &RedisObject = command_executor_stream_lookup_or_create(engine, key, now_ms, &created) catch |err| {
        if err == error.ObjectWrongType {
            return command_executor_wrongtype();
        }
        return command_executor_oom();
    };

    var id_ms: u64 = now_ms;
    var id_seq: u64 = 0u64;
    if id_token.len == 1 && id_token.ptr[0] == 42 as byte {
        if stream_obj.list_len > 0 && now_ms <= stream_obj.stream_last_ms {
            id_ms = stream_obj.stream_last_ms;
            id_seq = stream_obj.stream_last_seq + 1u64;
        }
    } else {
        const parsed: StreamId = command_executor_parse_stream_id(id_token, 0u64, false, false) catch {
            if created {
                _ = delete_key(engine, key);
            }
            return command_executor_error(&"ERR Invalid stream ID specified as stream command argument"[0: 57]);
        };
        if parsed.ms == 0u64 && parsed.seq == 0u64 {
            if created {
                _ = delete_key(engine, key);
            }
            return command_executor_error(&"ERR The ID specified in XADD is equal or smaller than the target stream top item"[0: 78]);
        }
        const last: StreamId = StreamId{ ms: stream_obj.stream_last_ms, seq: stream_obj.stream_last_seq, is_min: false, is_max: false, is_dollar: false };
        if stream_obj.list_len > 0 && command_executor_stream_id_cmp(&parsed, &last) <= 0 {
            if created {
                _ = delete_key(engine, key);
            }
            return command_executor_error(&"ERR The ID specified in XADD is equal or smaller than the target stream top item"[0: 78]);
        }
        id_ms = parsed.ms;
        id_seq = parsed.seq;
    }

    var id_sds: Sds = command_executor_stream_id_sds(id_ms, id_seq) catch {
        if created {
            _ = delete_key(engine, key);
        }
        return command_executor_oom();
    };
    defer {
        sds_free(&id_sds);
    }

    const entry: &RedisObject = create_list_object() catch {
        if created {
            _ = delete_key(engine, key);
        }
        return command_executor_oom();
    };
    _ = list_object_push_tail(entry, id_sds.buf[0: id_sds.len]) catch {
        object_free(entry);
        if created {
            _ = delete_key(engine, key);
        }
        return command_executor_oom();
    };
    var index: usize = 3;
    while index < command.argc {
        const field: &[byte] = command_executor_arg(command, index) catch {
            object_free(entry);
            if created {
                _ = delete_key(engine, key);
            }
            return command_executor_wrong_arity();
        };
        const value: &[byte] = command_executor_arg(command, index + 1) catch {
            object_free(entry);
            if created {
                _ = delete_key(engine, key);
            }
            return command_executor_wrong_arity();
        };
        _ = list_object_push_tail(entry, field) catch {
            object_free(entry);
            if created {
                _ = delete_key(engine, key);
            }
            return command_executor_oom();
        };
        _ = list_object_push_tail(entry, value) catch {
            object_free(entry);
            if created {
                _ = delete_key(engine, key);
            }
            return command_executor_oom();
        };
        index = index + 2;
    }
    _ = stream_object_append_entry(stream_obj, entry, id_ms, id_seq) catch {
        object_free(entry);
        if created {
            _ = delete_key(engine, key);
        }
        return command_executor_oom();
    };
    return command_executor_owned_bulk_copy(id_sds.buf[0: id_sds.len]);
}

fn command_executor_xdel(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    var index: usize = 2;
    while index < command.argc {
        const id_data: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        _ = command_executor_parse_stream_id(id_data, 0u64, false, false) catch {
            return command_executor_error(&"ERR Invalid stream ID specified as stream command argument"[0: 57]);
        };
        index = index + 1;
    }
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_stream {
        return command_executor_wrongtype();
    }
    var removed: usize = 0;
    index = 2;
    while index < command.argc {
        const id_data: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        var node: &ListNode = obj.list_head;
        var deleted: bool = false;
        while node != null && !deleted {
            const next: &ListNode = node.next;
            if node.value == null || node.value.obj_type != ObjectType.object_list || node.value.list_head == null {
                return command_executor_wrongtype();
            }
            const entry_id: &[byte] = node.value.list_head.value.value.buf[0: node.value.list_head.value.value.len];
            if command_executor_slice_eq(entry_id, id_data) {
                if node.prev != null {
                    node.prev.next = node.next;
                } else {
                    obj.list_head = node.next;
                }
                if node.next != null {
                    node.next.prev = node.prev;
                } else {
                    obj.list_tail = node.prev;
                }
                object_free(node.value);
                list_node_free(node);
                obj.list_len = obj.list_len - 1;
                removed = removed + 1;
                deleted = true;
            }
            node = next;
        }
        index = index + 1;
    }
    return command_executor_integer(removed as i64);
}

fn command_executor_xack(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_error(&"ERR no such key"[0: 14]);
    };
    if obj.obj_type != ObjectType.object_stream {
        return command_executor_wrongtype();
    }
    return command_executor_error(&"NOGROUP No such consumer group"[0: 30]);
}

fn command_executor_xclaim(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 6 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_arg(command, 4) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_arg(command, 5) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_error(&"ERR no such key"[0: 14]);
    };
    if obj.obj_type != ObjectType.object_stream {
        return command_executor_wrongtype();
    }
    return command_executor_error(&"NOGROUP No such consumer group"[0: 30]);
}

fn command_executor_xpending(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_error(&"ERR no such key"[0: 14]);
    };
    if obj.obj_type != ObjectType.object_stream {
        return command_executor_wrongtype();
    }
    return command_executor_error(&"NOGROUP No such consumer group"[0: 30]);
}

fn command_executor_xgroup(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup' command"[0: 50]);
    }
    const subcommand: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup' command"[0: 50]);
    };
    if command_executor_keyword_eq(subcommand, &"HELP"[0: 4]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|help' command"[0: 55]);
        }
        const reply_list: &RedisObject = create_list_object() catch {
            return command_executor_oom();
        };
        _ = list_object_push_tail(reply_list, &"XGROUP HELP"[0: 11]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Prints this help."[0: 21]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"XGROUP CREATE <key> <groupname> <id-or-$> [MKSTREAM]"[0: 52]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Validates stream keys; consumer group state is still deferred."[0: 66]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"XGROUP DESTROY <key> <groupname>"[0: 32]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Returns 0 while consumer group state is deferred."[0: 53]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"XGROUP SETID <key> <groupname> <id-or-$> [ENTRIESREAD entries-read]"[0: 67]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Returns NOGROUP until consumer groups are implemented."[0: 58]) catch { object_free(reply_list); return command_executor_oom(); };
        return command_executor_owned_array(reply_list);
    }
    if command_executor_keyword_eq(subcommand, &"CREATE"[0: 6]) {
        if command.argc != 5 && command.argc != 6 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|create' command"[0: 56]);
        }
        const key: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|create' command"[0: 56]);
        };
        _ = command_executor_arg(command, 3) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|create' command"[0: 56]);
        };
        _ = command_executor_arg(command, 4) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|create' command"[0: 56]);
        };
        if command.argc == 6 {
            const option: &[byte] = command_executor_arg(command, 5) catch {
                return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|create' command"[0: 56]);
            };
            if !command_executor_keyword_eq(option, &"MKSTREAM"[0: 8]) {
                return command_executor_syntax_error();
            }
        }
        const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
            return command_executor_error(&"ERR no such key"[0: 14]);
        };
        if obj.obj_type != ObjectType.object_stream {
            return command_executor_wrongtype();
        }
        return command_executor_error(&"ERR XGROUP CREATE is not supported yet"[0: 38]);
    }
    if command_executor_keyword_eq(subcommand, &"DESTROY"[0: 7]) {
        if command.argc != 4 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|destroy' command"[0: 58]);
        }
        const key: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|destroy' command"[0: 58]);
        };
        _ = command_executor_arg(command, 3) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|destroy' command"[0: 58]);
        };
        const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
            return command_executor_integer(0);
        };
        if obj.obj_type != ObjectType.object_stream {
            return command_executor_wrongtype();
        }
        return command_executor_integer(0);
    }
    if command_executor_keyword_eq(subcommand, &"SETID"[0: 5]) {
        if command.argc != 5 && command.argc != 7 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|setid' command"[0: 56]);
        }
        const key: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|setid' command"[0: 56]);
        };
        _ = command_executor_arg(command, 3) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|setid' command"[0: 56]);
        };
        _ = command_executor_arg(command, 4) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|setid' command"[0: 56]);
        };
        if command.argc == 7 {
            const option: &[byte] = command_executor_arg(command, 5) catch {
                return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|setid' command"[0: 56]);
            };
            _ = command_executor_arg(command, 6) catch {
                return command_executor_owned_error(&"ERR wrong number of arguments for 'xgroup|setid' command"[0: 56]);
            };
            if !command_executor_keyword_eq(option, &"ENTRIESREAD"[0: 11]) {
                return command_executor_syntax_error();
            }
        }
        const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
            return command_executor_error(&"ERR no such key"[0: 14]);
        };
        if obj.obj_type != ObjectType.object_stream {
            return command_executor_wrongtype();
        }
        return command_executor_error(&"NOGROUP No such consumer group"[0: 30]);
    }

    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR unknown subcommand '"[0: 24]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"'. Try XGROUP HELP."[0: 19]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_xinfo_stream_resp(buf: &Sds, obj: &RedisObject, length: usize) !void {
    var last_id: Sds = try command_executor_stream_id_sds(obj.stream_last_ms, obj.stream_last_seq);
    defer {
        sds_free(&last_id);
    }

    var first_entry: &RedisObject = null as &RedisObject;
    var last_entry: &RedisObject = null as &RedisObject;
    if obj.list_head != null {
        first_entry = obj.list_head.value;
    }
    if obj.list_tail != null {
        last_entry = obj.list_tail.value;
    }

    try command_executor_resp_append_array_header(buf, 20);
    try command_executor_resp_append_bulk(buf, &"length"[0: 6]);
    try command_executor_resp_append_integer(buf, length as i64);
    try command_executor_resp_append_bulk(buf, &"radix-tree-keys"[0: 15]);
    try command_executor_resp_append_integer(buf, 0);
    try command_executor_resp_append_bulk(buf, &"radix-tree-nodes"[0: 16]);
    try command_executor_resp_append_integer(buf, 0);
    try command_executor_resp_append_bulk(buf, &"last-generated-id"[0: 17]);
    try command_executor_resp_append_bulk(buf, last_id.buf[0: last_id.len]);
    try command_executor_resp_append_bulk(buf, &"max-deleted-entry-id"[0: 20]);
    try command_executor_resp_append_bulk(buf, &"0-0"[0: 3]);
    try command_executor_resp_append_bulk(buf, &"entries-added"[0: 13]);
    try command_executor_resp_append_integer(buf, length as i64);
    try command_executor_resp_append_bulk(buf, &"recorded-first-entry-id"[0: 23]);
    if first_entry != null && first_entry.list_head != null {
        const first_id: &[byte] = first_entry.list_head.value.value.buf[0: first_entry.list_head.value.value.len];
        try command_executor_resp_append_bulk(buf, first_id);
    } else {
        try command_executor_resp_append_bulk(buf, &"0-0"[0: 3]);
    }
    try command_executor_resp_append_bulk(buf, &"groups"[0: 6]);
    try command_executor_resp_append_integer(buf, 0);
    try command_executor_resp_append_bulk(buf, &"first-entry"[0: 11]);
    try command_executor_xinfo_append_entry_or_null(buf, first_entry);
    try command_executor_resp_append_bulk(buf, &"last-entry"[0: 10]);
    try command_executor_xinfo_append_entry_or_null(buf, last_entry);
}

fn command_executor_xinfo_stream_full_resp(buf: &Sds, obj: &RedisObject, length: usize, count_limit: i64) !void {
    var last_id: Sds = try command_executor_stream_id_sds(obj.stream_last_ms, obj.stream_last_seq);
    defer {
        sds_free(&last_id);
    }

    var entries_count: usize = length;
    if count_limit >= 0 && count_limit < entries_count as i64 {
        entries_count = count_limit as usize;
    }

    var first_entry: &RedisObject = null as &RedisObject;
    if obj.list_head != null {
        first_entry = obj.list_head.value;
    }

    try command_executor_resp_append_array_header(buf, 18);
    try command_executor_resp_append_bulk(buf, &"length"[0: 6]);
    try command_executor_resp_append_integer(buf, length as i64);
    try command_executor_resp_append_bulk(buf, &"radix-tree-keys"[0: 15]);
    try command_executor_resp_append_integer(buf, 0);
    try command_executor_resp_append_bulk(buf, &"radix-tree-nodes"[0: 16]);
    try command_executor_resp_append_integer(buf, 0);
    try command_executor_resp_append_bulk(buf, &"last-generated-id"[0: 17]);
    try command_executor_resp_append_bulk(buf, last_id.buf[0: last_id.len]);
    try command_executor_resp_append_bulk(buf, &"max-deleted-entry-id"[0: 20]);
    try command_executor_resp_append_bulk(buf, &"0-0"[0: 3]);
    try command_executor_resp_append_bulk(buf, &"entries-added"[0: 13]);
    try command_executor_resp_append_integer(buf, length as i64);
    try command_executor_resp_append_bulk(buf, &"recorded-first-entry-id"[0: 23]);
    if first_entry != null && first_entry.list_head != null {
        const first_id: &[byte] = first_entry.list_head.value.value.buf[0: first_entry.list_head.value.value.len];
        try command_executor_resp_append_bulk(buf, first_id);
    } else {
        try command_executor_resp_append_bulk(buf, &"0-0"[0: 3]);
    }
    try command_executor_resp_append_bulk(buf, &"entries"[0: 7]);
    try command_executor_resp_append_array_header(buf, entries_count);
    var emitted: usize = 0;
    var node: &ListNode = obj.list_head;
    while node != null && emitted < entries_count {
        try command_executor_stream_append_entry_resp(buf, node.value);
        emitted = emitted + 1;
        node = node.next;
    }
    try command_executor_resp_append_bulk(buf, &"groups"[0: 6]);
    try command_executor_resp_append_array_header(buf, 0);
}

fn command_executor_xinfo(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 2 {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo' command"[0: 49]);
    }
    const subcommand: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo' command"[0: 49]);
    };
    if command_executor_keyword_eq(subcommand, &"HELP"[0: 4]) {
        if command.argc != 2 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|help' command"[0: 54]);
        }
        const reply_list: &RedisObject = create_list_object() catch {
            return command_executor_oom();
        };
        _ = list_object_push_tail(reply_list, &"XINFO HELP"[0: 10]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Prints this help."[0: 21]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"XINFO STREAM <key> [FULL [COUNT <count>]]"[0: 41]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Returns basic stream metadata and FULL entry details."[0: 57]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"XINFO GROUPS <key>"[0: 18]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Returns an empty list; consumer group state is deferred."[0: 60]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"XINFO CONSUMERS <key> <groupname>"[0: 33]) catch { object_free(reply_list); return command_executor_oom(); };
        _ = list_object_push_tail(reply_list, &"    Returns NOGROUP until consumer groups are implemented."[0: 58]) catch { object_free(reply_list); return command_executor_oom(); };
        return command_executor_owned_array(reply_list);
    }
    if command_executor_keyword_eq(subcommand, &"STREAM"[0: 6]) {
        if command.argc != 3 && command.argc != 4 && command.argc != 6 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|stream' command"[0: 56]);
        }
        const key: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|stream' command"[0: 56]);
        };
        var full: bool = false;
        var count_limit: i64 = -1;
        if command.argc == 4 || command.argc == 6 {
            const full_token: &[byte] = command_executor_arg(command, 3) catch {
                return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|stream' command"[0: 56]);
            };
            if !command_executor_keyword_eq(full_token, &"FULL"[0: 4]) {
                return command_executor_syntax_error();
            }
            full = true;
        }
        if command.argc == 6 {
            const count_kw: &[byte] = command_executor_arg(command, 4) catch {
                return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|stream' command"[0: 56]);
            };
            if !command_executor_keyword_eq(count_kw, &"COUNT"[0: 5]) {
                return command_executor_syntax_error();
            }
            const count_data: &[byte] = command_executor_arg(command, 5) catch {
                return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|stream' command"[0: 56]);
            };
            count_limit = command_executor_parse_i64(count_data) catch {
                return command_executor_invalid_integer();
            };
            if count_limit < 0 {
                return command_executor_invalid_integer();
            }
        }
        const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
            return command_executor_error(&"ERR no such key"[0: 14]);
        };
        if obj.obj_type != ObjectType.object_stream {
            return command_executor_wrongtype();
        }
        const length: usize = stream_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        var raw: Sds = sds_empty() catch {
            return command_executor_oom();
        };
        defer {
            sds_free(&raw);
        }
        if full {
            _ = command_executor_xinfo_stream_full_resp(&raw, obj, length, count_limit) catch |build_err| {
                if build_err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        } else {
            _ = command_executor_xinfo_stream_resp(&raw, obj, length) catch |build_err| {
                if build_err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_wrongtype();
            };
        }
        return command_executor_owned_raw(raw.buf[0: raw.len]);
    }
    if command_executor_keyword_eq(subcommand, &"GROUPS"[0: 6]) {
        if command.argc != 3 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|groups' command"[0: 56]);
        }
        const key: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|groups' command"[0: 56]);
        };
        const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
            return command_executor_error(&"ERR no such key"[0: 14]);
        };
        if obj.obj_type != ObjectType.object_stream {
            return command_executor_wrongtype();
        }
        return command_executor_array_bulk(null as &ListNode, 0);
    }
    if command_executor_keyword_eq(subcommand, &"CONSUMERS"[0: 9]) {
        if command.argc != 4 {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|consumers' command"[0: 59]);
        }
        const key: &[byte] = command_executor_arg(command, 2) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|consumers' command"[0: 59]);
        };
        _ = command_executor_arg(command, 3) catch {
            return command_executor_owned_error(&"ERR wrong number of arguments for 'xinfo|consumers' command"[0: 59]);
        };
        const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
            return command_executor_error(&"ERR no such key"[0: 14]);
        };
        if obj.obj_type != ObjectType.object_stream {
            return command_executor_wrongtype();
        }
        return command_executor_error(&"NOGROUP No such consumer group"[0: 30]);
    }

    var err: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&err);
    }
    _ = command_executor_info_append(&err, &"ERR unknown subcommand '"[0: 24]) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, subcommand) catch {
        return command_executor_oom();
    };
    _ = command_executor_info_append(&err, &"'. Try XINFO HELP."[0: 18]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_error(err.buf[0: err.len]);
}

fn command_executor_xlen(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_stream {
        return command_executor_wrongtype();
    }
    const len: usize = stream_object_len(obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_integer(len as i64);
}

fn command_executor_xrange_common(engine: &Engine, command: &Command, now_ms: u64, reversed: bool) CommandReply {
    if command.argc != 4 && command.argc != 6 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const first_bound: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const second_bound: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    var count_limit: i64 = -1;
    if command.argc == 6 {
        const count_kw: &[byte] = command_executor_arg(command, 4) catch {
            return command_executor_wrong_arity();
        };
        if !command_executor_keyword_eq(count_kw, &"COUNT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const count_data: &[byte] = command_executor_arg(command, 5) catch {
            return command_executor_wrong_arity();
        };
        count_limit = command_executor_parse_i64(count_data) catch {
            return command_executor_invalid_integer();
        };
        if count_limit < 0 {
            return command_executor_invalid_integer();
        }
    }

    var start_default_seq: u64 = 0u64;
    var end_default_seq: u64 = STREAM_ID_MAX_SEQ;
    var start_token: &[byte] = first_bound;
    var end_token: &[byte] = second_bound;
    if reversed {
        start_token = second_bound;
        end_token = first_bound;
        start_default_seq = 0u64;
        end_default_seq = STREAM_ID_MAX_SEQ;
    }
    const start_id: StreamId = command_executor_parse_stream_id(start_token, start_default_seq, true, false) catch {
        return command_executor_error(&"ERR Invalid stream ID specified as stream command argument"[0: 57]);
    };
    const end_id: StreamId = command_executor_parse_stream_id(end_token, end_default_seq, true, false) catch {
        return command_executor_error(&"ERR Invalid stream ID specified as stream command argument"[0: 57]);
    };

    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_owned_raw(&"*0\r\n"[0: 4]);
    };
    if obj.obj_type != ObjectType.object_stream {
        return command_executor_wrongtype();
    }

    var body: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&body);
    }
    var emitted: usize = 0;
    var node: &ListNode = obj.list_head;
    if reversed {
        node = obj.list_tail;
    }
    while node != null {
        if node.value == null || node.value.obj_type != ObjectType.object_list || node.value.list_head == null {
            return command_executor_wrongtype();
        }
        const entry_id_data: &[byte] = node.value.list_head.value.value.buf[0: node.value.list_head.value.value.len];
        const entry_id: StreamId = command_executor_parse_stream_id(entry_id_data, 0u64, false, false) catch {
            return command_executor_wrongtype();
        };
        if command_executor_stream_id_cmp(&entry_id, &start_id) >= 0 && command_executor_stream_id_cmp(&entry_id, &end_id) <= 0 {
            if count_limit < 0 || emitted < count_limit as usize {
                _ = command_executor_stream_append_entry_resp(&body, node.value) catch {
                    return command_executor_oom();
                };
                emitted = emitted + 1;
            }
        }
        if count_limit >= 0 && emitted >= count_limit as usize {
            break;
        }
        if reversed {
            node = node.prev;
        } else {
            node = node.next;
        }
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_append_array_header(&raw, emitted) catch {
        return command_executor_oom();
    };
    _ = sds_cat(&raw, body.buf[0: body.len]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_xread(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }
    var index: usize = 1;
    var count_limit: i64 = -1;
    while index < command.argc {
        const token: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        if command_executor_keyword_eq(token, &"STREAMS"[0: 7]) {
            break;
        }
        if command_executor_keyword_eq(token, &"COUNT"[0: 5]) {
            if index + 1 >= command.argc {
                return command_executor_syntax_error();
            }
            const count_data: &[byte] = command_executor_arg(command, index + 1) catch {
                return command_executor_wrong_arity();
            };
            count_limit = command_executor_parse_i64(count_data) catch {
                return command_executor_invalid_integer();
            };
            if count_limit <= 0 {
                return command_executor_error(&"ERR value is out of range, must be positive"[0: 43]);
            }
            index = index + 2;
        } else if command_executor_keyword_eq(token, &"BLOCK"[0: 5]) {
            return command_executor_error(&"ERR XREAD BLOCK is not supported yet"[0: 36]);
        } else {
            return command_executor_syntax_error();
        }
    }
    if index >= command.argc {
        return command_executor_syntax_error();
    }
    const remaining: usize = command.argc - index - 1;
    if remaining == 0 || (remaining % 2usize) != 0usize {
        return command_executor_syntax_error();
    }
    const key_count: usize = remaining / 2;
    const first_key_index: usize = index + 1;
    const first_id_index: usize = first_key_index + key_count;

    var body: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&body);
    }
    var stream_count: usize = 0;
    var key_offset: usize = 0;
    while key_offset < key_count {
        const key: &[byte] = command_executor_arg(command, first_key_index + key_offset) catch {
            return command_executor_wrong_arity();
        };
        const id_data: &[byte] = command_executor_arg(command, first_id_index + key_offset) catch {
            return command_executor_wrong_arity();
        };
        const start_id: StreamId = command_executor_parse_stream_id(id_data, 0u64, false, true) catch {
            return command_executor_error(&"ERR Invalid stream ID specified as stream command argument"[0: 57]);
        };
        if !start_id.is_dollar {
            const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
            if obj_result.error_id != 0 {
                key_offset = key_offset + 1;
                continue;
            }
            const obj: &RedisObject = obj_result.value;
            if obj.obj_type != ObjectType.object_stream {
                return command_executor_wrongtype();
            }
            var entries: Sds = sds_empty() catch {
                return command_executor_oom();
            };
            defer {
                sds_free(&entries);
            }
            var emitted: usize = 0;
            var node: &ListNode = obj.list_head;
            while node != null {
                if node.value == null || node.value.obj_type != ObjectType.object_list || node.value.list_head == null {
                    return command_executor_wrongtype();
                }
                const entry_id_data: &[byte] = node.value.list_head.value.value.buf[0: node.value.list_head.value.value.len];
                const entry_id: StreamId = command_executor_parse_stream_id(entry_id_data, 0u64, false, false) catch {
                    return command_executor_wrongtype();
                };
                if command_executor_stream_id_cmp(&entry_id, &start_id) > 0 {
                    if count_limit < 0 || emitted < count_limit as usize {
                        _ = command_executor_stream_append_entry_resp(&entries, node.value) catch {
                            return command_executor_oom();
                        };
                        emitted = emitted + 1;
                    }
                }
                if count_limit >= 0 && emitted >= count_limit as usize {
                    break;
                }
                node = node.next;
            }
            if emitted > 0 {
                _ = command_executor_resp_append_array_header(&body, 2) catch { return command_executor_oom(); };
                _ = command_executor_resp_append_bulk(&body, key) catch { return command_executor_oom(); };
                _ = command_executor_resp_append_array_header(&body, emitted) catch { return command_executor_oom(); };
                _ = sds_cat(&body, entries.buf[0: entries.len]) catch { return command_executor_oom(); };
                stream_count = stream_count + 1;
            }
        }
        key_offset = key_offset + 1;
    }
    if stream_count == 0 {
        return command_executor_reply(CommandReplyType.reply_null_array, command_executor_empty_slice(), 0);
    }

    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_append_array_header(&raw, stream_count) catch {
        return command_executor_oom();
    };
    _ = sds_cat(&raw, body.buf[0: body.len]) catch {
        return command_executor_oom();
    };
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_rpush(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };

    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        const list_obj: &RedisObject = create_list_object() catch {
            return command_executor_oom();
        };
        var index_new: usize = 2;
        var new_len: usize = 0;
        while index_new < command.argc {
            const value_new: &[byte] = command_executor_arg(command, index_new) catch {
                object_free(list_obj);
                return command_executor_wrong_arity();
            };
            new_len = list_object_push_tail(list_obj, value_new) catch |err| {
                object_free(list_obj);
                if err == error.AllocOutOfMemory {
                    return command_executor_oom();
                }
                return command_executor_error(&"ERR list push failed"[0: 20]);
            };
            index_new = index_new + 1;
        }
        _ = set_key_at(engine, key, list_obj, now_ms) catch {
            object_free(list_obj);
            return command_executor_oom();
        };
        return command_executor_integer(new_len as i64);
    };

    if existing.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }

    var index: usize = 2;
    var new_len_existing: usize = 0;
    while index < command.argc {
        const value: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        new_len_existing = list_object_push_tail(existing, value) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_error(&"ERR list push failed"[0: 20]);
        };
        index = index + 1;
    }
    return command_executor_integer(new_len_existing as i64);
}

fn command_executor_rpop(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }

    const popped: &RedisObject = list_object_pop_tail(obj) catch |err| {
        if err == error.ObjectListEmpty {
            return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
        }
        return command_executor_wrongtype();
    };
    const data: &[byte] = command_executor_string_value(popped) catch {
        object_free(popped);
        return command_executor_wrongtype();
    };
    const remaining: usize = list_object_len(obj) catch {
        object_free(popped);
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, key);
    }
    var reply: CommandReply = command_executor_bulk(data);
    reply.owned_object = popped;
    return reply;
}

fn command_executor_lindex(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const index_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const idx: i64 = command_executor_parse_i64(index_data) catch {
        return command_executor_invalid_integer();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }
    const value: &RedisObject = list_object_index_value(obj, idx) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    const data: &[byte] = command_executor_string_value(value) catch {
        return command_executor_wrongtype();
    };
    return command_executor_bulk(data);
}

fn command_executor_linsert(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 5 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const where_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const pivot_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const element_data: &[byte] = command_executor_arg(command, 4) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }
    if obj.list_len == 0 {
        return command_executor_integer(0);
    }
    var before: bool = false;
    if command_executor_keyword_eq(where_data, &"BEFORE"[0: 6]) {
        before = true;
    } else if !command_executor_keyword_eq(where_data, &"AFTER"[0: 5]) {
        return command_executor_syntax_error();
    }
    var found: bool = false;
    var node: &ListNode = obj.list_head;
    while node != null {
        const node_data: &[byte] = node.value.value.buf[0: node.value.value.len];
        if bytes_eq(node_data, pivot_data) {
            found = true;
            break;
        }
        node = node.next;
    }
    if !found {
        return command_executor_integer(-1);
    }
    const new_value: &RedisObject = create_string_object(element_data) catch {
        return command_executor_oom();
    };
    const new_node: &ListNode = list_node_new(new_value) catch {
        object_free(new_value);
        return command_executor_oom();
    };
    if before {
        new_node.prev = node.prev;
        new_node.next = node;
        if node.prev != null {
            node.prev.next = new_node;
        } else {
            obj.list_head = new_node;
        }
        node.prev = new_node;
    } else {
        new_node.prev = node;
        new_node.next = node.next;
        if node.next != null {
            node.next.prev = new_node;
        } else {
            obj.list_tail = new_node;
        }
        node.next = new_node;
    }
    obj.list_len = obj.list_len + 1;
    return command_executor_integer(obj.list_len as i64);
}

fn command_executor_lset(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const index_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const value_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const idx: i64 = command_executor_parse_i64(index_data) catch {
        return command_executor_invalid_integer();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_error(&"ERR no such key"[0: 14]);
    };
    if obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }
    const result: !void = list_object_set_at(obj, idx, value_data);
    result catch |err| {
        if err == error.ObjectFieldNotFound {
            return command_executor_error(&"ERR index out of range"[0: 22]);
        }
        return command_executor_oom();
    };
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_llen(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 2 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }
    const len: usize = list_object_len(obj) catch {
        return command_executor_wrongtype();
    };
    return command_executor_integer(len as i64);
}

fn command_executor_ltrim(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const start_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const stop_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const start: i64 = command_executor_parse_i64(start_data) catch {
        return command_executor_invalid_integer();
    };
    const stop: i64 = command_executor_parse_i64(stop_data) catch {
        return command_executor_invalid_integer();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_simple(&"OK"[0: 2]);
    };
    if obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }
    const len: usize = list_object_len(obj) catch {
        return command_executor_wrongtype();
    };
    if len == 0 {
        return command_executor_simple(&"OK"[0: 2]);
    }
    const len_i64: i64 = len as i64;
    var start_idx: i64 = start;
    var stop_idx: i64 = stop;
    if start_idx < 0 {
        start_idx = len_i64 + start_idx;
    }
    if stop_idx < 0 {
        stop_idx = len_i64 + stop_idx;
    }
    if start_idx < 0 {
        start_idx = 0;
    }
    if stop_idx < 0 {
        stop_idx = 0;
    }
    if start_idx > stop_idx || start_idx >= len_i64 {
        while obj.list_head != null {
            const to_remove: &ListNode = obj.list_head;
            obj.list_head = to_remove.next;
            object_free(to_remove.value);
            list_node_free(to_remove);
        }
        obj.list_tail = null as &ListNode;
        obj.list_len = 0;
        _ = delete_key(engine, key);
        return command_executor_simple(&"OK"[0: 2]);
    }
    if stop_idx >= len_i64 {
        stop_idx = len_i64 - 1;
    }
    var i: i64 = 0;
    var node: &ListNode = obj.list_head;
    while i < start_idx {
        const to_remove: &ListNode = node;
        node = node.next;
        object_free(to_remove.value);
        list_node_free(to_remove);
        i = i + 1;
    }
    obj.list_head = node;
    if node != null {
        node.prev = null as &ListNode;
    }
    var j: i64 = 0;
    while j < stop_idx && node != null {
        node = node.next;
        j = j + 1;
    }
    if node != null && node.next != null {
        var drop: &ListNode = node.next;
        while drop != null {
            const next: &ListNode = drop.next;
            object_free(drop.value);
            list_node_free(drop);
            drop = next;
        }
        node.next = null as &ListNode;
        obj.list_tail = node;
    }
    if node == null {
        obj.list_tail = null as &ListNode;
    }
    obj.list_len = (stop_idx - start_idx + 1) as usize;
    return command_executor_simple(&"OK"[0: 2]);
}

fn command_executor_lrem(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const count_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const element_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const count: i64 = command_executor_parse_i64(count_data) catch {
        return command_executor_invalid_integer();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }
    const from_tail: bool = count < 0;
    var limit: i64 = count;
    if limit < 0 {
        limit = 0 - limit;
    }
    if limit == 0 {
        limit = obj.list_len as i64;
    }
    const removed: usize = list_object_remove_value(obj, element_data, limit, from_tail) catch {
        return command_executor_wrongtype();
    };
    if obj.list_len == 0 {
        _ = delete_key(engine, key);
    }
    return command_executor_integer(removed as i64);
}

fn command_executor_lpushx(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if existing.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }
    var index: usize = 2;
    var new_len_existing: usize = 0;
    while index < command.argc {
        const value: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        new_len_existing = list_object_push_head(existing, value) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_error(&"ERR list push failed"[0: 20]);
        };
        index = index + 1;
    }
    return command_executor_integer(new_len_existing as i64);
}

fn command_executor_rpushx(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const existing: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_integer(0);
    };
    if existing.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }
    var index: usize = 2;
    var new_len_existing: usize = 0;
    while index < command.argc {
        const value: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        new_len_existing = list_object_push_tail(existing, value) catch |err| {
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_error(&"ERR list push failed"[0: 20]);
        };
        index = index + 1;
    }
    return command_executor_integer(new_len_existing as i64);
}

fn command_executor_lpos(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const key: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const element_data: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const obj: &RedisObject = lookup_key_at(engine, key, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }
    const pos: i64 = list_object_pos(obj, element_data, 1, 0, 0) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    return command_executor_integer(pos);
}

fn command_executor_validate_blocking_timeout(timeout_data: &[byte]) !void {
    const timeout_seconds: f64 = command_executor_parse_f64(timeout_data) catch {
        return error.CommandInvalidFloat;
    };
    if timeout_seconds < 0.0 {
        return error.CommandInvalidFloat;
    }
}

fn command_executor_blocking_list_pop(engine: &Engine, command: &Command, now_ms: u64, left: bool) CommandReply {
    if command.argc < 3 {
        return command_executor_wrong_arity();
    }
    const timeout_data: &[byte] = command_executor_arg(command, command.argc - 1) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_validate_blocking_timeout(timeout_data) catch {
        return command_executor_error(&"ERR value is not a valid float"[0: 30]);
    };

    var index: usize = 1;
    while index + 1 < command.argc {
        const key: &[byte] = command_executor_arg(command, index) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        if obj_result.error_id != 0 {
            index = index + 1;
            continue;
        }
        const obj: &RedisObject = obj_result.value;
        if obj.obj_type != ObjectType.object_list {
            return command_executor_wrongtype();
        }

        const popped_result: !&RedisObject = command_executor_list_pop_direction(obj, left);
        if popped_result.error_id != 0 {
            if popped_result.error_id == @error_id(error.ObjectListEmpty) {
                index = index + 1;
                continue;
            }
            return command_executor_wrongtype();
        }
        const popped: &RedisObject = popped_result.value;
        const data: &[byte] = command_executor_string_value(popped) catch {
            object_free(popped);
            return command_executor_wrongtype();
        };
        const remaining: usize = list_object_len(obj) catch {
            object_free(popped);
            return command_executor_wrongtype();
        };
        if remaining == 0 {
            _ = delete_key(engine, key);
        }

        const pair_list: &RedisObject = create_list_object() catch {
            object_free(popped);
            return command_executor_oom();
        };
        _ = list_object_push_tail(pair_list, key) catch {
            object_free(pair_list);
            object_free(popped);
            return command_executor_oom();
        };
        _ = list_object_push_tail(pair_list, data) catch {
            object_free(pair_list);
            object_free(popped);
            return command_executor_oom();
        };
        object_free(popped);
        var reply: CommandReply = command_executor_array_bulk(pair_list.list_head, 2);
        reply.owned_object = pair_list;
        return reply;
    }

    return command_executor_reply(CommandReplyType.reply_null_array, command_executor_empty_slice(), 0);
}

fn command_executor_brpoplpush(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 4 {
        return command_executor_wrong_arity();
    }
    const source: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const destination: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const timeout_data: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_validate_blocking_timeout(timeout_data) catch {
        return command_executor_error(&"ERR value is not a valid float"[0: 30]);
    };
    return command_executor_list_move_internal(engine, source, destination, now_ms, false, true);
}

fn command_executor_list_pop_direction(obj: &RedisObject, left: bool) !&RedisObject {
    if left {
        return list_object_pop_head(obj);
    }
    return list_object_pop_tail(obj);
}

fn command_executor_list_push_direction(obj: &RedisObject, data: &[byte], left: bool) !usize {
    if left {
        return list_object_push_head(obj, data);
    }
    return list_object_push_tail(obj, data);
}

fn command_executor_list_restore_popped(obj: &RedisObject, popped: &RedisObject, pop_left: bool) !void {
    const data: &[byte] = command_executor_string_value(popped) catch {
        return error.ObjectWrongType;
    };
    _ = command_executor_list_push_direction(obj, data, pop_left);
}

fn command_executor_list_move_internal(
    engine: &Engine,
    source: &[byte],
    destination: &[byte],
    now_ms: u64,
    pop_left: bool,
    push_left: bool,
) CommandReply {
    const source_obj: &RedisObject = lookup_key_at(engine, source, now_ms) catch {
        return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
    };
    if source_obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }

    if bytes_eq(source, destination) {
        const popped_same: &RedisObject = command_executor_list_pop_direction(source_obj, pop_left) catch |err| {
            if err == error.ObjectListEmpty {
                return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
            }
            return command_executor_wrongtype();
        };
        const data_same: &[byte] = command_executor_string_value(popped_same) catch {
            _ = command_executor_list_restore_popped(source_obj, popped_same, pop_left) catch {};
            object_free(popped_same);
            return command_executor_wrongtype();
        };
        _ = command_executor_list_push_direction(source_obj, data_same, push_left) catch |err| {
            _ = command_executor_list_restore_popped(source_obj, popped_same, pop_left) catch {};
            object_free(popped_same);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        var reply_same: CommandReply = command_executor_bulk(data_same);
        reply_same.owned_object = popped_same;
        return reply_same;
    }

    const destination_obj: &RedisObject = command_executor_lookup_key_now_or_null(engine, destination, now_ms);
    if destination_obj != null && destination_obj.obj_type != ObjectType.object_list {
        return command_executor_wrongtype();
    }

    const popped: &RedisObject = command_executor_list_pop_direction(source_obj, pop_left) catch |err| {
        if err == error.ObjectListEmpty {
            return command_executor_reply(CommandReplyType.reply_null_bulk, command_executor_empty_slice(), 0);
        }
        return command_executor_wrongtype();
    };
    const data: &[byte] = command_executor_string_value(popped) catch {
        _ = command_executor_list_restore_popped(source_obj, popped, pop_left) catch {};
        object_free(popped);
        return command_executor_wrongtype();
    };

    if destination_obj == null {
        const new_destination: &RedisObject = create_list_object() catch {
            _ = command_executor_list_restore_popped(source_obj, popped, pop_left) catch {};
            object_free(popped);
            return command_executor_oom();
        };
        _ = command_executor_list_push_direction(new_destination, data, push_left) catch |err| {
            object_free(new_destination);
            _ = command_executor_list_restore_popped(source_obj, popped, pop_left) catch {};
            object_free(popped);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
        _ = set_key_at(engine, destination, new_destination, now_ms) catch {
            object_free(new_destination);
            _ = command_executor_list_restore_popped(source_obj, popped, pop_left) catch {};
            object_free(popped);
            return command_executor_oom();
        };
    } else {
        _ = command_executor_list_push_direction(destination_obj, data, push_left) catch |err| {
            _ = command_executor_list_restore_popped(source_obj, popped, pop_left) catch {};
            object_free(popped);
            if err == error.AllocOutOfMemory {
                return command_executor_oom();
            }
            return command_executor_wrongtype();
        };
    }

    const remaining: usize = list_object_len(source_obj) catch {
        object_free(popped);
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, source);
    }

    var reply: CommandReply = command_executor_bulk(data);
    reply.owned_object = popped;
    return reply;
}

fn command_executor_lmove(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 5 {
        return command_executor_wrong_arity();
    }
    const source: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const destination: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const wherefrom: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const whereto: &[byte] = command_executor_arg(command, 4) catch {
        return command_executor_wrong_arity();
    };

    var pop_left: bool = false;
    if command_executor_keyword_eq(wherefrom, &"LEFT"[0: 4]) {
        pop_left = true;
    } else if !command_executor_keyword_eq(wherefrom, &"RIGHT"[0: 5]) {
        return command_executor_syntax_error();
    }

    var push_left: bool = false;
    if command_executor_keyword_eq(whereto, &"LEFT"[0: 4]) {
        push_left = true;
    } else if !command_executor_keyword_eq(whereto, &"RIGHT"[0: 5]) {
        return command_executor_syntax_error();
    }

    return command_executor_list_move_internal(engine, source, destination, now_ms, pop_left, push_left);
}

fn command_executor_blmove(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 6 {
        return command_executor_wrong_arity();
    }
    const source: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const destination: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    const wherefrom: &[byte] = command_executor_arg(command, 3) catch {
        return command_executor_wrong_arity();
    };
    const whereto: &[byte] = command_executor_arg(command, 4) catch {
        return command_executor_wrong_arity();
    };
    const timeout_data: &[byte] = command_executor_arg(command, 5) catch {
        return command_executor_wrong_arity();
    };
    _ = command_executor_validate_blocking_timeout(timeout_data) catch {
        return command_executor_error(&"ERR value is not a valid float"[0: 30]);
    };

    var pop_left: bool = false;
    if command_executor_keyword_eq(wherefrom, &"LEFT"[0: 4]) {
        pop_left = true;
    } else if !command_executor_keyword_eq(wherefrom, &"RIGHT"[0: 5]) {
        return command_executor_syntax_error();
    }

    var push_left: bool = false;
    if command_executor_keyword_eq(whereto, &"LEFT"[0: 4]) {
        push_left = true;
    } else if !command_executor_keyword_eq(whereto, &"RIGHT"[0: 5]) {
        return command_executor_syntax_error();
    }

    return command_executor_list_move_internal(engine, source, destination, now_ms, pop_left, push_left);
}

fn command_executor_rpoplpush(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc != 3 {
        return command_executor_wrong_arity();
    }
    const source: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const destination: &[byte] = command_executor_arg(command, 2) catch {
        return command_executor_wrong_arity();
    };
    return command_executor_list_move_internal(engine, source, destination, now_ms, false, true);
}

fn command_executor_lmpop_reply(source: &[byte], obj: &RedisObject, pop_left: bool, count: usize) CommandReply {
    var raw: Sds = sds_empty() catch {
        return command_executor_oom();
    };
    defer {
        sds_free(&raw);
    }
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], 2) catch {
        return command_executor_oom();
    };
    _ = command_executor_command_append_bulk(&raw, source) catch {
        return command_executor_oom();
    };
    _ = command_executor_resp_collection_prefix(&raw, &"*"[0: 1], count) catch {
        return command_executor_oom();
    };

    var index: usize = 0;
    while index < count {
        var value_index: i64 = index as i64;
        if !pop_left {
            value_index = -1 - (index as i64);
        }
        const value_obj: &RedisObject = list_object_index_value(obj, value_index) catch {
            return command_executor_wrongtype();
        };
        const data: &[byte] = command_executor_string_value(value_obj) catch {
            return command_executor_wrongtype();
        };
        _ = command_executor_command_append_bulk(&raw, data) catch {
            return command_executor_oom();
        };
        index = index + 1;
    }
    return command_executor_owned_raw(raw.buf[0: raw.len]);
}

fn command_executor_lmpop(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 4 {
        return command_executor_wrong_arity();
    }

    const numkeys_data: &[byte] = command_executor_arg(command, 1) catch {
        return command_executor_wrong_arity();
    };
    const numkeys_i64: i64 = command_executor_parse_i64(numkeys_data) catch {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    };
    if numkeys_i64 <= 0 {
        return command_executor_error(&"ERR numkeys should be greater than 0"[0: 36]);
    }

    const numkeys: usize = numkeys_i64 as usize;
    const keys_end: usize = 2 + numkeys;
    if command.argc <= keys_end {
        return command_executor_syntax_error();
    }

    const wherefrom: &[byte] = command_executor_arg(command, keys_end) catch {
        return command_executor_syntax_error();
    };
    var pop_left: bool = false;
    if command_executor_keyword_eq(wherefrom, &"LEFT"[0: 4]) {
        pop_left = true;
    } else if !command_executor_keyword_eq(wherefrom, &"RIGHT"[0: 5]) {
        return command_executor_syntax_error();
    }

    var requested_count: usize = 1;
    if command.argc == keys_end + 3 {
        const option: &[byte] = command_executor_arg(command, keys_end + 1) catch {
            return command_executor_syntax_error();
        };
        if !command_executor_keyword_eq(option, &"COUNT"[0: 5]) {
            return command_executor_syntax_error();
        }
        const count_data: &[byte] = command_executor_arg(command, keys_end + 2) catch {
            return command_executor_syntax_error();
        };
        const count_i64: i64 = command_executor_parse_i64(count_data) catch {
            return command_executor_error(&"ERR count should be greater than 0"[0: 34]);
        };
        if count_i64 <= 0 {
            return command_executor_error(&"ERR count should be greater than 0"[0: 34]);
        }
        requested_count = count_i64 as usize;
    } else if command.argc != keys_end + 1 {
        return command_executor_syntax_error();
    }

    var source: &[byte] = command_executor_empty_slice();
    var source_obj: &RedisObject = null as &RedisObject;
    var arg_index: usize = 2;
    while arg_index < keys_end {
        const key: &[byte] = command_executor_arg(command, arg_index) catch {
            return command_executor_wrong_arity();
        };
        const obj_result: !&RedisObject = lookup_key_at(engine, key, now_ms);
        const obj: &RedisObject = obj_result catch {
            arg_index = arg_index + 1;
            null as &RedisObject;
        };
        if obj == null {
            continue;
        }
        if obj.obj_type != ObjectType.object_list {
            return command_executor_wrongtype();
        }
        const available: usize = list_object_len(obj) catch {
            return command_executor_wrongtype();
        };
        if available > 0 {
            source = key;
            source_obj = obj;
            break;
        }
        arg_index = arg_index + 1;
    }

    if source_obj == null {
        return command_executor_reply(CommandReplyType.reply_null_array, command_executor_empty_slice(), 0);
    }

    var actual_count: usize = requested_count;
    const available_count: usize = list_object_len(source_obj) catch {
        return command_executor_wrongtype();
    };
    if actual_count > available_count {
        actual_count = available_count;
    }
    if actual_count == 0 {
        _ = delete_key(engine, source);
        return command_executor_reply(CommandReplyType.reply_null_array, command_executor_empty_slice(), 0);
    }

    var reply: CommandReply = command_executor_lmpop_reply(source, source_obj, pop_left, actual_count);
    if reply.typ == CommandReplyType.reply_error {
        return reply;
    }

    var popped_count: usize = 0;
    while popped_count < actual_count {
        const popped: &RedisObject = command_executor_list_pop_direction(source_obj, pop_left) catch {
            command_reply_cleanup(&reply);
            return command_executor_wrongtype();
        };
        object_free(popped);
        popped_count = popped_count + 1;
    }

    const remaining: usize = list_object_len(source_obj) catch {
        command_reply_cleanup(&reply);
        return command_executor_wrongtype();
    };
    if remaining == 0 {
        _ = delete_key(engine, source);
    }
    return reply;
}

fn command_executor_blmpop(engine: &Engine, command: &Command, now_ms: u64) CommandReply {
    if command.argc < 5 {
        return command_executor_wrong_arity();
    }
