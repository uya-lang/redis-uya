    const touch_result: ConnectionProcessResult = try connection_process_input_at(&engine, &router, &"*3\r\n$5\r\nTOUCH\r\n$7\r\ntouchme\r\n$7\r\nmissing\r\n"[0: 41], &out[0], 128, 1000u64);
